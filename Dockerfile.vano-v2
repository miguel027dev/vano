# Original VANO Python route engine + V2 React/Node in one isolated container.
# Build context is the repository ROOT, because the verified V1 modules live there.
FROM node:22-bookworm-slim AS frontend
WORKDIR /build/v2
COPY v2/package.json ./
# The current V2 branch has no committed package-lock.json; npm ci is not possible yet.
RUN npm install --no-audit --no-fund
COPY v2/ ./
RUN npm test && npm run build

FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini bash \
    && rm -rf /var/lib/apt/lists/*
COPY --from=frontend /usr/local/bin/node /usr/local/bin/node
WORKDIR /opt/vano
COPY requirements.txt requirements.lock ./
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY . .
COPY --from=frontend /build/v2/dist ./v2/dist
RUN chmod 755 v2/original-engine/start.sh
EXPOSE 10000
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["bash","v2/original-engine/start.sh"]
