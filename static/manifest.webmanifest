{
  "name": "VANO MAPS",
  "short_name": "VANO",
  "description": "Navegação adaptativa com rotas rápidas, alternativas inteligentes e informações úteis para o trajeto.",
  "lang": "pt-BR",
  "start_url": "/mobile/entry",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FFF8F2",
  "theme_color": "#F47A31",
  "categories": ["navigation", "travel", "utilities"],
  "icons": [
    {"src": "/static/vano-maps-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "/static/vano-maps-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "shortcuts": [
    {"name": "Abrir mapa", "short_name": "Mapa", "url": "/", "icons": [{"src": "/static/vano-maps-icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Central de ajuda", "short_name": "Ajuda", "url": "/help", "icons": [{"src": "/static/vano-maps-icon-192.png", "sizes": "192x192", "type": "image/png"}]}
  ],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {"title": "title", "text": "text", "url": "url"}
  }
}
