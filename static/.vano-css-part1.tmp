@media(max-width:760px){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v255{left:8px!important;right:8px!important;bottom:max(8px,env(safe-area-inset-bottom))!important;width:auto!important;max-width:none!important;max-height:min(84dvh,680px)!important;padding:9px 10px 11px!important;border-radius:23px!important;transform-origin:bottom center}
  body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-intro{align-items:flex-start;flex-direction:column;gap:10px;margin-top:10px;padding:14px;border-radius:17px}
  body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-intro h2{font-size:21px}
  body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-intro p{font-size:11px}
  body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-status{white-space:normal}
  body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v108-quicknav.profile-v255-quicknav{grid-template-columns:1fr 1fr!important}
  body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-quicknav>a{min-height:78px!important}
  body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-detail-body{padding:12px!important}
