/* VANO MAPS — unified stylesheet, generated from canonical runtime CSS. */

/* ===== static/vano-app.css ===== */
/* VANO MAPS — consolidated production shell. */
/* VANO MAPS — bundle consolidado. Ordem preservada do runtime original. */

/* ---- rebrand-vano.css ---- */
/* VANO — complete bright design system */
body.vano-app-root:not(.vano-route-onboarding){
  --vano:#F59A62;--vano-2:#FFC39B;--vano-deep:#D9703F;--vano-soft:#FFF2E8;
  --vano-mint:#2CC7A0;--vano-mint-soft:#E5F9F3;--vano-sky:#EAF3FF;
  --vano-bg:#F6F7FB;--vano-card:#FFFFFF;--vano-ink:#182033;--vano-muted:#697386;
  --vano-line:#E2E6EF;--vano-danger:#E65361;--vano-warning:#E7A72A;--vano-info:#4A89E8;
  --vano-shadow:0 12px 34px rgba(35,43,78,.10);--vano-shadow-lg:0 24px 68px rgba(35,43,78,.15);
  --vano-r-sm:12px;--vano-r:16px;--vano-r-lg:22px;
  --bg:var(--vano-bg);--surface:#fff;--surface-2:#F0F2F7;--surface-3:#E7EAF1;
  --text:var(--vano-ink);--muted:var(--vano-muted);--muted-2:#8A93A3;--line:var(--vano-line);
  --orange:var(--vano);--orange-2:var(--vano-2);--orange-3:#F59A62;--success:var(--vano-mint);
  --warning:var(--vano-warning);--danger:var(--vano-danger);--info:var(--vano-info);--shadow:var(--vano-shadow);
}
html body.vano-app-root:not(.vano-route-onboarding),
body.vano-app-root:not(.vano-route-onboarding){background:var(--vano-bg)!important;color:var(--vano-ink)!important;font-size:16px}
body.vano-app-root:not(.vano-route-onboarding){background-image:radial-gradient(circle at 10% 0,rgba(217,112,63,.055),transparent 24%),radial-gradient(circle at 90% 8%,rgba(44,199,160,.045),transparent 22%)!important}
body.vano-app-root:not(.vano-route-onboarding):before{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) ::selection{background:#E8DED6;color:#1D2450}
body.vano-app-root:not(.vano-route-onboarding) .topbar{height:68px!important;background:rgba(255,255,255,.94)!important;border-bottom:1px solid var(--vano-line)!important;box-shadow:0 7px 24px rgba(35,43,78,.05)!important;backdrop-filter:blur(18px)!important}
body.vano-app-root:not(.vano-route-onboarding) .brand{gap:10px!important;color:var(--vano-ink)!important;font-size:18px!important;letter-spacing:-.55px!important}body.vano-app-root:not(.vano-route-onboarding) .brand:before{display:none!important}body.vano-app-root:not(.vano-route-onboarding) .vano-brandmark{width:34px;height:34px;display:block;border-radius:11px}body.vano-app-root:not(.vano-route-onboarding) .brand span{font-weight:900;letter-spacing:-.7px}
body.vano-app-root:not(.vano-route-onboarding) .navlinks a,
body.vano-app-root:not(.vano-route-onboarding) .navlinks button.navbtn{color:#657085!important}body.vano-app-root:not(.vano-route-onboarding) .navlinks a:hover,
body.vano-app-root:not(.vano-route-onboarding) .navlinks button.navbtn:hover,
body.vano-app-root:not(.vano-route-onboarding) .navlinks a.active{background:var(--vano-soft)!important;color:var(--vano-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .btn{min-height:46px;border-radius:14px!important;background:#fff!important;color:var(--vano-ink)!important;border:1px solid var(--vano-line)!important;font-size:14px!important;font-weight:760!important;box-shadow:none!important}body.vano-app-root:not(.vano-route-onboarding) .btn-primary{background:linear-gradient(135deg,var(--vano-2),var(--vano))!important;color:#fff!important;border-color:transparent!important;box-shadow:0 10px 24px rgba(217,112,63,.20)!important}body.vano-app-root:not(.vano-route-onboarding) .btn-primary:hover{box-shadow:0 13px 30px rgba(217,112,63,.27)!important}body.vano-app-root:not(.vano-route-onboarding) .btn-danger{background:#FFF0F2!important;color:#C83D4B!important;border-color:#F8D7DC!important}
body.vano-app-root:not(.vano-route-onboarding) .page{padding-top:28px!important}body.vano-app-root:not(.vano-route-onboarding) .eyebrow{color:var(--vano)!important}body.vano-app-root:not(.vano-route-onboarding) .title,
body.vano-app-root:not(.vano-route-onboarding) .page-title,
body.vano-app-root:not(.vano-route-onboarding) .section-title{color:var(--vano-ink)!important}body.vano-app-root:not(.vano-route-onboarding) .subtitle,
body.vano-app-root:not(.vano-route-onboarding) .page-subtitle,
body.vano-app-root:not(.vano-route-onboarding) .muted,
body.vano-app-root:not(.vano-route-onboarding) .tiny{color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .panel,
body.vano-app-root:not(.vano-route-onboarding) .card,
body.vano-app-root:not(.vano-route-onboarding) .kpi,
body.vano-app-root:not(.vano-route-onboarding) .alert-card,
body.vano-app-root:not(.vano-route-onboarding) .auth-card{background:#fff!important;color:var(--vano-ink)!important;border:1px solid var(--vano-line)!important;border-radius:var(--vano-r-lg)!important;box-shadow:0 10px 28px rgba(35,43,78,.055)!important}body.vano-app-root:not(.vano-route-onboarding) .panel-head{border-bottom-color:var(--vano-line)!important}body.vano-app-root:not(.vano-route-onboarding) .iconbox{background:var(--vano-soft)!important;color:var(--vano)!important;border-color:#E8DED6!important;box-shadow:none!important}
body.vano-app-root:not(.vano-route-onboarding) .input,
body.vano-app-root:not(.vano-route-onboarding) .select,
body.vano-app-root:not(.vano-route-onboarding) .textarea{min-height:46px;background:#FAFBFD!important;color:var(--vano-ink)!important;border:1px solid #DDE2EC!important;border-radius:13px!important;font-size:14px!important}body.vano-app-root:not(.vano-route-onboarding) .input:focus,
body.vano-app-root:not(.vano-route-onboarding) .select:focus,
body.vano-app-root:not(.vano-route-onboarding) .textarea:focus{border-color:#F59A62!important;box-shadow:0 0 0 4px rgba(217,112,63,.10)!important}body.vano-app-root:not(.vano-route-onboarding) .field label{color:#4F596B!important}
body.vano-app-root:not(.vano-route-onboarding) .table th,
body.vano-app-root:not(.vano-route-onboarding) .table td{border-color:#E9ECF2!important}body.vano-app-root:not(.vano-route-onboarding) .table tr:hover td{background:#F8F9FC!important}body.vano-app-root:not(.vano-route-onboarding) .flash{background:#fff!important;color:var(--vano-ink)!important;border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow)!important}
body.vano-app-root:not(.vano-route-onboarding) footer{border-color:var(--vano-line)!important;color:var(--vano-muted)!important;background:#fff!important}

/* Main map app */
body.vano-app-root:not(.vano-route-onboarding) .ws-app{--o:var(--vano);--o2:var(--vano-2);--bg:#EEF1F6;--glass:rgba(255,255,255,.94);--glass2:rgba(255,255,255,.985);--line:rgba(37,46,70,.10);--text:var(--vano-ink);--muted:#697386;--green:var(--vano-mint);--red:var(--vano-danger);--blue:var(--vano-info);--ink:var(--vano-ink);--soft:#F1F3F8;background:#EEF1F6!important;box-shadow:0 0 70px rgba(35,43,78,.10)!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-drawer,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .destination-confirm,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-loading-card,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .resume-trip-card,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-panel{background:rgba(255,255,255,.975)!important;color:var(--vano-ink)!important;border-color:rgba(39,47,72,.10)!important;box-shadow:var(--vano-shadow-lg)!important;backdrop-filter:blur(22px)!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card{top:max(66px,calc(env(safe-area-inset-top) + 58px))!important;padding:7px!important;border-radius:20px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .location-row{min-height:54px!important;background:#F7F8FC!important;border-color:#E6E9F0!important;border-radius:14px}body.vano-app-root:not(.vano-route-onboarding) .ws-app .location-row+.location-row{margin-top:6px;border-top:0!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .location-input{color:var(--vano-ink)!important;font-size:15px!important;font-weight:680!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .location-input::placeholder{color:#8A93A4!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .row-btn{color:#6D7687!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .row-btn:active{background:#EBEDF4!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .pin.end i{background:linear-gradient(145deg,#F59A62,var(--vano))!important;box-shadow:0 0 0 4px var(--vano-soft)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .pin.end i:after{background:#fff!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .top-actions,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .quick-actions{gap:8px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .map-btn,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .quick,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-stack-btn,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-audio-toggle{width:46px!important;height:46px!important;border-radius:14px!important;background:rgba(255,255,255,.96)!important;color:#4E596D!important;border:1px solid #E0E4ED!important;box-shadow:0 8px 22px rgba(35,43,78,.10)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .map-btn:hover,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .quick:hover{background:#F7F7FC!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-stack-btn.active,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-audio-toggle.active,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .map-btn.active{color:var(--vano)!important;background:var(--vano-soft)!important;border-color:#E8DED6!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .segment,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .travel{background:#F0F2F7!important;border-color:#E1E5ED!important;border-radius:14px!important;padding:4px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .segment button,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .travel button{min-height:40px!important;color:#687386!important;font-size:12px!important;border-radius:11px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .segment button.active,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .travel button.active{background:#fff!important;color:var(--vano-deep)!important;border-color:#E8DED6!important;box-shadow:0 4px 12px rgba(35,43,78,.07)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .segment button.fast.active{color:var(--vano-deep)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .segment button.smart.active{color:var(--vano-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-variant,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-card,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .parking-nearby,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-insight{background:#F8F9FC!important;border-color:#E4E8F0!important;color:#263044!important;border-radius:15px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-variant.active{background:var(--vano-soft)!important;border-color:#E8DED6!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .primary,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .destination-accept,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .start-trip-cta{min-height:50px!important;border-radius:15px!important;background:linear-gradient(135deg,var(--vano-2),var(--vano))!important;color:#fff!important;box-shadow:0 10px 24px rgba(217,112,63,.18)!important;font-size:14px!important;font-weight:820!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet{border-radius:24px 24px 0 0!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .grab{background:#CDD2DD!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet h2,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet h3{color:var(--vano-ink)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet p,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet small{color:var(--vano-muted)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-link{color:#344055!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-link:hover{background:#F4F5FA!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-divider{background:#EAEDF3!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-panel{left:10px!important;right:10px!important;bottom:max(10px,env(safe-area-inset-bottom))!important;border-radius:24px!important;padding:10px 12px 12px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .maneuver{grid-template-columns:52px 1fr auto!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .maneuver-icon{width:52px!important;height:52px!important;border-radius:16px!important;background:linear-gradient(145deg,var(--vano-2),var(--vano))!important;color:#fff!important;box-shadow:0 9px 22px rgba(217,112,63,.18)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .maneuver-copy b{font-size:15px!important;color:var(--vano-ink)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .maneuver-copy span{font-size:11px!important;color:#748094!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .remaining{font-size:27px!important;color:var(--vano-ink)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .remaining small{font-size:9px!important;color:#7D8798!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-stats{gap:6px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-stat{background:#F5F6FA!important;border-color:#E5E8EF!important;border-radius:12px!important;padding:9px 5px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-stat strong{font-size:12px!important;color:#2E394D!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-stat span{font-size:8px!important;color:#7B8596!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .progress{background:#E5E8F0!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .progress>div{background:linear-gradient(90deg,#FFC39B,var(--vano))!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-action{height:43px!important;background:#F5F6FA!important;color:#687386!important;border-color:#E3E7EE!important;border-radius:12px!important;font-size:9px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-action.active{color:var(--vano-deep)!important;border-color:#E8DED6!important;background:var(--vano-soft)!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-alt-card,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-suggestion{background:#F7F7FE!important;border-color:#E8DED6!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-alt-accept,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-accept{background:var(--vano)!important;color:#fff!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-alt-dismiss,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-dismiss{background:#EEF0F5!important;color:#697386!important;border-color:#E1E5ED!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .permission{background:#fff!important;color:#243047!important;border-color:#E2E6EE!important;box-shadow:var(--vano-shadow)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .permission-copy span{color:#738094!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .permission button{background:var(--vano-soft)!important;color:var(--vano-deep)!important}

/* Guest trial */
body.vano-app-root:not(.vano-route-onboarding) .guest-trial-pill{top:max(11px,env(safe-area-inset-top))!important;right:11px!important;height:38px!important;padding:0 12px!important;border:1px solid #DFE3ED!important;border-radius:999px!important;background:rgba(255,255,255,.96)!important;color:#4C586D!important;box-shadow:0 8px 22px rgba(35,43,78,.09)!important;font-size:11px!important;font-weight:760!important}body.vano-app-root:not(.vano-route-onboarding) .guest-trial-pill svg{color:var(--vano)!important}body.vano-app-root:not(.vano-route-onboarding) .guest-trial-pill b{color:#2E3850!important;font-size:12px!important}body.vano-app-root:not(.vano-route-onboarding) .guest-trial-pill.low{background:#FFF8E8!important;border-color:#F4DEAF!important}body.vano-app-root:not(.vano-route-onboarding) .guest-trial-pill.empty{background:#FFF1F3!important;color:#B74754!important;border-color:#F1D5DA!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-limit-backdrop{background:rgba(36,42,67,.28)!important}body.vano-app-root:not(.vano-route-onboarding) .guest-limit-card{background:#fff!important;color:var(--vano-ink)!important;border-color:#E2E6EF!important;border-radius:24px!important;box-shadow:var(--vano-shadow-lg)!important}body.vano-app-root:not(.vano-route-onboarding) .guest-limit-icon{background:var(--vano-soft)!important;color:var(--vano)!important}body.vano-app-root:not(.vano-route-onboarding) .guest-limit-card small{color:var(--vano)!important}body.vano-app-root:not(.vano-route-onboarding) .guest-limit-card p{color:var(--vano-muted)!important}body.vano-app-root:not(.vano-route-onboarding) .guest-limit-primary{background:linear-gradient(135deg,var(--vano-2),var(--vano))!important;color:#fff!important}body.vano-app-root:not(.vano-route-onboarding) .guest-limit-secondary{background:#F4F5F9!important;color:#344055!important;border-color:#E1E5ED!important}

/* Auth */
body.vano-app-root:not(.vano-route-onboarding) .vano-entry{background:var(--vano-bg)!important;color:var(--vano-ink)!important}body.vano-app-root:not(.vano-route-onboarding) .auth-screen{background:linear-gradient(180deg,#fff 0%,#F6F7FB 100%)!important}body.vano-app-root:not(.vano-route-onboarding) .auth-copy h1,
body.vano-app-root:not(.vano-route-onboarding) .auth-brandline{color:var(--vano-ink)!important}body.vano-app-root:not(.vano-route-onboarding) .auth-copy h1{font-size:clamp(34px,6vw,54px)!important;line-height:.98!important;letter-spacing:-2.1px!important}body.vano-app-root:not(.vano-route-onboarding) .auth-copy h1 span{color:var(--vano)!important}body.vano-app-root:not(.vano-route-onboarding) .auth-copy p{font-size:15px!important;color:var(--vano-muted)!important;max-width:460px}body.vano-app-root:not(.vano-route-onboarding) .auth-brandline{gap:9px!important}body.vano-app-root:not(.vano-route-onboarding) .auth-brandline img{width:34px!important;height:34px!important;border-radius:11px}body.vano-app-root:not(.vano-route-onboarding) .auth-brandline b{font-size:14px!important;letter-spacing:.04em}body.vano-app-root:not(.vano-route-onboarding) .auth-brandline span{color:#8A93A3!important;font-size:9px!important}body.vano-app-root:not(.vano-route-onboarding) .auth-choice,
body.vano-app-root:not(.vano-route-onboarding) .auth-google,
body.vano-app-root:not(.vano-route-onboarding) .auth-guest{min-height:50px!important;border-radius:14px!important;font-size:14px!important;font-weight:760!important}body.vano-app-root:not(.vano-route-onboarding) .auth-choice.primary,
body.vano-app-root:not(.vano-route-onboarding) .sheet-submit{background:linear-gradient(135deg,var(--vano-2),var(--vano))!important;color:#fff!important;box-shadow:0 10px 24px rgba(217,112,63,.17)!important}body.vano-app-root:not(.vano-route-onboarding) .auth-choice.secondary,
body.vano-app-root:not(.vano-route-onboarding) .auth-google{background:#fff!important;color:#273147!important;border-color:#DDE2EC!important}body.vano-app-root:not(.vano-route-onboarding) .auth-guest{color:var(--vano-deep)!important;background:var(--vano-soft)!important;border-color:#E8DED6!important}body.vano-app-root:not(.vano-route-onboarding) .auth-legal{color:#7E8899!important}body.vano-app-root:not(.vano-route-onboarding) .auth-legal a,
body.vano-app-root:not(.vano-route-onboarding) .sheet-switch a{color:var(--vano)!important}body.vano-app-root:not(.vano-route-onboarding) .auth-divider{color:#929AAA!important}body.vano-app-root:not(.vano-route-onboarding) .auth-divider:before,
