  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-collapsed{height:142px!important;min-height:142px!important;max-height:142px!important;--planner-collapsed-h:142px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-row{grid-template-columns:minmax(0,1fr) 52px!important;gap:6px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card{height:60px!important;min-height:60px!important;max-height:60px!important;border-radius:18px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-location-row.location-row{height:52px!important;min-height:52px!important;max-height:52px!important;grid-template-columns:38px minmax(0,1fr) 40px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput{height:52px!important;min-height:52px!important;line-height:52px!important;padding-inline:4px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-icon{width:35px!important;height:35px!important;border-radius:12px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn{width:52px!important;min-width:52px!important;height:60px!important;min-height:60px!important;border-radius:18px!important}
}

html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet{
  --v301-field:rgba(36,32,29,.96);--v301-soft:#2d2824;--v301-ink:#fff8f2;--v301-muted:#b7aaa1;--v301-line:rgba(255,248,242,.105);--v301-accent:#F59A62;--v301-accent-soft:rgba(245,154,98,.12);
  background:linear-gradient(180deg,rgba(31,28,26,.985),rgba(23,21,19,.98))!important;
  border-color:rgba(255,248,242,.10)!important;
