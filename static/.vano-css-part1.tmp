  background:rgba(37,33,30,.96)!important;border-color:rgba(255,248,242,.10)!important;color:#f8eee8!important;
}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card:focus-within{
  background:#292420!important;border-color:rgba(245,154,98,.42)!important;box-shadow:0 0 0 4px rgba(245,154,98,.10),0 14px 34px rgba(0,0,0,.28)!important;
}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-icon,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .voice-search-btn{background:#312a25!important;color:#ffc29a!important;border-color:rgba(255,248,242,.08)!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-preset,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-service,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-capabilities span{background:rgba(255,255,255,.035)!important;border-color:rgba(255,248,242,.08)!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .search-results,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .ws-app>.search-results.search-results-portal{background:rgba(31,28,26,.995)!important;border-color:rgba(255,248,242,.10)!important;color:#fff8f2!important;box-shadow:0 24px 68px rgba(0,0,0,.50)!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .search-results .search-item:hover,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .search-results .search-suggestion:hover,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .search-results .search-item:focus-visible,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .search-results .search-suggestion:focus-visible{background:#362e28!important}

/* ========================================================================== 
   VANO MAPS V302 — destination card polish + keyboard/search hardening
   ========================================================================== */
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet{
  border-radius:30px!important;
  box-shadow:0 24px 70px rgba(52,39,31,.17),0 3px 12px rgba(52,39,31,.05),inset 0 1px 0 rgba(255,255,255,.96)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-collapsed{
  height:150px!important;min-height:150px!important;max-height:150px!important;--planner-collapsed-h:150px!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-heading{margin-bottom:10px!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-heading-copy b{font-size:21px!important;letter-spacing:-.7px!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-collapsed .planner-heading-copy b{font-size:18.5px!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card{
  border-radius:21px!important;
  background:linear-gradient(180deg,rgba(255,255,255,.985),rgba(255,253,251,.955))!important;
  box-shadow:0 10px 28px rgba(52,39,31,.07),inset 0 1px 0 rgba(255,255,255,.98)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card:focus-within{
  transform:translateY(-1px)!important;
  border-color:rgba(217,112,63,.46)!important;
  box-shadow:0 0 0 4px rgba(217,112,63,.105),0 15px 36px rgba(52,39,31,.10)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-icon{
  background:linear-gradient(145deg,#FFF0E6,#FFF8F3)!important;
  box-shadow:inset 0 0 0 1px rgba(217,112,63,.04)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput{
  touch-action:manipulation!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput::selection{background:rgba(217,112,63,.16)!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .voice-search-btn,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn{
  touch-action:manipulation!important;
  -webkit-tap-highlight-color:transparent!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn{border-radius:21px!important}
body.vano-map-surface.vano-map-surface .ws-app>.search-results.search-results-portal{
  contain:layout paint!important;
  scroll-padding:8px!important;
  -webkit-overflow-scrolling:touch!important;
}
body.vano-map-surface.vano-map-surface .search-results .search-item,
body.vano-map-surface.vano-map-surface .search-results .search-suggestion{
  touch-action:manipulation!important;
  -webkit-tap-highlight-color:transparent!important;
}
body.vano-map-surface.vano-map-surface .search-results[data-placement="above"]{transform-origin:50% 100%!important}
body.vano-map-surface.vano-map-surface .search-results[data-placement="below"]{transform-origin:50% 0!important}
body.vano-map-surface.vano-map-surface .search-results.show{animation:vanoSearchResultsIn .16s cubic-bezier(.2,.75,.2,1) both!important}
@keyframes vanoSearchResultsIn{from{opacity:0;transform:translateY(3px) scale(.992)}to{opacity:1;transform:translateY(0) scale(1)}}

@media(max-width:899px){
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.planner-search-active{
    border-color:rgba(217,112,63,.14)!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open:not(.body-nav) #planSheet.planner-search-active{
    box-shadow:0 18px 52px rgba(52,39,31,.17),0 0 0 1px rgba(217,112,63,.045)!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open:not(.body-nav) #planSheet.planner-search-active .planner-search-card.search-card{
    transform:none!important;
  }
}
@media(max-width:380px){
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-collapsed{height:144px!important;min-height:144px!important;max-height:144px!important;--planner-collapsed-h:144px!important}
}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card{
  background:linear-gradient(180deg,rgba(39,35,32,.98),rgba(33,30,28,.97))!important;
}
@media(prefers-reduced-motion:reduce){body.vano-map-surface.vano-map-surface .search-results.show{animation:none!important}body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card{transition:none!important}}


/* ========================================================================== 
   VANO MAPS V345 — Samsung/Android keyboard + responsive nearby section
   - The app no longer visually collapses when the IME resizes visualViewport.
   - Expanded planner owns vertical scrolling; "Perto de você" never becomes a
     second nested scroll area where cards disappear behind its own clipping box.
   ========================================================================== */
@media(max-width:899px){
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-expanded{
    height:auto!important;
    min-height:0!important;
    max-height:min(780px,calc(var(--vano-vh,100dvh) - max(16px,env(safe-area-inset-top)) - max(16px,env(safe-area-inset-bottom)) - 82px))!important;
    overflow-x:hidden!important;
    overflow-y:auto!important;
    overscroll-behavior-y:contain!important;
    -webkit-overflow-scrolling:touch!important;
    scrollbar-width:none!important;
    scroll-padding:14px 0 max(22px,env(safe-area-inset-bottom))!important;
  }
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-expanded::-webkit-scrollbar{display:none!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-expanded .planner-expanded{
    display:block!important;
    max-height:none!important;
    height:auto!important;
    overflow:visible!important;
    overscroll-behavior:auto!important;
    padding:12px 1px max(14px,env(safe-area-inset-bottom))!important;
  }
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-section-head{
    min-width:0!important;
    padding-inline:2px!important;
  }
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-services{
    width:100%!important;
    min-width:0!important;
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
    gap:8px!important;
  }
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-service{
    width:100%!important;
    min-width:0!important;
    min-height:72px!important;
    padding:9px 8px!important;
    display:grid!important;
    grid-template-columns:36px minmax(0,1fr)!important;
    grid-template-rows:auto auto!important;
    column-gap:9px!important;
    row-gap:1px!important;
    align-items:center!important;
    text-align:left!important;
    overflow:hidden!important;
  }
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-service .nearby-service-icon{
    grid-row:1 / span 2!important;
    width:36px!important;
    height:36px!important;
    margin:0!important;
  }
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-service b{
    min-width:0!important;
    overflow:hidden!important;
    text-overflow:ellipsis!important;
    white-space:nowrap!important;
    font-size:10.5px!important;
  }
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-service small{
    display:block!important;
    min-width:0!important;
    overflow:hidden!important;
    text-overflow:ellipsis!important;
    white-space:nowrap!important;
    font-size:8px!important;
  }
  /* A focused field must not change the planner's state or scale. Only a card that
     was already collapsed is lifted above the IME; an expanded card keeps its
     geometry and lets the keyboard overlay its lower, non-search content. */
  body.vano-map-surface.vano-map-surface.vano-keyboard-open:not(.body-nav) #planSheet.planner-search-active.sheet-collapsed{
    height:150px!important;
    min-height:150px!important;
    max-height:150px!important;
    bottom:max(8px,calc(var(--vano-keyboard-bottom,0px) + 8px))!important;
    overflow:visible!important;
    transform:translate3d(0,0,0)!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open:not(.body-nav) #planSheet.planner-search-active.sheet-expanded{
    bottom:max(8px,calc(env(safe-area-inset-bottom) + 4px))!important;
    transform:translate3d(0,0,0)!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open:not(.body-nav) #planSheet .planner-search-card.search-card,
body.vano-map-surface.vano-map-surface.vano-keyboard-open:not(.body-nav) #planSheet .planner-location-row.location-row{
    flex:none!important;
    scale:1!important;
  }
}
@media(max-width:380px){
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-services{gap:6px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-service{min-height:68px!important;padding:8px 6px!important;grid-template-columns:32px minmax(0,1fr)!important;column-gap:7px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-service .nearby-service-icon{width:32px!important;height:32px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-service b{font-size:9.5px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-service small{font-size:7.5px!important}
  body.vano-map-surface.vano-map-surface.vano-keyboard-open:not(.body-nav) #planSheet.planner-search-active,
body.vano-map-surface.vano-map-surface.vano-keyboard-open:not(.body-nav) #planSheet.planner-search-active.sheet-collapsed{height:144px!important;min-height:144px!important;max-height:144px!important}
}


/* ========================================================================== 
   VANO MAPS V346 — deterministic mobile address search
   Fixes the IME/focus race that could leave the destination sheet visually
   half-open, move it on every keystroke, and grow suggestions upward.
   The planner state itself is preserved; keyboard search gets a temporary,
   explicit top-anchored surface inside the *visible* viewport.
   ========================================================================== */
@media(max-width:899px){
  body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active,
body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active.sheet-collapsed,
body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active.sheet-expanded{
    top:calc(var(--vano-visible-top,0px) + max(8px,env(safe-area-inset-top)))!important;
    bottom:auto!important;
    height:auto!important;
    min-height:0!important;
    max-height:none!important;
    padding:8px 10px 10px!important;
    overflow:visible!important;
    transform:translate3d(0,0,0)!important;
    -webkit-transform:translate3d(0,0,0)!important;
    transition:none!important;
    contain:none!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active :is(#planGrab,.planner-grab,.grab,.planner-heading,.planner-presets,.planner-expanded,#plannerSmartDestinations,.planner-expand-hint){
    display:none!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active .planner-search-row{
    margin:0!important;
    padding:0!important;
    width:100%!important;
    align-items:center!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active .planner-search-card.search-card{
    transform:none!important;
    margin:0!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active .planner-search-card .location-input#destinationInput,
body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active .planner-search-card .location-input#originInput{
    direction:ltr!important;
    unicode-bidi:plaintext!important;
    text-align:left!important;
    font-size:16px!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #recenterBtn{display:none!important}
  body.vano-map-surface.vano-map-surface .ws-app>.search-results.search-results-portal[data-placement="below"]{
    transform-origin:50% 0!important;
  }
}

/* ========================================================================== 
   VANO MAPS V347 — Samsung/Android address-input stability
   - Keep the focused search field directly above the IME instead of teleporting
     the whole planner to the top-left of the map.
   - Keep a normal LTR editable layer so numeric CEP/address input cannot render
     or compose backwards after visualViewport updates.
   - Suggestions continue opening above the field, preserving the normal planner
     interaction while the keyboard is visible.
   ========================================================================== */
@media(max-width:899px){
  body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active,
body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active.sheet-collapsed,
body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active.sheet-expanded{
    top:auto!important;
    bottom:max(8px,calc(var(--vano-keyboard-bottom,0px) + 8px))!important;
    left:max(8px,env(safe-area-inset-left))!important;
    right:max(8px,env(safe-area-inset-right))!important;
    width:auto!important;
    height:82px!important;
    min-height:82px!important;
    max-height:82px!important;
    padding:8px 10px!important;
    overflow:visible!important;
    transform:none!important;
    -webkit-transform:none!important;
    contain:none!important;
    transition:none!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active :is(#planGrab,.planner-grab,.grab,.planner-heading,.planner-presets,.planner-expanded,#plannerSmartDestinations,.planner-expand-hint){
    display:none!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active .planner-search-row{
    margin:0!important;
    padding:0!important;
    width:100%!important;
    height:64px!important;
    grid-template-columns:minmax(0,1fr) 58px!important;
    gap:8px!important;
    align-items:center!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active .planner-search-card.search-card{
    height:64px!important;
    min-height:64px!important;
    max-height:64px!important;
    margin:0!important;
    transform:none!important;
    -webkit-transform:none!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active .planner-location-row.location-row{
    height:56px!important;
    min-height:56px!important;
    max-height:56px!important;
    transform:none!important;
    -webkit-transform:none!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active .planner-search-card .location-input#destinationInput,
body.vano-map-surface.vano-map-surface.vano-keyboard-open.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active .planner-search-card .location-input#originInput{
    direction:ltr!important;
    unicode-bidi:normal!important;
    writing-mode:horizontal-tb!important;
    text-align:left!important;
    font-size:16px!important;
    transform:none!important;
    -webkit-transform:none!important;
  }
}



/* ===== static/vano-navigation.css ===== */
/* VANO MAPS Navigation V300.2 — canonical orange driver HUD. */
body.vano-map-surface{
  --vano-nav-accent:#F47A45;
  --vano-route-orange:#FF7800;
  --vano-route-orange-light:#FF9D3F;
  --vano-nav-accent-strong:#D96535;
  --vano-nav-accent-soft:#FFF2EA;
  --vano-nav-accent-wash:rgba(244,122,69,.10);
  --vano-nav-ink:#20232A;
  --vano-nav-muted:#858A95;
  --vano-nav-line:rgba(25,28,35,.085);
  --vano-nav-surface:rgba(255,255,255,.975);
  --vano-nav-soft:#F6F7F9;
  --vano-nav-shadow:0 14px 40px rgba(24,27,34,.14),0 2px 8px rgba(24,27,34,.05);
  --vano-safe-bottom:max(8px,env(safe-area-inset-bottom));
  --vano-safe-right:max(10px,env(safe-area-inset-right));
  --vano-safe-left:max(10px,env(safe-area-inset-left));
  --vano-hud-gap:10px;
  --vano-summary-h:58px;
}

/* One sizing model. This layer intentionally wins over legacy map CSS. */
body.vano-map-surface.body-nav #activeNav *,
body.vano-map-surface.body-nav #navManeuverTop *,
body.vano-map-surface.body-nav #navControlStack *{box-sizing:border-box}

/* User marker — orange, compact, high contrast on light and black maps. */
body.vano-map-surface .mapboxgl-marker.vano-user-puck-v300,
body.vano-map-surface .vano-user-puck-v300{
  width:40px!important;height:40px!important;min-width:40px!important;min-height:40px!important;
  display:block!important;visibility:visible!important;opacity:1!important;pointer-events:none!important;
  background:transparent!important;transform-origin:50% 50%!important;z-index:68!important;will-change:transform!important;
}
body.vano-map-surface .vano-user-puck-v300 .vano-puck-inline{width:40px!important;height:40px!important;display:block!important;overflow:visible!important;transform-origin:50% 58%!important;transition:transform .18s cubic-bezier(.2,.8,.2,1),filter .18s ease!important}
body.vano-map-surface .vano-user-puck-v300.is-moving .vano-puck-inline{transform:translateY(-.4px) scale(1.035)!important;filter:drop-shadow(0 2px 2px rgba(255,120,0,.12))!important}
body.vano-map-surface .vano-user-puck-v300 .vano-puck-halo{fill:#fff;stroke:rgba(26,29,36,.16);stroke-width:1.45}
body.vano-map-surface .vano-user-puck-v300 .vano-puck-face{fill:var(--vano-route-orange)!important;stroke:#fff;stroke-width:2.25;stroke-linejoin:round}
body.vano-map-surface .vano-user-puck-v300 .vano-puck-core{fill:rgba(255,255,255,.34);transition:opacity .18s ease!important}body.vano-map-surface .vano-user-puck-v300.is-moving .vano-puck-core{opacity:.92}
body.vano-map-surface .vano-user-puck-v300 .vano-puck-accuracy{
  position:absolute!important;left:50%!important;top:50%!important;width:50px!important;height:50px!important;
  transform:translate(-50%,-50%)!important;border:1px solid rgba(255,120,0,.22)!important;border-radius:50%!important;
  background:rgba(255,120,0,.065)!important;opacity:0!important;transition:opacity .2s ease,width .28s ease,height .28s ease!important;z-index:-1!important;
}
body.vano-map-surface .vano-user-puck-v300.is-gps-weak .vano-puck-accuracy{opacity:1!important;animation:vanoPuckAccuracyPulse 1.8s ease-in-out infinite!important}
html[data-vano-theme="black"] body.vano-map-surface .vano-user-puck-v300 .vano-puck-halo,
body.vano-map-surface[data-mood="night"] .vano-user-puck-v300 .vano-puck-halo{fill:#fff;stroke:rgba(255,255,255,.45)}

@keyframes vanoPuckAccuracyPulse{0%,100%{opacity:.52;transform:translate(-50%,-50%) scale(.96)}50%{opacity:.86;transform:translate(-50%,-50%) scale(1.08)}}

/* Top maneuver card. */
body.vano-map-surface.body-nav #navManeuverTop{
  position:absolute!important;z-index:72!important;
  top:max(10px,calc(env(safe-area-inset-top) + 8px))!important;left:var(--vano-safe-left)!important;right:auto!important;
  width:min(430px,calc(100vw - 20px))!important;min-height:74px!important;height:auto!important;
  padding:9px 11px!important;margin:0!important;display:grid!important;grid-template-columns:52px minmax(0,1fr)!important;
  align-items:center!important;gap:10px!important;border:1px solid var(--vano-nav-line)!important;border-radius:20px!important;
  background:var(--vano-nav-surface)!important;color:var(--vano-nav-ink)!important;box-shadow:0 10px 32px rgba(24,27,34,.13)!important;
  backdrop-filter:blur(20px) saturate(135%)!important;-webkit-backdrop-filter:blur(20px) saturate(135%)!important;
  transform:none!important;overflow:hidden!important;
}
body.vano-map-surface.body-nav #navManeuverTop:after{content:"";position:absolute;inset:auto 0 0;height:2px;background:linear-gradient(90deg,var(--vano-nav-accent),rgba(244,122,69,0));opacity:.9}
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{
  width:52px!important;height:52px!important;min-width:52px!important;border-radius:15px!important;
  background:var(--vano-nav-accent-soft)!important;color:var(--vano-nav-accent-strong)!important;display:grid!important;place-items:center!important;
}
body.vano-map-surface.body-nav #navManeuverTop .maneuver-glyph{font-size:30px!important;font-weight:850!important;line-height:1!important;color:var(--vano-nav-accent-strong)!important;transform:none!important}
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy{min-width:0!important;display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;grid-template-rows:auto auto!important;align-items:end!important;column-gap:9px!important}
body.vano-map-surface.body-nav #navManeuverTop small{grid-column:1/-1!important;margin:0 0 3px!important;font-size:7.5px!important;line-height:1!important;letter-spacing:.11em!important;font-weight:850!important;color:#9296A0!important}
body.vano-map-surface.body-nav #navManeuverTop b{min-width:0!important;font-size:17px!important;line-height:1.12!important;letter-spacing:-.35px!important;color:var(--vano-nav-ink)!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important}
body.vano-map-surface.body-nav #navManeuverTop #nextDistance{font-size:14px!important;line-height:1!important;font-weight:850!important;color:var(--vano-nav-accent-strong)!important;white-space:nowrap!important}
body.vano-map-surface.body-nav.nav-drive-turn #navManeuverTop,
body.vano-map-surface.body-nav.nav-drive-junction #navManeuverTop,
body.vano-map-surface.body-nav.nav-drive-roundabout #navManeuverTop{box-shadow:0 12px 36px rgba(24,27,34,.15),0 0 0 2px rgba(244,122,69,.10)!important}

/* Bottom trip information card — compact, stable and readable at a glance. */
body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal{
  position:absolute!important;z-index:71!important;left:var(--vano-safe-left)!important;right:var(--vano-safe-right)!important;
  bottom:var(--vano-safe-bottom)!important;top:auto!important;width:auto!important;max-width:none!important;min-height:72px!important;height:auto!important;
  padding:7px!important;margin:0!important;border:1px solid var(--vano-nav-line)!important;border-radius:22px!important;
  background:var(--vano-nav-surface)!important;color:var(--vano-nav-ink)!important;box-shadow:var(--vano-nav-shadow)!important;
  backdrop-filter:blur(22px) saturate(135%)!important;-webkit-backdrop-filter:blur(22px) saturate(135%)!important;
  overflow:visible!important;transform:translate3d(0,calc(100% + 30px),0)!important;opacity:0!important;
  transition:transform .22s cubic-bezier(.2,.8,.2,1),opacity .16s ease!important;
}
body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal.show{transform:translate3d(0,0,0)!important;opacity:1!important}
body.vano-map-surface.body-nav #activeNav .vano-nav-dock-head{display:none!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-row{
  width:100%!important;min-width:0!important;height:var(--vano-summary-h)!important;min-height:var(--vano-summary-h)!important;
  display:grid!important;grid-template-columns:1.18fr .94fr .98fr!important;gap:0!important;align-items:stretch!important;
  border:1px solid rgba(25,28,35,.045)!important;border-radius:16px!important;background:var(--vano-nav-soft)!important;overflow:hidden!important;
}
body.vano-map-surface.body-nav #activeNav .nav-summary-item,
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{
  min-width:0!important;height:100%!important;padding:8px 10px!important;margin:0!important;border:0!important;border-radius:0!important;
  background:transparent!important;box-shadow:none!important;display:flex!important;flex-direction:column!important;align-items:flex-start!important;justify-content:center!important;text-align:left!important;
}
body.vano-map-surface.body-nav #activeNav .nav-summary-item + .nav-summary-item{border-left:1px solid rgba(25,28,35,.065)!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{background:linear-gradient(135deg,#FFF5EF 0%,#FFF9F6 100%)!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-label{width:100%!important;min-width:0!important;margin:0 0 4px!important;display:flex!important;align-items:center!important;gap:4px!important;line-height:1!important;color:#969AA4!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-label svg{width:10px!important;height:10px!important;min-width:10px!important;color:#989CA5!important;stroke-width:2!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-primary .nav-summary-label svg{color:var(--vano-nav-accent-strong)!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-item small{min-width:0!important;margin:0!important;font-size:6.8px!important;line-height:1!important;letter-spacing:.095em!important;font-weight:850!important;color:#9498A2!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{display:block!important;width:100%!important;max-width:100%!important;margin:0!important;font-size:16px!important;line-height:1.05!important;letter-spacing:-.5px!important;font-weight:850!important;color:#252830!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;font-variant-numeric:tabular-nums!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-primary strong{font-size:20px!important;letter-spacing:-.75px!important;color:var(--vano-nav-accent-strong)!important}
body.vano-map-surface.body-nav #activeNav #navSearchBtn{display:none!important}

/* Traffic suggestion and reroute live inside the same card without breaking its width. */
body.vano-map-surface.body-nav #activeNav .traffic-suggestion{margin-top:7px!important;border:1px solid rgba(244,122,69,.15)!important;border-radius:15px!important;background:#FFF9F5!important;box-shadow:none!important;overflow:hidden!important}
body.vano-map-surface.body-nav #activeNav .traffic-suggestion-icon{background:var(--vano-nav-accent-soft)!important;color:var(--vano-nav-accent-strong)!important}
body.vano-map-surface.body-nav #activeNav .traffic-suggestion small{color:#8D9098!important}body.vano-map-surface.body-nav #activeNav .traffic-suggestion b{color:#24272E!important}body.vano-map-surface.body-nav #activeNav .traffic-suggestion span{color:#747984!important}
body.vano-map-surface.body-nav #activeNav .traffic-accept{background:var(--vano-nav-accent)!important;color:#fff!important;border:0!important}
body.vano-map-surface.body-nav #activeNav .traffic-dismiss{background:#F0F1F4!important;color:#656A74!important;border:0!important}
body.vano-map-surface.body-nav #activeNav .reroute{max-width:100%!important;margin-top:6px!important;color:#737781!important}body.vano-map-surface .loading{border-top-color:var(--vano-nav-accent)!important}

/* Road name is visually attached to navigation, but does not overlap controls. */
body.vano-map-surface.body-nav #navStreetChip{
  position:absolute!important;z-index:69!important;left:50%!important;right:auto!important;top:auto!important;
  bottom:calc(var(--vano-safe-bottom) + 82px)!important;width:auto!important;max-width:min(62vw,400px)!important;min-height:32px!important;height:32px!important;
  padding:0 12px!important;border:1px solid rgba(25,28,35,.09)!important;border-radius:12px!important;background:rgba(255,255,255,.955)!important;
  color:#565B65!important;box-shadow:0 7px 22px rgba(24,27,34,.10)!important;backdrop-filter:blur(16px)!important;-webkit-backdrop-filter:blur(16px)!important;
  transform:translateX(-50%)!important;display:flex!important;align-items:center!important;justify-content:center!important;overflow:hidden!important;
}
body.vano-map-surface.body-nav #navStreetChip span{min-width:0!important;max-width:100%!important;font-size:11px!important;line-height:1!important;font-weight:750!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}

/* Driver controls — same geometry and same neutral surface. */
body.vano-map-surface.body-nav #navControlStack{
  position:absolute!important;z-index:74!important;right:var(--vano-safe-right)!important;bottom:calc(var(--vano-safe-bottom) + 84px)!important;top:auto!important;
  width:42px!important;min-width:42px!important;display:flex!important;flex-direction:column!important;gap:7px!important;align-items:center!important;transform:none!important;
}
body.vano-map-surface.body-nav #navExitBtn,
body.vano-map-surface.body-nav #quickAlertBtn,
body.vano-map-surface.body-nav #navDrawerRecenter,
body.vano-map-surface.body-nav #soundBtn,
body.vano-map-surface.body-nav #navDrawerToggle{
  box-sizing:border-box!important;width:42px!important;height:42px!important;min-width:42px!important;min-height:42px!important;max-width:42px!important;max-height:42px!important;
  margin:0!important;padding:0!important;border:1px solid var(--vano-nav-line)!important;border-radius:13px!important;background:rgba(255,255,255,.97)!important;
  color:#606570!important;box-shadow:0 7px 20px rgba(24,27,34,.10)!important;display:grid!important;place-items:center!important;backdrop-filter:blur(16px)!important;-webkit-backdrop-filter:blur(16px)!important;
}
body.vano-map-surface.body-nav #navExitBtn{color:#B84D55!important}body.vano-map-surface.body-nav #quickAlertBtn{color:var(--vano-nav-accent-strong)!important}body.vano-map-surface.body-nav #navDrawerRecenter{color:var(--vano-nav-accent-strong)!important}
body.vano-map-surface.body-nav #soundBtn.active{background:var(--vano-nav-accent-soft)!important;color:var(--vano-nav-accent-strong)!important;border-color:rgba(244,122,69,.18)!important}
body.vano-map-surface.body-nav #navExitBtn:active,
body.vano-map-surface.body-nav #quickAlertBtn:active,
body.vano-map-surface.body-nav #navDrawerRecenter:active,
body.vano-map-surface.body-nav #soundBtn:active,
body.vano-map-surface.body-nav #navDrawerToggle:active{transform:scale(.94)!important}

/* Speedometer. */
body.vano-map-surface.body-nav #vanoSpeedometerV220{
  position:absolute!important;z-index:70!important;left:var(--vano-safe-left)!important;bottom:calc(var(--vano-safe-bottom) + 84px)!important;
  width:48px!important;height:48px!important;min-width:48px!important;min-height:48px!important;padding:0!important;
  border:2px solid rgba(25,28,35,.11)!important;border-radius:15px!important;background:rgba(255,255,255,.97)!important;color:var(--vano-nav-ink)!important;
  box-shadow:0 7px 22px rgba(24,27,34,.11)!important;display:grid!important;place-items:center!important;pointer-events:none!important;
}
body.vano-map-surface.body-nav #vanoSpeedometerV220 strong{font-size:17px!important;line-height:1!important;font-weight:880!important;letter-spacing:-.45px!important;color:inherit!important;font-variant-numeric:tabular-nums!important}
body.vano-map-surface.body-nav #vanoSpeedometerV220.over-limit{border-color:#D84B57!important;color:#C73744!important;background:#FFF7F7!important}

/* Camera state feedback. */
body.vano-map-surface.body-nav[data-nav-camera-state="FREE_LOOK"] #navDrawerRecenter{animation:vanoRecenterPulse 1.7s ease-in-out infinite}
body.vano-map-surface.body-nav[data-nav-camera-state="REROUTING"] #rerouteNotice.show{display:flex!important}
body.vano-map-surface.body-nav[data-nav-camera-state="ARRIVAL"] #navManeuverTop{opacity:.72!important}
@keyframes vanoRecenterPulse{0%,100%{box-shadow:0 7px 20px rgba(24,27,34,.10)}50%{box-shadow:0 7px 25px rgba(244,122,69,.27)}}

/* Alert library: orange for normal navigation alerts, red only for danger. */
body.vano-map-surface .route-marker.alert-marker{width:44px!important;height:48px!important;min-width:44px!important;min-height:48px!important;overflow:visible!important;background:transparent!important;border:0!important;padding:0!important;filter:none!important;transform-origin:50% 100%!important}
body.vano-map-surface .route-marker.alert-marker .alert-visual{width:44px!important;height:46px!important;transform:none!important;display:block!important;position:relative!important}
body.vano-map-surface .route-marker.alert-marker .alert-ground{position:absolute!important;left:50%!important;bottom:0!important;width:22px!important;height:6px!important;transform:translateX(-50%)!important;border-radius:50%!important;background:rgba(20,21,28,.12)!important;filter:blur(2px)!important}
body.vano-map-surface .route-marker.alert-marker .alert-bubble{position:absolute!important;left:50%!important;bottom:5px!important;width:40px!important;height:40px!important;transform:translateX(-50%)!important;border-radius:14px 14px 14px 5px!important;background:rgba(255,255,255,.98)!important;border:1px solid rgba(25,28,35,.09)!important;box-shadow:0 6px 16px rgba(23,24,32,.13)!important;display:grid!important;place-items:center!important}
body.vano-map-surface .route-marker.alert-marker .alert-ring,
body.vano-map-surface .route-marker.alert-marker .alert-face,
body.vano-map-surface .route-marker.alert-marker .alert-icon{width:30px!important;height:30px!important;display:grid!important;place-items:center!important}body.vano-map-surface .route-marker.alert-marker .alert-ring{border-radius:10px!important;background:var(--vano-nav-accent-wash)!important}body.vano-map-surface .route-marker.alert-marker .alert-icon-svg{width:24px!important;height:24px!important}body.vano-map-surface .route-marker.alert-marker .alert-icon-svg .fg{fill:#424751!important}body.vano-map-surface .route-marker.alert-marker .alert-icon-svg .light{fill:#fff!important}body.vano-map-surface .route-marker.alert-marker .alert-icon-svg .accent{fill:var(--vano-nav-accent)!important}body.vano-map-surface .route-marker.alert-marker .alert-icon-svg .stroke{fill:none!important;stroke:#5E6370!important;stroke-width:1.4!important;stroke-linecap:round!important;stroke-linejoin:round!important}body.vano-map-surface .route-marker.alert-marker .alert-icon-svg .stroke-fill{fill:#fff!important;stroke:#5E6370!important;stroke-width:1.2!important}
body.vano-map-surface .route-marker.alert-marker[data-kind="security"] .alert-ring,
body.vano-map-surface .route-marker.alert-marker[data-kind="accident"] .alert-ring,
body.vano-map-surface .route-marker.alert-marker[data-kind="block"] .alert-ring{background:rgba(216,75,87,.10)!important}body.vano-map-surface .route-marker.alert-marker[data-kind="security"] .alert-icon-svg .accent,
body.vano-map-surface .route-marker.alert-marker[data-kind="accident"] .alert-icon-svg .accent,
body.vano-map-surface .route-marker.alert-marker[data-kind="block"] .alert-icon-svg .accent{fill:#D84B57!important}
body.vano-map-surface.body-nav.nav-drive-fast .route-marker.alert-marker{opacity:.86!important;transform:scale(.94)!important}

/* Small portrait phones. */
@media (max-width:390px){
  body.vano-map-surface{--vano-summary-h:54px;--vano-safe-left:max(8px,env(safe-area-inset-left));--vano-safe-right:max(8px,env(safe-area-inset-right))}
  body.vano-map-surface.body-nav #navManeuverTop{width:calc(100vw - 16px)!important;grid-template-columns:48px minmax(0,1fr)!important;min-height:68px!important;padding:8px 9px!important;border-radius:18px!important}
  body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{width:48px!important;height:48px!important;border-radius:14px!important}body.vano-map-surface.body-nav #navManeuverTop .maneuver-glyph{font-size:28px!important}body.vano-map-surface.body-nav #navManeuverTop b{font-size:15px!important}body.vano-map-surface.body-nav #navManeuverTop #nextDistance{font-size:12.5px!important}
  body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal{padding:6px!important;border-radius:19px!important;min-height:66px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item,
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{padding:7px 7px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{font-size:14px!important}body.vano-map-surface.body-nav #activeNav .nav-summary-primary strong{font-size:18px!important}body.vano-map-surface.body-nav #activeNav .nav-summary-item small{font-size:6.2px!important}
  body.vano-map-surface.body-nav #navStreetChip{bottom:calc(var(--vano-safe-bottom) + 76px)!important;max-width:58vw!important;height:30px!important;min-height:30px!important}
  body.vano-map-surface.body-nav #navControlStack{right:var(--vano-safe-right)!important;bottom:calc(var(--vano-safe-bottom) + 78px)!important}
  body.vano-map-surface.body-nav #vanoSpeedometerV220{left:var(--vano-safe-left)!important;bottom:calc(var(--vano-safe-bottom) + 78px)!important;width:46px!important;height:46px!important;min-width:46px!important;min-height:46px!important}
  body.vano-map-surface .mapboxgl-marker.vano-user-puck-v300,
body.vano-map-surface .vano-user-puck-v300{width:38px!important;height:38px!important;min-width:38px!important;min-height:38px!important}body.vano-map-surface .vano-user-puck-v300 .vano-puck-inline{width:38px!important;height:38px!important}
}
@media (max-width:350px){body.vano-map-surface.body-nav #activeNav .nav-summary-item,
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{padding:6px 5px!important}body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{font-size:12.5px!important}body.vano-map-surface.body-nav #activeNav .nav-summary-primary strong{font-size:16.5px!important}body.vano-map-surface.body-nav #activeNav .nav-summary-item small{font-size:5.7px!important}}

/* Landscape: left information rail + right controls, with the map kept open in the middle. */
@media (orientation:landscape) and (max-height:650px){
  body.vano-map-surface{--vano-safe-left:max(10px,env(safe-area-inset-left));--vano-safe-right:max(10px,env(safe-area-inset-right));--vano-summary-h:52px}
  body.vano-map-surface.body-nav #navManeuverTop{left:var(--vano-safe-left)!important;top:max(8px,calc(env(safe-area-inset-top) + 6px))!important;width:min(320px,36vw)!important;min-height:64px!important;grid-template-columns:44px minmax(0,1fr)!important;padding:7px 9px!important;border-radius:18px!important}
  body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{width:44px!important;height:44px!important;border-radius:13px!important}body.vano-map-surface.body-nav #navManeuverTop .maneuver-glyph{font-size:26px!important}body.vano-map-surface.body-nav #navManeuverTop small{display:none!important}body.vano-map-surface.body-nav #navManeuverTop b{font-size:14px!important}body.vano-map-surface.body-nav #navManeuverTop #nextDistance{font-size:12px!important}
  body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal{left:var(--vano-safe-left)!important;right:auto!important;bottom:var(--vano-safe-bottom)!important;width:min(320px,36vw)!important;padding:6px!important;border-radius:19px!important;min-height:64px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-row{grid-template-columns:1.15fr .93fr .98fr!important}body.vano-map-surface.body-nav #activeNav .nav-summary-item,
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{padding:6px 7px!important}body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{font-size:13px!important}body.vano-map-surface.body-nav #activeNav .nav-summary-primary strong{font-size:16px!important}body.vano-map-surface.body-nav #activeNav .nav-summary-item small{font-size:5.8px!important}
  body.vano-map-surface.body-nav #navStreetChip{left:calc(var(--vano-safe-left) + min(160px,18vw))!important;bottom:calc(var(--vano-safe-bottom) + 74px)!important;max-width:min(300px,34vw)!important}
  body.vano-map-surface.body-nav #navControlStack{right:var(--vano-safe-right)!important;bottom:var(--vano-safe-bottom)!important;flex-direction:row!important;width:auto!important;min-width:0!important}
  body.vano-map-surface.body-nav #vanoSpeedometerV220{left:auto!important;right:var(--vano-safe-right)!important;bottom:calc(var(--vano-safe-bottom) + 50px)!important}
  body.vano-map-surface .mapboxgl-marker.vano-user-puck-v300,
body.vano-map-surface .vano-user-puck-v300{width:36px!important;height:36px!important;min-width:36px!important;min-height:36px!important}body.vano-map-surface .vano-user-puck-v300 .vano-puck-inline{width:36px!important;height:36px!important}
}

/* Black mode preserves hierarchy and orange identity. */
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navManeuverTop,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navStreetChip,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navExitBtn,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #quickAlertBtn,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navDrawerRecenter,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #soundBtn,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navDrawerToggle,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #vanoSpeedometerV220{background:rgba(25,26,31,.97)!important;color:#F5F5F7!important;border-color:rgba(255,255,255,.10)!important}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .nav-summary-row{background:#202126!important;border-color:rgba(255,255,255,.06)!important}html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .nav-summary-item,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .nav-summary-primary{background:transparent!important}html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .nav-summary-primary{background:rgba(244,122,69,.09)!important}html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .nav-summary-item + .nav-summary-item{border-left-color:rgba(255,255,255,.07)!important}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navManeuverTop b,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{color:#F5F5F7!important}html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .nav-summary-primary strong,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navManeuverTop #nextDistance{color:#FF9A6B!important}html[data-vano-theme="black"] body.vano-map-surface.body-nav #navStreetChip{color:#D5D6DB!important}html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .traffic-suggestion{background:rgba(244,122,69,.08)!important;border-color:rgba(244,122,69,.16)!important}html[data-vano-theme="black"] body.vano-map-surface .route-marker.alert-marker .alert-bubble{background:rgba(27,28,34,.98)!important;border-color:rgba(255,255,255,.10)!important;box-shadow:0 7px 18px rgba(0,0,0,.28)!important}html[data-vano-theme="black"] body.vano-map-surface .route-marker.alert-marker .alert-icon-svg .fg{fill:#E8E8ED!important}html[data-vano-theme="black"] body.vano-map-surface .route-marker.alert-marker .alert-icon-svg .stroke{stroke:#CACBD1!important}

@media (prefers-reduced-motion:reduce){body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal,
body.vano-map-surface .vano-user-puck-v300 .vano-puck-accuracy,
body.vano-map-surface .vano-user-puck-v300 .vano-puck-inline,
body.vano-map-surface.body-nav #navExitBtn,
body.vano-map-surface.body-nav #quickAlertBtn,
body.vano-map-surface.body-nav #navDrawerRecenter,
body.vano-map-surface.body-nav #soundBtn,
body.vano-map-surface.body-nav #navDrawerToggle{transition:none!important;animation:none!important}}

/* ========================================================================== 
   VANO MAPS V302 — driver HUD polish
   Modernizes the active-trip information card and camera-state feedback while
   preserving the V300 navigation DOM/API contract.
   ========================================================================== */
body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal{
  --vano-trip-accent:#F47A45;
  min-height:108px!important;
  padding:8px!important;
  border-radius:25px!important;
  border-color:rgba(28,31,38,.08)!important;
  background:linear-gradient(180deg,rgba(255,255,255,.985),rgba(252,252,253,.965))!important;
  box-shadow:0 18px 52px rgba(24,27,34,.16),0 2px 8px rgba(24,27,34,.055)!important;
  overflow:hidden!important;
}
body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal:before{
  content:"";position:absolute;inset:0 auto auto 0;width:100%;height:1px;pointer-events:none;
  background:linear-gradient(90deg,rgba(255,255,255,.92),rgba(255,255,255,.2));
}
body.vano-map-surface.body-nav #activeNav .vano-nav-tripline{
  position:relative!important;width:100%!important;min-width:0!important;height:34px!important;
  padding:0 7px 6px!important;display:grid!important;grid-template-columns:26px minmax(0,1fr) auto!important;
  align-items:center!important;gap:7px!important;
}
body.vano-map-surface.body-nav #activeNav .vano-nav-trip-icon{
  width:25px!important;height:25px!important;border-radius:9px!important;display:grid!important;place-items:center!important;
  color:var(--vano-nav-accent-strong)!important;background:var(--vano-nav-accent-soft)!important;
}
body.vano-map-surface.body-nav #activeNav .vano-nav-trip-icon svg{width:13px!important;height:13px!important;stroke-width:2.3!important}
body.vano-map-surface.body-nav #activeNav .vano-nav-trip-copy{min-width:0!important;display:flex!important;flex-direction:column!important;justify-content:center!important;gap:1px!important}
body.vano-map-surface.body-nav #activeNav .vano-nav-trip-copy small{
  min-width:0!important;margin:0!important;color:#989CA5!important;font-size:6.4px!important;line-height:1.05!important;
  font-weight:850!important;letter-spacing:.09em!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;
}
body.vano-map-surface.body-nav #activeNav .vano-nav-trip-copy b{
  min-width:0!important;margin:0!important;color:#252830!important;font-size:11.5px!important;line-height:1.12!important;
  font-weight:790!important;letter-spacing:-.18px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;
}
body.vano-map-surface.body-nav #activeNav .vano-nav-trip-live{
  min-width:0!important;height:22px!important;padding:0 8px!important;border:1px solid rgba(244,122,69,.14)!important;border-radius:999px!important;
  display:inline-flex!important;align-items:center!important;gap:5px!important;background:#FFF7F2!important;color:#BA5D34!important;
  font-size:6.2px!important;font-weight:900!important;letter-spacing:.09em!important;white-space:nowrap!important;
}
body.vano-map-surface.body-nav #activeNav .vano-nav-trip-live i{width:5px!important;height:5px!important;border-radius:50%!important;background:var(--vano-nav-accent)!important;box-shadow:0 0 0 3px rgba(244,122,69,.10)!important}
body.vano-map-surface.body-nav #activeNav .vano-nav-progress{
  position:relative!important;width:calc(100% - 14px)!important;height:3px!important;margin:-1px 7px 6px!important;
  border-radius:999px!important;background:rgba(30,33,40,.065)!important;overflow:hidden!important;
}
body.vano-map-surface.body-nav #activeNav .vano-nav-progress span{
  position:absolute!important;inset:0 auto 0 0!important;width:0%;max-width:100%!important;border-radius:inherit!important;
  background:linear-gradient(90deg,#F47A45,#FF9D71)!important;box-shadow:0 0 10px rgba(244,122,69,.22)!important;
  transition:width .55s cubic-bezier(.22,.72,.2,1)!important;will-change:width!important;
}
body.vano-map-surface.body-nav #activeNav .nav-summary-row{
  height:58px!important;min-height:58px!important;border-radius:17px!important;border-color:rgba(25,28,35,.04)!important;
  background:#F5F6F8!important;
}
body.vano-map-surface.body-nav #activeNav .nav-summary-item,
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{padding:8px 11px!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{background:linear-gradient(135deg,#FFF2E9 0%,#FFF9F5 100%)!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{font-size:16.5px!important;letter-spacing:-.55px!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-primary strong{font-size:21px!important;letter-spacing:-.8px!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-label{margin-bottom:4px!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-item small{font-size:6.5px!important}

/* Maneuver card: clearer hierarchy and a distance chip that stays readable. */
body.vano-map-surface.body-nav #navManeuverTop{
  width:min(448px,calc(100vw - 20px))!important;min-height:78px!important;padding:10px 12px!important;
  grid-template-columns:56px minmax(0,1fr)!important;gap:11px!important;border-radius:22px!important;
  border-color:rgba(28,31,38,.08)!important;background:linear-gradient(180deg,rgba(255,255,255,.988),rgba(252,252,253,.97))!important;
  box-shadow:0 14px 40px rgba(24,27,34,.145),0 2px 8px rgba(24,27,34,.035)!important;
  transition:box-shadow .2s ease,transform .2s ease,opacity .2s ease!important;
}
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{width:56px!important;height:56px!important;border-radius:17px!important;background:linear-gradient(145deg,#FFF0E6,#FFF7F2)!important}
body.vano-map-surface.body-nav #navManeuverTop .maneuver-glyph{font-size:32px!important}
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy{align-items:center!important;row-gap:2px!important}
body.vano-map-surface.body-nav #navManeuverTop small{margin-bottom:1px!important;font-size:7px!important}
body.vano-map-surface.body-nav #navManeuverTop b{font-size:17.5px!important;line-height:1.12!important;font-weight:825!important}
body.vano-map-surface.body-nav #navManeuverTop #nextDistance{
  min-width:52px!important;padding:7px 9px!important;border-radius:10px!important;background:var(--vano-nav-accent-soft)!important;
  font-size:13px!important;text-align:center!important;
}
body.vano-map-surface.body-nav.nav-drive-turn #navManeuverTop,
body.vano-map-surface.body-nav.nav-drive-junction #navManeuverTop,
body.vano-map-surface.body-nav.nav-drive-roundabout #navManeuverTop{
  transform:translateY(1px)!important;box-shadow:0 16px 44px rgba(24,27,34,.17),0 0 0 2px rgba(244,122,69,.095)!important;
}

/* Driver controls: larger touch targets without visually taking over the map. */
body.vano-map-surface.body-nav #navControlStack{width:46px!important;min-width:46px!important;gap:8px!important}
body.vano-map-surface.body-nav #navExitBtn,
body.vano-map-surface.body-nav #quickAlertBtn,
body.vano-map-surface.body-nav #navDrawerRecenter,
body.vano-map-surface.body-nav #soundBtn,
body.vano-map-surface.body-nav #navDrawerToggle{
  width:46px!important;height:46px!important;min-width:46px!important;min-height:46px!important;max-width:46px!important;max-height:46px!important;
  border-radius:15px!important;box-shadow:0 9px 24px rgba(24,27,34,.105)!important;transition:transform .14s ease,box-shadow .18s ease,background .18s ease!important;
}
body.vano-map-surface.body-nav #navDrawerRecenter{background:#FFF8F3!important;border-color:rgba(244,122,69,.16)!important}
body.vano-map-surface.body-nav[data-nav-camera-state="FREE_LOOK"] #navDrawerRecenter{background:var(--vano-nav-accent)!important;color:#fff!important;border-color:transparent!important}
body.vano-map-surface.body-nav #vanoSpeedometerV220{
  width:52px!important;height:52px!important;min-width:52px!important;min-height:52px!important;border-radius:17px!important;
  border-width:1px!important;box-shadow:0 9px 24px rgba(24,27,34,.11)!important;
}
body.vano-map-surface.body-nav #vanoSpeedometerV220:after{content:"km/h";position:absolute;bottom:6px;font-size:5.6px;line-height:1;font-weight:850;letter-spacing:.04em;color:#9A9EA7}
body.vano-map-surface.body-nav #vanoSpeedometerV220 strong{transform:translateY(-4px);font-size:18px!important}

/* Free-look state is explicit: driver knows a single tap returns to route follow. */
body.vano-map-surface.body-nav.nav-map-free #navStreetChip:before{content:"CÂMERA LIVRE · ";font-size:7px;font-weight:900;letter-spacing:.06em;color:var(--vano-nav-accent-strong)}
body.vano-map-surface.body-nav.nav-map-free #activeNav .vano-nav-trip-copy small{color:var(--vano-nav-accent-strong)!important}
body.vano-map-surface.body-nav.nav-map-free #activeNav .vano-nav-trip-icon{background:var(--vano-nav-accent)!important;color:#fff!important}

@media (max-width:390px){
  body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal{min-height:101px!important;padding:7px!important;border-radius:22px!important}
  body.vano-map-surface.body-nav #activeNav .vano-nav-tripline{height:31px!important;padding:0 5px 5px!important;grid-template-columns:24px minmax(0,1fr) auto!important;gap:6px!important}
  body.vano-map-surface.body-nav #activeNav .vano-nav-trip-icon{width:23px!important;height:23px!important;border-radius:8px!important}
  body.vano-map-surface.body-nav #activeNav .vano-nav-trip-copy b{font-size:10.5px!important}
  body.vano-map-surface.body-nav #activeNav .vano-nav-trip-copy small{font-size:5.8px!important}
  body.vano-map-surface.body-nav #activeNav .vano-nav-trip-live{height:20px!important;padding:0 6px!important;font-size:5.5px!important}
  body.vano-map-surface.body-nav #activeNav .vano-nav-progress{margin-bottom:5px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-row{height:54px!important;min-height:54px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item,
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{padding:7px 7px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{font-size:14px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-primary strong{font-size:18.5px!important}
  body.vano-map-surface.body-nav #navManeuverTop{min-height:72px!important;grid-template-columns:50px minmax(0,1fr)!important;padding:9px 10px!important;border-radius:20px!important}
  body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{width:50px!important;height:50px!important;border-radius:15px!important}
  body.vano-map-surface.body-nav #navManeuverTop .maneuver-glyph{font-size:29px!important}
  body.vano-map-surface.body-nav #navManeuverTop b{font-size:15.5px!important}
  body.vano-map-surface.body-nav #navManeuverTop #nextDistance{min-width:48px!important;padding:6px 7px!important;font-size:12px!important}
  body.vano-map-surface.body-nav #navControlStack{width:44px!important;min-width:44px!important}
  body.vano-map-surface.body-nav #navExitBtn,
body.vano-map-surface.body-nav #quickAlertBtn,
body.vano-map-surface.body-nav #navDrawerRecenter,
body.vano-map-surface.body-nav #soundBtn,
body.vano-map-surface.body-nav #navDrawerToggle{width:44px!important;height:44px!important;min-width:44px!important;min-height:44px!important;max-width:44px!important;max-height:44px!important}
  body.vano-map-surface.body-nav #vanoSpeedometerV220{width:49px!important;height:49px!important;min-width:49px!important;min-height:49px!important}
}

@media (orientation:landscape) and (max-height:650px){
  body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal{min-height:68px!important;padding:6px!important}
  body.vano-map-surface.body-nav #activeNav .vano-nav-tripline,
body.vano-map-surface.body-nav #activeNav .vano-nav-progress{display:none!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-row{height:54px!important;min-height:54px!important}
}

html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navManeuverTop{
  background:linear-gradient(180deg,rgba(27,28,33,.985),rgba(22,23,27,.975))!important;border-color:rgba(255,255,255,.09)!important;
}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .vano-nav-trip-copy b{color:#F5F5F7!important}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .vano-nav-trip-copy small{color:#8E929C!important}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .vano-nav-trip-live{background:rgba(244,122,69,.10)!important;border-color:rgba(244,122,69,.18)!important;color:#FFAA82!important}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .vano-nav-progress{background:rgba(255,255,255,.08)!important}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .nav-summary-row{background:#1E1F24!important}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{background:rgba(244,122,69,.10)!important}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navManeuverTop #nextDistance{background:rgba(244,122,69,.11)!important;color:#FF9A6B!important}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #vanoSpeedometerV220:after{color:#81858F}

@media (prefers-reduced-motion:reduce){body.vano-map-surface.body-nav #activeNav .vano-nav-progress span,
body.vano-map-surface.body-nav #navManeuverTop,
body.vano-map-surface.body-nav #navExitBtn,
body.vano-map-surface.body-nav #quickAlertBtn,
body.vano-map-surface.body-nav #navDrawerRecenter,
body.vano-map-surface.body-nav #soundBtn,
body.vano-map-surface.body-nav #navDrawerToggle{transition:none!important}}

/* Pre-trip route card — compact decision surface before the driver starts. */
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState.vano-route-studio .vano-route-hero{
  position:relative!important;margin:2px 0 11px!important;padding:15px 15px 14px!important;overflow:hidden!important;
  border:1px solid rgba(28,31,38,.07)!important;border-radius:23px!important;
  background:radial-gradient(circle at 94% 4%,rgba(244,122,69,.13),transparent 34%),linear-gradient(145deg,#FFFFFF,#FFF9F5)!important;
  box-shadow:0 14px 36px rgba(42,33,28,.085),inset 0 1px 0 rgba(255,255,255,.96)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState.vano-route-studio .vano-route-hero:after{
  content:"";position:absolute;left:15px;right:15px;bottom:0;height:2px;border-radius:99px;background:linear-gradient(90deg,var(--vano-nav-accent),rgba(244,122,69,0));opacity:.72;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState .route-head{align-items:center!important;gap:12px!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState .vr-eyebrow{font-size:7.5px!important;letter-spacing:.15em!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState h2{font-size:22px!important;letter-spacing:-.78px!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState .route-time{
  min-width:76px!important;padding:10px 11px!important;border:1px solid rgba(244,122,69,.12)!important;border-radius:16px!important;
  background:rgba(255,255,255,.76)!important;box-shadow:0 6px 18px rgba(44,33,27,.05)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState .route-time span{font-size:27px!important;color:var(--vano-nav-accent-strong)!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment{
  grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:5px!important;padding:4px!important;border-radius:18px!important;background:#F3F4F6!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment button{min-width:0!important;min-height:48px!important;padding:6px 5px!important;border-radius:14px!important;gap:5px!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment .route-option-copy{min-width:0!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment .route-option-copy b{max-width:100%!important;font-size:10.5px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment .route-option-copy small{display:none!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment button.active{box-shadow:0 4px 14px rgba(26,29,36,.085)!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #startTripBtn{
  min-height:60px!important;border-radius:20px!important;background:linear-gradient(135deg,#F47A45,#E56832)!important;
  box-shadow:0 14px 32px rgba(229,104,50,.28),inset 0 1px 0 rgba(255,255,255,.24)!important;
  transition:transform .16s ease,box-shadow .18s ease,filter .18s ease!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #startTripBtn:hover{transform:translateY(-1px)!important;box-shadow:0 17px 38px rgba(229,104,50,.32),inset 0 1px 0 rgba(255,255,255,.26)!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #startTripBtn:active{transform:scale(.988)!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeVariants .route-variant{border-radius:16px!important;transition:transform .14s ease,border-color .16s ease,background .16s ease!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeVariants .route-variant:active{transform:scale(.988)!important}

@media(max-width:380px){
  body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState.vano-route-studio .vano-route-hero{padding:13px!important;border-radius:20px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState h2{font-size:20px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState .route-time{min-width:69px!important;padding:9px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState .route-time span{font-size:24px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment button{min-height:45px!important;padding-inline:3px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment .route-option-icon{display:none!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment .route-option-copy b{font-size:9.5px!important}
}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState.vano-route-studio .vano-route-hero{
  background:radial-gradient(circle at 94% 4%,rgba(244,122,69,.13),transparent 34%),linear-gradient(145deg,#24211F,#1B1918)!important;border-color:rgba(255,255,255,.07)!important;
}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState .route-time{background:rgba(255,255,255,.035)!important;border-color:rgba(244,122,69,.16)!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment{background:#1D1E22!important}

/* ========================================================================== 
   VANO MAPS V310 — clearer turn guidance, connectivity and arrival summary
   ========================================================================== */
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy{min-width:0;display:flex;flex-direction:column;justify-content:center}body.vano-map-surface .nav-following-step{display:none;align-items:center;gap:6px;min-width:0;margin-top:4px;padding-top:4px;border-top:1px solid rgba(30,33,40,.055);line-height:1}body.vano-map-surface .nav-following-step.show{display:flex}body.vano-map-surface .nav-following-step span{flex:0 0 auto;font-size:6px;font-weight:900;letter-spacing:.1em;color:#a1a4aa}body.vano-map-surface .nav-following-step b{min-width:0!important;flex:1!important;font-size:9px!important;font-weight:720!important;color:#72767e!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}body.vano-map-surface .nav-following-step em{font-style:normal;font-size:8px;font-weight:800;color:#F47A45;white-space:nowrap}
body.vano-map-surface .nav-connectivity-pill{position:fixed;z-index:34;top:calc(env(safe-area-inset-top,0px) + 104px);left:50%;transform:translate(-50%,-5px);display:flex;align-items:center;gap:6px;padding:7px 10px;border-radius:999px;background:rgba(34,36,42,.92);color:#fff;box-shadow:0 8px 24px rgba(0,0,0,.16);font-size:9px;font-weight:800;opacity:0;pointer-events:none;transition:.2s ease}body.vano-map-surface .nav-connectivity-pill.show{opacity:1;transform:translate(-50%,0)}body.vano-map-surface .nav-connectivity-pill[hidden]{display:none!important}body.vano-map-surface .vano-offline #activeNav .vano-nav-trip-live{background:#f2f2f3!important;color:#74777d!important;border-color:rgba(0,0,0,.07)!important}body.vano-map-surface .vano-offline #activeNav .vano-nav-trip-live i{background:#92969e!important;box-shadow:none!important}
body.vano-map-surface .nav-eta-confidence{display:block;margin-top:1px;font-size:6.7px;font-weight:760;font-style:normal;color:#8d9199;white-space:nowrap}body.vano-map-surface .nav-summary-primary .nav-eta-confidence{color:#bb7655}
body.vano-map-surface .vano-arrival-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;width:100%;margin:13px 0 14px}body.vano-map-surface .vano-arrival-metrics>div{min-width:0;padding:9px 6px;border-radius:13px;background:#f5f6f8;text-align:center}body.vano-map-surface .vano-arrival-metrics small{display:block;margin-bottom:3px;font-size:6px;font-weight:900;letter-spacing:.09em;color:#9a9da4}body.vano-map-surface .vano-arrival-metrics b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:11px;color:#2c2f36}
body.vano-map-surface.body-nav #navExitBtn,
body.vano-map-surface.body-nav #quickAlertBtn,
body.vano-map-surface.body-nav #navDrawerRecenter,
body.vano-map-surface.body-nav #soundBtn,
body.vano-map-surface.body-nav #navDrawerToggle{min-width:46px!important;min-height:46px!important;touch-action:manipulation}body.vano-map-surface .quick-alert-grid button{min-height:64px;touch-action:manipulation}
html[data-vano-theme="black"] body.vano-map-surface .nav-following-step{border-top-color:rgba(255,255,255,.07)}html[data-vano-theme="black"] body.vano-map-surface .nav-following-step b{color:#aeb0b6!important}html[data-vano-theme="black"] body.vano-map-surface .vano-arrival-metrics>div{background:#24252a}html[data-vano-theme="black"] body.vano-map-surface .vano-arrival-metrics b{color:#f3f3f5}
@media(max-width:620px){body.vano-map-surface.body-nav #navManeuverTop{min-height:88px!important}body.vano-map-surface .vano-arrival-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}body.vano-map-surface .nav-connectivity-pill{top:calc(env(safe-area-inset-top,0px) + 96px);max-width:calc(100vw - 28px);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}}
@media(prefers-reduced-motion:reduce){body.vano-map-surface .nav-connectivity-pill{transition:none}}
body.vano-map-surface .nav-context-alert{position:fixed;z-index:33;left:50%;top:calc(env(safe-area-inset-top,0px) + 112px);transform:translateX(-50%);width:min(410px,calc(100vw - 24px));min-height:42px;padding:7px 9px;border-radius:15px;border:1px solid rgba(34,37,43,.07);background:rgba(255,255,255,.96);box-shadow:0 10px 28px rgba(24,27,34,.12);display:grid;grid-template-columns:30px minmax(0,1fr) auto;align-items:center;gap:8px}body.vano-map-surface .nav-context-alert[hidden]{display:none!important}body.vano-map-surface .nav-context-icon{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;background:#fff0e8;color:#e46938}body.vano-map-surface .nav-context-copy{min-width:0;display:flex;flex-direction:column}body.vano-map-surface .nav-context-copy small{font-size:6px;font-weight:900;letter-spacing:.1em;color:#999ca3}body.vano-map-surface .nav-context-copy b{font-size:10.5px;color:#33363d;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}body.vano-map-surface .nav-context-alert em{font-size:9px;font-weight:850;font-style:normal;color:#F47A45;white-space:nowrap}body.vano-map-surface .nav-context-alert[data-kind="lane"] .nav-context-icon{background:#eef5ff;color:#4775b8}body.vano-map-surface .nav-context-alert[data-kind="lane"] em{color:#4775b8}html[data-vano-theme="black"] body.vano-map-surface .nav-context-alert{background:rgba(28,29,34,.96);border-color:rgba(255,255,255,.09)}html[data-vano-theme="black"] body.vano-map-surface .nav-context-copy b{color:#f3f3f5}@media(max-width:620px){body.vano-map-surface .nav-context-alert{top:calc(env(safe-area-inset-top,0px) + 108px);width:calc(100vw - 18px)}}


/* ========================================================================== 
   VANO NAVIGATION V316 — driver-readable HUD and accessible touch scale
   ========================================================================== */
body.vano-map-surface{
  --vano-nav-accent:#FF9500;
  --vano-route-orange:#FF9500;
  --vano-route-orange-light:#FFC15A;
  --vano-nav-accent-strong:#A84F00;
  --vano-nav-accent-soft:#FFF4E5;
  --vano-summary-h:68px;
}
body.vano-map-surface .mapboxgl-marker.vano-user-puck-v300,
body.vano-map-surface .vano-user-puck-v300{
  width:46px!important;height:46px!important;min-width:46px!important;min-height:46px!important;
}
body.vano-map-surface .vano-user-puck-v300 .vano-puck-inline{width:46px!important;height:46px!important}
body.vano-map-surface .vano-user-puck-v300 .vano-puck-accuracy{width:58px!important;height:58px!important}

body.vano-map-surface.body-nav #navManeuverTop{
  width:min(470px,calc(100vw - 20px))!important;min-height:94px!important;padding:12px 14px!important;
  grid-template-columns:64px minmax(0,1fr)!important;gap:13px!important;border-radius:24px!important;
}
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{width:64px!important;height:64px!important;min-width:64px!important;border-radius:19px!important}
body.vano-map-surface.body-nav #navManeuverTop .maneuver-glyph{font-size:37px!important}
body.vano-map-surface.body-nav #navManeuverTop small{font-size:10px!important;line-height:1.05!important;letter-spacing:.095em!important;margin-bottom:3px!important}
body.vano-map-surface.body-nav #navManeuverTop b{font-size:20px!important;line-height:1.15!important;letter-spacing:-.4px!important}
body.vano-map-surface.body-nav #navManeuverTop #nextDistance{min-width:60px!important;padding:8px 10px!important;border-radius:12px!important;font-size:16px!important}
body.vano-map-surface .nav-following-step{gap:7px!important;margin-top:6px!important;padding-top:6px!important}
body.vano-map-surface .nav-following-step span{font-size:9px!important}
body.vano-map-surface .nav-following-step b{font-size:12px!important;line-height:1.2!important}
body.vano-map-surface .nav-following-step em{font-size:11px!important}

body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal{min-height:116px!important;padding:8px!important;border-radius:25px!important}
body.vano-map-surface.body-nav #activeNav .vano-nav-tripline{height:38px!important;padding:0 7px 6px!important;grid-template-columns:30px minmax(0,1fr) auto!important;gap:8px!important}
body.vano-map-surface.body-nav #activeNav .vano-nav-trip-icon{width:28px!important;height:28px!important;border-radius:9px!important}
body.vano-map-surface.body-nav #activeNav .vano-nav-trip-icon svg{width:15px!important;height:15px!important}
body.vano-map-surface.body-nav #activeNav .vano-nav-trip-copy small{font-size:9px!important;line-height:1.1!important;letter-spacing:.075em!important;color:#6F7580!important}
body.vano-map-surface.body-nav #activeNav .vano-nav-trip-copy b{font-size:13.5px!important;line-height:1.15!important}
body.vano-map-surface.body-nav #activeNav .vano-nav-trip-live{height:26px!important;padding:0 9px!important;font-size:9px!important;letter-spacing:.07em!important}
body.vano-map-surface.body-nav #activeNav .vano-nav-trip-live i{width:6px!important;height:6px!important}
body.vano-map-surface.body-nav #activeNav .vano-nav-progress{height:4px!important;margin:0 8px 7px!important;width:calc(100% - 16px)!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-row{height:68px!important;min-height:68px!important;border-radius:18px!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-item,
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{padding:9px 12px!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-label{gap:5px!important;margin-bottom:5px!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-label svg{width:13px!important;height:13px!important;min-width:13px!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-item small{font-size:9.5px!important;line-height:1.05!important;letter-spacing:.075em!important;color:#676E79!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{font-size:18.5px!important;line-height:1.05!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-primary strong{font-size:24px!important}
body.vano-map-surface .nav-eta-confidence{font-size:9px!important;line-height:1.1!important;margin-top:3px!important;color:#69717B!important}

body.vano-map-surface.body-nav #navStreetChip.nav-street-chip{height:44px!important;min-height:44px!important;border-radius:15px!important;padding-inline:13px!important}
body.vano-map-surface.body-nav #navStreetChip span{font-size:13px!important;line-height:1.1!important}
body.vano-map-surface.body-nav #navControlStack{width:54px!important;min-width:54px!important;gap:9px!important}
body.vano-map-surface.body-nav #navExitBtn,
body.vano-map-surface.body-nav #quickAlertBtn,
body.vano-map-surface.body-nav #navDrawerRecenter,
body.vano-map-surface.body-nav #soundBtn,
body.vano-map-surface.body-nav #navDrawerToggle,
body.vano-map-surface.body-nav #navControlStack .nav-drawer-btn{
  width:54px!important;height:54px!important;min-width:54px!important;min-height:54px!important;max-width:54px!important;max-height:54px!important;
  border-radius:18px!important;
}
body.vano-map-surface.body-nav #navControlStack :is(svg,[data-lucide]){width:22px!important;height:22px!important;stroke-width:2.15!important}
body.vano-map-surface.body-nav #navDrawerRecenter{
  background:#FFF7ED!important;border-color:rgba(255,149,0,.28)!important;
  box-shadow:0 0 0 3px rgba(255,149,0,.12),0 10px 28px rgba(24,27,34,.12)!important;
}
body.vano-map-surface.body-nav #vanoSpeedometerV220{width:60px!important;height:60px!important;min-width:60px!important;min-height:60px!important;border-radius:19px!important}
body.vano-map-surface.body-nav #vanoSpeedometerV220 strong{font-size:22px!important;transform:translateY(-5px)!important}
body.vano-map-surface.body-nav #vanoSpeedometerV220:after{bottom:7px!important;font-size:7.5px!important;letter-spacing:.03em!important}
body.vano-map-surface.body-nav.nav-map-free #navStreetChip:before{font-size:9px!important}

body.vano-map-surface .nav-connectivity-pill{min-height:38px!important;padding:9px 12px!important;font-size:11px!important}
body.vano-map-surface .nav-context-alert{min-height:54px!important;padding:9px 11px!important;grid-template-columns:36px minmax(0,1fr) auto!important;gap:10px!important;border-radius:17px!important}
body.vano-map-surface .nav-context-icon{width:36px!important;height:36px!important;border-radius:11px!important}
body.vano-map-surface .nav-context-copy small{font-size:9px!important;line-height:1.05!important}
body.vano-map-surface .nav-context-copy b{font-size:12.5px!important;line-height:1.2!important}
body.vano-map-surface .nav-context-alert em{font-size:11px!important}
body.vano-map-surface .vano-arrival-metrics{gap:8px!important}
body.vano-map-surface .vano-arrival-metrics>div{padding:11px 8px!important;border-radius:14px!important}
body.vano-map-surface .vano-arrival-metrics small{font-size:9px!important;line-height:1.1!important}
body.vano-map-surface .vano-arrival-metrics b{font-size:13px!important}
body.vano-map-surface .quick-alert-grid button{min-height:76px!important}

/* Keep the pre-trip decision surface readable because this stylesheet loads last. */
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState .vr-eyebrow{font-size:10px!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState h2{font-size:24px!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeState .route-time span{font-size:30px!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment button{min-height:58px!important;padding:8px 6px!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment .route-option-copy b{font-size:12px!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment .route-option-copy small{display:block!important;font-size:9.5px!important;line-height:1.1!important;color:#737A84!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #startTripBtn{min-height:64px!important;border-radius:20px!important;background:#FF9500!important;color:#241400!important;box-shadow:0 14px 30px rgba(255,149,0,.27)!important}

@media (max-width:390px){
  body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal{min-height:111px!important;padding:7px!important}
  body.vano-map-surface.body-nav #activeNav .vano-nav-tripline{height:35px!important;padding:0 5px 5px!important;grid-template-columns:27px minmax(0,1fr) auto!important}
  body.vano-map-surface.body-nav #activeNav .vano-nav-trip-icon{width:26px!important;height:26px!important}
  body.vano-map-surface.body-nav #activeNav .vano-nav-trip-copy b{font-size:12px!important}
  body.vano-map-surface.body-nav #activeNav .vano-nav-trip-copy small{font-size:8px!important}
  body.vano-map-surface.body-nav #activeNav .vano-nav-trip-live{height:24px!important;padding:0 7px!important;font-size:8px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-row{height:64px!important;min-height:64px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item,
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{padding:8px 7px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item small{font-size:8.5px!important;letter-spacing:.045em!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{font-size:16px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-primary strong{font-size:21px!important}
  body.vano-map-surface.body-nav #navManeuverTop{min-height:88px!important;grid-template-columns:58px minmax(0,1fr)!important;padding:11px!important;border-radius:22px!important}
  body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{width:58px!important;height:58px!important;min-width:58px!important;border-radius:17px!important}
  body.vano-map-surface.body-nav #navManeuverTop .maneuver-glyph{font-size:34px!important}
  body.vano-map-surface.body-nav #navManeuverTop small{font-size:9px!important}
  body.vano-map-surface.body-nav #navManeuverTop b{font-size:17px!important}
  body.vano-map-surface.body-nav #navManeuverTop #nextDistance{min-width:54px!important;padding:7px 8px!important;font-size:14px!important}
  body.vano-map-surface.body-nav #navControlStack{width:50px!important;min-width:50px!important}
  body.vano-map-surface.body-nav #navExitBtn,
body.vano-map-surface.body-nav #quickAlertBtn,
body.vano-map-surface.body-nav #navDrawerRecenter,
body.vano-map-surface.body-nav #soundBtn,
body.vano-map-surface.body-nav #navDrawerToggle,
body.vano-map-surface.body-nav #navControlStack .nav-drawer-btn{width:50px!important;height:50px!important;min-width:50px!important;min-height:50px!important;max-width:50px!important;max-height:50px!important}
  body.vano-map-surface.body-nav #vanoSpeedometerV220{width:56px!important;height:56px!important;min-width:56px!important;min-height:56px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment .route-option-copy small{display:none!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #routeModeSegment .route-option-copy b{font-size:11.5px!important}
}
@media (orientation:landscape) and (max-height:650px){
  body.vano-map-surface.body-nav #navManeuverTop{min-height:76px!important;grid-template-columns:52px minmax(0,1fr)!important;padding:8px 10px!important}
  body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{width:52px!important;height:52px!important;min-width:52px!important}
  body.vano-map-surface.body-nav #navManeuverTop b{font-size:16px!important}
  body.vano-map-surface.body-nav #navManeuverTop small{font-size:8.5px!important}
  body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal{min-height:72px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-row{height:60px!important;min-height:60px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item small{font-size:8.5px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{font-size:16px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-primary strong{font-size:20px!important}
  body.vano-map-surface.body-nav #navExitBtn,
body.vano-map-surface.body-nav #quickAlertBtn,
body.vano-map-surface.body-nav #navDrawerRecenter,
body.vano-map-surface.body-nav #soundBtn,
body.vano-map-surface.body-nav #navDrawerToggle{width:48px!important;height:48px!important;min-width:48px!important;min-height:48px!important;max-width:48px!important;max-height:48px!important}
}
@media (prefers-contrast:more){
  body.vano-map-surface.body-nav #navManeuverTop,
body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal,
body.vano-map-surface.body-nav #navStreetChip{border-color:rgba(20,23,28,.28)!important}
  body.vano-map-surface.body-nav #activeNav .vano-nav-trip-copy small,
body.vano-map-surface.body-nav #activeNav .nav-summary-item small{color:#4F5660!important}
}


/* VANO MAPS V303 — single adaptive camera + clean maneuver glance card */
body.vano-map-surface.body-nav #navManeuverTop{width:min(410px,calc(100vw - 20px))!important;min-height:72px!important;padding:9px 11px!important;grid-template-columns:52px minmax(0,1fr)!important;gap:10px!important;border-radius:20px!important;background:rgba(255,255,255,.975)!important;box-shadow:0 12px 34px rgba(24,27,34,.13),0 2px 7px rgba(24,27,34,.04)!important;transform:none!important}
body.vano-map-surface.body-nav #navManeuverTop:after{height:1px!important;opacity:.55!important}
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{width:52px!important;height:52px!important;min-width:52px!important;border-radius:15px!important;background:#FFF1E8!important}
body.vano-map-surface.body-nav #navManeuverTop .maneuver-glyph{font-size:31px!important;color:#D96535!important}
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy{min-width:0!important;display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;grid-template-rows:1fr!important;align-items:center!important;gap:10px!important}
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy>small,
body.vano-map-surface.body-nav #navManeuverTop .nav-following-step{display:none!important}
body.vano-map-surface.body-nav #navManeuverTop b{min-width:0!important;margin:0!important;font-size:17px!important;line-height:1.16!important;font-weight:800!important;letter-spacing:-.35px!important;white-space:normal!important;display:-webkit-box!important;-webkit-line-clamp:2!important;-webkit-box-orient:vertical!important;overflow:hidden!important}
body.vano-map-surface.body-nav #navManeuverTop #nextDistance{min-width:0!important;padding:0!important;border-radius:0!important;background:transparent!important;font-size:15px!important;line-height:1!important;font-weight:850!important;color:var(--vano-nav-accent-strong)!important;text-align:right!important}
body.vano-map-surface.body-nav.nav-drive-turn #navManeuverTop,
body.vano-map-surface.body-nav.nav-drive-junction #navManeuverTop,
body.vano-map-surface.body-nav.nav-drive-roundabout #navManeuverTop{transform:none!important;box-shadow:0 14px 38px rgba(24,27,34,.15),0 0 0 1px rgba(244,122,69,.08)!important}
@media(max-width:390px){body.vano-map-surface.body-nav #navManeuverTop{min-height:66px!important;grid-template-columns:46px minmax(0,1fr)!important;padding:8px 9px!important;border-radius:18px!important;gap:9px!important}body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{width:46px!important;height:46px!important;min-width:46px!important;border-radius:14px!important}body.vano-map-surface.body-nav #navManeuverTop .maneuver-glyph{font-size:28px!important}body.vano-map-surface.body-nav #navManeuverTop b{font-size:15.5px!important}body.vano-map-surface.body-nav #navManeuverTop #nextDistance{font-size:13px!important}}
@media(orientation:landscape) and (max-height:650px){body.vano-map-surface.body-nav #navManeuverTop{min-height:62px!important;grid-template-columns:44px minmax(0,1fr)!important;padding:7px 9px!important}body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{width:44px!important;height:44px!important;min-width:44px!important}body.vano-map-surface.body-nav #navManeuverTop b{font-size:15px!important}body.vano-map-surface.body-nav #navManeuverTop #nextDistance{font-size:12.5px!important}}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navManeuverTop{background:rgba(25,26,31,.975)!important}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{background:rgba(244,122,69,.11)!important}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navManeuverTop #nextDistance{background:transparent!important;color:#FF9A6B!important}

