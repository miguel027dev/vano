body.vano-app-root:not(.vano-route-onboarding) .splash-tag{display:none!important}body.vano-app-root:not(.vano-route-onboarding) .splash-center{animation:vanoLogoIn .54s cubic-bezier(.2,.8,.2,1) both!important;transform:none!important}body.vano-app-root:not(.vano-route-onboarding) .splash-mark{width:92px!important;height:92px!important;filter:drop-shadow(0 13px 25px rgba(217,112,63,.18))!important;animation:none!important}body.vano-app-root:not(.vano-route-onboarding) .vano-splash.is-complete .splash-center{transform:scale(.96)!important;opacity:.88}body.vano-app-root:not(.vano-route-onboarding) .vano-splash{transition:opacity .25s ease,visibility .25s ease!important}@keyframes vanoLogoIn{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:scale(1)}}

