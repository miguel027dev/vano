body.vano-app-root:not(.vano-route-onboarding) .vano-splash{background:#fff!important}body.vano-app-root:not(.vano-route-onboarding) .vano-splash:before,
body.vano-app-root:not(.vano-route-onboarding) .vano-splash:after,
