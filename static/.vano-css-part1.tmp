body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-field select,
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-place input{font-size:16px!important}
}
@media(max-width:390px){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-actions{grid-template-columns:1fr}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-actions>a{min-height:70px;grid-template-columns:38px minmax(0,1fr)}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-user.account-v255-user{grid-template-columns:46px minmax(0,1fr)!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-user .drawer-avatar{width:46px!important;height:46px!important;min-width:46px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-user .drawer-profile{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v108-quicknav.profile-v255-quicknav{grid-template-columns:1fr!important}
  body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-quicknav>a{min-height:66px!important}
}
@media(prefers-reduced-motion:reduce){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v255,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-close,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-actions>a{transition:none!important}
}

/* ========================================================================== 
   VANO MAPS — three-dots account experience
   One isolated component for authenticated + guest states.
   ========================================================================== */

body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v256{
  --av256-bg:rgba(255,255,255,.985);
  --av256-surface:#F7F7F8;
  --av256-surface-2:#FCFCFD;
  --av256-line:#E7E7EA;
  --av256-ink:#1D2027;
  --av256-copy:#707681;
  --av256-muted:#999EA7;
  --av256-brand:#D9703F;
  --av256-brand-strong:#C65F31;
  --av256-brand-soft:#FFF1E8;
  --av256-danger:#B65353;
  --av256-danger-soft:#FFF3F2;
  left:auto!important;
  right:16px!important;
  top:auto!important;
  bottom:16px!important;
  width:min(404px,calc(100vw - 32px))!important;
  max-width:404px!important;
  max-height:min(86dvh,760px)!important;
  box-sizing:border-box!important;
  padding:9px 12px 12px!important;
  overflow-x:hidden!important;
  overflow-y:auto!important;
  overscroll-behavior:contain!important;
  scrollbar-width:none!important;
  border:1px solid rgba(31,35,43,.10)!important;
  border-radius:26px!important;
  background:var(--av256-bg)!important;
  color:var(--av256-ink)!important;
  box-shadow:0 26px 80px rgba(22,25,33,.20)!important;
  backdrop-filter:blur(24px) saturate(135%)!important;
  -webkit-backdrop-filter:blur(24px) saturate(135%)!important;
  transform:translateY(calc(100% + 36px));
  transform-origin:bottom right;
  transition:transform .27s cubic-bezier(.22,.84,.24,1),opacity .18s ease!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v256::-webkit-scrollbar{display:none}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer.show{transform:translateY(0)}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v256 .drawer-grab{
  display:block!important;width:38px!important;height:4px!important;margin:0 auto 8px!important;border-radius:999px!important;background:#D8D9DD!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app #accountBackdrop.account-backdrop{background:rgba(20,23,30,.24)!important;backdrop-filter:blur(3px)!important;-webkit-backdrop-filter:blur(3px)!important}

body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:1px 1px 10px}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-brand{display:flex;align-items:center;gap:9px;min-width:0}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-brand-mark{width:34px;height:34px;flex:0 0 34px;border:1px solid #E9E3DE;border-radius:11px;background:#FFF7F1;display:grid;place-items:center;overflow:hidden}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-brand-mark img{width:24px;height:24px;object-fit:contain;display:block}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-brand-copy{min-width:0}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-brand-copy small{display:block;color:var(--av256-brand);font-size:8px;line-height:1;font-weight:950;letter-spacing:.13em}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-brand-copy b{display:block;margin-top:3px;color:var(--av256-ink);font-size:13px;line-height:1.1;font-weight:850;letter-spacing:-.15px}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-close{width:36px;height:36px;flex:0 0 36px;padding:0;border:1px solid var(--av256-line);border-radius:11px;background:var(--av256-surface);color:#666C76;display:grid;place-items:center;cursor:pointer;transition:background .15s ease,transform .12s ease,border-color .15s ease}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-close:active{transform:scale(.95)}

/* Signed in */
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-card{
  min-height:84px;box-sizing:border-box;padding:12px;border:1px solid var(--av256-line);border-radius:19px;background:linear-gradient(145deg,#FFF,#FAFAFB);color:var(--av256-ink);display:grid;grid-template-columns:54px minmax(0,1fr) 32px;align-items:center;gap:11px;text-decoration:none;box-shadow:0 5px 18px rgba(28,32,42,.035);transition:border-color .16s ease,box-shadow .16s ease,transform .12s ease;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-card:active{transform:scale(.992)}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-avatar-wrap{position:relative;width:54px;height:54px;display:block}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-avatar{width:54px;height:54px;border-radius:17px;border:1px solid #E8E5E2;background:#FFF1E8;color:var(--av256-brand);object-fit:cover;display:grid;place-items:center;overflow:hidden}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-avatar-fallback{box-sizing:border-box}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-online{position:absolute;right:-1px;bottom:1px;width:12px;height:12px;border:3px solid #fff;border-radius:999px;background:#54A879;box-sizing:border-box}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-copy{min-width:0}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-copy b{display:block;color:var(--av256-ink)!important;font-size:14px!important;line-height:1.15!important;font-weight:880!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-copy small{display:block;margin-top:3px;color:var(--av256-copy);font-size:10.5px;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-copy em{display:inline-flex;margin-top:7px;color:var(--av256-brand);font-size:9px;line-height:1;font-style:normal;font-weight:850}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-arrow{width:32px;height:32px;border-radius:10px;background:var(--av256-surface);color:#A1A5AC;display:grid;place-items:center}

body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-section-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin:14px 3px 7px}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-section-head span{color:#8F949D;font-size:8px;font-weight:950;letter-spacing:.12em}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-section-head small{color:#ADB1B8;font-size:8.5px;font-weight:650}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-section-spaced{margin-top:15px}

body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick{position:relative;min-width:0;min-height:72px;box-sizing:border-box;padding:10px;border:1px solid var(--av256-line);border-radius:16px;background:var(--av256-surface-2);color:var(--av256-ink);display:grid;grid-template-columns:36px minmax(0,1fr);align-items:center;gap:9px;text-decoration:none;transition:background .15s ease,border-color .15s ease,transform .12s ease}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick:active{transform:scale(.985)}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick.primary{background:linear-gradient(145deg,#FFF8F3,#FFFDFB);border-color:#EBDDD3}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick-icon{width:36px;height:36px;border-radius:11px;background:#F0F1F3;color:#68707A;display:grid;place-items:center}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick.primary .account-v256-quick-icon{background:var(--av256-brand-soft);color:var(--av256-brand)}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick>span:last-of-type{min-width:0}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick b{display:block;color:inherit;font-size:11.5px;line-height:1.1;font-weight:850;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick small{display:block;margin-top:4px;color:#8B9099;font-size:9px;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick .notif-count{position:absolute;top:8px;right:8px}

body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu{display:grid;gap:4px;padding:4px;border:1px solid var(--av256-line);border-radius:18px;background:var(--av256-surface-2)}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu>a{min-height:56px;box-sizing:border-box;padding:7px 8px;border-radius:13px;color:var(--av256-ink);display:grid;grid-template-columns:36px minmax(0,1fr) 18px;align-items:center;gap:9px;text-decoration:none;transition:background .15s ease,transform .12s ease}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu>a:active{transform:scale(.992);background:#F1F2F4}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu>a+ a{border-top:1px solid #EFEFF1;border-top-left-radius:9px;border-top-right-radius:9px}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu-icon{width:36px;height:36px;border-radius:11px;background:#F0F1F3;color:#6D737D;display:grid;place-items:center}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu-copy{min-width:0}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu-copy b{display:block;color:inherit;font-size:11.5px;line-height:1.1;font-weight:820}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu-copy small{display:block;margin-top:3px;color:#8B9099;font-size:9.5px;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu>a>svg{color:#A8ACB3}

body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-footer{display:grid;grid-template-columns:1fr auto;align-items:center;gap:10px;margin-top:10px;padding-top:9px;border-top:1px solid #EEEEF0}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-footer form{margin:0!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-logout{min-height:39px;padding:0 12px;border:0;border-radius:11px;background:var(--av256-danger-soft);color:var(--av256-danger);display:inline-flex;align-items:center;justify-content:center;gap:7px;font-size:10px;font-weight:850;cursor:pointer}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-footer>small{padding-right:3px;color:#B0B3B9;font-size:7.5px;font-weight:900;letter-spacing:.12em}

/* Guest */
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-hero{position:relative;overflow:hidden;padding:15px;border:1px solid #EADFD7;border-radius:20px;background:linear-gradient(145deg,#FFF8F2 0%,#FFF 72%);display:grid;grid-template-columns:44px minmax(0,1fr);gap:11px;box-shadow:0 5px 18px rgba(35,29,25,.035)}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-hero::after{content:"";position:absolute;width:126px;height:126px;right:-48px;top:-58px;border-radius:50%;background:rgba(217,112,63,.055);pointer-events:none}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-icon{position:relative;z-index:1;width:44px;height:44px;border-radius:14px;background:var(--av256-brand-soft);color:var(--av256-brand);display:grid;place-items:center}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-hero>div{position:relative;z-index:1;min-width:0}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-hero small{display:block;color:var(--av256-brand);font-size:8px;line-height:1;font-weight:950;letter-spacing:.12em}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-hero h3{margin:5px 0 0;color:var(--av256-ink);font-size:18px;line-height:1.08;letter-spacing:-.4px}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-hero p{margin:7px 0 0;color:var(--av256-copy);font-size:10.5px;line-height:1.45}

body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits{display:grid;gap:5px;margin-top:10px;padding:4px;border:1px solid var(--av256-line);border-radius:18px;background:var(--av256-surface-2)}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits>div{min-height:57px;padding:7px 8px;box-sizing:border-box;display:grid;grid-template-columns:36px minmax(0,1fr);align-items:center;gap:9px}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits>div+div{border-top:1px solid #EFEFF1}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits>div>span{width:36px;height:36px;border-radius:11px;background:#F0F1F3;color:#6E747D;display:grid;place-items:center}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits b{display:block;color:var(--av256-ink);font-size:11.5px;line-height:1.1;font-weight:830}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits small{display:block;margin-top:3px;color:#8A9099;font-size:9.5px;line-height:1.25}

body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-actions{display:grid;gap:7px;margin-top:11px}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-create{min-height:49px;padding:0 15px;border-radius:14px;background:linear-gradient(135deg,#E17B49,#CF6537);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:12px;text-decoration:none;box-shadow:0 9px 24px rgba(207,101,55,.20);font-size:11px;font-weight:900;transition:transform .12s ease,box-shadow .16s ease}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-create:active{transform:scale(.987);box-shadow:0 5px 15px rgba(207,101,55,.16)}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-login{min-height:43px;padding:0 13px;border:1px solid var(--av256-line);border-radius:13px;background:var(--av256-surface-2);color:#747A84;display:flex;align-items:center;justify-content:center;gap:5px;text-decoration:none;font-size:10px;font-weight:720}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-login b{color:var(--av256-ink);font-weight:900}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-continue{width:100%;min-height:40px;margin-top:7px;padding:0 10px;border:0;border-radius:12px;background:transparent;color:#727883;display:flex;align-items:center;justify-content:center;gap:7px;font-size:10px;font-weight:830;cursor:pointer}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-note{margin:3px 0 0;padding:0 4px;color:#A0A4AB;font-size:8.5px;line-height:1.35;text-align:center;display:flex;align-items:center;justify-content:center;gap:5px}

@media(hover:hover) and (pointer:fine){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-close:hover{background:#F1F2F3;border-color:#DEDFE3}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-card:hover{border-color:#DDDDE1;box-shadow:0 8px 24px rgba(28,32,42,.055)}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick:hover{background:#F7F7F8;border-color:#DEDFE3}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick.primary:hover{background:#FFF6EF;border-color:#E6D3C5}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu>a:hover{background:#F3F4F5}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-continue:hover{background:#F5F5F6}
}

/* Dark / Black — same structure, only palette changes. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v256,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v256{
  --av256-bg:rgba(27,26,25,.985);
  --av256-surface:#242220;
  --av256-surface-2:#22201F;
  --av256-line:rgba(255,255,255,.085);
  --av256-ink:#FBF7F4;
  --av256-copy:#B8B0AA;
  --av256-muted:#8D8884;
  --av256-brand:#F29A65;
  --av256-brand-strong:#FFAA76;
  --av256-brand-soft:rgba(242,154,101,.12);
  --av256-danger:#E89797;
  --av256-danger-soft:rgba(190,78,78,.12);
  background:var(--av256-bg)!important;border-color:rgba(255,255,255,.09)!important;color:var(--av256-ink)!important;box-shadow:0 30px 85px rgba(0,0,0,.43)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v256 .drawer-grab,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v256 .drawer-grab{background:#514C48!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-brand-mark,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-brand-mark{background:#2B2724;border-color:rgba(255,255,255,.08)}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-brand-copy b,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-brand-copy b,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-copy b,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-copy b,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-hero h3,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-hero h3,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits b,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits b{color:var(--av256-ink)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-close,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-close,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-card,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-login,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-login{background:var(--av256-surface-2)!important;border-color:var(--av256-line)!important;color:var(--av256-ink)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-card,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-card{background:linear-gradient(145deg,#262321,#211F1D)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-hero,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-hero{background:linear-gradient(145deg,#2B241F,#211F1D 75%)!important;border-color:rgba(242,154,101,.15)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-avatar,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-avatar{border-color:rgba(255,255,255,.09);background:#302822}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-online,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-online{border-color:#24211F}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-arrow,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-arrow,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick-icon,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick-icon,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu-icon,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu-icon,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits>div>span,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits>div>span{background:#2C2927;color:#B8B0AA}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick.primary,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick.primary{background:#2B241F!important;border-color:rgba(242,154,101,.15)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick.primary .account-v256-quick-icon,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick.primary .account-v256-quick-icon{background:rgba(242,154,101,.13);color:var(--av256-brand)}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu>a+ a,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu>a+ a,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits>div+div,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits>div+div,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-footer,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-footer{border-color:rgba(255,255,255,.07)}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-login b,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-login b{color:#FFF7F2}

@media(max-width:760px){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v256{
    left:8px!important;right:8px!important;top:auto!important;bottom:max(8px,env(safe-area-inset-bottom))!important;width:auto!important;max-width:none!important;max-height:min(88dvh,760px)!important;padding:8px 10px max(11px,env(safe-area-inset-bottom))!important;border-radius:24px!important;transform-origin:bottom center;
  }
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-card{min-height:80px;padding:10px;grid-template-columns:50px minmax(0,1fr) 30px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-avatar-wrap,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-avatar{width:50px;height:50px}
}
@media(max-width:390px){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v256{left:6px!important;right:6px!important;bottom:max(6px,env(safe-area-inset-bottom))!important;padding-left:9px!important;padding-right:9px!important;border-radius:22px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick-grid{gap:6px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick{min-height:68px;padding:8px;grid-template-columns:34px minmax(0,1fr);gap:7px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick-icon{width:34px;height:34px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-hero{padding:13px;grid-template-columns:40px minmax(0,1fr);gap:9px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-icon{width:40px;height:40px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-hero h3{font-size:17px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu-copy small{font-size:9px}
}
@media(max-width:340px){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick-grid{grid-template-columns:1fr}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick{min-height:58px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-section-head small{display:none}
}
@media(max-height:680px) and (max-width:760px){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v256{max-height:92dvh!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-section-head{margin-top:10px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-card{min-height:72px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick{min-height:62px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu>a{min-height:50px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-hero p{font-size:10px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-guest-benefits>div{min-height:51px}
}
@media(prefers-reduced-motion:reduce){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v256,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-close,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-profile-card,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-quick,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-menu>a,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v256-create{transition:none!important}
}

/* ================================================================
   VANO MAPS — map/user puck stacking containment
   The live user marker must belong to the map plane, never to the UI plane.
   ================================================================ */
body.vano-app-root:not(.vano-route-onboarding) .ws-app #map{
  z-index:0!important;
  isolation:isolate;
}

/* Mapbox markers stay above roads/canvas but below every VANO interface layer. */
body.vano-app-root:not(.vano-route-onboarding) .ws-app .mapboxgl-marker{
  z-index:3!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .mapboxgl-marker.user-marker,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .user-marker.vano-uploaded-user{
  z-index:4!important;
  pointer-events:none!important;
}

/* Explicit UI planes. These values intentionally sit above the map/markers. */
body.vano-app-root:not(.vano-route-onboarding) .ws-app .map-vignette,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .ambient-halo{z-index:5!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .header,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .map-tools,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .floating-locate{z-index:20!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app #planSheet{z-index:40!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .permission,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .toast,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .connectivity-pill{z-index:70!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-backdrop{z-index:109!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer{z-index:110!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-drawer{z-index:110!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .quick-alert-sheet,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .guest-limit-modal,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .vano-arrival,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .token-overlay{z-index:130!important}

/* Never allow the location puck to capture taps intended for cards/sheets. */
body.vano-app-root:not(.vano-route-onboarding) .ws-app .user-marker,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .user-marker *{
  pointer-events:none!important;
  user-select:none!important;
  -webkit-user-select:none!important;
}

/* V258 page polish */
/* =====================================================================
   VANO MAPS — stable UI layer
   Scope rule: account/admin pages and the map account drawer are isolated.
   No global map geometry is changed here.
   ===================================================================== */

body.vano-app-root:not(.vano-route-onboarding){
  --v258-bg:#f7f5f2;
  --v258-surface:#ffffff;
  --v258-surface-2:#fbfaf8;
  --v258-surface-3:#f3efeb;
  --v258-ink:#27231f;
  --v258-copy:#655e58;
  --v258-muted:#918880;
  --v258-line:#e9e2dc;
  --v258-line-strong:#ddd2ca;
  --v258-brand:#d9703f;
  --v258-brand-2:#f59a62;
  --v258-brand-3:#ffc39b;
  --v258-brand-soft:#fff0e7;
  --v258-good:#24845d;
  --v258-warn:#b57424;
  --v258-danger:#c75963;
  --v258-radius:22px;
  --v258-shadow:0 16px 48px rgba(67,49,38,.09);
  --v258-shadow-soft:0 8px 28px rgba(67,49,38,.065);
  --v258-focus:0 0 0 4px rgba(217,112,63,.13);
}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding){
  --v258-bg:#151310;
  --v258-surface:#1c1916;
  --v258-surface-2:#211d1a;
  --v258-surface-3:#28231f;
  --v258-ink:#fff9f4;
  --v258-copy:#c6bbb2;
  --v258-muted:#948981;
  --v258-line:#342e29;
  --v258-line-strong:#443a33;
  --v258-brand:#f59a62;
  --v258-brand-2:#ffc39b;
  --v258-brand-3:#ffe0cc;
  --v258-brand-soft:rgba(245,154,98,.12);
  --v258-good:#65c99b;
  --v258-warn:#e2aa62;
  --v258-danger:#ef8790;
  --v258-shadow:0 22px 62px rgba(0,0,0,.32);
  --v258-shadow-soft:0 10px 32px rgba(0,0,0,.22);
  --v258-focus:0 0 0 4px rgba(245,154,98,.16);
}

/* -------------------------- Non-map shell -------------------------- */
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface{
  min-height:100dvh;
  background:
    radial-gradient(circle at 90% -10%,rgba(245,154,98,.12),transparent 28rem),
    radial-gradient(circle at 5% 45%,rgba(255,195,155,.08),transparent 25rem),
    var(--v258-bg);
  color:var(--v258-ink);
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  overflow-x:hidden;
  padding-bottom:0;
}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface *,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface *::before,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface *::after{box-sizing:border-box}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface a{color:inherit}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface button,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface input,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface select,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface textarea{font:inherit}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface button,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface a{-webkit-tap-highlight-color:transparent}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface :focus-visible{outline:0;box-shadow:var(--v258-focus)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .container{width:min(1160px,calc(100% - 34px));margin-inline:auto}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .page{padding:34px 0 92px;min-height:calc(100dvh - 72px)}

body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .topbar{
  position:sticky;top:0;z-index:300;height:66px;
  border-bottom:1px solid color-mix(in srgb,var(--v258-line) 80%,transparent);
  background:color-mix(in srgb,var(--v258-bg) 87%,transparent);
  backdrop-filter:blur(18px) saturate(145%);-webkit-backdrop-filter:blur(18px) saturate(145%);
  box-shadow:none;
}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .nav{width:min(1160px,calc(100% - 34px));height:100%;margin:auto;display:flex;align-items:center;gap:18px}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .brand{gap:9px;color:var(--v258-ink);text-decoration:none;font-weight:900;letter-spacing:-.35px}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .brand:before{display:none}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .vano-brand-wordmark{width:124px;max-height:34px;object-fit:contain;object-position:left center}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .brand>span:not(.vano-adaptive-brand){display:none}

/* V259 — adaptive VANO brand: dark mode uses the white-letter banner asset. */
body.vano-app-root:not(.vano-route-onboarding) .vano-adaptive-brand{position:relative;display:inline-grid!important;align-items:center;justify-items:start;line-height:0}
body.vano-app-root:not(.vano-route-onboarding) .vano-adaptive-brand>.vano-brand-img{grid-area:1/1;display:block;max-width:100%;height:auto;object-fit:contain;transition:opacity .16s ease,visibility .16s ease}
body.vano-app-root:not(.vano-route-onboarding) .vano-adaptive-brand>.vano-brand-img-dark{opacity:0!important;visibility:hidden!important;pointer-events:none!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-adaptive-brand>.vano-brand-img-light{opacity:1!important;visibility:visible!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-adaptive-brand>.vano-brand-img-light{opacity:0!important;visibility:hidden!important;pointer-events:none!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-adaptive-brand>.vano-brand-img-dark{opacity:1!important;visibility:visible!important}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .vano-nav-brand{min-width:132px!important;display:inline-flex!important;align-items:center!important}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .vano-nav-brand-images{width:132px!important;height:38px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .vano-nav-brand-images>.vano-brand-img{width:auto!important;height:38px!important;max-width:132px!important;object-position:left center!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-clean.vano-adaptive-brand,
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-frame.vano-adaptive-brand{display:inline-grid!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-mini-brand{width:138px;max-width:46vw}
body.vano-app-root:not(.vano-route-onboarding) .vano-share-brand{width:150px;max-width:50vw}

body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .navlinks{display:flex;align-items:center;gap:4px;margin-left:10px}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .navlinks a,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .navlinks button.navbtn{
  min-height:38px;padding:0 12px;border:0;border-radius:12px;background:transparent;color:var(--v258-copy);
  font-size:13px;font-weight:760;text-decoration:none;display:flex;align-items:center;
}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .navlinks a:hover,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .navlinks a.active{background:var(--v258-surface);color:var(--v258-ink);box-shadow:0 0 0 1px var(--v258-line)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .nav-actions{margin-left:auto;display:flex;align-items:center;gap:8px;color:var(--v258-copy)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .nav-actions form{margin:0}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .vano-theme-toggle{border:1px solid var(--v258-line);background:var(--v258-surface);color:var(--v258-copy);box-shadow:none}

body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .btn{
  min-height:42px;padding:0 15px;border:1px solid var(--v258-line);border-radius:13px;background:var(--v258-surface);color:var(--v258-ink);
  box-shadow:none;font-weight:800;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;
}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .btn:hover{border-color:var(--v258-line-strong);background:var(--v258-surface-2);transform:none}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .btn:active{transform:scale(.985)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .btn-primary{border-color:transparent;background:linear-gradient(135deg,var(--v258-brand-2),var(--v258-brand));color:#fff;box-shadow:0 10px 24px rgba(217,112,63,.18)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .btn-primary:hover{background:linear-gradient(135deg,#f7a470,var(--v258-brand));box-shadow:0 12px 28px rgba(217,112,63,.22)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .btn-ghost{background:transparent}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .btn-sm{min-height:38px;padding-inline:12px}

body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin:0 0 22px}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .eyebrow{color:var(--v258-brand);font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .page-title,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .title{margin:5px 0 0;color:var(--v258-ink);font-size:clamp(28px,4vw,42px);line-height:1.02;letter-spacing:-1.5px}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .page-subtitle,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .subtitle,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .muted{color:var(--v258-copy);line-height:1.55}

body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .panel,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .card,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .kpi,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .alert-card{
  border:1px solid var(--v258-line);background:var(--v258-surface);color:var(--v258-ink);box-shadow:var(--v258-shadow-soft)
}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .panel{border-radius:var(--v258-radius);overflow:hidden}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .panel-head{padding:18px 20px;border-bottom:1px solid var(--v258-line)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .panel-body{padding:20px}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .card{border-radius:18px;padding:20px}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .kpi{border-radius:18px;padding:18px}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .alert-card{border-radius:16px;padding:15px}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .panel:hover,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .card:hover{border-color:var(--v258-line-strong)}

body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .input,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .select,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .textarea,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]),
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface select,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface textarea{
  width:100%;min-height:46px;border:1px solid var(--v258-line-strong);border-radius:13px;background:var(--v258-surface);color:var(--v258-ink);padding:11px 13px;outline:0;box-shadow:none;
}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface textarea{min-height:112px;resize:vertical}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface input::placeholder,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface textarea::placeholder{color:var(--v258-muted)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface input:focus,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface select:focus,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface textarea:focus{border-color:var(--v258-brand);box-shadow:var(--v258-focus)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface label>span:first-child{color:var(--v258-copy)}

body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .table-wrap{border:1px solid var(--v258-line);border-radius:18px;overflow:auto;background:var(--v258-surface)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .table{width:100%;border-collapse:collapse}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .table th{background:var(--v258-surface-2);color:var(--v258-muted);font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;text-align:left}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .table th,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .table td{padding:13px 14px;border-bottom:1px solid var(--v258-line)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .table td{color:var(--v258-copy);font-size:12px}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .table tr:last-child td{border-bottom:0}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .table tr:hover td{background:var(--v258-surface-2)}

body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .flash-wrap{position:fixed;z-index:1000;top:78px;left:50%;transform:translateX(-50%);width:min(480px,calc(100% - 24px));display:grid;gap:8px}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .flash{border:1px solid var(--v258-line);border-radius:14px;background:var(--v258-surface);color:var(--v258-ink);box-shadow:var(--v258-shadow);backdrop-filter:blur(14px)}

body.vano-app-root:not(.vano-route-onboarding).vano-page-surface footer{border-top:1px solid var(--v258-line);background:color-mix(in srgb,var(--v258-bg) 85%,transparent);color:var(--v258-muted)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface footer a{color:var(--v258-copy);text-decoration:none}

/* ----------------------------- Auth basics ----------------------------- */
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .auth-wrap{min-height:calc(100dvh - 66px);padding:38px 18px 100px;display:grid;place-items:start center;background:transparent}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .auth-card{width:min(480px,100%);margin-top:5vh;padding:28px;border:1px solid var(--v258-line);border-radius:26px;background:var(--v258-surface);color:var(--v258-ink);box-shadow:var(--v258-shadow)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .auth-card h1{margin:12px 0 8px;color:var(--v258-ink);font-size:30px;letter-spacing:-1px}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .auth-card .page-subtitle{margin-bottom:20px}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .auth-card .tiny{color:var(--v258-muted)}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .vano-auth-banner-frame{border:0;background:transparent;box-shadow:none}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .vano-auth-banner{max-width:180px;height:auto}

/* --------------------------- Generic content pages --------------------------- */
body.vano-app-root:not(.vano-route-onboarding).vano-route-about .section,
body.vano-app-root:not(.vano-route-onboarding).vano-route-sobre .section{margin-top:26px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-about .grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-about .iconbox{background:var(--v258-brand-soft);color:var(--v258-brand);border-radius:14px}
body.vano-app-root:not(.vano-route-onboarding):is(.vano-route-privacy-policy,.vano-route-terms-of-use) .legal-copy{max-width:850px;color:var(--v258-copy);font-size:14px;line-height:1.75}
body.vano-app-root:not(.vano-route-onboarding):is(.vano-route-privacy-policy,.vano-route-terms-of-use) .legal-copy h2{color:var(--v258-ink);margin-top:28px;letter-spacing:-.45px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-error .panel{max-width:650px;margin:8vh auto 0;text-align:center}
body.vano-app-root:not(.vano-route-onboarding).vano-route-error .code-num{color:var(--v258-brand);font-weight:950}

/* --------------------------- Help / notifications --------------------------- */
body.vano-app-root:not(.vano-route-onboarding).vano-route-help-page .faq-shell{max-width:820px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-help-page .faq-hero h1{color:var(--v258-ink)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-help-page .faq-hero p{color:var(--v258-copy)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-help-page .faq-search{height:50px;border:1px solid var(--v258-line-strong);border-radius:15px;background:var(--v258-surface);color:var(--v258-ink);box-shadow:var(--v258-shadow-soft)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-help-page .faq details{border:1px solid var(--v258-line);border-radius:16px;background:var(--v258-surface);box-shadow:0 4px 18px rgba(67,49,38,.035)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-help-page .faq summary{color:var(--v258-ink);font-size:13px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-help-page .faq details p{color:var(--v258-copy)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-notifications-page .notif-shell{max-width:820px;margin:auto}
body.vano-app-root:not(.vano-route-onboarding).vano-route-notifications-page .notif-head{margin-bottom:18px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-notifications-page .notif-list{display:grid;gap:10px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-notifications-page .notif-list>*{border-color:var(--v258-line);background:var(--v258-surface);box-shadow:var(--v258-shadow-soft)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-notifications-page .notif-icon{background:var(--v258-brand-soft);color:var(--v258-brand)}

/* --------------------------- Report / alerts --------------------------- */
body.vano-app-root:not(.vano-route-onboarding).vano-route-alerts-page .alert-card{display:grid;gap:8px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-alerts-page .severity,
body.vano-app-root:not(.vano-route-onboarding).vano-route-alerts-page .badge{border:1px solid var(--v258-line);background:var(--v258-surface-2);color:var(--v258-copy)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-report-page .split{gap:16px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-report-page #reportMap{border-color:var(--v258-line)!important;box-shadow:var(--v258-shadow-soft)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-report-page .pick-note{color:var(--v258-copy)}

/* --------------------------- Onboarding --------------------------- */
body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding{background:var(--v258-bg)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding .onboard{min-height:calc(100dvh - 66px);padding:34px 17px 100px;background:transparent;color:var(--v258-ink)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding .ob-shell{width:min(900px,100%);margin:auto;border:1px solid var(--v258-line);border-radius:28px;background:var(--v258-surface);box-shadow:var(--v258-shadow);overflow:hidden}
body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding .ob-top{border-bottom:1px solid var(--v258-line);background:var(--v258-surface-2)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding .ob-head h1{color:var(--v258-ink);letter-spacing:-1.2px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding .ob-head p{color:var(--v258-copy)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding .ob-section{border:1px solid var(--v258-line);background:var(--v258-surface-2);border-radius:18px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding .ob-section-title,
body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding .choice b{color:var(--v258-ink)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding .choice{border-color:var(--v258-line);background:var(--v258-surface)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding .choice:has(input:checked){border-color:var(--v258-brand);background:var(--v258-brand-soft);box-shadow:var(--v258-focus)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding .step-pill{background:var(--v258-brand-soft);color:var(--v258-brand)}

/* --------------------------- Register --------------------------- */
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .vano-entry{min-height:calc(100dvh - 66px);background:transparent;color:var(--v258-ink);padding-bottom:92px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .v63-entry-shell{width:min(1040px,calc(100% - 32px));margin:30px auto;gap:18px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .v63-entry-panel{border:1px solid var(--v258-line);border-radius:28px;background:var(--v258-surface);color:var(--v258-ink);box-shadow:var(--v258-shadow)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .v63-entry-kicker{color:var(--v258-brand)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .v63-entry-panel h1,
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .v63-auth-label{color:var(--v258-ink)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .v63-entry-lead,
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .v63-entry-proof,
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .v63-entry-footer{color:var(--v258-copy)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .auth-google,
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .auth-email,
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .auth-field{border-color:var(--v258-line-strong);background:var(--v258-surface);color:var(--v258-ink)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .auth-google-primary{box-shadow:var(--v258-shadow-soft)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-register .vano-splash{background:var(--v258-bg)}

/* --------------------------- Profile --------------------------- */
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .v72-profile-page{background:transparent!important;color:var(--v258-ink)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-shell{width:min(980px,100%);display:grid;gap:14px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-hero{border:1px solid var(--v258-line)!important;border-radius:24px!important;background:linear-gradient(145deg,var(--v258-surface),var(--v258-surface-2))!important;box-shadow:var(--v258-shadow-soft)!important;color:var(--v258-ink)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-copy h1{color:var(--v258-ink)!important;font-size:clamp(25px,5vw,36px)!important;letter-spacing:-1.1px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-copy p{color:var(--v258-copy)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-eyebrow{color:var(--v258-brand)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-badge{border-color:var(--v258-line)!important;background:var(--v258-surface)!important;color:var(--v258-copy)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-map-button{border-color:transparent!important;background:linear-gradient(135deg,var(--v258-brand-2),var(--v258-brand))!important;color:white!important;box-shadow:0 10px 24px rgba(217,112,63,.16)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v108-quicknav{gap:10px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v108-quicknav a{border:1px solid var(--v258-line)!important;border-radius:17px!important;background:var(--v258-surface)!important;color:var(--v258-ink)!important;box-shadow:0 4px 18px rgba(67,49,38,.04)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v108-quicknav a:hover{border-color:var(--v258-line-strong)!important;transform:translateY(-1px)}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v108-quicknav small{color:var(--v258-muted)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v108-quick-icon,
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-detail-icon{background:var(--v258-brand-soft)!important;color:var(--v258-brand)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-form{display:grid;gap:10px}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-detail{border:1px solid var(--v258-line)!important;border-radius:19px!important;background:var(--v258-surface)!important;color:var(--v258-ink)!important;box-shadow:0 4px 18px rgba(67,49,38,.035)!important;overflow:hidden}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-detail>summary{min-height:70px!important;padding:13px 15px!important;background:transparent!important;color:var(--v258-ink)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-detail[open]>summary{border-bottom:1px solid var(--v258-line)!important;background:var(--v258-surface-2)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-detail-copy b,
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-subhead b,
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-place-head b{color:var(--v258-ink)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-detail-copy small,
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-subcopy{color:var(--v258-muted)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-detail-body{background:var(--v258-surface)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-field input,
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-field select,
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-place input{border-color:var(--v258-line-strong)!important;background:var(--v258-surface)!important;color:var(--v258-ink)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-note{border-color:var(--v258-line)!important;background:var(--v258-brand-soft)!important;color:var(--v258-copy)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-nav-pref,
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-map-style{border-color:var(--v258-line)!important;background:var(--v258-surface-2)!important;color:var(--v258-ink)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-nav-pref:has(input:checked),
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-map-style:has(input:checked){border-color:color-mix(in srgb,var(--v258-brand) 55%,var(--v258-line))!important;background:var(--v258-brand-soft)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-save{border:0!important;border-radius:17px!important;background:linear-gradient(135deg,var(--v258-brand-2),var(--v258-brand))!important;color:#fff!important;box-shadow:0 12px 28px rgba(217,112,63,.18)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-links a{border-color:var(--v258-line)!important;background:var(--v258-surface)!important;color:var(--v258-ink)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-links small{color:var(--v258-muted)!important}

/* --------------------------- Admin system --------------------------- */
/* V259: admin is a dedicated surface. Keep the dashboard's own CSS in charge of
   geometry and use this layer only for theme, stacking and interaction safety. */
body.vano-app-root:not(.vano-route-onboarding).vano-admin-surface{background:#f6f8fc!important;color:#202533!important;overflow-x:hidden!important}
body.vano-app-root:not(.vano-route-onboarding).vano-admin-surface:before{pointer-events:none!important}
body.vano-app-root:not(.vano-route-onboarding).vano-admin-surface .mobile-dock{display:none!important}
body.vano-app-root:not(.vano-route-onboarding).vano-admin-surface :is(a,button,input,select,textarea,summary,[role="button"]){pointer-events:auto}
body.vano-app-root:not(.vano-route-onboarding).vano-admin-surface :is(.admin240,.admin240-shell,.admin-users-v76,.radar-admin){position:relative;z-index:1}
body.vano-app-root:not(.vano-route-onboarding).vano-admin-surface .topbar{z-index:700!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240{padding-bottom:max(72px,env(safe-area-inset-bottom))!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240-shell{isolation:isolate!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240-topbar{position:relative!important;z-index:3!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240-nav{position:relative!important;z-index:2!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240 :is(.admin240-card,.admin240-kpi,.admin240-server){position:relative}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .node-config-modal{z-index:5200!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .node-config-backdrop{z-index:0!important;pointer-events:auto!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .node-config-dialog{z-index:1!important;pointer-events:auto!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .node-config-modal[hidden]{display:none!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240 :is(.node-action,.admin240-primary,.admin240-ghost,.node-filter){touch-action:manipulation!important}

/* Light admin polish — does not alter the dashboard grid or JS hooks. */
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240,
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240-shell{background:transparent!important;color:#202533!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240-topbar{border-color:#e1e5ec!important;background:rgba(255,255,255,.96)!important;box-shadow:0 12px 32px rgba(38,45,73,.06)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard :is(.admin240-card,.admin240-kpi,.admin240-server){border-color:#e4e8ee!important;background:#fff!important;color:#202533!important;box-shadow:0 8px 26px rgba(38,45,73,.045)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard :is(.admin240-card h2,.admin240-kpi b,.server-head h3){color:#26303f!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard :is(.admin240-card small,.admin240-kpi small,.server-head p){color:#8791a0!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240-nav a{border-color:#e3e7ed!important;background:#fff!important;color:#4e5969!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240-nav a:hover{background:#fff4ed!important;color:#d9703f!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard :is(.node-search,.node-sort,.node-config-dialog){border-color:#dfe4eb!important;background:#fff!important;color:#303a49!important}

/* Other admin pages keep their own template CSS; these rules only normalize theme. */
body.vano-app-root:not(.vano-route-onboarding):is(.vano-route-admin-users,.vano-route-admin-audit-logs,.vano-route-admin-server-detail) :is(.users-surface,.admin86-card,.activity-kpi,.admin-modal-card){border-color:var(--v258-line)!important;background:var(--v258-surface)!important;color:var(--v258-ink)!important;box-shadow:var(--v258-shadow-soft)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-users .admin-user-modal{z-index:5200!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-users .admin-modal-backdrop{pointer-events:auto!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-users .admin-modal-card{position:relative!important;z-index:1!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-users .users-table tr,
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-users .users-table td,
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-users .users-table th{border-color:var(--v258-line)!important;color:var(--v258-copy)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-users .users-table th{background:var(--v258-surface-2)!important;color:var(--v258-muted)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-users .user-name,
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-users .admin-modal-head h2{color:var(--v258-ink)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-users .know-more{background:var(--v258-brand-soft)!important;color:var(--v258-brand)!important;border-color:transparent!important}
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-finance :is(.finance-card,.finance-kpi,.account-list>*,.finance-modal-card),
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-risk-zones :is(.risk-card,.risk-zone-card),
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-radars :is(.ra-card,.ra-kpi){border-color:var(--v258-line)!important;background:var(--v258-surface)!important;color:var(--v258-ink)!important;box-shadow:var(--v258-shadow-soft)!important}

/* Admin Black: dedicated colors while preserving original component geometry. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-admin-surface{background:#121315!important;color:#f5f6f7!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-admin-surface:before{background:radial-gradient(circle at 10% -10%,rgba(245,154,98,.08),transparent 22%),linear-gradient(180deg,#151618,#101113 60%,#0e0f11)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-admin-surface .topbar{background:rgba(17,18,20,.94)!important;border-bottom-color:#2a2d31!important}
