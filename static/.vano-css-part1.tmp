body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-quicknav small{margin-top:3px!important;font-size:10px!important;line-height:1.3!important;color:#858b96!important}

body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-form{gap:9px!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-detail{border-color:#e6e7eb!important;border-radius:18px!important;box-shadow:0 5px 18px rgba(23,27,34,.035)!important;overflow:hidden!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-detail summary{min-height:68px!important;padding:12px 14px!important;background:#fff!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-detail[open]{border-color:#e3ddd9!important;box-shadow:0 9px 26px rgba(23,27,34,.05)!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-detail[open] summary{border-bottom:1px solid #ececef!important;background:#fffaf7!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-detail-icon{width:40px!important;height:40px!important;border-radius:12px!important;background:#fff1e7!important;color:#D9703F!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-detail-copy b{font-size:13px!important;color:#20242c!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-detail-copy small{margin-top:2px!important;font-size:10.5px!important;color:#858b96!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-detail-body{padding:14px!important;background:#fcfcfd!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-field>span,
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-place-head b{font-size:10px!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-field input,
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-field select,
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-place input{min-height:48px!important;border-radius:12px!important;font-size:14px!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-nav-copy b,
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-map-copy b{font-size:11.5px!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-nav-copy small,
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-map-copy small{font-size:9.5px!important;line-height:1.35!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v72-save{position:sticky!important;bottom:max(10px,env(safe-area-inset-bottom))!important;z-index:20!important;margin-top:3px!important}

