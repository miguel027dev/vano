  body.vano-app-root:not(.vano-route-onboarding) .mobile-dock{background:rgba(255,255,255,.96)!important;border-color:#E1E5ED!important;box-shadow:0 13px 34px rgba(35,43,78,.11)!important}body.vano-app-root:not(.vano-route-onboarding) .mobile-dock a{color:#6C778A!important}body.vano-app-root:not(.vano-route-onboarding) .mobile-dock a:hover,
