body.vano-app-root:not(.vano-route-onboarding) .card,
body.vano-app-root:not(.vano-route-onboarding) .panel,
body.vano-app-root:not(.vano-route-onboarding) .auth-card{border-color:rgba(112,104,97,.15)!important;background:#fff!important;color:#27231F!important;box-shadow:0 18px 55px rgba(112,104,97,.09)!important}body.vano-app-root:not(.vano-route-onboarding) .subtitle,
body.vano-app-root:not(.vano-route-onboarding) .page-subtitle,
body.vano-app-root:not(.vano-route-onboarding) .card p{color:#706861!important}body.vano-app-root:not(.vano-route-onboarding) .iconbox{background:#FFF2E8!important;color:#D9703F!important;border-color:#FFE0CC!important}
body.vano-app-root:not(.vano-route-onboarding) .brand .vano-brand-wordmark{width:124px!important;height:38px!important}body.vano-app-root:not(.vano-route-onboarding) .vano-map-brand img{object-fit:contain!important}
/* map UI becomes cream/white + charcoal while preserving exact positions/sizes */
