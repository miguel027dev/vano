/* V56 splash: intentionally minimal — VANO mark only. */
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .vano-splash{background:#F7F8FC!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-entry .vano-splash{background:#07080D!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .vano-splash:before,
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .vano-splash:after,
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .splash-map,
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .splash-route,
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .splash-word,
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .splash-tag,
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .splash-puck{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .splash-center{transform:none!important;animation:none!important;display:grid;place-items:center}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .splash-mark{width:92px!important;margin:0!important;filter:drop-shadow(0 12px 28px rgba(217,112,63,.20))!important;animation:vanoMarkV56 .58s cubic-bezier(.2,.8,.2,1) both!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-entry .splash-mark{filter:drop-shadow(0 0 24px rgba(217,112,63,.30))!important}
@keyframes vanoMarkV56{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:scale(1)}}


/* ---- vano-global.css ---- */
/* VANO — global interaction/accessibility guardrails */
body.vano-app-root:not(.vano-route-onboarding){--v60-focus:rgba(217,112,63,.28)}
html body.vano-app-root:not(.vano-route-onboarding){-webkit-text-size-adjust:100%}
body.vano-app-root:not(.vano-route-onboarding) button,
body.vano-app-root:not(.vano-route-onboarding) a,
body.vano-app-root:not(.vano-route-onboarding) input,
body.vano-app-root:not(.vano-route-onboarding) select,
body.vano-app-root:not(.vano-route-onboarding) textarea{-webkit-tap-highlight-color:transparent}
body.vano-app-root:not(.vano-route-onboarding) button,
body.vano-app-root:not(.vano-route-onboarding) a{touch-action:manipulation}
body.vano-app-root:not(.vano-route-onboarding) button:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) a:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) input:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) select:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) textarea:focus-visible{outline:3px solid var(--v60-focus)!important;outline-offset:2px!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-options{grid-template-columns:repeat(2,minmax(0,1fr))!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-option{min-height:42px!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding){color-scheme:light}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding){color-scheme:dark}
@media(pointer:coarse){body.vano-app-root:not(.vano-route-onboarding) button,
body.vano-app-root:not(.vano-route-onboarding) .btn,
body.vano-app-root:not(.vano-route-onboarding) a.btn{min-height:42px}}
@media(max-width:360px){body.vano-app-root:not(.vano-route-onboarding) .container,
body.vano-app-root:not(.vano-route-onboarding) .nav{max-width:100%!important}}
@media(prefers-reduced-motion:reduce){body.vano-app-root:not(.vano-route-onboarding) *,
body.vano-app-root:not(.vano-route-onboarding) *:before,
body.vano-app-root:not(.vano-route-onboarding) *:after{scroll-behavior:auto!important}}

/* Touch targets: keep compact visuals, but never ship tiny controls on phones/tablets. */
@media (pointer:coarse){
  body.vano-app-root:not(.vano-route-onboarding) button,
body.vano-app-root:not(.vano-route-onboarding) .btn,
body.vano-app-root:not(.vano-route-onboarding) a.btn{min-height:42px!important}
  body.vano-app-root:not(.vano-route-onboarding) .sheet-close,
body.vano-app-root:not(.vano-route-onboarding) .password-toggle,
body.vano-app-root:not(.vano-route-onboarding) .prefs-close,
body.vano-app-root:not(.vano-route-onboarding) .safety-close,
body.vano-app-root:not(.vano-route-onboarding) .row-btn,
body.vano-app-root:not(.vano-route-onboarding) .nav-recalc-btn{min-width:42px!important;min-height:42px!important}
}


/* ---- vano-brand-assets.css ---- */
/* VANO brand assets v159 — board-derived wordmark + app icon */
body.vano-app-root:not(.vano-route-onboarding) .brand .vano-brand-wordmark{display:block;width:118px!important;height:40px!important;object-fit:contain!important;object-position:left center!important;filter:none!important;box-shadow:none!important;border-radius:0!important}
body.vano-app-root:not(.vano-route-onboarding) .brand .vano-brand-wordmark + span{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) .v63-entry-brand .vano-entry-wordmark{display:block!important;width:126px!important;height:34px!important;object-fit:contain!important;object-position:left center!important;border-radius:0!important;filter:none!important;box-shadow:none!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-mini .vano-mini-wordmark{display:block!important;width:104px!important;height:32px!important;object-fit:contain!important;object-position:left center!important;border-radius:0!important;filter:none!important;box-shadow:none!important}
body.vano-app-root:not(.vano-route-onboarding) .auth-brand-wordmark{display:block;width:154px;height:48px;object-fit:contain;object-position:left center}
@media(max-width:640px){
  body.vano-app-root:not(.vano-route-onboarding) .brand .vano-brand-wordmark{width:104px!important;height:34px!important}
  body.vano-app-root:not(.vano-route-onboarding) .v63-entry-brand .vano-entry-wordmark{width:108px!important;height:29px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-mini .vano-mini-wordmark{width:94px!important;height:29px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-brand-wordmark{width:126px;height:38px}
}


/* ---- vano-brand.css ---- */
/* VANO v168 — branding-only skin. Layout/geometry intentionally untouched. */
body.vano-app-root:not(.vano-route-onboarding){
  --vano-primary:#F59A62;--vano-light:#FFC39B;--vano-deep:#D9703F;
  --vano-paper:#FFFBF2;--vano-ink:#27231F;--vano-muted:#706861;
  --o:#F59A62!important;--o2:#FFC39B!important;
  --orange:#F59A62!important;--orange-2:#D9703F!important;--orange-3:#FFC39B!important;
  --bg:#FFFBF2!important;--text:#27231F!important;--muted:#706861!important;
  --line:rgba(112,104,97,.18)!important;
  --vano:#F59A62!important;--vano-2:#FFC39B!important;--vano-deep:#D9703F!important;--vano-soft:#FFF2E8!important;
}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding),
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding){color-scheme:light!important}
body.vano-app-root:not(.vano-route-onboarding):not(:has(.ws-app)){background:var(--vano-paper)!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding):not(:has(.ws-app)):before{background:radial-gradient(circle at 10% -8%,rgba(245,154,98,.14),transparent 29%),radial-gradient(circle at 90% 4%,rgba(255,195,155,.15),transparent 27%)!important}
body.vano-app-root:not(.vano-route-onboarding) .topbar{background:rgba(255,251,242,.90)!important;border-bottom-color:rgba(112,104,97,.14)!important}body.vano-app-root:not(.vano-route-onboarding) .navlinks a,
