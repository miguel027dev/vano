body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-status{flex:0 0 auto;min-height:34px;padding:0 10px;border:1px solid #e5eee9;border-radius:999px;background:#f7fbf8;color:#5d7e6c;display:flex;align-items:center;gap:6px;font-size:9.5px;font-weight:800;white-space:nowrap}

body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v108-quicknav.profile-v255-quicknav{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:8px!important;margin:0 0 12px!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-quicknav>a{min-height:86px!important;padding:11px!important;border:1px solid #e7e8ec!important;border-radius:17px!important;background:#fff!important;grid-template-columns:38px minmax(0,1fr)!important;grid-template-rows:auto auto!important;align-content:center!important;gap:8px!important;color:#20242c!important;box-shadow:0 5px 18px rgba(23,27,34,.035)!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-quicknav>a>svg{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-quicknav .profile-v108-quick-icon{width:38px!important;height:38px!important;border-radius:12px!important;background:#fff1e7!important;color:#D9703F!important}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-quicknav>a>span:nth-child(2){min-width:0!important}
