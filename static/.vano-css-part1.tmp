body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-card .mins,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-level strong{color:var(--vano-ink)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-card-meta{color:#6F7A8E!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-card-meta span{background:#F0F2F7!important;border-color:#E1E5ED!important;color:#58657A!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-dots i{background:#D8DDE7!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-dots i.on{background:linear-gradient(90deg,#F59A62,var(--vano))!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .level-pill{background:var(--vano-soft)!important;border-color:#E8DED6!important;color:var(--vano-deep)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-line{color:#6E798C!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-bar{background:#E5E8EF!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .smart-note{background:#F0F2FF!important;border-color:#E8DED6!important;color:#5C6580!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .smart-note b{color:var(--vano-deep)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .risk-note{background:#FFF8E8!important;border-color:#F2DEB6!important;color:#9D6D18!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .sub-action{background:#F5F6FA!important;border-color:#E1E5ED!important;color:#647084!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .disclaimer{color:#7C8697!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-card.smart-selected{border-color:#E8DED6!important;background:#F8F8FF!important;box-shadow:none!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-ai{border-top-color:#E7EAF0!important;color:#7A8496!important;font-size:9px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-ai b{color:#3D4960!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-ai .vano-dot{background:var(--vano)!important;box-shadow:0 0 0 4px rgba(217,112,63,.09)!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-suggestion-icon{color:var(--vano)!important;background:var(--vano-soft)!important;border-color:#E8DED6!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-suggestion-main small{color:var(--vano)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-suggestion-main b{color:var(--vano-ink)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-suggestion-main span{color:#748094!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-suggestion-actions button{font-size:10px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-accept{color:#fff!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-dismiss{background:#EEF0F5!important;color:#687386!important;border-color:#E1E5ED!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .lane-guidance{border-color:#E0E4EC!important;background:#F6F7FA!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .lane-guidance>small{color:#778295!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .lane{border-color:#DFE3EB!important;background:#EEF0F5!important;color:#7B8596!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .lane.valid{color:var(--vano-deep)!important;background:var(--vano-soft)!important;border-color:#E8DED6!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .lane.active{background:linear-gradient(145deg,var(--vano-2),var(--vano))!important;color:#fff!important;border-color:transparent!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .live-context-strip{border-color:#CDEFE5!important;background:#F0FBF7!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .live-context-main small{color:#218D72!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .live-context-main b{color:#344055!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .live-chip{border-color:#DCE6E3!important;background:#fff!important;color:#687386!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .live-chip.good{color:#208C70!important;border-color:#CDEEE4!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .live-chip.warn{color:#9D6D18!important;border-color:#F1DFB8!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .live-chip.bad{color:#BF4C58!important;border-color:#F0D5D9!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-head small{color:#218D72!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-head h3{color:var(--vano-ink)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-close{border-color:#E0E4EC!important;background:#F2F4F8!important;color:#697487!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-tool{border-color:#E2E6EE!important;background:#F8F9FC!important;color:var(--vano-ink)!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-tool i{background:#EEF0F5!important;color:#687386!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-tool span{color:#748094!important;font-size:8px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-tool.live i{color:#218D72!important;background:#E6F8F2!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-tool.emergency i{color:#C84A57!important;background:#FFF0F2!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .risk-ahead{background:#FFF8E8!important;border-color:#F0DDB6!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .risk-ahead-icon{background:#FFF1CC!important;color:#A8751B!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .risk-ahead-copy small,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .risk-distance{color:#9B6A18!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .risk-ahead-copy b{color:#3E4758!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .risk-ahead-copy span{color:#7B8595!important}


/* ---- rebrand-vano.css ---- */
/* VANO — free-map navigation + calmer, clearer HUD */
body.vano-app-root:not(.vano-route-onboarding){
  --vano-nav-glass:rgba(255,255,255,.94);
  --vano-nav-glass-strong:rgba(255,255,255,.985);
  --vano-nav-border:rgba(62,68,111,.11);
  --vano-nav-shadow:0 12px 34px rgba(41,48,88,.14);
  --vano-nav-shadow-soft:0 7px 20px rgba(41,48,88,.10);
}

/* Let the map remain the visual focus. */
body.vano-app-root:not(.vano-route-onboarding) .ws-app .map-vignette{background:linear-gradient(180deg,rgba(29,34,55,.14),transparent 20%,transparent 76%,rgba(29,34,55,.08))!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .map-vignette{background:linear-gradient(180deg,rgba(29,34,55,.08),transparent 18%,transparent 82%,rgba(29,34,55,.055))!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .ambient-halo{opacity:.25!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav #map{touch-action:none}

/* Top maneuver card */
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-top{
  left:10px!important;right:10px!important;
  top:max(10px,calc(env(safe-area-inset-top) + 6px))!important;
  min-height:70px!important;padding:9px 11px 9px 9px!important;gap:10px!important;
  border-radius:21px!important;border:1px solid var(--vano-nav-border)!important;
  background:var(--vano-nav-glass)!important;color:var(--vano-ink)!important;
  box-shadow:var(--vano-nav-shadow)!important;
  backdrop-filter:blur(18px) saturate(130%)!important;-webkit-backdrop-filter:blur(18px) saturate(130%)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-icon{
  width:52px!important;height:52px!important;flex-basis:52px!important;border-radius:16px!important;
  background:linear-gradient(145deg,#F59A62,var(--vano))!important;color:#fff!important;
  box-shadow:0 9px 22px rgba(217,112,63,.21)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-copy small{color:#8B94A5!important;font-size:7px!important;letter-spacing:.12em!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-copy b{color:#192137!important;font-size:16px!important;font-weight:850!important;letter-spacing:-.38px!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-copy span{color:#687487!important;font-size:10px!important;font-weight:720!important}

/* Street + recalculate: one calm strip above the bottom card. */
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-street-chip{
  left:10px!important;right:66px!important;
  bottom:max(92px,calc(env(safe-area-inset-bottom) + 92px))!important;
  height:42px!important;padding:4px 4px 4px 13px!important;
  grid-template-columns:minmax(0,1fr) 34px!important;gap:7px!important;
  border-radius:14px!important;border:1px solid var(--vano-nav-border)!important;
  background:var(--vano-nav-glass)!important;box-shadow:var(--vano-nav-shadow-soft)!important;
  backdrop-filter:blur(16px)!important;-webkit-backdrop-filter:blur(16px)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-street-chip span{color:#2B354B!important;font-size:11.5px!important;font-weight:820!important;text-align:left!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-recalc-btn{width:34px!important;height:34px!important;border-radius:10px!important;background:#F2F3F8!important;border:1px solid #E2E5ED!important;color:#697487!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-recalc-btn.recalculating{background:var(--vano-soft)!important;color:var(--vano)!important;border-color:#E8DED6!important}

/* Bottom trip summary */
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-panel.nav-minimal{
  left:10px!important;right:10px!important;bottom:max(10px,env(safe-area-inset-bottom))!important;
  padding:8px!important;border-radius:20px!important;
  background:var(--vano-nav-glass-strong)!important;border:1px solid var(--vano-nav-border)!important;
  box-shadow:0 -9px 28px rgba(41,48,88,.12)!important;
  backdrop-filter:blur(20px) saturate(130%)!important;-webkit-backdrop-filter:blur(20px) saturate(130%)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-summary-row{grid-template-columns:1fr 1fr 1fr 48px!important;gap:6px!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-summary-item{height:56px!important;padding:0 9px!important;border:0!important;border-radius:13px!important;background:#F5F6FA!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-summary-item small{font-size:6.5px!important;color:#8992A2!important;letter-spacing:.1em!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-summary-item strong{font-size:12px!important;color:#263148!important;font-weight:870!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-search-btn{width:48px!important;height:56px!important;border-radius:13px!important;background:linear-gradient(145deg,var(--vano-2),var(--vano))!important;color:#fff!important;box-shadow:0 8px 18px rgba(217,112,63,.18)!important}

/* Navigation controls stay icon-only and stack vertically. */
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-control-stack{
  display:flex!important;right:10px!important;
  bottom:max(250px,calc(env(safe-area-inset-bottom) + 250px))!important;
  gap:7px!important;z-index:42!important;
}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-stack-btn,
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-audio-toggle{
  width:44px!important;height:44px!important;border-radius:14px!important;
  background:var(--vano-nav-glass-strong)!important;color:#59657A!important;
  border:1px solid var(--vano-nav-border)!important;box-shadow:var(--vano-nav-shadow-soft)!important;
  backdrop-filter:blur(14px)!important;-webkit-backdrop-filter:blur(14px)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-stack-btn.active,
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-audio-toggle.active{
  background:var(--vano-soft)!important;color:var(--vano)!important;border-color:#E8DED6!important;
  box-shadow:0 7px 20px rgba(217,112,63,.12)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-stack-btn:active,
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-audio-toggle:active{transform:scale(.93)!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-audio-toggle{right:10px!important;bottom:max(198px,calc(env(safe-area-inset-bottom) + 198px))!important}

/* Speedometer stays compact and readable. */
body.vano-app-root:not(.vano-route-onboarding) .body-nav .floating-speedo{
  right:10px!important;bottom:max(132px,calc(env(safe-area-inset-bottom) + 132px))!important;
  width:56px!important;height:56px!important;min-width:56px!important;
  background:conic-gradient(from 210deg,var(--vano) 0deg var(--speed-angle),#E4E7EF var(--speed-angle) 300deg,transparent 300deg 360deg)!important;
  box-shadow:var(--vano-nav-shadow-soft)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .floating-speedo:after{background:#fff!important;box-shadow:inset 0 0 0 1px #E3E7EF!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .floating-speedo strong{color:#283248!important;font-size:19px!important}body.vano-app-root:not(.vano-route-onboarding) .body-nav .floating-speedo span{color:#8490A2!important}

/* Explicit feedback that dragging unlocked the camera. */
body.vano-app-root:not(.vano-route-onboarding) .nav-map-mode{display:none}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-map-mode.show{
  display:flex;position:absolute;z-index:41;right:62px;
  bottom:max(337px,calc(env(safe-area-inset-bottom) + 337px));
  max-width:min(230px,calc(100vw - 88px));min-height:44px;padding:7px 10px;align-items:center;gap:8px;
  border-radius:14px;border:1px solid #E8DED6;background:rgba(248,248,255,.97);color:var(--vano-deep);
  box-shadow:var(--vano-nav-shadow-soft);animation:vanoFreeMapIn .18s ease both;
}
body.vano-app-root:not(.vano-route-onboarding) .nav-map-mode>svg{flex:0 0 auto}body.vano-app-root:not(.vano-route-onboarding) .nav-map-mode span{min-width:0}body.vano-app-root:not(.vano-route-onboarding) .nav-map-mode b{display:block;font-size:9px;font-weight:900}body.vano-app-root:not(.vano-route-onboarding) .nav-map-mode small{display:block;margin-top:2px;color:#727D91;font-size:7px;line-height:1.22;font-weight:650}
@keyframes vanoFreeMapIn{from{opacity:0;transform:translateY(4px) scale(.98)}to{opacity:1;transform:none}}

/* Faster route prompt */
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-alt-hint.show{
  left:10px!important;top:max(90px,calc(env(safe-area-inset-top) + 86px))!important;
  width:min(360px,calc(100% - 20px))!important;min-height:58px!important;
  border-radius:17px!important;background:rgba(255,255,255,.98)!important;border:1px solid #E8DED6!important;
  box-shadow:var(--vano-nav-shadow)!important;color:#283248!important;
}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-alt-hint .nav-alt-copy small{color:var(--vano)!important}body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-alt-hint .nav-alt-copy b{color:#283248!important;font-size:10.5px!important}body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-alt-hint .nav-alt-copy em{color:#758095!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-alt-accept{background:linear-gradient(135deg,var(--vano-2),var(--vano))!important;color:#fff!important;border-radius:10px!important;box-shadow:none!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-alt-dismiss{background:#F1F3F7!important;color:#778195!important}

/* Feedback should look like a lightweight native prompt. */
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-feedback.show{background:rgba(255,255,255,.98)!important;border:1px solid var(--vano-nav-border)!important;box-shadow:var(--vano-nav-shadow-soft)!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-feedback span{color:#697487!important}body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-feedback button{background:#F4F5F9!important;color:#536075!important;border-color:#E2E6EE!important}body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-feedback button:first-of-type{background:#EAF8F3!important;color:#23866F!important;border-color:#D0EEE4!important}body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-feedback button:last-of-type{background:#FFF7E9!important;color:#9B6D1B!important;border-color:#F2E0B9!important}

/* Voice selector */
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-voice-popover{background:#fff!important;color:#283248!important;border:1px solid var(--vano-nav-border)!important;box-shadow:var(--vano-nav-shadow)!important}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-voice-popover small{color:#7C8799!important}body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-voice-popover select{background:#F7F8FB!important;color:#2A344A!important;border-color:#E1E5ED!important}body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-voice-popover button{background:var(--vano-soft)!important;color:var(--vano-deep)!important}

/* Planning UI polish */
body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card{box-shadow:0 12px 34px rgba(41,48,88,.12)!important;border-color:rgba(62,68,111,.10)!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet{box-shadow:0 -10px 34px rgba(41,48,88,.10)!important;border-color:rgba(62,68,111,.10)!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-variants{gap:7px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-variant{min-height:47px!important;padding:8px 10px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-variant b{font-size:12px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-variant span{font-size:8px!important;color:#788397!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-card{padding:12px!important;border-radius:17px!important;background:#FAFBFD!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-card-top h3{font-size:13px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-card .mins{font-size:20px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-insight{padding:5px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .insight{background:#fff!important;border-radius:11px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .start-trip-cta{box-shadow:0 9px 22px rgba(217,112,63,.18)!important}

/* Mapbox popups: align with the bright VANO language. */
body.vano-app-root:not(.vano-route-onboarding) .ws-app .mapboxgl-popup-content{background:#fff!important;color:#283248!important;border:1px solid #E0E4EC!important;box-shadow:0 13px 30px rgba(41,48,88,.16)!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .mapboxgl-popup-tip{border-top-color:#fff!important}

@media(pointer:coarse){
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-top,
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-street-chip,
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-panel.nav-minimal,
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-stack-btn,
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-audio-toggle{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
}
@media(max-width:390px){
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-top{left:7px!important;right:7px!important;min-height:66px!important;border-radius:18px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-icon{width:48px!important;height:48px!important;flex-basis:48px!important;border-radius:15px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-copy b{font-size:15px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-panel.nav-minimal{left:7px!important;right:7px!important;bottom:max(7px,env(safe-area-inset-bottom))!important;border-radius:18px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-summary-item{height:53px!important;padding:0 7px!important}body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-summary-item strong{font-size:10.8px!important}body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-search-btn{height:53px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-street-chip{left:7px!important;right:60px!important;bottom:max(86px,calc(env(safe-area-inset-bottom) + 86px))!important;height:40px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-control-stack{right:7px!important;bottom:max(236px,calc(env(safe-area-inset-bottom) + 236px))!important;gap:6px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-stack-btn,
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-audio-toggle{width:42px!important;height:42px!important;border-radius:13px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-audio-toggle{right:7px!important;bottom:max(188px,calc(env(safe-area-inset-bottom) + 188px))!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .floating-speedo{right:7px!important;bottom:max(128px,calc(env(safe-area-inset-bottom) + 128px))!important;width:54px!important;height:54px!important;min-width:54px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-map-mode.show{right:56px;bottom:max(319px,calc(env(safe-area-inset-bottom) + 319px));max-width:205px}
  body.vano-app-root:not(.vano-route-onboarding) .nav-map-mode small{font-size:6.7px}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-alt-hint.show{left:7px!important;width:calc(100% - 14px)!important;top:max(84px,calc(env(safe-area-inset-top) + 80px))!important}
}


/* ---- responsive-vano.css ---- */
/* VANO — responsive phone / foldable / tablet / landscape layout */
body.vano-app-root:not(.vano-route-onboarding){
  --vano-tablet-gutter:20px;
  --vano-tablet-panel:430px;
  --vano-tablet-nav:560px;
}

/* Keep desktop pages comfortable on medium-size touch screens. */
@media (min-width:700px) and (max-width:1199px){
  body.vano-app-root:not(.vano-route-onboarding) .container,
body.vano-app-root:not(.vano-route-onboarding) .nav{width:min(1080px,calc(100% - 40px))}
  body.vano-app-root:not(.vano-route-onboarding) .page{padding-left:4px;padding-right:4px}
  body.vano-app-root:not(.vano-route-onboarding) .auth-wrap{padding-left:24px;padding-right:24px}
  body.vano-app-root:not(.vano-route-onboarding) .auth-card{width:min(560px,100%)}
  body.vano-app-root:not(.vano-route-onboarding) .form-grid{gap:18px}
  body.vano-app-root:not(.vano-route-onboarding) .panel-head,
body.vano-app-root:not(.vano-route-onboarding) .panel-body{padding-left:22px;padding-right:22px}
}

/* The map app must use the tablet canvas instead of emulating a narrow phone. */
@media (min-width:700px){
  body.vano-app-root:not(.vano-route-onboarding):has(.ws-app){overflow:hidden;background:#F6F7FB!important;padding-bottom:0!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app{
    width:100vw!important;max-width:none!important;height:100dvh!important;max-height:none!important;
    margin:0!important;border:0!important;box-shadow:none!important;border-radius:0!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .ws-app #map{position:absolute!important;inset:0!important}

  /* Search becomes a compact floating command panel. */
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card{
    left:var(--vano-tablet-gutter)!important;right:auto!important;
    top:max(var(--vano-tablet-gutter),calc(env(safe-area-inset-top) + 14px))!important;
    width:min(var(--vano-tablet-panel),calc(100vw - 126px))!important;
    min-height:62px!important;padding:5px 7px!important;border-radius:21px!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card .location-row{height:52px!important;min-height:52px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card .location-input{font-size:15px!important}
  /* Tablet: keep destination search clean; recent destinations stay a phone-only shortcut. */
  body.vano-app-root:not(.vano-route-onboarding) .ws-app #quickRecentTop,
body.vano-app-root:not(.vano-route-onboarding) .ws-app #quickRecent{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-results{max-height:min(58vh,520px)!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .header{
    left:auto!important;right:var(--vano-tablet-gutter)!important;
    top:max(var(--vano-tablet-gutter),calc(env(safe-area-inset-top) + 14px))!important;
    width:52px!important;height:52px!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .options-btn{width:52px!important;height:52px!important;border-radius:17px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .guest-trial-pill{max-width:220px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-radar{left:var(--vano-tablet-gutter)!important;max-width:var(--vano-tablet-panel)!important}

  /* Planning is a side card; the route stays visible next to it. */
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet{
    left:var(--vano-tablet-gutter)!important;right:auto!important;
    bottom:max(var(--vano-tablet-gutter),calc(env(safe-area-inset-bottom) + 14px))!important;
    width:var(--vano-tablet-panel)!important;max-width:calc(100vw - 40px)!important;
    max-height:min(62vh,620px)!important;overflow:auto!important;overscroll-behavior:contain;
    border-radius:27px!important;padding:9px 14px 14px!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet::-webkit-scrollbar{width:0;height:0}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet .grab{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-variants{flex-wrap:wrap!important;overflow:visible!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-variant{flex:1 1 96px!important;max-width:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .destination-confirm{
    left:var(--vano-tablet-gutter)!important;right:auto!important;
    bottom:max(var(--vano-tablet-gutter),calc(env(safe-area-inset-bottom) + 14px))!important;
    width:var(--vano-tablet-panel)!important;max-width:calc(100vw - 40px)!important;
    border-radius:24px!important;
  }

  /* Drawers use the right side instead of stretching edge to edge. */
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer{
    left:auto!important;right:var(--vano-tablet-gutter)!important;
    width:min(400px,calc(100vw - 40px))!important;
    max-height:min(76vh,720px)!important;overflow:auto!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-drawer{
    left:auto!important;right:var(--vano-tablet-gutter)!important;
    width:min(430px,calc(100vw - 40px))!important;
    max-height:min(76vh,720px)!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .permission{
    left:50%!important;right:auto!important;width:min(560px,calc(100vw - 40px))!important;
    transform:translate(-50%,calc(-100% - 28px))!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .permission.show{transform:translate(-50%,0)!important}

  /* Navigation: compact information blocks, maximum map visibility. */
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-top{
    left:var(--vano-tablet-gutter)!important;right:auto!important;
    width:min(520px,calc(100vw - 130px))!important;min-height:78px!important;
    top:max(var(--vano-tablet-gutter),calc(env(safe-area-inset-top) + 14px))!important;
    padding:11px 14px 11px 10px!important;border-radius:23px!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-icon{width:56px!important;height:56px!important;flex-basis:56px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-copy b{font-size:18px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-copy span{font-size:11px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-panel.nav-minimal{
    left:var(--vano-tablet-gutter)!important;right:auto!important;
    bottom:max(var(--vano-tablet-gutter),calc(env(safe-area-inset-bottom) + 14px))!important;
    width:min(var(--vano-tablet-nav),calc(100vw - 110px))!important;
    border-radius:22px!important;padding:9px!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-summary-row{grid-template-columns:repeat(3,minmax(110px,1fr)) 54px!important;gap:7px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-summary-item{height:62px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-summary-item small{font-size:7px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-summary-item strong{font-size:14px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-search-btn{width:54px!important;height:62px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-street-chip{
    left:var(--vano-tablet-gutter)!important;right:auto!important;
    bottom:max(102px,calc(env(safe-area-inset-bottom) + 102px))!important;
    width:min(450px,calc(100vw - 120px))!important;height:44px!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-control-stack{right:var(--vano-tablet-gutter)!important;gap:8px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-stack-btn,
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-audio-toggle{width:48px!important;height:48px!important;border-radius:15px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-audio-toggle{right:var(--vano-tablet-gutter)!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .floating-speedo{right:var(--vano-tablet-gutter)!important;width:62px!important;height:62px!important;min-width:62px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-map-mode.show{right:86px!important;max-width:260px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-alt-hint.show{
    left:var(--vano-tablet-gutter)!important;width:min(420px,calc(100vw - 120px))!important;
    top:max(108px,calc(env(safe-area-inset-top) + 104px))!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-feedback.show{left:var(--vano-tablet-gutter)!important}

  /* Larger touch targets on tablet while avoiding oversized typography. */
  body.vano-app-root:not(.vano-route-onboarding) .ws-app button,
body.vano-app-root:not(.vano-route-onboarding) .ws-app [role="button"]{touch-action:manipulation}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .chip-shortcut{min-height:42px}
}

/* Large tablets: give planning and nav a little more breathing room. */
@media (min-width:1000px){
  body.vano-app-root:not(.vano-route-onboarding){--vano-tablet-gutter:24px;--vano-tablet-panel:460px;--vano-tablet-nav:590px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card{width:460px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .destination-confirm{width:460px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-top{width:550px!important}
}

/* Tablet landscape: use a true side-panel composition. */
@media (min-width:800px) and (orientation:landscape) and (max-height:760px){
  body.vano-app-root:not(.vano-route-onboarding){--vano-tablet-gutter:16px;--vano-tablet-panel:390px;--vano-tablet-nav:520px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card{top:max(16px,calc(env(safe-area-inset-top) + 10px))!important;width:390px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet{
    top:94px!important;bottom:16px!important;width:390px!important;max-height:none!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .destination-confirm{width:390px!important;bottom:16px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .header{top:max(16px,calc(env(safe-area-inset-top) + 10px))!important;right:16px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-top{left:16px!important;top:16px!important;width:470px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-panel.nav-minimal{left:16px!important;bottom:16px!important;width:500px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-street-chip{left:16px!important;bottom:101px!important;width:390px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-control-stack{right:16px!important;bottom:250px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-audio-toggle{right:16px!important;bottom:194px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .floating-speedo{right:16px!important;bottom:122px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-map-mode.show{right:82px!important;bottom:326px!important}
}

/* Foldables / small tablets: switch only after there is genuinely enough room. */
@media (min-width:600px) and (max-width:699px){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app{max-width:none!important;width:100vw!important;border:0!important;box-shadow:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card{left:12px!important;right:76px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .destination-confirm{left:12px!important;right:12px!important}
}

/* Very wide desktop preview: center map UI in a bounded working region without hiding map. */
@media (min-width:1200px){
  body.vano-app-root:not(.vano-route-onboarding):has(.ws-app){overflow:hidden;background:#EEF0F7!important;padding-bottom:0!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app{width:100vw!important;max-width:none!important;height:100dvh!important;margin:0!important;box-shadow:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card{left:24px!important;right:auto!important;width:440px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .destination-confirm{left:24px!important;right:auto!important;width:440px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .header{right:24px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-top{left:24px!important;right:auto!important;width:540px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-panel.nav-minimal{left:24px!important;right:auto!important;width:580px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-street-chip{left:24px!important;right:auto!important;width:450px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-control-stack,
body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-audio-toggle,
body.vano-app-root:not(.vano-route-onboarding) .body-nav .floating-speedo{right:24px!important}
}

@media (min-width:700px){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet.sheet-collapsed{transform:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet.sheet-collapsed .welcome,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet.sheet-collapsed #routeState{opacity:1!important;pointer-events:auto!important}
}


/* ============================================================
   VANO — tablet search layering + entry redesign
   ============================================================ */
@media (min-width:700px){
  /* Search always owns the foreground while the user is choosing a place. */
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card{z-index:64!important;transition:box-shadow .2s ease,transform .2s ease,background .2s ease!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-results{
    z-index:66!important;
    max-height:min(62dvh,560px)!important;
    overflow:auto!important;
    overscroll-behavior:contain!important;
    border-radius:20px!important;
    box-shadow:0 20px 55px rgba(34,41,74,.18)!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .ws-app.search-open .search-card{box-shadow:0 22px 64px rgba(34,41,74,.22)!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app.search-open .sheet{
    opacity:0!important;
    transform:translateY(18px) scale(.985)!important;
    pointer-events:none!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .ws-app.search-open .destination-confirm{opacity:0!important;pointer-events:none!important;transform:translateY(14px)!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app.search-open .traffic-radar{opacity:.35!important}

  body.vano-app-root:not(.vano-route-onboarding)[data-mood="day"] .ws-app .search-results,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-results{
    background:rgba(255,255,255,.985)!important;
    color:#182033!important;
    border-color:#DDE2EC!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-label{color:#737E90!important;border-bottom:1px solid #EEF0F5!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-item{color:#182033!important;min-height:62px!important;border-radius:14px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-item:hover,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-item:active{background:#FFFBF2!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .result-icon{background:#FFFBF2!important;color:#F59A62!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .result-copy b{color:#182033!important;font-size:13px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .result-address,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .result-copy small{color:#6F7A8D!important;font-size:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .result-meta{color:#626D80!important;border-color:#E2E5ED!important;background:#F7F8FB!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-message{color:#687386!important}

  /* Tablet entry: true two-column composition instead of a stretched phone. */
  body.vano-app-root:not(.vano-route-onboarding):has(.vano-entry){background:#EEF1F8!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry{display:grid!important;place-items:center!important;padding:24px!important;background:linear-gradient(145deg,#F7F8FC 0%,#EEF1F8 100%)!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-screen{
    width:min(1120px,calc(100vw - 48px))!important;
    height:min(760px,calc(100svh - 48px))!important;
    min-height:650px!important;
    display:grid!important;
    grid-template-columns:minmax(0,1.08fr) minmax(360px,.92fr)!important;
    grid-template-rows:auto minmax(0,1fr)!important;
    padding:0!important;
    border-radius:32px!important;
    border:1px solid #E1E4ED!important;
    background:#fff!important;
    overflow:hidden!important;
    box-shadow:0 32px 90px rgba(41,49,86,.14)!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .auth-copy{grid-column:1;grid-row:1;padding:46px 48px 18px!important;align-self:start!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-copy h1{font-size:clamp(42px,5vw,62px)!important;max-width:560px!important;letter-spacing:-2.6px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-copy p{max-width:520px!important;font-size:15px!important;line-height:1.55!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-brandline{margin-bottom:24px!important}
  body.vano-app-root:not(.vano-route-onboarding) .city-art{
    grid-column:1;grid-row:2;
    min-height:0!important;height:100%!important;
    margin:0!important;border-radius:0!important;box-shadow:none!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .city-art:before{height:15%!important;background:linear-gradient(180deg,#fff 0%,rgba(255,255,255,.45),transparent 100%)!important}
  body.vano-app-root:not(.vano-route-onboarding) .city-art:after{height:15%!important;background:linear-gradient(0deg,rgba(255,255,255,.9),transparent)!important}
  body.vano-app-root:not(.vano-route-onboarding) .city-art img{object-position:center 46%!important;transform:translateX(-50%) scale(1.02)!important}
  body.vano-app-root:not(.vano-route-onboarding) .city-route-badge{left:36px!important;bottom:28px!important;height:36px!important;padding:0 13px!important;font-size:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-actions{
    grid-column:2;grid-row:1/3;
    justify-content:center!important;
    align-self:stretch!important;
    padding:54px 50px!important;
    gap:11px!important;
    border-left:1px solid #E6E8F0!important;
    background:linear-gradient(180deg,#FBFBFE 0%,#F6F7FC 100%)!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .auth-actions-head{display:block;margin-bottom:18px}
  body.vano-app-root:not(.vano-route-onboarding) .auth-actions-head>span{display:block;color:#F59A62;font-size:10px;font-weight:900;letter-spacing:.13em}
  body.vano-app-root:not(.vano-route-onboarding) .auth-actions-head h2{margin:8px 0 0;color:#182033;font-size:30px;line-height:1.05;letter-spacing:-1.15px}
  body.vano-app-root:not(.vano-route-onboarding) .auth-actions-head p{margin:10px 0 0;color:#6F7A8D;font-size:13px;line-height:1.5;max-width:330px}
  body.vano-app-root:not(.vano-route-onboarding) .auth-choice,
body.vano-app-root:not(.vano-route-onboarding) .auth-google,
body.vano-app-root:not(.vano-route-onboarding) .auth-guest{height:58px!important;min-height:58px!important;border-radius:17px!important;font-size:15px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-legal{font-size:10px!important;padding-top:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-divider{padding:3px 0!important}

  /* Auth form becomes a centered dialog on tablet/desktop. */
  body.vano-app-root:not(.vano-route-onboarding) .auth-sheet{align-items:center!important;padding:24px!important}
  body.vano-app-root:not(.vano-route-onboarding) .sheet-card{
    width:min(480px,calc(100vw - 48px))!important;
    max-height:min(82svh,760px)!important;
    margin:auto!important;
    border:1px solid #E0E4ED!important;
    border-radius:26px!important;
    padding:20px 24px 24px!important;
    box-shadow:0 30px 90px rgba(29,36,67,.2)!important;
    transform:translateY(18px) scale(.985)!important;
    opacity:0!important;
    transition:transform .24s ease,opacity .2s ease!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .auth-sheet:target .sheet-card,
body.vano-app-root:not(.vano-route-onboarding) .auth-sheet.is-open .sheet-card{transform:none!important;opacity:1!important}
  body.vano-app-root:not(.vano-route-onboarding) .sheet-grab{display:none!important}
}

@media (min-width:700px) and (max-height:700px){
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry{padding:14px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-screen{height:calc(100svh - 28px)!important;min-height:560px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-copy{padding:30px 36px 12px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-copy h1{font-size:42px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-actions{padding:34px 38px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-actions-head{margin-bottom:10px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-actions-head h2{font-size:25px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-choice,
body.vano-app-root:not(.vano-route-onboarding) .auth-google,
body.vano-app-root:not(.vano-route-onboarding) .auth-guest{height:50px!important;min-height:50px!important}
}

@media (max-width:699px){
  body.vano-app-root:not(.vano-route-onboarding) .auth-actions-head{display:none!important}
}


/* ---- vano-theme.css ---- */
/* ============================================================
   VANO — global theme + black mode + responsive polish
   Brand purple stays exactly #F59A62 / #FFC39B.
   Purple is used for action, route and selection — not as a page wash.
   ============================================================ */
body.vano-app-root:not(.vano-route-onboarding){
  --vano:#F59A62;
  --vano-2:#FFC39B;
  --vano-deep:#D9703F;
  --vano-soft:#FFF2E8;
  --vano-focus:rgba(217,112,63,.14);
  --vano-bg:#F4F5F8;
  --vano-card:#FFFFFF;
  --vano-card-2:#F8F9FC;
  --vano-ink:#182033;
  --vano-muted:#697386;
  --vano-line:#E1E5ED;
  --vano-shadow:0 10px 28px rgba(28,34,62,.08);
  --vano-shadow-lg:0 24px 64px rgba(28,34,62,.14);
}

/* Remove decorative purple wash: brand color should signal action. */
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding){
  background:#F4F5F8!important;
  background-image:none!important;
  color:#182033!important;
}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding):before{display:none!important}

/* ---------- Global Black theme ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding){
  --vano-bg:#07070A;
  --vano-card:#101116;
  --vano-card-2:#15171D;
  --vano-ink:#F4F5F8;
  --vano-muted:#979EAB;
  --vano-line:#252832;
  --vano-soft:#27231F;
  --vano-shadow:0 10px 28px rgba(0,0,0,.30);
  --vano-shadow-lg:0 24px 68px rgba(0,0,0,.46);
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding){
  background:#07070A!important;
  background-image:none!important;
  color:#F4F5F8!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):before{display:none!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) ::selection{background:#27231F;color:#fff}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .topbar{
  background:rgba(9,10,13,.94)!important;
  border-bottom-color:#242630!important;
  box-shadow:0 8px 28px rgba(0,0,0,.25)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .brand,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .title,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .page-title,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .section-title{color:#F5F6F8!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .navlinks a,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .navlinks button.navbtn{color:#A2A9B5!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .navlinks a:hover,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .navlinks button.navbtn:hover,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .navlinks a.active{background:#171824!important;color:#E8DED6!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .subtitle,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .page-subtitle,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .muted,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .tiny{color:#989FAC!important}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .panel,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .kpi,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .alert-card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .profile-hero,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .profile-card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .profile-detail,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .profile-link,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .faq details{
  background:#101116!important;
  color:#F4F5F8!important;
  border-color:#252832!important;
  box-shadow:0 12px 30px rgba(0,0,0,.20)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .panel-head,
html[data-vano-theme="black"] .detail-body.vano-app-root:not(.vano-route-onboarding){border-color:#252832!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) footer{background:#090A0D!important;border-color:#242630!important;color:#8F97A4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .iconbox,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .profile-detail summary .detail-icon{background:#27231F!important;color:#F59A62!important;border-color:#27231F!important}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .btn{
  background:#15171D!important;color:#EEF0F4!important;border-color:#2B2E38!important;box-shadow:none!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .btn-primary{
  background:linear-gradient(135deg,#FFC39B,#F59A62)!important;color:#fff!important;border-color:transparent!important;
  box-shadow:0 12px 28px rgba(217,112,63,.24)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .btn-danger{background:#291619!important;color:#FF9AA4!important;border-color:#51252B!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .input,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .select,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .textarea,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .settings-field input,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .settings-field select,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .place-card input,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .invite-box input,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .faq-search{
  background:#0C0D11!important;color:#F3F4F7!important;border-color:#2A2D36!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .input::placeholder,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .textarea::placeholder,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .settings-field input::placeholder,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .faq-search::placeholder{color:#686F7B!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .input:focus,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .select:focus,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .textarea:focus,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .settings-field input:focus,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .settings-field select:focus,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .faq-search:focus{border-color:#D9703F!important;box-shadow:0 0 0 4px rgba(217,112,63,.13)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .field label,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .settings-field label{color:#B0B6C1!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .table th,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .table td{border-color:#242730!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .table tr:hover td{background:#15171D!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .flash{background:#111218!important;color:#F2F3F6!important;border-color:#2A2D36!important}

/* ---------- Theme switch ---------- */
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 13px;border-radius:15px;border:1px solid #E1E5ED;background:#F8F9FC;min-height:64px}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting .theme-copy{min-width:0}body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting .theme-copy b{display:flex;align-items:center;gap:7px;font-size:11px;color:#263047}body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting .theme-copy span{display:block;margin-top:3px;font-size:8.5px;line-height:1.35;color:#768195}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle{flex:0 0 auto;height:38px;min-width:116px;padding:0 12px;border-radius:12px;border:1px solid #D8DCE7;background:#fff;color:#3F4A60;display:flex;align-items:center;justify-content:center;gap:7px;font-size:9px;font-weight:900;cursor:pointer;transition:.18s ease}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle:hover{border-color:#E8DED6;color:#D9703F;background:#F7F7FF}body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle.is-black{background:#151620;border-color:#33354A;color:#E8DED6}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-dot{width:9px;height:9px;border-radius:50%;background:#D4D8E2;box-shadow:inset 0 0 0 2px #fff}body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle.is-black .vano-theme-dot{background:#FFC39B;box-shadow:0 0 0 4px rgba(245,154,98,.12)}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting{background:#15171D;border-color:#292C36}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting .theme-copy b{color:#F1F2F5}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting .theme-copy span{color:#9098A5}

/* ---------- Map UI: Black ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app{--bg:#07080B;--glass:rgba(12,13,17,.94);--glass2:rgba(12,13,17,.985);--line:rgba(255,255,255,.085);--text:#F3F4F7;--muted:#979EAB;--ink:#F3F4F7;--soft:#15171D;background:#07080B!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-drawer,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .destination-confirm,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-loading-card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .resume-trip-card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-panel,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding)[data-mood="day"] .ws-app .search-card{
  background:rgba(12,13,17,.965)!important;color:#F3F4F7!important;border-color:rgba(255,255,255,.085)!important;box-shadow:0 22px 54px rgba(0,0,0,.38)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .location-row,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding)[data-mood="day"] .ws-app .location-row{background:#15171D!important;border-color:#292C35!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .location-input,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding)[data-mood="day"] .ws-app .location-input{color:#F3F4F7!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .location-input::placeholder{color:#747C89!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .row-btn{color:#A0A8B4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .row-btn:active{background:#22242C!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .chip-shortcut,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding)[data-mood="day"] .ws-app .chip-shortcut{background:#14161B!important;color:#DEE1E7!important;border-color:#292C35!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .map-btn,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .quick,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-stack-btn,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-audio-toggle{background:rgba(13,14,18,.96)!important;color:#B7BDC7!important;border-color:#2A2D36!important;box-shadow:0 9px 24px rgba(0,0,0,.32)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-stack-btn.active,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-audio-toggle.active,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .map-btn.active{background:#27231F!important;color:#FFC39B!important;border-color:#27231F!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .segment,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .travel{background:#16181E!important;border-color:#292C35!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .segment button,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .travel button{color:#929AA7!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .segment button.active,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .travel button.active{background:#27231F!important;color:#FFFBF2!important;border-color:#27231F!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-variant,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .parking-nearby,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-insight{background:#15171D!important;border-color:#292C36!important;color:#E9EBEF!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-variant.active{background:#27231F!important;border-color:#D9703F!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet h2,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet h3{color:#F4F5F8!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet p,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet small{color:#969EAA!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-link{color:#D9DDE4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-link:hover{background:#191B22!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-divider{background:#252832!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-results,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding)[data-mood="day"] .ws-app .search-results{background:#111218!important;color:#F3F4F7!important;border-color:#292C35!important;box-shadow:0 24px 60px rgba(0,0,0,.46)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-label{color:#9098A5!important;border-bottom-color:#242730!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-item{color:#F1F2F5!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-item:hover,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-item:active{background:#1A1B27!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .result-icon{background:#27231F!important;color:#F59A62!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .result-copy b{color:#F0F2F5!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .result-address,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .result-copy small{color:#8E97A5!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .result-meta{color:#A1A8B4!important;border-color:#2A2D36!important;background:#17191F!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-message{color:#929AA7!important}

/* Navigation black glass */
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .nav-maneuver-top,
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .nav-street-chip,
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .nav-panel.nav-minimal{background:rgba(10,11,15,.94)!important;border-color:rgba(255,255,255,.09)!important;box-shadow:0 14px 38px rgba(0,0,0,.36)!important}
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .nav-maneuver-copy b,
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .nav-street-chip span{color:#F2F3F6!important}
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .nav-maneuver-copy span,
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .nav-maneuver-copy small{color:#969EAA!important}
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .nav-recalc-btn,
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .nav-summary-item{background:#17191F!important;border-color:#292C35!important;color:#E4E7EC!important}
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .nav-summary-item strong{color:#F1F2F5!important}
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .nav-summary-item small{color:#8F98A6!important}
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .floating-speedo{background:conic-gradient(from 210deg,#F59A62 0deg var(--speed-angle),#292C35 var(--speed-angle) 300deg,transparent 300deg 360deg)!important}
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .floating-speedo:after{background:#101116!important;box-shadow:inset 0 0 0 1px #2B2E37!important}
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .floating-speedo strong{color:#F3F4F7!important}
html[data-vano-theme="black"] .body.vano-app-root:not(.vano-route-onboarding)-nav .floating-speedo span{color:#8D96A4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-content{background:#111218!important;color:#F4F5F8!important;border:1px solid #2B2E37!important;box-shadow:0 18px 48px rgba(0,0,0,.42)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-tip{border-top-color:#111218!important;border-bottom-color:#111218!important}

/* ---------- Auth: same VANO purple, no orange brand residue ---------- */
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .auth-copy h1 span,
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .auth-actions-head>span,
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .auth-legal a,
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .sheet-switch a{color:#F59A62!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .auth-brandline img{filter:drop-shadow(0 0 12px rgba(217,112,63,.28))!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .city-route-badge svg{color:#FFC39B!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .auth-choice.primary,
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .sheet-submit{background:linear-gradient(135deg,#FFC39B,#F59A62)!important;color:#fff!important;border-color:transparent!important;box-shadow:0 12px 30px rgba(217,112,63,.22)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .city-art:where(:not(.no-purple-route))::after{pointer-events:none}
/* Purple route overlay aligned over the hero photo; keeps the source photo untouched. */
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .city-art .vano-login-route{position:absolute;inset:0;z-index:3;width:100%;height:100%;pointer-events:none;filter:drop-shadow(0 0 7px rgba(217,112,63,.55))}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .city-art .vano-login-route path.route-halo{fill:none;stroke:#F59A62;stroke-width:22;stroke-linecap:round;stroke-linejoin:round;opacity:.10}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .city-art .vano-login-route path.route-main{fill:none;stroke:url(#vanoLoginRouteGradient);stroke-width:7;stroke-linecap:round;stroke-linejoin:round;opacity:.96}

/* Auth black follows the selected global theme. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):has(.vano-entry),
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-entry{background:#07070A!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-screen{background:#090A0E!important;border-color:#252832!important;box-shadow:0 30px 90px rgba(0,0,0,.52)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-copy h1,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-brandline{color:#F4F5F8!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-copy p{color:#989FAC!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-actions{background:#0D0E13!important;border-color:#242630!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-actions-head h2{color:#F3F4F7!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-actions-head p{color:#969EAB!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-choice.secondary,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-guest{background:#15171D!important;color:#ECEEF2!important;border-color:#2A2D36!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-divider{color:#777F8C!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-divider:before,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-divider:after{background:#2B2D36!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-legal{color:#747D8A!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .sheet-card{background:#111218!important;color:#F3F4F7!important;border-color:#2B2E37!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .sheet-head h2{color:#F3F4F7!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .sheet-head p{color:#8E97A5!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .sheet-input,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .sheet-select{background:#0B0C10!important;color:#F3F4F7!important;border-color:#2A2D36!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .sheet-close,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .password-toggle{color:#A2A9B5!important}

/* ---------- Onboarding / profile branding cleanup ---------- */
body.vano-app-root:not(.vano-route-onboarding) .onboard .step-pill,
body.vano-app-root:not(.vano-route-onboarding) .onboard .ob-head .eyebrow{color:#F59A62!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .ob-progress i{background:linear-gradient(90deg,#FFC39B,#F59A62)!important;box-shadow:0 0 15px rgba(217,112,63,.34)!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .ob-head .eyebrow i{background:#F59A62!important;box-shadow:0 0 0 5px rgba(217,112,63,.10)!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .ob-section-title .ico{background:rgba(217,112,63,.10)!important;border-color:rgba(217,112,63,.16)!important;color:#F59A62!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .choice input:checked+label,
body.vano-app-root:not(.vano-route-onboarding) .onboard .pref input:checked+label{border-color:rgba(217,112,63,.48)!important;background:rgba(217,112,63,.075)!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .choice input:checked+label i,
body.vano-app-root:not(.vano-route-onboarding) .onboard .pref input:checked+label .pref-icon{color:#F59A62!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .pref input:checked+label .radio-dot{border-color:#FFC39B!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .pref input:checked+label .radio-dot:after{background:#F59A62!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .switch input:checked+.slider{background:#F59A62!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .presence-consent{border-color:rgba(217,112,63,.18)!important;background:rgba(217,112,63,.055)!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .presence-consent input{accent-color:#F59A62!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .ob-submit{box-shadow:0 13px 32px rgba(217,112,63,.20)!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .vano-mini img{filter:drop-shadow(0 0 13px rgba(217,112,63,.28))!important}

html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard{background:#F4F5F8!important;color:#182033!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .vano-mini{color:#182033!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .ob-head h1{color:#182033!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .ob-head h1 span{color:#697386!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .ob-head p{color:#697386!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .ob-section{background:#fff!important;border-color:#E1E5ED!important;box-shadow:0 10px 26px rgba(28,34,62,.05)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .ob-section-title b{color:#263047!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .ob-section-title span{color:#778195!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .input,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .select,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .choice label,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .pref label,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .night-card{background:#F8F9FC!important;color:#182033!important;border-color:#E1E5ED!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .choice label b,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .pref label b,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .night-card b{color:#263047!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .field label{color:#566176!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .input,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard .select{color:#182033!important}

/* ---------- Responsiveness: all device classes ---------- */
html body.vano-app-root:not(.vano-route-onboarding),
body.vano-app-root:not(.vano-route-onboarding){min-width:0;max-width:100%;overflow-x:hidden}
body.vano-app-root:not(.vano-route-onboarding) img,
body.vano-app-root:not(.vano-route-onboarding) svg,
body.vano-app-root:not(.vano-route-onboarding) video,
body.vano-app-root:not(.vano-route-onboarding) canvas{max-width:100%}
body.vano-app-root:not(.vano-route-onboarding) .container{width:min(1180px,calc(100% - 32px));margin-inline:auto}
body.vano-app-root:not(.vano-route-onboarding) .page{min-width:0}

/* Small phones: prevent cramped two-column controls and oversized titles. */
@media (max-width:359px){
  body.vano-app-root:not(.vano-route-onboarding) .container{width:min(100% - 20px,1180px)}
  body.vano-app-root:not(.vano-route-onboarding) .page{padding-top:18px!important}
  body.vano-app-root:not(.vano-route-onboarding) .page-title{font-size:clamp(25px,9vw,32px)!important}
  body.vano-app-root:not(.vano-route-onboarding) .profile-hero{gap:9px!important;padding:11px!important}body.vano-app-root:not(.vano-route-onboarding) .profile-avatar{width:50px!important;height:50px!important}
  body.vano-app-root:not(.vano-route-onboarding) .fuel-list{grid-template-columns:1fr!important}body.vano-app-root:not(.vano-route-onboarding) .style-choices{grid-template-columns:1fr!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting{align-items:flex-start;flex-direction:column}body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle{width:100%}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card{left:7px!important;right:58px!important}body.vano-app-root:not(.vano-route-onboarding) .ws-app .header{right:7px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-summary-row{grid-template-columns:repeat(3,1fr) 44px!important}body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-search-btn{width:44px!important}
}

/* Phones / portrait: comfortable single column. */
@media (max-width:699px){
  body.vano-app-root:not(.vano-route-onboarding) .container{width:min(100% - 24px,1180px)}
  body.vano-app-root:not(.vano-route-onboarding) .page-head{gap:12px!important;align-items:flex-start!important}
  body.vano-app-root:not(.vano-route-onboarding) .page-head>.btn{flex:0 0 auto}
  body.vano-app-root:not(.vano-route-onboarding) .profile-shell,
body.vano-app-root:not(.vano-route-onboarding) .faq-shell{width:100%;max-width:100%!important}
  body.vano-app-root:not(.vano-route-onboarding) .profile-detail summary{min-height:58px;height:auto!important;padding-block:10px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting{min-height:68px}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .auth-screen{width:100%!important;max-width:520px!important}
}

/* Short landscape phones: keep route and auth usable without vertical clipping. */
@media (max-width:899px) and (orientation:landscape) and (max-height:520px){
  body.vano-app-root:not(.vano-route-onboarding) .topbar{height:56px!important}body.vano-app-root:not(.vano-route-onboarding) .page{padding-top:14px!important;padding-bottom:72px!important}
  body.vano-app-root:not(.vano-route-onboarding) .mobile-dock{height:54px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry{overflow:auto!important}body.vano-app-root:not(.vano-route-onboarding) .vano-entry .auth-screen{min-height:620px!important;height:auto!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-maneuver-top{top:7px!important;left:7px!important;right:auto!important;width:min(430px,58vw)!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-panel.nav-minimal{left:7px!important;right:auto!important;width:min(500px,66vw)!important;bottom:7px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-street-chip{left:7px!important;right:auto!important;width:min(390px,52vw)!important;bottom:78px!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-control-stack{right:8px!important;bottom:180px!important}body.vano-app-root:not(.vano-route-onboarding) .body-nav .nav-audio-toggle{right:8px!important;bottom:128px!important}body.vano-app-root:not(.vano-route-onboarding) .body-nav .floating-speedo{right:8px!important;bottom:64px!important}
}

/* Tablet portrait: widen content intelligently instead of stretching cards. */
@media (min-width:700px) and (max-width:1099px){
  body.vano-app-root:not(.vano-route-onboarding) .container{width:min(100% - 48px,980px)}
  body.vano-app-root:not(.vano-route-onboarding) .profile-shell{max-width:900px!important}body.vano-app-root:not(.vano-route-onboarding) .faq-shell{max-width:900px!important}
  body.vano-app-root:not(.vano-route-onboarding) .profile-hero{padding:18px!important}body.vano-app-root:not(.vano-route-onboarding) .profile-avatar{width:72px!important;height:72px!important}
  body.vano-app-root:not(.vano-route-onboarding) .settings-grid{grid-template-columns:1fr 1fr!important}body.vano-app-root:not(.vano-route-onboarding) .settings-grid .full{grid-column:1/-1!important}
  body.vano-app-root:not(.vano-route-onboarding) .profile-links{grid-template-columns:repeat(2,minmax(0,1fr))!important}body.vano-app-root:not(.vano-route-onboarding) .profile-links .profile-link:last-child:nth-child(odd){grid-column:1/-1}
}

/* Desktop/large tablet: content grids use width, but text remains readable. */
@media (min-width:1100px){
  body.vano-app-root:not(.vano-route-onboarding) .container{width:min(1180px,calc(100% - 64px))}
  body.vano-app-root:not(.vano-route-onboarding) .profile-shell{max-width:1040px!important}
  body.vano-app-root:not(.vano-route-onboarding) .profile-hero{padding:20px!important}body.vano-app-root:not(.vano-route-onboarding) .profile-avatar{width:78px!important;height:78px!important}
  body.vano-app-root:not(.vano-route-onboarding) .profile-links{grid-template-columns:repeat(3,minmax(0,1fr))!important}
  body.vano-app-root:not(.vano-route-onboarding) .faq-shell{max-width:980px!important}
  body.vano-app-root:not(.vano-route-onboarding) .faq{grid-template-columns:1fr 1fr;align-items:start}body.vano-app-root:not(.vano-route-onboarding) .faq details{min-width:0}
}

/* Very large desktop: never scale the UI endlessly. */
@media (min-width:1600px){
  body.vano-app-root:not(.vano-route-onboarding) .container{max-width:1280px}
  body.vano-app-root:not(.vano-route-onboarding) .profile-shell{max-width:1120px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-screen{max-width:1240px!important}
}

/* Touch/coarse input: consistent targets. */
@media (pointer:coarse){
  body.vano-app-root:not(.vano-route-onboarding) button,
body.vano-app-root:not(.vano-route-onboarding) .btn,
body.vano-app-root:not(.vano-route-onboarding) a.btn,
body.vano-app-root:not(.vano-route-onboarding) .profile-link,
body.vano-app-root:not(.vano-route-onboarding) .drawer-link{min-height:44px}
  body.vano-app-root:not(.vano-route-onboarding) input,
body.vano-app-root:not(.vano-route-onboarding) select,
body.vano-app-root:not(.vano-route-onboarding) textarea{font-size:16px}
}

@media (prefers-reduced-motion:reduce){
  body.vano-app-root:not(.vano-route-onboarding) *,
body.vano-app-root:not(.vano-route-onboarding) *:before,
body.vano-app-root:not(.vano-route-onboarding) *:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}

/* Remaining themed components */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mobile-dock{background:rgba(9,10,13,.96)!important;border-color:#252832!important;box-shadow:0 -12px 32px rgba(0,0,0,.30)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mobile-dock a{color:#8F97A4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mobile-dock a:hover,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mobile-dock a.active{color:#FFC39B!important;background:#181826!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .place-card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .fuel-choice,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .family-person,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .style-choice{background:#15171D!important;border-color:#292C35!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .place-card b,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .family-person .copy b,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .style-choice b{color:#EFF1F4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .family-person .pic{background:#20222A!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .family-person .copy span,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .style-choice span,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .map-style-note,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .emergency-note,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .family-note,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .privacy-note{color:#8F98A6!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .style-preview{background:#0C0D11!important;border-color:#2B2E37!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .style-select,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mood-legend em{background:#20222A!important;color:#A4ABB6!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .style-choice:has(input:checked){background:#27231F!important;border-color:#D9703F!important;box-shadow:0 0 0 3px rgba(217,112,63,.08)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .style-choice:has(input:checked) .style-select{background:#27231F!important;color:#E8DED6!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .invite-box button,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .invite-main{background:#27231F!important;color:#FFC39B!important;border-color:#27231F!important}

/* Splash and hero route always use VANO purple, not legacy orange. */
body.vano-app-root:not(.vano-route-onboarding) .vano-splash .splash-route{filter:drop-shadow(0 0 7px rgba(217,112,63,.92)) drop-shadow(0 0 24px rgba(245,154,98,.42))!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-splash .splash-route .route-halo{stroke:#F59A62!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-splash .splash-tag{color:#FFC39B!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-splash .splash-mark{filter:drop-shadow(0 0 18px rgba(217,112,63,.34))!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-splash .splash-puck:after{background:#F59A62!important;box-shadow:0 0 10px rgba(217,112,63,.65)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .city-art:before{background:linear-gradient(180deg,#090A0E 0%,rgba(9,10,14,.50) 42%,transparent 100%)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .city-art:after{background:linear-gradient(0deg,#090A0E 0%,rgba(9,10,14,.62) 40%,transparent 100%)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .city-route-badge{background:rgba(13,14,19,.91)!important;color:#D5D9E0!important;border-color:#2B2E37!important;box-shadow:0 10px 28px rgba(0,0,0,.28)!important}

/* In light mode the entry uses neutral white/gray; purple stays only on interactive details. */
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding):has(.vano-entry){background:#F4F5F8!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .vano-entry{background:#F4F5F8!important}

/* Tablet settings become easier to scan. */
@media (min-width:760px){
  body.vano-app-root:not(.vano-route-onboarding) #appSettings .detail-body.settings-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important}
  body.vano-app-root:not(.vano-route-onboarding) #appSettings .settings-field.full{grid-column:1/-1!important}
  body.vano-app-root:not(.vano-route-onboarding) #appSettings .vano-theme-setting{padding:14px 15px!important}
}

/* Small brand polish on auxiliary pages */
body.vano-app-root:not(.vano-route-onboarding) .faq details[open]{border-color:rgba(217,112,63,.28)!important}
body.vano-app-root:not(.vano-route-onboarding) .badge.orange{background:#FFF2E8!important;color:#D9703F!important;border-color:#E8DED6!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .badge.orange{background:#27231F!important;color:#FFC39B!important;border-color:#27231F!important}


/* ---- vano-theme.css ---- */
/* ============================================================
   VANO — white + purple system, automatic Black mode
   Official brand purple: #F59A62 / #FFC39B
   ============================================================ */
body.vano-app-root:not(.vano-route-onboarding){
  --vano:#F59A62;
  --vano-2:#FFC39B;
  --vano-deep:#D9703F;
  --vano-soft:#FFF4EC;
  --vano-soft-2:#FFFBF2;
  --vano-bg:#F6F7FB;
  --vano-card:#FFFFFF;
  --vano-card-2:#FAFAFD;
  --vano-ink:#171A2B;
  --vano-muted:#687386;
  --vano-line:#E3E6EE;
  --vano-line-strong:#D6DAE5;
  --vano-shadow:0 12px 34px rgba(32,38,70,.08);
  --vano-shadow-lg:0 28px 80px rgba(32,38,70,.13);
  --vano-radius:18px;
  /* Legacy aliases: old orange branding becomes VANO purple. Traffic/alerts
     that use dedicated hard-coded warning colors remain functional. */
  --orange:#F59A62;
  --orange-2:#FFC39B;
  --orange-3:#FFC39B;
  --bg:#F6F7FB;
  --surface:#FFFFFF;
  --surface-2:#F8F9FC;
  --surface-3:#F0F2F7;
  --text:#171A2B;
  --muted:#687386;
  --muted-2:#8891A1;
  --line:#E3E6EE;
  --shadow:var(--vano-shadow);
}
html body.vano-app-root:not(.vano-route-onboarding){background:var(--vano-bg)}
html body.vano-app-root:not(.vano-route-onboarding),
body.vano-app-root:not(.vano-route-onboarding){max-width:100%;overflow-x:hidden}
body.vano-app-root:not(.vano-route-onboarding){background:var(--vano-bg)!important;background-image:none!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding):before{display:none!important}

/* ---------- Global light surfaces ---------- */
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .topbar{
  background:rgba(255,255,255,.90)!important;border-bottom:1px solid rgba(215,219,230,.86)!important;
  box-shadow:0 8px 28px rgba(30,36,70,.055)!important;backdrop-filter:blur(22px) saturate(135%)!important;
}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .brand,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .page-title,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .title,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) h1,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) h2,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) h3{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .navlinks a,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .navlinks button.navbtn{color:#667185!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .navlinks a:hover,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .navlinks button.navbtn:hover,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .navlinks a.active{background:#FFF4EC!important;color:#D9703F!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .panel,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .card,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .kpi,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .alert-card,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-card,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .profile-hero,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .profile-card,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .profile-detail,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .profile-link,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .faq details{
  background:#fff!important;color:#171A2B!important;border-color:#E3E6EE!important;box-shadow:0 10px 28px rgba(34,40,75,.055)!important;
}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .panel-head,
html[data-vano-theme="light"] .detail-body.vano-app-root:not(.vano-route-onboarding){border-color:#E8EAF1!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .page-subtitle,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .subtitle,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .muted,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .tiny{color:#707A8C!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .input,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .select,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .textarea,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .settings-field input,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .settings-field select,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .place-card input,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .invite-box input{
  background:#FBFBFD!important;color:#171A2B!important;border-color:#DDE1EA!important;box-shadow:none!important;
}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .input:focus,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .select:focus,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .textarea:focus,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .settings-field input:focus,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .settings-field select:focus{
  border-color:rgba(217,112,63,.62)!important;box-shadow:0 0 0 4px rgba(217,112,63,.09)!important;
}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .profile-detail summary .detail-icon,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .iconbox{background:#FFF4EC!important;color:#F59A62!important;border-color:#FFE0CC!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .profile-detail summary .detail-copy span,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .profile-card-head p,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .privacy-note,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .emergency-note,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .family-note{color:#748093!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .place-card,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .fuel-choice,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .family-person,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .style-choice{background:#FAFAFD!important;border-color:#E4E7EF!important;color:#252A3B!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .style-choice:has(input:checked){background:#FFFBF2!important;border-color:#FFC39B!important;box-shadow:0 0 0 3px rgba(217,112,63,.07)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .style-choice:has(input:checked) .style-select{background:#FFFBF2!important;color:#D9703F!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .invite-main{background:#FFF2E8!important;color:#D9703F!important;border:1px solid #E8DED6!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .profile-link i{color:#D9703F!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) footer{background:#F6F7FB!important;border-color:#E2E5ED!important;color:#7A8495!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .mobile-dock{background:rgba(255,255,255,.94)!important;border-color:#DEE2EB!important;box-shadow:0 14px 38px rgba(29,35,69,.10)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .mobile-dock a{color:#778195!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .mobile-dock a:hover{background:#FFF4EC!important;color:#D9703F!important}

/* ---------- Buttons ---------- */
body.vano-app-root:not(.vano-route-onboarding) .btn-primary,
body.vano-app-root:not(.vano-route-onboarding) .sheet-submit,
body.vano-app-root:not(.vano-route-onboarding) .auth-choice.primary{
  background:linear-gradient(135deg,#FFC39B 0%,#F59A62 58%,#D9703F 100%)!important;
  border-color:transparent!important;color:#fff!important;
  box-shadow:0 12px 28px rgba(217,112,63,.22)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .btn-primary:hover,
body.vano-app-root:not(.vano-route-onboarding) .sheet-submit:hover,
body.vano-app-root:not(.vano-route-onboarding) .auth-choice.primary:hover{filter:brightness(1.025);box-shadow:0 15px 34px rgba(217,112,63,.27)!important}
body.vano-app-root:not(.vano-route-onboarding) .btn:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) a:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) button:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) input:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) select:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) textarea:focus-visible{outline:3px solid rgba(217,112,63,.24)!important;outline-offset:2px}

/* ---------- Theme selector ---------- */
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting-v56{display:grid;gap:12px;padding:14px;border:1px solid var(--vano-line);border-radius:17px;background:var(--vano-card-2)}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting-v56 .theme-copy{display:flex;align-items:flex-start;gap:10px}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting-v56 .theme-icon{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;flex:none;background:#FFF2E8;color:#F59A62;border:1px solid #FFE0CC}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting-v56 .theme-copy>div{min-width:0;flex:1}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting-v56 .theme-copy b{display:block;font-size:11px;color:var(--vano-ink)}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting-v56 .theme-copy span{display:block;margin-top:4px;color:var(--vano-muted);font-size:8.5px;line-height:1.45}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-options{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:5px;background:#ECEEF4;border-radius:14px}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-option{height:40px;border:0;border-radius:10px;background:transparent;color:#697386;font-size:9px;font-weight:900;display:flex;align-items:center;justify-content:center;gap:6px}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-option.active{background:#fff;color:#D9703F;box-shadow:0 4px 14px rgba(35,40,70,.10)}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-meta{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;color:#7A8495;font-size:8px;line-height:1.4}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-meta [data-theme-state]{color:#555FC9;font-weight:800}

/* ---------- Black theme ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding){
  --vano-bg:#07080D;--vano-card:#101116;--vano-card-2:#15171D;--vano-ink:#F4F5F8;--vano-muted:#969EAC;--vano-line:#272A34;
  --bg:#07080D;--surface:#101116;--surface-2:#15171D;--surface-3:#1A1C23;--text:#F4F5F8;--muted:#969EAC;--muted-2:#777F8D;--line:#272A34;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding),
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding){background:#07080D!important;color:#F4F5F8!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting-v56{background:#15171D!important;border-color:#292C36!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-setting-v56 .theme-icon{background:#27231F!important;color:#FFC39B!important;border-color:#27231F!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-options{background:#0C0D12!important;border:1px solid #252832!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-option{color:#8F97A5!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-option.active{background:#27231F!important;color:#FFC39B!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-meta{color:#7F8794!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-meta [data-theme-state]{color:#FFC39B!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mobile-dock{background:rgba(10,11,15,.94)!important;border-color:#292C35!important}

/* ---------- Map app light refinement ---------- */
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding):has(.ws-app){background:#EEF1F7!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .search-card,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .sheet,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .destination-confirm,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-drawer{
  background:rgba(255,255,255,.965)!important;color:#171A2B!important;border-color:rgba(220,224,234,.95)!important;
  box-shadow:0 18px 48px rgba(28,34,66,.13)!important;
}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .location-row{background:#F8F9FC!important;border-color:#E2E5ED!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .location-input{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .location-input::placeholder{color:#8A93A2!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .chip-shortcut,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .quick,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .map-btn,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-stack-btn,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-audio-toggle{background:#fff!important;color:#5E687A!important;border-color:#E0E4EC!important;box-shadow:0 8px 22px rgba(33,39,71,.09)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-stack-btn.active,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-audio-toggle.active,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .map-btn.active{background:#FFF2E8!important;color:#D9703F!important;border-color:#E8DED6!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .segment,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .travel{background:#F1F3F7!important;border-color:#E1E4EC!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .segment button,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .travel button{color:#727D8F!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .segment button.active,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .travel button.active{background:#fff!important;color:#D9703F!important;box-shadow:0 3px 10px rgba(36,42,75,.09)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-card,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-variant,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .parking-nearby,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-insight{background:#FAFAFD!important;color:#252A3B!important;border-color:#E2E5ED!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .route-variant.active{background:#FFF4EC!important;border-color:#FFC39B!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-link{color:#32384A!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-link:hover{background:#FFF4EC!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-divider{background:#E7E9F0!important}

/* ---------- Entry / login: white + purple ---------- */
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding):has(.vano-entry){background:#F4F5FA!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .vano-entry{background:#F4F5FA!important;color:#171A2B!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-screen{background:#fff!important;border-color:#E2E5ED!important;box-shadow:0 30px 90px rgba(35,41,76,.12)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-screen:before{background:none!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-copy h1{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-copy h1 span{color:#F59A62!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-copy p{color:#697487!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-brandline{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-brandline span{color:#8A93A3!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-brandline img{filter:drop-shadow(0 7px 16px rgba(217,112,63,.18))!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .city-art:before{background:linear-gradient(180deg,#fff 0%,rgba(255,255,255,.68) 34%,transparent 100%)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .city-art:after{background:linear-gradient(0deg,#fff 0%,rgba(255,255,255,.64) 36%,transparent 100%)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .city-art img{filter:saturate(.88) contrast(1.02) brightness(1.02)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .city-route-badge{background:rgba(255,255,255,.90)!important;color:#444B5C!important;border-color:#E1E4ED!important;box-shadow:0 10px 28px rgba(30,36,70,.10)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-actions{background:#FAFAFD!important;border-color:#E7E9F0!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-actions-head h2{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-actions-head p{color:#707B8E!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-choice.secondary,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-guest{background:#fff!important;color:#2B3041!important;border-color:#DDE1EA!important;box-shadow:none!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-google{background:#fff!important;color:#202431!important;border-color:#DDE1EA!important;box-shadow:0 5px 16px rgba(35,41,70,.045)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-divider{color:#9098A7!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-divider:before,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-divider:after{background:#E4E7EE!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-legal{color:#8A93A3!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .sheet-backdrop{background:rgba(20,24,40,.34)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .sheet-card{background:#fff!important;color:#171A2B!important;border-color:#DFE3EC!important;box-shadow:0 30px 90px rgba(29,35,67,.22)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .sheet-grab{background:#D4D8E2!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .sheet-head h2{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .sheet-head p{color:#747E90!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .sheet-close{background:#F5F6F9!important;color:#6F7889!important;border-color:#E1E4EC!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .sheet-field label{color:#555F72!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .sheet-input,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .sheet-select{background:#F9FAFC!important;color:#171A2B!important;border-color:#DDE1EA!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .sheet-input:focus,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .sheet-select:focus{border-color:rgba(217,112,63,.62)!important;box-shadow:0 0 0 4px rgba(217,112,63,.08)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .sheet-switch{color:#7B8495!important}

/* Purple line exactly follows the official VANO palette. */
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .city-art .vano-login-route{filter:drop-shadow(0 0 8px rgba(217,112,63,.50))!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .city-art .vano-login-route path.route-halo{stroke:#F59A62!important;opacity:.12!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .city-art .vano-login-route path.route-main{stroke:url(#vanoLoginRouteGradient)!important;opacity:.98!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .splash-route{filter:drop-shadow(0 0 9px rgba(217,112,63,.72))!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .splash-route .route-halo{stroke:#F59A62!important;opacity:.10!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .splash-mark{filter:drop-shadow(0 0 18px rgba(217,112,63,.34))!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .splash-tag{color:#F59A62!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .splash-puck:after{background:#F59A62!important;box-shadow:0 0 12px rgba(217,112,63,.62)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .vano-splash:after{background:linear-gradient(90deg,#F59A62,#FFC39B,#F59A62)!important;box-shadow:0 0 10px rgba(217,112,63,.55)!important}

/* ---------- Responsive polish ---------- */
@media (max-width:699px){
  body.vano-app-root:not(.vano-route-onboarding) .container,
body.vano-app-root:not(.vano-route-onboarding) .nav{width:calc(100% - 20px)!important}
  body.vano-app-root:not(.vano-route-onboarding) .topbar{height:58px!important}
  body.vano-app-root:not(.vano-route-onboarding) .page{padding:18px 0 82px!important}
  body.vano-app-root:not(.vano-route-onboarding) .profile-shell{width:100%!important}
  body.vano-app-root:not(.vano-route-onboarding) .profile-hero,
body.vano-app-root:not(.vano-route-onboarding) .profile-card,
body.vano-app-root:not(.vano-route-onboarding) .profile-detail,
body.vano-app-root:not(.vano-route-onboarding) .profile-link{border-radius:16px!important}
  body.vano-app-root:not(.vano-route-onboarding) .settings-grid,
body.vano-app-root:not(.vano-route-onboarding) .place-grid{grid-template-columns:1fr!important}
  body.vano-app-root:not(.vano-route-onboarding) .settings-grid .full{grid-column:auto!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-theme-options{grid-template-columns:repeat(3,minmax(0,1fr))}
  body.vano-app-root:not(.vano-route-onboarding) .vano-theme-option{height:42px;font-size:8.5px}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .auth-screen{width:100%!important;max-width:520px!important;min-height:100svh!important;border:0!important;border-radius:0!important;box-shadow:none!important}
  html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .vano-entry .auth-screen{background:#fff!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-copy{padding-top:max(26px,env(safe-area-inset-top))!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-actions{padding-bottom:max(18px,env(safe-area-inset-bottom))!important}
}

@media (min-width:700px) and (max-width:1099px){
  body.vano-app-root:not(.vano-route-onboarding) .container{width:min(940px,calc(100% - 36px))!important}
  body.vano-app-root:not(.vano-route-onboarding) .profile-shell{max-width:860px!important}
  body.vano-app-root:not(.vano-route-onboarding) .settings-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry{padding:18px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-screen{width:min(1000px,calc(100vw - 36px))!important;height:min(780px,calc(100svh - 36px))!important;min-height:620px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-actions{padding:42px 34px!important}
}

@media (min-width:1100px){
  body.vano-app-root:not(.vano-route-onboarding) .container{width:min(1220px,calc(100% - 56px))!important}
  body.vano-app-root:not(.vano-route-onboarding) .profile-shell{max-width:940px!important}
  body.vano-app-root:not(.vano-route-onboarding) .profile-card,
body.vano-app-root:not(.vano-route-onboarding) .profile-detail{border-radius:20px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry{padding:28px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-screen{width:min(1180px,calc(100vw - 56px))!important;height:min(790px,calc(100svh - 56px))!important}
}

@media (orientation:landscape) and (max-height:620px){
  body.vano-app-root:not(.vano-route-onboarding) .page{padding-top:12px!important}
  body.vano-app-root:not(.vano-route-onboarding) .topbar{height:52px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry{padding:10px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-screen{height:calc(100svh - 20px)!important;min-height:500px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-copy{padding-top:28px!important;padding-bottom:8px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-copy h1{font-size:38px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-actions{padding-top:24px!important;padding-bottom:24px!important}
}

@media (pointer:coarse){
  body.vano-app-root:not(.vano-route-onboarding) button,
body.vano-app-root:not(.vano-route-onboarding) .btn,
body.vano-app-root:not(.vano-route-onboarding) a.auth-choice,
body.vano-app-root:not(.vano-route-onboarding) a.auth-google,
body.vano-app-root:not(.vano-route-onboarding) a.auth-guest,
body.vano-app-root:not(.vano-route-onboarding) .profile-link{min-height:44px}
}
@media (prefers-reduced-motion:reduce){
  body.vano-app-root:not(.vano-route-onboarding) *,
body.vano-app-root:not(.vano-route-onboarding) *:before,
body.vano-app-root:not(.vano-route-onboarding) *:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}

/* Entry information density: useful, not noisy. */
body.vano-app-root:not(.vano-route-onboarding) .auth-proof{display:flex;flex-wrap:wrap;gap:7px;margin-top:15px}
body.vano-app-root:not(.vano-route-onboarding) .auth-proof span{min-height:29px;display:inline-flex;align-items:center;gap:5px;padding:0 9px;border-radius:999px;font-size:7.5px;font-weight:820;letter-spacing:.01em}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-proof span{background:#FFFBF2;color:#D9703F;border:1px solid #FFFBF2}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-proof span{background:#19192C;color:#FFC39B;border:1px solid #27231F}
body.vano-app-root:not(.vano-route-onboarding) .auth-logout-note{display:flex;align-items:center;gap:9px;padding:11px 12px;border-radius:14px;margin-bottom:4px}
body.vano-app-root:not(.vano-route-onboarding) .auth-logout-note b{display:block;font-size:10px}body.vano-app-root:not(.vano-route-onboarding) .auth-logout-note span{display:block;margin-top:2px;font-size:8px}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-logout-note{background:#F0FAF6;border:1px solid #D7EFE4;color:#237555}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .auth-logout-note span{color:#56836F}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-logout-note{background:#10221B;border:1px solid #204735;color:#70D6A5}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-logout-note span{color:#79A993}
@media(max-width:430px){body.vano-app-root:not(.vano-route-onboarding) .auth-proof{gap:5px;margin-top:11px}body.vano-app-root:not(.vano-route-onboarding) .auth-proof span{font-size:7px;padding:0 7px;min-height:26px}}

/* Shared/live route pages also follow the same day/night system. */
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .share-app,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding):has(.share-app),
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .app,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding):has(.app){background:#F6F7FB!important;color:#171A2B!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .share-app .pill,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .share-app .bottom,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .app .brand,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .app .status,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .app .card{background:rgba(255,255,255,.94)!important;color:#171A2B!important;border-color:#E0E4EC!important;box-shadow:0 16px 40px rgba(34,40,72,.12)!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .share-app .pill span,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .share-app .route-label small,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .app .card p,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .app .privacy,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .app .stat span{color:#747F91!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .app .stat{background:#F8F9FC!important;border-color:#E2E5ED!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .share-app .veil,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .app .veil{background:linear-gradient(180deg,rgba(246,247,251,.18),transparent 24%,transparent 72%,rgba(246,247,251,.24))!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .vano-splash:before{
  background:linear-gradient(180deg,rgba(5,6,12,.28) 0%,rgba(5,6,12,.42) 34%,rgba(5,6,12,.64) 72%,#07080D 100%),url('/static/auth-city-route-vano.webp') center 49%/cover no-repeat!important;
}

/* ---------- Onboarding: same white/purple language ---------- */
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding):has(.onboard){background:#F6F7FB!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .onboard{background:#F6F7FB!important;color:#171A2B!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .vano-mini{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .vano-mini img{filter:drop-shadow(0 8px 16px rgba(217,112,63,.18))!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .step-pill{color:#D9703F!important;background:#FFF2E8!important;border-color:#E8DED6!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ob-progress{background:#E6E8EF!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ob-head h1{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ob-head h1 span{color:#6D7789!important}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ob-head p{color:#707B8E!important}
