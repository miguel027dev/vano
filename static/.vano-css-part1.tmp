body.vano-app-root:not(.vano-route-onboarding) .ob-section .select:focus{border-color:#F59A62!important;box-shadow:0 0 0 4px rgba(217,112,63,.09)!important}body.vano-app-root:not(.vano-route-onboarding) .ob-section .input::placeholder{color:#939CAB!important}body.vano-app-root:not(.vano-route-onboarding) .choice label,
