body.vano-app-root:not(.vano-route-onboarding) .place-popup-actions .use,
body.vano-app-root:not(.vano-route-onboarding) .place-popup-use{background:linear-gradient(135deg,#FFC39B,#F59A62)!important;color:#27231F!important;border-color:transparent!important;box-shadow:0 10px 26px rgba(217,112,63,.18)!important}body.vano-app-root:not(.vano-route-onboarding) .maneuver-icon,
body.vano-app-root:not(.vano-route-onboarding) .nav-maneuver-icon{background:linear-gradient(145deg,#FFC39B,#F59A62 60%,#D9703F)!important;color:#27231F!important}body.vano-app-root:not(.vano-route-onboarding) .pin.end i,
body.vano-app-root:not(.vano-route-onboarding) .arrival-pin{background:#F59A62!important}body.vano-app-root:not(.vano-route-onboarding) .pin.end i{box-shadow:0 0 0 4px rgba(245,154,98,.16),0 6px 14px rgba(112,104,97,.18)!important}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-content{background:#FFFBF2!important;color:#27231F!important;border-color:rgba(112,104,97,.16)!important;box-shadow:0 14px 38px rgba(112,104,97,.18)!important}body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-tip{border-top-color:#FFFBF2!important}body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-ctrl-attrib{background:rgba(255,251,242,.84)!important;color:#706861!important}
/* explicit route/marker brand tone */
body.vano-app-root:not(.vano-route-onboarding) .user-marker .pulse{background:rgba(245,154,98,.18)!important}body.vano-app-root:not(.vano-route-onboarding) .vano-nearby-users-notice{border-color:rgba(245,154,98,.25)!important}body.vano-app-root:not(.vano-route-onboarding) .vano-nearby-users-icon{color:#D9703F!important}
/* retain dark maneuver HUD from the board reference */
body.vano-app-root:not(.vano-route-onboarding) .nav-maneuver-top{background:#27231F!important;color:#FFFBF2!important;border-color:#27231F!important;box-shadow:0 16px 38px rgba(39,35,31,.22)!important}body.vano-app-root:not(.vano-route-onboarding) .nav-maneuver-top small,
body.vano-app-root:not(.vano-route-onboarding) .nav-maneuver-top span{color:#D5CEC7!important}


/* ---- vano-system.css ---- */
/* VANO v170 — complete visual system.
   Keeps the existing HTML/application structure and re-skins every shared surface
   with the VANO brand board: peach/orange, ivory, warm charcoal and warm gray. */
body.vano-app-root:not(.vano-route-onboarding){
  --vano-primary:#F59A62;
  --vano-primary-soft:#FFC39B;
  --vano-primary-deep:#D9703F;
  --vano-paper:#FFFBF2;
  --vano-paper-2:#FFF6EE;
  --vano-paper-3:#F7EEE5;
  --vano-ink:#27231F;
  --vano-muted:#706861;
  --vano-line:rgba(112,104,97,.16);
  --vano-line-strong:rgba(112,104,97,.25);
  --vano-white:#FFFFFF;
  --vano-shadow-sm:0 8px 24px rgba(79,58,43,.08);
  --vano-shadow:0 18px 50px rgba(79,58,43,.12);
  --vano-shadow-lg:0 30px 90px rgba(79,58,43,.16);
  --vano-ring:0 0 0 4px rgba(245,154,98,.16);
  --bg:#FFFBF2!important;
  --surface:#FFFFFF!important;
  --surface-2:#FFF6EE!important;
  --surface-3:#F7EEE5!important;
  --text:#27231F!important;
  --muted:#706861!important;
  --muted-2:#948A82!important;
  --line:rgba(112,104,97,.16)!important;
  --orange:#F59A62!important;
  --orange-2:#D9703F!important;
  --orange-3:#FFC39B!important;
  --o:#F59A62!important;
  --o2:#FFC39B!important;
  --shadow:var(--vano-shadow)!important;
  --brand:#F59A62!important;
  --brand-2:#D9703F!important;
  --brand-soft:#FFF0E5!important;
  --accent:#F59A62!important;
  --ink:#27231F!important;
  --soft:#FFF6EE!important;
}
html body.vano-app-root:not(.vano-route-onboarding){color-scheme:light!important;background:var(--vano-paper)!important}
html[data-vano-theme] body.vano-app-root:not(.vano-route-onboarding),
html[data-vano-theme] body.vano-app-root:not(.vano-route-onboarding){color-scheme:light!important}
body.vano-app-root:not(.vano-route-onboarding){
  color:var(--vano-ink)!important;
  background:
    radial-gradient(circle at 8% -8%,rgba(255,195,155,.28),transparent 30rem),
    radial-gradient(circle at 94% 0,rgba(245,154,98,.12),transparent 28rem),
    var(--vano-paper)!important;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
body.vano-app-root:not(.vano-route-onboarding):before{background:none!important}
body.vano-app-root:not(.vano-route-onboarding) ::selection{background:rgba(245,154,98,.28);color:var(--vano-ink)}
body.vano-app-root:not(.vano-route-onboarding) :focus-visible{outline:2px solid rgba(217,112,63,.55)!important;outline-offset:2px!important}

/* Header / navigation */
body.vano-app-root:not(.vano-route-onboarding) .topbar{
  background:rgba(255,251,242,.86)!important;
  border-bottom:1px solid rgba(112,104,97,.12)!important;
  box-shadow:0 8px 30px rgba(79,58,43,.045)!important;
  backdrop-filter:blur(24px) saturate(1.2)!important;
  -webkit-backdrop-filter:blur(24px) saturate(1.2)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .nav{gap:14px!important}
body.vano-app-root:not(.vano-route-onboarding) .brand{color:var(--vano-ink)!important;font-weight:880!important;letter-spacing:-.45px!important}
body.vano-app-root:not(.vano-route-onboarding) .brand>span{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-brand-wordmark{width:126px!important;height:38px!important;object-fit:contain!important;object-position:left center!important}
body.vano-app-root:not(.vano-route-onboarding) .navlinks a,
body.vano-app-root:not(.vano-route-onboarding) .navlinks button.navbtn{color:var(--vano-muted)!important;border-radius:999px!important;font-weight:720!important}
body.vano-app-root:not(.vano-route-onboarding) .navlinks a:hover,
body.vano-app-root:not(.vano-route-onboarding) .navlinks button.navbtn:hover,
body.vano-app-root:not(.vano-route-onboarding) .navlinks a.active{background:rgba(245,154,98,.11)!important;color:var(--vano-ink)!important}

/* Buttons */
body.vano-app-root:not(.vano-route-onboarding) .btn,
body.vano-app-root:not(.vano-route-onboarding) .auth-button,
body.vano-app-root:not(.vano-route-onboarding) .profile-v108-button,
body.vano-app-root:not(.vano-route-onboarding) .guest-limit-primary,
body.vano-app-root:not(.vano-route-onboarding) .guest-limit-secondary{
  border-radius:14px!important;
  font-weight:800!important;
  letter-spacing:-.12px!important;
  transition:transform .18s cubic-bezier(.2,.8,.2,1),box-shadow .18s ease,border-color .18s ease,background .18s ease!important;
}
body.vano-app-root:not(.vano-route-onboarding) .btn{
  background:rgba(255,255,255,.92)!important;
  color:var(--vano-ink)!important;
  border:1px solid var(--vano-line)!important;
  box-shadow:0 5px 16px rgba(79,58,43,.045)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .btn:hover{transform:translateY(-1px)!important;border-color:rgba(217,112,63,.28)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-app-root:not(.vano-route-onboarding) .btn:active{transform:translateY(0) scale(.985)!important}
body.vano-app-root:not(.vano-route-onboarding) .btn-primary{
  color:#fff!important;
  border-color:transparent!important;
  background:linear-gradient(135deg,#FFC39B 0%,#F59A62 45%,#D9703F 100%)!important;
  box-shadow:0 11px 26px rgba(217,112,63,.22),inset 0 1px 0 rgba(255,255,255,.42)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .btn-primary:hover{box-shadow:0 15px 34px rgba(217,112,63,.27),inset 0 1px 0 rgba(255,255,255,.46)!important}
body.vano-app-root:not(.vano-route-onboarding) .btn-danger{background:#FFF3F0!important;border-color:#F3CDC6!important;color:#A04435!important}

/* Shared cards / panels / forms */
body.vano-app-root:not(.vano-route-onboarding) .card,
body.vano-app-root:not(.vano-route-onboarding) .panel,
body.vano-app-root:not(.vano-route-onboarding) .kpi,
body.vano-app-root:not(.vano-route-onboarding) .alert-card,
body.vano-app-root:not(.vano-route-onboarding) .auth-card,
body.vano-app-root:not(.vano-route-onboarding) .modal-card,
body.vano-app-root:not(.vano-route-onboarding) .sheet-card{
  background:rgba(255,255,255,.94)!important;
  color:var(--vano-ink)!important;
  border-color:var(--vano-line)!important;
  box-shadow:var(--vano-shadow-sm)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .card:hover,
body.vano-app-root:not(.vano-route-onboarding) .panel:hover{border-color:rgba(217,112,63,.23)!important}
body.vano-app-root:not(.vano-route-onboarding) .panel-head{border-bottom-color:rgba(112,104,97,.12)!important}
body.vano-app-root:not(.vano-route-onboarding) .subtitle,
body.vano-app-root:not(.vano-route-onboarding) .page-subtitle,
body.vano-app-root:not(.vano-route-onboarding) .muted,
body.vano-app-root:not(.vano-route-onboarding) .tiny,
body.vano-app-root:not(.vano-route-onboarding) .card p,
body.vano-app-root:not(.vano-route-onboarding) .panel p{color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .eyebrow{color:var(--vano-primary-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .title,
body.vano-app-root:not(.vano-route-onboarding) .page-title,
body.vano-app-root:not(.vano-route-onboarding) .section-title{color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .title span,
body.vano-app-root:not(.vano-route-onboarding) .section-title span,
body.vano-app-root:not(.vano-route-onboarding) .hero h1 span{color:var(--vano-primary-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .iconbox{
  background:linear-gradient(145deg,#FFF7F0,#FFE7D6)!important;
  color:var(--vano-primary-deep)!important;
  border-color:#FFDCC6!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 9px 22px rgba(217,112,63,.08)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .input,
body.vano-app-root:not(.vano-route-onboarding) .select,
body.vano-app-root:not(.vano-route-onboarding) .textarea,
body.vano-app-root:not(.vano-route-onboarding) input:not([type=radio]):not([type=checkbox]):not([type=hidden]),
body.vano-app-root:not(.vano-route-onboarding) select,
body.vano-app-root:not(.vano-route-onboarding) textarea{
  color:var(--vano-ink)!important;
  background:rgba(255,255,255,.94)!important;
  border-color:var(--vano-line)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .input::placeholder,
body.vano-app-root:not(.vano-route-onboarding) .textarea::placeholder,
body.vano-app-root:not(.vano-route-onboarding) input::placeholder,
body.vano-app-root:not(.vano-route-onboarding) textarea::placeholder{color:#9C9189!important}
body.vano-app-root:not(.vano-route-onboarding) .input:focus,
body.vano-app-root:not(.vano-route-onboarding) .select:focus,
body.vano-app-root:not(.vano-route-onboarding) .textarea:focus,
body.vano-app-root:not(.vano-route-onboarding) input:focus,
body.vano-app-root:not(.vano-route-onboarding) select:focus,
body.vano-app-root:not(.vano-route-onboarding) textarea:focus{
  border-color:rgba(217,112,63,.5)!important;
  box-shadow:var(--vano-ring)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .badge{background:#FFF3E9!important;border-color:#FFD9C2!important;color:#A9522D!important}
body.vano-app-root:not(.vano-route-onboarding) .badge.green{background:#EDF8F3!important;border-color:#CDE8DB!important;color:#2B7258!important}
body.vano-app-root:not(.vano-route-onboarding) .badge.red{background:#FFF0EE!important;border-color:#F0CAC4!important;color:#A34B3E!important}
body.vano-app-root:not(.vano-route-onboarding) .table th{color:#8E837C!important;background:#FFF8F2!important;border-color:var(--vano-line)!important}
body.vano-app-root:not(.vano-route-onboarding) .table td{color:var(--vano-ink)!important;border-color:rgba(112,104,97,.10)!important}
body.vano-app-root:not(.vano-route-onboarding) .table tr:hover td{background:#FFFAF6!important}
body.vano-app-root:not(.vano-route-onboarding) .flash{background:rgba(255,255,255,.96)!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important;box-shadow:var(--vano-shadow-sm)!important}

/* Landing / public pages */
body.vano-app-root:not(.vano-route-onboarding) .hero-card{background:linear-gradient(145deg,#FFFFFF,#FFF6EE)!important;border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-lg)!important}
body.vano-app-root:not(.vano-route-onboarding) .mock-map{background:radial-gradient(circle at 30% 20%,#FFFDF9,#F4EDE6 62%,#EEE4DA)!important}
body.vano-app-root:not(.vano-route-onboarding) .mock-map:before,
body.vano-app-root:not(.vano-route-onboarding) .mock-map:after{filter:none!important;opacity:.7!important}
body.vano-app-root:not(.vano-route-onboarding) .map-bubble{background:rgba(39,35,31,.92)!important;color:#fff!important;border-color:rgba(255,255,255,.10)!important;box-shadow:0 15px 36px rgba(39,35,31,.18)!important}
body.vano-app-root:not(.vano-route-onboarding) .map-bubble small{color:#D9D1CB!important}
body.vano-app-root:not(.vano-route-onboarding) .route-line{border-color:var(--vano-primary)!important;border-left-color:transparent!important;border-bottom-color:var(--vano-primary-soft)!important;filter:drop-shadow(0 0 12px rgba(245,154,98,.27))!important}

/* Mobile dock */
body.vano-app-root:not(.vano-route-onboarding) .mobile-dock{
  background:rgba(255,251,242,.94)!important;
  border-color:rgba(112,104,97,.14)!important;
  box-shadow:0 16px 42px rgba(79,58,43,.14)!important;
  backdrop-filter:blur(24px) saturate(1.2)!important;
  -webkit-backdrop-filter:blur(24px) saturate(1.2)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .mobile-dock a{color:#847A73!important}
body.vano-app-root:not(.vano-route-onboarding) .mobile-dock a:hover,
body.vano-app-root:not(.vano-route-onboarding) .mobile-dock a.active{background:#FFF0E5!important;color:var(--vano-primary-deep)!important}

/* Login standalone: override legacy purple without changing its structure */
body.vano-app-root:not(.vano-route-onboarding) .auth-page{background:
  radial-gradient(circle at 8% 0,rgba(255,195,155,.26),transparent 34rem),
  var(--vano-paper)!important}
body.vano-app-root:not(.vano-route-onboarding) .auth-shell{background:#fff!important;border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-lg)!important}
body.vano-app-root:not(.vano-route-onboarding) .auth-pane{background:linear-gradient(160deg,#FFFFFF 0%,#FFFCF8 100%)!important}
body.vano-app-root:not(.vano-route-onboarding) .auth-page .eyebrow,
body.vano-app-root:not(.vano-route-onboarding) .auth-page h1 span{color:var(--vano-primary-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .auth-page .eyebrow:before{background:var(--vano-primary)!important}
body.vano-app-root:not(.vano-route-onboarding) .product-pill{background:#FFF8F2!important;border-color:var(--vano-line)!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .product-pill i{background:var(--vano-primary)!important;box-shadow:0 0 0 4px rgba(245,154,98,.13)!important}
body.vano-app-root:not(.vano-route-onboarding) .auth-button.email{
  background:linear-gradient(135deg,#FFC39B,#F59A62 52%,#D9703F)!important;
  color:#fff!important;
  box-shadow:0 12px 28px rgba(217,112,63,.23)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .auth-button.google{border-color:var(--vano-line)!important;box-shadow:0 6px 18px rgba(79,58,43,.06)!important}
body.vano-app-root:not(.vano-route-onboarding) .auth-links a:hover{color:var(--vano-primary-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .route-pane{background:#F4EEE7!important;border-left-color:var(--vano-line)!important}
body.vano-app-root:not(.vano-route-onboarding) .route-glow{background:rgba(245,154,98,.17)!important}
body.vano-app-root:not(.vano-route-onboarding) .live-badge,
body.vano-app-root:not(.vano-route-onboarding) .mini-chip,
body.vano-app-root:not(.vano-route-onboarding) .route-summary,
body.vano-app-root:not(.vano-route-onboarding) .reroute-card{border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-app-root:not(.vano-route-onboarding) .mini-chip svg,
body.vano-app-root:not(.vano-route-onboarding) .reroute-icon{color:var(--vano-primary-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .reroute-icon{background:#FFF0E5!important}
body.vano-app-root:not(.vano-route-onboarding) .reroute-line i{background:linear-gradient(90deg,var(--vano-primary-soft),var(--vano-primary-deep))!important}
body.vano-app-root:not(.vano-route-onboarding) .location-dot{background:var(--vano-primary)!important;box-shadow:0 4px 16px rgba(217,112,63,.28)!important}
body.vano-app-root:not(.vano-route-onboarding) .location-dot.end{background:var(--vano-ink)!important}

/* Onboarding/profile/admin polish */
body.vano-app-root:not(.vano-route-onboarding) .ob-card,
body.vano-app-root:not(.vano-route-onboarding) .profile-v108-card,
body.vano-app-root:not(.vano-route-onboarding) .profile-v72-card,
body.vano-app-root:not(.vano-route-onboarding) .activity-card,
body.vano-app-root:not(.vano-route-onboarding) .admin-card,
body.vano-app-root:not(.vano-route-onboarding) .admin-kpi{
  background:#fff!important;
  border-color:var(--vano-line)!important;
  box-shadow:var(--vano-shadow-sm)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ob-option.active,
body.vano-app-root:not(.vano-route-onboarding) .profile-v72-accent:has(input:checked),
body.vano-app-root:not(.vano-route-onboarding) .profile-v108-quick a:hover{
  border-color:rgba(217,112,63,.34)!important;
  background:#FFF5EC!important;
}
body.vano-app-root:not(.vano-route-onboarding) .profile-v108-quick-icon,
body.vano-app-root:not(.vano-route-onboarding) .profile-v72-icon,
body.vano-app-root:not(.vano-route-onboarding) .ob-icon{background:#FFF0E5!important;color:var(--vano-primary-deep)!important}

/* Shared route / live trip standalone */
body.vano-app-root:not(.vano-route-onboarding) .share-app,
body.vano-app-root:not(.vano-route-onboarding) .live-app{background:#F5EFE8!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .share-top,
body.vano-app-root:not(.vano-route-onboarding) .route-panel,
body.vano-app-root:not(.vano-route-onboarding) .live-top,
body.vano-app-root:not(.vano-route-onboarding) .live-app .card{background:rgba(255,251,242,.96)!important;border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow)!important}
body.vano-app-root:not(.vano-route-onboarding) .route-kicker,
body.vano-app-root:not(.vano-route-onboarding) .live-app .eyebrow{color:var(--vano-primary-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .route-actions .primary{background:linear-gradient(135deg,#FFC39B,#F59A62 55%,#D9703F)!important;color:#fff!important;box-shadow:0 10px 24px rgba(217,112,63,.2)!important}
body.vano-app-root:not(.vano-route-onboarding) .route-note{background:#FFF1E7!important;color:#8A4B2D!important}
body.vano-app-root:not(.vano-route-onboarding) .metric,
body.vano-app-root:not(.vano-route-onboarding) .stat{background:#FFF9F4!important;border-color:var(--vano-line)!important}
body.vano-app-root:not(.vano-route-onboarding) .progress i{background:linear-gradient(90deg,#FFC39B,#F59A62,#D9703F)!important}

@media(max-width:760px){
  body.vano-app-root:not(.vano-route-onboarding) .topbar{background:rgba(255,251,242,.94)!important}
  body.vano-app-root:not(.vano-route-onboarding) .container,
body.vano-app-root:not(.vano-route-onboarding) .nav{width:calc(100% - 18px)!important}
  body.vano-app-root:not(.vano-route-onboarding) .page{padding-top:18px!important}
  body.vano-app-root:not(.vano-route-onboarding) .card,
body.vano-app-root:not(.vano-route-onboarding) .panel{border-radius:18px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page{padding:0!important;background:#fff!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-shell{border:0!important;border-radius:0!important;min-height:100dvh!important;box-shadow:none!important}
}

@media(prefers-reduced-motion:reduce){
  body.vano-app-root:not(.vano-route-onboarding) *,
body.vano-app-root:not(.vano-route-onboarding) *:before,
body.vano-app-root:not(.vano-route-onboarding) *:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}


/* Dedicated admin/risk screens that shipped with hard-coded violet rules. */
body.vano-app-root:not(.vano-route-onboarding):has(.risk-admin){background:var(--vano-paper)!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding):has(.risk-admin) .topbar{background:rgba(255,251,242,.94)!important;border-color:var(--vano-line)!important}
body.vano-app-root:not(.vano-route-onboarding) .risk-eyebrow{color:var(--vano-primary-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .risk-card{border-color:var(--vano-line)!important;background:#fff!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-app-root:not(.vano-route-onboarding) .risk-card-head{border-color:rgba(112,104,97,.11)!important}
body.vano-app-root:not(.vano-route-onboarding) .rf-input,
body.vano-app-root:not(.vano-route-onboarding) .rf-select{background:#FFFCF9!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .rf-input:focus,
body.vano-app-root:not(.vano-route-onboarding) .rf-select:focus{border-color:rgba(217,112,63,.52)!important;box-shadow:var(--vano-ring)!important}
body.vano-app-root:not(.vano-route-onboarding) .switch input:checked+span{background:linear-gradient(135deg,var(--vano-primary-soft),var(--vano-primary))!important}
body.vano-app-root:not(.vano-route-onboarding) .risk-submit{background:linear-gradient(135deg,#FFC39B,#F59A62 52%,#D9703F)!important;box-shadow:0 10px 24px rgba(217,112,63,.2)!important}
body.vano-app-root:not(.vano-route-onboarding) .zone-pill{background:#FFF1E7!important;color:#A4512D!important}
body.vano-app-root:not(.vano-route-onboarding) .policy-note{background:#FFF6EF!important;border-color:#FFE0CD!important;color:#795C4B!important}
body.vano-app-root:not(.vano-route-onboarding) .risk-back,
body.vano-app-root:not(.vano-route-onboarding) .mini-btn{border-color:var(--vano-line)!important;color:var(--vano-ink)!important}

/* Register / entry experience */
body.vano-app-root:not(.vano-route-onboarding):has(.vano-entry),
body.vano-app-root:not(.vano-route-onboarding) .vano-entry{background:var(--vano-paper)!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .v63-entry-shell{background:#fff!important;border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-lg)!important}
body.vano-app-root:not(.vano-route-onboarding) .v63-entry-shell:before{background:linear-gradient(115deg,rgba(255,255,255,.96) 0 43%,rgba(255,246,238,.54) 43% 100%)!important}
body.vano-app-root:not(.vano-route-onboarding) .v63-entry-brand em,
body.vano-app-root:not(.vano-route-onboarding) .v63-entry-kicker,
body.vano-app-root:not(.vano-route-onboarding) .v63-entry-panel h1 span{color:var(--vano-primary-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .v63-entry-brand em{background:#FFF0E5!important}
body.vano-app-root:not(.vano-route-onboarding) .v63-entry-proof span{border-color:var(--vano-line)!important;background:#FFF9F4!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .v63-route-stage{background:radial-gradient(circle at 72% 8%,rgba(255,195,155,.22),transparent 26%),linear-gradient(145deg,#FFF9F4,#F0E7DE)!important;border-color:var(--vano-line)!important}
body.vano-app-root:not(.vano-route-onboarding) .v63-stage-card,
body.vano-app-root:not(.vano-route-onboarding) .v63-stage-brand{background:rgba(255,251,242,.90)!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-app-root:not(.vano-route-onboarding) .auth-choice.primary,
body.vano-app-root:not(.vano-route-onboarding) .auth-google.auth-google-primary{background:linear-gradient(135deg,#FFC39B,#F59A62 50%,#D9703F)!important;color:#fff!important;border-color:transparent!important;box-shadow:0 12px 28px rgba(217,112,63,.21)!important}
body.vano-app-root:not(.vano-route-onboarding) .auth-choice.secondary,
body.vano-app-root:not(.vano-route-onboarding) .auth-guest{background:#fff!important;color:var(--vano-ink)!important;border-color:var(--vano-line)!important}
body.vano-app-root:not(.vano-route-onboarding) .auth-sheet .sheet-card{border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-lg)!important}
body.vano-app-root:not(.vano-route-onboarding) .sheet-input:focus,
body.vano-app-root:not(.vano-route-onboarding) .sheet-select:focus{border-color:rgba(217,112,63,.5)!important;box-shadow:var(--vano-ring)!important}
body.vano-app-root:not(.vano-route-onboarding) .sheet-submit{background:linear-gradient(135deg,#FFC39B,#F59A62 50%,#D9703F)!important;box-shadow:0 12px 26px rgba(217,112,63,.21)!important}

/* Onboarding: convert the legacy dark setup flow into a warm VANO setup flow. */
body.vano-app-root:not(.vano-route-onboarding) .onboard{
  background:radial-gradient(circle at 86% -6%,rgba(255,195,155,.30),transparent 30rem),radial-gradient(circle at 4% 36%,rgba(245,154,98,.10),transparent 25rem),var(--vano-paper)!important;
  color:var(--vano-ink)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-mini{color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-mini img{filter:drop-shadow(0 8px 18px rgba(217,112,63,.16))!important}
body.vano-app-root:not(.vano-route-onboarding) .step-pill{color:var(--vano-primary-deep)!important;border-color:#FFD7BF!important;background:#FFF1E6!important}
body.vano-app-root:not(.vano-route-onboarding) .ob-progress{background:#EFE4DB!important}body.vano-app-root:not(.vano-route-onboarding) .ob-progress i{background:linear-gradient(90deg,#FFC39B,#F59A62,#D9703F)!important;box-shadow:0 0 15px rgba(245,154,98,.22)!important}
body.vano-app-root:not(.vano-route-onboarding) .ob-head .eyebrow{color:var(--vano-primary-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .ob-head h1{color:var(--vano-ink)!important}body.vano-app-root:not(.vano-route-onboarding) .ob-head h1 span{color:#8A7F77!important}body.vano-app-root:not(.vano-route-onboarding) .ob-head p{color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .ob-section{border-color:var(--vano-line)!important;background:rgba(255,255,255,.92)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-app-root:not(.vano-route-onboarding) .ob-section-title .ico{background:#FFF0E5!important;border-color:#FFDCC7!important;color:var(--vano-primary-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .ob-section-title b{color:var(--vano-ink)!important}body.vano-app-root:not(.vano-route-onboarding) .ob-section-title span{color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .input,
body.vano-app-root:not(.vano-route-onboarding) .onboard .select{background:#FFFCF9!important;color:var(--vano-ink)!important;border-color:var(--vano-line)!important}
body.vano-app-root:not(.vano-route-onboarding) .onboard .input::placeholder{color:#A0958D!important}
body.vano-app-root:not(.vano-route-onboarding) .choice label,
body.vano-app-root:not(.vano-route-onboarding) .pref label,
body.vano-app-root:not(.vano-route-onboarding) .night-card{background:#FFFDFC!important;border-color:var(--vano-line)!important}
body.vano-app-root:not(.vano-route-onboarding) .choice label b,
body.vano-app-root:not(.vano-route-onboarding) .pref label b,
body.vano-app-root:not(.vano-route-onboarding) .night-card b,
body.vano-app-root:not(.vano-route-onboarding) .presence-consent b{color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .choice label span,
body.vano-app-root:not(.vano-route-onboarding) .pref label span,
body.vano-app-root:not(.vano-route-onboarding) .night-card span,
body.vano-app-root:not(.vano-route-onboarding) .presence-consent span span{color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .choice input:checked+label,
body.vano-app-root:not(.vano-route-onboarding) .pref input:checked+label{border-color:rgba(217,112,63,.38)!important;background:#FFF2E8!important;box-shadow:inset 0 0 0 1px rgba(245,154,98,.05)!important}
body.vano-app-root:not(.vano-route-onboarding) .pref-icon{background:#FFF5ED!important;color:#8A7E76!important}body.vano-app-root:not(.vano-route-onboarding) .pref input:checked+label .pref-icon{background:#FFEBDD!important;color:var(--vano-primary-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .radio-dot{border-color:#CFC2B8!important}body.vano-app-root:not(.vano-route-onboarding) .pref input:checked+label .radio-dot{border-color:var(--vano-primary)!important}body.vano-app-root:not(.vano-route-onboarding) .pref input:checked+label .radio-dot:after{background:var(--vano-primary)!important}
body.vano-app-root:not(.vano-route-onboarding) .slider{background:#D7CCC3!important}body.vano-app-root:not(.vano-route-onboarding) .switch input:checked+.slider{background:linear-gradient(135deg,var(--vano-primary-soft),var(--vano-primary))!important}
body.vano-app-root:not(.vano-route-onboarding) .mini-note{background:#FFF8F2!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .privacy-note{background:#FFF6EF!important;border-color:#FFE1CE!important;color:#796C63!important}body.vano-app-root:not(.vano-route-onboarding) .privacy-note i{color:var(--vano-primary-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .presence-consent{border-color:#FFD9C3!important;background:#FFF4EB!important}
body.vano-app-root:not(.vano-route-onboarding) .fine,
body.vano-app-root:not(.vano-route-onboarding) .optional,
body.vano-app-root:not(.vano-route-onboarding) .vehicle-hint{color:#887D75!important}body.vano-app-root:not(.vano-route-onboarding) .vehicle-hint i{color:var(--vano-primary-deep)!important}

/* Live trip standalone */
body.vano-app-root:not(.vano-route-onboarding) .app{background:#F4EEE7!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .app .map{background:#F1EAE3!important}
body.vano-app-root:not(.vano-route-onboarding) .app .veil{background:linear-gradient(180deg,rgba(255,251,242,.18),transparent 24%,transparent 70%,rgba(255,251,242,.12))!important}
body.vano-app-root:not(.vano-route-onboarding) .app .brand,
body.vano-app-root:not(.vano-route-onboarding) .app .status{background:rgba(255,251,242,.95)!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-app-root:not(.vano-route-onboarding) .app .status{color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .app .dot{background:var(--vano-primary)!important;box-shadow:0 0 0 5px rgba(245,154,98,.13)!important}
body.vano-app-root:not(.vano-route-onboarding) .app .card{background:rgba(255,251,242,.97)!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important;box-shadow:0 -14px 42px rgba(67,49,37,.14)!important}
body.vano-app-root:not(.vano-route-onboarding) .app .grab{background:#D6CBC2!important}body.vano-app-root:not(.vano-route-onboarding) .app .eyebrow{color:var(--vano-primary-deep)!important}body.vano-app-root:not(.vano-route-onboarding) .app .card p,
body.vano-app-root:not(.vano-route-onboarding) .app .stat span,
body.vano-app-root:not(.vano-route-onboarding) .app .privacy{color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .app .stat{background:#FFF8F2!important;border-color:var(--vano-line)!important}body.vano-app-root:not(.vano-route-onboarding) .app .progress{background:#EDE2D9!important}
body.vano-app-root:not(.vano-route-onboarding) .app .progress i{background:linear-gradient(90deg,#FFC39B,#F59A62,#D9703F)!important}
body.vano-app-root:not(.vano-route-onboarding) .app .puck{background:linear-gradient(145deg,#FFC39B,#F59A62 55%,#D9703F)!important;border-color:#FFFBF2!important;box-shadow:0 0 0 4px rgba(39,35,31,.82),0 9px 22px rgba(39,35,31,.24)!important}
body.vano-app-root:not(.vano-route-onboarding) .app .offline{background:var(--vano-paper)!important;color:var(--vano-ink)!important}body.vano-app-root:not(.vano-route-onboarding) .app .offline p{color:var(--vano-muted)!important}


/* ---- vano-map.css ---- */
/* VANO v170 — Mapbox/navigation redesign. Geometry and IDs are preserved. */
body.vano-app-root:not(.vano-route-onboarding) .ws-app{
  --v-card:rgba(255,251,242,.965);
  --v-card-solid:#FFFBF2;
  --v-ink:#27231F;
  --v-muted:#706861;
  --v-primary:#F59A62;
  --v-light:#FFC39B;
  --v-deep:#D9703F;
  --v-line:rgba(112,104,97,.17);
  --v-shadow:0 18px 48px rgba(67,49,37,.14);
  background:#F4EEE7!important;
  color:var(--v-ink)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app #map{background:#F4EEE7!important}
body.vano-app-root:not(.vano-route-onboarding) .map-vignette{background:linear-gradient(180deg,rgba(255,251,242,.40),transparent 18%,transparent 76%,rgba(255,251,242,.14))!important}
body.vano-app-root:not(.vano-route-onboarding) .ambient-halo{opacity:.45!important;filter:saturate(.78)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-map-brand{
  background:rgba(255,251,242,.86)!important;
  border:1px solid rgba(112,104,97,.11)!important;
  border-radius:16px!important;
  box-shadow:0 8px 24px rgba(67,49,37,.09)!important;
  backdrop-filter:blur(18px) saturate(1.15)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-map-brand img{filter:none!important}

/* Search / planning sheet */
body.vano-app-root:not(.vano-route-onboarding) .search-card,
body.vano-app-root:not(.vano-route-onboarding) .planner-search-card.search-card{
  background:rgba(255,251,242,.94)!important;
  color:var(--v-ink)!important;
  border:1px solid rgba(112,104,97,.15)!important;
  border-radius:22px!important;
  box-shadow:0 14px 36px rgba(67,49,37,.13),inset 0 1px 0 rgba(255,255,255,.92)!important;
  backdrop-filter:blur(24px) saturate(1.25)!important;
  -webkit-backdrop-filter:blur(24px) saturate(1.25)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .location-row+.location-row{border-top-color:rgba(112,104,97,.10)!important}
body.vano-app-root:not(.vano-route-onboarding) .location-input{color:var(--v-ink)!important;font-weight:760!important;letter-spacing:-.18px!important}
body.vano-app-root:not(.vano-route-onboarding) .location-input::placeholder{color:#958A82!important}
body.vano-app-root:not(.vano-route-onboarding) .row-btn,
body.vano-app-root:not(.vano-route-onboarding) .planner-adjust-btn,
body.vano-app-root:not(.vano-route-onboarding) .map-btn,
body.vano-app-root:not(.vano-route-onboarding) .options-btn,
body.vano-app-root:not(.vano-route-onboarding) .floating-locate,
body.vano-app-root:not(.vano-route-onboarding) .nav-stack-btn,
body.vano-app-root:not(.vano-route-onboarding) .nav-audio-toggle,
body.vano-app-root:not(.vano-route-onboarding) .nav-search-btn{
  background:rgba(255,251,242,.96)!important;
  color:var(--v-ink)!important;
  border:1px solid rgba(112,104,97,.13)!important;
  box-shadow:0 8px 22px rgba(67,49,37,.105)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .row-btn:hover,
body.vano-app-root:not(.vano-route-onboarding) .planner-adjust-btn:hover,
body.vano-app-root:not(.vano-route-onboarding) .map-btn:hover,
body.vano-app-root:not(.vano-route-onboarding) .options-btn:hover,
body.vano-app-root:not(.vano-route-onboarding) .floating-locate:hover,
body.vano-app-root:not(.vano-route-onboarding) .nav-stack-btn:hover,
body.vano-app-root:not(.vano-route-onboarding) .nav-audio-toggle:hover{background:#FFF0E5!important;color:var(--v-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .search-results,
body.vano-app-root:not(.vano-route-onboarding) .search-results.search-results-portal{
  background:rgba(255,251,242,.985)!important;
  color:var(--v-ink)!important;
  border:1px solid rgba(112,104,97,.15)!important;
  box-shadow:0 20px 52px rgba(67,49,37,.16)!important;
  backdrop-filter:blur(22px)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .search-item{border-color:rgba(112,104,97,.08)!important}
body.vano-app-root:not(.vano-route-onboarding) .search-item:hover,
body.vano-app-root:not(.vano-route-onboarding) .search-item:active{background:#FFF3E9!important}
body.vano-app-root:not(.vano-route-onboarding) .result-icon,
body.vano-app-root:not(.vano-route-onboarding) .planner-preset-icon,
body.vano-app-root:not(.vano-route-onboarding) .nearby-service-icon{
  background:linear-gradient(145deg,#FFF3E9,#FFE6D4)!important;
  color:var(--v-deep)!important;
  border-color:#FFDDC8!important;
}
body.vano-app-root:not(.vano-route-onboarding) .result-copy b,
body.vano-app-root:not(.vano-route-onboarding) .planner-heading-copy b{color:var(--v-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .result-copy small,
body.vano-app-root:not(.vano-route-onboarding) .result-meta,
body.vano-app-root:not(.vano-route-onboarding) .search-label,
body.vano-app-root:not(.vano-route-onboarding) .search-message,
body.vano-app-root:not(.vano-route-onboarding) .planner-tip,
body.vano-app-root:not(.vano-route-onboarding) .planner-heading-copy span{color:var(--v-muted)!important}

body.vano-app-root:not(.vano-route-onboarding) .sheet#planSheet,
body.vano-app-root:not(.vano-route-onboarding) .sheet,
body.vano-app-root:not(.vano-route-onboarding) .destination-confirm,
body.vano-app-root:not(.vano-route-onboarding) .prefs-drawer,
body.vano-app-root:not(.vano-route-onboarding) .safety-drawer,
body.vano-app-root:not(.vano-route-onboarding) .account-drawer,
body.vano-app-root:not(.vano-route-onboarding) .options-drawer{
  background:rgba(255,251,242,.975)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.15)!important;
  box-shadow:0 -14px 52px rgba(67,49,37,.15)!important;
  backdrop-filter:blur(26px) saturate(1.18)!important;
  -webkit-backdrop-filter:blur(26px) saturate(1.18)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .grab,
body.vano-app-root:not(.vano-route-onboarding) .sheet-grab{background:#D9D0C8!important}
body.vano-app-root:not(.vano-route-onboarding) .planner-preset,
body.vano-app-root:not(.vano-route-onboarding) .nearby-service,
body.vano-app-root:not(.vano-route-onboarding) .quick,
body.vano-app-root:not(.vano-route-onboarding) .route-card,
body.vano-app-root:not(.vano-route-onboarding) .parking-nearby,
body.vano-app-root:not(.vano-route-onboarding) .parking-item,
body.vano-app-root:not(.vano-route-onboarding) .route-insight .insight,
body.vano-app-root:not(.vano-route-onboarding) .sub-action,
body.vano-app-root:not(.vano-route-onboarding) .safety-tool,
body.vano-app-root:not(.vano-route-onboarding) .pref-row{
  background:rgba(255,255,255,.88)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.13)!important;
  box-shadow:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) .planner-preset:hover,
body.vano-app-root:not(.vano-route-onboarding) .nearby-service:hover,
body.vano-app-root:not(.vano-route-onboarding) .quick:hover,
body.vano-app-root:not(.vano-route-onboarding) .parking-item:hover,
body.vano-app-root:not(.vano-route-onboarding) .sub-action:hover{background:#FFF4EB!important;border-color:rgba(217,112,63,.22)!important}
body.vano-app-root:not(.vano-route-onboarding) .segment,
body.vano-app-root:not(.vano-route-onboarding) .travel{background:#F8EFE7!important;border-color:rgba(112,104,97,.12)!important;padding:4px!important}
body.vano-app-root:not(.vano-route-onboarding) .segment button,
body.vano-app-root:not(.vano-route-onboarding) .travel button{color:#7B716A!important;border-color:transparent!important;border-radius:12px!important}
body.vano-app-root:not(.vano-route-onboarding) .segment button.active,
body.vano-app-root:not(.vano-route-onboarding) .travel button.active,
body.vano-app-root:not(.vano-route-onboarding) .segment button.smart.active{
  color:#A94F29!important;
  background:#FFF8F3!important;
  border-color:#FFD6BD!important;
  box-shadow:0 5px 14px rgba(217,112,63,.09)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .route-head h2,
body.vano-app-root:not(.vano-route-onboarding) .route-card h3,
body.vano-app-root:not(.vano-route-onboarding) .parking-head b{color:var(--v-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .route-head p,
body.vano-app-root:not(.vano-route-onboarding) .route-ai,
body.vano-app-root:not(.vano-route-onboarding) .parking-head span,
body.vano-app-root:not(.vano-route-onboarding) .parking-empty,
body.vano-app-root:not(.vano-route-onboarding) .route-card p{color:var(--v-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .route-time span{color:var(--v-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .route-time small{color:var(--v-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .customize-route-kicker span,
body.vano-app-root:not(.vano-route-onboarding) .route-choice-label{color:#9A8E86!important}
body.vano-app-root:not(.vano-route-onboarding) .customize-route-kicker b{color:var(--v-ink)!important}

/* Main CTA — deliberately rebuilt to feel like the hero action */
body.vano-app-root:not(.vano-route-onboarding) .start-trip-cta{
  position:relative!important;
  min-height:62px!important;
  padding:8px 12px 8px 9px!important;
  display:grid!important;
  grid-template-columns:46px minmax(0,1fr) 36px!important;
  align-items:center!important;
  gap:10px!important;
  border:1px solid rgba(255,255,255,.40)!important;
  border-radius:20px!important;
  overflow:hidden!important;
  background:
    radial-gradient(circle at 18% -10%,rgba(255,255,255,.58),transparent 30%),
    linear-gradient(135deg,#FFC39B 0%,#F59A62 48%,#D9703F 100%)!important;
  color:#fff!important;
  box-shadow:0 16px 36px rgba(217,112,63,.28),inset 0 1px 0 rgba(255,255,255,.54),inset 0 -1px 0 rgba(132,59,26,.10)!important;
  text-align:left!important;
  transform:translateZ(0)!important;
  transition:transform .2s cubic-bezier(.2,.8,.2,1),box-shadow .2s ease,filter .2s ease!important;
}
body.vano-app-root:not(.vano-route-onboarding) .start-trip-cta:before{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 18%,rgba(255,255,255,.20) 38%,transparent 58%);transform:translateX(-120%);transition:transform .6s ease;pointer-events:none}
body.vano-app-root:not(.vano-route-onboarding) .start-trip-cta:hover:before{transform:translateX(120%)}
body.vano-app-root:not(.vano-route-onboarding) .start-trip-cta:hover{transform:translateY(-1px)!important;box-shadow:0 19px 42px rgba(217,112,63,.34),inset 0 1px 0 rgba(255,255,255,.6)!important}
body.vano-app-root:not(.vano-route-onboarding) .start-trip-cta:active{transform:translateY(0) scale(.99)!important}
body.vano-app-root:not(.vano-route-onboarding) .start-trip-cta:disabled{filter:saturate(.72);opacity:.8!important}
body.vano-app-root:not(.vano-route-onboarding) .start-trip-icon{
  width:46px!important;height:46px!important;border-radius:15px!important;display:grid!important;place-items:center!important;
  background:linear-gradient(155deg,#38332E,#211E1B)!important;
  color:#FFF8F3!important;
  border:1px solid rgba(255,255,255,.14)!important;
  box-shadow:0 8px 18px rgba(68,37,23,.20),inset 0 1px 0 rgba(255,255,255,.12)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .start-trip-icon svg{width:20px!important;height:20px!important;stroke-width:2.4!important}
body.vano-app-root:not(.vano-route-onboarding) .start-trip-copy{min-width:0!important;display:flex!important;flex-direction:column!important;gap:2px!important}
body.vano-app-root:not(.vano-route-onboarding) .start-trip-copy b{font-size:14px!important;line-height:1.12!important;letter-spacing:-.28px!important;color:#fff!important;font-weight:880!important}
body.vano-app-root:not(.vano-route-onboarding) .start-trip-copy small{font-size:9px!important;line-height:1.25!important;color:rgba(255,255,255,.82)!important;font-weight:720!important;letter-spacing:.01em!important}
body.vano-app-root:not(.vano-route-onboarding) .start-trip-arrow{width:34px!important;height:34px!important;border-radius:50%!important;display:grid!important;place-items:center!important;background:rgba(255,255,255,.17)!important;border:1px solid rgba(255,255,255,.20)!important;color:#fff!important;font-size:24px!important;line-height:1!important}

/* Confirmation / loading */
body.vano-app-root:not(.vano-route-onboarding) .destination-confirm-card,
body.vano-app-root:not(.vano-route-onboarding) .route-loading-card,
body.vano-app-root:not(.vano-route-onboarding) .resume-trip-card,
body.vano-app-root:not(.vano-route-onboarding) .immersive-choice-card,
body.vano-app-root:not(.vano-route-onboarding) .guest-limit-card{
  background:rgba(255,251,242,.98)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.16)!important;
  box-shadow:0 24px 68px rgba(67,49,37,.19)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .destination-accept,
body.vano-app-root:not(.vano-route-onboarding) .resume-trip-continue,
body.vano-app-root:not(.vano-route-onboarding) .traffic-accept,
body.vano-app-root:not(.vano-route-onboarding) .guest-limit-primary{
  color:#fff!important;
  background:linear-gradient(135deg,#FFC39B,#F59A62 48%,#D9703F)!important;
  border-color:transparent!important;
  box-shadow:0 10px 25px rgba(217,112,63,.22)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .destination-edit,
body.vano-app-root:not(.vano-route-onboarding) .resume-trip-dismiss,
body.vano-app-root:not(.vano-route-onboarding) .traffic-dismiss,
body.vano-app-root:not(.vano-route-onboarding) .guest-limit-secondary{background:#fff!important;color:var(--v-ink)!important;border-color:var(--v-line)!important}
body.vano-app-root:not(.vano-route-onboarding) .route-loading-spinner{border-color:rgba(245,154,98,.18)!important;border-top-color:var(--v-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .route-loading-dots i{background:var(--v-primary)!important}

/* Map controls/status */
body.vano-app-root:not(.vano-route-onboarding) .status-chip,
body.vano-app-root:not(.vano-route-onboarding) .gps-quality,
body.vano-app-root:not(.vano-route-onboarding) .traffic-radar,
body.vano-app-root:not(.vano-route-onboarding) .connectivity-pill,
body.vano-app-root:not(.vano-route-onboarding) .nav-map-mode,
body.vano-app-root:not(.vano-route-onboarding) .nav-tracking,
body.vano-app-root:not(.vano-route-onboarding) .nav-immersive-chip,
body.vano-app-root:not(.vano-route-onboarding) .nav-voice-popover,
body.vano-app-root:not(.vano-route-onboarding) .nav-alt-hint,
body.vano-app-root:not(.vano-route-onboarding) .nav-feedback{
  background:rgba(255,251,242,.94)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.14)!important;
  box-shadow:0 10px 28px rgba(67,49,37,.12)!important;
  backdrop-filter:blur(18px) saturate(1.2)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .floating-speedo{background:rgba(39,35,31,.93)!important;color:#fff!important;border-color:rgba(255,255,255,.08)!important;box-shadow:0 12px 28px rgba(39,35,31,.22)!important}
body.vano-app-root:not(.vano-route-onboarding) .floating-speedo small{color:#CFC6BF!important}

/* Active navigation HUD */
body.vano-app-root:not(.vano-route-onboarding) .nav-maneuver-top{
  background:
    radial-gradient(circle at 18% -25%,rgba(255,195,155,.16),transparent 40%),
    linear-gradient(150deg,#302B27,#211E1B)!important;
  color:#FFFBF2!important;
  border:1px solid rgba(255,255,255,.09)!important;
  border-radius:24px!important;
  box-shadow:0 18px 44px rgba(39,35,31,.26),inset 0 1px 0 rgba(255,255,255,.06)!important;
  backdrop-filter:blur(18px)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .nav-maneuver-icon{
  background:linear-gradient(145deg,#FFC39B,#F59A62 56%,#D9703F)!important;
  color:#fff!important;
  border:1px solid rgba(255,255,255,.28)!important;
  box-shadow:0 9px 20px rgba(217,112,63,.23),inset 0 1px 0 rgba(255,255,255,.45)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .nav-maneuver-copy small{color:#CFC5BE!important}
body.vano-app-root:not(.vano-route-onboarding) .nav-maneuver-copy b{color:#fff!important}
body.vano-app-root:not(.vano-route-onboarding) .nav-maneuver-copy span{color:#E7DED8!important}
body.vano-app-root:not(.vano-route-onboarding) .nav-street-chip{background:rgba(255,251,242,.94)!important;color:var(--v-ink)!important;border-color:rgba(112,104,97,.13)!important;box-shadow:0 8px 22px rgba(67,49,37,.10)!important}
body.vano-app-root:not(.vano-route-onboarding) .nav-panel.nav-minimal{
  background:rgba(255,251,242,.965)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.15)!important;
  box-shadow:0 -18px 52px rgba(67,49,37,.17)!important;
  backdrop-filter:blur(24px) saturate(1.2)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .nav-summary-item{background:#FFF8F2!important;border-color:rgba(112,104,97,.11)!important}
body.vano-app-root:not(.vano-route-onboarding) .nav-summary-item small{color:#9A8E86!important}
body.vano-app-root:not(.vano-route-onboarding) .nav-summary-item strong{color:var(--v-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .traffic-suggestion{background:#FFF4EA!important;border-color:#FFD7BE!important}
body.vano-app-root:not(.vano-route-onboarding) .traffic-suggestion-icon{background:#fff!important;color:var(--v-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .nav-alt-accept{background:var(--v-primary)!important;color:#fff!important}
body.vano-app-root:not(.vano-route-onboarding) .reroute .loading{border-color:rgba(245,154,98,.20)!important;border-top-color:var(--v-primary)!important}

/* User puck */
body.vano-app-root:not(.vano-route-onboarding) .user-marker.vano-uploaded-user{filter:drop-shadow(0 10px 14px rgba(66,42,28,.24))!important}
body.vano-app-root:not(.vano-route-onboarding) .user-marker.vano-uploaded-user .pulse{background:radial-gradient(circle,rgba(245,154,98,.22) 0 18%,rgba(245,154,98,.08) 36%,transparent 68%)!important;animation-duration:2.6s!important}
body.vano-app-root:not(.vano-route-onboarding) .user-marker.vano-uploaded-user .user-puck-image{filter:drop-shadow(0 1px 0 rgba(255,255,255,.45))!important}

/* Destination marker: built from DOM/CSS, no rectangular PNG asset. */
body.vano-app-root:not(.vano-route-onboarding) .route-marker.destination{
  width:48px!important;
  height:59px!important;
  overflow:visible!important;
  filter:none!important;
  pointer-events:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) .arrival-ground{
  position:absolute!important;
  left:50%!important;
  bottom:0!important;
  width:29px!important;
  height:8px!important;
  transform:translateX(-50%)!important;
  border-radius:50%!important;
  background:rgba(39,35,31,.22)!important;
  filter:blur(4px)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .arrival-bubble{
  position:absolute!important;
  left:50%!important;
  top:0!important;
  width:44px!important;
  height:44px!important;
  transform:translateX(-50%) translateZ(0)!important;
  border-radius:50%!important;
  background:linear-gradient(145deg,#3B3530,#211E1B)!important;
  border:1px solid rgba(255,255,255,.18)!important;
  box-shadow:
    0 10px 20px rgba(39,35,31,.24),
    0 3px 8px rgba(217,112,63,.12),
    inset 0 1px 0 rgba(255,255,255,.20),
    inset 0 -2px 5px rgba(0,0,0,.20)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .arrival-bubble:after{
  content:""!important;
  position:absolute!important;
  left:50%!important;
  bottom:-10px!important;
  width:18px!important;
  height:18px!important;
  transform:translateX(-50%) rotate(45deg)!important;
  border-radius:3px 0 5px 0!important;
  background:linear-gradient(135deg,#2B2723 42%,#211E1B 100%)!important;
  border-right:1px solid rgba(255,255,255,.12)!important;
  border-bottom:1px solid rgba(255,255,255,.09)!important;
  box-shadow:5px 5px 10px rgba(39,35,31,.12)!important;
  z-index:-1!important;
}
body.vano-app-root:not(.vano-route-onboarding) .arrival-ring{
  position:absolute!important;
  inset:4px!important;
  border-radius:50%!important;
  padding:3px!important;
  background:linear-gradient(145deg,#FFE0CB 0%,#FFC39B 22%,#F59A62 58%,#D9703F 100%)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.64),0 1px 5px rgba(217,112,63,.20)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .arrival-checkers{
  position:relative!important;
  display:block!important;
  width:100%!important;
  height:100%!important;
  overflow:hidden!important;
  border-radius:50%!important;
  background-color:#FFFBF2!important;
  background-image:conic-gradient(#27231F 25%,#FFFBF2 0 50%,#27231F 0 75%,#FFFBF2 0)!important;
  background-size:12px 12px!important;
  background-position:center!important;
  box-shadow:inset 0 0 0 1px rgba(39,35,31,.45),inset 0 -7px 10px rgba(39,35,31,.12),inset 0 7px 10px rgba(255,255,255,.28)!important;
  transform:rotate(-3deg)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .arrival-checkers:before{
  content:""!important;
  position:absolute!important;
  inset:-4px!important;
  border-radius:50%!important;
  background:linear-gradient(145deg,rgba(255,255,255,.66) 0 21%,transparent 38% 65%,rgba(39,35,31,.10) 100%)!important;
  pointer-events:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) .arrival-checkers:after{
  content:""!important;
  position:absolute!important;
  left:8px!important;right:8px!important;top:4px!important;height:7px!important;
  border-radius:50%!important;
  background:rgba(255,255,255,.32)!important;
  filter:blur(2px)!important;
}

body.vano-app-root:not(.vano-route-onboarding) .body-nav .route-marker.destination .arrival-visual{transform:scale(.96)!important;transform-origin:center bottom!important}

/* Map alerts rebuilt with the same polished DOM/CSS language as the arrival pin. */
body.vano-app-root:not(.vano-route-onboarding) .route-marker.alert-marker{position:relative!important;width:52px!important;height:64px!important;padding:0!important;border:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important;cursor:pointer!important;pointer-events:auto!important;appearance:none!important;-webkit-appearance:none!important}
body.vano-app-root:not(.vano-route-onboarding) .alert-visual{position:relative!important;display:block!important;width:52px!important;height:64px!important}
body.vano-app-root:not(.vano-route-onboarding) .alert-ground{position:absolute!important;left:50%!important;bottom:0!important;width:31px!important;height:8px!important;transform:translateX(-50%)!important;border-radius:50%!important;background:rgba(39,35,31,.18)!important;filter:blur(4px)!important}
body.vano-app-root:not(.vano-route-onboarding) .alert-bubble{position:absolute!important;left:50%!important;top:0!important;width:46px!important;height:46px!important;transform:translateX(-50%) translateZ(0)!important;border-radius:50%!important;background:linear-gradient(145deg,#3B3530,#211E1B)!important;border:1px solid rgba(255,255,255,.18)!important;box-shadow:0 10px 20px rgba(39,35,31,.22),0 3px 8px rgba(217,112,63,.12),inset 0 1px 0 rgba(255,255,255,.20),inset 0 -2px 5px rgba(0,0,0,.20)!important}
body.vano-app-root:not(.vano-route-onboarding) .alert-bubble:after{content:""!important;position:absolute!important;left:50%!important;bottom:-10px!important;width:18px!important;height:18px!important;transform:translateX(-50%) rotate(45deg)!important;border-radius:3px 0 5px 0!important;background:linear-gradient(135deg,#2B2723 42%,#211E1B 100%)!important;border-right:1px solid rgba(255,255,255,.12)!important;border-bottom:1px solid rgba(255,255,255,.09)!important;box-shadow:5px 5px 10px rgba(39,35,31,.12)!important;z-index:-1!important}
body.vano-app-root:not(.vano-route-onboarding) .alert-ring{position:absolute!important;inset:4px!important;display:grid!important;place-items:center!important;border-radius:50%!important;padding:3px!important;background:linear-gradient(145deg,#FFE0CB 0%,#FFC39B 22%,#F59A62 58%,#D9703F 100%)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.64),0 1px 5px rgba(217,112,63,.20)!important}
body.vano-app-root:not(.vano-route-onboarding) .alert-face{position:relative!important;display:grid!important;place-items:center!important;width:100%!important;height:100%!important;overflow:hidden!important;border-radius:50%!important;background:radial-gradient(circle at 34% 26%,#FFFFFF 0%,#FFF8F1 40%,#F1E5D8 100%)!important;box-shadow:inset 0 0 0 1px rgba(39,35,31,.16),inset 0 -7px 10px rgba(39,35,31,.09),inset 0 7px 10px rgba(255,255,255,.28)!important}
body.vano-app-root:not(.vano-route-onboarding) .alert-face:before{content:""!important;position:absolute!important;inset:0!important;border-radius:50%!important;background:linear-gradient(145deg,rgba(255,255,255,.58) 0 21%,transparent 38% 68%,rgba(39,35,31,.07) 100%)!important;pointer-events:none!important}
body.vano-app-root:not(.vano-route-onboarding) .alert-face:after{content:""!important;position:absolute!important;left:9px!important;right:9px!important;top:5px!important;height:7px!important;border-radius:50%!important;background:rgba(255,255,255,.34)!important;filter:blur(2px)!important;pointer-events:none!important}
body.vano-app-root:not(.vano-route-onboarding) .alert-icon{position:relative!important;z-index:1!important;display:grid!important;place-items:center!important;width:100%!important;height:100%!important}
body.vano-app-root:not(.vano-route-onboarding) .alert-icon-svg{width:24px!important;height:24px!important;display:block!important}
body.vano-app-root:not(.vano-route-onboarding) .alert-icon-svg .fg{fill:#27231F!important}body.vano-app-root:not(.vano-route-onboarding) .alert-icon-svg .accent{fill:#F59A62!important}body.vano-app-root:not(.vano-route-onboarding) .alert-icon-svg .light{fill:#FFFBF2!important}body.vano-app-root:not(.vano-route-onboarding) .alert-icon-svg .stroke{fill:none!important;stroke:#27231F!important;stroke-width:1.8!important;stroke-linecap:round!important;stroke-linejoin:round!important}body.vano-app-root:not(.vano-route-onboarding) .alert-icon-svg .stroke-fill{fill:#FFFBF2!important;stroke:#27231F!important;stroke-width:1.4!important}
body.vano-app-root:not(.vano-route-onboarding) .route-marker.alert-marker[data-kind="traffic"] .alert-face{background:radial-gradient(circle at 34% 26%,#FFFFFF 0%,#FFF7ED 38%,#F6E1CF 100%)!important}
body.vano-app-root:not(.vano-route-onboarding) .route-marker.alert-marker[data-kind="flood"] .alert-face{background:radial-gradient(circle at 34% 26%,#FFFFFF 0%,#FFF8F1 42%,#F0E9E0 100%)!important}
body.vano-app-root:not(.vano-route-onboarding) .route-marker.alert-marker[data-kind="police"] .alert-ring,
body.vano-app-root:not(.vano-route-onboarding) .route-marker.alert-marker[data-kind="security"] .alert-ring{background:linear-gradient(145deg,#FFE0CB 0%,#FFC39B 20%,#F59A62 55%,#CF6A3C 100%)!important}
@media(max-width:640px){body.vano-app-root:not(.vano-route-onboarding) .route-marker.alert-marker{width:48px!important;height:60px!important}body.vano-app-root:not(.vano-route-onboarding) .alert-visual{width:48px!important;height:60px!important}body.vano-app-root:not(.vano-route-onboarding) .alert-bubble{width:42px!important;height:42px!important}body.vano-app-root:not(.vano-route-onboarding) .alert-icon-svg{width:22px!important;height:22px!important}}

/* Arrival marker also used by standalone shared-route page */
body.vano-app-root:not(.vano-route-onboarding) .marker.dest{
  position:relative!important;width:38px!important;height:46px!important;border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important;
}
body.vano-app-root:not(.vano-route-onboarding) .marker.dest:before{
  content:""!important;position:absolute!important;left:50%!important;top:0!important;width:36px!important;height:36px!important;transform:translateX(-50%)!important;border-radius:50%!important;
  background:conic-gradient(#27231F 25%,#FFFBF2 0 50%,#27231F 0 75%,#FFFBF2 0) center/10px 10px!important;
  border:4px solid #F59A62!important;box-shadow:0 0 0 3px #27231F,0 8px 18px rgba(39,35,31,.22),inset 0 3px 6px rgba(255,255,255,.28)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .marker.dest:after{
  content:""!important;position:absolute!important;left:50%!important;top:31px!important;width:14px!important;height:14px!important;transform:translateX(-50%) rotate(45deg)!important;background:#27231F!important;border-radius:2px!important;box-shadow:5px 5px 9px rgba(39,35,31,.10)!important;z-index:-1!important;
}

/* Popups / Mapbox chrome */
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-content{background:rgba(255,251,242,.98)!important;color:var(--v-ink)!important;border:1px solid rgba(112,104,97,.15)!important;border-radius:16px!important;box-shadow:0 16px 38px rgba(67,49,37,.16)!important}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-tip{border-top-color:#FFFBF2!important}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-ctrl-group{border-radius:14px!important;overflow:hidden!important;box-shadow:0 8px 22px rgba(67,49,37,.11)!important}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-ctrl-group button{background:#FFFBF2!important;color:var(--v-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-ctrl-attrib.mapboxgl-compact,
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-ctrl-attrib{background:rgba(255,251,242,.84)!important;color:#7F746D!important;border-color:rgba(112,104,97,.12)!important}

/* Do not let the legacy dark theme repaint the navigation. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .sheet#planSheet,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .search-card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .nav-panel.nav-minimal,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .destination-confirm,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .prefs-drawer,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .safety-drawer{background:rgba(255,251,242,.97)!important;color:var(--v-ink)!important;border-color:var(--v-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .nav-maneuver-top{background:linear-gradient(150deg,#302B27,#211E1B)!important;color:#fff!important}

@media(max-width:640px){
  body.vano-app-root:not(.vano-route-onboarding) .search-card,
body.vano-app-root:not(.vano-route-onboarding) .planner-search-card.search-card{left:8px!important;right:8px!important;border-radius:19px!important}
  body.vano-app-root:not(.vano-route-onboarding) .sheet#planSheet,
body.vano-app-root:not(.vano-route-onboarding) .sheet{border-radius:24px 24px 0 0!important}
  body.vano-app-root:not(.vano-route-onboarding) .start-trip-cta{min-height:58px!important;border-radius:18px!important;grid-template-columns:42px minmax(0,1fr) 32px!important;gap:9px!important;padding:8px 10px 8px 8px!important}
  body.vano-app-root:not(.vano-route-onboarding) .start-trip-icon{width:42px!important;height:42px!important;border-radius:14px!important}
  body.vano-app-root:not(.vano-route-onboarding) .start-trip-copy b{font-size:13px!important}
  body.vano-app-root:not(.vano-route-onboarding) .start-trip-copy small{font-size:8px!important}
  body.vano-app-root:not(.vano-route-onboarding) .start-trip-arrow{width:30px!important;height:30px!important;font-size:21px!important}
  body.vano-app-root:not(.vano-route-onboarding) .nav-maneuver-top{border-radius:20px!important}
  body.vano-app-root:not(.vano-route-onboarding) .route-marker.destination{width:44px!important;height:55px!important}
  body.vano-app-root:not(.vano-route-onboarding) .route-marker.destination .arrival-visual{transform:scale(.94)!important;transform-origin:center bottom!important}
}
body.vano-app-root:not(.vano-route-onboarding) .start-trip-loading-icon .loading{width:18px!important;height:18px!important;border:2px solid rgba(255,255,255,.28)!important;border-top-color:#fff!important;border-radius:50%!important;animation:spin .7s linear infinite!important}
body.vano-app-root:not(.vano-route-onboarding) .start-trip-cta.is-starting .start-trip-arrow{font-size:16px!important;font-weight:900!important;letter-spacing:2px!important}


/* ---- vano-polish.css ---- */
/* VANO v171 — palette cleanup + UI polish + exact Mapbox destination anchoring. */
body.vano-app-root:not(.vano-route-onboarding){
  --v171-primary:#F59A62;
  --v171-light:#FFC39B;
  --v171-deep:#D9703F;
  --v171-paper:#FFFBF2;
  --v171-soft:#FFF4EC;
  --v171-ink:#27231F;
  --v171-muted:#706861;
  --v171-line:rgba(112,104,97,.16);
  --v171-shadow:0 16px 42px rgba(76,54,39,.12);
}

/* One consistent interaction language everywhere. */
body.vano-app-root:not(.vano-route-onboarding) button,
body.vano-app-root:not(.vano-route-onboarding) a,
body.vano-app-root:not(.vano-route-onboarding) .btn,
body.vano-app-root:not(.vano-route-onboarding) [role="button"]{-webkit-tap-highlight-color:transparent}
body.vano-app-root:not(.vano-route-onboarding) button:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) a:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) input:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) select:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) textarea:focus-visible{outline:3px solid rgba(245,154,98,.24)!important;outline-offset:2px!important}
body.vano-app-root:not(.vano-route-onboarding) button:not(:disabled){transition:transform .16s cubic-bezier(.2,.8,.2,1),box-shadow .18s ease,background .18s ease,border-color .18s ease,filter .18s ease!important}
body.vano-app-root:not(.vano-route-onboarding) button:not(:disabled):active{transform:scale(.985)}

/* Final brand pass for legacy controls that previously carried violet identity. */
body.vano-app-root:not(.vano-route-onboarding) :is(.primary,.btn-primary,.destination-accept,.traffic-accept,.nav-alt-accept,.resume-trip-continue,.guest-limit-primary,.sheet-submit,.risk-submit,.know-more,.auth-choice.primary,.auth-button.email,.route-actions .primary){
  background:linear-gradient(135deg,var(--v171-light) 0%,var(--v171-primary) 52%,var(--v171-deep) 100%)!important;
  color:#fff!important;
  border-color:transparent!important;
  box-shadow:0 11px 27px rgba(217,112,63,.22),inset 0 1px 0 rgba(255,255,255,.38)!important;
}
body.vano-app-root:not(.vano-route-onboarding) :is(.primary,.btn-primary,.destination-accept,.traffic-accept,.nav-alt-accept,.resume-trip-continue,.guest-limit-primary,.sheet-submit,.risk-submit,.know-more,.auth-choice.primary,.auth-button.email,.route-actions .primary):hover{
  filter:saturate(1.03) brightness(1.015)!important;
  box-shadow:0 15px 34px rgba(217,112,63,.27),inset 0 1px 0 rgba(255,255,255,.44)!important;
}
body.vano-app-root:not(.vano-route-onboarding) :is(.secondary,.btn-ghost,.destination-edit,.traffic-dismiss,.guest-limit-secondary,.toggle-user,.mini-btn,.admin-back,.risk-back){
  background:rgba(255,255,255,.94)!important;color:var(--v171-ink)!important;border-color:var(--v171-line)!important;
}

/* Warm all segmented/selected states, toggles and active chips. */
body.vano-app-root:not(.vano-route-onboarding) :is(.segment button.active,.travel button.active,.style-choice:has(input:checked),.ob-option.active,.pref input:checked+label,.choice input:checked+label,.planner-preset.active,.nearby-service.active){
  background:#FFF3E9!important;color:#A8512C!important;border-color:#FFD5BC!important;box-shadow:0 5px 14px rgba(217,112,63,.08)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .switch input:checked+span,
body.vano-app-root:not(.vano-route-onboarding) .switch input:checked+.slider{background:linear-gradient(135deg,var(--v171-light),var(--v171-primary))!important}

/* Common cards: slightly less flat, without changing page structure. */
body.vano-app-root:not(.vano-route-onboarding) :is(.search-card,.sheet,.destination-confirm,.prefs-drawer,.safety-drawer,.account-drawer,.options-drawer,.route-card,.resume-trip-card,.immersive-choice-card,.guest-limit-card,.route-panel,.risk-card,.users-surface,.admin-modal-card){
  border-color:var(--v171-line)!important;
}
body.vano-app-root:not(.vano-route-onboarding) :is(.search-card,.sheet,.destination-confirm,.prefs-drawer,.safety-drawer,.account-drawer,.options-drawer,.resume-trip-card,.immersive-choice-card,.guest-limit-card){
  box-shadow:var(--v171-shadow)!important;
}

/* Start navigation: compact premium CTA, still uses the existing structure/IDs. */
body.vano-app-root:not(.vano-route-onboarding) #startTripBtn.start-trip-cta{
  min-height:60px!important;
  border-radius:19px!important;
  background:
    radial-gradient(circle at 15% -20%,rgba(255,255,255,.52),transparent 34%),
    linear-gradient(135deg,#FFC39B 0%,#F59A62 49%,#D9703F 100%)!important;
  box-shadow:0 14px 31px rgba(217,112,63,.27),inset 0 1px 0 rgba(255,255,255,.54),inset 0 -1px 0 rgba(111,49,23,.10)!important;
}
body.vano-app-root:not(.vano-route-onboarding) #startTripBtn .start-trip-icon{background:linear-gradient(155deg,#3B3530,#27231F)!important;box-shadow:0 7px 16px rgba(39,35,31,.19),inset 0 1px 0 rgba(255,255,255,.13)!important}
body.vano-app-root:not(.vano-route-onboarding) #startTripBtn .start-trip-arrow{background:rgba(255,251,242,.18)!important;border-color:rgba(255,255,255,.22)!important}

/* Mapbox destination marker.
   IMPORTANT: never set transform on .route-marker.destination itself.
   Mapbox owns that transform for screen positioning; overriding it is what sent the marker to the left corner. */
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker.route-marker.destination{
  width:42px!important;
  height:50px!important;
  position:absolute!important;
  display:block!important;
  overflow:visible!important;
  pointer-events:none!important;
  filter:none!important;
  margin:0!important;
  padding:0!important;
  border:0!important;
  background:transparent!important;
  will-change:transform!important;
}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker.route-marker.destination>.arrival-visual{
  position:absolute!important;
  inset:0!important;
  display:block!important;
  transform-origin:50% 100%!important;
  pointer-events:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker.route-marker.destination .arrival-ground{
  position:absolute!important;
  left:50%!important;
  bottom:1px!important;
  width:24px!important;
  height:6px!important;
  transform:translateX(-50%)!important;
  border-radius:50%!important;
  background:rgba(39,35,31,.20)!important;
  filter:blur(3.5px)!important;
  opacity:.72!important;
}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker.route-marker.destination .arrival-bubble{
  position:absolute!important;
  left:50%!important;
  top:0!important;
  width:38px!important;
  height:38px!important;
  transform:translateX(-50%)!important;
  border-radius:50%!important;
  background:linear-gradient(150deg,#4A433D 0%,#2D2925 46%,#211E1B 100%)!important;
  border:1px solid rgba(255,255,255,.18)!important;
  box-shadow:0 9px 18px rgba(39,35,31,.22),0 3px 7px rgba(217,112,63,.12),inset 0 1px 0 rgba(255,255,255,.20),inset 0 -2px 5px rgba(0,0,0,.22)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker.route-marker.destination .arrival-bubble:after{
  content:""!important;
  position:absolute!important;
  left:50%!important;
  bottom:-8px!important;
  width:14px!important;
  height:14px!important;
  transform:translateX(-50%) rotate(45deg)!important;
  border-radius:2px 0 4px 0!important;
  background:linear-gradient(135deg,#302B27 38%,#211E1B 100%)!important;
  border-right:1px solid rgba(255,255,255,.10)!important;
  border-bottom:1px solid rgba(255,255,255,.08)!important;
  box-shadow:4px 4px 8px rgba(39,35,31,.10)!important;
  z-index:-1!important;
}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker.route-marker.destination .arrival-ring{
  position:absolute!important;
  inset:3px!important;
  border-radius:50%!important;
  padding:3px!important;
  background:linear-gradient(145deg,#FFE1CC 0%,#FFC39B 20%,#F59A62 57%,#D9703F 100%)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.70),0 1px 4px rgba(217,112,63,.18)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker.route-marker.destination .arrival-checkers{
  position:relative!important;
  display:block!important;
  width:100%!important;
  height:100%!important;
  overflow:hidden!important;
  border-radius:50%!important;
  background-color:#FFFBF2!important;
  background-image:conic-gradient(#27231F 25%,#FFFBF2 0 50%,#27231F 0 75%,#FFFBF2 0)!important;
  background-size:9px 9px!important;
  background-position:center!important;
  box-shadow:inset 0 0 0 1px rgba(39,35,31,.48),inset 0 -6px 8px rgba(39,35,31,.13),inset 0 6px 9px rgba(255,255,255,.30)!important;
  transform:rotate(-3deg)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker.route-marker.destination .arrival-checkers:before{
  content:""!important;position:absolute!important;inset:-3px!important;border-radius:50%!important;
  background:linear-gradient(145deg,rgba(255,255,255,.68) 0 19%,transparent 39% 64%,rgba(39,35,31,.11) 100%)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker.route-marker.destination .arrival-checkers:after{
  content:""!important;position:absolute!important;left:7px!important;right:7px!important;top:4px!important;height:5px!important;border-radius:50%!important;background:rgba(255,255,255,.30)!important;filter:blur(1.5px)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .body-nav .mapboxgl-marker.route-marker.destination>.arrival-visual{transform:scale(.94)!important}

/* Standalone shared-route destination uses the same visual but is not a Mapbox route-marker. */
body.vano-app-root:not(.vano-route-onboarding) .marker.dest{
  width:42px!important;height:50px!important;border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important;
}
body.vano-app-root:not(.vano-route-onboarding) .marker.dest>.arrival-visual{position:absolute!important;inset:0!important;display:block!important}
body.vano-app-root:not(.vano-route-onboarding) .marker.dest .arrival-ground{position:absolute!important;left:50%!important;bottom:1px!important;width:24px!important;height:6px!important;transform:translateX(-50%)!important;border-radius:50%!important;background:rgba(39,35,31,.20)!important;filter:blur(3.5px)!important}
body.vano-app-root:not(.vano-route-onboarding) .marker.dest .arrival-bubble{position:absolute!important;left:50%!important;top:0!important;width:38px!important;height:38px!important;transform:translateX(-50%)!important;border-radius:50%!important;background:linear-gradient(150deg,#4A433D,#211E1B)!important;border:1px solid rgba(255,255,255,.18)!important;box-shadow:0 9px 18px rgba(39,35,31,.22),inset 0 1px 0 rgba(255,255,255,.20)!important}
body.vano-app-root:not(.vano-route-onboarding) .marker.dest .arrival-bubble:after{content:""!important;position:absolute!important;left:50%!important;bottom:-8px!important;width:14px!important;height:14px!important;transform:translateX(-50%) rotate(45deg)!important;background:#27231F!important;border-radius:2px!important;z-index:-1!important}
body.vano-app-root:not(.vano-route-onboarding) .marker.dest .arrival-ring{position:absolute!important;inset:3px!important;border-radius:50%!important;padding:3px!important;background:linear-gradient(145deg,#FFE1CC,#FFC39B 22%,#F59A62 58%,#D9703F)!important}
body.vano-app-root:not(.vano-route-onboarding) .marker.dest .arrival-checkers{display:block!important;width:100%!important;height:100%!important;border-radius:50%!important;background:conic-gradient(#27231F 25%,#FFFBF2 0 50%,#27231F 0 75%,#FFFBF2 0) center/9px 9px!important;box-shadow:inset 0 0 0 1px rgba(39,35,31,.45),inset 0 6px 9px rgba(255,255,255,.28)!important;transform:rotate(-3deg)!important}
body.vano-app-root:not(.vano-route-onboarding) .marker.dest:before,
body.vano-app-root:not(.vano-route-onboarding) .marker.dest:after{content:none!important}

/* Administrative screens that were most visibly left behind. */
body.vano-app-root:not(.vano-route-onboarding) .admin-users-v76 .role-admin,
body.vano-app-root:not(.vano-route-onboarding) .risk-eyebrow,
body.vano-app-root:not(.vano-route-onboarding) .admin-modal-head small{color:var(--v171-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .admin-users-v76 .know-more,
body.vano-app-root:not(.vano-route-onboarding) .risk-submit{background:linear-gradient(135deg,var(--v171-light),var(--v171-primary) 52%,var(--v171-deep))!important}
body.vano-app-root:not(.vano-route-onboarding) .admin-users-v76 .state,
body.vano-app-root:not(.vano-route-onboarding) .zone-pill{border-color:#F0DCCF!important}
body.vano-app-root:not(.vano-route-onboarding) .policy-note,
body.vano-app-root:not(.vano-route-onboarding) .route-note{background:#FFF4EC!important;border-color:#FFE0CD!important;color:#795A48!important}

@media(max-width:640px){
  body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker.route-marker.destination{width:40px!important;height:48px!important}
  body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker.route-marker.destination>.arrival-visual{transform:scale(.94)!important}
  body.vano-app-root:not(.vano-route-onboarding) .body-nav .mapboxgl-marker.route-marker.destination>.arrival-visual{transform:scale(.90)!important}
  body.vano-app-root:not(.vano-route-onboarding) #startTripBtn.start-trip-cta{min-height:58px!important;border-radius:18px!important}
}


/* ---- vano-release.css ---- */
/* VANO v173 — production release polish.
   Mobile entry stability, guest drawer rebuild and explicit Black map mode. */
body.vano-app-root:not(.vano-route-onboarding){
  --v173-orange:#F59A62;
  --v173-orange-light:#FFC39B;
  --v173-orange-deep:#D9703F;
  --v173-paper:#FFFBF2;
  --v173-ink:#27231F;
  --v173-muted:#706861;
  --v173-line:rgba(112,104,97,.17);
  --v173-black:#171512;
  --v173-black-2:#211E1B;
  --v173-black-3:#2B2723;
}

/* Never distort brand assets. */
body.vano-app-root:not(.vano-route-onboarding) img[src*="vano-logo"],
body.vano-app-root:not(.vano-route-onboarding) img[src*="vano-wordmark"]{object-fit:contain!important;object-position:center!important}

/* -------------------------------------------------------------
   Map Black button
   ------------------------------------------------------------- */
body.vano-app-root:not(.vano-route-onboarding) .map-theme-btn{position:relative!important;overflow:hidden!important}
body.vano-app-root:not(.vano-route-onboarding) .map-theme-btn .map-theme-day,
body.vano-app-root:not(.vano-route-onboarding) .map-theme-btn .map-theme-night{position:absolute!important;inset:0!important;display:grid!important;place-items:center!important;transition:opacity .16s ease,transform .18s ease!important}
body.vano-app-root:not(.vano-route-onboarding) .map-theme-btn .map-theme-day{opacity:1;transform:scale(1)}
body.vano-app-root:not(.vano-route-onboarding) .map-theme-btn .map-theme-night{opacity:0;transform:scale(.72)}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .map-theme-btn .map-theme-day{opacity:0;transform:scale(.72)}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .map-theme-btn .map-theme-night{opacity:1;transform:scale(1)}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .map-theme-btn{background:linear-gradient(145deg,#302B27,#211E1B)!important;color:#FFC39B!important;border-color:rgba(255,195,155,.22)!important;box-shadow:0 12px 30px rgba(0,0,0,.30),inset 0 1px 0 rgba(255,255,255,.08)!important}

/* -------------------------------------------------------------
   Guest drawer — three dots while signed out
   ------------------------------------------------------------- */
body.vano-app-root:not(.vano-route-onboarding) .ws-app .guest-account-drawer{padding:12px!important;overflow:hidden!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .guest-account-drawer .drawer-grab{margin-bottom:9px!important;background:rgba(112,104,97,.22)!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-content{padding:4px 3px 6px!important;min-width:0!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-top{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;margin-bottom:18px!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-brand{display:flex!important;align-items:center!important;gap:11px!important;min-width:0!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-brand img{width:42px!important;height:42px!important;flex:0 0 42px!important;border-radius:13px!important;box-shadow:0 9px 22px rgba(217,112,63,.16)!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-brand div{min-width:0!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-brand small{display:block!important;color:var(--v173-orange-deep)!important;font-size:8px!important;font-weight:950!important;letter-spacing:.14em!important;line-height:1!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-brand b{display:block!important;margin-top:5px!important;color:var(--v173-ink)!important;font-size:11px!important;font-weight:850!important;line-height:1.25!important;white-space:normal!important;overflow-wrap:anywhere!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-close{width:36px!important;height:36px!important;flex:0 0 36px!important;display:grid!important;place-items:center!important;padding:0!important;border:1px solid var(--v173-line)!important;border-radius:12px!important;background:#FFF8F2!important;color:#655D57!important;box-shadow:none!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-content h3{margin:0!important;color:var(--v173-ink)!important;font-size:22px!important;letter-spacing:-.75px!important;line-height:1.05!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-content>p{margin:9px 0 0!important;max-width:34ch!important;color:#7A716B!important;font-size:11px!important;line-height:1.55!important;overflow-wrap:anywhere!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-benefits{display:grid!important;grid-template-columns:1fr!important;gap:7px!important;margin-top:17px!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-benefits span{min-width:0!important;display:flex!important;align-items:center!important;gap:9px!important;padding:10px 11px!important;border:1px solid rgba(112,104,97,.12)!important;border-radius:13px!important;background:#FFF9F4!important;color:#5E5651!important;font-size:10px!important;font-weight:800!important;line-height:1.2!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-benefits svg{flex:0 0 auto!important;color:var(--v173-orange-deep)!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-actions{display:grid!important;grid-template-columns:1fr 1fr!important;gap:8px!important;margin-top:17px!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-primary,
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-secondary{min-width:0!important;min-height:47px!important;display:flex!important;align-items:center!important;justify-content:center!important;padding:0 10px!important;border-radius:14px!important;font-size:10.5px!important;font-weight:900!important;text-align:center!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-primary{background:linear-gradient(135deg,var(--v173-orange-light),var(--v173-orange) 58%,var(--v173-orange-deep))!important;color:#fff!important;box-shadow:0 10px 22px rgba(217,112,63,.20)!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-secondary{border:1px solid var(--v173-line)!important;background:#fff!important;color:var(--v173-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-continue{width:100%!important;min-height:40px!important;margin-top:7px!important;padding:0 12px!important;border:0!important;background:transparent!important;color:#827973!important;font-size:9.5px!important;font-weight:800!important;box-shadow:none!important}

/* -------------------------------------------------------------
   Real Black mode. Only Vano charcoal + orange; no legacy violet.
   ------------------------------------------------------------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding){--bg:#171512;--surface:#211E1B;--surface-2:#2B2723;--surface-3:#332E29;--text:#FFFBF2;--muted:#B8AEA7;--muted-2:#8F857E;--line:rgba(255,251,242,.11);background:#171512!important;color:#FFFBF2!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app{background:#171512!important;color:#FFFBF2!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.search-card,.sheet#planSheet,.sheet,.destination-confirm,.prefs-drawer,.safety-drawer,.account-drawer,.options-drawer,.nav-panel.nav-minimal,.nav-maneuver-top,.nav-street-chip,.floating-speedo,.nav-stack-btn,.nav-audio-toggle,.nav-map-mode,.nav-tracking,.nav-voice-popover,.nav-alt-hint,.nav-feedback,.traffic-radar,.route-loading-card,.resume-trip-card,.quick-alert-card,.guest-limit-card){background:rgba(33,30,27,.96)!important;color:#FFFBF2!important;border-color:rgba(255,251,242,.10)!important;box-shadow:0 18px 48px rgba(0,0,0,.30)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.search-card input,.location-input,.route-card,.planner-preset,.nearby-service,.drawer-link,.safety-tool,.pref-row,.quick-alert-grid button,.parking-item,.preview-actions .sub-action,.segment button,.travel button){background:#27231F!important;color:#F7EFEA!important;border-color:rgba(255,251,242,.10)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.planner-heading-copy b,.route-head h2,.route-card h3,.nav-maneuver-copy b,.nav-summary-item strong,.floating-speedo strong,.drawer-user b,.drawer-login h3,.safety-head h3,.prefs-head h3,.destination-confirm h3,.guest-drawer-brand b,.guest-drawer-content h3){color:#FFFBF2!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.drawer-user span,.drawer-login p,.guest-drawer-content>p,.planner-heading-copy span,.route-card-meta,.route-ai,.nav-summary-item small,.traffic-radar-copy span,.destination-confirm p){color:#B6ACA5!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.options-btn,.map-tools .map-btn,.floating-locate){background:rgba(39,35,31,.95)!important;color:#FFFBF2!important;border-color:rgba(255,251,242,.12)!important;box-shadow:0 10px 26px rgba(0,0,0,.28)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.options-btn,.map-tools .map-btn,.floating-locate):hover{background:#302B27!important;color:#FFC39B!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.segment button.active,.travel button.active,.planner-preset.active,.nearby-service.active){background:rgba(245,154,98,.13)!important;color:#FFC39B!important;border-color:rgba(245,154,98,.30)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-brand small,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-head small{color:#FFC39B!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-close,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-secondary{background:#27231F!important;color:#FFFBF2!important;border-color:rgba(255,251,242,.10)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-benefits span{background:#27231F!important;color:#D4CAC3!important;border-color:rgba(255,251,242,.08)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-continue{color:#AAA098!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-content{background:rgba(33,30,27,.98)!important;color:#FFFBF2!important;border-color:rgba(255,251,242,.10)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-tip{border-top-color:#211E1B!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-ctrl-group button{background:#27231F!important;color:#FFFBF2!important}

/* -------------------------------------------------------------
   Phone entry/login — predictable single-column layout.
   ------------------------------------------------------------- */
@media(max-width:760px){
  body.vano-app-root:not(.vano-route-onboarding):has(.auth-page[data-auth-page="login"]){overflow-x:hidden!important;background:#FFFBF2!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"]{display:block!important;min-height:100dvh!important;height:auto!important;padding:0!important;background:#FFFBF2!important;overflow:visible!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-shell{display:block!important;min-height:100dvh!important;height:auto!important;width:100%!important;border:0!important;border-radius:0!important;background:#FFFBF2!important;box-shadow:none!important;overflow:visible!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .route-pane{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-pane{display:block!important;min-height:100dvh!important;padding:max(18px,env(safe-area-inset-top)) max(18px,env(safe-area-inset-right)) max(24px,calc(env(safe-area-inset-bottom) + 10px)) max(18px,env(safe-area-inset-left))!important;background:#FFFBF2!important;overflow:visible!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .brand-row{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;flex-wrap:nowrap!important;width:100%!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .brand{display:flex!important;min-width:0!important;max-width:60%!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-brand-wordmark{display:block!important;width:min(156px,44vw)!important;height:auto!important;max-height:34px!important;object-fit:contain!important;object-position:left center!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .product-pill{flex:0 0 auto!important;max-width:42%!important;padding:7px 9px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;font-size:8px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-copy{display:block!important;padding:clamp(34px,8vh,72px) 0 0!important;margin:0!important;max-width:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .eyebrow{font-size:9px!important;letter-spacing:.12em!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] h1{margin:12px 0 13px!important;max-width:11ch!important;font-size:clamp(37px,11.6vw,54px)!important;line-height:.96!important;letter-spacing:-2.3px!important;color:#27231F!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] h1 span{display:block!important;color:#D9703F!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .lead{max-width:42ch!important;margin:0!important;font-size:13px!important;line-height:1.55!important;color:#706861!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-actions{display:grid!important;gap:9px!important;margin-top:26px!important;width:100%!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-button{width:100%!important;min-width:0!important;height:52px!important;min-height:52px!important;border-radius:15px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-links{margin-top:2px!important;font-size:10.5px!important;line-height:1.4!important;text-align:center!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .guest-link{width:100%!important;height:44px!important;min-height:44px!important;margin-top:0!important;border-radius:14px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .legal{margin-top:24px!important;padding-top:15px!important;font-size:9px!important;line-height:1.5!important;color:#8B817A!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .status-note{margin:15px 0 0!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-sheet{align-items:flex-end!important;justify-content:center!important;padding:0!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-sheet .sheet-card{width:100%!important;max-width:none!important;max-height:min(88dvh,720px)!important;border-radius:24px 24px 0 0!important;padding:max(18px,env(safe-area-inset-top)) max(16px,env(safe-area-inset-right)) max(18px,calc(env(safe-area-inset-bottom) + 8px)) max(16px,env(safe-area-inset-left))!important;overflow:auto!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-sheet .sheet-input,
body.vano-app-root:not(.vano-route-onboarding) .auth-sheet .sheet-select{font-size:16px!important}
}
@media(max-width:370px){
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-pane{padding-left:max(14px,env(safe-area-inset-left))!important;padding-right:max(14px,env(safe-area-inset-right))!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-brand-wordmark{width:132px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .product-pill{font-size:7px!important;padding:6px 7px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-copy{padding-top:30px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] h1{font-size:36px!important}
}

/* -------------------------------------------------------------
   Registration — remove the unstable illustration column on phones.
   ------------------------------------------------------------- */
@media(max-width:760px){
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry{min-height:100dvh!important;background:#FFFBF2!important;overflow-x:hidden!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .vano-splash{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-shell{display:block!important;width:100%!important;min-height:100dvh!important;margin:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;background:#FFFBF2!important;overflow:visible!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-route-stage{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-panel{width:100%!important;min-height:100dvh!important;padding:max(24px,env(safe-area-inset-top)) max(18px,env(safe-area-inset-right)) max(28px,calc(env(safe-area-inset-bottom) + 10px)) max(18px,env(safe-area-inset-left))!important;background:#FFFBF2!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-brand{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;min-width:0!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .vano-entry-wordmark{width:min(156px,44vw)!important;height:auto!important;max-height:34px!important;object-fit:contain!important;object-position:left center!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-brand em{max-width:44%!important;font-size:8px!important;line-height:1.2!important;text-align:right!important;white-space:normal!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-kicker{margin-top:clamp(38px,8vh,72px)!important;font-size:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-panel h1{max-width:10ch!important;margin:10px 0 13px!important;font-size:clamp(38px,11vw,52px)!important;line-height:.96!important;letter-spacing:-2.2px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-lead{max-width:42ch!important;font-size:13px!important;line-height:1.55!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-proof{display:flex!important;gap:7px!important;flex-wrap:wrap!important;margin-top:17px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-proof span{font-size:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-auth-block{margin-top:24px!important;width:100%!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .auth-google{min-height:52px!important;border-radius:15px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-auth-row{grid-template-columns:1fr!important;gap:8px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .auth-choice{min-height:48px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .auth-guest{min-height:42px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .auth-legal{font-size:9px!important;line-height:1.5!important}
}

/* -------------------------------------------------------------
   Onboarding logo + phone sizing.
   ------------------------------------------------------------- */
body.vano-app-root:not(.vano-route-onboarding) .vano-mini .vano-mini-wordmark{width:128px!important;height:auto!important;max-height:28px!important;border-radius:0!important;filter:none!important;object-fit:contain!important;object-position:left center!important}
@media(max-width:430px){
  body.vano-app-root:not(.vano-route-onboarding) .onboard{padding-top:max(14px,env(safe-area-inset-top))!important;padding-left:max(12px,env(safe-area-inset-left))!important;padding-right:max(12px,env(safe-area-inset-right))!important}
  body.vano-app-root:not(.vano-route-onboarding) .ob-top{min-height:44px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-mini .vano-mini-wordmark{width:112px!important;max-height:24px!important}
  body.vano-app-root:not(.vano-route-onboarding) .step-pill{font-size:7.5px!important;letter-spacing:.06em!important;padding:6px 8px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ob-head{padding:22px 1px 17px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ob-head h1{font-size:clamp(34px,10.8vw,44px)!important;line-height:.98!important}
  body.vano-app-root:not(.vano-route-onboarding) .ob-head p{font-size:11px!important;line-height:1.5!important}
  body.vano-app-root:not(.vano-route-onboarding) .choice-grid{grid-template-columns:1fr!important}
  body.vano-app-root:not(.vano-route-onboarding) .night-card{grid-template-columns:minmax(0,1fr) auto!important}
  body.vano-app-root:not(.vano-route-onboarding) .privacy-note{font-size:9px!important}
}

/* Guest drawer is a bottom sheet on phones; never a clipped right panel. */
@media(max-width:640px){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.guest-account-drawer{left:max(8px,env(safe-area-inset-left))!important;right:max(8px,env(safe-area-inset-right))!important;top:auto!important;bottom:max(8px,env(safe-area-inset-bottom))!important;width:auto!important;max-width:none!important;max-height:min(82dvh,620px)!important;border-radius:24px!important;overflow:auto!important;transform:translateY(calc(100% + 30px))!important;transition:transform .24s cubic-bezier(.2,.78,.2,1)!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.guest-account-drawer.show{transform:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-content h3{font-size:21px!important}
  body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-content>p{max-width:none!important;font-size:10.5px!important}
  body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-benefits{grid-template-columns:1fr!important}
  body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-actions{grid-template-columns:1fr!important}
  body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-primary,
body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-secondary{min-height:46px!important}
}

/* Small landscape phones: keep only what matters. */
@media(max-height:520px) and (orientation:landscape) and (max-width:960px){
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-copy{padding-top:14px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] h1{font-size:34px!important;margin:8px 0!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .lead{font-size:11px!important;line-height:1.35!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-actions{margin-top:12px!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .legal{margin-top:10px!important;padding-top:8px!important}
}

/* Keep the Black toggle visible in the free-map control rail. */
body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) .map-tools #mapThemeBtn{
  display:grid!important;
  width:44px!important;
  height:44px!important;
  border-radius:15px!important;
  border:1px solid rgba(112,104,97,.17)!important;
  background:rgba(255,251,242,.96)!important;
  color:#4F4843!important;
  box-shadow:0 9px 22px rgba(74,51,36,.10)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) .map-tools #mapThemeBtn{
  background:linear-gradient(145deg,#302B27,#211E1B)!important;
  color:#FFC39B!important;
  border-color:rgba(255,195,155,.20)!important;
}


/* ------------------------------------------------------------------
   VANO v174 — dark-mode text cleanup + auth brand lockup polish.
   ------------------------------------------------------------------ */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(
  .search-label,.search-label span,.search-label em,.search-message,.search-message b,.search-message span,
  .result-copy b,.result-address,.result-copy small,.result-stars,.result-meta,
  .search-suggestion,.search-suggestion b,.search-suggestion small,
  .drawer-link,.drawer-link span,.drawer-link em,.drawer-link i,
  .guest-drawer-content h3,.guest-drawer-content>p,.guest-drawer-brand b,.guest-drawer-brand small,
  .guest-drawer-benefits span,.guest-drawer-continue,.guest-drawer-secondary,
  .quick-alert-head h3,.quick-alert-head p,.quick-alert-label,.quick-alert-status,
  .planner-heading-copy b,.planner-heading-copy span,.planner-tip,
  .route-card h3,.route-card p,.route-card-meta,.route-ai,.route-ai *,
  .sheet-head h2,.sheet-head p,.sheet-switch,.sheet-switch a,.sheet-field label,
  .destination-confirm h3,.destination-confirm p,.preview-actions .sub-action,
  .travel button,.segment button,.planner-preset,.planner-preset *,
  .nearby-service,.nearby-service *, .safety-tool,.safety-tool *, .pref-row,.pref-row *,
  .nav-summary-item strong,.nav-summary-item small,.nav-street-chip,.nav-map-mode,.nav-tracking,.nav-feedback,
  .traffic-radar-copy b,.traffic-radar-copy span,.guest-limit-card *,.parking-item *
){color:#FFFBF2!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(
  .guest-drawer-content>p,.drawer-user span,.drawer-login p,.planner-heading-copy span,.route-card-meta,.route-ai,
  .nav-summary-item small,.traffic-radar-copy span,.destination-confirm p,.search-label,.search-label em,
  .result-address,.result-copy small,.sheet-head p,.sheet-switch,.sheet-field label,.quick-alert-head p,.quick-alert-label,
  .guest-drawer-benefits span,.guest-drawer-continue,.parking-item span,.search-suggestion small
){color:#D5CBC4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.search-card input,.location-input,.sheet-input,.sheet-select,.search-item,.search-suggestion,.drawer-link,.quick-alert-grid button,.planner-preset,.nearby-service,.safety-tool,.pref-row,.parking-item){color:#FFFBF2!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.search-card input,.location-input,.sheet-input)::placeholder{color:#B8AEA7!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.drawer-link:hover,.search-item:active,.search-suggestion:active,.quick-alert-grid button:active,.planner-preset:active,.nearby-service:active){color:#FFC39B!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-primary{color:#fff!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-content *{color:inherit!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .route-card .badge,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .route-card .delta{color:#FFC39B!important}

/* Shared brand lockup used on register page. */
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-lockup{display:flex!important;align-items:center!important;gap:12px!important;min-width:0!important;text-decoration:none!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-lockup img.vano-auth-icon{width:48px!important;height:48px!important;flex:0 0 48px!important;border-radius:15px!important;box-shadow:0 10px 22px rgba(217,112,63,.16)!important;object-fit:contain!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-brand-copy{display:flex!important;flex-direction:column!important;min-width:0!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-brand-copy .vano-auth-wordmark{width:170px!important;max-width:100%!important;height:auto!important;max-height:48px!important;object-fit:contain!important;object-position:left center!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-tagline{display:block!important;margin-top:6px!important;color:#706861!important;font-size:12px!important;font-weight:700!important;line-height:1.28!important;letter-spacing:-.1px!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-tagline br{display:block!important}
@media(max-width:760px){
  body.vano-app-root:not(.vano-route-onboarding) .vano-auth-lockup img.vano-auth-icon{width:44px!important;height:44px!important;flex-basis:44px!important;border-radius:14px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-auth-brand-copy .vano-auth-wordmark{width:min(154px,44vw)!important;max-height:34px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-auth-tagline{font-size:10.5px!important;line-height:1.25!important;margin-top:4px!important}
}


/* ------------------------------------------------------------------
   VANO v175 — auth banner, true auth dark mode, and global black cleanup.
   ------------------------------------------------------------------ */
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-link{display:block!important;max-width:min(100%,560px)!important;text-decoration:none!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner{display:block!important;width:min(100%,520px)!important;height:auto!important;max-height:112px!important;object-fit:contain!important;object-position:left center!important;filter:drop-shadow(0 14px 34px rgba(74,51,36,.10))}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner--compact{width:min(100%,420px)!important;max-height:96px!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-tagline{display:block!important;margin-top:10px!important;color:#706861!important;font-size:14px!important;font-weight:700!important;line-height:1.35!important;letter-spacing:-.12px!important}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.topbar,footer,.mobile-dock,.auth-page,.auth-shell,.auth-pane,.route-pane,.route-summary,.reroute-card,.status-note,.product-pill,.vano-entry,.v63-entry-shell,.v63-entry-panel,.v63-auth-block,.sheet-card,.sheet-input,.sheet-select,.auth-google,.auth-choice.secondary,.auth-guest,.auth-legal,.v63-entry-proof span,.v63-stage-card,.v63-stage-brand,.field input,.input-shell){color:#FFFBF2!important}
html[data-vano-theme="black"] :is(body.vano-app-root:not(.vano-route-onboarding),.auth-page,.vano-entry){background:#171512!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.auth-shell,.v63-entry-shell){background:#211E1B!important;border-color:rgba(255,251,242,.08)!important;box-shadow:0 22px 72px rgba(0,0,0,.34)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.auth-pane,.v63-entry-panel,.v63-auth-block,.sheet-card){background:#211E1B!important;border-color:rgba(255,251,242,.08)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.eyebrow,.v63-entry-kicker,.v63-entry-brand em,.sheet-field label,.sheet-switch,.auth-legal,.lead,.v63-entry-lead,.legal,.route-summary p,.reroute-card span,.status-note,.product-pill,.auth-links,.guest-link,.v63-entry-proof span){color:#D5CBC4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(h1,.auth-copy h1,.v63-entry-panel h1,.sheet-head h2,.route-summary h2,.reroute-card b,.auth-links a,.guest-link,.status-note,.v63-auth-label span:first-child){color:#FFFBF2!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(h1 span,.eyebrow,.v63-entry-kicker,.v63-auth-label span:last-child,.sheet-switch a,.auth-links a:hover,.guest-link:hover){color:#FFC39B!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.product-pill,.status-note,.v63-entry-proof span,.v63-stage-card,.v63-stage-brand){background:#27231F!important;border-color:rgba(255,251,242,.10)!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .product-pill i{background:#F59A62!important;box-shadow:0 0 0 4px rgba(245,154,98,.11)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.auth-button.google,.auth-google,.auth-choice.secondary,.auth-guest,.sheet-close){background:#27231F!important;color:#FFFBF2!important;border-color:rgba(255,251,242,.10)!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.auth-button.email,.auth-choice.primary,.sheet-submit){color:#fff!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.sheet-input,.sheet-select,.field input,.input-shell){background:#27231F!important;color:#FFFBF2!important;border-color:rgba(255,251,242,.10)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.sheet-input,.sheet-select,.field input)::placeholder{color:#B8AEA7!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .route-pane{background:#1B1815!important;border-left-color:rgba(255,251,242,.08)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .route-summary,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .reroute-card{background:rgba(39,35,31,.95)!important;border-color:rgba(255,251,242,.10)!important;color:#FFFBF2!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .summary-kicker,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .summary-kicker span:first-child{color:#D5CBC4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .route-metrics div{background:#27231F!important;border:1px solid rgba(255,251,242,.08)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .route-metrics strong{color:#FFFBF2!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .route-metrics span{color:#C6BBB4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-auth-tagline{color:#D5CBC4!important}
@media(max-width:760px){
  body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner{width:min(100%,350px)!important;max-height:84px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-auth-tagline{font-size:11px!important;line-height:1.3!important;margin-top:8px!important}
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"]{background:#171512!important}
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-shell{background:#171512!important}
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-pane,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-panel{background:#171512!important}
}


/* ---- vano-black.css ---- */
/* VANO v176 — final black-mode authority and auth/banner polish. */
body.vano-app-root:not(.vano-route-onboarding){--vb-bg:#171512;--vb-surface:#211E1B;--vb-surface-2:#27231F;--vb-surface-3:#302B27;--vb-text:#FFFBF2;--vb-muted:#D5CBC4;--vb-muted-2:#B9AEA7;--vb-line:rgba(255,251,242,.11);--vb-orange:#F59A62;--vb-orange-2:#FFC39B;--vb-orange-3:#D9703F}

/* Brand banner: use the exact supplied 2048×682 artwork but crop its built-in whitespace in CSS. */
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-link{display:block!important;width:min(100%,570px)!important;text-decoration:none!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-frame{position:relative!important;display:block!important;width:min(100%,560px)!important;aspect-ratio:5.06/1!important;overflow:hidden!important;border-radius:20px!important;background:#fff!important;border:1px solid rgba(112,104,97,.10)!important;box-shadow:0 14px 38px rgba(74,51,36,.11)!important;isolation:isolate!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-frame .vano-auth-banner{position:absolute!important;left:50%!important;top:50%!important;width:123.7%!important;height:auto!important;max-width:none!important;max-height:none!important;transform:translate(-50%,-50%)!important;display:block!important;image-rendering:auto!important;filter:none!important;object-fit:initial!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner--compact .vano-auth-banner-frame,
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-frame.compact{width:min(100%,465px)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-tagline{margin:10px 0 0!important;color:#706861!important;font-size:12px!important;font-weight:720!important;line-height:1.3!important;letter-spacing:-.12px!important}
@media(max-width:760px){body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-link{width:min(100%,380px)!important}body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-frame{width:min(100%,360px)!important;border-radius:17px!important}body.vano-app-root:not(.vano-route-onboarding) .vano-auth-tagline{font-size:10.5px!important;margin-top:7px!important}}
@media(max-width:370px){body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-link{width:min(100%,330px)!important}body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-frame{width:min(100%,316px)!important}}

/* Black mode must paint before and across every normal page. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding){background:var(--vb-bg)!important;color-scheme:dark!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding){background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):before{background:radial-gradient(circle at 18% -10%,rgba(245,154,98,.055),transparent 28%),radial-gradient(circle at 88% 8%,rgba(255,195,155,.025),transparent 24%)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.page,.section,.auth-wrap,.onboard,.vano-entry){background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.topbar,.mobile-dock){background:rgba(23,21,18,.96)!important;border-color:var(--vb-line)!important;color:var(--vb-text)!important;box-shadow:0 12px 34px rgba(0,0,0,.24)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) footer{background:var(--vb-bg)!important;border-color:var(--vb-line)!important;color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.navlinks a,.navlinks button.navbtn,.nav-actions .tiny){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.navlinks a:hover,.navlinks button.navbtn:hover,.navlinks a.active){background:var(--vb-surface-2)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.page-title,.title,.section-title,h1,h2,h3,h4,h5,h6,strong,b,summary,label){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.page-subtitle,.subtitle,.muted,.tiny,p,small){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.eyebrow,[class*="eyebrow"],[class*="kicker"]){color:var(--vb-orange-2)!important}

/* General surfaces/forms used by content pages. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.panel,.card,.kpi,.alert-card,.auth-card,.invite-card,.faq-hero,.faq details,.notif,.users-surface,.flash){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:0 14px 42px rgba(0,0,0,.20)!important}
html[data-vano-theme="black"] :is(.panel-head,.panel-body.vano-app-root:not(.vano-route-onboarding),.card-body,.section,.table-wrap){border-color:var(--vb-line)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.input,.select,.textarea,input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),select,textarea){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.input,.select,.textarea,input,textarea)::placeholder{color:#AFA49D!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) table{color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.table th,.table td,thead,tbody,tr){border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .table tr:hover td{background:rgba(255,251,242,.025)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.badge,.pill,.chip){border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .btn:not(.btn-primary){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .btn-primary{color:#fff!important}

/* Map UI: the account/profile drawer and its profile section were being repainted white by older CSS. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app{background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.account-drawer,.safety-drawer,.prefs-drawer,.quick-alert-card,.search-results,.destination-confirm,.sheet#planSheet,.sheet,.route-card,.guest-limit-card,.resume-trip-card,.nav-panel.nav-minimal,.nav-voice-popover,.traffic-radar,.route-loading-card){background:rgba(33,30,27,.975)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:0 18px 50px rgba(0,0,0,.32)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.drawer-user,.drawer-link,.drawer-profile,.safety-tool,.pref-row,.quick-alert-grid button,.parking-item,.planner-preset,.nearby-service,.search-item,.search-suggestion,.location-row,.segment button,.travel button,.preview-actions .sub-action){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.drawer-user b,.drawer-profile,.drawer-link,.drawer-link span,.drawer-link em,.drawer-link i,.safety-tool,.safety-tool b,.pref-row,.pref-row b,.quick-alert-label,.quick-alert-head h3,.search-item b,.search-suggestion b,.planner-heading-copy b,.route-card h3,.route-head h2,.destination-confirm h3,.nav-summary-item strong){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.drawer-user span,.drawer-login p,.guest-drawer-content>p,.quick-alert-head p,.quick-alert-status,.result-address,.result-copy small,.search-label,.search-label span,.search-label em,.search-message,.search-message span,.search-suggestion small,.planner-heading-copy span,.route-card-meta,.route-ai,.destination-confirm p,.nav-summary-item small,.traffic-radar-copy span){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.drawer-divider,.support-title){border-color:var(--vb-line)!important;background-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.drawer-link:hover,.drawer-link:active,.search-item:active,.search-suggestion:active,.quick-alert-grid button:active,.planner-preset:active,.nearby-service:active){background:var(--vb-surface-3)!important;color:var(--vb-orange-2)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.drawer-avatar.fallback,.quick-alert-close,.guest-drawer-close,.guest-drawer-secondary){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .guest-drawer-benefits span{background:var(--vb-surface-2)!important;color:var(--vb-muted)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .guest-drawer-primary{color:#fff!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .mapboxgl-popup-content{background:rgba(33,30,27,.99)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .mapboxgl-popup-content *{color:inherit!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .mapboxgl-popup-tip{border-top-color:var(--vb-surface)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .mapboxgl-ctrl-group button{background:var(--vb-surface-2)!important;color:var(--vb-text)!important}
body.vano-app-root:not(.vano-route-onboarding) .map-mood-fade{transition:opacity .09s ease!important}

/* Profile page: authoritative dark skin for every nested profile surface. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):has(.v72-profile-page){background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.profile-v72-hero,.profile-v72-card,.profile-v72-detail,.profile-v72-links,.profile-v108-quicknav a,.profile-v72-place,.profile-v72-nav-pref,.profile-v72-map-style,.profile-v72-accent,.profile-v72-fuel-list span,.profile-v72-person,.profile-v72-empty){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .profile-v72-detail summary{background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .profile-v72-detail summary:hover{background:var(--vb-surface-2)!important}
html[data-vano-theme="black"] .profile-v72-detail-body.vano-app-root:not(.vano-route-onboarding){background:#1C1916!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.profile-v72-field input,.profile-v72-field select,.profile-v72-place input,.profile-v72-invite input){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.profile-v72-copy h1,.profile-v72-section-head h2,.profile-v72-subhead b,.profile-v72-detail-copy b,.profile-v72-place-head,.profile-v72-nav-copy b,.profile-v72-map-copy b,.profile-v72-person b,.profile-v72-links b,.profile-v108-quicknav b){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.profile-v72-copy p,.profile-v72-section-head p,.profile-v72-subcopy,.profile-v72-detail-copy small,.profile-v72-field>span,.profile-v72-nav-copy small,.profile-v72-map-copy small,.profile-v72-person small,.profile-v72-links small,.profile-v108-quicknav small){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.profile-v72-badge,.profile-v72-note,.profile-v72-nav-icon,.profile-v72-detail-icon,.profile-v72-card-icon,.profile-v72-link-icon,.profile-v108-quick-icon,.profile-v72-secondary){background:rgba(245,154,98,.10)!important;color:var(--vb-orange-2)!important;border-color:rgba(245,154,98,.18)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .profile-v72-switch{background:#4A433E!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .profile-v72-switch:before{background:#FFFBF2!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.profile-v72-map-style:has(input:checked),.profile-v72-accent:has(input:checked),.profile-v72-fuel-list input:checked+span){background:rgba(245,154,98,.11)!important;border-color:rgba(245,154,98,.30)!important;color:var(--vb-orange-2)!important}

/* Onboarding and auth entry. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.ob-shell,.ob-section,.choice label,.pref label,.night-card,.presence-consent,.privacy-note,.v63-entry-shell,.v63-entry-panel,.v63-auth-block,.auth-shell,.auth-pane,.sheet-card){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.ob-head h1,.ob-section-title b,.choice label b,.pref label b,.night-card b,.v63-entry-panel h1,.v63-auth-label span:first-child,.auth-copy h1,.sheet-head h2){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.ob-head p,.ob-section-title span,.choice label span,.pref label span,.night-card span,.v63-entry-lead,.auth-legal,.lead,.legal,.sheet-head p,.sheet-switch){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.ob-section .input,.ob-section .select,.sheet-input,.sheet-select,.field input,.input-shell,.auth-button.google,.auth-google,.auth-choice.secondary,.auth-guest){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.auth-button.email,.auth-choice.primary,.sheet-submit){color:#fff!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-auth-tagline{color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-frame{border-color:rgba(255,195,155,.16)!important;box-shadow:0 16px 42px rgba(0,0,0,.30)!important}
@media(max-width:760px){html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.auth-page[data-auth-page="login"],.auth-page[data-auth-page="login"] .auth-shell,.auth-page[data-auth-page="login"] .auth-pane,.vano-entry,.vano-entry .v63-entry-shell,.vano-entry .v63-entry-panel){background:var(--vb-bg)!important}}

/* Notifications/help/invites and generic content lists. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.notif-shell,.notif-list,.faq-shell,.invite-shell){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.notif,.faq details,.invite-card){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.notif p,.notif small,.faq p,.faq small,.invite-card p,.invite-card small){color:var(--vb-muted)!important}

/* Admin pages: old admin-specific styles contained many late white !important rules. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76){background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76) :is([class*="card"],[class*="panel"],[class*="surface"],[class*="kpi"],[class*="metric"],[class*="tile"],[class*="row"],table){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76) :is(input,select,textarea){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76) :is(h1,h2,h3,h4,b,strong,label,th,td){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76) :is(p,small,.muted,span){border-color:var(--vb-line)!important}

/* Standalone shared/live pages when this sheet is linked there. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.share-app,.map-unavailable,.app,.offline){background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.share-top,.route-panel,.share-app .metric,.share-app .route-actions button,.share-app .route-actions a:not(.primary),.live-trip-card){background:rgba(33,30,27,.97)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.share-top span,.share-app .place small,.share-app .metric small,.share-app .copy-status,.share-app .route-panel p){color:var(--vb-muted)!important}


/* VANO v177 — remove the cramped mobile header shown in the screenshot.
   Signed-in phones already have the bottom dock, so the old wordmark/logout bar is redundant. */
@media(max-width:760px){
  body.vano-app-root:not(.vano-route-onboarding).vano-signed-in>.topbar,
body.vano-app-root:not(.vano-route-onboarding):has(.vano-entry)>.topbar,
body.vano-app-root:not(.vano-route-onboarding):has(.onboard)>.topbar{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-signed-in{padding-top:0!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-signed-in>.page,
body.vano-app-root:not(.vano-route-onboarding).vano-signed-in>.container.page{padding-top:max(14px,env(safe-area-inset-top))!important}
}

/* Desktop/tablet header stays restrained and does not duplicate the wordmark text. */
body.vano-app-root:not(.vano-route-onboarding) .topbar .brand>span{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) .topbar .vano-brand-wordmark{width:132px!important;height:32px!important;max-width:132px!important;object-fit:contain!important;object-position:left center!important;filter:none!important}


/* VANO v178 — transparent auth branding.
   Removes the white/cropped banner frame entirely and uses high-resolution
   light/dark transparent assets so the identity feels native to the page. */
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-link{
  display:block!important;
  width:min(100%,560px)!important;
  max-width:560px!important;
  margin:0!important;
  padding:0!important;
  background:transparent!important;
  border:0!important;
  border-radius:0!important;
  box-shadow:none!important;
  overflow:visible!important;
  text-decoration:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-clean{
  position:relative!important;
  display:block!important;
  width:100%!important;
  aspect-ratio:4.86/1!important;
  background:transparent!important;
  border:0!important;
  border-radius:0!important;
  box-shadow:none!important;
  overflow:visible!important;
  isolation:isolate!important;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-clean:before{
  content:""!important;
  position:absolute!important;
  left:1.5%!important;
  top:17%!important;
  width:17%!important;
  aspect-ratio:1!important;
  border-radius:34%!important;
  background:rgba(245,154,98,.14)!important;
  filter:blur(22px)!important;
  transform:scale(.92)!important;
  z-index:-1!important;
  pointer-events:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-clean .vano-auth-banner{
  position:absolute!important;
  inset:0!important;
  display:block!important;
  width:100%!important;
  height:100%!important;
  max-width:none!important;
  max-height:none!important;
  object-fit:contain!important;
  object-position:left center!important;
  transform:none!important;
  background:transparent!important;
  border:0!important;
  border-radius:0!important;
  box-shadow:none!important;
  image-rendering:auto!important;
  -webkit-font-smoothing:antialiased!important;
  filter:drop-shadow(0 10px 22px rgba(74,51,36,.08))!important;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-dark{opacity:0!important;visibility:hidden!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-light{opacity:0!important;visibility:hidden!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-dark{opacity:1!important;visibility:visible!important;filter:drop-shadow(0 12px 28px rgba(0,0,0,.24))!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-clean:before{background:rgba(245,154,98,.18)!important;filter:blur(25px)!important}

/* Kill every legacy framed-banner style that could leak back in. */
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-frame{
  display:contents!important;
  width:auto!important;height:auto!important;aspect-ratio:auto!important;
  overflow:visible!important;border:0!important;border-radius:0!important;
  background:transparent!important;box-shadow:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-frame .vano-auth-banner{position:static!important;transform:none!important}

/* Better auth hierarchy around the new lockup. */
body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .brand-row{
  position:relative!important;
  inset:auto!important;
  width:100%!important;
  min-height:0!important;
  margin:0 0 clamp(24px,4.5vh,48px)!important;
  padding:0!important;
  pointer-events:auto!important;
  display:block!important;
}
body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-copy{
  margin:0!important;
  padding:0!important;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-brand{
  display:block!important;
  width:100%!important;
  margin:0 0 clamp(28px,5vh,52px)!important;
  padding:0!important;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-kicker{margin-top:0!important}

@media(max-width:760px){
  body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-link{width:min(100%,390px)!important;max-width:390px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-clean{aspect-ratio:4.86/1!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .brand-row{margin-bottom:clamp(28px,6vh,48px)!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .auth-pane{
    padding-top:max(24px,calc(env(safe-area-inset-top) + 16px))!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-brand{margin-bottom:34px!important}
}
@media(max-width:380px){
  body.vano-app-root:not(.vano-route-onboarding) .vano-auth-banner-link{width:min(100%,344px)!important}
  body.vano-app-root:not(.vano-route-onboarding) .auth-page[data-auth-page="login"] .brand-row{margin-bottom:26px!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-entry .v63-entry-brand{margin-bottom:28px!important}
}


/* ---- vano-theme.css ---- */
/* ============================================================
   VANO — THEME CONTRAST AUTHORITY
   Objetivo:
   - Black: texto principal realmente branco/claro em TODA a UI.
   - White: texto principal realmente escuro em TODA a UI.
   - Preserva laranja da marca e cores semânticas (erro/sucesso/alerta).
   - Carregado por último para neutralizar regras antigas hard-coded.
   ============================================================ */

body.vano-app-root:not(.vano-route-onboarding),
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding){
  color-scheme: light;
  --vt-bg: #FFF8F2;
  --vt-surface: #FFFFFF;
  --vt-surface-2: #FFFDFB;
  --vt-surface-3: #F7F2EE;
  --vt-text: #27231F;
  --vt-text-2: #4E4741;
  --vt-muted: #706861;
  --vt-placeholder: #9A9088;
  --vt-line: rgba(39,35,31,.10);
  --vt-primary: #F59A62;
  --vt-primary-light: #FFC39B;
  --vt-primary-dark: #D9703F;

  /* aliases usados por CSS legado / mapa */
  --text: var(--vt-text);
  --muted: var(--vt-muted);
  --muted-2: var(--vt-placeholder);
  --vano-ink: var(--vt-text);
  --vano-muted: var(--vt-muted);
  --vano-bg: var(--vt-bg);
  --vano-card: var(--vt-surface);
  --vano-card-2: var(--vt-surface-2);
  --vg-bg: var(--vt-bg);
  --vg-surface: rgba(255,255,255,.965);
  --vg-surface-solid: var(--vt-surface);
  --vg-surface-soft: var(--vt-surface-2);
  --vg-surface-glass: rgba(255,255,255,.90);
  --vg-text: var(--vt-text);
  --vg-text-2: var(--vt-text-2);
  --vg-muted: var(--vt-muted);
}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding){
  color-scheme: dark;
  --vt-bg: #171512;
  --vt-surface: #211E1B;
  --vt-surface-2: #27231F;
  --vt-surface-3: #302B27;
  --vt-text: #FFF8F2;
  --vt-text-2: #E8DED7;
  --vt-muted: #BFB4AC;
  --vt-placeholder: #938981;
  --vt-line: rgba(255,248,242,.11);
  --vt-primary: #F59A62;
  --vt-primary-light: #FFC39B;
  --vt-primary-dark: #D9703F;

  --text: var(--vt-text);
  --muted: var(--vt-muted);
  --muted-2: var(--vt-placeholder);
  --vano-ink: var(--vt-text);
  --vano-muted: var(--vt-muted);
  --vano-bg: var(--vt-bg);
  --vano-card: var(--vt-surface);
  --vano-card-2: var(--vt-surface-2);
  --vg-bg: var(--vt-bg);
  --vg-surface: rgba(33,30,27,.975);
  --vg-surface-solid: var(--vt-surface);
  --vg-surface-soft: var(--vt-surface-2);
  --vg-surface-glass: rgba(27,24,22,.92);
  --vg-text: var(--vt-text);
  --vg-text-2: var(--vt-text-2);
  --vg-muted: var(--vt-muted);
}

/* ---------- Base: White ---------- */
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding),
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding){
  background-color: var(--vt-bg) !important;
  color: var(--vt-text) !important;
}

html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) :is(
  .page-title,.title,.section-title,
  h1,h2,h3,h4,h5,h6,
  strong,b,label,legend,summary,
  .brand,.drawer-link,.result-copy b,.route-head h2,
  .destination-confirm h3,.planner-section-head b
){
  color: var(--vt-text) !important;
}

html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) :is(
  p,small,.muted,.tiny,.subtitle,.page-subtitle,
  .result-address,.result-copy small,.search-label,.search-message,
  .route-head p,.route-card-meta,.route-ai
){
  color: var(--vt-muted) !important;
}

html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) :is(
  input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
  textarea,select,.input,.textarea,.select
){
  color: var(--vt-text) !important;
}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) :is(input,textarea)::placeholder{
  color: var(--vt-placeholder) !important;
  opacity: 1 !important;
}

/* ---------- Base: Black ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding),
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding){
  background-color: var(--vt-bg) !important;
  color: var(--vt-text) !important;
}

/* Autoridade principal: qualquer título/rótulo que ficou preto vira claro. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(
  .page-title,.title,.section-title,
  h1,h2,h3,h4,h5,h6,
  strong,b,label,legend,summary,
  .brand,.brand span,.nav-actions .tiny,
  .drawer-link,.drawer-link span,.drawer-link em,
  .drawer-user b,.drawer-profile,
  .result-copy b,.search-item,.search-item b,.search-suggestion b,
  .planner-heading-copy b,.planner-section-head b,.planner-preset b,.nearby-service b,
  .route-head h2,.route-time span,.route-card h3,.route-card .mins,
  .destination-confirm h3,.nav-summary-item strong,
  .profile-v72-copy h1,.profile-v72-section-head h2,.profile-v72-detail-copy b,
  .profile-v72-nav-copy b,.profile-v72-map-copy b,.profile-v72-person b,
  .auth-copy h1,.auth-actions-head h2,.sheet-head h2,
  .ob-head h1,.ob-section-title b,.choice label b,.pref label b
){
  color: var(--vt-text) !important;
}

/* Texto secundário: nunca preto no Black; fica cinza claro legível. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(
  p,small,.muted,.tiny,.subtitle,.page-subtitle,
  .drawer-user span,.drawer-login p,.guest-drawer-content>p,
  .result-address,.result-copy small,.search-label,.search-label span,.search-label em,.search-message,.search-message span,
  .search-suggestion small,.planner-heading-copy span,.planner-preset small,.nearby-service small,
  .route-head p,.route-card-meta,.route-ai,.route-card p,
  .destination-confirm p,.nav-summary-item small,.traffic-radar-copy span,
  .profile-v72-copy p,.profile-v72-detail-copy span,.profile-v72-note,
  .auth-copy p,.auth-actions-head p,.auth-legal,.lead,.legal,.sheet-head p,.sheet-switch,
  .ob-head p,.ob-section-title span,.choice label span,.pref label span
){
  color: var(--vt-muted) !important;
}

/* Forms e controles de texto. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(
  input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
  textarea,select,.input,.textarea,.select,
  .location-input,.sheet-input,.sheet-select
){
  background-color: var(--vt-surface-2) !important;
  color: var(--vt-text) !important;
  border-color: var(--vt-line) !important;
  caret-color: var(--vt-primary) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(input,textarea)::placeholder{
  color: var(--vt-placeholder) !important;
  opacity: 1 !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) select option{
  background: var(--vt-surface) !important;
  color: var(--vt-text) !important;
}

/* ---------- Surfaces comuns ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(
  .panel,.card,.kpi,.alert-card,.auth-card,.profile-card,.profile-detail,
  .faq details,.notif,.invite-card,.flash,
  .account-drawer,.prefs-drawer,.safety-drawer,.sheet,.destination-confirm,
  .search-results,.route-card,.route-loading-card,.resume-trip-card,
  .nav-panel,.nav-voice-popover,.traffic-radar
){
  color: var(--vt-text) !important;
  border-color: var(--vt-line) !important;
}

html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) :is(
  .panel,.card,.kpi,.alert-card,.auth-card,.profile-card,.profile-detail,
  .faq details,.notif,.invite-card,.flash
){
  color: var(--vt-text) !important;
}

/* ---------- Mapa / WebView ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app{
  --text: var(--vt-text) !important;
  --ink: var(--vt-text) !important;
  --muted: var(--vt-muted) !important;
  color: var(--vt-text) !important;
}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .ws-app{
  --text: var(--vt-text) !important;
  --ink: var(--vt-text) !important;
  --muted: var(--vt-muted) !important;
  color: var(--vt-text) !important;
}

/* Elementos que tinham cores escuras hard-coded em folhas antigas. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(
  .location-input,.row-btn,.chip-shortcut,.quick,.map-btn,.nav-stack-btn,.nav-audio-toggle,
  .segment button,.travel button,.route-variant,.route-card,
  .parking-nearby,.parking-item,.parking-row,.route-insight,.insight,
  .drawer-user,.drawer-profile,.drawer-link,.safety-tool,.pref-row,
  .planner-preset,.nearby-service,.search-item,.search-suggestion,
  .destination-edit,.floating-preview-cancel,.nav-recalc-btn,.nav-summary-item
){
  color: var(--vt-text) !important;
}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(
  .route-card-meta,.route-card p,.route-card span,.route-ai,
  .parking-head>span,.insight span,.planner-tip,
  .result-meta,.search-message,.nav-maneuver-copy span,.nav-maneuver-copy small
){
  color: var(--vt-muted) !important;
}

/* ---------- Tables / generic content pages ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) table,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(th,td){
  color: var(--vt-text) !important;
  border-color: var(--vt-line) !important;
}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) table,
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) :is(th,td){
  color: var(--vt-text) !important;
}

/* ---------- Botões ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(button,.btn):not(.btn-primary):not(.sheet-submit):not(.auth-choice.primary):not(.destination-accept):not([class*="danger"]):not([class*="success"]){
  color: var(--vt-text) !important;
}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) :is(button,.btn):not(.btn-primary):not(.sheet-submit):not(.auth-choice.primary):not(.destination-accept):not([class*="danger"]):not([class*="success"]){
  color: var(--vt-text) !important;
}

/* CTA principal continua branco sobre o laranja nos dois temas. */
body.vano-app-root:not(.vano-route-onboarding) :is(.btn-primary,.sheet-submit,.auth-choice.primary,.destination-accept,.guest-drawer-primary){
  color: #FFFFFF !important;
}

/* Marca / estados semânticos NÃO são dessaturados pela troca de tema. */
body.vano-app-root:not(.vano-route-onboarding) :is(.eyebrow,[class*="eyebrow"],[class*="kicker"],.planner-section-head small,.destination-confirm-kicker,.destination-confirm-kicker small){
  color: var(--vt-primary) !important;
}
body.vano-app-root:not(.vano-route-onboarding) :is(.danger,.error,[class*="danger"],[class*="error"]){ --vt-semantic-preserve: 1; }
body.vano-app-root:not(.vano-route-onboarding) :is(.success,[class*="success"]){ --vt-semantic-preserve: 1; }

/* Mapbox popup acompanha o tema. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-content{
  background: var(--vt-surface) !important;
  color: var(--vt-text) !important;
  border-color: var(--vt-line) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-content :is(b,strong,h1,h2,h3,h4,span,p,small){
  color: inherit !important;
}
html[data-vano-theme="light"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-content{
  background: var(--vt-surface) !important;
  color: var(--vt-text) !important;
}

/* Troca visual curta e fluida; evita animação pesada no mapa. */
@media (prefers-reduced-motion: no-preference){
  body.vano-app-root:not(.vano-route-onboarding),
body.vano-app-root:not(.vano-route-onboarding) .topbar,
body.vano-app-root:not(.vano-route-onboarding) .mobile-dock,
body.vano-app-root:not(.vano-route-onboarding) .panel,
body.vano-app-root:not(.vano-route-onboarding) .card,
body.vano-app-root:not(.vano-route-onboarding) .auth-card,
body.vano-app-root:not(.vano-route-onboarding) .account-drawer,
body.vano-app-root:not(.vano-route-onboarding) .prefs-drawer,
body.vano-app-root:not(.vano-route-onboarding) .safety-drawer,
body.vano-app-root:not(.vano-route-onboarding) .sheet,
body.vano-app-root:not(.vano-route-onboarding) .search-results,
body.vano-app-root:not(.vano-route-onboarding) .destination-confirm,
body.vano-app-root:not(.vano-route-onboarding) input,
body.vano-app-root:not(.vano-route-onboarding) textarea,
body.vano-app-root:not(.vano-route-onboarding) select,
body.vano-app-root:not(.vano-route-onboarding) button{
    transition-property: color,background-color,border-color !important;
    transition-duration: 140ms !important;
    transition-timing-function: ease-out !important;
  }
}

/* ============================================================
   VANO — BLACK MODE FINAL CONTRAST LOCK
   This block intentionally lives in the last-loaded theme sheet.
   It only affects Black mode and neutralizes late legacy light-mode
   hard-codes from the bundled map/navigation stylesheet.
   ============================================================ */

/* Active navigation: ETA / remaining time / distance card. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav.nav-panel.nav-minimal{
  background: rgba(33,30,27,.985) !important;
  color: var(--vt-text) !important;
  border-color: var(--vt-line) !important;
  box-shadow: 0 -12px 42px rgba(0,0,0,.30) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item{
  background: var(--vt-surface-2) !important;
  color: var(--vt-text) !important;
  border-color: var(--vt-line) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item small,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item strong,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item:first-child strong{
  color: var(--vt-text) !important;
}

/* Speedometer: never inherit the old black text / white card in Black mode. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo{
  background: rgba(39,35,31,.985) !important;
  color: var(--vt-text) !important;
  border-color: var(--vt-line) !important;
  box-shadow: 0 7px 18px rgba(0,0,0,.26) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo strong,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo span,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo small{
  color: var(--vt-text) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo::before{
  background: rgba(255,248,242,.14) !important;
}

/* Driver controls and free-map tool rail. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app :is(#navDrawerRecenter,#soundBtn,#navCameraToggle),
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) .ws-app :is(.options-btn,.map-tools .map-btn,.floating-locate){
  background: rgba(39,35,31,.97) !important;
  color: var(--vt-text) !important;
  border-color: var(--vt-line) !important;
  box-shadow: 0 7px 18px rgba(0,0,0,.20) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app :is(#soundBtn.active,#navCameraToggle.active){
  background: var(--vt-primary) !important;
  color: #fff !important;
  border-color: var(--vt-primary) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #navDrawerRecenter.active{
  background: var(--vt-surface-2) !important;
  color: var(--vt-text) !important;
  border-color: var(--vt-line) !important;
}

/* Maneuver/street cards: old bundled rules forced black text and white surfaces. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-top,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-street-chip{
  background: rgba(33,30,27,.975) !important;
  color: var(--vt-text) !important;
  border-color: var(--vt-line) !important;
  box-shadow: 0 10px 28px rgba(0,0,0,.24) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy b,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-street-chip,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-street-chip span{
  color: var(--vt-text) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy span{
  color: var(--vt-primary-light) !important;
}

/* Planner / route-preview text that legacy light rules pin to dark colors. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app #routeState,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app #routeState :is(.route-head h2,.route-time span,.route-time small,.customize-route-kicker,.customize-route-kicker b,.route-choice-label,.route-card,.route-card h3,.route-card-meta,.route-ai,.safety-level strong,.traffic-line,.route-insight strong,.route-insight span,.preview-actions .sub-action,.disclaimer){
  color: var(--vt-text) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app #routeState :is(.route-head p,.route-card-meta,.route-ai,.safety-level strong,.traffic-line,.route-insight span,.disclaimer){
  color: var(--vt-muted) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app #routeState :is(.segment button,.travel button,.route-card,.route-insight .insight,.preview-actions .sub-action,.parking-nearby,.parking-item){
  background: var(--vt-surface-2) !important;
  border-color: var(--vt-line) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app #routeState :is(.segment button.active,.travel button.active){
  background: rgba(245,154,98,.16) !important;
  color: var(--vt-primary-light) !important;
  border-color: rgba(245,154,98,.28) !important;
}

/* Traffic / reroute helper content. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav :is(.traffic-suggestion,.reroute,.nav-alt-hint,.nav-feedback){
  background: rgba(33,30,27,.98) !important;
  color: var(--vt-text) !important;
  border-color: var(--vt-line) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav :is(.traffic-suggestion b,.traffic-suggestion span,.traffic-suggestion small,.nav-alt-copy b,.nav-alt-copy em,.nav-feedback-copy b,.nav-feedback-copy small,.reroute span){
  color: var(--vt-text) !important;
}


/* Small late surfaces that were still authored as White-only. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) #planSheet .planner-grab,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .connectivity-pill,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .place-popup-save,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-dismiss{
  background: var(--vt-surface-2) !important;
  color: var(--vt-text) !important;
  border-color: var(--vt-line) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) #planSheet .planner-grab:active{
  background: var(--vt-surface-3) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app #activeNav .traffic-suggestion.show{
  background: rgba(33,30,27,.985) !important;
  color: var(--vt-text) !important;
  border-color: var(--vt-line) !important;
  box-shadow: 0 14px 38px rgba(0,0,0,.28) !important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-suggestion-icon{
  background: rgba(245,154,98,.14) !important;
  color: var(--vt-primary-light) !important;
}


/* ---- vano-route-studio.css ---- */
/* VANO Route Studio V184
   Full redesign of the pre-navigation route customization panel.
   Loaded last on purpose: this file owns the visual layer of #routeState only.
*/

body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio{
  --vr-accent:#F59A62;
  --vr-accent-light:#FFC39B;
  --vr-accent-dark:#D9703F;
  --vr-text:#27231F;
  --vr-muted:#706861;
  --vr-faint:#9A8F87;
  --vr-surface:#FFFFFF;
  --vr-surface-2:#FFFDFB;
  --vr-soft:#FFF4EC;
  --vr-soft-2:#FFF8F2;
  --vr-line:#EDE3DC;
  --vr-line-strong:#E0D1C7;
  --vr-shadow:0 12px 30px rgba(71,46,29,.09);
  --vr-shadow-soft:0 6px 18px rgba(71,46,29,.055);
  --vr-radius-lg:22px;
  --vr-radius-md:16px;
  --vr-radius-sm:13px;
  box-sizing:border-box!important;
  width:100%!important;
  min-width:0!important;
  color:var(--vr-text)!important;
  padding:2px 1px 8px!important;
  scrollbar-width:none!important;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio::-webkit-scrollbar{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio *,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio *::before,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio *::after{box-sizing:border-box}

/* Theme switch: no geometry changes, only semantic colors. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio{
  --vr-text:#FFF8F2;
  --vr-muted:#C7BBB3;
  --vr-faint:#91847C;
  --vr-surface:#171512;
  --vr-surface-2:#1D1A17;
  --vr-soft:#2B211B;
  --vr-soft-2:#211D1A;
  --vr-line:#332C27;
  --vr-line-strong:#443830;
  --vr-shadow:0 15px 36px rgba(0,0,0,.30);
  --vr-shadow-soft:0 8px 20px rgba(0,0,0,.20);
}

/* Route hero */
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  gap:12px!important;
  align-items:center!important;
  padding:13px 14px!important;
  margin:0 0 10px!important;
  border:1px solid var(--vr-line)!important;
  border-radius:var(--vr-radius-lg)!important;
  background:linear-gradient(145deg,var(--vr-surface) 0%,var(--vr-surface-2) 70%)!important;
  color:var(--vr-text)!important;
  box-shadow:var(--vr-shadow-soft)!important;
  overflow:hidden!important;
  position:relative!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero::after{
  content:"";
  position:absolute;
  width:120px;height:120px;
  right:-58px;top:-70px;
  border-radius:50%;
  background:radial-gradient(circle,rgba(245,154,98,.18),rgba(245,154,98,0) 68%);
  pointer-events:none;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-copy{min-width:0!important;position:relative;z-index:1}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-eyebrow{
  display:flex!important;align-items:center!important;gap:6px!important;
  margin:0 0 5px!important;color:var(--vr-accent-dark)!important;
  font-size:8px!important;line-height:1!important;font-weight:950!important;
  letter-spacing:.12em!important;text-transform:uppercase!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-eyebrow::before{
  content:"";width:7px;height:7px;border-radius:50%;background:var(--vr-accent)!important;
  box-shadow:0 0 0 4px rgba(245,154,98,.13);
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head{display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;gap:12px!important;align-items:center!important;width:100%!important;position:relative!important;z-index:1!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head>div:first-child{min-width:0!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head h2{
  margin:0!important;color:var(--vr-text)!important;font-size:20px!important;line-height:1.08!important;
  font-weight:950!important;letter-spacing:-.65px!important;white-space:normal!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head p{
  margin:5px 0 0!important;color:var(--vr-muted)!important;font-size:10px!important;line-height:1.35!important;
  font-weight:650!important;max-width:30rem!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time{
  min-width:82px!important;text-align:right!important;position:relative;z-index:1;
  padding-left:8px!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time span{
  display:block!important;color:var(--vr-text)!important;font-size:25px!important;line-height:.95!important;
  font-weight:950!important;letter-spacing:-1px!important;white-space:nowrap!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time small{
  display:block!important;margin-top:5px!important;color:var(--vr-accent-dark)!important;font-size:9px!important;
  line-height:1!important;font-weight:900!important;white-space:nowrap!important;
}

/* Customization controls */
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-customize{
  padding:12px!important;margin:0 0 10px!important;border:1px solid var(--vr-line)!important;
  border-radius:var(--vr-radius-lg)!important;background:var(--vr-surface)!important;color:var(--vr-text)!important;
  box-shadow:var(--vr-shadow-soft)!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .customize-route-kicker{
  display:flex!important;align-items:flex-end!important;justify-content:space-between!important;gap:10px!important;
  margin:0 1px 11px!important;padding:0!important;border:0!important;opacity:1!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .customize-route-kicker span{
  color:var(--vr-text)!important;font-size:13px!important;line-height:1!important;font-weight:950!important;
  letter-spacing:-.2px!important;text-transform:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .customize-route-kicker b{
  color:var(--vr-muted)!important;font-size:8px!important;line-height:1!important;font-weight:750!important;
  letter-spacing:0!important;text-transform:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-control-block + .vr-control-block{margin-top:10px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-choice-label{
  display:flex!important;align-items:center!important;justify-content:space-between!important;gap:8px!important;
  margin:0 2px 6px!important;color:var(--vr-muted)!important;font-size:8px!important;line-height:1!important;
  font-weight:900!important;letter-spacing:.09em!important;text-transform:uppercase!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-choice-label small{
  color:var(--vr-faint)!important;font-size:7px!important;font-weight:700!important;letter-spacing:0!important;text-transform:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel{
  display:grid!important;gap:7px!important;margin:0!important;padding:0!important;background:transparent!important;border:0!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment{grid-template-columns:repeat(2,minmax(0,1fr))!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel{grid-template-columns:repeat(3,minmax(0,1fr))!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment button,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel button{
  appearance:none!important;min-width:0!important;height:48px!important;padding:0 10px!important;
  display:flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;
  border:1px solid var(--vr-line)!important;border-radius:14px!important;background:var(--vr-surface-2)!important;
  color:var(--vr-muted)!important;box-shadow:none!important;font-size:10px!important;line-height:1!important;
  font-weight:900!important;white-space:nowrap!important;position:relative!important;overflow:hidden!important;
  touch-action:manipulation!important;-webkit-tap-highlight-color:transparent!important;
  transition:transform .12s ease,background-color .14s ease,border-color .14s ease,color .14s ease!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment button svg,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel button svg{width:16px!important;height:16px!important;flex:0 0 auto!important;color:currentColor!important;stroke:currentColor!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel .moto-ico{fill:none!important;stroke:currentColor!important;stroke-width:1.7!important;stroke-linecap:round!important;stroke-linejoin:round!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment button.active,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel button.active{
  border-color:rgba(245,154,98,.58)!important;background:var(--vr-soft)!important;color:var(--vr-accent-dark)!important;
  box-shadow:inset 0 0 0 1px rgba(245,154,98,.07)!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment button.active::after,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel button.active::after{
  content:"";position:absolute!important;right:8px!important;top:8px!important;width:6px!important;height:6px!important;
  border-radius:50%!important;background:var(--vr-accent)!important;box-shadow:0 0 0 3px rgba(245,154,98,.12)!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment button:active,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel button:active{transform:scale(.975)!important}

/* Alternatives */
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-section-head{
  display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;
  margin:0 2px 6px!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-section-head span{color:var(--vr-text)!important;font-size:11px!important;font-weight:950!important;letter-spacing:-.1px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-section-head small{color:var(--vr-faint)!important;font-size:7.5px!important;font-weight:750!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variants{
  display:grid!important;grid-auto-flow:column!important;grid-auto-columns:minmax(126px,1fr)!important;
  gap:7px!important;margin:0 0 10px!important;padding:1px 1px 3px!important;overflow-x:auto!important;overflow-y:hidden!important;
  scroll-snap-type:x proximity!important;overscroll-behavior-x:contain!important;scrollbar-width:none!important;-webkit-overflow-scrolling:touch!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variants::-webkit-scrollbar{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variants.route-alt-hidden{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant{
  scroll-snap-align:start!important;min-width:126px!important;max-width:none!important;min-height:92px!important;padding:11px 11px!important;
  display:flex!important;flex-direction:column!important;align-items:flex-start!important;justify-content:flex-start!important;
  border:1px solid var(--vr-line)!important;border-radius:16px!important;background:var(--vr-surface)!important;color:var(--vr-text)!important;
  box-shadow:var(--vr-shadow-soft)!important;text-align:left!important;position:relative!important;overflow:hidden!important;
  touch-action:manipulation!important;-webkit-tap-highlight-color:transparent!important;
  transition:transform .12s ease,border-color .14s ease,background-color .14s ease!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant::before{
  content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:transparent;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant.active{
  border-color:rgba(245,154,98,.66)!important;background:linear-gradient(145deg,var(--vr-soft),var(--vr-surface))!important;
  box-shadow:0 8px 22px rgba(217,112,63,.10)!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant.active::before{background:var(--vr-accent)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant:active{transform:scale(.978)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant small{
  display:block!important;margin:0 0 5px!important;color:var(--vr-faint)!important;font-size:7px!important;line-height:1!important;
  font-weight:900!important;text-transform:uppercase!important;letter-spacing:.08em!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant.active small{color:var(--vr-accent-dark)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant b{
  display:block!important;margin:0!important;color:var(--vr-text)!important;font-size:17px!important;line-height:1!important;font-weight:950!important;letter-spacing:-.45px!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant span{
  display:block!important;margin:6px 0 0!important;color:var(--vr-muted)!important;font-size:9px!important;line-height:1.1!important;font-weight:800!important;
  white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;max-width:100%!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant em{
  display:block!important;margin:4px 0 0!important;color:var(--vr-accent-dark)!important;font-size:7px!important;line-height:1.1!important;font-style:normal!important;font-weight:850!important;
  white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;max-width:100%!important;
}

/* Route summary card */
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-summary-head{margin-top:1px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card{
  margin:0!important;padding:13px!important;border:1px solid var(--vr-line)!important;border-radius:var(--vr-radius-lg)!important;
  background:var(--vr-surface)!important;color:var(--vr-text)!important;box-shadow:var(--vr-shadow)!important;overflow:hidden!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card.fast-selected{border-color:rgba(245,154,98,.52)!important;background:linear-gradient(145deg,var(--vr-surface),var(--vr-soft-2))!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card-top{
  display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;gap:10px!important;align-items:flex-start!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card-top>div:first-child{min-width:0!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card-top h3{
  margin:0!important;color:var(--vr-text)!important;font-size:13px!important;line-height:1.15!important;font-weight:950!important;letter-spacing:-.2px!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card .mins{
  color:var(--vr-accent-dark)!important;font-size:18px!important;line-height:1!important;font-weight:950!important;letter-spacing:-.45px!important;white-space:nowrap!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .safety-level{
  display:flex!important;align-items:center!important;gap:7px!important;flex-wrap:wrap!important;margin-top:7px!important;min-width:0!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .level-pill{
  min-height:24px!important;padding:0 8px!important;display:inline-flex!important;align-items:center!important;gap:4px!important;
  border:1px solid rgba(245,154,98,.38)!important;border-radius:999px!important;background:var(--vr-soft)!important;color:var(--vr-accent-dark)!important;
  font-size:8px!important;line-height:1!important;font-weight:950!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .level-pill svg{width:11px!important;height:11px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .safety-level strong{color:var(--vr-muted)!important;font-size:9px!important;line-height:1.2!important;font-weight:760!important;min-width:0!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .safety-dots{display:inline-flex!important;align-items:center!important;gap:3px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .safety-dots i{width:6px!important;height:6px!important;border-radius:50%!important;background:var(--vr-line-strong)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .safety-dots i.on{background:var(--vr-accent)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card-meta{display:flex!important;gap:6px!important;flex-wrap:wrap!important;margin-top:9px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card-meta span{
  padding:5px 8px!important;border:1px solid var(--vr-line)!important;border-radius:999px!important;background:var(--vr-surface-2)!important;
  color:var(--vr-muted)!important;font-size:7.5px!important;font-weight:800!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .traffic-line{
  display:grid!important;grid-template-columns:minmax(0,1fr) minmax(72px,1fr) auto!important;gap:8px!important;align-items:center!important;
  margin-top:10px!important;padding-top:10px!important;border-top:1px solid var(--vr-line)!important;border-left:0!important;border-right:0!important;border-bottom:0!important;
  background:transparent!important;color:var(--vr-muted)!important;font-size:8px!important;font-weight:760!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .traffic-bar{height:5px!important;border-radius:999px!important;background:var(--vr-line)!important;overflow:hidden!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .traffic-bar i{display:block!important;height:100%!important;border-radius:inherit!important;background:linear-gradient(90deg,#78C896,#F1B95D,#D96E52)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .smart-note,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .risk-note{
  margin-top:9px!important;padding:9px 10px!important;display:flex!important;align-items:flex-start!important;gap:7px!important;
  border:1px solid var(--vr-line)!important;border-radius:13px!important;background:var(--vr-surface-2)!important;color:var(--vr-muted)!important;
  font-size:9px!important;line-height:1.35!important;font-weight:680!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .smart-note{border-color:rgba(245,154,98,.30)!important;background:var(--vr-soft-2)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .smart-note b{color:var(--vr-accent-dark)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .risk-note svg{flex:0 0 auto!important;color:var(--vr-accent-dark)!important;margin-top:1px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .live-dot{width:7px!important;height:7px!important;flex:0 0 auto!important;margin-top:2px!important;border-radius:50%!important;background:var(--vr-accent)!important;box-shadow:0 0 0 4px rgba(245,154,98,.11)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-ai{
  margin-top:9px!important;padding:10px!important;display:block!important;border:0!important;border-radius:13px!important;
  background:var(--vr-soft-2)!important;color:var(--vr-muted)!important;font-size:9px!important;line-height:1.42!important;font-weight:650!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-ai .vano-dot{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-ai b{
  display:block!important;margin:0 0 3px!important;color:var(--vr-accent-dark)!important;font-size:7.5px!important;line-height:1!important;font-weight:950!important;
  text-transform:uppercase!important;letter-spacing:.08em!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-ai span{color:var(--vr-muted)!important}

/* Parking */
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-nearby{
  display:none!important;margin:0 0 10px!important;padding:11px!important;border:1px solid var(--vr-line)!important;
  border-radius:var(--vr-radius-md)!important;background:var(--vr-surface)!important;color:var(--vr-text)!important;box-shadow:var(--vr-shadow-soft)!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-nearby.show{display:block!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-head{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:8px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-head small{display:block!important;color:var(--vr-accent-dark)!important;font-size:7px!important;font-weight:950!important;letter-spacing:.08em!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-head b{display:block!important;margin-top:2px!important;color:var(--vr-text)!important;font-size:10px!important;font-weight:900!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-head>span{color:var(--vr-faint)!important;font-size:7px!important;font-weight:700!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-list{display:grid!important;gap:6px!important;margin-top:8px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-item{
  width:100%!important;min-height:46px!important;padding:8px 9px!important;display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;gap:8px!important;align-items:center!important;
  border:1px solid var(--vr-line)!important;border-radius:12px!important;background:var(--vr-surface-2)!important;color:var(--vr-text)!important;text-align:left!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-item b{color:var(--vr-text)!important;font-size:9px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-item span{color:var(--vr-muted)!important;font-size:7px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-item strong{color:var(--vr-accent-dark)!important;font-size:9px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-empty{color:var(--vr-muted)!important;font-size:8px!important}

/* Main action */
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .start-trip-cta.primary{
  width:100%!important;min-height:58px!important;margin:10px 0 0!important;padding:9px 11px!important;
  display:grid!important;grid-template-columns:40px minmax(0,1fr) 24px!important;align-items:center!important;gap:10px!important;
  border:1px solid rgba(255,255,255,.16)!important;border-radius:18px!important;
  background:linear-gradient(135deg,var(--vr-accent-light) 0%,var(--vr-accent) 48%,var(--vr-accent-dark) 100%)!important;
  color:#FFFFFF!important;box-shadow:0 13px 28px rgba(217,112,63,.24)!important;text-align:left!important;
  touch-action:manipulation!important;-webkit-tap-highlight-color:transparent!important;
  transition:transform .12s ease,filter .12s ease!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .start-trip-cta.primary:active{transform:scale(.985)!important;filter:brightness(.98)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .start-trip-icon{
  width:40px!important;height:40px!important;display:grid!important;place-items:center!important;border-radius:13px!important;
  background:rgba(255,255,255,.16)!important;border:1px solid rgba(255,255,255,.18)!important;color:#fff!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .start-trip-icon svg{width:18px!important;height:18px!important;color:#fff!important;stroke:#fff!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .start-trip-copy{min-width:0!important;color:#fff!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .start-trip-copy b{display:block!important;color:#fff!important;font-size:13px!important;line-height:1.1!important;font-weight:950!important;letter-spacing:-.15px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .start-trip-copy small{display:block!important;margin-top:3px!important;color:rgba(255,255,255,.80)!important;font-size:7.5px!important;line-height:1.1!important;font-weight:760!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .start-trip-arrow{justify-self:end!important;color:#fff!important;font-size:25px!important;line-height:1!important;font-weight:500!important;opacity:.9!important}

/* Secondary actions */
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .preview-actions{
  display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:7px!important;margin:7px 0 0!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .preview-actions .sub-action{
  min-width:0!important;height:42px!important;padding:0 7px!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:6px!important;
  border:1px solid var(--vr-line)!important;border-radius:13px!important;background:var(--vr-surface)!important;color:var(--vr-muted)!important;
  box-shadow:none!important;font-size:8px!important;line-height:1!important;font-weight:850!important;white-space:nowrap!important;
  touch-action:manipulation!important;-webkit-tap-highlight-color:transparent!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .preview-actions .sub-action svg{width:14px!important;height:14px!important;color:var(--vr-accent-dark)!important;stroke:var(--vr-accent-dark)!important;flex:0 0 auto!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .preview-actions .sub-action:active{transform:scale(.975)!important;background:var(--vr-soft)!important;color:var(--vr-accent-dark)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio>.disclaimer,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .routeState-disclaimer{
  margin:8px 3px 0!important;color:var(--vr-faint)!important;font-size:7.5px!important;line-height:1.35!important;font-weight:650!important;text-align:center!important;
}

/* Hard contrast lock: nothing inside the route screen may inherit stale black/white legacy values. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head h2,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time span,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .customize-route-kicker span,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-section-head span,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant b,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card h3,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-head b,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-item b{color:#FFF8F2!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head p,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .customize-route-kicker b,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-choice-label,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant span,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .safety-level strong,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .traffic-line,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-ai,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-ai span,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .smart-note,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .risk-note,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .preview-actions .sub-action{color:#C7BBB3!important}

/* Phones */
@media(max-width:899px){
  body.vano-app-root:not(.vano-route-onboarding) #planSheet:not(.sheet-collapsed) #routeState.vano-route-studio{
    max-height:min(67dvh,650px)!important;overflow-y:auto!important;overscroll-behavior:contain!important;padding-bottom:7px!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero{padding:12px 12px!important;border-radius:19px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-customize{padding:11px!important;border-radius:19px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card{border-radius:19px!important}
}
@media(max-width:430px){
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head h2{font-size:18px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head p{font-size:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time{min-width:74px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time span{font-size:22px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time small{font-size:8px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment button,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel button{height:46px!important;padding:0 7px!important;font-size:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variants{grid-auto-columns:122px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant{min-width:122px!important;min-height:88px!important;padding:10px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .preview-actions .sub-action{font-size:7.5px!important;gap:5px!important}
}
@media(max-width:360px){
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero{gap:8px!important;padding:11px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head h2{font-size:17px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head p{font-size:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time{min-width:66px!important;padding-left:4px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time span{font-size:20px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .customize-route-kicker{align-items:flex-start!important;flex-direction:column!important;gap:4px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel button{font-size:8px!important;gap:4px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment button{font-size:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment button svg,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel button svg{width:14px!important;height:14px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variants{grid-auto-columns:116px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant{min-width:116px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .preview-actions{gap:5px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .preview-actions .sub-action{height:40px!important;padding:0 4px!important;font-size:7px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .preview-actions .sub-action svg{width:12px!important;height:12px!important}
}
@media(max-height:680px) and (max-width:899px){
  body.vano-app-root:not(.vano-route-onboarding) #planSheet:not(.sheet-collapsed) #routeState.vano-route-studio{max-height:62dvh!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero{margin-bottom:8px!important;padding-top:10px!important;padding-bottom:10px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-customize{margin-bottom:8px!important;padding:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment button,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel button{height:42px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant{min-height:82px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .start-trip-cta.primary{min-height:54px!important}
}
@media(min-width:900px){
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variants{grid-auto-columns:minmax(132px,1fr)!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero{padding:14px 15px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-customize{padding:13px!important}
}
@media(pointer:coarse){
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-customize,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-variant{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
}
@media(prefers-reduced-motion:reduce){
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio *,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio *::before,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio *::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}
}


/* ---- vano-black-polish.css ---- */
/* ============================================================
   VANO — BLACK MODE UI POLISH AUTHORITY
   Final map/application layer. Loaded after every legacy stylesheet.
   Focus: consistent dark surfaces, readable hierarchy, clean controls,
   rebuilt speedometer, and stable route customization UI.
   ============================================================ */

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app{
  --vb-bg:#11110f;
  --vb-surface:#181715;
  --vb-surface-2:#201e1b;
  --vb-surface-3:#292520;
  --vb-surface-glass:rgba(24,23,21,.96);
  --vb-surface-glass-2:rgba(32,30,27,.94);
  --vb-text:#fffaf6;
  --vb-text-2:#e8dfd8;
  --vb-muted:#b8ada5;
  --vb-faint:#8e847d;
  --vb-line:rgba(255,250,246,.10);
  --vb-line-strong:rgba(255,250,246,.17);
  --vb-accent:#F59A62;
  --vb-accent-light:#FFC39B;
  --vb-accent-deep:#D9703F;
  --vb-accent-soft:rgba(245,154,98,.14);
  --vb-shadow:0 18px 46px rgba(0,0,0,.34);
  --vb-shadow-soft:0 9px 24px rgba(0,0,0,.24);
  color:var(--vb-text)!important;
}

/* ---------- generic readable hierarchy inside map ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(
  h1,h2,h3,h4,strong,b,
  .planner-heading-copy b,.planner-section-head b,.planner-preset b,.nearby-service b,
  .route-head h2,.route-time span,.parking-head b,.parking-item b,
  .destination-confirm h3,.resume-trip-head h3,.resume-trip-destination b,.resume-trip-metric b,
  .nav-maneuver-copy b,.nav-summary-item strong,.traffic-suggestion-main b,
  .prefs-head h3,.safety-head h3,.account-drawer b,.quick-alert-head h3,
  .immersive-choice-head h3,.immersive-option b,.permission-copy b
){color:var(--vb-text)!important}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(
  p,small,.disclaimer,.planner-tip,.planner-section-head span,.planner-preset small,.nearby-service small,
  .route-head p,.route-card p,.route-card-meta,.route-ai,.parking-head span,.parking-item span,
  .destination-confirm p,.resume-trip-destination span,.resume-trip-metric small,.resume-trip-age,
  .nav-maneuver-copy small,.nav-summary-item small,.traffic-suggestion-main span,.traffic-suggestion-main small,
  .traffic-radar-copy span,.prefs-foot,.safety-foot,.pref-row>span>span,.safety-tool>span>span,
  .immersive-choice-head p,.immersive-option-copy>span,.permission-copy span,.search-message,.result-meta
){color:var(--vb-muted)!important}

/* ---------- planner / search ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) #planSheet.sheet{
  background:linear-gradient(180deg,rgba(27,25,23,.985),rgba(17,16,15,.99))!important;
  border-color:var(--vb-line)!important;
  box-shadow:0 -14px 48px rgba(0,0,0,.38)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #planSheet .grab,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #planSheet .planner-grab{
  background:rgba(255,250,246,.22)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .planner-weather,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .planner-search-card.search-card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .planner-preset,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .nearby-service,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .search-results{
  background:var(--vb-surface-2)!important;
  color:var(--vb-text)!important;
  border-color:var(--vb-line)!important;
  box-shadow:none!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .planner-search-card.search-card{
  border-radius:18px!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.025)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .planner-search-card .location-input{
  background:transparent!important;
  color:var(--vb-text)!important;
  caret-color:var(--vb-accent)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .planner-search-card .location-input::placeholder{color:var(--vb-faint)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .planner-search-icon{color:var(--vb-accent-light)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.planner-adjust-btn,.planner-search-card .row-btn,.planner-preset-icon,.nearby-service-icon){
  background:var(--vb-surface-3)!important;
  color:var(--vb-text-2)!important;
  border-color:var(--vb-line)!important;
  box-shadow:none!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.planner-adjust-btn,.planner-preset,.nearby-service,.search-item):active{
  background:#302a25!important;
  border-color:rgba(245,154,98,.20)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .search-item{color:var(--vb-text)!important;border-color:rgba(255,250,246,.06)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .search-item:hover{background:rgba(255,255,255,.035)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .result-icon{background:var(--vb-surface-3)!important;border-color:var(--vb-line)!important;color:var(--vb-accent-light)!important}

/* ---------- destination / calculation / resume ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.destination-confirm,.route-loading-card,.resume-trip-card){
  background:linear-gradient(160deg,var(--vb-surface-2),var(--vb-surface))!important;
  color:var(--vb-text)!important;
  border-color:var(--vb-line)!important;
  box-shadow:var(--vb-shadow)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .destination-edit,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .resume-trip-end{
  background:var(--vb-surface-3)!important;
  color:var(--vb-text)!important;
  border-color:var(--vb-line)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) :is(.destination-accept,.resume-trip-continue){
  background:linear-gradient(135deg,var(--vb-accent-light),var(--vb-accent) 48%,var(--vb-accent-deep))!important;
  color:#fff!important;
  border-color:transparent!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .resume-trip-preview,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .resume-trip-metric{
  background:var(--vb-surface-3)!important;
  border-color:var(--vb-line)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .route-loading-spinner{border-color:rgba(255,255,255,.10)!important;border-top-color:var(--vb-accent)!important}

/* ---------- route studio refinements ---------- */
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-option-icon{
  width:31px!important;height:31px!important;flex:0 0 31px!important;
  display:grid!important;place-items:center!important;border-radius:10px!important;
  background:rgba(112,104,97,.075)!important;color:currentColor!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-option-icon svg{width:15px!important;height:15px!important;display:block!important;color:currentColor!important;stroke:currentColor!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-option-copy{
  min-width:0!important;display:flex!important;flex-direction:column!important;align-items:flex-start!important;gap:3px!important;text-align:left!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-option-copy b{font-size:10px!important;line-height:1!important;font-weight:930!important;color:currentColor!important;white-space:nowrap!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-option-copy small{font-size:7px!important;line-height:1!important;font-weight:700!important;color:var(--vr-faint)!important;white-space:nowrap!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment button,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel button{
  justify-content:flex-start!important;
  min-height:54px!important;height:54px!important;
  padding:0 9px!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment button.active .route-option-icon,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel button.active .route-option-icon{
  background:rgba(245,154,98,.18)!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment button.active::after,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel button.active::after{right:9px!important;top:9px!important}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio{
  --vr-text:var(--vb-text)!important;
  --vr-muted:var(--vb-muted)!important;
  --vr-faint:var(--vb-faint)!important;
  --vr-surface:var(--vb-surface)!important;
  --vr-surface-2:var(--vb-surface-2)!important;
  --vr-soft:#2a211c!important;
  --vr-soft-2:#211d1a!important;
  --vr-line:var(--vb-line)!important;
  --vr-line-strong:var(--vb-line-strong)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-customize,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .parking-nearby{
  background:linear-gradient(150deg,var(--vb-surface-2),var(--vb-surface))!important;
  border-color:var(--vb-line)!important;
  box-shadow:var(--vb-shadow-soft)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-choice-label span,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .customize-route-kicker span,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-section-head span{color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-choice-label small,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .customize-route-kicker b,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-section-head small{color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio :is(.segment button,.travel button,.route-variant,.preview-actions .sub-action,.parking-item){
  background:var(--vb-surface-2)!important;
  color:var(--vb-text-2)!important;
  border-color:var(--vb-line)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio :is(.segment button,.travel button) .route-option-copy b{color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio :is(.segment button.active,.travel button.active){
  background:linear-gradient(145deg,rgba(245,154,98,.17),rgba(245,154,98,.09))!important;
  color:var(--vb-accent-light)!important;
  border-color:rgba(245,154,98,.42)!important;
  box-shadow:inset 0 0 0 1px rgba(245,154,98,.04)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio :is(.segment button.active,.travel button.active) .route-option-copy b{color:#fff6ef!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .start-trip-cta.primary{box-shadow:0 14px 30px rgba(217,112,63,.24)!important}

/* ---------- active navigation card ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav.nav-panel.nav-minimal{
  background:linear-gradient(180deg,rgba(30,28,26,.99),rgba(20,19,17,.99))!important;
  color:var(--vb-text)!important;
  border:1px solid var(--vb-line)!important;
  box-shadow:0 -14px 42px rgba(0,0,0,.40)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-row{
  gap:7px!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item{
  background:var(--vb-surface-2)!important;
  border:1px solid var(--vb-line)!important;
  color:var(--vb-text)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.018)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item small{
  color:var(--vb-muted)!important;
  letter-spacing:.08em!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item strong,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item:first-child strong{
  color:var(--vb-text)!important;
  font-variant-numeric:tabular-nums!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-search-btn{
  background:var(--vb-surface-3)!important;
  color:var(--vb-text)!important;
  border-color:var(--vb-line)!important;
  box-shadow:none!important;
}

/* ---------- maneuver / current street ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-top{
  background:linear-gradient(145deg,rgba(31,29,27,.99),rgba(19,18,17,.99))!important;
  color:var(--vb-text)!important;
  border:1px solid var(--vb-line)!important;
  box-shadow:0 14px 36px rgba(0,0,0,.34)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-icon{
  background:linear-gradient(145deg,var(--vb-accent),var(--vb-accent-deep))!important;
  color:#fff!important;
  box-shadow:0 8px 20px rgba(217,112,63,.22)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy b{color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy span{color:var(--vb-accent-light)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-street-chip{
  background:rgba(25,23,21,.97)!important;
  color:var(--vb-text)!important;
  border:1px solid var(--vb-line)!important;
  box-shadow:0 8px 22px rgba(0,0,0,.24)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-street-chip span{color:var(--vb-text)!important}

/* ---------- V187: simple real speedometer ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo{
  --speed-progress:0;
  --speed-angle:0deg;
  --speed-ring:var(--vb-accent-light);
  position:absolute!important;
  left:max(12px,calc(env(safe-area-inset-left) + 10px))!important;
  right:auto!important;
  box-sizing:border-box!important;
  width:76px!important;min-width:76px!important;max-width:76px!important;
  height:76px!important;min-height:76px!important;max-height:76px!important;
  padding:0!important;
  display:grid!important;
  place-items:center!important;
  overflow:hidden!important;
  border:0!important;
  border-radius:50%!important;
  background:rgba(20,19,17,.965)!important;
  color:var(--vb-text)!important;
  box-shadow:0 9px 24px rgba(0,0,0,.30),inset 0 0 0 1px rgba(255,255,255,.055)!important;
  isolation:isolate!important;
  text-align:center!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo .speedo-label,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo .speedo-limit{
  display:none!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo strong{
  position:absolute!important;
  z-index:3!important;
  left:50%!important;
  top:48%!important;
  transform:translate(-50%,-50%)!important;
  display:block!important;
  width:100%!important;
  margin:0!important;
  color:var(--vb-text)!important;
  font-size:29px!important;
  line-height:1!important;
  font-weight:900!important;
  letter-spacing:-1.35px!important;
  font-variant-numeric:tabular-nums!important;
  text-align:center!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo .speedo-unit{
  position:absolute!important;
  z-index:3!important;
  left:50%!important;
  bottom:15px!important;
  transform:translateX(-50%)!important;
  display:block!important;
  margin:0!important;
  color:rgba(255,250,246,.58)!important;
  font-size:6.5px!important;
  line-height:1!important;
  font-weight:850!important;
  letter-spacing:.06em!important;
  text-transform:uppercase!important;
  white-space:nowrap!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo::before{
  content:""!important;
  position:absolute!important;
  z-index:1!important;
  inset:5px!important;
  border-radius:50%!important;
  pointer-events:none!important;
  background:conic-gradient(
    from 210deg,
    var(--speed-ring) 0deg var(--speed-angle),
    rgba(255,250,246,.11) var(--speed-angle) 300deg,
    transparent 300deg 360deg
  )!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo::after{
  content:""!important;
  position:absolute!important;
  z-index:2!important;
  inset:9px!important;
  border-radius:50%!important;
  pointer-events:none!important;
  background:linear-gradient(150deg,rgba(34,31,28,.99),rgba(18,17,16,.99))!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.035)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo.moving{
  box-shadow:0 10px 26px rgba(0,0,0,.32),inset 0 0 0 1px rgba(255,255,255,.065)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo.over-limit{
  --speed-ring:#ff7474;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo.over-limit strong{
  color:#fff!important;
}

/* ---------- right-side control rail ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #navControlStack{
  width:43px!important;min-width:43px!important;max-width:43px!important;
  gap:8px!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app :is(#navDrawerRecenter,#soundBtn,#navCameraToggle,.nav-drawer-toggle,.nav-drawer-btn,.nav-stack-btn,.nav-audio-toggle){
  width:43px!important;min-width:43px!important;max-width:43px!important;
  height:43px!important;min-height:43px!important;max-height:43px!important;
  padding:0!important;
  border-radius:14px!important;
  border:1px solid var(--vb-line)!important;
  background:rgba(29,27,25,.97)!important;
  color:var(--vb-text-2)!important;
  box-shadow:0 7px 18px rgba(0,0,0,.24)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app :is(#soundBtn.active,#navCameraToggle.active,.nav-drawer-btn.active){
  background:linear-gradient(145deg,var(--vb-accent),var(--vb-accent-deep))!important;
  color:#fff!important;
  border-color:rgba(255,195,155,.35)!important;
  box-shadow:0 8px 20px rgba(217,112,63,.22)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #navDrawerRecenter.active{
  background:var(--vb-surface-3)!important;
  color:var(--vb-text)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) .ws-app :is(.options-btn,.map-tools .map-btn,.floating-locate){
  background:rgba(29,27,25,.96)!important;
  color:var(--vb-text-2)!important;
  border:1px solid var(--vb-line)!important;
  box-shadow:0 7px 18px rgba(0,0,0,.24)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) .ws-app :is(.options-btn,.map-tools .map-btn,.floating-locate):active{
  background:var(--vb-surface-3)!important;
  color:var(--vb-text)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) .ws-app .map-tools #focusModeBtn.active{
  background:linear-gradient(145deg,var(--vb-accent),var(--vb-accent-deep))!important;
  color:#fff!important;
  border-color:rgba(255,195,155,.34)!important;
}

/* ---------- small status / live surfaces ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(
  .status-chip,.gps-quality,.traffic-radar,.connectivity-pill,.nav-tracking,
  .nav-immersive-chip,.nav-voice-popover,.nav-alt-hint,.nav-feedback,.traffic-suggestion,.reroute
){
  background:rgba(27,25,23,.97)!important;
  color:var(--vb-text)!important;
  border-color:var(--vb-line)!important;
  box-shadow:var(--vb-shadow-soft)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.status-chip,.gps-quality,.connectivity-pill,.nav-tracking,.nav-immersive-chip) span{color:var(--vb-text-2)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-tracking-copy span{color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-tracking-score{color:var(--vb-accent-light)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-voice-popover select{
  background:var(--vb-surface-3)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .nav-voice-popover button{
  background:var(--vb-accent-soft)!important;color:var(--vb-accent-light)!important;border-color:rgba(245,154,98,.24)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.traffic-dismiss,.nav-alt-dismiss){background:var(--vb-surface-3)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.traffic-accept,.nav-alt-accept){background:linear-gradient(145deg,var(--vb-accent),var(--vb-accent-deep))!important;color:#fff!important;border-color:transparent!important}

/* ---------- drawers / sheets ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.prefs-drawer,.safety-drawer,.account-drawer,.options-drawer,.quick-alert-card,.immersive-choice-card,.guest-limit-card){
  background:linear-gradient(155deg,var(--vb-surface-2),var(--vb-surface))!important;
  color:var(--vb-text)!important;
  border-color:var(--vb-line)!important;
  box-shadow:var(--vb-shadow)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.prefs-close,.safety-close,.guest-drawer-close,.quick-alert-close){
  background:var(--vb-surface-3)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.pref-row,.safety-tool,.drawer-link,.immersive-option){
  background:var(--vb-surface-2)!important;
  color:var(--vb-text)!important;
  border-color:var(--vb-line)!important;
  box-shadow:none!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.pref-row,.safety-tool,.drawer-link,.immersive-option):active{background:var(--vb-surface-3)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .safety-tool svg,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .immersive-option svg{color:var(--vb-accent-light)!important;stroke:var(--vb-accent-light)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .voice-select{background:var(--vb-surface-3)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}

/* ---------- quick alerts ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-backdrop{background:rgba(0,0,0,.46)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-card .quick-alert-grid button{
  background:var(--vb-surface-2)!important;
  color:var(--vb-text)!important;
  border-color:var(--vb-line)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-card .quick-alert-grid button:active{background:var(--vb-surface-3)!important;border-color:rgba(245,154,98,.25)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-label{color:var(--vb-text-2)!important}

/* ---------- permission / guest / error ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .permission{
  background:rgba(24,23,21,.985)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:var(--vb-shadow)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .permission-icon{background:var(--vb-accent-soft)!important;color:var(--vb-accent-light)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .permission button,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .guest-limit-primary{
  background:linear-gradient(145deg,var(--vb-accent),var(--vb-accent-deep))!important;color:#fff!important;border-color:transparent!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.guest-limit-secondary,.guest-limit-later){background:var(--vb-surface-3)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .map-boot-recovery{
  background:rgba(25,23,21,.985)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:var(--vb-shadow)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .map-boot-recovery span{color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .map-boot-recovery button{background:var(--vb-accent)!important;color:#fff!important;border-color:transparent!important}

/* ---------- popups / toast ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .toast,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.place-popup,.place-popup-card){
  background:rgba(24,23,21,.97)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:var(--vb-shadow-soft)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-content{
  background:rgba(24,23,21,.99)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:var(--vb-shadow)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-content *{color:inherit!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-popup-tip{border-top-color:rgba(24,23,21,.99)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-ctrl-group{background:rgba(24,23,21,.94)!important;border-color:var(--vb-line)!important;box-shadow:var(--vb-shadow-soft)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-ctrl-group button{background:transparent!important;color:var(--vb-text)!important}

/* ---------- defeat old day-mode black text while Black theme is selected ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding)[data-mood="day"] .ws-app :is(
  .planner-heading-copy b,.planner-weather span,.location-input,.route-head h2,.route-time span,
  .route-card,.route-card h3,.route-variant b,.route-variant span,.nav-maneuver-copy b,
  .nav-summary-item strong,.floating-speedo strong,.nav-street-chip
){color:var(--vb-text)!important}

/* ---------- responsive polish ---------- */
@media(max-width:430px){
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .segment button,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .travel button{min-height:52px!important;height:52px!important;padding:0 7px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-option-icon{width:29px!important;height:29px!important;flex-basis:29px!important;border-radius:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-option-copy b{font-size:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-option-copy small{font-size:6.5px!important}
}
@media(max-width:380px){
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo{
    left:max(8px,calc(env(safe-area-inset-left) + 6px))!important;
    width:68px!important;min-width:68px!important;max-width:68px!important;
    height:68px!important;min-height:68px!important;max-height:68px!important;
  }
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo strong{font-size:26px!important}
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo .speedo-unit{bottom:13px!important;font-size:6px!important}
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #navControlStack{right:9px!important;width:40px!important;min-width:40px!important;max-width:40px!important}
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app :is(#navDrawerRecenter,#soundBtn,#navCameraToggle,.nav-drawer-toggle,.nav-drawer-btn,.nav-stack-btn,.nav-audio-toggle){width:40px!important;min-width:40px!important;max-width:40px!important;height:40px!important;min-height:40px!important;max-height:40px!important;border-radius:13px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-option-copy small{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-option-icon{width:27px!important;height:27px!important;flex-basis:27px!important}
}
@media(max-height:680px) and (max-width:899px){
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo{
    width:66px!important;min-width:66px!important;max-width:66px!important;
    height:66px!important;min-height:66px!important;max-height:66px!important;
  }
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo strong{font-size:25px!important}
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo .speedo-unit{bottom:12px!important}
}
@media(prefers-reduced-motion:reduce){
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .floating-speedo{scroll-behavior:auto!important}
}

/* ---------- V186 late coverage: secondary flows ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.support-results,.support-item){
  border-color:var(--vb-line)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .support-item{
  background:var(--vb-surface-2)!important;
  color:var(--vb-text)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .support-title,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .support-item span{color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .support-item b{color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .support-item strong{color:#9de1c2!important}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-profile,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.guest-drawer-benefits span,.guest-drawer-secondary,.guest-drawer-continue){
  background:var(--vb-surface-3)!important;
  color:var(--vb-text)!important;
  border-color:var(--vb-line)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .guest-drawer-brand b,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .guest-drawer-content h3{color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .guest-drawer-content>p{color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .guest-drawer-primary{
  background:linear-gradient(145deg,var(--vb-accent),var(--vb-accent-deep))!important;
  color:#fff!important;
  border-color:transparent!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-divider{background:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-avatar{background:var(--vb-surface-3)!important;border-color:var(--vb-line)!important}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .pref-switch{background:#34302c!important;border:1px solid var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .pref-switch::before{background:#aaa099!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .pref-switch:checked{background:var(--vb-accent-deep)!important;border-color:rgba(245,154,98,.38)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .pref-switch:checked::before{background:#fff!important}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.place-popup-save,.place-popup-use){border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .place-popup-save{background:var(--vb-surface-3)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .place-popup-save.saved{background:rgba(245,154,98,.14)!important;color:var(--vb-accent-light)!important;border-color:rgba(245,154,98,.28)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .place-popup-use{background:linear-gradient(145deg,var(--vb-accent),var(--vb-accent-deep))!important;color:#fff!important}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .floating-preview-cancel{
  background:rgba(29,27,25,.97)!important;
  color:var(--vb-text)!important;
  border-color:var(--vb-line)!important;
  box-shadow:0 7px 18px rgba(0,0,0,.24)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .traffic-radar.speed-camera{
  background:rgba(39,22,24,.97)!important;
  color:var(--vb-text)!important;
  border-color:rgba(255,105,115,.34)!important;
}


/* ---- vano-motion.css ---- */
/* VANO — motion/performance + quick community reports.
   Loaded last on purpose: this file owns only the V188 navigation/report surface. */

body.vano-app-root:not(.vano-route-onboarding){
  --v188-accent:#F59A62;
  --v188-accent-strong:#D9703F;
  --v188-ink:#202225;
  --v188-muted:#777b82;
  --v188-line:rgba(32,34,37,.10);
  --v188-card:rgba(255,255,255,.975);
}

/* Quick report FAB: it exists only while navigating. The parent used to be hidden
   by older releases, so V188 re-enables only this child instead of the whole toolbar. */
body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .map-tools{
  opacity:1!important;
  visibility:visible!important;
  pointer-events:none!important;
  top:auto!important;
  right:auto!important;
  left:max(10px,calc(env(safe-area-inset-left) + 8px))!important;
  bottom:max(170px,calc(env(safe-area-inset-bottom) + 166px))!important;
  width:auto!important;
  height:auto!important;
  display:block!important;
  z-index:67!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .map-tools>.map-btn{display:none!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .map-tools>#quickAlertBtn.nav-report-fab{
  pointer-events:auto!important;
  display:flex!important;
  align-items:center!important;
  justify-content:flex-start!important;
  gap:7px!important;
  width:auto!important;
  min-width:48px!important;
  height:48px!important;
  padding:4px 12px 4px 5px!important;
  border:1px solid rgba(42,43,47,.10)!important;
  border-radius:17px!important;
  background:rgba(255,255,255,.965)!important;
  color:#24262a!important;
  box-shadow:0 10px 28px rgba(20,21,24,.14)!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
  font:inherit!important;
  font-size:11px!important;
  font-weight:850!important;
  letter-spacing:-.08px!important;
  overflow:hidden!important;
  transition:transform .14s ease,box-shadow .16s ease,background .16s ease!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #quickAlertBtn.nav-report-fab img{
  width:39px!important;
  height:39px!important;
  flex:0 0 39px!important;
  display:block!important;
  object-fit:contain!important;
  filter:none!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #quickAlertBtn.nav-report-fab:active{transform:scale(.955)!important;box-shadow:0 6px 17px rgba(20,21,24,.12)!important}
body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) .ws-app #quickAlertBtn.nav-report-fab{display:none!important}

/* Report sheet */
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet.quick-alert-v188{z-index:120!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-backdrop{background:rgba(10,11,13,.28)!important;backdrop-filter:blur(2px)!important;-webkit-backdrop-filter:blur(2px)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-card{
  width:min(520px,calc(100% - 18px))!important;
  max-height:min(82dvh,720px)!important;
  padding:7px 12px max(13px,env(safe-area-inset-bottom))!important;
  border:1px solid var(--v188-line)!important;
  border-radius:24px!important;
  background:var(--v188-card)!important;
  color:var(--v188-ink)!important;
  box-shadow:0 22px 60px rgba(23,24,27,.18)!important;
  overflow:auto!important;
  overscroll-behavior:contain!important;
  scrollbar-width:none;
}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-card::-webkit-scrollbar{display:none}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grab{width:34px!important;height:4px!important;margin:1px auto 8px!important;background:rgba(46,47,50,.13)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-head{padding:2px 2px 7px!important;align-items:flex-start!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-head small{font-size:7.5px!important;font-weight:900!important;letter-spacing:.16em!important;color:var(--v188-accent-strong)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-head h3{margin:3px 0 2px!important;font-size:21px!important;line-height:1.05!important;letter-spacing:-.55px!important;color:var(--v188-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-head p{margin:0!important;font-size:10px!important;line-height:1.35!important;color:var(--v188-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-close{width:36px!important;height:36px!important;flex:0 0 36px!important;border:1px solid rgba(40,42,45,.08)!important;border-radius:12px!important;background:#f5f5f6!important;color:#555960!important;box-shadow:none!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-section-label{margin:6px 3px 5px;font-size:7px;font-weight:900;letter-spacing:.14em;color:#96999f}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grid{margin:0!important;display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:7px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grid button{
  min-width:0!important;
  min-height:87px!important;
  padding:8px 5px 7px!important;
  display:flex!important;
  flex-direction:column!important;
  align-items:center!important;
  justify-content:center!important;
  gap:4px!important;
  border:1px solid rgba(36,38,42,.075)!important;
  border-radius:16px!important;
  background:#f7f7f8!important;
  color:#2c2e32!important;
  box-shadow:none!important;
  touch-action:manipulation;
}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grid button:active{transform:scale(.965)!important;background:#f0f0f2!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grid button.sending,
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grid button:disabled{opacity:.55!important;pointer-events:none!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-badge{display:grid!important;place-items:center!important;width:48px!important;height:48px!important;flex:0 0 48px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-art-shell,
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-art-pin{display:block!important;width:48px!important;height:48px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-art-pin{object-fit:contain!important;filter:none!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-badge-shell{width:42px;height:42px;display:grid;place-items:center;border-radius:14px;background:#fff;border:1px solid rgba(45,47,50,.07);box-shadow:0 4px 12px rgba(27,29,32,.055)}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-badge-ring,
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-badge-face{display:grid;place-items:center;width:100%;height:100%}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-badge-icon{display:grid;place-items:center;color:var(--v188-accent-strong)}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-badge-icon .alert-icon-svg{width:25px!important;height:25px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-label{display:block!important;min-height:21px;font-size:9px!important;font-weight:820!important;line-height:1.12!important;letter-spacing:-.08px!important;text-align:center!important;color:#36383d!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-more{margin-top:8px;border-top:1px solid rgba(45,47,50,.075);padding-top:2px}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-more summary{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 4px;list-style:none;cursor:pointer;color:#6f737a;font-size:10px;font-weight:800}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-more summary::-webkit-details-marker{display:none}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-more[open] summary svg{transform:rotate(180deg)}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-secondary{padding-top:2px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-secondary button{min-height:73px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-secondary .quick-alert-badge{width:39px!important;height:39px!important;flex-basis:39px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-secondary .quick-alert-badge-shell{width:38px;height:38px;border-radius:12px}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-secondary .quick-alert-badge-icon .alert-icon-svg{width:22px!important;height:22px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-status{min-height:16px!important;padding-top:7px!important;color:#71757c!important;font-size:9px!important;font-weight:750!important;text-align:center!important}

/* Premium alert art on the actual map. Same visual weight as the arrival marker. */
body.vano-app-root:not(.vano-route-onboarding) .route-marker.alert-marker .alert-premium-art{display:block!important;width:58px!important;height:58px!important;pointer-events:none!important;filter:drop-shadow(0 7px 10px rgba(12,13,15,.20))}
body.vano-app-root:not(.vano-route-onboarding) .route-marker.alert-marker .alert-premium-art img{display:block!important;width:58px!important;height:58px!important;object-fit:contain!important;filter:none!important;transform:none!important}
body.vano-app-root:not(.vano-route-onboarding) .route-marker.alert-marker:active .alert-premium-art{transform:scale(.94)}

/* Black mode */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #quickAlertBtn.nav-report-fab{
  background:rgba(24,23,21,.97)!important;
  color:#fff7f1!important;
  border-color:rgba(255,255,255,.08)!important;
  box-shadow:0 10px 28px rgba(0,0,0,.31)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-backdrop{background:rgba(0,0,0,.52)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-card{background:linear-gradient(180deg,#1d1b19,#151412)!important;color:#fff8f3!important;border-color:rgba(255,255,255,.085)!important;box-shadow:0 25px 70px rgba(0,0,0,.46)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grab{background:rgba(255,255,255,.15)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-head h3{color:#fff8f3!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-head p,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-section-label,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-status{color:#aaa5a0!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-close{background:#282522!important;color:#f7eee8!important;border-color:rgba(255,255,255,.08)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grid button{background:#24211f!important;color:#fff7f1!important;border-color:rgba(255,255,255,.075)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grid button:active{background:#2c2825!important;border-color:rgba(245,154,98,.28)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-label{color:#f5ede7!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-badge-shell{background:#2a2724;border-color:rgba(255,255,255,.07);box-shadow:none}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-more{border-color:rgba(255,255,255,.075)}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-more summary{color:#b8b1ab}

/* Adaptive rendering. These classes are applied by the live frame monitor, not by
   device-name guessing. Under load we remove the expensive glass effects first. */
html.vano-perf-normal body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app :is(.nav-maneuver-top,.nav-street-chip,.nav-panel,.traffic-radar,.nav-voice-popover){backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
html.vano-perf-eco body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.nav-maneuver-top,.nav-street-chip,.nav-panel,.traffic-radar,.nav-voice-popover,.sheet,.destination-confirm,.quick-alert-card,.map-btn){backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
html.vano-perf-eco body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.nav-maneuver-top,.nav-street-chip,.traffic-radar,.nav-panel,.floating-speedo){box-shadow:0 5px 15px rgba(0,0,0,.15)!important}
html.vano-perf-eco body.vano-app-root:not(.vano-route-onboarding) .route-marker.alert-marker .alert-premium-art{filter:none!important}
html.vano-perf-eco body.vano-app-root:not(.vano-route-onboarding) .ws-app *{scroll-behavior:auto!important}

@media(max-width:430px){
  body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .map-tools{bottom:max(162px,calc(env(safe-area-inset-bottom) + 158px))!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .map-tools>#quickAlertBtn.nav-report-fab{height:46px!important;padding:4px 10px 4px 4px!important;border-radius:16px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #quickAlertBtn.nav-report-fab img{width:37px!important;height:37px!important;flex-basis:37px!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-card{left:max(6px,env(safe-area-inset-left))!important;right:max(6px,env(safe-area-inset-right))!important;width:auto!important;padding-inline:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:5px!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grid button{min-height:80px!important;padding:6px 3px!important;border-radius:14px!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-badge,
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-art-shell,
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-art-pin{width:43px!important;height:43px!important;flex-basis:43px!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-label{font-size:8px!important}
}
@media(max-width:360px){
  body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #quickAlertBtn.nav-report-fab span{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .map-tools>#quickAlertBtn.nav-report-fab{width:46px!important;min-width:46px!important;padding:4px!important;justify-content:center!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grid button{min-height:67px!important;flex-direction:row!important;justify-content:flex-start!important;padding:6px 8px!important;gap:7px!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-label{min-height:0!important;text-align:left!important;font-size:9px!important}
}
@media(orientation:landscape) and (max-height:520px){
  body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .map-tools{left:auto!important;right:max(10px,calc(env(safe-area-inset-right) + 8px))!important;bottom:max(12px,env(safe-area-inset-bottom))!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-card{max-width:min(720px,94vw)!important;max-height:92dvh!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important}
}
@media(prefers-reduced-motion:reduce){
  body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #quickAlertBtn.nav-report-fab,
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-v188 .quick-alert-grid button,
body.vano-app-root:not(.vano-route-onboarding) .route-marker.alert-marker .alert-premium-art{transition:none!important}
}


/* ---- vano-maps-production.css ---- */
/* VANO MAPS — production brand layer */
body.vano-app-root:not(.vano-route-onboarding){
  --vano-orange:#f47a31;--vano-orange-2:#ff9b62;--vano-orange-soft:#fff0e5;
  --vano-cream:#fff8f2;--vano-cream-2:#fffdf9;--vano-ink:#171717;--vano-muted:#6f6a66;
  --o:#f47a31!important;--o2:#ffad78!important;--orange:#f47a31!important;--orange-2:#ffad78!important;--orange-3:#ff8a45!important;
}
html body.vano-app-root:not(.vano-route-onboarding),
body.vano-app-root:not(.vano-route-onboarding){accent-color:var(--vano-orange)}
body.vano-app-root:not(.vano-route-onboarding){background:var(--vano-cream)!important;color:var(--vano-ink)}
body.vano-app-root:not(.vano-route-onboarding):before{background:radial-gradient(circle at 12% -8%,rgba(244,122,49,.16),transparent 31%),radial-gradient(circle at 92% 3%,rgba(255,173,120,.12),transparent 28%)!important}
body.vano-app-root:not(.vano-route-onboarding) .topbar{background:rgba(255,248,242,.86)!important;border-bottom:1px solid rgba(37,28,23,.08)!important;box-shadow:0 7px 28px rgba(83,48,28,.045)}
body.vano-app-root:not(.vano-route-onboarding) .brand{gap:9px}body.vano-app-root:not(.vano-route-onboarding) .brand .vano-brand-wordmark{width:148px!important;height:44px!important;object-fit:contain!important;object-position:left center!important;border-radius:11px!important;mix-blend-mode:multiply}body.vano-app-root:not(.vano-route-onboarding) .brand>span{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) .navlinks a,
body.vano-app-root:not(.vano-route-onboarding) .navlinks button.navbtn{color:#625c58!important}body.vano-app-root:not(.vano-route-onboarding) .navlinks a:hover,
body.vano-app-root:not(.vano-route-onboarding) .navlinks button.navbtn:hover,
body.vano-app-root:not(.vano-route-onboarding) .navlinks a.active{background:#fff0e6!important;color:#1d1815!important}
body.vano-app-root:not(.vano-route-onboarding) .btn{background:#fff!important;color:#221b17!important;border-color:rgba(74,54,42,.12)!important;box-shadow:0 5px 18px rgba(77,45,27,.055)}
body.vano-app-root:not(.vano-route-onboarding) .btn-primary{color:#fff!important;background:linear-gradient(135deg,#ff9556,#f47a31)!important;box-shadow:0 10px 25px rgba(244,122,49,.24)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle{width:40px;height:40px;border-radius:13px;border:1px solid rgba(61,43,33,.12);background:#fff;color:#2a211c;display:grid;place-items:center;padding:0;box-shadow:0 6px 18px rgba(70,42,25,.07);position:relative;overflow:hidden}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle span{grid-area:1/1;display:grid;place-items:center;transition:.22s ease}body.vano-app-root:not(.vano-route-onboarding) .vano-theme-moon{opacity:1;transform:scale(1)}body.vano-app-root:not(.vano-route-onboarding) .vano-theme-sun{opacity:0;transform:scale(.75)}
body.vano-app-root:not(.vano-route-onboarding) footer{background:rgba(255,253,249,.82)!important;border-top:1px solid rgba(67,48,37,.08)!important;color:#756d68!important}
body.vano-app-root:not(.vano-route-onboarding) .card,
body.vano-app-root:not(.vano-route-onboarding) .panel,
body.vano-app-root:not(.vano-route-onboarding) .sheet,
body.vano-app-root:not(.vano-route-onboarding) .modal-card,
body.vano-app-root:not(.vano-route-onboarding) .drawer,
body.vano-app-root:not(.vano-route-onboarding) .profile-card,
body.vano-app-root:not(.vano-route-onboarding) .settings-card{border-color:rgba(62,44,33,.09)}
body.vano-app-root:not(.vano-route-onboarding) input,
body.vano-app-root:not(.vano-route-onboarding) select,
body.vano-app-root:not(.vano-route-onboarding) textarea{accent-color:var(--vano-orange)}
body.vano-app-root:not(.vano-route-onboarding) ::selection{background:rgba(244,122,49,.22)}

/* Map UI brand */
body.vano-app-root:not(.vano-route-onboarding) .ws-app{--o:#f47a31!important;--o2:#ffad78!important;--accent:#f47a31!important}
body.vano-app-root:not(.vano-route-onboarding) .route-loading-spinner,
body.vano-app-root:not(.vano-route-onboarding) .loading{border-top-color:#f47a31!important}body.vano-app-root:not(.vano-route-onboarding) .primary,
body.vano-app-root:not(.vano-route-onboarding) .start-trip-cta,
body.vano-app-root:not(.vano-route-onboarding) .destination-accept,
body.vano-app-root:not(.vano-route-onboarding) .traffic-accept,
body.vano-app-root:not(.vano-route-onboarding) .nav-alt-accept{background:linear-gradient(135deg,#ff9453,#f47a31)!important}
body.vano-app-root:not(.vano-route-onboarding) .map-btn.is-black,
body.vano-app-root:not(.vano-route-onboarding) .map-theme-btn.is-black{background:#171717!important;color:#fff!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-trigger img{filter:none!important}

/* Whole-system Black mode */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding),
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding){color-scheme:dark;--bg:#09090a;--surface:#111113;--surface-2:#171719;--surface-3:#202023;--text:#f7f5f3;--muted:#aaa39e;--muted-2:#7e7772;--line:#2a2826;--vano-cream:#09090a;--vano-cream-2:#111113;--vano-ink:#f7f5f3;--vano-muted:#aaa39e}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding),
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding){background:#09090a!important;color:#f7f5f3!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):before,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding):before{background:radial-gradient(circle at 12% -8%,rgba(244,122,49,.11),transparent 29%),radial-gradient(circle at 90% 0%,rgba(255,145,75,.06),transparent 25%)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .topbar,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) .topbar{background:rgba(9,9,10,.84)!important;border-bottom-color:rgba(255,255,255,.065)!important;box-shadow:0 8px 28px rgba(0,0,0,.22)}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .brand .vano-brand-wordmark,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) .brand .vano-brand-wordmark{mix-blend-mode:normal;filter:brightness(1.12) contrast(.96)}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .navlinks a,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) .navlinks a{color:#b8b2ad!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .navlinks a:hover,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .navlinks a.active,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) .navlinks a:hover,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) .navlinks a.active{background:#171719!important;color:#fff!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .btn,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) .btn{background:#171719!important;color:#f7f5f3!important;border-color:#2a2826!important;box-shadow:none}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .btn-primary,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) .btn-primary{background:linear-gradient(135deg,#ff9453,#f47a31)!important;color:#fff!important;border-color:transparent!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle{background:#171719;border-color:#2b2927;color:#fff}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-moon,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-moon{opacity:0;transform:scale(.75)}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-sun,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-sun{opacity:1;transform:scale(1)}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) footer,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) footer{background:#0d0d0e!important;border-top-color:#242426!important;color:#99928d!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) input,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) select,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) textarea,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) input,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) select,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) textarea{background:#151517!important;color:#f7f5f3!important;border-color:#2b2928!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .card,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .panel,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .sheet,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) .card,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) .panel,
html[data-vano-theme-mode="black"] body.vano-app-root:not(.vano-route-onboarding) .sheet{background:#111113!important;color:#f7f5f3!important;border-color:#262426!important}

@media(max-width:720px){body.vano-app-root:not(.vano-route-onboarding) .brand .vano-brand-wordmark{width:118px!important;height:38px!important}body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle{width:38px;height:38px;border-radius:12px}body.vano-app-root:not(.vano-route-onboarding) .nav-actions{gap:6px}}
body.vano-app-root:not(.vano-route-onboarding) .vano-auth-theme-toggle{position:fixed;right:max(14px,env(safe-area-inset-right));top:max(14px,env(safe-area-inset-top));z-index:9999;font-size:18px}


/* ---- vano-design-system.css ---- */
/* VANO MAPS — camera height + speedometer + incident reporting polish
   New work should land here instead of adding another legacy theme layer. */
body.vano-app-root:not(.vano-route-onboarding){
  --vano-accent:#f47a31;
  --vano-accent-strong:#df6523;
  --vano-accent-soft:#fff0e7;
  --vano-danger:#ef4444;
  --vano-success:#16a36a;
  --vano-bg:#f5f6f8;
  --vano-surface:#ffffff;
  --vano-surface-2:#f7f8fa;
  --vano-ink:#17191d;
  --vano-muted:#6c727d;
  --vano-line:rgba(23,25,29,.09);
  --vano-shadow:0 14px 38px rgba(18,21,27,.12);
  --vano-radius-sm:14px;
  --vano-radius:18px;
  --vano-radius-lg:24px;
  --vano-ease:cubic-bezier(.22,.78,.22,1);
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding){
  --vano-bg:#0f1013;
  --vano-surface:#17181c;
  --vano-surface-2:#1e2025;
  --vano-ink:#f7f8fa;
  --vano-muted:#a4a8b0;
  --vano-line:rgba(255,255,255,.085);
  --vano-shadow:0 16px 42px rgba(0,0,0,.32);
  --vano-accent-soft:rgba(244,122,49,.13);
}

/* ===== navigation hierarchy ===== */
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-tracking,
body.vano-app-root:not(.vano-route-onboarding).body-nav .status-chip,
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-immersive-chip,
body.vano-app-root:not(.vano-route-onboarding).body-nav #recenterBtn,
body.vano-app-root:not(.vano-route-onboarding).body-nav #focusModeBtn,
body.vano-app-root:not(.vano-route-onboarding).body-nav #mapThemeBtn{
  display:none!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav .gps-quality{display:none!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .gps-quality.show{
  display:flex!important;
  position:fixed!important;
  z-index:88!important;
  top:max(92px,calc(env(safe-area-inset-top) + 86px))!important;
  left:50%!important;
  transform:translateX(-50%)!important;
  border:1px solid rgba(239,68,68,.16)!important;
  border-radius:999px!important;
  background:rgba(24,25,29,.94)!important;
  color:#fff!important;
  padding:7px 10px!important;
  box-shadow:0 8px 22px rgba(0,0,0,.18)!important;
  font-size:10px!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav .connectivity-pill.show{z-index:89!important}

body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-top{
  position:fixed!important;
  z-index:86!important;
  top:max(10px,calc(env(safe-area-inset-top) + 8px))!important;
  left:max(10px,env(safe-area-inset-left))!important;
  right:max(10px,env(safe-area-inset-right))!important;
  width:auto!important;
  max-width:520px!important;
  min-height:78px!important;
  margin:0 auto!important;
  padding:10px 12px!important;
  display:flex!important;
  align-items:center!important;
  gap:11px!important;
  border:1px solid var(--vano-line)!important;
  border-radius:20px!important;
  background:rgba(255,255,255,.97)!important;
  color:var(--vano-ink)!important;
  box-shadow:var(--vano-shadow)!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
  transform:translateZ(0)!important;
  transition:transform .22s var(--vano-ease),box-shadow .22s ease,border-color .22s ease!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-top{background:rgba(20,21,25,.97)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-icon{
  width:54px!important;height:54px!important;min-width:54px!important;
  display:grid!important;place-items:center!important;
  border-radius:16px!important;background:var(--vano-accent)!important;color:#fff!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav .maneuver-glyph{font-size:31px!important;line-height:1!important;font-weight:900!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy{min-width:0!important;flex:1!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy small{display:none!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy b{display:block!important;font-size:17px!important;line-height:1.13!important;font-weight:900!important;letter-spacing:-.35px!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy span{display:block!important;margin-top:4px!important;font-size:12px!important;font-weight:800!important;color:var(--vano-muted)!important}

/* Large junctions and roundabouts get one visual focus state instead of more UI. */
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-drive-junction .nav-maneuver-top,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-drive-roundabout .nav-maneuver-top{
  border-color:rgba(244,122,49,.38)!important;
  box-shadow:0 16px 42px rgba(21,20,18,.16),0 0 0 4px rgba(244,122,49,.09)!important;
  transform:translateY(1px) scale(1.012)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-drive-junction .nav-maneuver-icon,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-drive-roundabout .nav-maneuver-icon{width:58px!important;height:58px!important;min-width:58px!important;border-radius:18px!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-drive-junction .nav-maneuver-copy b,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-drive-roundabout .nav-maneuver-copy b{font-size:18px!important}

body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-street-chip{
  position:fixed!important;
  z-index:71!important;
  max-width:min(70vw,360px)!important;
  min-height:30px!important;
  padding:7px 11px!important;
  border:1px solid var(--vano-line)!important;
  border-radius:999px!important;
  background:rgba(255,255,255,.95)!important;
  color:var(--vano-ink)!important;
  box-shadow:0 7px 18px rgba(20,22,27,.10)!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
  font-size:10px!important;font-weight:850!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-street-chip{background:rgba(22,23,27,.96)!important}

body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-panel.nav-minimal{
  position:fixed!important;
  z-index:74!important;
  left:max(10px,env(safe-area-inset-left))!important;
  right:max(10px,env(safe-area-inset-right))!important;
  bottom:max(10px,calc(env(safe-area-inset-bottom) + 8px))!important;
  width:auto!important;
  max-width:620px!important;
  margin:0 auto!important;
  padding:8px!important;
  border:1px solid var(--vano-line)!important;
  border-radius:20px!important;
  background:rgba(255,255,255,.97)!important;
  color:var(--vano-ink)!important;
  box-shadow:var(--vano-shadow)!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-panel.nav-minimal{background:rgba(20,21,25,.97)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-summary-row{min-height:54px!important;display:grid!important;grid-template-columns:1.08fr 1fr 1fr 44px!important;gap:5px!important;align-items:stretch!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-summary-item{display:flex!important;flex-direction:column!important;justify-content:center!important;align-items:center!important;border:0!important;background:transparent!important;padding:4px 5px!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-summary-item small{font-size:7px!important;font-weight:850!important;color:var(--vano-muted)!important;letter-spacing:.08em!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-summary-item strong{margin-top:2px!important;font-size:14px!important;font-weight:900!important;letter-spacing:-.25px!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-search-btn{width:44px!important;height:44px!important;align-self:center!important;border:0!important;border-radius:14px!important;background:var(--vano-surface-2)!important;color:var(--vano-ink)!important;box-shadow:none!important}

/* Contextual notices may appear; they are not permanent HUD. */
body.vano-app-root:not(.vano-route-onboarding).body-nav .traffic-radar,
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-alt-hint,
body.vano-app-root:not(.vano-route-onboarding).body-nav .traffic-suggestion,
body.vano-app-root:not(.vano-route-onboarding).body-nav .reroute{
  border:1px solid var(--vano-line)!important;
  box-shadow:0 10px 28px rgba(20,22,27,.12)!important;
  backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
}

/* ===== speedometer V215 ===== */
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.floating-speedo{
  --speed-angle:0deg;
  --speed-progress:0;
  position:fixed!important;
  z-index:79!important;
  left:max(11px,env(safe-area-inset-left))!important;
  right:auto!important;
  width:86px!important;height:86px!important;min-width:86px!important;min-height:86px!important;
  padding:0!important;
  display:grid!important;place-items:center!important;
  border:1px solid rgba(255,255,255,.18)!important;
  border-radius:50%!important;
  overflow:visible!important;
  color:#fff!important;
  background:
    radial-gradient(circle at 50% 50%,transparent 57%,rgba(255,255,255,.08) 58% 59%,transparent 60%),
    repeating-conic-gradient(from 225deg,rgba(255,255,255,.42) 0 1.2deg,transparent 1.2deg 13deg),
    linear-gradient(155deg,#24262c 0%,#121317 62%,#0c0d10 100%)!important;
  box-shadow:0 12px 28px rgba(0,0,0,.24),inset 0 1px 0 rgba(255,255,255,.08)!important;
  transform:translateZ(0)!important;
  transition:box-shadow .18s ease,border-color .18s ease,filter .18s ease!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.floating-speedo::before{
  content:""!important;display:block!important;position:absolute!important;inset:6px!important;z-index:0!important;
  border-radius:50%!important;
  background:
    conic-gradient(from 225deg,var(--vano-accent) 0 var(--speed-angle),rgba(255,255,255,.07) var(--speed-angle) 270deg,transparent 270deg 360deg)!important;
  -webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 2px))!important;
  mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 2px))!important;
  opacity:.92!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.floating-speedo::after{
  content:""!important;display:block!important;position:absolute!important;z-index:1!important;
  width:3px!important;height:22px!important;left:50%!important;top:21px!important;
  border-radius:999px!important;
  background:linear-gradient(to top,rgba(244,122,49,.18),#f47a31)!important;
  box-shadow:0 0 8px rgba(244,122,49,.23)!important;
  transform-origin:50% 22px!important;
  transform:translateX(-50%) rotate(calc(-135deg + var(--speed-angle)))!important;
  transition:transform .18s cubic-bezier(.2,.75,.25,1)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo .speedo-label{display:none!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo #floatingSpeedValue{
  position:relative!important;z-index:3!important;display:block!important;margin:4px 0 0!important;padding:0!important;
  min-width:54px!important;text-align:center!important;
  font-size:31px!important;line-height:.92!important;font-weight:950!important;letter-spacing:-1.7px!important;
  font-variant-numeric:tabular-nums!important;color:#fff!important;text-shadow:0 1px 8px rgba(0,0,0,.18)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo .speedo-unit{
  position:absolute!important;z-index:3!important;left:50%!important;bottom:12px!important;transform:translateX(-50%)!important;
  font-size:6.5px!important;line-height:1!important;font-weight:850!important;letter-spacing:.12em!important;text-transform:uppercase!important;color:rgba(255,255,255,.56)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo .speedo-limit{
  position:absolute!important;z-index:6!important;right:-7px!important;top:-6px!important;
  width:31px!important;height:31px!important;min-width:31px!important;min-height:31px!important;padding:0!important;
  display:grid!important;place-items:center!important;border-radius:50%!important;border:3px solid #e43d45!important;
  background:#fff!important;color:#141518!important;font-size:10px!important;line-height:1!important;font-weight:950!important;font-style:normal!important;
  box-shadow:0 5px 13px rgba(0,0,0,.24)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.near-limit{border-color:rgba(244,122,49,.50)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.over-limit{
  border-color:rgba(239,68,68,.76)!important;
  box-shadow:0 12px 28px rgba(0,0,0,.25),0 0 0 4px rgba(239,68,68,.13)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.over-limit::before{
  background:conic-gradient(from 225deg,var(--vano-danger) 0 var(--speed-angle),rgba(239,68,68,.11) var(--speed-angle) 270deg,transparent 270deg 360deg)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.over-limit::after{background:linear-gradient(to top,rgba(239,68,68,.18),#ef4444)!important;box-shadow:0 0 9px rgba(239,68,68,.28)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.over-limit #floatingSpeedValue{color:#ff9499!important}

/* ===== right controls ===== */
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-control-stack{
  position:fixed!important;z-index:78!important;
  right:max(11px,env(safe-area-inset-right))!important;
  display:flex!important;flex-direction:column!important;align-items:center!important;gap:7px!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-stack-btn,
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-audio-toggle,
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-drawer-toggle,
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-drawer-btn{
  width:46px!important;height:46px!important;min-width:46px!important;min-height:46px!important;padding:0!important;
  display:grid!important;place-items:center!important;border:1px solid var(--vano-line)!important;border-radius:15px!important;
  background:rgba(255,255,255,.97)!important;color:#565c66!important;box-shadow:0 8px 20px rgba(20,22,27,.12)!important;
  backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
  transition:transform .13s ease,background .16s ease,color .16s ease,box-shadow .16s ease!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav :is(.nav-stack-btn,.nav-audio-toggle,.nav-drawer-toggle,.nav-drawer-btn){background:#18191d!important;color:#e4e6ea!important;border-color:rgba(255,255,255,.08)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav :is(.nav-stack-btn,.nav-audio-toggle,.nav-drawer-toggle,.nav-drawer-btn):active{transform:scale(.94)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-audio-toggle.active{color:var(--vano-accent)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav #quickAlertBtn.nav-report-main{
  display:grid!important;visibility:visible!important;pointer-events:auto!important;position:relative!important;
  width:48px!important;height:48px!important;min-width:48px!important;min-height:48px!important;
  border-radius:16px!important;border:1px solid rgba(222,61,70,.18)!important;
  background:#fff4f4!important;color:#df3e47!important;
  box-shadow:0 9px 22px rgba(92,24,29,.12)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #quickAlertBtn.nav-report-main::after{content:""!important;position:absolute!important;width:6px!important;height:6px!important;border-radius:50%!important;background:#e43d45!important;right:7px!important;top:7px!important;box-shadow:0 0 0 3px rgba(228,61,69,.10)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #quickAlertBtn.nav-report-main{background:#2a181b!important;color:#ff747d!important;border-color:rgba(255,116,125,.20)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav #navDrawerRecenter.calibrating{box-shadow:0 0 0 5px rgba(244,122,49,.12),0 9px 23px rgba(20,22,27,.15)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav #navDrawerRecenter.calibrating i{animation:vano-calibrate-v214 1.05s var(--vano-ease) both!important;transform-origin:50% 50%!important}
@keyframes vano-calibrate-v214{0%{transform:rotate(0deg) scale(1)}45%{transform:rotate(175deg) scale(.90)}78%{transform:rotate(330deg) scale(1.08)}100%{transform:rotate(360deg) scale(1)}}

/* Launch removes the impression of a camera teleport. */
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .nav-maneuver-top,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .nav-panel,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .nav-control-stack,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .floating-speedo{animation:vano-hud-in-v214 .62s var(--vano-ease) both!important}
@keyframes vano-hud-in-v214{0%{opacity:0;transform:translateY(8px) scale(.985)}45%{opacity:.35}100%{opacity:1;transform:translateY(0) scale(1)}}

/* ===== route ready ===== */
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready{
  padding:2px 0 max(16px,env(safe-area-inset-bottom))!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .vano-route-hero{
  padding:4px 2px 8px!important;margin:0!important;background:transparent!important;border:0!important;box-shadow:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .route-head{display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;gap:14px!important;align-items:start!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .vr-eyebrow{font-size:8px!important;font-weight:900!important;letter-spacing:.12em!important;color:var(--vano-accent)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .vr-copy h2{margin:4px 0 4px!important;font-size:25px!important;line-height:1.03!important;letter-spacing:-.8px!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .vr-copy p{margin:0!important;font-size:11px!important;line-height:1.35!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .route-time{min-width:86px!important;text-align:right!important;padding-top:2px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .route-time span{display:block!important;font-size:27px!important;line-height:1!important;font-weight:950!important;letter-spacing:-1px!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .route-time small{display:block!important;margin-top:4px!important;font-size:10px!important;font-weight:800!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-decision{display:inline-flex!important;align-items:center!important;gap:5px!important;margin-top:8px!important;padding:6px 8px!important;border-radius:999px!important;background:var(--vano-accent-soft)!important;color:var(--vano-accent-strong)!important;font-size:9px!important;font-weight:850!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-mode-row{margin:8px 0 12px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-mode-row .segment{display:grid!important;grid-template-columns:1fr 1fr!important;gap:7px!important;padding:4px!important;border:1px solid var(--vano-line)!important;border-radius:17px!important;background:var(--vano-surface-2)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-mode-row .segment button{min-height:48px!important;border:0!important;border-radius:13px!important;background:transparent!important;color:var(--vano-muted)!important;box-shadow:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-mode-row .segment button.active{background:var(--vano-surface)!important;color:var(--vano-ink)!important;box-shadow:0 5px 14px rgba(20,22,27,.08)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-mode-row .segment button.active.fast{color:var(--vano-accent-strong)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-alternatives-head{margin:2px 1px 7px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .route-variants{display:flex!important;gap:8px!important;overflow-x:auto!important;overscroll-behavior-x:contain!important;scroll-snap-type:x proximity!important;padding:0 1px 3px!important;scrollbar-width:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .route-variants::-webkit-scrollbar{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .route-variant{flex:0 0 min(158px,43vw)!important;min-height:72px!important;padding:9px 10px!important;border:1px solid var(--vano-line)!important;border-radius:16px!important;background:var(--vano-surface)!important;color:var(--vano-ink)!important;box-shadow:none!important;scroll-snap-align:start!important;text-align:left!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .route-variant.active{border-color:rgba(244,122,49,.42)!important;background:var(--vano-accent-soft)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .start-trip-cta{width:100%!important;min-height:60px!important;margin:11px 0 9px!important;border:0!important;border-radius:18px!important;background:linear-gradient(135deg,#ff9453,var(--vano-accent))!important;color:#fff!important;box-shadow:0 12px 25px rgba(244,122,49,.24)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .start-trip-copy b{font-size:16px!important;font-weight:900!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .start-trip-copy small{font-size:9px!important;color:rgba(255,255,255,.82)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more{margin:0!important;border:1px solid var(--vano-line)!important;border-radius:16px!important;background:var(--vano-surface)!important;overflow:hidden!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more>summary{list-style:none!important;min-height:48px!important;padding:0 12px!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;color:var(--vano-ink)!important;font-size:11px!important;font-weight:850!important;cursor:pointer!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more>summary::-webkit-details-marker{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more>summary span{display:flex!important;align-items:center!important;gap:7px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more[open]>summary>svg:last-child{transform:rotate(180deg)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more-content{padding:0 10px 10px!important;display:grid!important;gap:9px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more .vr-control-block,
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more .route-card,
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more .parking-nearby{border:1px solid var(--vano-line)!important;border-radius:15px!important;background:var(--vano-surface-2)!important;box-shadow:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .preview-actions{display:grid!important;grid-template-columns:repeat(3,1fr)!important;gap:6px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .preview-actions .sub-action{min-width:0!important;min-height:40px!important;border:1px solid var(--vano-line)!important;border-radius:12px!important;background:var(--vano-surface-2)!important;color:var(--vano-ink)!important;box-shadow:none!important;font-size:9px!important}

/* ===== incident reporting V215 ===== */
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet.vano-incident-sheet{position:fixed!important;inset:0!important;z-index:130!important;display:none!important;align-items:flex-end!important;justify-content:center!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet.vano-incident-sheet.show{display:flex!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet.vano-incident-sheet .quick-alert-backdrop{position:absolute!important;inset:0!important;border:0!important;background:rgba(10,11,14,.48)!important;backdrop-filter:blur(3px)!important;-webkit-backdrop-filter:blur(3px)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet.vano-incident-sheet .quick-alert-card{position:relative!important;z-index:1!important;width:min(570px,calc(100% - 12px))!important;margin:0 6px max(6px,env(safe-area-inset-bottom))!important;padding:10px 12px 13px!important;border:1px solid var(--vano-line)!important;border-radius:26px!important;background:var(--vano-surface)!important;color:var(--vano-ink)!important;box-shadow:0 26px 78px rgba(0,0,0,.32)!important;transform:translateY(20px)!important;animation:vano-sheet-up-v215 .25s var(--vano-ease) forwards!important}
@keyframes vano-sheet-up-v215{to{transform:translateY(0)}}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-handle{width:38px!important;height:4px!important;margin:0 auto 10px!important;border-radius:999px!important;background:rgba(120,126,136,.24)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-head{display:flex!important;align-items:flex-start!important;justify-content:space-between!important;gap:12px!important;margin-bottom:12px!important;padding:0 2px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-head small{display:block!important;font-size:8px!important;font-weight:900!important;letter-spacing:.12em!important;color:#df3e47!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-head h3{margin:3px 0 3px!important;font-size:20px!important;line-height:1.08!important;letter-spacing:-.55px!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-head p{margin:0!important;font-size:10px!important;line-height:1.3!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-close{width:38px!important;height:38px!important;min-width:38px!important;display:grid!important;place-items:center!important;border:1px solid var(--vano-line)!important;border-radius:13px!important;background:var(--vano-surface-2)!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid button{position:relative!important;min-height:64px!important;padding:8px 9px!important;display:grid!important;grid-template-columns:38px minmax(0,1fr)!important;align-items:center!important;justify-content:stretch!important;gap:9px!important;border:1px solid var(--vano-line)!important;border-radius:16px!important;background:var(--vano-surface-2)!important;color:var(--vano-ink)!important;box-shadow:none!important;text-align:left!important;transition:transform .13s ease,border-color .16s ease,background .16s ease!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid button:active{transform:scale(.97)!important;background:#fff4f4!important;border-color:rgba(228,61,69,.18)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid button.sending{opacity:.58!important;transform:scale(.98)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-premium-icon{width:38px!important;height:38px!important;display:grid!important;place-items:center!important;border-radius:13px!important;background:#fff0f1!important;color:#df3e47!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-premium-icon{background:rgba(255,104,116,.10)!important;color:#ff747d!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-copy{min-width:0!important;display:flex!important;flex-direction:column!important;gap:2px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-copy b{font-size:10.5px!important;line-height:1.1!important;font-weight:900!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-copy small{font-size:8px!important;line-height:1.15!important;font-weight:700!important;color:var(--vano-muted)!important;white-space:normal!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-status{min-height:18px!important;padding-top:8px!important;text-align:center!important;font-size:9px!important;line-height:1.2!important;font-weight:800!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-foot{display:flex!important;align-items:center!important;justify-content:center!important;gap:5px!important;margin-top:1px!important;font-size:8px!important;font-weight:700!important;color:var(--vano-muted)!important}
@media(max-width:370px){body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid{grid-template-columns:1fr!important}body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid button{min-height:55px!important}}

/* ===== arrival ===== */
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival{position:fixed!important;inset:0!important;z-index:122!important;display:none!important;align-items:flex-end!important;justify-content:center!important;pointer-events:none!important;background:linear-gradient(to top,rgba(8,10,12,.24),transparent 50%)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival.show{display:flex!important;pointer-events:auto!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-card{width:min(560px,calc(100% - 18px))!important;margin:0 9px max(10px,env(safe-area-inset-bottom))!important;padding:18px!important;border:1px solid var(--vano-line)!important;border-radius:26px!important;background:var(--vano-surface)!important;color:var(--vano-ink)!important;box-shadow:0 26px 70px rgba(0,0,0,.28)!important;animation:vano-arrive-v214 .44s var(--vano-ease) both!important}
@keyframes vano-arrive-v214{0%{opacity:0;transform:translateY(26px) scale(.97)}100%{opacity:1;transform:translateY(0) scale(1)}}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-mark{width:48px!important;height:48px!important;margin-bottom:10px!important;display:grid!important;place-items:center!important;border-radius:16px!important;background:var(--vano-accent-soft)!important;color:var(--vano-accent-strong)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-card>small{font-size:8px!important;font-weight:900!important;letter-spacing:.14em!important;color:var(--vano-accent)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-card h2{margin:4px 0 5px!important;font-size:24px!important;line-height:1.05!important;letter-spacing:-.7px!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-card p{margin:0 0 14px!important;font-size:11px!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-actions{display:grid!important;grid-template-columns:1fr 1.15fr!important;gap:8px!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-actions button{min-height:50px!important;border-radius:15px!important;font-size:11px!important;font-weight:900!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-actions .arrival-secondary{display:flex!important;align-items:center!important;justify-content:center!important;gap:6px!important;border:1px solid var(--vano-line)!important;background:var(--vano-surface-2)!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-actions .arrival-primary{border:0!important;background:var(--vano-accent)!important;color:#fff!important;box-shadow:0 9px 22px rgba(244,122,49,.22)!important}
body.vano-app-root:not(.vano-route-onboarding).nav-arrived :is(.nav-maneuver-top,.nav-street-chip,.nav-panel,.floating-speedo,.nav-control-stack,.traffic-radar,.nav-alt-hint){opacity:0!important;pointer-events:none!important;transform:translateY(8px)!important;transition:opacity .2s ease,transform .2s ease!important}

@media(max-width:390px){
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-top{left:max(7px,env(safe-area-inset-left))!important;right:max(7px,env(safe-area-inset-right))!important;min-height:72px!important;padding:8px 9px!important;border-radius:18px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-icon{width:50px!important;height:50px!important;min-width:50px!important;border-radius:15px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy b{font-size:15px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.floating-speedo{left:max(8px,env(safe-area-inset-left))!important;width:80px!important;height:80px!important;min-width:80px!important;min-height:80px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo #floatingSpeedValue{font-size:29px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-control-stack{right:max(8px,env(safe-area-inset-right))!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav :is(.nav-stack-btn,.nav-audio-toggle,.nav-drawer-toggle,.nav-drawer-btn){width:43px!important;height:43px!important;min-width:43px!important;min-height:43px!important;border-radius:14px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-summary-row{grid-template-columns:1fr .92fr .92fr 42px!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid button{min-height:66px!important;flex-direction:row!important;justify-content:flex-start!important;text-align:left!important;padding:8px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .vr-copy h2{font-size:22px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .route-time span{font-size:24px!important}
}

@media(orientation:landscape) and (max-height:520px){
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-top{left:max(8px,env(safe-area-inset-left))!important;right:auto!important;width:min(390px,55vw)!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-panel.nav-minimal{left:max(8px,env(safe-area-inset-left))!important;right:auto!important;width:min(470px,58vw)!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-card{width:min(520px,62vw)!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet.vano-incident-sheet .quick-alert-card{width:min(680px,82vw)!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important}
}

@media(prefers-reduced-motion:reduce){
  body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .nav-maneuver-top,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .nav-panel,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .nav-control-stack,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .floating-speedo,
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-card,
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet.vano-incident-sheet .quick-alert-card{animation:none!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #navDrawerRecenter.calibrating i{animation:none!important}
}


/* V215 design system */
/* VANO MAPS — camera height + speedometer + incident reporting polish
   New work should land here instead of adding another legacy theme layer. */
body.vano-app-root:not(.vano-route-onboarding){
  --vano-accent:#f47a31;
  --vano-accent-strong:#df6523;
  --vano-accent-soft:#fff0e7;
  --vano-danger:#ef4444;
  --vano-success:#16a36a;
  --vano-bg:#f5f6f8;
  --vano-surface:#ffffff;
  --vano-surface-2:#f7f8fa;
  --vano-ink:#17191d;
  --vano-muted:#6c727d;
  --vano-line:rgba(23,25,29,.09);
  --vano-shadow:0 14px 38px rgba(18,21,27,.12);
  --vano-radius-sm:14px;
  --vano-radius:18px;
  --vano-radius-lg:24px;
  --vano-ease:cubic-bezier(.22,.78,.22,1);
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding){
  --vano-bg:#0f1013;
  --vano-surface:#17181c;
  --vano-surface-2:#1e2025;
  --vano-ink:#f7f8fa;
  --vano-muted:#a4a8b0;
  --vano-line:rgba(255,255,255,.085);
  --vano-shadow:0 16px 42px rgba(0,0,0,.32);
  --vano-accent-soft:rgba(244,122,49,.13);
}

/* ===== navigation hierarchy ===== */
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-tracking,
body.vano-app-root:not(.vano-route-onboarding).body-nav .status-chip,
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-immersive-chip,
body.vano-app-root:not(.vano-route-onboarding).body-nav #recenterBtn,
body.vano-app-root:not(.vano-route-onboarding).body-nav #focusModeBtn,
body.vano-app-root:not(.vano-route-onboarding).body-nav #mapThemeBtn{
  display:none!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav .gps-quality{display:none!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .gps-quality.show{
  display:flex!important;
  position:fixed!important;
  z-index:88!important;
  top:max(92px,calc(env(safe-area-inset-top) + 86px))!important;
  left:50%!important;
  transform:translateX(-50%)!important;
  border:1px solid rgba(239,68,68,.16)!important;
  border-radius:999px!important;
  background:rgba(24,25,29,.94)!important;
  color:#fff!important;
  padding:7px 10px!important;
  box-shadow:0 8px 22px rgba(0,0,0,.18)!important;
  font-size:10px!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav .connectivity-pill.show{z-index:89!important}

body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-top{
  position:fixed!important;
  z-index:86!important;
  top:max(10px,calc(env(safe-area-inset-top) + 8px))!important;
  left:max(10px,env(safe-area-inset-left))!important;
  right:max(10px,env(safe-area-inset-right))!important;
  width:auto!important;
  max-width:520px!important;
  min-height:78px!important;
  margin:0 auto!important;
  padding:10px 12px!important;
  display:flex!important;
  align-items:center!important;
  gap:11px!important;
  border:1px solid var(--vano-line)!important;
  border-radius:20px!important;
  background:rgba(255,255,255,.97)!important;
  color:var(--vano-ink)!important;
  box-shadow:var(--vano-shadow)!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
  transform:translateZ(0)!important;
  transition:transform .22s var(--vano-ease),box-shadow .22s ease,border-color .22s ease!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-top{background:rgba(20,21,25,.97)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-icon{
  width:54px!important;height:54px!important;min-width:54px!important;
  display:grid!important;place-items:center!important;
  border-radius:16px!important;background:var(--vano-accent)!important;color:#fff!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav .maneuver-glyph{font-size:31px!important;line-height:1!important;font-weight:900!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy{min-width:0!important;flex:1!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy small{display:none!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy b{display:block!important;font-size:17px!important;line-height:1.13!important;font-weight:900!important;letter-spacing:-.35px!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy span{display:block!important;margin-top:4px!important;font-size:12px!important;font-weight:800!important;color:var(--vano-muted)!important}

/* Large junctions and roundabouts get one visual focus state instead of more UI. */
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-drive-junction .nav-maneuver-top,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-drive-roundabout .nav-maneuver-top{
  border-color:rgba(244,122,49,.38)!important;
  box-shadow:0 16px 42px rgba(21,20,18,.16),0 0 0 4px rgba(244,122,49,.09)!important;
  transform:translateY(1px) scale(1.012)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-drive-junction .nav-maneuver-icon,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-drive-roundabout .nav-maneuver-icon{width:58px!important;height:58px!important;min-width:58px!important;border-radius:18px!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-drive-junction .nav-maneuver-copy b,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-drive-roundabout .nav-maneuver-copy b{font-size:18px!important}

body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-street-chip{
  position:fixed!important;
  z-index:71!important;
  max-width:min(70vw,360px)!important;
  min-height:30px!important;
  padding:7px 11px!important;
  border:1px solid var(--vano-line)!important;
  border-radius:999px!important;
  background:rgba(255,255,255,.95)!important;
  color:var(--vano-ink)!important;
  box-shadow:0 7px 18px rgba(20,22,27,.10)!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
  font-size:10px!important;font-weight:850!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-street-chip{background:rgba(22,23,27,.96)!important}

body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-panel.nav-minimal{
  position:fixed!important;
  z-index:74!important;
  left:max(10px,env(safe-area-inset-left))!important;
  right:max(10px,env(safe-area-inset-right))!important;
  bottom:max(10px,calc(env(safe-area-inset-bottom) + 8px))!important;
  width:auto!important;
  max-width:620px!important;
  margin:0 auto!important;
  padding:8px!important;
  border:1px solid var(--vano-line)!important;
  border-radius:20px!important;
  background:rgba(255,255,255,.97)!important;
  color:var(--vano-ink)!important;
  box-shadow:var(--vano-shadow)!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-panel.nav-minimal{background:rgba(20,21,25,.97)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-summary-row{min-height:54px!important;display:grid!important;grid-template-columns:1.08fr 1fr 1fr 44px!important;gap:5px!important;align-items:stretch!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-summary-item{display:flex!important;flex-direction:column!important;justify-content:center!important;align-items:center!important;border:0!important;background:transparent!important;padding:4px 5px!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-summary-item small{font-size:7px!important;font-weight:850!important;color:var(--vano-muted)!important;letter-spacing:.08em!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-summary-item strong{margin-top:2px!important;font-size:14px!important;font-weight:900!important;letter-spacing:-.25px!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-search-btn{width:44px!important;height:44px!important;align-self:center!important;border:0!important;border-radius:14px!important;background:var(--vano-surface-2)!important;color:var(--vano-ink)!important;box-shadow:none!important}

/* Contextual notices may appear; they are not permanent HUD. */
body.vano-app-root:not(.vano-route-onboarding).body-nav .traffic-radar,
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-alt-hint,
body.vano-app-root:not(.vano-route-onboarding).body-nav .traffic-suggestion,
body.vano-app-root:not(.vano-route-onboarding).body-nav .reroute{
  border:1px solid var(--vano-line)!important;
  box-shadow:0 10px 28px rgba(20,22,27,.12)!important;
  backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
}

/* ===== speedometer V215 ===== */
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.floating-speedo{
  --speed-angle:0deg;
  --speed-progress:0;
  position:fixed!important;
  z-index:79!important;
  left:max(11px,env(safe-area-inset-left))!important;
  right:auto!important;
  width:86px!important;height:86px!important;min-width:86px!important;min-height:86px!important;
  padding:0!important;
  display:grid!important;place-items:center!important;
  border:1px solid rgba(255,255,255,.18)!important;
  border-radius:50%!important;
  overflow:visible!important;
  color:#fff!important;
  background:
    radial-gradient(circle at 50% 50%,transparent 57%,rgba(255,255,255,.08) 58% 59%,transparent 60%),
    repeating-conic-gradient(from 225deg,rgba(255,255,255,.42) 0 1.2deg,transparent 1.2deg 13deg),
    linear-gradient(155deg,#24262c 0%,#121317 62%,#0c0d10 100%)!important;
  box-shadow:0 12px 28px rgba(0,0,0,.24),inset 0 1px 0 rgba(255,255,255,.08)!important;
  transform:translateZ(0)!important;
  transition:box-shadow .18s ease,border-color .18s ease,filter .18s ease!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.floating-speedo::before{
  content:""!important;display:block!important;position:absolute!important;inset:6px!important;z-index:0!important;
  border-radius:50%!important;
  background:
    conic-gradient(from 225deg,var(--vano-accent) 0 var(--speed-angle),rgba(255,255,255,.07) var(--speed-angle) 270deg,transparent 270deg 360deg)!important;
  -webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 2px))!important;
  mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 2px))!important;
  opacity:.92!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.floating-speedo::after{
  content:""!important;display:block!important;position:absolute!important;z-index:1!important;
  width:3px!important;height:22px!important;left:50%!important;top:21px!important;
  border-radius:999px!important;
  background:linear-gradient(to top,rgba(244,122,49,.18),#f47a31)!important;
  box-shadow:0 0 8px rgba(244,122,49,.23)!important;
  transform-origin:50% 22px!important;
  transform:translateX(-50%) rotate(calc(-135deg + var(--speed-angle)))!important;
  transition:transform .18s cubic-bezier(.2,.75,.25,1)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo .speedo-label{display:none!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo #floatingSpeedValue{
  position:relative!important;z-index:3!important;display:block!important;margin:4px 0 0!important;padding:0!important;
  min-width:54px!important;text-align:center!important;
  font-size:31px!important;line-height:.92!important;font-weight:950!important;letter-spacing:-1.7px!important;
  font-variant-numeric:tabular-nums!important;color:#fff!important;text-shadow:0 1px 8px rgba(0,0,0,.18)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo .speedo-unit{
  position:absolute!important;z-index:3!important;left:50%!important;bottom:12px!important;transform:translateX(-50%)!important;
  font-size:6.5px!important;line-height:1!important;font-weight:850!important;letter-spacing:.12em!important;text-transform:uppercase!important;color:rgba(255,255,255,.56)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo .speedo-limit{
  position:absolute!important;z-index:6!important;right:-7px!important;top:-6px!important;
  width:31px!important;height:31px!important;min-width:31px!important;min-height:31px!important;padding:0!important;
  display:grid!important;place-items:center!important;border-radius:50%!important;border:3px solid #e43d45!important;
  background:#fff!important;color:#141518!important;font-size:10px!important;line-height:1!important;font-weight:950!important;font-style:normal!important;
  box-shadow:0 5px 13px rgba(0,0,0,.24)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.near-limit{border-color:rgba(244,122,49,.50)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.over-limit{
  border-color:rgba(239,68,68,.76)!important;
  box-shadow:0 12px 28px rgba(0,0,0,.25),0 0 0 4px rgba(239,68,68,.13)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.over-limit::before{
  background:conic-gradient(from 225deg,var(--vano-danger) 0 var(--speed-angle),rgba(239,68,68,.11) var(--speed-angle) 270deg,transparent 270deg 360deg)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.over-limit::after{background:linear-gradient(to top,rgba(239,68,68,.18),#ef4444)!important;box-shadow:0 0 9px rgba(239,68,68,.28)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.over-limit #floatingSpeedValue{color:#ff9499!important}

/* ===== right controls ===== */
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-control-stack{
  position:fixed!important;z-index:78!important;
  right:max(11px,env(safe-area-inset-right))!important;
  display:flex!important;flex-direction:column!important;align-items:center!important;gap:7px!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-stack-btn,
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-audio-toggle,
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-drawer-toggle,
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-drawer-btn{
  width:46px!important;height:46px!important;min-width:46px!important;min-height:46px!important;padding:0!important;
  display:grid!important;place-items:center!important;border:1px solid var(--vano-line)!important;border-radius:15px!important;
  background:rgba(255,255,255,.97)!important;color:#565c66!important;box-shadow:0 8px 20px rgba(20,22,27,.12)!important;
  backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
  transition:transform .13s ease,background .16s ease,color .16s ease,box-shadow .16s ease!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav :is(.nav-stack-btn,.nav-audio-toggle,.nav-drawer-toggle,.nav-drawer-btn){background:#18191d!important;color:#e4e6ea!important;border-color:rgba(255,255,255,.08)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav :is(.nav-stack-btn,.nav-audio-toggle,.nav-drawer-toggle,.nav-drawer-btn):active{transform:scale(.94)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-audio-toggle.active{color:var(--vano-accent)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav #quickAlertBtn.nav-report-main{
  display:grid!important;visibility:visible!important;pointer-events:auto!important;position:relative!important;
  width:48px!important;height:48px!important;min-width:48px!important;min-height:48px!important;
  border-radius:16px!important;border:1px solid rgba(222,61,70,.18)!important;
  background:#fff4f4!important;color:#df3e47!important;
  box-shadow:0 9px 22px rgba(92,24,29,.12)!important;
}
body.vano-app-root:not(.vano-route-onboarding).body-nav #quickAlertBtn.nav-report-main::after{content:""!important;position:absolute!important;width:6px!important;height:6px!important;border-radius:50%!important;background:#e43d45!important;right:7px!important;top:7px!important;box-shadow:0 0 0 3px rgba(228,61,69,.10)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #quickAlertBtn.nav-report-main{background:#2a181b!important;color:#ff747d!important;border-color:rgba(255,116,125,.20)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav #navDrawerRecenter.calibrating{box-shadow:0 0 0 5px rgba(244,122,49,.12),0 9px 23px rgba(20,22,27,.15)!important}
body.vano-app-root:not(.vano-route-onboarding).body-nav #navDrawerRecenter.calibrating i{animation:vano-calibrate-v214 1.05s var(--vano-ease) both!important;transform-origin:50% 50%!important}
@keyframes vano-calibrate-v214{0%{transform:rotate(0deg) scale(1)}45%{transform:rotate(175deg) scale(.90)}78%{transform:rotate(330deg) scale(1.08)}100%{transform:rotate(360deg) scale(1)}}

/* Launch removes the impression of a camera teleport. */
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .nav-maneuver-top,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .nav-panel,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .nav-control-stack,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .floating-speedo{animation:vano-hud-in-v214 .62s var(--vano-ease) both!important}
@keyframes vano-hud-in-v214{0%{opacity:0;transform:translateY(8px) scale(.985)}45%{opacity:.35}100%{opacity:1;transform:translateY(0) scale(1)}}

/* ===== route ready ===== */
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready{
  padding:2px 0 max(16px,env(safe-area-inset-bottom))!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .vano-route-hero{
  padding:4px 2px 8px!important;margin:0!important;background:transparent!important;border:0!important;box-shadow:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .route-head{display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;gap:14px!important;align-items:start!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .vr-eyebrow{font-size:8px!important;font-weight:900!important;letter-spacing:.12em!important;color:var(--vano-accent)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .vr-copy h2{margin:4px 0 4px!important;font-size:25px!important;line-height:1.03!important;letter-spacing:-.8px!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .vr-copy p{margin:0!important;font-size:11px!important;line-height:1.35!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .route-time{min-width:86px!important;text-align:right!important;padding-top:2px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .route-time span{display:block!important;font-size:27px!important;line-height:1!important;font-weight:950!important;letter-spacing:-1px!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .route-time small{display:block!important;margin-top:4px!important;font-size:10px!important;font-weight:800!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-decision{display:inline-flex!important;align-items:center!important;gap:5px!important;margin-top:8px!important;padding:6px 8px!important;border-radius:999px!important;background:var(--vano-accent-soft)!important;color:var(--vano-accent-strong)!important;font-size:9px!important;font-weight:850!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-mode-row{margin:8px 0 12px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-mode-row .segment{display:grid!important;grid-template-columns:1fr 1fr!important;gap:7px!important;padding:4px!important;border:1px solid var(--vano-line)!important;border-radius:17px!important;background:var(--vano-surface-2)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-mode-row .segment button{min-height:48px!important;border:0!important;border-radius:13px!important;background:transparent!important;color:var(--vano-muted)!important;box-shadow:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-mode-row .segment button.active{background:var(--vano-surface)!important;color:var(--vano-ink)!important;box-shadow:0 5px 14px rgba(20,22,27,.08)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-mode-row .segment button.active.fast{color:var(--vano-accent-strong)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-alternatives-head{margin:2px 1px 7px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .route-variants{display:flex!important;gap:8px!important;overflow-x:auto!important;overscroll-behavior-x:contain!important;scroll-snap-type:x proximity!important;padding:0 1px 3px!important;scrollbar-width:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .route-variants::-webkit-scrollbar{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .route-variant{flex:0 0 min(158px,43vw)!important;min-height:72px!important;padding:9px 10px!important;border:1px solid var(--vano-line)!important;border-radius:16px!important;background:var(--vano-surface)!important;color:var(--vano-ink)!important;box-shadow:none!important;scroll-snap-align:start!important;text-align:left!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .route-variant.active{border-color:rgba(244,122,49,.42)!important;background:var(--vano-accent-soft)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .start-trip-cta{width:100%!important;min-height:60px!important;margin:11px 0 9px!important;border:0!important;border-radius:18px!important;background:linear-gradient(135deg,#ff9453,var(--vano-accent))!important;color:#fff!important;box-shadow:0 12px 25px rgba(244,122,49,.24)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .start-trip-copy b{font-size:16px!important;font-weight:900!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .start-trip-copy small{font-size:9px!important;color:rgba(255,255,255,.82)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more{margin:0!important;border:1px solid var(--vano-line)!important;border-radius:16px!important;background:var(--vano-surface)!important;overflow:hidden!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more>summary{list-style:none!important;min-height:48px!important;padding:0 12px!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;color:var(--vano-ink)!important;font-size:11px!important;font-weight:850!important;cursor:pointer!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more>summary::-webkit-details-marker{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more>summary span{display:flex!important;align-items:center!important;gap:7px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more[open]>summary>svg:last-child{transform:rotate(180deg)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more-content{padding:0 10px 10px!important;display:grid!important;gap:9px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more .vr-control-block,
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more .route-card,
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more .parking-nearby{border:1px solid var(--vano-line)!important;border-radius:15px!important;background:var(--vano-surface-2)!important;box-shadow:none!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .preview-actions{display:grid!important;grid-template-columns:repeat(3,1fr)!important;gap:6px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .preview-actions .sub-action{min-width:0!important;min-height:40px!important;border:1px solid var(--vano-line)!important;border-radius:12px!important;background:var(--vano-surface-2)!important;color:var(--vano-ink)!important;box-shadow:none!important;font-size:9px!important}

/* ===== incident reporting V215 ===== */
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet.vano-incident-sheet{position:fixed!important;inset:0!important;z-index:130!important;display:none!important;align-items:flex-end!important;justify-content:center!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet.vano-incident-sheet.show{display:flex!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet.vano-incident-sheet .quick-alert-backdrop{position:absolute!important;inset:0!important;border:0!important;background:rgba(10,11,14,.48)!important;backdrop-filter:blur(3px)!important;-webkit-backdrop-filter:blur(3px)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet.vano-incident-sheet .quick-alert-card{position:relative!important;z-index:1!important;width:min(570px,calc(100% - 12px))!important;margin:0 6px max(6px,env(safe-area-inset-bottom))!important;padding:10px 12px 13px!important;border:1px solid var(--vano-line)!important;border-radius:26px!important;background:var(--vano-surface)!important;color:var(--vano-ink)!important;box-shadow:0 26px 78px rgba(0,0,0,.32)!important;transform:translateY(20px)!important;animation:vano-sheet-up-v215 .25s var(--vano-ease) forwards!important}
@keyframes vano-sheet-up-v215{to{transform:translateY(0)}}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-handle{width:38px!important;height:4px!important;margin:0 auto 10px!important;border-radius:999px!important;background:rgba(120,126,136,.24)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-head{display:flex!important;align-items:flex-start!important;justify-content:space-between!important;gap:12px!important;margin-bottom:12px!important;padding:0 2px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-head small{display:block!important;font-size:8px!important;font-weight:900!important;letter-spacing:.12em!important;color:#df3e47!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-head h3{margin:3px 0 3px!important;font-size:20px!important;line-height:1.08!important;letter-spacing:-.55px!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-head p{margin:0!important;font-size:10px!important;line-height:1.3!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-close{width:38px!important;height:38px!important;min-width:38px!important;display:grid!important;place-items:center!important;border:1px solid var(--vano-line)!important;border-radius:13px!important;background:var(--vano-surface-2)!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid button{position:relative!important;min-height:64px!important;padding:8px 9px!important;display:grid!important;grid-template-columns:38px minmax(0,1fr)!important;align-items:center!important;justify-content:stretch!important;gap:9px!important;border:1px solid var(--vano-line)!important;border-radius:16px!important;background:var(--vano-surface-2)!important;color:var(--vano-ink)!important;box-shadow:none!important;text-align:left!important;transition:transform .13s ease,border-color .16s ease,background .16s ease!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid button:active{transform:scale(.97)!important;background:#fff4f4!important;border-color:rgba(228,61,69,.18)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid button.sending{opacity:.58!important;transform:scale(.98)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-premium-icon{width:38px!important;height:38px!important;display:grid!important;place-items:center!important;border-radius:13px!important;background:#fff0f1!important;color:#df3e47!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-premium-icon{background:rgba(255,104,116,.10)!important;color:#ff747d!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-copy{min-width:0!important;display:flex!important;flex-direction:column!important;gap:2px!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-copy b{font-size:10.5px!important;line-height:1.1!important;font-weight:900!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-copy small{font-size:8px!important;line-height:1.15!important;font-weight:700!important;color:var(--vano-muted)!important;white-space:normal!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-status{min-height:18px!important;padding-top:8px!important;text-align:center!important;font-size:9px!important;line-height:1.2!important;font-weight:800!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-foot{display:flex!important;align-items:center!important;justify-content:center!important;gap:5px!important;margin-top:1px!important;font-size:8px!important;font-weight:700!important;color:var(--vano-muted)!important}
@media(max-width:370px){body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid{grid-template-columns:1fr!important}body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid button{min-height:55px!important}}

/* ===== arrival ===== */
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival{position:fixed!important;inset:0!important;z-index:122!important;display:none!important;align-items:flex-end!important;justify-content:center!important;pointer-events:none!important;background:linear-gradient(to top,rgba(8,10,12,.24),transparent 50%)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival.show{display:flex!important;pointer-events:auto!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-card{width:min(560px,calc(100% - 18px))!important;margin:0 9px max(10px,env(safe-area-inset-bottom))!important;padding:18px!important;border:1px solid var(--vano-line)!important;border-radius:26px!important;background:var(--vano-surface)!important;color:var(--vano-ink)!important;box-shadow:0 26px 70px rgba(0,0,0,.28)!important;animation:vano-arrive-v214 .44s var(--vano-ease) both!important}
@keyframes vano-arrive-v214{0%{opacity:0;transform:translateY(26px) scale(.97)}100%{opacity:1;transform:translateY(0) scale(1)}}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-mark{width:48px!important;height:48px!important;margin-bottom:10px!important;display:grid!important;place-items:center!important;border-radius:16px!important;background:var(--vano-accent-soft)!important;color:var(--vano-accent-strong)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-card>small{font-size:8px!important;font-weight:900!important;letter-spacing:.14em!important;color:var(--vano-accent)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-card h2{margin:4px 0 5px!important;font-size:24px!important;line-height:1.05!important;letter-spacing:-.7px!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-card p{margin:0 0 14px!important;font-size:11px!important;color:var(--vano-muted)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-actions{display:grid!important;grid-template-columns:1fr 1.15fr!important;gap:8px!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-actions button{min-height:50px!important;border-radius:15px!important;font-size:11px!important;font-weight:900!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-actions .arrival-secondary{display:flex!important;align-items:center!important;justify-content:center!important;gap:6px!important;border:1px solid var(--vano-line)!important;background:var(--vano-surface-2)!important;color:var(--vano-ink)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-actions .arrival-primary{border:0!important;background:var(--vano-accent)!important;color:#fff!important;box-shadow:0 9px 22px rgba(244,122,49,.22)!important}
body.vano-app-root:not(.vano-route-onboarding).nav-arrived :is(.nav-maneuver-top,.nav-street-chip,.nav-panel,.floating-speedo,.nav-control-stack,.traffic-radar,.nav-alt-hint){opacity:0!important;pointer-events:none!important;transform:translateY(8px)!important;transition:opacity .2s ease,transform .2s ease!important}

@media(max-width:390px){
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-top{left:max(7px,env(safe-area-inset-left))!important;right:max(7px,env(safe-area-inset-right))!important;min-height:72px!important;padding:8px 9px!important;border-radius:18px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-icon{width:50px!important;height:50px!important;min-width:50px!important;border-radius:15px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-copy b{font-size:15px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo.floating-speedo{left:max(8px,env(safe-area-inset-left))!important;width:80px!important;height:80px!important;min-width:80px!important;min-height:80px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #floatingSpeedo #floatingSpeedValue{font-size:29px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-control-stack{right:max(8px,env(safe-area-inset-right))!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav :is(.nav-stack-btn,.nav-audio-toggle,.nav-drawer-toggle,.nav-drawer-btn){width:43px!important;height:43px!important;min-width:43px!important;min-height:43px!important;border-radius:14px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-summary-row{grid-template-columns:1fr .92fr .92fr 42px!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid button{min-height:66px!important;flex-direction:row!important;justify-content:flex-start!important;text-align:left!important;padding:8px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .vr-copy h2{font-size:22px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-ready .route-time span{font-size:24px!important}
}

@media(orientation:landscape) and (max-height:520px){
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-maneuver-top{left:max(8px,env(safe-area-inset-left))!important;right:auto!important;width:min(390px,55vw)!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav .nav-panel.nav-minimal{left:max(8px,env(safe-area-inset-left))!important;right:auto!important;width:min(470px,58vw)!important}
  body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-card{width:min(520px,62vw)!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet.vano-incident-sheet .quick-alert-card{width:min(680px,82vw)!important}
  body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet .quick-alert-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important}
}

@media(prefers-reduced-motion:reduce){
  body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .nav-maneuver-top,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .nav-panel,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .nav-control-stack,
body.vano-app-root:not(.vano-route-onboarding).body-nav.nav-launching .floating-speedo,
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival-card,
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet.vano-incident-sheet .quick-alert-card{animation:none!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #navDrawerRecenter.calibrating i{animation:none!important}
}


/* ========================================================================== 
   VANO MAPS — Route personalization + route information cards
   Modern, mobile-first, light/black adaptive. Loaded last in base.html.
   ========================================================================== */

/* ---------- Personalizar rota ---------- */
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251{
  --v251-bg:rgba(255,255,255,.985);
  --v251-surface:#F6F7F9;
  --v251-surface-strong:#FFFFFF;
  --v251-line:rgba(28,32,39,.095);
  --v251-line-strong:rgba(28,32,39,.14);
  --v251-text:#20232A;
  --v251-muted:#767C87;
  --v251-faint:#979DA7;
  --v251-accent:#E47B48;
  --v251-accent-strong:#D86B37;
  --v251-accent-soft:#FFF1E8;
  right:12px!important;
  top:max(64px,calc(env(safe-area-inset-top) + 56px))!important;
  width:min(390px,calc(100% - 24px))!important;
  max-height:min(76svh,650px)!important;
  box-sizing:border-box!important;
  padding:14px!important;
  border:1px solid var(--v251-line)!important;
  border-radius:28px!important;
  background:var(--v251-bg)!important;
  color:var(--v251-text)!important;
  box-shadow:0 28px 72px rgba(22,26,34,.19),0 5px 16px rgba(22,26,34,.07),inset 0 1px 0 rgba(255,255,255,.78)!important;
  backdrop-filter:blur(24px) saturate(125%)!important;
  -webkit-backdrop-filter:blur(24px) saturate(125%)!important;
  overflow:auto!important;
  overscroll-behavior:contain!important;
  scrollbar-width:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251::-webkit-scrollbar{display:none!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head{
  display:flex!important;align-items:flex-start!important;justify-content:space-between!important;gap:12px!important;
  padding:2px 1px 13px!important;margin:0!important;
  border-bottom:1px solid var(--v251-line)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head-main{display:flex!important;align-items:center!important;gap:11px!important;min-width:0!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head-icon{
  width:42px!important;height:42px!important;min-width:42px!important;border-radius:14px!important;
  display:grid!important;place-items:center!important;
  background:linear-gradient(145deg,#FFF6F0,var(--v251-accent-soft))!important;
  border:1px solid rgba(228,123,72,.18)!important;color:var(--v251-accent-strong)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.82)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head-icon svg{width:18px!important;height:18px!important;stroke-width:2.15!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head-copy{min-width:0!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head small{
  display:block!important;margin:0 0 3px!important;color:var(--v251-accent-strong)!important;
  font-size:7.5px!important;line-height:1!important;font-weight:900!important;letter-spacing:.12em!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head h3{
  margin:0!important;color:var(--v251-text)!important;font-size:20px!important;line-height:1.06!important;
  font-weight:880!important;letter-spacing:-.52px!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head p{
  margin:5px 0 0!important;max-width:260px!important;color:var(--v251-muted)!important;
  font-size:9px!important;line-height:1.3!important;font-weight:620!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-close{
  width:38px!important;height:38px!important;min-width:38px!important;border-radius:13px!important;
  border:1px solid var(--v251-line)!important;background:var(--v251-surface)!important;color:#727985!important;
  display:grid!important;place-items:center!important;box-shadow:none!important;
  transition:transform .14s ease,background-color .14s ease,border-color .14s ease!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-close:active{transform:scale(.94)!important;background:#ECEEF1!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-list{display:grid!important;gap:8px!important;margin:12px 0 0!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row{
  min-height:62px!important;box-sizing:border-box!important;padding:10px 11px 10px 13px!important;
  display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;align-items:center!important;gap:13px!important;
  border:1px solid var(--v251-line)!important;border-radius:18px!important;
  background:var(--v251-surface)!important;color:var(--v251-text)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.62)!important;
  transition:transform .12s ease,border-color .16s ease,background-color .16s ease!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row:active{transform:scale(.993)!important;border-color:var(--v251-line-strong)!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row>span{min-width:0!important;margin:0!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row b{
  display:block!important;margin:0!important;color:var(--v251-text)!important;
  font-size:11px!important;line-height:1.15!important;font-weight:820!important;letter-spacing:-.12px!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row>span>span{
  display:block!important;margin:4px 0 0!important;color:var(--v251-muted)!important;
  font-size:8.4px!important;line-height:1.32!important;font-weight:560!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-switch{
  appearance:none!important;-webkit-appearance:none!important;width:42px!important;height:25px!important;min-width:42px!important;
  border:1px solid rgba(87,94,104,.16)!important;border-radius:999px!important;background:#E4E7EA!important;
  position:relative!important;box-shadow:inset 0 1px 2px rgba(25,30,36,.05)!important;transition:.18s ease!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-switch::before{
  content:""!important;position:absolute!important;left:3px!important;top:3px!important;width:17px!important;height:17px!important;
  border-radius:50%!important;background:#FFFFFF!important;box-shadow:0 2px 6px rgba(20,24,30,.18)!important;transition:transform .18s cubic-bezier(.2,.8,.2,1)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-switch:checked{
  background:linear-gradient(135deg,var(--v251-accent),var(--v251-accent-strong))!important;
  border-color:rgba(216,107,55,.42)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-switch:checked::before{transform:translateX(17px)!important;background:#fff!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .voice-pref-row{grid-template-columns:minmax(0,1fr) 128px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .voice-select{
  width:128px!important;height:39px!important;padding:0 10px!important;border:1px solid var(--v251-line)!important;
  border-radius:13px!important;background:var(--v251-surface-strong)!important;color:var(--v251-text)!important;
  font-size:9px!important;font-weight:760!important;outline:none!important;box-shadow:0 2px 7px rgba(22,26,34,.035)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-foot{
  margin:11px 3px 1px!important;padding:0!important;color:var(--v251-faint)!important;font-size:7.5px!important;line-height:1.3!important;font-weight:600!important;
}

/* ---------- Route information: larger, cleaner, consistent borders ---------- */
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio{
  --v251-route-line:rgba(30,34,41,.10);
  --v251-route-line-strong:rgba(30,34,41,.15);
  --v251-route-surface:#FFFFFF;
  --v251-route-soft:#F7F8FA;
  --v251-route-text:#20232A;
  --v251-route-muted:#737A85;
  --v251-route-accent:#E47B48;
  --v251-route-accent-soft:#FFF2EA;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero{
  box-sizing:border-box!important;padding:16px 16px!important;margin-bottom:11px!important;
  border:1px solid var(--v251-route-line)!important;border-radius:24px!important;
  background:linear-gradient(145deg,#FFFFFF,#FBFBFC)!important;
  box-shadow:0 12px 32px rgba(23,27,34,.075),0 2px 8px rgba(23,27,34,.035),inset 0 1px 0 rgba(255,255,255,.9)!important;
  overflow:hidden!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head{gap:14px!important;align-items:center!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head h2{font-size:21px!important;line-height:1.05!important;letter-spacing:-.65px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head p{margin-top:5px!important;font-size:9.5px!important;line-height:1.25!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time{
  min-width:92px!important;padding:9px 10px!important;border:1px solid rgba(228,123,72,.16)!important;
  border-radius:17px!important;background:var(--v251-route-accent-soft)!important;text-align:right!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time span{font-size:28px!important;letter-spacing:-1.1px!important;color:#C85E2D!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time small{margin-top:4px!important;color:#A86649!important}

body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card{
  position:relative!important;box-sizing:border-box!important;min-height:136px!important;
  margin:2px 0 1px!important;padding:16px 16px 15px!important;
  border:1px solid var(--v251-route-line)!important;border-radius:22px!important;
  background:linear-gradient(145deg,var(--v251-route-surface),#FBFBFC)!important;color:var(--v251-route-text)!important;
  box-shadow:0 10px 28px rgba(23,27,34,.07),0 2px 7px rgba(23,27,34,.03),inset 0 1px 0 rgba(255,255,255,.86)!important;
  overflow:hidden!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card::before{
  content:""!important;position:absolute!important;left:16px!important;right:16px!important;top:0!important;height:2px!important;
  border-radius:0 0 999px 999px!important;background:linear-gradient(90deg,transparent,rgba(228,123,72,.62),transparent)!important;opacity:.8!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card.fast-selected{
  border-color:rgba(228,123,72,.24)!important;background:linear-gradient(145deg,#FFFFFF,#FFF8F3)!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card-top{gap:14px!important;align-items:flex-start!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card-top h3{
  font-size:15px!important;line-height:1.12!important;letter-spacing:-.32px!important;color:var(--v251-route-text)!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card .mins{
  min-width:72px!important;padding:7px 9px!important;border:1px solid rgba(228,123,72,.15)!important;border-radius:14px!important;
  background:var(--v251-route-accent-soft)!important;color:#C85E2D!important;font-size:19px!important;text-align:center!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .safety-level{margin-top:9px!important;gap:7px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .level-pill{border-radius:999px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-ai{
  margin-top:11px!important;padding:10px 11px!important;border:1px solid var(--v251-route-line)!important;border-radius:14px!important;
  background:var(--v251-route-soft)!important;color:var(--v251-route-muted)!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-ai b{color:var(--v251-route-text)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .traffic-line,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .smart-note,
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .risk-note{border-radius:13px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more{
  border-radius:20px!important;border-color:var(--v251-route-line)!important;background:#FFFFFF!important;
  box-shadow:0 5px 16px rgba(23,27,34,.035)!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more>summary{min-height:52px!important;padding:0 14px!important;font-size:11.5px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more[open]>summary{border-bottom:1px solid var(--v251-route-line)!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more-content{padding:13px!important}

/* ---------- Black / dark ---------- */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251{
  --v251-bg:rgba(29,27,25,.985);--v251-surface:#25221F;--v251-surface-strong:#2C2824;
  --v251-line:rgba(255,248,242,.09);--v251-line-strong:rgba(255,248,242,.15);
  --v251-text:#FFF8F2;--v251-muted:#B9AFA8;--v251-faint:#8F8781;
  --v251-accent:#F59A62;--v251-accent-strong:#F18A4C;--v251-accent-soft:rgba(245,154,98,.11);
  box-shadow:0 30px 78px rgba(0,0,0,.42),0 6px 18px rgba(0,0,0,.18),inset 0 1px 0 rgba(255,255,255,.025)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head-icon,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head-icon{
  background:rgba(245,154,98,.10)!important;border-color:rgba(245,154,98,.19)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.025)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row{
  background:var(--v251-surface)!important;border-color:var(--v251-line)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.018)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-close,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-close,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .voice-select,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .voice-select{
  background:var(--v251-surface-strong)!important;color:var(--v251-text)!important;border-color:var(--v251-line)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-switch,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-switch{background:#3A3531!important;border-color:rgba(255,248,242,.10)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-switch:checked,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-switch:checked{background:linear-gradient(135deg,#F59A62,#D9703F)!important}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio{
  --v251-route-line:rgba(255,248,242,.09);--v251-route-line-strong:rgba(255,248,242,.14);
  --v251-route-surface:#25221F;--v251-route-soft:#2C2824;--v251-route-text:#FFF8F2;--v251-route-muted:#B9AFA8;
  --v251-route-accent:#F59A62;--v251-route-accent-soft:rgba(245,154,98,.11);
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card{
  background:linear-gradient(145deg,#25221F,#211E1B)!important;color:var(--v251-route-text)!important;
  border-color:var(--v251-route-line)!important;box-shadow:0 14px 34px rgba(0,0,0,.22),inset 0 1px 0 rgba(255,255,255,.025)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card.fast-selected,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card.fast-selected{background:linear-gradient(145deg,#28231F,#2B231D)!important;border-color:rgba(245,154,98,.22)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card .mins,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card .mins{background:rgba(245,154,98,.10)!important;border-color:rgba(245,154,98,.17)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time span,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time span,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card .mins,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card .mins{color:#F6A06D!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-ai,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-ai{background:#2C2824!important;border-color:var(--v251-route-line)!important;color:var(--v251-route-muted)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more{background:#25221F!important;border-color:var(--v251-route-line)!important;box-shadow:0 8px 22px rgba(0,0,0,.16)!important}

/* ---------- Responsive ---------- */
@media(max-width:640px){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251{
    left:10px!important;right:10px!important;top:auto!important;bottom:max(10px,calc(env(safe-area-inset-bottom) + 8px))!important;
    width:auto!important;max-height:min(78svh,620px)!important;padding:13px!important;border-radius:26px!important;
  }
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head h3{font-size:19px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head p{max-width:230px!important;font-size:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row{min-height:60px!important;padding:9px 10px 9px 12px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero{padding:14px!important;border-radius:22px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head h2{font-size:19px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time{min-width:82px!important;padding:8px 9px!important;border-radius:15px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time span{font-size:24px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card{min-height:128px!important;padding:15px!important;border-radius:20px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card-top h3{font-size:14px!important}
}
@media(max-width:370px){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head-icon{width:38px!important;height:38px!important;min-width:38px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head p{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row>span>span{font-size:7.8px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .voice-pref-row{grid-template-columns:minmax(0,1fr) 112px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .voice-select{width:112px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time{min-width:74px!important;padding:7px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time span{font-size:21px!important}
}
@media(prefers-reduced-motion:reduce){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-switch,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-switch::before,
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-close{transition:none!important}
}


/* ========================================================================== 
   VANO MAPS — entry experience, personalization cleanup and card polish
   ========================================================================== */

/* Entry experience: search remains primary, capabilities communicate value only when expanded. */
body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) #planSheet .planner-capabilities{
  display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin:8px 2px 2px;padding:0;
}
body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) #planSheet.sheet-collapsed .planner-capabilities{display:none!important}
body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) #planSheet .planner-capabilities span{
  min-height:28px;display:inline-flex;align-items:center;gap:5px;padding:0 9px;border-radius:999px;
  border:1px solid rgba(31,35,43,.075);background:rgba(246,247,249,.92);color:#737985;
  font-size:9px;font-weight:760;letter-spacing:-.05px;white-space:nowrap;
}
body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) #planSheet .planner-capabilities svg{width:12px;height:12px;color:#D9703F;stroke-width:2.2}
body.vano-app-root:not(.vano-route-onboarding) #quickPrefs .planner-preset-icon{background:linear-gradient(145deg,rgba(245,154,98,.13),rgba(217,112,63,.18))!important;color:#D9703F!important;border-color:rgba(217,112,63,.10)!important}
body.vano-app-root:not(.vano-route-onboarding) #quickPrefs .planner-preset-icon svg{stroke-width:2.15}

/* Personalization: fewer visual layers, larger readable copy and clear groups. */
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251{
  width:min(410px,calc(100% - 24px))!important;padding:16px!important;border-radius:26px!important;
  box-shadow:0 24px 62px rgba(22,26,34,.16),0 4px 14px rgba(22,26,34,.055),inset 0 1px 0 rgba(255,255,255,.76)!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head{padding:1px 1px 14px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head h3{font-size:21px!important;letter-spacing:-.58px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head p{font-size:10.5px!important;line-height:1.38!important;max-width:278px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-list-v252{display:grid!important;gap:14px!important;margin-top:14px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-section{display:grid!important;gap:7px!important;margin:0!important;padding:0!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-section-label{display:flex!important;align-items:baseline!important;justify-content:space-between!important;gap:10px!important;padding:0 3px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-section-label span{color:var(--v251-accent-strong)!important;font-size:8px!important;font-weight:900!important;letter-spacing:.13em!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-section-label small{color:var(--v251-faint)!important;font-size:8.8px!important;font-weight:620!important;text-align:right!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row{
  min-height:68px!important;padding:11px 12px 11px 14px!important;border-radius:17px!important;gap:14px!important;
  background:var(--v251-surface)!important;box-shadow:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row b{font-size:12.5px!important;line-height:1.2!important;font-weight:790!important;letter-spacing:-.16px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row>span>span{font-size:10.3px!important;line-height:1.38!important;font-weight:540!important;margin-top:4px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-switch{width:46px!important;height:28px!important;min-width:46px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-switch::before{width:20px!important;height:20px!important;left:3px!important;top:3px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-switch:checked::before{transform:translateX(18px)!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .voice-pref-row{grid-template-columns:minmax(0,1fr) 132px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .voice-select{width:132px!important;height:42px!important;font-size:10.5px!important;border-radius:13px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-foot{margin:13px 4px 1px!important;font-size:9px!important;line-height:1.35!important}

/* Route information: slightly larger without becoming a second sheet. */
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero{padding:17px!important;border-radius:24px!important;margin-bottom:12px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head h2{font-size:22px!important;line-height:1.04!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head p{font-size:10.5px!important;line-height:1.35!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time{min-width:98px!important;padding:10px 11px!important;border-radius:16px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time span{font-size:29px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card{
  min-height:150px!important;padding:17px!important;border-radius:24px!important;
  border-width:1px!important;box-shadow:0 9px 24px rgba(23,27,34,.055),0 2px 6px rgba(23,27,34,.025)!important;
}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card::before{left:18px!important;right:18px!important;height:2px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card-top{gap:15px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card-top h3{font-size:16px!important;line-height:1.18!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card .mins{min-width:78px!important;padding:8px 10px!important;border-radius:14px!important;font-size:20px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-ai{margin-top:12px!important;padding:11px 12px!important;border-radius:14px!important;font-size:10.2px!important;line-height:1.38!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-ai b{font-size:10.5px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more{border-radius:21px!important}
body.vano-app-root:not(.vano-route-onboarding) #routeState .vano-route-more>summary{min-height:54px!important;font-size:12px!important}

/* Dark mode: preserve contrast, not a gray wash. */
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) #planSheet .planner-capabilities span,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) #planSheet .planner-capabilities span{
  background:rgba(38,35,32,.94);border-color:rgba(255,248,242,.08);color:#B9AFA8;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251{
  box-shadow:0 26px 66px rgba(0,0,0,.38),0 4px 14px rgba(0,0,0,.16),inset 0 1px 0 rgba(255,255,255,.025)!important;
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card,
html[data-vano-theme="dark"] body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card{
  box-shadow:0 10px 26px rgba(0,0,0,.20),inset 0 1px 0 rgba(255,255,255,.02)!important;
}

@media(max-width:640px){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251{left:8px!important;right:8px!important;bottom:max(8px,calc(env(safe-area-inset-bottom) + 6px))!important;width:auto!important;max-height:min(82svh,680px)!important;padding:14px!important;border-radius:25px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251::before{content:"";display:block;width:42px;height:4px;border-radius:999px;background:rgba(84,89,98,.16);margin:-5px auto 9px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head h3{font-size:20px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-head p{font-size:10px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row{min-height:64px!important;padding:10px 11px 10px 13px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row b{font-size:12px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .pref-row>span>span{font-size:9.8px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .vr-hero{padding:15px!important;border-radius:22px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-head h2{font-size:20px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time{min-width:86px!important;padding:9px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-time span{font-size:25px!important}
  body.vano-app-root:not(.vano-route-onboarding) #routeState.vano-route-studio .route-card{min-height:140px!important;padding:16px!important;border-radius:22px!important}
}
@media(max-width:370px){
  body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) #planSheet .planner-capabilities{gap:5px}
  body.vano-app-root:not(.vano-route-onboarding):not(.body-nav) #planSheet .planner-capabilities span{font-size:8.3px;padding:0 7px}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .prefs-section-label small{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .voice-pref-row{grid-template-columns:minmax(0,1fr) 116px!important}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .prefs-drawer.prefs-drawer-v251 .voice-select{width:116px!important}
}


/* VANO MAPS — theme toggle icon-only, compact and touch-friendly */
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle,
body.vano-app-root:not(.vano-route-onboarding) #mapThemeBtn.map-theme-btn{
  appearance:none!important;
  -webkit-appearance:none!important;
  width:38px!important;
  height:38px!important;
  min-width:38px!important;
  min-height:38px!important;
  padding:0!important;
  margin:0!important;
  display:grid!important;
  place-items:center!important;
  border:0!important;
  border-radius:12px!important;
  background:transparent!important;
  box-shadow:none!important;
  color:var(--vano-muted,#666d78)!important;
  line-height:1!important;
  overflow:hidden!important;
  transition:background-color .15s ease,color .15s ease,transform .12s ease!important;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle:hover,
body.vano-app-root:not(.vano-route-onboarding) #mapThemeBtn.map-theme-btn:hover{background:rgba(217,112,63,.08)!important;color:#D9703F!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle:active,
body.vano-app-root:not(.vano-route-onboarding) #mapThemeBtn.map-theme-btn:active{transform:scale(.92)!important;background:rgba(217,112,63,.12)!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) #mapThemeBtn.map-theme-btn:focus-visible{outline:2px solid rgba(217,112,63,.52)!important;outline-offset:2px!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle>span,
body.vano-app-root:not(.vano-route-onboarding) #mapThemeBtn.map-theme-btn>span{position:static!important;width:22px!important;height:22px!important;display:none!important;place-items:center!important;opacity:1!important;transform:none!important;background:transparent!important;border:0!important;box-shadow:none!important}
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle svg,
body.vano-app-root:not(.vano-route-onboarding) #mapThemeBtn.map-theme-btn svg{width:20px!important;height:20px!important;stroke-width:2.15!important}
html:not([data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding)) .vano-theme-toggle .vano-theme-moon,
html:not([data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding)) #mapThemeBtn .map-theme-day{display:grid!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle .vano-theme-sun,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #mapThemeBtn .map-theme-night{display:grid!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #mapThemeBtn.map-theme-btn{color:#f0b184!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle:hover,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) #mapThemeBtn.map-theme-btn:hover{background:rgba(245,154,98,.10)!important;color:#FFC19A!important}
@media(max-width:430px){body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle,
body.vano-app-root:not(.vano-route-onboarding) #mapThemeBtn.map-theme-btn{width:40px!important;height:40px!important;min-width:40px!important;min-height:40px!important}}

/* ========================================================================== 
   VANO MAPS — account sheet + profile personalization stabilization
   Scoped final-layer rules. No map/navigation runtime overrides.
   ========================================================================== */

/* Signed-in three-dots account sheet */
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v255{
  left:auto!important;
  right:16px!important;
  bottom:16px!important;
  width:min(392px,calc(100vw - 32px))!important;
  max-width:392px!important;
  max-height:min(78dvh,680px)!important;
  padding:10px 12px 12px!important;
  overflow-x:hidden!important;
  overflow-y:auto!important;
  overscroll-behavior:contain;
  border:1px solid rgba(32,36,44,.09)!important;
  border-radius:24px!important;
  background:rgba(255,255,255,.985)!important;
  color:#20242c!important;
  box-shadow:0 22px 64px rgba(25,30,40,.18)!important;
  backdrop-filter:blur(20px) saturate(125%)!important;
  -webkit-backdrop-filter:blur(20px) saturate(125%)!important;
  scrollbar-width:none;
  transform:translateY(calc(100% + 30px));
  transform-origin:bottom right;
  transition:transform .25s cubic-bezier(.2,.8,.2,1),opacity .18s ease;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v255::-webkit-scrollbar{display:none}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer.show{transform:translateY(0);opacity:1}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-drawer.account-drawer-v255 .drawer-grab{
  width:38px!important;height:4px!important;margin:1px auto 8px!important;border-radius:999px!important;background:#d7d9de!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-backdrop{background:rgba(23,26,32,.28)!important;backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px)}

body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:2px 2px 10px}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-head>div{min-width:0}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-head small{display:block;color:#D9703F;font-size:9px;font-weight:900;letter-spacing:.12em}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-head strong{display:block;margin-top:2px;color:#20242c;font-size:18px;line-height:1.15;letter-spacing:-.35px}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-close{width:38px;height:38px;flex:0 0 38px;padding:0;border:1px solid #e7e8ec;border-radius:12px;background:#f8f8f9;color:#666c77;display:grid;place-items:center;cursor:pointer}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-close:active{transform:scale(.96)}

body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-user.account-v255-user{
  display:grid!important;grid-template-columns:50px minmax(0,1fr) auto!important;align-items:center!important;gap:10px!important;
  margin:0 0 10px!important;padding:10px!important;border:1px solid #e9eaed!important;border-radius:17px!important;background:#fbfbfc!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-user .drawer-avatar{width:50px!important;height:50px!important;min-width:50px!important;border-radius:15px!important;object-fit:cover!important;border:1px solid #e5e6e9!important;background:#fff3ea!important;color:#D9703F!important;display:grid!important;place-items:center!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-user-copy{min-width:0}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-user-copy b{display:block!important;color:#20242c!important;font-size:14px!important;font-weight:850!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-user-copy span{display:block!important;margin-top:3px!important;color:#7b818c!important;font-size:11px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-user .drawer-profile{height:34px!important;padding:0 9px!important;border:1px solid #e4e5e8!important;border-radius:10px!important;background:#fff!important;color:#555c67!important;display:inline-flex!important;align-items:center!important;gap:2px!important;font-size:10px!important;font-weight:850!important;text-decoration:none!important}

body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:13px}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-actions>a{position:relative;min-width:0;min-height:92px;padding:11px;border:1px solid #e7e8ec;border-radius:16px;background:#fff;color:#20242c;display:grid;grid-template-columns:36px minmax(0,1fr);align-items:center;gap:9px;text-decoration:none;box-shadow:0 4px 14px rgba(26,31,43,.035)}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-actions>a>span{width:36px;height:36px;border-radius:11px;background:#fff1e7;color:#D9703F;display:grid;place-items:center}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-actions>a>div{min-width:0}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-actions b{display:block;font-size:12px;line-height:1.15;font-weight:850}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-actions small{display:block;margin-top:3px;color:#858b96;font-size:10px;line-height:1.3}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-actions .notif-count{position:absolute;top:8px;right:8px}

body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-section-label{margin:0 3px 6px;color:#969ba4;font-size:8px;font-weight:900;letter-spacing:.12em}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .drawer-list.account-v255-list{display:grid!important;gap:4px!important;margin:0!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-list .drawer-link{
  width:100%!important;min-height:55px!important;box-sizing:border-box!important;padding:7px 8px!important;border:1px solid transparent!important;border-radius:13px!important;background:transparent!important;color:#262b34!important;
  display:grid!important;grid-template-columns:36px minmax(0,1fr) 16px!important;align-items:center!important;gap:9px!important;text-decoration:none!important;
}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-list .drawer-link>span:nth-child(2){min-width:0}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-list .drawer-link b{display:block!important;color:inherit!important;font-size:12px!important;font-weight:820!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-list .drawer-link small{display:block!important;margin-top:2px!important;color:#8a9099!important;font-size:10px!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-icon{width:36px;height:36px;border-radius:11px;background:#f4f5f6;color:#69707b;display:grid;place-items:center}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-list .drawer-link>svg{color:#a4a8af}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-logout{margin-top:8px;padding-top:8px;border-top:1px solid #ececef}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-logout form{margin:0!important}
body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-logout .drawer-logout{width:100%!important;min-height:44px!important;border:0!important;border-radius:12px!important;background:#fff3f2!important;color:#b65353!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;font-size:11px!important;font-weight:850!important}

@media(hover:hover) and (pointer:fine){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-close:hover{background:#f1f2f3}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-actions>a:hover{border-color:#dedfe3;background:#fffcfa}
  body.vano-app-root:not(.vano-route-onboarding) .ws-app .account-v255-list .drawer-link:hover{background:#f6f7f8!important}
}

/* Profile personalization hierarchy */
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-intro{
  display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin:14px 0 10px;padding:18px 20px;border:1px solid #e7e8ec;border-radius:20px;background:linear-gradient(145deg,#fff,#fbfbfc);box-shadow:0 7px 24px rgba(23,27,34,.045);
}
body.vano-app-root:not(.vano-route-onboarding) .v72-profile-page .profile-v255-intro>div:first-child{min-width:0}
