html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard :is(.admin240-card small,.admin240-kpi small,.server-head p){color:#9aa0a8!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240-nav a:hover{background:#2a211d!important;color:#ffc39b!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-users .admin-modal-backdrop,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .node-config-backdrop{background:rgba(0,0,0,.62)!important;backdrop-filter:blur(6px)!important}

/* --------------------------- Mobile dock --------------------------- */
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .mobile-dock{
  position:fixed;z-index:350;left:10px;right:10px;bottom:max(8px,env(safe-area-inset-bottom));height:62px;
  padding:6px;border:1px solid var(--v258-line);border-radius:19px;background:color-mix(in srgb,var(--v258-surface) 94%,transparent);
  box-shadow:0 16px 40px rgba(43,31,23,.15);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)
}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .mobile-dock a{border-radius:13px;color:var(--v258-muted);font-size:9px;font-weight:800}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .mobile-dock a:hover,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .mobile-dock a:active{background:var(--v258-brand-soft);color:var(--v258-brand)}

/* --------------------------- MAP: account drawer only --------------------------- */
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .account-backdrop{z-index:210!important;background:rgba(30,23,19,.30)!important;backdrop-filter:blur(5px)!important;-webkit-backdrop-filter:blur(5px)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .account-drawer{
  z-index:220!important;overflow:auto!important;overscroll-behavior:contain;
  border:1px solid rgba(222,211,203,.92)!important;background:rgba(255,252,249,.985)!important;color:#27231f!important;
  box-shadow:0 24px 70px rgba(47,34,27,.22)!important;backdrop-filter:blur(24px) saturate(135%)!important;-webkit-backdrop-filter:blur(24px) saturate(135%)!important;
}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-grab{width:42px!important;height:5px!important;margin:3px auto 12px!important;background:#d6cbc4!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .v258-drawer-head{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;margin-bottom:10px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .v258-drawer-brand{display:flex!important;align-items:center!important;gap:9px!important;min-width:0!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .v258-drawer-brand img{width:34px!important;height:34px!important;border-radius:11px!important;object-fit:contain!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .v258-drawer-brand span{display:block!important;color:#9a8f87!important;font-size:8px!important;font-weight:900!important;letter-spacing:.12em!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .v258-drawer-brand b{display:block!important;margin-top:1px!important;color:#27231f!important;font-size:12px!important;letter-spacing:-.2px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .v258-drawer-close{width:36px!important;height:36px!important;border:1px solid #e9e0da!important;border-radius:12px!important;background:#f8f4f1!important;color:#665e58!important;display:grid!important;place-items:center!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-user{display:grid!important;grid-template-columns:54px minmax(0,1fr) auto!important;gap:11px!important;align-items:center!important;padding:12px!important;border:1px solid #eee4de!important;border-radius:18px!important;background:#fff!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-avatar{width:54px!important;height:54px!important;border-radius:17px!important;border:1px solid #eee2da!important;background:#fff2e9!important;color:#d9703f!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-user b{color:#27231f!important;font-size:14px!important;letter-spacing:-.25px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-user span{color:#8d827a!important;font-size:9.5px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-profile{min-height:34px!important;padding:0 11px!important;border:1px solid #f1d8c8!important;border-radius:11px!important;background:#fff0e7!important;color:#d9703f!important;font-size:9px!important;font-weight:900!important;text-decoration:none!important;display:flex!important;align-items:center!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .v258-drawer-section{margin-top:12px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .v258-drawer-label{display:flex!important;justify-content:space-between!important;gap:10px!important;padding:0 3px 7px!important;color:#998d85!important;font-size:8px!important;font-weight:900!important;letter-spacing:.11em!important;text-transform:uppercase!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-list{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-list form{grid-column:1/-1!important;margin:0!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-link{min-height:66px!important;height:auto!important;padding:11px!important;border:1px solid #ece2dc!important;border-radius:16px!important;background:#fff!important;color:#3d3732!important;display:grid!important;grid-template-columns:32px minmax(0,1fr) auto!important;align-items:center!important;gap:9px!important;text-decoration:none!important;font-size:10px!important;font-weight:850!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-link>i:first-child{width:32px!important;height:32px!important;padding:8px!important;border-radius:10px!important;background:#fff0e7!important;color:#d9703f!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-link .v258-link-copy{min-width:0!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-link .v258-link-copy b{display:block!important;color:#37312d!important;font-size:10.5px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-link .v258-link-copy small{display:block!important;margin-top:2px!important;color:#988d85!important;font-size:7.5px!important;font-weight:650!important;line-height:1.25!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-link:hover,
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-link:active{background:#fff8f3!important;border-color:#efd8c9!important;color:#d9703f!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-link.drawer-logout{width:100%!important;min-height:48px!important;grid-template-columns:30px minmax(0,1fr)!important;background:#fffafa!important;border-color:#f1e1e2!important;color:#b9515a!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-link.drawer-logout>i:first-child{width:30px!important;height:30px!important;padding:7px!important;background:#fff0f1!important;color:#c75963!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-divider{display:none!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .notif-count{min-width:20px!important;height:20px!important;border-radius:999px!important;background:#d9703f!important;color:#fff!important;display:grid!important;place-items:center!important;font-size:8px!important;font-style:normal!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-content{padding:0!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-top{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-brand{display:flex!important;align-items:center!important;gap:10px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-brand img{width:42px!important;height:42px!important;border-radius:13px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-brand small{display:block!important;color:#d9703f!important;font-size:8px!important;font-weight:900!important;letter-spacing:.12em!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-brand b{display:block!important;margin-top:2px!important;color:#27231f!important;font-size:11px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-close{width:36px!important;height:36px!important;border:1px solid #e9e0da!important;border-radius:12px!important;background:#f8f4f1!important;color:#655d57!important;display:grid!important;place-items:center!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-content h3{margin:18px 0 7px!important;color:#27231f!important;font-size:23px!important;line-height:1.05!important;letter-spacing:-.8px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-content>p{margin:0!important;color:#746a63!important;font-size:10.5px!important;line-height:1.5!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-benefits{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:7px!important;margin:14px 0!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-benefits span{min-height:58px!important;padding:9px 7px!important;border:1px solid #eee3dd!important;border-radius:14px!important;background:#fff!important;color:#615851!important;font-size:8px!important;font-weight:780!important;line-height:1.25!important;display:flex!important;flex-direction:column!important;justify-content:center!important;gap:6px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-benefits i{color:#d9703f!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-actions{display:grid!important;grid-template-columns:1fr 1fr!important;gap:8px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-primary,
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-secondary{min-height:48px!important;border-radius:14px!important;display:flex!important;align-items:center!important;justify-content:center!important;font-size:10.5px!important;font-weight:900!important;text-decoration:none!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-primary{border:0!important;background:linear-gradient(135deg,#f59a62,#d9703f)!important;color:#fff!important;box-shadow:0 10px 22px rgba(217,112,63,.20)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-secondary{border:1px solid #e8ddd6!important;background:#fff!important;color:#514943!important}
body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-continue{width:100%!important;min-height:38px!important;margin-top:7px!important;border:0!important;background:transparent!important;color:#8a8078!important;font-size:9px!important;font-weight:800!important}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .account-drawer{border-color:#39312c!important;background:rgba(27,24,21,.985)!important;color:#fff9f4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-grab{background:#5c5048!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-map-surface :is(.drawer-user,.drawer-link,.guest-drawer-benefits span,.guest-drawer-secondary){border-color:#39312c!important;background:#211d1a!important;color:#f7eee8!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-map-surface :is(.drawer-user b,.v258-drawer-brand b,.guest-drawer-brand b,.guest-drawer-content h3,.drawer-link .v258-link-copy b){color:#fff9f4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-map-surface :is(.drawer-user span,.drawer-link .v258-link-copy small,.guest-drawer-content>p,.guest-drawer-continue){color:#a89b92!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-map-surface :is(.v258-drawer-close,.guest-drawer-close){border-color:#3b332e!important;background:#28231f!important;color:#c9bdb5!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-link:hover{background:#2a241f!important;border-color:#554033!important}

/* --------------------------- Responsive --------------------------- */
@media(max-width:900px){
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .navlinks{display:none}
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .page{padding-top:22px;padding-bottom:100px}
  body.vano-app-root:not(.vano-route-onboarding).vano-route-about .grid-3{grid-template-columns:1fr}
  body.vano-app-root:not(.vano-route-onboarding).vano-route-register .v63-entry-shell{width:min(100% - 20px,680px);margin:16px auto}
  body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v108-quicknav{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240-grid-main,
body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-dashboard .admin240-server-grid{grid-template-columns:1fr!important}
}
@media(max-width:640px){
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .topbar{height:58px}
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .nav,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .container{width:calc(100% - 20px)}
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .vano-brand-wordmark{width:108px;max-height:30px}
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .nav-actions .hide-mobile{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .nav-actions{gap:5px}
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .btn-sm{min-height:36px;padding-inline:10px;font-size:11px}
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .page{min-height:calc(100dvh - 58px);padding:18px 0 92px}
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .page-head{align-items:flex-start;flex-direction:column;margin-bottom:16px}
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .page-title,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .title{font-size:28px;letter-spacing:-1px}
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .panel{border-radius:18px}body.vano-app-root:not(.vano-route-onboarding) .panel-head{padding:15px}body.vano-app-root:not(.vano-route-onboarding) .panel-body{padding:15px}
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface footer{display:none}
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .auth-wrap{min-height:calc(100dvh - 58px);padding:18px 10px 92px;place-items:start center}
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .auth-card{margin-top:4vh;padding:21px 17px;border-radius:21px}
  body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding .onboard{padding:14px 10px 94px}
  body.vano-app-root:not(.vano-route-onboarding).vano-route-onboarding .ob-shell{border-radius:20px}
  body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-shell{gap:10px}
  body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-hero{border-radius:19px!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-identity{align-items:center!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v108-quicknav{grid-template-columns:1fr!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-detail{border-radius:16px!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-route-profile .profile-v72-detail>summary{min-height:64px!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-route-admin-users .users-table tr{border-color:var(--v258-line)!important;background:var(--v258-surface)!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .account-drawer{left:7px!important;right:7px!important;top:auto!important;bottom:max(7px,env(safe-area-inset-bottom))!important;width:auto!important;max-width:none!important;max-height:min(84dvh,720px)!important;border-radius:25px!important;padding:9px 11px max(12px,env(safe-area-inset-bottom))!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-list{grid-template-columns:1fr 1fr!important}
}
@media(max-width:390px){
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .nav-actions>a.btn-primary{padding-inline:9px;font-size:10px}
  body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-user{grid-template-columns:48px minmax(0,1fr)!important}body.vano-app-root:not(.vano-route-onboarding) .drawer-avatar{width:48px!important;height:48px!important}body.vano-app-root:not(.vano-route-onboarding) .drawer-profile{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .drawer-link{min-height:61px!important;padding:9px!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-map-surface .guest-drawer-benefits{grid-template-columns:1fr!important}body.vano-app-root:not(.vano-route-onboarding) .guest-drawer-benefits span{min-height:45px!important;flex-direction:row!important;align-items:center!important;justify-content:flex-start!important}
}
@media(prefers-reduced-motion:reduce){
  body.vano-app-root:not(.vano-route-onboarding).vano-page-surface *,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface *::before,
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface *::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}

/* --------------------------- Standalone login --------------------------- */
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258{
  margin:0!important;min-height:100dvh!important;background:#f7f5f2!important;color:#27231f!important;
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif!important;overflow-x:hidden!important
}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-login-v258{background:#151310!important;color:#fff9f4!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-page{min-height:100dvh!important;padding:14px!important;display:flex!important;align-items:stretch!important;background:transparent!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-shell{width:min(1480px,100%)!important;min-height:calc(100dvh - 28px)!important;margin:auto!important;display:grid!important;grid-template-columns:minmax(390px,.88fr) minmax(470px,1.12fr)!important;border:1px solid #e8e0da!important;border-radius:30px!important;background:#fff!important;box-shadow:0 26px 90px rgba(68,48,37,.11)!important;overflow:hidden!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-pane{padding:clamp(30px,4.4vw,68px)!important;display:flex!important;flex-direction:column!important;background:#fff!important;color:#27231f!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .brand-row{display:flex!important;align-items:center!important;justify-content:flex-start!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .vano-auth-banner-clean{display:block!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .vano-auth-banner{width:min(190px,48vw)!important;height:auto!important;max-height:52px!important;object-fit:contain!important;object-position:left center!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-copy{margin:auto 0!important;max-width:560px!important;padding:42px 0 30px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .eyebrow{color:#d9703f!important;font-size:10px!important;font-weight:950!important;letter-spacing:.14em!important;text-transform:uppercase!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 h1{margin:13px 0 13px!important;color:#27231f!important;font-size:clamp(38px,5vw,66px)!important;line-height:.94!important;letter-spacing:-3.2px!important;font-weight:930!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 h1 span{display:block!important;color:#d9703f!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .lead{max-width:510px!important;margin:0!important;color:#706760!important;font-size:14px!important;line-height:1.62!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-actions{width:100%!important;max-width:500px!important;margin-top:28px!important;display:grid!important;gap:9px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-button{width:100%!important;height:54px!important;min-height:54px!important;border-radius:15px!important;font-size:13px!important;font-weight:850!important;text-decoration:none!important;box-sizing:border-box!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-button.google{border:1px solid #e4ddd7!important;background:#fff!important;color:#27231f!important;box-shadow:0 6px 20px rgba(67,49,38,.05)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-button.google:hover{border-color:#d6cbc4!important;box-shadow:0 10px 28px rgba(67,49,38,.08)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-button.email{border:0!important;background:linear-gradient(135deg,#f59a62,#d9703f)!important;color:#fff!important;box-shadow:0 12px 28px rgba(217,112,63,.21)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-links{margin-top:3px!important;color:#91867e!important;font-size:12px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-links a{color:#3e3732!important;font-weight:900!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .guest-link{width:100%!important;height:43px!important;border:1px dashed #ddd3cc!important;border-radius:13px!important;background:#fbf9f7!important;color:#716861!important;font-size:10px!important;font-weight:850!important;text-decoration:none!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .legal{padding-top:18px!important;color:#a0968f!important;font-size:9px!important;line-height:1.5!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .legal a{color:#766c65!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .status-note{border:1px solid #d8ece2!important;background:#f2faf6!important;color:#287354!important;border-radius:13px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .route-pane{position:relative!important;min-height:100%!important;background:linear-gradient(145deg,#f1efec,#ebe8e4)!important;border-left:1px solid #e8e0da!important;overflow:hidden!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-sheet{z-index:1600!important;background:transparent!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .sheet-backdrop{background:rgba(37,30,26,.34)!important;backdrop-filter:blur(5px)!important;-webkit-backdrop-filter:blur(5px)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .sheet-card{width:min(450px,100%)!important;border:1px solid #e7ded8!important;border-radius:24px!important;background:#fff!important;color:#27231f!important;box-shadow:0 30px 90px rgba(49,35,28,.22)!important;padding:23px!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .sheet-head h2{color:#27231f!important;letter-spacing:-.8px!important}body.vano-app-root:not(.vano-route-onboarding) .sheet-head p{color:#7e746d!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .sheet-close{border-color:#e7ded8!important;background:#f8f5f2!important;color:#6b625c!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .field label{color:#5d554f!important;font-weight:800!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .field input{height:48px!important;border:1px solid #ddd3cc!important;border-radius:13px!important;background:#fff!important;color:#27231f!important;outline:0!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .field input:focus{border-color:#d9703f!important;box-shadow:0 0 0 4px rgba(217,112,63,.12)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .password-toggle{color:#81766e!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .sheet-submit{height:50px!important;border:0!important;border-radius:14px!important;background:linear-gradient(135deg,#f59a62,#d9703f)!important;color:#fff!important;font-weight:900!important;box-shadow:0 12px 28px rgba(217,112,63,.18)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .sheet-switch{color:#8b8078!important;font-size:11px!important}body.vano-app-root:not(.vano-route-onboarding) .sheet-switch a{color:#d9703f!important;font-weight:850!important}
body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .vano-auth-theme-toggle{z-index:1700!important;top:max(18px,env(safe-area-inset-top))!important;right:max(18px,env(safe-area-inset-right))!important;border:1px solid #e6ddd7!important;background:rgba(255,255,255,.92)!important;color:#5e5650!important;box-shadow:0 8px 22px rgba(67,49,38,.08)!important}

html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-shell,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-pane,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .sheet-card{border-color:#39312c!important;background:#1c1916!important;color:#fff9f4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 :is(h1,.sheet-head h2){color:#fff9f4!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 :is(.lead,.legal,.sheet-head p,.sheet-switch){color:#b4a79e!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .route-pane{border-color:#342e29!important;background:linear-gradient(145deg,#211d1a,#171411)!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 :is(.auth-button.google,.guest-link,.field input){border-color:#3d342e!important;background:#211d1a!important;color:#f9f1eb!important}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .vano-auth-theme-toggle{border-color:#3d342e!important;background:#211d1a!important;color:#d5c8bf!important}

@media(max-width:820px){
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-page{padding:0!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-shell{min-height:100dvh!important;border:0!important;border-radius:0!important;grid-template-columns:1fr!important;grid-template-rows:auto minmax(160px,28vh)!important;box-shadow:none!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-pane{order:0!important;padding:max(22px,env(safe-area-inset-top)) max(18px,env(safe-area-inset-right)) max(22px,env(safe-area-inset-bottom)) max(18px,env(safe-area-inset-left))!important;justify-content:center!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .route-pane{order:1!important;min-height:160px!important;max-height:30vh!important;border-left:0!important;border-top:1px solid #e8e0da!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-copy{margin:0!important;padding:32px 0 18px!important;max-width:none!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 h1{font-size:clamp(36px,10vw,50px)!important;letter-spacing:-2px!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .lead{font-size:13px!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-actions{max-width:none!important;margin-top:22px!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .route-summary{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-sheet{place-items:end center!important;padding:0!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .sheet-card{width:100%!important;border-radius:24px 24px 0 0!important;border-bottom:0!important;padding:20px max(18px,env(safe-area-inset-right)) max(22px,env(safe-area-inset-bottom)) max(18px,env(safe-area-inset-left))!important}
}
@media(max-width:420px){
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-pane{padding-inline:max(14px,env(safe-area-inset-left))!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-copy{padding-top:24px!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 h1{font-size:34px!important;letter-spacing:-1.6px!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .lead{font-size:12.3px!important;line-height:1.5!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .auth-button{height:50px!important;min-height:50px!important;font-size:12.5px!important}
  body.vano-app-root:not(.vano-route-onboarding).vano-login-v258 .route-pane{min-height:145px!important;max-height:22vh!important}
}

/* --------------------------- Shared/live standalone --------------------------- */
body.vano-app-root:not(.vano-route-onboarding).vano-shared-v258,
body.vano-app-root:not(.vano-route-onboarding).vano-live-v258{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif!important}
body.vano-app-root:not(.vano-route-onboarding).vano-shared-v258 :is(.route-panel,.share-top),
body.vano-app-root:not(.vano-route-onboarding).vano-live-v258 :is(.top,.card){backdrop-filter:blur(20px) saturate(135%)!important;-webkit-backdrop-filter:blur(20px) saturate(135%)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-shared-v258 .route-panel,
body.vano-app-root:not(.vano-route-onboarding).vano-live-v258 .card{border-radius:24px!important;box-shadow:0 20px 60px rgba(36,28,23,.16)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-shared-v258 .route-actions button,
body.vano-app-root:not(.vano-route-onboarding).vano-live-v258 button{border-radius:13px!important}

/* V258 hard isolation guards */
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface{background:radial-gradient(circle at 90% -10%,rgba(245,154,98,.12),transparent 28rem),radial-gradient(circle at 5% 45%,rgba(255,195,155,.08),transparent 25rem),var(--v258-bg)!important}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface::before{display:none!important;content:none!important}
body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .vano-nav-avatar{width:30px;height:30px;border-radius:10px;object-fit:cover;border:1px solid var(--v258-line);background:var(--v258-surface)}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).vano-page-surface .vano-nav-avatar{border-color:var(--v258-line-strong)}

/* V260 route HUD */
/* ================================================================
   VANO MAPS — mobile active route information card
   Final owner of the lower route HUD. Loaded after all legacy map CSS.
   ================================================================ */

@media (max-width:899px){
  body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #activeNav.nav-panel.nav-minimal{
    box-sizing:border-box!important;
    left:max(8px,calc(env(safe-area-inset-left) + 6px))!important;
    right:max(8px,calc(env(safe-area-inset-right) + 6px))!important;
    top:auto!important;
    bottom:max(5px,calc(env(safe-area-inset-bottom) + 3px))!important;
    width:auto!important;
    max-width:none!important;
    min-height:68px!important;
    margin:0!important;
    padding:6px 8px 7px!important;
    border:1px solid rgba(31,35,43,.12)!important;
    border-radius:21px!important;
    background:rgba(255,255,255,.985)!important;
    color:#17191f!important;
    box-shadow:0 10px 34px rgba(18,22,30,.14),0 2px 8px rgba(18,22,30,.06),inset 0 1px 0 rgba(255,255,255,.94)!important;
    backdrop-filter:blur(22px) saturate(128%)!important;
    -webkit-backdrop-filter:blur(22px) saturate(128%)!important;
    overflow:visible!important;
    isolation:isolate!important;
    z-index:60!important;
  }

  /* Remove the old top-only bottom-sheet accent. */
  body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #activeNav.nav-panel.nav-minimal::before{
    content:none!important;
    display:none!important;
  }

  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .vano-nav-dock-head{
    height:10px!important;
    min-height:10px!important;
    margin:0!important;
    padding:0 3px 2px!important;
    display:flex!important;
    align-items:center!important;
    justify-content:space-between!important;
  }
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .vano-nav-dock-caption{display:none!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .vano-nav-live{
    gap:5px!important;
    color:#858a93!important;
    font-size:6.8px!important;
    line-height:1!important;
    font-weight:850!important;
    letter-spacing:.11em!important;
  }
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .vano-nav-live i{
    width:5px!important;
    height:5px!important;
    flex:0 0 5px!important;
    background:#F59A62!important;
    box-shadow:0 0 0 3px rgba(245,154,98,.10)!important;
  }

  /* One clean segmented surface inside the outer card. */
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-row{
    box-sizing:border-box!important;
    min-height:48px!important;
    height:48px!important;
    margin:0!important;
    padding:0!important;
    display:grid!important;
    grid-template-columns:1.22fr .89fr .89fr!important;
    gap:0!important;
    align-items:stretch!important;
    border:1px solid rgba(31,35,43,.085)!important;
    border-radius:15px!important;
    background:linear-gradient(180deg,#fbfbfc,#f6f7f9)!important;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.95)!important;
    overflow:hidden!important;
  }

  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item,
body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary{
    box-sizing:border-box!important;
    min-width:0!important;
    min-height:46px!important;
    height:46px!important;
    margin:0!important;
    padding:6px 9px!important;
    display:flex!important;
    flex-direction:column!important;
    justify-content:center!important;
    border:0!important;
    border-radius:0!important;
    background:transparent!important;
    box-shadow:none!important;
    overflow:hidden!important;
    text-align:left!important;
  }
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item + .nav-summary-item{
    border-left:1px solid rgba(31,35,43,.075)!important;
  }
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary::after{content:none!important;display:none!important}

  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-label{
    display:flex!important;
    align-items:center!important;
    gap:4px!important;
    min-width:0!important;
    margin:0 0 3px!important;
  }
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-label svg{
    width:10px!important;
    height:10px!important;
    flex:0 0 10px!important;
    color:#8c919a!important;
    stroke-width:2.15!important;
  }
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary .nav-summary-label svg,
body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary small{color:#D9703F!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item small{
    margin:0!important;
    color:#8d929b!important;
    font-size:6.7px!important;
    line-height:1!important;
    font-weight:850!important;
    letter-spacing:.085em!important;
    white-space:nowrap!important;
  }
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item strong{
    display:block!important;
    min-width:0!important;
    margin:0!important;
    color:#202229!important;
    font-size:15px!important;
    line-height:1!important;
    font-weight:850!important;
    letter-spacing:-.035em!important;
    white-space:nowrap!important;
    overflow:hidden!important;
    text-overflow:ellipsis!important;
    font-variant-numeric:tabular-nums!important;
  }
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary strong{
    color:#202229!important;
    font-size:18px!important;
    letter-spacing:-.045em!important;
  }

  /* Keep the controls close to the lower card instead of floating too high. */
  body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #navControlStack{
    bottom:calc(max(5px,env(safe-area-inset-bottom)) + 80px)!important;
  }
  body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #vanoSpeedometerV220,
body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo{
    bottom:calc(max(5px,env(safe-area-inset-bottom)) + 80px)!important;
  }
  body.vano-app-root:not(.vano-route-onboarding).body-nav .mapboxgl-ctrl-bottom-left,
body.vano-app-root:not(.vano-route-onboarding).body-nav .mapboxgl-ctrl-bottom-right{
    bottom:calc(max(4px,env(safe-area-inset-bottom)) + 70px)!important;
  }

  /* Suggestions remain attached directly above the route card. */
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .traffic-suggestion.show,
body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .reroute.show{
    border:1px solid rgba(31,35,43,.10)!important;
    border-radius:16px!important;
  }
}

/* The Android wrapper already applies the native system-bar inset around WebView.
   Avoid counting the bottom safe area twice and seat the card a little lower. */
@media (max-width:899px){
  html.vano-native-android body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #activeNav.nav-panel.nav-minimal{
    left:7px!important;
    right:7px!important;
    bottom:2px!important;
    min-height:66px!important;
    padding:5px 7px 6px!important;
    border-radius:20px!important;
  }
  html.vano-native-android body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .vano-nav-dock-head{
    height:9px!important;
    min-height:9px!important;
    padding-bottom:1px!important;
  }
  html.vano-native-android body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-row{
    min-height:47px!important;
    height:47px!important;
  }
  html.vano-native-android body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item,
html.vano-native-android body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary{
    min-height:45px!important;
    height:45px!important;
  }
  html.vano-native-android body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #navControlStack,
html.vano-native-android body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #vanoSpeedometerV220,
html.vano-native-android body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app .floating-speedo{
    bottom:78px!important;
  }
  html.vano-native-android body.vano-app-root:not(.vano-route-onboarding).body-nav .mapboxgl-ctrl-bottom-left,
html.vano-native-android body.vano-app-root:not(.vano-route-onboarding).body-nav .mapboxgl-ctrl-bottom-right{
    bottom:68px!important;
  }
}

/* Dark mode keeps the same four-sided geometry and contrast. */
@media (max-width:899px){
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #activeNav.nav-panel.nav-minimal{
    border:1px solid rgba(255,255,255,.11)!important;
    background:linear-gradient(180deg,rgba(28,27,27,.985),rgba(20,20,21,.992))!important;
    color:#FFF9F4!important;
    box-shadow:0 12px 38px rgba(0,0,0,.38),0 2px 8px rgba(0,0,0,.20),inset 0 1px 0 rgba(255,255,255,.04)!important;
  }
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-row{
    border-color:rgba(255,255,255,.085)!important;
    background:rgba(255,255,255,.038)!important;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.025)!important;
  }
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary{
    background:transparent!important;
    border-top:0!important;
    border-right:0!important;
    border-bottom:0!important;
  }
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item + .nav-summary-item{
    border-left:1px solid rgba(255,255,255,.075)!important;
  }
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item strong,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary strong{color:#FFF9F4!important}
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item small{color:#96918c!important}
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-label svg{color:#8d8985!important}
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary .nav-summary-label svg,
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary small{color:#F59A62!important}
}

@media (max-width:380px){
  body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #activeNav.nav-panel.nav-minimal{
    left:6px!important;
    right:6px!important;
    min-height:64px!important;
    padding:5px 6px 6px!important;
    border-radius:19px!important;
  }
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .vano-nav-dock-head{height:8px!important;min-height:8px!important;padding-bottom:1px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-row{min-height:45px!important;height:45px!important;border-radius:14px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item,
body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary{min-height:43px!important;height:43px!important;padding:5px 7px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item small{font-size:6.2px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item strong{font-size:13.5px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary strong{font-size:16.5px!important}
}

/* ================================================================
   VANO — stability, mobile UX and accessibility final overrides
   ================================================================ */
body.vano-app-root:not(.vano-route-onboarding){
  --vano-touch:44px;
  --vano-topbar-h:68px;
  --vano-layer-map:0;
  --vano-layer-marker:5;
  --vano-layer-control:30;
  --vano-layer-card:40;
  --vano-layer-drawer:60;
  --vano-layer-modal:80;
  --vano-layer-toast:100;
}
html body.vano-app-root:not(.vano-route-onboarding){min-width:320px;text-size-adjust:100%;-webkit-text-size-adjust:100%;scroll-padding-top:calc(var(--vano-topbar-h) + 12px)}
body.vano-app-root:not(.vano-route-onboarding){overflow-wrap:anywhere;-webkit-tap-highlight-color:transparent}
body.vano-app-root:not(.vano-route-onboarding) button,
body.vano-app-root:not(.vano-route-onboarding) a,
body.vano-app-root:not(.vano-route-onboarding) input,
body.vano-app-root:not(.vano-route-onboarding) select,
body.vano-app-root:not(.vano-route-onboarding) textarea,
body.vano-app-root:not(.vano-route-onboarding) [role="button"]{touch-action:manipulation}
body.vano-app-root:not(.vano-route-onboarding) button:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) a:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) input:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) select:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) textarea:focus-visible,
body.vano-app-root:not(.vano-route-onboarding) [tabindex]:focus-visible{outline:3px solid rgba(245,154,98,.38)!important;outline-offset:2px!important}
body.vano-app-root:not(.vano-route-onboarding) img,
body.vano-app-root:not(.vano-route-onboarding) svg,
body.vano-app-root:not(.vano-route-onboarding) video,
body.vano-app-root:not(.vano-route-onboarding) canvas{max-width:100%}
body.vano-app-root:not(.vano-route-onboarding) img{height:auto}
body.vano-app-root:not(.vano-route-onboarding) input,
body.vano-app-root:not(.vano-route-onboarding) select,
body.vano-app-root:not(.vano-route-onboarding) textarea{max-width:100%}
body.vano-app-root:not(.vano-route-onboarding) button:disabled,
body.vano-app-root:not(.vano-route-onboarding) [aria-disabled="true"]{cursor:not-allowed;opacity:.58}

/* Avoid iOS form zoom and improve tap targets without making dense desktop UI huge. */
@media(max-width:899px){
  body.vano-app-root:not(.vano-route-onboarding) input,
body.vano-app-root:not(.vano-route-onboarding) select,
body.vano-app-root:not(.vano-route-onboarding) textarea{font-size:16px!important}
  body.vano-app-root:not(.vano-route-onboarding) .btn,
body.vano-app-root:not(.vano-route-onboarding) .mobile-dock a,
body.vano-app-root:not(.vano-route-onboarding) .vano-theme-toggle{min-height:var(--vano-touch)}
  body.vano-app-root:not(.vano-route-onboarding) .container,
body.vano-app-root:not(.vano-route-onboarding) .nav{max-width:100%}
  body.vano-app-root:not(.vano-route-onboarding){padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right)}
}

/* The Mapbox DOM must never escape above application drawers/modals. */
body.vano-app-root:not(.vano-route-onboarding) .ws-app,
body.vano-app-root:not(.vano-route-onboarding) #map,
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-map{isolation:isolate;z-index:var(--vano-layer-map)!important}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker,
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker.vano-user-puck-v300,
body.vano-app-root:not(.vano-route-onboarding) .vano-user-puck-v300,
body.vano-app-root:not(.vano-route-onboarding) .user-marker,
body.vano-app-root:not(.vano-route-onboarding) .vano-uploaded-user{z-index:var(--vano-layer-marker)!important}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker{pointer-events:none}
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker [data-vano-interactive-marker],
body.vano-app-root:not(.vano-route-onboarding) .mapboxgl-marker.vano-alert-marker{pointer-events:auto}
body.vano-app-root:not(.vano-route-onboarding) .account-drawer,
body.vano-app-root:not(.vano-route-onboarding) .vano-routine-sheet,
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-sheet{z-index:var(--vano-layer-drawer)!important}
body.vano-app-root:not(.vano-route-onboarding) .token-overlay,
body.vano-app-root:not(.vano-route-onboarding) .guest-limit-modal,
body.vano-app-root:not(.vano-route-onboarding) .vano-arrival,
body.vano-app-root:not(.vano-route-onboarding) .route-loading-overlay{z-index:var(--vano-layer-modal)!important}
body.vano-app-root:not(.vano-route-onboarding) .flash-wrap,
body.vano-app-root:not(.vano-route-onboarding) .vano-global-toasts{z-index:var(--vano-layer-toast)!important}

/* Adaptive brand: no white/black wordmark mismatch between themes. */
body.vano-app-root:not(.vano-route-onboarding) .vano-adaptive-brand{display:inline-grid;align-items:center}
body.vano-app-root:not(.vano-route-onboarding) .vano-adaptive-brand .vano-brand-img{grid-area:1/1;display:block;max-height:42px;width:auto}
body.vano-app-root:not(.vano-route-onboarding) .vano-brand-img-dark{opacity:0;visibility:hidden}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-brand-img-light{opacity:0;visibility:hidden}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-brand-img-dark{opacity:1;visibility:visible}

/* Navigation route card: four real borders, readable typography, less GPU blur. */
@media(max-width:899px){
  body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #activeNav.nav-panel.nav-minimal{
    border:1px solid rgba(31,35,43,.14)!important;
    border-radius:20px!important;
    backdrop-filter:blur(10px) saturate(112%)!important;
    -webkit-backdrop-filter:blur(10px) saturate(112%)!important;
    overflow:hidden!important;
  }
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .vano-nav-live{font-size:9px!important;letter-spacing:.08em!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item small{font-size:9px!important;letter-spacing:.055em!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item strong{font-size:15px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary strong{font-size:18px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item{padding-inline:8px!important}
  html.vano-native-android body.vano-app-root:not(.vano-route-onboarding).body-nav .ws-app #activeNav.nav-panel.nav-minimal{bottom:3px!important}
}
@media(max-width:370px){
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item small{font-size:9px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-item strong{font-size:13.5px!important}
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav .nav-summary-primary strong{font-size:16.5px!important}
}

/* Stable viewport / keyboards / drawers. */
body.vano-app-root:not(.vano-route-onboarding) .ws-app{height:100vh!important;height:100svh!important;height:100dvh!important}
body.vano-app-root:not(.vano-route-onboarding) .account-drawer,
body.vano-app-root:not(.vano-route-onboarding) .vano-routine-card,
body.vano-app-root:not(.vano-route-onboarding) .quick-alert-card{max-height:calc(100dvh - env(safe-area-inset-top) - 12px);overflow:auto;overscroll-behavior:contain}
@supports not (height:100dvh){body.vano-app-root:not(.vano-route-onboarding) .ws-app{height:100vh!important}}

/* Page surfaces: prevent accidental map/body overflow. */
body.vano-app-root:not(.vano-route-onboarding) .vano-page-surface .page,
body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface .page{min-width:0}
body.vano-app-root:not(.vano-route-onboarding) .vano-page-surface .panel,
body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface .panel{min-width:0}
body.vano-app-root:not(.vano-route-onboarding) .table-wrap{max-width:100%;overflow:auto;-webkit-overflow-scrolling:touch}
body.vano-app-root:not(.vano-route-onboarding) .table{border-collapse:separate;border-spacing:0}
body.vano-app-root:not(.vano-route-onboarding) .table th{position:relative}

/* Forms and profile polish. */
body.vano-app-root:not(.vano-route-onboarding) .profile-v72-field input,
body.vano-app-root:not(.vano-route-onboarding) .profile-v72-field select,
body.vano-app-root:not(.vano-route-onboarding) .profile-v72-place input{min-height:46px}
body.vano-app-root:not(.vano-route-onboarding) .profile-v72-nav-pref{min-height:56px}
body.vano-app-root:not(.vano-route-onboarding) .profile-v72-nav-pref input:focus-visible + .profile-v72-switch{outline:3px solid rgba(245,154,98,.35);outline-offset:3px}
body.vano-app-root:not(.vano-route-onboarding) .profile-v72-save{min-height:50px}
body.vano-app-root:not(.vano-route-onboarding) .profile-v72-detail summary{min-height:58px}
body.vano-app-root:not(.vano-route-onboarding) .profile-v72-detail summary::-webkit-details-marker{display:none}

/* Account danger zone. */
body.vano-app-root:not(.vano-route-onboarding) .profile-danger-zone{margin-top:18px;border:1px solid rgba(220,76,76,.20);background:rgba(220,76,76,.045);border-radius:20px;padding:18px}
body.vano-app-root:not(.vano-route-onboarding) .profile-danger-zone h2{margin:0 0 7px;font-size:17px}body.vano-app-root:not(.vano-route-onboarding) .profile-danger-zone p{margin:0 0 14px;color:var(--muted);font-size:13px;line-height:1.55}
body.vano-app-root:not(.vano-route-onboarding) .profile-danger-zone form{display:grid;gap:10px}body.vano-app-root:not(.vano-route-onboarding) .profile-danger-zone input{min-height:46px;border-radius:12px;border:1px solid var(--vano-line,#ddd);padding:0 12px;background:var(--surface,#fff);color:var(--text,#222)}
body.vano-app-root:not(.vano-route-onboarding) .profile-danger-zone .danger-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}

/* Global non-blocking feedback. */
body.vano-app-root:not(.vano-route-onboarding) .vano-global-toasts{position:fixed;right:max(12px,env(safe-area-inset-right));top:calc(env(safe-area-inset-top) + 14px);width:min(360px,calc(100vw - 24px));display:grid;gap:8px;pointer-events:none}
body.vano-app-root:not(.vano-route-onboarding) .vano-global-toast{display:flex;gap:10px;align-items:center;justify-content:space-between;padding:12px 13px;border:1px solid rgba(255,255,255,.10);border-radius:14px;background:rgba(25,25,27,.96);color:#fff;box-shadow:0 14px 42px rgba(0,0,0,.22);transform:translateY(-8px);opacity:0;transition:.18s ease;pointer-events:auto;font-size:13px}
body.vano-app-root:not(.vano-route-onboarding) .vano-global-toast.show{opacity:1;transform:none}body.vano-app-root:not(.vano-route-onboarding) .vano-global-toast.is-success{border-color:rgba(53,199,131,.28)}body.vano-app-root:not(.vano-route-onboarding) .vano-global-toast.is-error{border-color:rgba(255,83,83,.35)}body.vano-app-root:not(.vano-route-onboarding) .vano-global-toast button{width:34px;height:34px;border:0;border-radius:10px;background:transparent;color:inherit;font-size:22px}
body.vano-app-root:not(.vano-route-onboarding) .vano-confirm-overlay{position:fixed;inset:0;z-index:var(--vano-layer-modal);display:grid;place-items:center;padding:18px;background:rgba(0,0,0,.44);backdrop-filter:blur(6px)}
body.vano-app-root:not(.vano-route-onboarding) .vano-confirm-card{width:min(420px,100%);border:1px solid rgba(255,255,255,.10);border-radius:22px;padding:20px;background:#fff;color:#24201d;box-shadow:0 24px 80px rgba(0,0,0,.28)}
body.vano-app-root:not(.vano-route-onboarding) .vano-confirm-card h2{margin:0 0 7px;font-size:20px}body.vano-app-root:not(.vano-route-onboarding) .vano-confirm-card p{margin:0 0 18px;color:#706861;line-height:1.5}body.vano-app-root:not(.vano-route-onboarding) .vano-confirm-card>div{display:flex;justify-content:flex-end;gap:8px}body.vano-app-root:not(.vano-route-onboarding) .vano-confirm-card button{min-height:44px;border:1px solid #e6ddd6;border-radius:12px;padding:0 15px;background:#f7f4f1;color:#2b2724;font-weight:750}body.vano-app-root:not(.vano-route-onboarding) .vano-confirm-card button[data-confirm]{background:#F59A62;color:#fff;border-color:#F59A62}body.vano-app-root:not(.vano-route-onboarding) .vano-confirm-card button.danger{background:#c94747;border-color:#c94747}
html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-confirm-card{background:#211e1b;color:#fff9f4;border-color:#3a342f}html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-confirm-card p{color:#c5bbb4}html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding) .vano-confirm-card button{background:#2b2724;color:#fff9f4;border-color:#433b35}

/* Error screens should look intentional rather than like framework pages. */
body.vano-app-root:not(.vano-route-onboarding) .code-num{font-size:clamp(48px,10vw,92px);font-weight:900;letter-spacing:-.07em;color:#F59A62;line-height:.9}

/* Admin: controls should remain clickable above decorative layers. */
body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface .topbar{z-index:50}body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface .panel,
body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface .btn,
body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface button,
body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface a{position:relative}body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface [role="dialog"]{z-index:80}

/* Accessibility and power saving. */
@media(prefers-reduced-motion:reduce){
  body.vano-app-root:not(.vano-route-onboarding) *,
body.vano-app-root:not(.vano-route-onboarding) *::before,
body.vano-app-root:not(.vano-route-onboarding) *::after{scroll-behavior:auto!important;animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}
}
@media(forced-colors:active){body.vano-app-root:not(.vano-route-onboarding) button,
body.vano-app-root:not(.vano-route-onboarding) a,
body.vano-app-root:not(.vano-route-onboarding) input,
body.vano-app-root:not(.vano-route-onboarding) select,
body.vano-app-root:not(.vano-route-onboarding) textarea{forced-color-adjust:auto}body.vano-app-root:not(.vano-route-onboarding) .vano-brand-img{forced-color-adjust:none}}
/* Admin readability floor — prevents 6px metadata on phones/high-density screens. */
body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface .tiny,
body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface small,
body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface .fact small{font-size:max(9px,.65rem)!important}body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface .fact b,
body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface .detail-item span,
body.vano-app-root:not(.vano-route-onboarding) .vano-admin-surface .detail-item em{font-size:max(10px,.7rem)!important}

/* V262: route dock full-perimeter geometry (moved from ignored child-template tail). */
@media(max-width:899px){
  body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav.nav-panel.nav-minimal{left:7px!important;right:7px!important;width:auto!important;max-width:none!important;border-radius:20px!important}
  html[data-vano-theme="black"] body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav.nav-panel.nav-minimal{border:1px solid rgba(255,255,255,.11)!important}
}
@media(max-width:380px){body.vano-app-root:not(.vano-route-onboarding).body-nav #activeNav.nav-panel.nav-minimal{left:6px!important;right:6px!important;border-radius:19px!important}}

/* ============================================================
   VANO — global finishing pass
   Small, low-risk interaction/accessibility improvements shared by the app.
   ============================================================ */
body.vano-app-root:not(.vano-route-onboarding) .vano-app-root :is(button,a,[role="button"],input,select,textarea){
  -webkit-tap-highlight-color:transparent;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-app-root :is(button,a,[role="button"]){
  touch-action:manipulation;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-app-root button:not(:disabled),
body.vano-app-root:not(.vano-route-onboarding) .vano-app-root [role="button"]:not([aria-disabled="true"]){cursor:pointer}
body.vano-app-root:not(.vano-route-onboarding) .vano-app-root :is(button,input,select,textarea,a):focus-visible{
  outline:3px solid rgba(217,112,63,.28);
  outline-offset:2px;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-app-root :is(button,input,select,textarea):disabled,
body.vano-app-root:not(.vano-route-onboarding) .vano-app-root [aria-disabled="true"]{
  cursor:not-allowed!important;
  opacity:.56;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-app-root :is(.panel,.card,.auth-card,.sheet,.account-drawer,.prefs-drawer,.safety-drawer,.destination-confirm){
  min-width:0;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-app-root :is(h1,h2,h3,.page-title,.planner-heading-copy b,.route-head h2){
  text-wrap:balance;
}
body.vano-app-root:not(.vano-route-onboarding) .vano-app-root img{max-width:100%}
body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.map-btn,.options-btn,.floating-locate,.nav-stack-btn,.nav-audio-toggle,.row-btn,.planner-adjust-btn){
  will-change:transform;
}
@media(hover:hover) and (pointer:fine){
  body.vano-app-root:not(.vano-route-onboarding) .ws-app :is(.map-btn,.options-btn,.floating-locate,.nav-stack-btn,.nav-audio-toggle,.row-btn):hover{
    transform:translateY(-1px);
  }
}
@media(prefers-reduced-motion:reduce){
  body.vano-app-root:not(.vano-route-onboarding) .vano-app-root :is(.map-btn,.options-btn,.floating-locate,.nav-stack-btn,.nav-audio-toggle,.row-btn,.planner-adjust-btn){will-change:auto}
}


/* ===== static/vano-map.css ===== */
/* VANO MAPS V300 — single map UI layer
   Loaded after vano-app.css. This file owns the map surface layout,
   planner, route-ready state and active-navigation HUD. */

body.vano-map-surface{
  --vano-accent:#f47a45;
  --vano-accent-strong:#dd6534;
  --vano-accent-soft:#fff1e9;
  --vano-ink:#191c22;
  --vano-muted:#737984;
  --vano-line:rgba(28,33,42,.10);
  --vano-surface:rgba(255,255,255,.965);
  --vano-surface-solid:#fff;
  --vano-surface-soft:#f5f6f8;
  --vano-shadow:0 14px 44px rgba(22,27,36,.16),0 2px 10px rgba(22,27,36,.08);
  --vano-shadow-soft:0 8px 24px rgba(22,27,36,.11),0 1px 5px rgba(22,27,36,.06);
  --vano-safe-t:max(10px,env(safe-area-inset-top));
  --vano-safe-b:max(10px,env(safe-area-inset-bottom));
  --vano-safe-l:max(10px,env(safe-area-inset-left));
  --vano-safe-r:max(10px,env(safe-area-inset-right));
  --vano-nav-card-h:78px;
}

html body.vano-map-surface,
body.vano-map-surface.vano-map-surface,
body.vano-map-surface.vano-map-surface .ws-app{width:100%;height:100%;min-height:100%;overflow:hidden}
body.vano-map-surface.vano-map-surface{margin:0;background:#e9eaec;overscroll-behavior:none;touch-action:manipulation}
body.vano-map-surface.vano-map-surface::before{display:none!important}
body.vano-map-surface.vano-map-surface .topbar,
body.vano-map-surface.vano-map-surface .mobile-dock{display:none!important}
body.vano-map-surface.vano-map-surface .ws-app{position:fixed!important;inset:0!important;isolation:isolate;background:#e9eaec}
body.vano-map-surface.vano-map-surface #map{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;z-index:0;background:#e9eaec}
body.vano-map-surface.vano-map-surface .mapboxgl-canvas{outline:none}
body.vano-map-surface.vano-map-surface button{-webkit-tap-highlight-color:transparent}
body.vano-map-surface.vano-map-surface button:focus-visible{outline:3px solid rgba(244,122,69,.32);outline-offset:2px}

/* Keep the map visually clean without turning off required provider attribution. */
body.vano-map-surface.vano-map-surface .mapboxgl-ctrl-logo{transform:scale(.76);transform-origin:left bottom;opacity:.72}
body.vano-map-surface.vano-map-surface .mapboxgl-ctrl-attrib{font-size:9px!important;opacity:.74}
body.vano-map-surface.vano-map-surface .mapboxgl-ctrl-bottom-left{left:var(--vano-safe-l);bottom:calc(var(--vano-safe-b) + 2px)}
body.vano-map-surface.vano-map-surface .mapboxgl-ctrl-bottom-right{right:var(--vano-safe-r);bottom:calc(var(--vano-safe-b) + 2px)}

/* Ambient overlays are intentionally subtle. The map must remain the interface. */
body.vano-map-surface.vano-map-surface .map-vignette{position:absolute;inset:0;z-index:3;pointer-events:none;background:linear-gradient(180deg,rgba(11,15,22,.05),transparent 14%,transparent 72%,rgba(11,15,22,.07));opacity:.38}
body.vano-map-surface.vano-map-surface .map-mood-fade,
body.vano-map-surface.vano-map-surface .ambient-halo{pointer-events:none}
body.vano-map-surface.vano-map-surface .road-mood-hint{display:none!important}

/* ---------- General floating controls ---------- */
body.vano-map-surface.vano-map-surface .floating-locate,
body.vano-map-surface.vano-map-surface .map-btn,
body.vano-map-surface.vano-map-surface .nav-stack-btn,
body.vano-map-surface.vano-map-surface .nav-audio-toggle,
body.vano-map-surface.vano-map-surface .nav-drawer-toggle,
body.vano-map-surface.vano-map-surface .nav-drawer-btn,
body.vano-map-surface.vano-map-surface .floating-preview-cancel{
  border:1px solid rgba(25,29,37,.10)!important;
  background:rgba(255,255,255,.95)!important;
  color:#23272e!important;
  box-shadow:var(--vano-shadow-soft)!important;
  backdrop-filter:blur(14px) saturate(130%);
  -webkit-backdrop-filter:blur(14px) saturate(130%);
}
body.vano-map-surface.vano-map-surface .floating-locate:active,
body.vano-map-surface.vano-map-surface .map-btn:active,
body.vano-map-surface.vano-map-surface .nav-stack-btn:active,
body.vano-map-surface.vano-map-surface .nav-audio-toggle:active,
body.vano-map-surface.vano-map-surface .nav-drawer-toggle:active,
body.vano-map-surface.vano-map-surface .nav-drawer-btn:active{transform:scale(.92)!important}

body.vano-map-surface.vano-map-surface .floating-locate{
  position:absolute!important;z-index:42!important;
  right:var(--vano-safe-r)!important;bottom:calc(var(--vano-safe-b) + 124px)!important;
  width:46px!important;height:46px!important;min-width:46px!important;min-height:46px!important;
  display:grid!important;place-items:center!important;border-radius:15px!important;padding:0!important;
}
body.vano-map-surface.vano-map-surface .map-tools{position:absolute!important;z-index:40!important;right:var(--vano-safe-r)!important;top:calc(var(--vano-safe-t) + 2px)!important;display:flex!important;gap:8px!important}
body.vano-map-surface.vano-map-surface .map-tools .map-btn{width:43px!important;height:43px!important;display:grid!important;place-items:center!important;border-radius:14px!important;padding:0!important}

/* ---------- Planner ---------- */
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet{
  position:absolute!important;z-index:35!important;
  left:max(10px,calc(env(safe-area-inset-left) + 8px))!important;
  right:max(10px,calc(env(safe-area-inset-right) + 8px))!important;
  bottom:max(10px,calc(env(safe-area-inset-bottom) + 8px))!important;
  top:auto!important;width:auto!important;
  max-height:min(76dvh,680px)!important;
  overflow:hidden auto!important;overscroll-behavior:contain;
  padding:7px 10px 12px!important;
  border:1px solid var(--vano-line)!important;border-radius:25px!important;
  background:var(--vano-surface)!important;color:var(--vano-ink)!important;
  box-shadow:var(--vano-shadow)!important;
  backdrop-filter:blur(20px) saturate(128%);-webkit-backdrop-filter:blur(20px) saturate(128%);
  transition:transform .28s cubic-bezier(.2,.8,.2,1),max-height .28s cubic-bezier(.2,.8,.2,1),opacity .18s ease!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.hidden{transform:translate3d(0,calc(100% + 40px),0)!important;opacity:0!important;pointer-events:none!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-collapsed{height:132px!important;min-height:132px!important;max-height:132px!important;overflow:visible!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-dragging{transition:none!important}

body.vano-map-surface #planSheet .vano-planner-toggle-v221{
  appearance:none!important;display:grid!important;place-items:center!important;
  width:72px!important;height:25px!important;min-width:72px!important;min-height:25px!important;
  margin:0 auto 5px!important;padding:0!important;border:0!important;border-radius:999px!important;
  background:rgba(105,112,123,.10)!important;color:#757b85!important;box-shadow:none!important;touch-action:none!important;
}
body.vano-map-surface #planSheet .vano-planner-toggle-chevron{width:9px!important;height:9px!important;border-left:2px solid currentColor!important;border-top:2px solid currentColor!important;transform:translateY(2px) rotate(45deg)!important;transition:transform .22s ease!important}
body.vano-map-surface #planSheet:not(.sheet-collapsed) .vano-planner-toggle-chevron{transform:translateY(-2px) rotate(225deg)!important}
body.vano-map-surface #planSheet.sheet-collapsed .planner-presets,
body.vano-map-surface #planSheet.sheet-collapsed .planner-expanded{display:none!important}
body.vano-map-surface #planSheet.sheet-collapsed .planner-heading{margin:0 4px 7px!important;min-height:20px!important}
body.vano-map-surface #planSheet.sheet-collapsed .planner-heading-copy small,
body.vano-map-surface #planSheet.sheet-collapsed .planner-weather{display:none!important}
body.vano-map-surface #planSheet.sheet-collapsed .planner-heading-copy b{font-size:17px!important;letter-spacing:-.35px!important}

body.vano-map-surface.vano-map-surface .planner-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:3px 4px 10px}
body.vano-map-surface.vano-map-surface .planner-heading-copy{display:flex;flex-direction:column;gap:2px}
body.vano-map-surface.vano-map-surface .planner-heading-copy small{font-size:9px;letter-spacing:.14em;font-weight:850;color:var(--vano-accent-strong)}
body.vano-map-surface.vano-map-surface .planner-heading-copy b{font-size:19px;line-height:1.1;letter-spacing:-.5px;color:var(--vano-ink)}
body.vano-map-surface.vano-map-surface .planner-search-row{display:grid!important;grid-template-columns:minmax(0,1fr) 54px!important;gap:8px!important;align-items:stretch!important}
body.vano-map-surface.vano-map-surface .planner-search-card{margin:0!important;padding:0!important;border:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important}
body.vano-map-surface.vano-map-surface .planner-location-row{height:54px!important;min-height:54px!important;border:1px solid rgba(27,31,38,.09)!important;border-radius:17px!important;background:#f5f6f8!important;display:flex!important;align-items:center!important;padding:0 7px 0 14px!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.9)!important}
body.vano-map-surface.vano-map-surface .planner-location-row:focus-within{border-color:rgba(244,122,69,.42)!important;background:#fff!important;box-shadow:0 0 0 3px rgba(244,122,69,.09)!important}
body.vano-map-surface.vano-map-surface .planner-search-icon{display:grid;place-items:center;color:#767d88;margin-right:9px}
body.vano-map-surface.vano-map-surface #destinationInput{min-width:0!important;flex:1!important;height:100%!important;border:0!important;outline:0!important;background:transparent!important;color:#20242b!important;font-size:16px!important;font-weight:650!important;padding:0!important;box-shadow:none!important}
body.vano-map-surface.vano-map-surface #destinationInput::placeholder{color:#777e88;opacity:1}
body.vano-map-surface.vano-map-surface .voice-search-btn{width:38px!important;height:38px!important;min-width:38px!important;border:0!important;border-radius:12px!important;background:#fff!important;color:#4c525c!important;display:grid!important;place-items:center!important;box-shadow:0 2px 8px rgba(22,27,36,.07)!important}
body.vano-map-surface.vano-map-surface .planner-adjust-btn{height:54px!important;border:1px solid rgba(27,31,38,.09)!important;border-radius:17px!important;background:#fff!important;color:#31363e!important;display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:2px!important;font-size:9px!important;font-weight:800!important;box-shadow:none!important}
body.vano-map-surface.vano-map-surface .planner-capabilities{display:flex!important;gap:6px!important;overflow-x:auto!important;scrollbar-width:none!important;padding:9px 1px 0!important}
body.vano-map-surface.vano-map-surface .planner-capabilities::-webkit-scrollbar{display:none}
body.vano-map-surface.vano-map-surface .planner-capabilities span{flex:0 0 auto!important;display:inline-flex!important;align-items:center!important;gap:5px!important;padding:6px 8px!important;border-radius:999px!important;background:#f7f7f8!important;border:1px solid rgba(24,29,37,.06)!important;color:#747a84!important;font-size:10px!important;font-weight:720!important}
body.vano-map-surface.vano-map-surface .planner-capabilities svg{color:var(--vano-accent)}
body.vano-map-surface.vano-map-surface .planner-presets{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important;margin-top:11px!important}
body.vano-map-surface.vano-map-surface .planner-preset{min-height:61px!important;border:1px solid rgba(24,29,37,.07)!important;border-radius:17px!important;background:#fff!important;color:var(--vano-ink)!important;padding:9px 10px!important;display:flex!important;align-items:center!important;gap:9px!important;text-align:left!important;box-shadow:none!important}
body.vano-map-surface.vano-map-surface .planner-preset-icon{width:34px!important;height:34px!important;min-width:34px!important;border-radius:11px!important;display:grid!important;place-items:center!important;background:var(--vano-accent-soft)!important;color:var(--vano-accent-strong)!important}
body.vano-map-surface.vano-map-surface .planner-preset b{font-size:12px!important}
body.vano-map-surface.vano-map-surface .planner-preset small{font-size:9px!important;color:#8a9099!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;display:block!important;max-width:145px!important}
body.vano-map-surface.vano-map-surface .planner-expanded{padding-top:14px!important}
body.vano-map-surface.vano-map-surface .nearby-services{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:7px!important}
body.vano-map-surface.vano-map-surface .nearby-service{min-width:0!important;min-height:76px!important;border:1px solid rgba(24,29,37,.07)!important;border-radius:16px!important;background:#fff!important;color:#252a31!important;padding:8px 5px!important;display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:3px!important;box-shadow:none!important}
body.vano-map-surface.vano-map-surface .nearby-service-icon{width:31px!important;height:31px!important;border-radius:10px!important;background:#f5f6f8!important;display:grid!important;place-items:center!important;color:#565d67!important}
body.vano-map-surface.vano-map-surface .nearby-service b{font-size:10px!important}
body.vano-map-surface.vano-map-surface .nearby-service small{font-size:8px!important;color:#9399a1!important}

/* Search results always attach to the search field, never to the viewport. */
body.vano-map-surface.vano-map-surface #searchResults{position:absolute!important;left:0!important;right:0!important;top:calc(100% + 7px)!important;z-index:90!important;max-height:min(42dvh,360px)!important;overflow:auto!important;border:1px solid rgba(24,29,37,.09)!important;border-radius:17px!important;background:#fff!important;box-shadow:0 16px 42px rgba(20,25,34,.18)!important}
body.vano-map-surface.vano-map-surface .planner-search-card{position:relative!important;z-index:2!important}

/* ---------- Route ready ---------- */
body.vano-map-surface.vano-map-surface #routeState{color:var(--vano-ink)}
body.vano-map-surface.vano-map-surface #routeState .vano-route-hero{padding:4px 4px 8px!important;background:transparent!important;border:0!important;box-shadow:none!important}
body.vano-map-surface.vano-map-surface #routeState .route-head{display:flex!important;align-items:flex-start!important;justify-content:space-between!important;gap:14px!important}
body.vano-map-surface.vano-map-surface #routeState .vr-copy{min-width:0}
body.vano-map-surface.vano-map-surface #routeState .vr-eyebrow{font-size:8px!important;letter-spacing:.14em!important;font-weight:850!important;color:var(--vano-accent-strong)!important}
body.vano-map-surface.vano-map-surface #routeState h2{margin:3px 0 2px!important;font-size:21px!important;line-height:1.06!important;letter-spacing:-.7px!important;color:#1d2127!important}
body.vano-map-surface.vano-map-surface #routeState #routeSubtitle{margin:0!important;font-size:11px!important;color:#818791!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-decision{margin-top:7px!important;width:max-content!important;display:inline-flex!important;align-items:center!important;gap:5px!important;padding:5px 8px!important;border-radius:999px!important;background:var(--vano-accent-soft)!important;color:var(--vano-accent-strong)!important;font-size:9px!important;font-weight:800!important}
body.vano-map-surface.vano-map-surface #routeState .route-time{text-align:right!important;display:flex!important;flex-direction:column!important;align-items:flex-end!important;gap:1px!important;flex:0 0 auto!important}
body.vano-map-surface.vano-map-surface #routeState .route-time span{font-size:25px!important;line-height:1!important;letter-spacing:-1.2px!important;font-weight:850!important;color:#1d2127!important}
body.vano-map-surface.vano-map-surface #routeState .route-time small{font-size:10px!important;color:#848a94!important;font-weight:700!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-mode-row{margin:4px 0 9px!important}
body.vano-map-surface.vano-map-surface #routeModeSegment{display:grid!important;grid-template-columns:1fr 1fr!important;gap:6px!important;padding:4px!important;border-radius:16px!important;background:#f1f2f4!important;border:1px solid rgba(24,29,37,.05)!important}
body.vano-map-surface.vano-map-surface #routeModeSegment button{min-height:45px!important;border:0!important;border-radius:12px!important;background:transparent!important;color:#666d77!important;box-shadow:none!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;padding:6px 8px!important}
body.vano-map-surface.vano-map-surface #routeModeSegment button.active{background:#fff!important;color:#20242a!important;box-shadow:0 2px 8px rgba(21,26,34,.07)!important}
body.vano-map-surface.vano-map-surface #routeModeSegment .route-option-icon{color:var(--vano-accent-strong)!important}
body.vano-map-surface.vano-map-surface #routeModeSegment .route-option-copy{display:flex!important;flex-direction:column!important;align-items:flex-start!important;line-height:1.05!important}
body.vano-map-surface.vano-map-surface #routeModeSegment .route-option-copy b{font-size:11px!important}
body.vano-map-surface.vano-map-surface #routeModeSegment .route-option-copy small{font-size:8px!important;color:#969ca4!important}
body.vano-map-surface.vano-map-surface #routeState .vano-alternatives-head{display:flex!important;align-items:center!important;justify-content:space-between!important;margin:7px 3px 5px!important;color:#5f6670!important;font-size:10px!important;font-weight:800!important}
body.vano-map-surface.vano-map-surface #routeState .vano-alternatives-head small{font-size:8px!important;color:#a0a5ad!important;font-weight:700!important}
body.vano-map-surface.vano-map-surface #routeVariants{display:grid!important;gap:6px!important;max-height:150px!important;overflow:auto!important;scrollbar-width:none!important}
body.vano-map-surface.vano-map-surface #routeVariants::-webkit-scrollbar{display:none}
body.vano-map-surface.vano-map-surface #startTripBtn{width:100%!important;min-height:54px!important;margin-top:9px!important;border:0!important;border-radius:17px!important;background:var(--vano-accent)!important;color:#fff!important;display:grid!important;grid-template-columns:38px 1fr 20px!important;align-items:center!important;gap:8px!important;padding:8px 12px!important;box-shadow:0 10px 24px rgba(244,122,69,.28)!important;text-align:left!important}
body.vano-map-surface.vano-map-surface #startTripBtn .start-trip-icon{width:34px!important;height:34px!important;border-radius:11px!important;background:rgba(255,255,255,.17)!important;display:grid!important;place-items:center!important}
body.vano-map-surface.vano-map-surface #startTripBtn .start-trip-copy{display:flex!important;flex-direction:column!important;gap:1px!important}
body.vano-map-surface.vano-map-surface #startTripBtn .start-trip-copy b{font-size:14px!important}
body.vano-map-surface.vano-map-surface #startTripBtn .start-trip-copy small{font-size:9px!important;color:rgba(255,255,255,.76)!important}
body.vano-map-surface.vano-map-surface #startTripBtn .start-trip-arrow{font-size:23px!important;text-align:center!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more{margin-top:7px!important;border:1px solid rgba(24,29,37,.07)!important;border-radius:15px!important;background:#fafafb!important;overflow:hidden!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more>summary{min-height:42px!important;padding:0 12px!important;display:flex!important;align-items:center!important;justify-content:space-between!important;color:#5d646d!important;font-size:10px!important;font-weight:800!important;list-style:none!important}

/* ---------- Status / permission ---------- */
body.vano-map-surface.vano-map-surface .status-chip{display:none!important}
body.vano-map-surface.vano-map-surface .gps-quality{position:absolute!important;z-index:38!important;left:var(--vano-safe-l)!important;top:calc(var(--vano-safe-t) + 4px)!important;display:none;align-items:center;gap:6px;padding:7px 10px;border-radius:12px;background:rgba(255,255,255,.92);border:1px solid rgba(25,29,37,.08);box-shadow:var(--vano-shadow-soft);font-size:10px;font-weight:750;color:#555d67}
body.vano-map-surface.vano-map-surface .gps-quality.show{display:flex!important}
body.vano-map-surface.vano-map-surface .gps-quality.weak{color:#9b4d2e;background:#fff7f2}
body.vano-map-surface.vano-map-surface .connectivity-pill{position:absolute!important;z-index:43!important;top:calc(var(--vano-safe-t) + 57px)!important;left:50%!important;transform:translateX(-50%)!important;border-radius:999px!important;padding:7px 10px!important;background:rgba(30,33,39,.9)!important;color:#fff!important;font-size:10px!important;box-shadow:var(--vano-shadow-soft)!important}
body.vano-map-surface.vano-map-surface .permission{z-index:80!important;border-radius:18px!important;background:#fff!important;color:#20242a!important;border:1px solid rgba(24,29,37,.09)!important;box-shadow:var(--vano-shadow)!important}
body.vano-map-surface.vano-map-surface .permission button{border:0!important;border-radius:12px!important;background:var(--vano-accent)!important;color:#fff!important;font-weight:800!important}

/* ---------- User puck ---------- */
body.vano-map-surface .vano-user-puck-v300{
  position:relative!important;width:40px!important;height:48px!important;display:grid!important;place-items:center!important;
  transform-origin:50% 52%!important;pointer-events:none!important;filter:drop-shadow(0 4px 5px rgba(18,24,32,.23));
  transition:filter .2s ease!important;
}
body.vano-map-surface .vano-user-puck-v300 .vano-puck-inline{display:block!important;width:40px!important;height:48px!important;overflow:visible!important}
body.vano-map-surface .vano-user-puck-v300 .vano-puck-accuracy{position:absolute!important;left:50%!important;top:54%!important;width:54px!important;height:54px!important;transform:translate(-50%,-50%)!important;border-radius:50%!important;background:rgba(255,120,0,.075)!important;border:1px solid rgba(255,120,0,.14)!important;opacity:0!important;transition:opacity .2s ease!important;z-index:-1!important}
body.vano-map-surface .vano-user-puck-v300.is-gps-weak .vano-puck-accuracy{opacity:1!important;width:64px!important;height:64px!important;background:rgba(255,120,0,.06)!important}
body.vano-map-surface .vano-user-puck-v300.is-moving{filter:drop-shadow(0 5px 6px rgba(18,24,32,.25))}

/* ---------- Navigation layout ---------- */
body.vano-map-surface.body-nav #planSheet,
body.vano-map-surface.body-nav .map-tools,
body.vano-map-surface.body-nav .floating-locate{display:none!important}
body.vano-map-surface.body-nav .map-vignette{opacity:.18}

body.vano-map-surface.body-nav #navManeuverTop{
  position:absolute!important;z-index:48!important;
  top:calc(var(--vano-safe-t) + 2px)!important;
  left:var(--vano-safe-l)!important;
  width:min(430px,calc(100vw - var(--vano-safe-l) - var(--vano-safe-r) - 8px))!important;
  min-height:82px!important;
  padding:9px 12px 9px 9px!important;
  display:flex!important;align-items:center!important;gap:10px!important;
  border:1px solid rgba(24,29,37,.09)!important;border-radius:21px!important;
  background:rgba(255,255,255,.96)!important;color:#20242a!important;
  box-shadow:var(--vano-shadow)!important;
  backdrop-filter:blur(18px) saturate(130%);-webkit-backdrop-filter:blur(18px) saturate(130%);
  transform:translate3d(0,0,0)!important;opacity:1!important;
}
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{width:62px!important;height:62px!important;min-width:62px!important;border-radius:17px!important;background:#20242b!important;color:#fff!important;display:grid!important;place-items:center!important}
body.vano-map-surface.body-nav #navManeuverTop .maneuver-glyph{font-size:34px!important;line-height:1!important;font-weight:750!important;transform:none!important;color:#fff!important}
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy{min-width:0!important;display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;grid-template-rows:auto auto!important;align-items:end!important;column-gap:10px!important;flex:1!important}
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy small{display:block!important;grid-column:1 / -1!important;font-size:8px!important;letter-spacing:.13em!important;font-weight:850!important;color:#9a6a55!important;margin-bottom:2px!important}
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy b{min-width:0!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important;font-size:17px!important;line-height:1.12!important;letter-spacing:-.4px!important;color:#23272e!important}
body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy span{font-size:16px!important;line-height:1!important;font-weight:850!important;color:var(--vano-accent-strong)!important;white-space:nowrap!important}

/* Context changes should be restrained, not flashy. */
body.vano-map-surface.body-nav.nav-drive-turn #navManeuverTop,
body.vano-map-surface.body-nav.nav-drive-junction #navManeuverTop,
body.vano-map-surface.body-nav.nav-drive-roundabout #navManeuverTop{box-shadow:0 16px 46px rgba(22,27,36,.18),0 0 0 2px rgba(244,122,69,.10)!important}

body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal{
  position:absolute!important;z-index:49!important;
  left:var(--vano-safe-l)!important;right:var(--vano-safe-r)!important;
  bottom:var(--vano-safe-b)!important;top:auto!important;
  min-height:var(--vano-nav-card-h)!important;height:auto!important;
  padding:6px!important;margin:0!important;
  border:1px solid rgba(24,29,37,.09)!important;border-radius:24px!important;
  background:rgba(255,255,255,.965)!important;color:#20242a!important;
  box-shadow:0 14px 40px rgba(20,25,34,.17),0 2px 8px rgba(20,25,34,.07)!important;
  backdrop-filter:blur(20px) saturate(130%);-webkit-backdrop-filter:blur(20px) saturate(130%);
  transform:translate3d(0,0,0)!important;overflow:visible!important;
}
body.vano-map-surface.body-nav #activeNav .vano-nav-dock-head{display:none!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-row{
  display:grid!important;grid-template-columns:1.20fr .93fr .97fr!important;
  height:66px!important;min-height:66px!important;gap:0!important;
  border-radius:19px!important;background:#f5f6f8!important;border:1px solid rgba(24,29,37,.045)!important;overflow:hidden!important;
}
body.vano-map-surface.body-nav #activeNav .nav-summary-item,
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{
  min-width:0!important;display:flex!important;flex-direction:column!important;align-items:flex-start!important;justify-content:center!important;
  padding:8px 11px!important;background:transparent!important;border:0!important;border-radius:0!important;box-shadow:none!important;
}
body.vano-map-surface.body-nav #activeNav .nav-summary-item + .nav-summary-item{border-left:1px solid rgba(24,29,37,.07)!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{background:#fff7f2!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-label{display:flex!important;align-items:center!important;gap:5px!important;margin-bottom:4px!important;line-height:1!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-label svg{width:10px!important;height:10px!important;color:#8b919a!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-primary .nav-summary-label svg{color:var(--vano-accent-strong)!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-item small{font-size:7px!important;line-height:1!important;letter-spacing:.10em!important;font-weight:850!important;color:#8a9099!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{max-width:100%!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important;font-size:17px!important;line-height:1!important;letter-spacing:-.55px!important;color:#24282f!important;font-weight:820!important}
body.vano-map-surface.body-nav #activeNav .nav-summary-primary strong{font-size:22px!important;color:var(--vano-accent-strong)!important;letter-spacing:-.85px!important}
body.vano-map-surface.body-nav #activeNav #navSearchBtn{display:none!important}

/* Street name: quiet, readable, never competes with the maneuver card. */
body.vano-map-surface.body-nav #navStreetChip.nav-street-chip{
  position:absolute!important;z-index:45!important;
  left:76px!important;right:70px!important;
  bottom:calc(var(--vano-safe-b) + var(--vano-nav-card-h) + 18px)!important;
  height:36px!important;min-height:36px!important;
  display:flex!important;align-items:center!important;justify-content:center!important;
  padding:0 12px!important;border-radius:13px!important;
  background:rgba(31,35,42,.90)!important;color:#fff!important;border:1px solid rgba(255,255,255,.08)!important;
  box-shadow:0 8px 22px rgba(20,25,34,.16)!important;backdrop-filter:blur(12px)!important;
}
body.vano-map-surface.body-nav #navStreetChip span{min-width:0!important;max-width:100%!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important;font-size:11px!important;font-weight:760!important;letter-spacing:-.1px!important}

/* Speedometer */
body.vano-map-surface.body-nav #vanoSpeedometerV220{
  position:absolute!important;z-index:47!important;
  left:var(--vano-safe-l)!important;bottom:calc(var(--vano-safe-b) + var(--vano-nav-card-h) + 15px)!important;
  width:56px!important;height:56px!important;min-width:56px!important;min-height:56px!important;
  display:flex!important;align-items:center!important;justify-content:center!important;
  padding:0!important;border:2px solid rgba(255,255,255,.92)!important;border-radius:17px!important;
  background:rgba(31,35,42,.94)!important;color:#fff!important;box-shadow:0 9px 24px rgba(20,25,34,.20)!important;
  pointer-events:none!important;
}
body.vano-map-surface.body-nav #vanoSpeedValueV220{font-size:22px!important;font-weight:850!important;line-height:1!important;letter-spacing:-.6px!important;color:#fff!important;font-variant-numeric:tabular-nums!important}
body.vano-map-surface.body-nav #vanoSpeedometerV220.over-limit{border-color:#ff5b52!important;box-shadow:0 9px 24px rgba(20,25,34,.20),0 0 0 3px rgba(255,91,82,.14)!important}

/* Right-side controls: same size, same language. */
body.vano-map-surface.body-nav #navControlStack{
  position:absolute!important;z-index:50!important;
  right:var(--vano-safe-r)!important;bottom:calc(var(--vano-safe-b) + var(--vano-nav-card-h) + 15px)!important;
  display:flex!important;flex-direction:column!important;align-items:flex-end!important;gap:7px!important;
  width:46px!important;padding:0!important;background:transparent!important;border:0!important;box-shadow:none!important;
}
body.vano-map-surface.body-nav #navControlStack :is(.nav-stack-btn,.nav-audio-toggle,.nav-drawer-toggle,.nav-drawer-btn){
  width:46px!important;height:46px!important;min-width:46px!important;min-height:46px!important;
  padding:0!important;border-radius:15px!important;display:grid!important;place-items:center!important;
  transition:transform .12s ease,background-color .16s ease,color .16s ease!important;
}
body.vano-map-surface.body-nav #navExitBtn.nav-exit-main{color:#a8433a!important;background:rgba(255,250,249,.97)!important}
body.vano-map-surface.body-nav #quickAlertBtn.nav-report-main{color:var(--vano-accent-strong)!important}
body.vano-map-surface.body-nav #navDrawerRecenter.nav-recenter-main{color:#29303a!important}
body.vano-map-surface.body-nav #soundBtn.active{background:#24282f!important;color:#fff!important;border-color:#24282f!important}
body.vano-map-surface.body-nav #navDrawerToggle{display:none!important}
body.vano-map-surface.body-nav #navControlDrawer{position:static!important;display:flex!important;flex-direction:column!important;gap:7px!important;opacity:1!important;visibility:visible!important;transform:none!important;pointer-events:auto!important}
body.vano-map-surface.body-nav #navControlDrawer #navDrawerOptions{display:none!important}
body.vano-map-surface.body-nav #navControlDrawer #navDrawerSupport{display:none!important}

body.vano-map-surface.body-nav #rerouteNotice.reroute{
  position:absolute!important;z-index:54!important;
  left:50%!important;bottom:calc(var(--vano-safe-b) + var(--vano-nav-card-h) + 66px)!important;
  transform:translate(-50%,10px)!important;
  width:max-content!important;max-width:calc(100vw - 140px)!important;
  min-height:38px!important;margin:0!important;padding:8px 12px!important;
  display:flex!important;align-items:center!important;gap:8px!important;
  border-radius:13px!important;background:rgba(31,35,42,.94)!important;color:#fff!important;border:1px solid rgba(255,255,255,.08)!important;
  box-shadow:0 10px 28px rgba(20,25,34,.20)!important;
  opacity:0!important;pointer-events:none!important;transition:opacity .18s ease,transform .18s ease!important;
}
body.vano-map-surface.body-nav #rerouteNotice.show{opacity:1!important;transform:translate(-50%,0)!important}
body.vano-map-surface.body-nav #rerouteNotice span:last-child{font-size:11px!important;font-weight:760!important;white-space:nowrap!important}

body.vano-map-surface.body-nav #navAltHint.nav-alt-hint,
body.vano-map-surface.body-nav #trafficSuggestion.traffic-suggestion{
  position:absolute!important;z-index:53!important;
  left:var(--vano-safe-l)!important;right:calc(var(--vano-safe-r) + 58px)!important;
  bottom:calc(var(--vano-safe-b) + var(--vano-nav-card-h) + 66px)!important;
  margin:0!important;border:1px solid rgba(24,29,37,.09)!important;border-radius:17px!important;
  background:rgba(255,255,255,.97)!important;color:#24282f!important;box-shadow:var(--vano-shadow)!important;
}

/* Arrival */
body.vano-map-surface.body-nav.nav-arrived #navManeuverTop{opacity:0!important;transform:translateY(-14px)!important;pointer-events:none!important}
body.vano-map-surface.body-nav .arrival-experience{z-index:60!important}
body.vano-map-surface.body-nav .arrival-experience.show{display:flex!important}

/* Voice / reports */
body.vano-map-surface.body-nav #navVoicePopover{z-index:70!important;right:calc(var(--vano-safe-r) + 54px)!important;bottom:calc(var(--vano-safe-b) + var(--vano-nav-card-h) + 68px)!important;border-radius:16px!important;background:#fff!important;color:#24282f!important;box-shadow:var(--vano-shadow)!important;border:1px solid rgba(24,29,37,.09)!important}
body.vano-map-surface.vano-map-surface #quickAlertSheet{z-index:90!important}
body.vano-map-surface.vano-map-surface #quickAlertSheet .quick-alert-card{border-radius:26px 26px 0 0!important;background:#fff!important;color:#20242a!important;box-shadow:0 -20px 50px rgba(20,25,34,.22)!important}
body.vano-map-surface.vano-map-surface #quickAlertSheet .quick-alert-grid button{border:1px solid rgba(24,29,37,.07)!important;background:#f7f8f9!important;color:#252a31!important;border-radius:16px!important}
body.vano-map-surface.vano-map-surface #quickAlertSheet .quick-alert-premium-icon{background:#fff!important;color:var(--vano-accent-strong)!important;border:1px solid rgba(24,29,37,.06)!important}

/* Loading is compact and non-blocking-looking even though route calculation is modal. */
body.vano-map-surface.vano-map-surface #routeLoadingOverlay{z-index:95!important;background:rgba(20,24,31,.20)!important;backdrop-filter:blur(4px)!important}
body.vano-map-surface.vano-map-surface #routeLoadingOverlay .route-loading-card{width:min(280px,calc(100vw - 36px))!important;border-radius:20px!important;background:#fff!important;color:#20242a!important;border:1px solid rgba(24,29,37,.08)!important;box-shadow:var(--vano-shadow)!important;padding:18px!important}

/* ---------- Black mode ---------- */
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface{
  --vano-ink:#f6f6f7;--vano-muted:#a2a4aa;--vano-line:rgba(255,255,255,.075);
  --vano-surface:rgba(24,24,26,.965);--vano-surface-solid:#18181a;--vano-surface-soft:#222225;
  --vano-accent-soft:rgba(244,122,69,.13);
}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navManeuverTop,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .floating-locate,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .map-btn,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navControlStack :is(.nav-stack-btn,.nav-audio-toggle,.nav-drawer-toggle,.nav-drawer-btn){background:rgba(24,24,26,.96)!important;color:#f7f7f8!important;border-color:rgba(255,255,255,.07)!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .planner-location-row,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .nav-summary-row{background:#222225!important;border-color:rgba(255,255,255,.06)!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #destinationInput,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .planner-heading-copy b,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState h2,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState .route-time span,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy b,
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{color:#f7f7f8!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .planner-preset,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .nearby-service,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .voice-search-btn,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeModeSegment button.active{background:#2a2a2e!important;color:#f7f7f8!important;border-color:rgba(255,255,255,.06)!important}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .nav-summary-primary{background:rgba(244,122,69,.10)!important}
html[data-vano-theme="black"] body.vano-map-surface.body-nav #activeNav .nav-summary-item + .nav-summary-item{border-left-color:rgba(255,255,255,.06)!important}

/* ---------- Small phones ---------- */
@media (max-width:390px) and (orientation:portrait){
  body.vano-map-surface{--vano-nav-card-h:72px}
  body.vano-map-surface.body-nav #navManeuverTop{min-height:76px!important;padding:8px!important;border-radius:19px!important}
  body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{width:56px!important;height:56px!important;min-width:56px!important;border-radius:15px!important}
  body.vano-map-surface.body-nav #navManeuverTop .maneuver-glyph{font-size:31px!important}
  body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy b{font-size:15px!important}
  body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy span{font-size:14px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-row{height:60px!important;min-height:60px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item,
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{padding:7px 8px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{font-size:15px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-primary strong{font-size:20px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item small{font-size:6.3px!important}
  body.vano-map-surface.body-nav #vanoSpeedometerV220{width:52px!important;height:52px!important;min-width:52px!important;min-height:52px!important;border-radius:16px!important}
  body.vano-map-surface.body-nav #vanoSpeedValueV220{font-size:20px!important}
  body.vano-map-surface.body-nav #navControlStack{width:43px!important}
  body.vano-map-surface.body-nav #navControlStack :is(.nav-stack-btn,.nav-audio-toggle,.nav-drawer-toggle,.nav-drawer-btn){width:43px!important;height:43px!important;min-width:43px!important;min-height:43px!important;border-radius:14px!important}
  body.vano-map-surface.body-nav #navStreetChip.nav-street-chip{left:69px!important;right:63px!important}
  body.vano-map-surface.vano-map-surface .nearby-services{grid-template-columns:repeat(3,minmax(0,1fr))!important}
}

/* ---------- Landscape phone ---------- */
@media (orientation:landscape) and (max-height:700px) and (max-width:1200px){
  body.vano-map-surface{--vano-nav-card-h:66px}
  body.vano-map-surface.body-nav #navManeuverTop{top:var(--vano-safe-t)!important;left:var(--vano-safe-l)!important;width:min(360px,46vw)!important;min-height:68px!important;border-radius:18px!important;padding:7px!important}
  body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-icon{width:52px!important;height:52px!important;min-width:52px!important;border-radius:14px!important}
  body.vano-map-surface.body-nav #navManeuverTop .maneuver-glyph{font-size:29px!important}
  body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy small{display:none!important}
  body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy b{font-size:14px!important}
  body.vano-map-surface.body-nav #navManeuverTop .nav-maneuver-copy span{font-size:13px!important}

  body.vano-map-surface.body-nav #activeNav.nav-panel.nav-minimal{left:var(--vano-safe-l)!important;right:auto!important;width:min(360px,46vw)!important;bottom:var(--vano-safe-b)!important;border-radius:20px!important;padding:5px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-row{height:56px!important;min-height:56px!important;border-radius:16px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item,
body.vano-map-surface.body-nav #activeNav .nav-summary-primary{padding:6px 8px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-item strong{font-size:14px!important}
  body.vano-map-surface.body-nav #activeNav .nav-summary-primary strong{font-size:19px!important}

  body.vano-map-surface.body-nav #vanoSpeedometerV220{left:auto!important;right:calc(var(--vano-safe-r) + 53px)!important;bottom:var(--vano-safe-b)!important;width:48px!important;height:48px!important;min-width:48px!important;min-height:48px!important;border-radius:15px!important}
  body.vano-map-surface.body-nav #vanoSpeedValueV220{font-size:19px!important}
  body.vano-map-surface.body-nav #navControlStack{right:var(--vano-safe-r)!important;bottom:var(--vano-safe-b)!important;gap:6px!important}
  body.vano-map-surface.body-nav #navControlStack :is(.nav-stack-btn,.nav-audio-toggle,.nav-drawer-toggle,.nav-drawer-btn){width:42px!important;height:42px!important;min-width:42px!important;min-height:42px!important;border-radius:13px!important}
  body.vano-map-surface.body-nav #navStreetChip.nav-street-chip{left:calc(var(--vano-safe-l) + min(360px,46vw) + 12px)!important;right:calc(var(--vano-safe-r) + 52px)!important;bottom:var(--vano-safe-b)!important;height:34px!important;min-height:34px!important}
  body.vano-map-surface.body-nav #rerouteNotice.reroute{bottom:calc(var(--vano-safe-b) + 58px)!important}
  body.vano-map-surface.body-nav #navAltHint.nav-alt-hint,
body.vano-map-surface.body-nav #trafficSuggestion.traffic-suggestion{left:calc(var(--vano-safe-l) + min(360px,46vw) + 12px)!important;right:calc(var(--vano-safe-r) + 52px)!important;bottom:calc(var(--vano-safe-b) + 47px)!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet{left:var(--vano-safe-l)!important;right:auto!important;width:min(430px,48vw)!important;max-height:calc(100dvh - var(--vano-safe-t) - var(--vano-safe-b))!important}
}

/* Reduced motion should remain fully usable. */
@media (prefers-reduced-motion:reduce){
  body.vano-map-surface.vano-map-surface *,
body.vano-map-surface.vano-map-surface *::before,
body.vano-map-surface.vano-map-surface *::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
}

/* Admin route simulator stays functional after removing the old inline patch stack. */
body.vano-map-surface.vano-map-surface .admin-route-test-btn{
  width:100%!important;min-height:52px!important;margin-top:9px!important;padding:8px 10px!important;
  display:flex!important;align-items:center!important;gap:10px!important;text-align:left!important;
  border:1px solid rgba(244,122,69,.16)!important;border-radius:16px!important;background:#fff8f4!important;color:#292d33!important;
  box-shadow:none!important;
}
body.vano-map-surface.vano-map-surface .admin-route-test-btn:active{transform:scale(.985)!important}
body.vano-map-surface.vano-map-surface .admin-route-test-btn.running{border-color:rgba(220,67,59,.24)!important;background:#fff5f4!important}
body.vano-map-surface.vano-map-surface .admin-route-test-icon{width:34px!important;height:34px!important;min-width:34px!important;display:grid!important;place-items:center!important;border-radius:11px!important;background:rgba(244,122,69,.11)!important;color:var(--vano-accent-strong)!important}
body.vano-map-surface.vano-map-surface .admin-route-test-copy{display:grid!important;gap:2px!important;min-width:0!important;flex:1!important}
body.vano-map-surface.vano-map-surface .admin-route-test-copy b{font-size:12px!important;line-height:1.1!important;color:inherit!important}
body.vano-map-surface.vano-map-surface .admin-route-test-copy small{font-size:9px!important;line-height:1.25!important;color:#858b94!important;white-space:normal!important}
body.vano-map-surface.vano-map-surface .admin-route-test-badge{height:22px!important;padding:0 7px!important;display:inline-flex!important;align-items:center!important;border-radius:999px!important;background:rgba(244,122,69,.10)!important;color:var(--vano-accent-strong)!important;font-size:7.5px!important;font-weight:900!important;letter-spacing:.09em!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .admin-route-test-btn{background:#222225!important;color:#f7f7f8!important;border-color:rgba(244,122,69,.18)!important}

/* Android native-map handoff: keep the HTML HUD and make only WebGL transparent. */
html.vano-native-map-active body.vano-map-surface,
html.vano-native-map-active body.vano-map-surface,
html.vano-native-map-active body.vano-map-surface > .ws-app,
html.vano-native-map-active body.vano-map-surface #map{background:transparent!important}
html.vano-native-map-active body.vano-map-surface #map .mapboxgl-canvas-container,
html.vano-native-map-active body.vano-map-surface #map .mapboxgl-control-container{opacity:0!important;visibility:hidden!important;pointer-events:none!important}

/* ========================================================================== 
   VANO MAPS V310 — route decision + smart destination UX
   ========================================================================== */
body.vano-map-surface .vano-smart-balance{display:none;margin:8px 0 10px;padding:12px 13px;border:1px solid rgba(31,34,41,.07);border-radius:18px;background:linear-gradient(180deg,#fff,#fafbfc);box-shadow:0 8px 22px rgba(25,28,35,.045)}
body.vano-map-surface .vano-smart-balance.active{display:block}body.vano-map-surface .vano-smart-balance-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px}body.vano-map-surface .vano-smart-balance-head>span{display:flex;align-items:center;gap:7px;color:#292c33;font-size:12px}body.vano-map-surface .vano-smart-balance-head>span svg{color:#F47A45}body.vano-map-surface .vano-smart-balance-head small{font-size:10px;font-weight:800;color:#70747d;background:#f0f1f4;padding:4px 8px;border-radius:999px}body.vano-map-surface .vano-smart-balance.safety-heavy .vano-smart-balance-head small{color:#8f512f;background:#fff0e7}body.vano-map-surface .vano-smart-balance.speed-heavy .vano-smart-balance-head small{color:#4f6579;background:#eef4f8}
body.vano-map-surface .vano-smart-balance-scale{display:grid;grid-template-columns:auto minmax(110px,1fr) auto;align-items:center;gap:9px}body.vano-map-surface .vano-smart-balance-scale>span{font-size:9px;font-weight:780;color:#8d9199;white-space:nowrap}body.vano-map-surface .vano-smart-balance input[type=range]{width:100%;height:24px;accent-color:#F47A45;cursor:pointer}body.vano-map-surface .vano-smart-balance p{margin:5px 0 0;color:#8b8f98;font-size:10px;line-height:1.35}
body.vano-map-surface .planner-smart-destinations{margin-top:10px}body.vano-map-surface .planner-smart-destinations[hidden]{display:none}body.vano-map-surface .planner-smart-head{display:flex;justify-content:space-between;align-items:center;margin:0 2px 7px}body.vano-map-surface .planner-smart-head span{font-size:8px;font-weight:900;letter-spacing:.12em;color:#7d8189}body.vano-map-surface .planner-smart-head small{font-size:9px;color:#a0a3aa}body.vano-map-surface .planner-smart-scroll{display:flex;gap:8px;overflow-x:auto;padding:1px 1px 5px;scrollbar-width:none}body.vano-map-surface .planner-smart-scroll::-webkit-scrollbar{display:none}body.vano-map-surface .planner-smart-scroll button{flex:0 0 auto;min-width:132px;max-width:176px;padding:9px 10px;border:1px solid rgba(27,30,36,.065);border-radius:15px;background:#fff;display:grid;grid-template-columns:24px 1fr;grid-template-areas:'icon title' 'icon sub';gap:1px 7px;text-align:left;box-shadow:0 5px 14px rgba(25,28,34,.035)}body.vano-map-surface .planner-smart-scroll button>span{grid-area:icon;width:24px;height:24px;border-radius:8px;display:grid;place-items:center;background:#fff1e9;color:#e46f3e}body.vano-map-surface .planner-smart-scroll button b{grid-area:title;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:10.5px;color:#2d3037}body.vano-map-surface .planner-smart-scroll button small{grid-area:sub;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:8.5px;color:#969aa2}
body.vano-map-surface .route-variant{position:relative}body.vano-map-surface .route-variant .route-variant-signals{display:flex;gap:5px;flex-wrap:wrap;margin-top:5px}body.vano-map-surface .route-variant .route-variant-signals i{font-style:normal;font-size:7.5px;font-weight:800;color:#777c84;background:rgba(31,34,40,.045);padding:3px 5px;border-radius:7px}body.vano-map-surface .route-variant.active .route-variant-signals i{color:#a85632;background:rgba(244,122,69,.09)}
html[data-vano-theme="black"] body.vano-map-surface .vano-smart-balance,
html[data-vano-theme="black"] body.vano-map-surface .planner-smart-scroll button{background:#202126;border-color:rgba(255,255,255,.08);box-shadow:none}html[data-vano-theme="black"] body.vano-map-surface .vano-smart-balance-head>span,
html[data-vano-theme="black"] body.vano-map-surface .planner-smart-scroll button b{color:#f2f2f4}html[data-vano-theme="black"] body.vano-map-surface .vano-smart-balance p,
html[data-vano-theme="black"] body.vano-map-surface .planner-smart-scroll button small{color:#a6a8ae}html[data-vano-theme="black"] body.vano-map-surface .planner-smart-scroll button>span{background:rgba(244,122,69,.12)}
@media(max-width:520px){body.vano-map-surface .vano-smart-balance{margin-top:6px;padding:10px 11px}body.vano-map-surface .vano-smart-balance-scale>span{font-size:8px}body.vano-map-surface .planner-smart-scroll button{min-width:124px}body.vano-map-surface .route-variant .route-variant-signals{gap:3px}}


/* ========================================================================== 
   VANO MAPS V313 — regression hotfix: admin simulator, options and route line
   ========================================================================== */
body.vano-map-surface{--vano-route-live:#FF9500;--vano-route-live-soft:#FFC266}
body.vano-map-surface.vano-map-surface .admin-route-test-slot{display:block!important;margin:8px 0 3px!important}
body.vano-map-surface.vano-map-surface .admin-route-test-slot .admin-route-test-btn{margin-top:0!important;border-color:rgba(255,149,0,.28)!important;background:linear-gradient(180deg,#fffaf1,#fff5e5)!important;box-shadow:0 8px 20px rgba(255,149,0,.10)!important}
body.vano-map-surface.vano-map-surface .admin-route-test-slot .admin-route-test-icon{background:rgba(255,149,0,.13)!important;color:#D97700!important}
body.vano-map-surface.vano-map-surface .admin-route-test-slot .admin-route-test-badge{background:#FF9500!important;color:#fff!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .admin-route-test-slot .admin-route-test-btn{background:#25211c!important;border-color:rgba(255,149,0,.35)!important;color:#fff!important}

/* The three-dot options drawer must have one deterministic open/closed state. */
body.vano-map-surface.vano-map-surface #accountBackdrop{visibility:hidden!important;opacity:0!important;pointer-events:none!important;transition:opacity .18s ease,visibility 0s linear .18s!important}
body.vano-map-surface.vano-map-surface #accountBackdrop.show{visibility:visible!important;opacity:1!important;pointer-events:auto!important;transition:opacity .18s ease!important}
body.vano-map-surface.vano-map-surface #accountDrawer{visibility:hidden!important;pointer-events:none!important}
body.vano-map-surface.vano-map-surface #accountDrawer.show{visibility:visible!important;pointer-events:auto!important}
body.vano-map-surface.vano-account-open{overflow:hidden!important}

/* Keep route option taps independent from the draggable planner shell. */
body.vano-map-surface.vano-map-surface #routeVariants .route-variant{touch-action:manipulation!important;-webkit-tap-highlight-color:transparent!important}
body.vano-map-surface.vano-map-surface #routeVariants .route-variant.active{border-color:rgba(255,149,0,.34)!important;box-shadow:0 7px 18px rgba(255,149,0,.09)!important}

/* ========================================================================== 
   VANO MAPS V314 — stable route details card
   ========================================================================== */
body.vano-map-surface.vano-map-surface #routeState #routeModeSegment{grid-template-columns:repeat(3,minmax(0,1fr))!important}
body.vano-map-surface.vano-map-surface #routeState #routeModeSegment button{min-width:0!important}
body.vano-map-surface.vano-map-surface #routeState #routeModeSegment .route-option-copy{min-width:0!important}
body.vano-map-surface.vano-map-surface #routeState #routeModeSegment .route-option-copy b,
body.vano-map-surface.vano-map-surface #routeState #routeModeSegment .route-option-copy small{max-width:100%!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important}

body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.route-details-open{max-height:min(88dvh,780px)!important;overscroll-behavior:contain!important;scroll-behavior:smooth!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreDetails{
  margin-top:8px!important;border:1px solid rgba(25,29,36,.08)!important;border-radius:18px!important;
  background:#fff!important;overflow:clip!important;contain:layout paint!important;box-shadow:0 7px 20px rgba(23,28,36,.045)!important;
}
body.vano-map-surface.vano-map-surface #routeState #routeMoreToggle{
  appearance:none!important;width:100%!important;min-height:54px!important;padding:8px 12px!important;margin:0!important;
  display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;
  border:0!important;border-radius:0!important;background:transparent!important;color:#252930!important;box-shadow:none!important;
  text-align:left!important;touch-action:manipulation!important;-webkit-tap-highlight-color:transparent!important;cursor:pointer!important;
}
body.vano-map-surface.vano-map-surface #routeState #routeMoreToggle:focus-visible{outline:3px solid rgba(255,149,0,.20)!important;outline-offset:-3px!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-toggle-copy{min-width:0!important;display:flex!important;align-items:center!important;gap:9px!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-toggle-copy>svg{width:31px!important;height:31px!important;min-width:31px!important;padding:7px!important;border-radius:10px!important;background:#fff4e5!important;color:#D97700!important;stroke-width:2!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-toggle-copy>span{min-width:0!important;display:grid!important;gap:2px!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-toggle-copy b{font-size:11.5px!important;line-height:1.1!important;font-weight:900!important;color:#252930!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-toggle-copy small{font-size:8.5px!important;line-height:1.2!important;font-weight:700!important;color:#90959e!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-chevron{flex:0 0 auto!important;color:#777d86!important;transition:transform .2s ease!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreDetails.is-open .vano-route-more-chevron{transform:rotate(180deg)!important}

body.vano-map-surface.vano-map-surface #routeState #routeMoreContent[hidden]{display:none!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreDetails.is-open>#routeMoreContent{
  display:grid!important;grid-template-columns:minmax(0,1fr)!important;gap:10px!important;
  padding:0 10px 11px!important;border-top:1px solid rgba(25,29,36,.06)!important;background:#fbfbfc!important;
}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent>*{min-width:0!important;max-width:100%!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-section{min-width:0!important;margin:10px 0 0!important;padding:10px!important;border:1px solid rgba(25,29,36,.065)!important;border-radius:15px!important;background:#fff!important;box-shadow:none!important;overflow:hidden!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-analysis-section{padding:0!important;border:0!important;background:transparent!important;overflow:visible!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-analysis-section>.vano-route-more-section-head{margin:0 1px 7px!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-section-head{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;margin-bottom:8px!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-section-head span{font-size:9px!important;line-height:1!important;font-weight:900!important;letter-spacing:.07em!important;text-transform:uppercase!important;color:#565c65!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-section-head small{font-size:8px!important;line-height:1!important;font-weight:700!important;color:#a0a4ab!important;white-space:nowrap!important}

body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:6px!important;padding:0!important;background:transparent!important;border:0!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel button{min-width:0!important;min-height:48px!important;height:auto!important;padding:7px 5px!important;border:1px solid rgba(25,29,36,.07)!important;border-radius:12px!important;background:#f6f7f8!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:6px!important;color:#666d76!important;box-shadow:none!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel button.active{border-color:rgba(255,149,0,.26)!important;background:#fff4e7!important;color:#b76300!important;box-shadow:inset 0 0 0 1px rgba(255,149,0,.06)!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel .route-option-icon{width:22px!important;height:22px!important;min-width:22px!important;display:grid!important;place-items:center!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel .route-option-copy{min-width:0!important;display:grid!important;gap:1px!important;text-align:left!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel .route-option-copy b{font-size:9.5px!important;line-height:1.05!important;color:inherit!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel .route-option-copy small{font-size:7px!important;line-height:1.05!important;color:#9a9fa7!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .moto-ico{width:17px!important;height:17px!important;fill:none!important;stroke:currentColor!important;stroke-width:1.7!important;stroke-linecap:round!important;stroke-linejoin:round!important}

body.vano-map-surface.vano-map-surface #routeState #routeMoreContent #routeCard{margin:0!important;padding:11px!important;border:1px solid rgba(25,29,36,.07)!important;border-radius:15px!important;background:#fff!important;box-shadow:none!important;overflow:hidden!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-card-top{min-width:0!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-card-top h3{overflow-wrap:anywhere!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .safety-level{min-width:0!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .safety-level strong{flex:1 1 120px!important;overflow-wrap:anywhere!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px!important;margin-top:9px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-chip{min-width:0!important;padding:8px!important;border:1px solid rgba(25,29,36,.06)!important;border-radius:11px!important;background:#f7f8f9!important;display:grid!important;gap:2px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-chip:nth-child(3){grid-column:1/-1!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-chip small{font-size:6.8px!important;line-height:1!important;font-weight:900!important;letter-spacing:.08em!important;color:#9b9fa6!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-chip b{min-width:0!important;font-size:9.5px!important;line-height:1.15!important;color:#343941!important;overflow-wrap:anywhere!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-chip span{min-width:0!important;font-size:7.5px!important;line-height:1.25!important;color:#838992!important;overflow-wrap:anywhere!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .traffic-line{display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;grid-template-areas:'copy score' 'bar bar'!important;gap:5px 8px!important;align-items:center!important;min-width:0!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .traffic-line>span:first-child{grid-area:copy!important;min-width:0!important;overflow-wrap:anywhere!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .traffic-line>.traffic-bar{grid-area:bar!important;min-width:0!important;width:100%!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .traffic-line>span:last-child{grid-area:score!important;white-space:nowrap!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent :is(.smart-note,.risk-note,.route-story-line,.route-ai){min-width:0!important;max-width:100%!important;overflow-wrap:anywhere!important;word-break:normal!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-story-line{margin-top:8px!important;padding:8px 9px!important;display:flex!important;align-items:flex-start!important;gap:7px!important;border-radius:11px!important;background:#fff8f1!important;color:#765b47!important;font-size:8.5px!important;line-height:1.35!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-story-line svg{flex:0 0 auto!important;margin-top:1px!important;color:#D97700!important}

body.vano-map-surface.vano-map-surface #routeState #routeMoreContent #parkingNearby{margin:0!important;padding:10px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-head{min-width:0!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-head>div{min-width:0!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-head b{white-space:normal!important;overflow-wrap:anywhere!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-head>span{flex:0 0 auto!important;white-space:nowrap!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-item{min-width:0!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-item>span{min-width:0!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-item b,
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-item span{max-width:100%!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important}

body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .preview-actions{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:6px!important;margin:0!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .preview-actions .sub-action{min-width:0!important;min-height:42px!important;padding:7px 5px!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:5px!important;border:1px solid rgba(25,29,36,.07)!important;border-radius:12px!important;background:#fff!important;color:#5c626b!important;box-shadow:none!important;font-size:8.5px!important;font-weight:800!important;white-space:nowrap!important;overflow:hidden!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .preview-actions .sub-action span{min-width:0!important;overflow:hidden!important;text-overflow:ellipsis!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .preview-actions .sub-action svg{flex:0 0 auto!important;color:#D97700!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .vano-route-more-disclaimer{margin:0!important;padding:0 2px!important;display:flex!important;align-items:flex-start!important;gap:5px!important;color:#999da4!important;font-size:7.5px!important;line-height:1.3!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .vano-route-more-disclaimer svg{flex:0 0 auto!important;margin-top:1px!important;color:#bd7a32!important}

html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState #routeMoreDetails{background:#202126!important;border-color:rgba(255,255,255,.08)!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState #routeMoreToggle{color:#f4f4f6!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState .vano-route-more-toggle-copy>svg{background:rgba(255,149,0,.12)!important;color:#ffb13c!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState .vano-route-more-toggle-copy b{color:#f4f4f6!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState .vano-route-more-toggle-copy small{color:#9fa1a7!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState #routeMoreDetails.is-open>#routeMoreContent{background:#1d1e22!important;border-top-color:rgba(255,255,255,.06)!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState .vano-route-more-section,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState #routeMoreContent #routeCard,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .preview-actions .sub-action{background:#25262b!important;border-color:rgba(255,255,255,.07)!important;color:#e8e8eb!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState .vano-route-more-section-head span,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-chip b{color:#ececef!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-chip{background:#202126!important;border-color:rgba(255,255,255,.06)!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-chip span,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState .vano-route-more-section-head small{color:#9c9fa7!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel button{background:#202126!important;border-color:rgba(255,255,255,.07)!important;color:#cfd1d6!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel button.active{background:rgba(255,149,0,.12)!important;border-color:rgba(255,149,0,.25)!important;color:#ffb13c!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-story-line{background:rgba(255,149,0,.08)!important;color:#d5c1aa!important}

@media(max-width:380px){
  body.vano-map-surface.vano-map-surface #routeState #routeModeSegment .route-option-copy small{display:none!important}
  body.vano-map-surface.vano-map-surface #routeState #routeModeSegment button{padding:6px 4px!important;gap:4px!important}
  body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-grid{grid-template-columns:1fr!important}
  body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-chip:nth-child(3){grid-column:auto!important}
  body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .preview-actions{grid-template-columns:1fr!important}
  body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .preview-actions .sub-action{justify-content:flex-start!important;padding:8px 10px!important}
}


/* VANO V315 — recalibration control feedback */
@keyframes vanoRecalibratePulse315{0%{transform:scale(1);box-shadow:0 8px 22px rgba(20,25,34,.15)}45%{transform:scale(.92);box-shadow:0 0 0 7px rgba(255,149,0,.18),0 8px 22px rgba(20,25,34,.12)}100%{transform:scale(1);box-shadow:0 8px 22px rgba(20,25,34,.15)}}
body.vano-map-surface.vano-map-surface :is(#navDrawerRecenter,#recenterBtn).calibrating{color:#ff9500!important;animation:vanoRecalibratePulse315 .46s ease-in-out 2!important}
body.vano-map-surface.vano-map-surface :is(#navDrawerRecenter,#recenterBtn).calibrating svg{transform:rotate(180deg);transition:transform .46s cubic-bezier(.2,.8,.2,1)!important}
@media (prefers-reduced-motion:reduce){body.vano-map-surface.vano-map-surface :is(#navDrawerRecenter,#recenterBtn).calibrating{animation:none!important}body.vano-map-surface.vano-map-surface :is(#navDrawerRecenter,#recenterBtn).calibrating svg{transform:none!important}}


/* ========================================================================== 
   VANO MAPS V316 — accessibility, scale and visual polish
   Larger readable type, 48–56 px touch targets and consistent bright orange.
   ========================================================================== */
body.vano-map-surface{
  --vano-accent:#FF9500;
  --vano-accent-strong:#A84F00;
  --vano-accent-soft:#FFF4E5;
  --vano-touch:52px;
  --vano-touch-lg:58px;
}
body.vano-map-surface.vano-map-surface button:focus-visible,
body.vano-map-surface.vano-map-surface input:focus-visible,
body.vano-map-surface.vano-map-surface select:focus-visible{
  outline:3px solid rgba(255,149,0,.42)!important;
  outline-offset:3px!important;
}
body.vano-map-surface.vano-map-surface .floating-locate{
  width:54px!important;height:54px!important;min-width:54px!important;min-height:54px!important;
  border-radius:18px!important;bottom:calc(var(--vano-safe-b) + 136px)!important;
}
body.vano-map-surface.vano-map-surface .floating-locate svg{width:22px!important;height:22px!important;stroke-width:2.2!important}
body.vano-map-surface.vano-map-surface .map-tools .map-btn{width:50px!important;height:50px!important;min-width:50px!important;min-height:50px!important;border-radius:16px!important}

body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet{
  max-height:min(82dvh,760px)!important;padding:10px 12px 15px!important;border-radius:28px!important;
  box-shadow:0 18px 52px rgba(22,27,36,.18),0 3px 12px rgba(22,27,36,.08)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-collapsed{height:150px!important;min-height:150px!important;max-height:150px!important}
body.vano-map-surface #planSheet .vano-planner-toggle-v221{width:88px!important;height:32px!important;min-width:88px!important;min-height:32px!important;margin-bottom:7px!important}
body.vano-map-surface #planSheet .vano-planner-toggle-chevron{width:11px!important;height:11px!important}
body.vano-map-surface #planSheet.sheet-collapsed .planner-heading-copy b{font-size:20px!important}
body.vano-map-surface.vano-map-surface .planner-heading{margin:3px 4px 12px!important}
body.vano-map-surface.vano-map-surface .planner-heading-copy small{font-size:10.5px!important;letter-spacing:.12em!important}
body.vano-map-surface.vano-map-surface .planner-heading-copy b{font-size:22px!important;line-height:1.12!important}
body.vano-map-surface.vano-map-surface .planner-search-row{grid-template-columns:minmax(0,1fr) 62px!important;gap:10px!important}
body.vano-map-surface.vano-map-surface .planner-location-row{height:60px!important;min-height:60px!important;border-radius:19px!important;padding-left:16px!important}
body.vano-map-surface.vano-map-surface #destinationInput{font-size:17px!important;font-weight:680!important}
body.vano-map-surface.vano-map-surface .planner-search-icon svg{width:20px!important;height:20px!important}
body.vano-map-surface.vano-map-surface .voice-search-btn{width:46px!important;height:46px!important;min-width:46px!important;border-radius:14px!important}
body.vano-map-surface.vano-map-surface .voice-search-btn svg{width:20px!important;height:20px!important}
body.vano-map-surface.vano-map-surface .planner-adjust-btn{height:60px!important;min-height:60px!important;border-radius:19px!important;font-size:11px!important;gap:4px!important}
body.vano-map-surface.vano-map-surface .planner-adjust-btn svg{width:21px!important;height:21px!important}
body.vano-map-surface.vano-map-surface .planner-capabilities{gap:8px!important;padding-top:11px!important}
body.vano-map-surface.vano-map-surface .planner-capabilities span{padding:8px 11px!important;font-size:11px!important;line-height:1.2!important}
body.vano-map-surface.vano-map-surface .planner-presets{gap:10px!important;margin-top:13px!important}
body.vano-map-surface.vano-map-surface .planner-preset{min-height:72px!important;border-radius:19px!important;padding:11px 12px!important;gap:11px!important}
body.vano-map-surface.vano-map-surface .planner-preset-icon{width:40px!important;height:40px!important;min-width:40px!important;border-radius:13px!important}
body.vano-map-surface.vano-map-surface .planner-preset b{font-size:14px!important;line-height:1.15!important}
body.vano-map-surface.vano-map-surface .planner-preset small{font-size:11px!important;line-height:1.25!important;max-width:180px!important;color:#707781!important}
body.vano-map-surface.vano-map-surface .planner-expanded{padding-top:17px!important}
body.vano-map-surface.vano-map-surface .planner-section-head small{font-size:10px!important}
body.vano-map-surface.vano-map-surface .planner-section-head b{font-size:15px!important}
body.vano-map-surface.vano-map-surface .planner-section-head>span{font-size:10.5px!important}
body.vano-map-surface.vano-map-surface .nearby-services{gap:9px!important}
body.vano-map-surface.vano-map-surface .nearby-service{min-height:90px!important;border-radius:18px!important;padding:10px 6px!important;gap:5px!important}
body.vano-map-surface.vano-map-surface .nearby-service-icon{width:38px!important;height:38px!important;border-radius:12px!important}
body.vano-map-surface.vano-map-surface .nearby-service b{font-size:12.5px!important;line-height:1.15!important}
body.vano-map-surface.vano-map-surface .nearby-service small{font-size:10.5px!important;line-height:1.2!important;color:#757C86!important}
body.vano-map-surface.vano-map-surface .planner-tip{font-size:11.5px!important;line-height:1.45!important;padding:10px 11px!important}

/* Smart destinations and Spark controls should be readable without zooming. */
body.vano-map-surface.vano-map-surface .planner-smart-head span{font-size:10px!important}
body.vano-map-surface.vano-map-surface .planner-smart-head small{font-size:10.5px!important}
body.vano-map-surface.vano-map-surface .planner-smart-scroll button{min-width:154px!important;min-height:58px!important;padding:11px 12px!important;grid-template-columns:30px 1fr!important;gap:2px 9px!important}
body.vano-map-surface.vano-map-surface .planner-smart-scroll button>span{width:30px!important;height:30px!important;border-radius:10px!important}
body.vano-map-surface.vano-map-surface .planner-smart-scroll button b{font-size:12px!important}
body.vano-map-surface.vano-map-surface .planner-smart-scroll button small{font-size:10.5px!important}
body.vano-map-surface.vano-map-surface .vano-smart-balance{padding:14px 15px!important;border-radius:19px!important}
body.vano-map-surface.vano-map-surface .vano-smart-balance-head>span{font-size:13px!important}
body.vano-map-surface.vano-map-surface .vano-smart-balance-head small{font-size:11px!important;padding:5px 9px!important}
body.vano-map-surface.vano-map-surface .vano-smart-balance-scale>span{font-size:10.5px!important}
body.vano-map-surface.vano-map-surface .vano-smart-balance input[type=range]{height:34px!important}
body.vano-map-surface.vano-map-surface .vano-smart-balance p{font-size:11.5px!important;line-height:1.45!important}

/* Route-ready card: larger decision hierarchy and comfortable controls. */
body.vano-map-surface.vano-map-surface #routeState .vr-eyebrow{font-size:10px!important}
body.vano-map-surface.vano-map-surface #routeState h2{font-size:24px!important;line-height:1.08!important}
body.vano-map-surface.vano-map-surface #routeState #routeSubtitle{font-size:13px!important;line-height:1.35!important;color:#666E79!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-decision{font-size:11px!important;padding:7px 10px!important;gap:7px!important}
body.vano-map-surface.vano-map-surface #routeState .route-time span{font-size:30px!important}
body.vano-map-surface.vano-map-surface #routeState .route-time small{font-size:12px!important;color:#68707B!important}
body.vano-map-surface.vano-map-surface #routeModeSegment button{min-height:58px!important;border-radius:15px!important;padding:8px 7px!important;gap:7px!important}
body.vano-map-surface.vano-map-surface #routeModeSegment .route-option-copy b{font-size:12.5px!important;line-height:1.1!important}
body.vano-map-surface.vano-map-surface #routeModeSegment .route-option-copy small{font-size:10px!important;line-height:1.15!important;color:#727984!important}
body.vano-map-surface.vano-map-surface #routeState .vano-alternatives-head{font-size:12px!important;margin:10px 3px 7px!important}
body.vano-map-surface.vano-map-surface #routeState .vano-alternatives-head small{font-size:10px!important}
body.vano-map-surface.vano-map-surface #routeVariants{gap:8px!important;max-height:190px!important}
body.vano-map-surface.vano-map-surface #routeVariants .route-variant{min-height:58px!important;padding-block:9px!important}
body.vano-map-surface.vano-map-surface .route-variant .route-variant-signals i{font-size:9.5px!important;padding:4px 7px!important;border-radius:8px!important}
body.vano-map-surface.vano-map-surface #startTripBtn{min-height:64px!important;border-radius:20px!important;grid-template-columns:42px 1fr 24px!important;padding:10px 14px!important;background:#FF9500!important;color:#241400!important;box-shadow:0 14px 30px rgba(255,149,0,.27)!important}
body.vano-map-surface.vano-map-surface #startTripBtn .start-trip-icon{width:40px!important;height:40px!important;border-radius:13px!important;background:rgba(255,255,255,.36)!important}
body.vano-map-surface.vano-map-surface #startTripBtn .start-trip-copy b{font-size:16px!important}
body.vano-map-surface.vano-map-surface #startTripBtn .start-trip-copy small{font-size:11px!important;line-height:1.25!important;color:rgba(36,20,0,.72)!important}
body.vano-map-surface.vano-map-surface .admin-route-test-btn{min-height:60px!important;border-radius:18px!important;padding:10px 12px!important}
body.vano-map-surface.vano-map-surface .admin-route-test-icon{width:40px!important;height:40px!important;min-width:40px!important;border-radius:13px!important}
body.vano-map-surface.vano-map-surface .admin-route-test-copy b{font-size:13.5px!important}
body.vano-map-surface.vano-map-surface .admin-route-test-copy small{font-size:11px!important;line-height:1.35!important;color:#6E7580!important}
body.vano-map-surface.vano-map-surface .admin-route-test-badge{height:26px!important;padding:0 9px!important;font-size:9px!important}

/* More information: no essential copy below ~10 px. */
body.vano-map-surface.vano-map-surface #routeState #routeMoreToggle{min-height:64px!important;padding:10px 13px!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-toggle-copy{gap:11px!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-toggle-copy>svg{width:38px!important;height:38px!important;min-width:38px!important;padding:9px!important;border-radius:12px!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-toggle-copy b{font-size:13.5px!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-toggle-copy small{font-size:11px!important;line-height:1.3!important;color:#6E7580!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreDetails.is-open>#routeMoreContent{gap:12px!important;padding:0 12px 13px!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-section{padding:12px!important;border-radius:17px!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-section-head span{font-size:11px!important;line-height:1.1!important}
body.vano-map-surface.vano-map-surface #routeState .vano-route-more-section-head small{font-size:10px!important;line-height:1.15!important;color:#777E88!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel{gap:8px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel button{min-height:58px!important;padding:9px 7px!important;border-radius:14px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel .route-option-icon{width:27px!important;height:27px!important;min-width:27px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel .route-option-copy b{font-size:12px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .travel .route-option-copy small{font-size:10px!important;line-height:1.15!important;color:#777E88!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent #routeCard{padding:13px!important;border-radius:17px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-card-top h3{font-size:15px!important;line-height:1.25!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-grid{gap:8px!important;margin-top:11px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-chip{padding:10px!important;border-radius:13px!important;gap:4px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-chip small{font-size:10px!important;line-height:1.1!important;color:#747B85!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-chip b{font-size:12px!important;line-height:1.25!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-deep-chip span{font-size:11px!important;line-height:1.35!important;color:#69717C!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .route-story-line{padding:10px 11px!important;border-radius:13px!important;font-size:11px!important;line-height:1.45!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent #parkingNearby{padding:12px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-head small{font-size:10px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-head b{font-size:13px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-head>span{font-size:10.5px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-item{min-height:48px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-item b{font-size:12px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .parking-item span{font-size:10.5px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .preview-actions{gap:8px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .preview-actions .sub-action{min-height:52px!important;padding:9px 8px!important;border-radius:14px!important;font-size:11.5px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .preview-actions .sub-action svg{width:17px!important;height:17px!important}
body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .vano-route-more-disclaimer{font-size:10.5px!important;line-height:1.45!important;color:#6F7680!important;gap:7px!important;padding:2px 3px!important}
body.vano-map-surface.vano-map-surface .gps-quality,
body.vano-map-surface.vano-map-surface .connectivity-pill{font-size:11px!important;min-height:36px!important;padding:8px 11px!important}

/* High contrast and touch devices get a stronger, simpler interaction surface. */
@media (pointer:coarse){
  body.vano-map-surface.vano-map-surface :is(.planner-preset,.nearby-service,#startTripBtn,#routeMoreToggle,.admin-route-test-btn){touch-action:manipulation!important}
  body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .preview-actions .sub-action{min-height:54px!important}
}
@media (max-width:390px) and (orientation:portrait){
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet{max-height:min(85dvh,760px)!important;padding-inline:10px!important}
  body.vano-map-surface.vano-map-surface .nearby-services{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  body.vano-map-surface.vano-map-surface #routeState h2{font-size:22px!important}
  body.vano-map-surface.vano-map-surface #routeModeSegment button{min-height:54px!important;padding-inline:4px!important}
  body.vano-map-surface.vano-map-surface #routeModeSegment .route-option-copy b{font-size:11.5px!important}
  body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .preview-actions{grid-template-columns:1fr!important}
  body.vano-map-surface.vano-map-surface #routeState #routeMoreContent .preview-actions .sub-action{justify-content:flex-start!important;padding-inline:12px!important}
}
@media (prefers-contrast:more){
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet,
body.vano-map-surface.vano-map-surface .planner-location-row,
body.vano-map-surface.vano-map-surface .planner-preset,
body.vano-map-surface.vano-map-surface .nearby-service,
body.vano-map-surface.vano-map-surface #routeState #routeMoreDetails{border-color:rgba(20,24,30,.24)!important}
  body.vano-map-surface.vano-map-surface :is(.planner-preset small,.nearby-service small,#routeSubtitle,.vano-route-more-toggle-copy small){color:#4F5660!important}
}
@media (forced-colors:active){
  body.vano-map-surface.vano-map-surface button,
body.vano-map-surface.vano-map-surface input,
body.vano-map-surface.vano-map-surface #planSheet{forced-color-adjust:auto!important}
}

/* V317 — search relevance presentation. The best semantic match must read as
   the destination itself; related businesses remain useful without competing. */
body.vano-map-surface.vano-map-surface .search-item.match-primary{
  border:1px solid rgba(255,149,0,.52)!important;
  background:linear-gradient(135deg,rgba(255,149,0,.10),rgba(255,255,255,.98) 48%)!important;
  box-shadow:0 7px 20px rgba(53,35,9,.08)!important;
}
body.vano-map-surface.vano-map-surface .search-item.match-primary .result-topline b{
  font-weight:850!important;
}
body.vano-map-surface.vano-map-surface .search-item.match-primary .result-icon{
  background:rgba(255,149,0,.16)!important;
  color:#A94D00!important;
}
body.vano-map-surface.vano-map-surface .search-item.match-related{
  background:rgba(247,248,250,.88)!important;
  border-color:rgba(20,24,30,.075)!important;
}
body.vano-map-surface.vano-map-surface .result-match-note{
  display:flex!important;
  align-items:center!important;
  gap:5px!important;
  width:max-content!important;
  max-width:100%!important;
  margin-top:3px!important;
  color:#747B84!important;
  font-size:10.5px!important;
  line-height:1.25!important;
  font-weight:650!important;
}
body.vano-map-surface.vano-map-surface .result-match-note.primary{
  color:#9A4A00!important;
}
body.vano-map-surface.vano-map-surface .search-item .result-meta.precise{
  background:#FF9500!important;
  color:#241400!important;
  border-color:rgba(148,76,0,.12)!important;
  font-weight:850!important;
}
body.vano-map-surface.vano-map-surface .search-item.match-related .result-meta{
  color:#6E747C!important;
}
body.vano-map-surface.vano-map-surface[data-vano-theme="black"] .search-item.match-primary,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .search-item.match-primary{
  background:linear-gradient(135deg,rgba(255,149,0,.14),rgba(22,24,27,.98) 50%)!important;
  border-color:rgba(255,166,43,.50)!important;
}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .result-match-note.primary{color:#FFB34E!important}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface .search-item.match-related{background:rgba(27,29,32,.92)!important}


/* V322 — planner input/search polish and safer touch scrolling */
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet{
  -webkit-overflow-scrolling:touch!important;
  overscroll-behavior:contain!important;
  touch-action:pan-y!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet:not(.sheet-collapsed){max-height:min(82dvh,760px)!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-collapsed{height:146px!important;min-height:146px!important;max-height:146px!important}
body.vano-map-surface.vano-map-surface .planner-expanded{max-height:min(35dvh,300px)!important;overflow:auto!important;padding-right:2px!important;-webkit-overflow-scrolling:touch!important}
body.vano-map-surface.vano-map-surface .planner-smart-scroll,
body.vano-map-surface.vano-map-surface .search-results{
  -webkit-overflow-scrolling:touch!important;
  overscroll-behavior:contain!important;
  touch-action:pan-y!important;
}
body.vano-map-surface.vano-map-surface .planner-search-row,
body.vano-map-surface.vano-map-surface .planner-search-card,
body.vano-map-surface.vano-map-surface .planner-location-row{overflow:visible!important}
body.vano-map-surface.vano-map-surface .search-results{max-height:min(44dvh,350px)!important}
body.vano-map-surface.vano-map-surface .planner-adjust-btn span{font-size:8px!important}


/* ===== static/vano-planner.css ===== */
/* ========================================================================== 
   VANO MAPS V263 — destination planner card hardening
   Scope: only the initial "Para onde vamos?" planner on the map.
   This file loads after vano-app.css so legacy .search-card tablet/mobile
   rules cannot move the nested destination field out of position.
   ========================================================================== */

body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet{
  --v263-paper:rgba(255,251,247,.985);
  --v263-field:#fff;
  --v263-soft:#f7f2ed;
  --v263-ink:#29231f;
  --v263-muted:#81766f;
  --v263-faint:#9c918a;
  --v263-line:rgba(92,74,62,.14);
  --v263-line-strong:rgba(217,112,63,.34);
  --v263-accent:#D9703F;
  --v263-accent-2:#F59A62;
  --v263-ring:0 0 0 4px rgba(217,112,63,.105);
  --v263-shadow:0 18px 48px rgba(57,43,34,.16),0 3px 12px rgba(57,43,34,.055);
  overflow:visible!important;
  isolation:isolate!important;
}

/* A little more vertical room prevents the heading/search from fighting the
   old fixed collapsed heights on small devices and increased text scaling. */
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-collapsed{
  height:142px!important;
  min-height:142px!important;
  max-height:142px!important;
  --planner-collapsed-h:142px!important;
  padding:7px 10px 11px!important;
}

body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-welcome{
  position:relative!important;
  width:100%!important;
  min-width:0!important;
}

body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-heading{
  min-width:0!important;
  margin:1px 3px 9px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  gap:10px!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-heading-copy{
  min-width:0!important;
  display:block!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-heading-copy b{
  display:block!important;
  margin:0!important;
  color:var(--v263-ink)!important;
  font-size:19px!important;
  font-weight:830!important;
  line-height:1.08!important;
  letter-spacing:-.48px!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet:not(.sheet-collapsed) .planner-heading-copy b{
  font-size:21px!important;
}

/* The row owns the geometry. The child .search-card must never inherit the
   old floating-search positioning used by previous VANO generations. */
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-row{
  position:relative!important;
  width:100%!important;
  min-width:0!important;
  margin:0!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr) 52px!important;
  align-items:stretch!important;
  gap:8px!important;
}

body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card{
  position:relative!important;
  inset:auto!important;
  top:auto!important;
  right:auto!important;
  bottom:auto!important;
  left:auto!important;
  transform:none!important;
  translate:none!important;
  width:100%!important;
  max-width:none!important;
  min-width:0!important;
  height:62px!important;
  min-height:62px!important;
  max-height:62px!important;
  margin:0!important;
  padding:3px 5px!important;
  overflow:visible!important;
  border:1px solid var(--v263-line)!important;
  border-radius:18px!important;
  outline:0!important;
  background:var(--v263-field)!important;
  box-shadow:0 7px 20px rgba(57,43,34,.055),inset 0 1px 0 rgba(255,255,255,.9)!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
  z-index:3!important;
  box-sizing:border-box!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card:focus-within{
  border-color:var(--v263-line-strong)!important;
  box-shadow:var(--v263-ring),0 8px 24px rgba(57,43,34,.075)!important;
}

body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-location-row.location-row{
  position:relative!important;
  inset:auto!important;
  width:100%!important;
  height:54px!important;
  min-height:54px!important;
  max-height:54px!important;
  margin:0!important;
  padding:0!important;
  display:grid!important;
  grid-template-columns:40px minmax(0,1fr) 42px!important;
  align-items:center!important;
  gap:2px!important;
  overflow:visible!important;
  border:0!important;
  border-radius:15px!important;
  background:transparent!important;
  box-shadow:none!important;
  box-sizing:border-box!important;
}

body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-icon{
  position:static!important;
  width:40px!important;
  height:40px!important;
  margin:0!important;
  display:grid!important;
  place-items:center!important;
  align-self:center!important;
  justify-self:center!important;
  color:var(--v263-accent)!important;
  transform:none!important;
  pointer-events:none!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-icon svg{
  width:19px!important;
  height:19px!important;
  display:block!important;
  stroke-width:2.15!important;
}

/* Main bug fix: make the destination input a normal grid child. No inherited
   absolute offsets, translate, unexpected margins or line-height tricks. */
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput:hover,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput:focus,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput:focus-visible{
  position:static!important;
  inset:auto!important;
  transform:none!important;
  translate:none!important;
  align-self:stretch!important;
  justify-self:stretch!important;
  width:100%!important;
  max-width:100%!important;
  min-width:0!important;
  height:54px!important;
  min-height:54px!important;
  margin:0!important;
  padding:0 5px!important;
  border:0!important;
  border-radius:0!important;
  outline:0!important;
  background:transparent!important;
  box-shadow:none!important;
  color:var(--v263-ink)!important;
  caret-color:var(--v263-accent)!important;
  font-family:inherit!important;
  font-size:16px!important;
  font-weight:690!important;
  font-style:normal!important;
  line-height:54px!important;
  letter-spacing:-.18px!important;
  text-align:left!important;
  white-space:nowrap!important;
  text-overflow:ellipsis!important;
  overflow:hidden!important;
  -webkit-appearance:none!important;
  appearance:none!important;
  box-sizing:border-box!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput::placeholder{
  color:var(--v263-faint)!important;
  opacity:1!important;
  font-weight:580!important;
}

body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .voice-search-btn{
  position:static!important;
  align-self:center!important;
  justify-self:center!important;
  width:40px!important;
  height:40px!important;
  min-width:40px!important;
  min-height:40px!important;
  margin:0!important;
  padding:0!important;
  display:grid!important;
  place-items:center!important;
  border:1px solid rgba(217,112,63,.11)!important;
  border-radius:13px!important;
  background:var(--v263-soft)!important;
  color:var(--v263-accent)!important;
  box-shadow:none!important;
  transform:none!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .voice-search-btn:hover{
  background:#fff0e6!important;
  color:#b85932!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .voice-search-btn:active{transform:scale(.96)!important}

body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn{
  position:static!important;
  inset:auto!important;
  width:52px!important;
  min-width:52px!important;
  height:62px!important;
  min-height:62px!important;
  margin:0!important;
  padding:0!important;
  display:grid!important;
  place-items:center!important;
  align-self:stretch!important;
  border:1px solid var(--v263-line)!important;
  border-radius:18px!important;
  background:var(--v263-field)!important;
  color:#746a64!important;
  box-shadow:0 7px 20px rgba(57,43,34,.045)!important;
  transform:none!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn span{display:none!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn:hover,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn.active{
  border-color:rgba(217,112,63,.22)!important;
  background:#fff2e9!important;
  color:var(--v263-accent)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn:active{transform:scale(.96)!important}

/* Results stay visually attached to the input. Collapsed cards open upward so
   they never render below the viewport; expanded cards open downward. */
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .search-results{
  position:absolute!important;
  left:0!important;
  right:0!important;
  width:auto!important;
  min-width:0!important;
  max-width:none!important;
  z-index:120!important;
  margin:0!important;
  padding:7px!important;
  overflow-x:hidden!important;
  overflow-y:auto!important;
  overscroll-behavior:contain!important;
  border:1px solid var(--v263-line)!important;
  border-radius:18px!important;
  background:rgba(255,255,255,.99)!important;
  color:var(--v263-ink)!important;
  box-shadow:0 20px 56px rgba(57,43,34,.18)!important;
  backdrop-filter:blur(12px)!important;
  -webkit-backdrop-filter:blur(12px)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-collapsed .planner-search-card .search-results{
  top:auto!important;
  bottom:calc(100% + 9px)!important;
  max-height:min(42dvh,350px)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet:not(.sheet-collapsed) .planner-search-card .search-results{
  top:calc(100% + 9px)!important;
  bottom:auto!important;
  max-height:min(38dvh,330px)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .search-item{
  min-height:58px!important;
  padding:8px!important;
  border-radius:13px!important;
  color:var(--v263-ink)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .search-item:hover,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .search-item:active{background:#fff3ea!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .result-copy{min-width:0!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .result-copy b{font-size:12.5px!important;line-height:1.18!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .result-address,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .result-copy small{font-size:9.5px!important;line-height:1.25!important;color:var(--v263-muted)!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .result-meta{font-size:8px!important}

/* Old tablet search-open behavior hid the sheet because search used to be a
   separate floating card. It is nested now, so the sheet must remain visible. */
@media(min-width:700px){
  body.vano-map-surface .vano-map-surface .ws-app.search-open #planSheet:not(.hidden){
    opacity:1!important;
    pointer-events:auto!important;
    transform:translateY(var(--planner-drag-y,0px))!important;
  }
  body.vano-map-surface .vano-map-surface .ws-app.search-open #planSheet .planner-search-card.search-card{
    box-shadow:var(--v263-ring),0 8px 24px rgba(57,43,34,.075)!important;
  }
}

/* Dark mode owns the same geometry; only colors change. */
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet{
  --v263-paper:rgba(24,22,21,.99);
  --v263-field:#211f1e;
  --v263-soft:#2b2724;
  --v263-ink:#fff9f4;
  --v263-muted:#bdb2aa;
  --v263-faint:#938980;
  --v263-line:rgba(255,249,244,.105);
  --v263-line-strong:rgba(245,154,98,.40);
  --v263-shadow:0 20px 54px rgba(0,0,0,.40);
}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet{
  background:linear-gradient(180deg,rgba(28,26,24,.99),rgba(20,18,17,.995))!important;
  border-color:var(--v263-line)!important;
  color:var(--v263-ink)!important;
  box-shadow:var(--v263-shadow)!important;
}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-heading-copy b,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput{
  color:var(--v263-ink)!important;
}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn{
  background:var(--v263-field)!important;
  border-color:var(--v263-line)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.025)!important;
}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .voice-search-btn{
  background:var(--v263-soft)!important;
  border-color:var(--v263-line)!important;
  color:#ffc39b!important;
}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .search-results{
  background:rgba(31,29,28,.995)!important;
  color:var(--v263-ink)!important;
  border-color:var(--v263-line)!important;
  box-shadow:0 22px 62px rgba(0,0,0,.48)!important;
}
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .search-item:hover,
html[data-vano-theme="black"] body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .search-item:active{background:#302b27!important}

/* Small phones: preserve a real 44px+ touch target without squeezing the text. */
@media(max-width:380px){
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-collapsed{
    height:138px!important;
    min-height:138px!important;
    max-height:138px!important;
    --planner-collapsed-h:138px!important;
    padding-left:8px!important;
    padding-right:8px!important;
  }
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-heading{margin-bottom:7px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-heading-copy b{font-size:17px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-row{grid-template-columns:minmax(0,1fr) 48px!important;gap:6px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card{height:58px!important;min-height:58px!important;max-height:58px!important;padding:2px 4px!important;border-radius:17px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-location-row.location-row{height:52px!important;min-height:52px!important;max-height:52px!important;grid-template-columns:36px minmax(0,1fr) 40px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-icon{width:36px!important;height:36px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput{height:52px!important;min-height:52px!important;line-height:52px!important;padding:0 3px!important;font-size:16px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .voice-search-btn{width:38px!important;height:38px!important;min-width:38px!important;min-height:38px!important;border-radius:12px!important}
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn{width:48px!important;min-width:48px!important;height:58px!important;min-height:58px!important;border-radius:17px!important}
}

/* Tablet/foldable/desktop: explicitly cancel every old floating-search offset. */
@media(min-width:600px){
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card{
    top:auto!important;left:auto!important;right:auto!important;bottom:auto!important;
    width:100%!important;max-width:none!important;
  }
}

@media(prefers-reduced-motion:reduce){
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .voice-search-btn,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .search-results{transition:none!important;animation:none!important}
}

/* ========================================================================== 
   VANO MAPS V301 — planner polish + keyboard-safe search
   Loaded after the map shell so this component owns its final geometry.
   ========================================================================== */
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet{
  --v301-panel:rgba(255,252,248,.965);
  --v301-panel-solid:#fffaf6;
  --v301-field:rgba(255,255,255,.94);
  --v301-soft:#f8f2ec;
  --v301-ink:#26211e;
  --v301-muted:#7e746d;
  --v301-line:rgba(91,70,56,.13);
  --v301-accent:#D9703F;
  --v301-accent-soft:rgba(217,112,63,.10);
  isolation:isolate!important;
  overflow:visible!important;
  padding:8px 11px 13px!important;
  border:1px solid rgba(101,79,65,.13)!important;
  border-radius:28px!important;
  background:linear-gradient(180deg,rgba(255,253,250,.985),rgba(255,249,244,.965))!important;
  box-shadow:0 22px 64px rgba(52,39,31,.16),0 3px 12px rgba(52,39,31,.055),inset 0 1px 0 rgba(255,255,255,.95)!important;
  backdrop-filter:blur(24px) saturate(132%)!important;
  -webkit-backdrop-filter:blur(24px) saturate(132%)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-collapsed{
  height:148px!important;
  min-height:148px!important;
  max-height:148px!important;
  --planner-collapsed-h:148px!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.planner-search-active{
  z-index:78!important;
  overflow:visible!important;
  box-shadow:0 24px 72px rgba(52,39,31,.19),0 0 0 1px rgba(217,112,63,.045),inset 0 1px 0 rgba(255,255,255,.96)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .vano-planner-toggle-v221{
  width:66px!important;height:22px!important;min-width:66px!important;min-height:22px!important;
  margin:0 auto 6px!important;
  background:transparent!important;color:#a0968f!important;
  border-radius:999px!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .vano-planner-toggle-v221::before{
  content:"";position:absolute;width:34px;height:4px;border-radius:99px;background:currentColor;opacity:.42;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .vano-planner-toggle-chevron{opacity:0!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-heading{
  margin:0 4px 9px!important;min-height:24px!important;align-items:flex-end!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-heading-copy small{
  display:block!important;margin:0 0 3px!important;color:var(--v301-accent)!important;
  font-size:8px!important;font-weight:900!important;letter-spacing:.15em!important;line-height:1!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-heading-copy b{
  color:var(--v301-ink)!important;font-size:20px!important;font-weight:870!important;letter-spacing:-.62px!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-collapsed .planner-heading-copy small{display:none!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.sheet-collapsed .planner-heading-copy b{font-size:18px!important;letter-spacing:-.42px!important}

body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-row{
  grid-template-columns:minmax(0,1fr) 58px!important;gap:8px!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card{
  height:64px!important;min-height:64px!important;max-height:64px!important;padding:3px 5px!important;
  border:1px solid var(--v301-line)!important;border-radius:20px!important;background:var(--v301-field)!important;
  box-shadow:0 9px 24px rgba(52,39,31,.065),inset 0 1px 0 rgba(255,255,255,.96)!important;
  transition:border-color .18s ease,box-shadow .18s ease,background .18s ease,transform .18s ease!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card.search-card:focus-within{
  border-color:rgba(217,112,63,.42)!important;background:#fff!important;
  box-shadow:0 0 0 4px rgba(217,112,63,.10),0 12px 30px rgba(52,39,31,.09)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-location-row.location-row{
  height:56px!important;min-height:56px!important;max-height:56px!important;
  grid-template-columns:42px minmax(0,1fr) 42px!important;gap:1px!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-icon{
  width:38px!important;height:38px!important;border-radius:13px!important;
  background:var(--v301-accent-soft)!important;color:var(--v301-accent)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-icon svg{width:18px!important;height:18px!important;stroke-width:2.25!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput:hover,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput:focus,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput:focus-visible{
  height:56px!important;min-height:56px!important;line-height:56px!important;padding:0 7px!important;
  color:var(--v301-ink)!important;caret-color:var(--v301-accent)!important;font-size:16px!important;font-weight:670!important;
  letter-spacing:-.22px!important;overflow:hidden!important;text-overflow:ellipsis!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .location-input#destinationInput::placeholder{
  color:#9a9089!important;font-weight:560!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .voice-search-btn{
  width:40px!important;height:40px!important;min-width:40px!important;min-height:40px!important;
  border:1px solid rgba(217,112,63,.11)!important;border-radius:13px!important;
  background:#fff7f1!important;color:var(--v301-accent)!important;
  box-shadow:none!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .voice-search-btn.listening{
  background:#fff0e7!important;color:#b9552d!important;box-shadow:0 0 0 4px rgba(217,112,63,.10)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn{
  width:58px!important;min-width:58px!important;height:64px!important;min-height:64px!important;
  display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:3px!important;
  border:1px solid var(--v301-line)!important;border-radius:20px!important;background:rgba(255,255,255,.90)!important;
  color:#6f665f!important;box-shadow:0 9px 24px rgba(52,39,31,.055)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn span{display:block!important;font-size:8px!important;font-weight:850!important;line-height:1!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn svg{width:18px!important;height:18px!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn:hover,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-adjust-btn:focus-visible{
  border-color:rgba(217,112,63,.28)!important;background:#fff3ea!important;color:var(--v301-accent)!important;
}

body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-capabilities{padding-top:10px!important;gap:6px!important}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-capabilities span{
  background:rgba(255,255,255,.70)!important;border-color:rgba(91,70,56,.08)!important;color:#786f69!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-preset,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-service{
  border-color:rgba(91,70,56,.09)!important;background:rgba(255,255,255,.76)!important;
  box-shadow:0 6px 18px rgba(52,39,31,.035)!important;
  transition:transform .16s ease,border-color .16s ease,background .16s ease,box-shadow .16s ease!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-preset:hover,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-service:hover{
  transform:translateY(-1px)!important;border-color:rgba(217,112,63,.18)!important;background:#fff!important;box-shadow:0 9px 22px rgba(52,39,31,.06)!important;
}
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-preset:active,
body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .nearby-service:active{transform:scale(.985)!important}

body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet .planner-search-card .search-results,
body.vano-map-surface.vano-map-surface .ws-app>.search-results.search-results-portal{
  padding:7px!important;border:1px solid rgba(91,70,56,.13)!important;border-radius:20px!important;
  background:rgba(255,253,250,.99)!important;color:var(--v301-ink)!important;
  box-shadow:0 22px 64px rgba(52,39,31,.20),inset 0 1px 0 rgba(255,255,255,.95)!important;
  backdrop-filter:blur(22px) saturate(126%)!important;-webkit-backdrop-filter:blur(22px) saturate(126%)!important;
  scrollbar-width:thin!important;scrollbar-color:rgba(217,112,63,.25) transparent!important;
}
body.vano-map-surface.vano-map-surface .ws-app>.search-results.search-results-portal{position:absolute!important;z-index:140!important;overflow:auto!important;overscroll-behavior:contain!important}
body.vano-map-surface.vano-map-surface .search-results .search-label{padding:8px 9px 7px!important;color:#887e76!important;font-size:9px!important;font-weight:820!important;letter-spacing:.035em!important}
body.vano-map-surface.vano-map-surface .search-results .search-item,
body.vano-map-surface.vano-map-surface .search-results .search-suggestion{
  width:100%!important;min-height:60px!important;border:0!important;border-radius:14px!important;
  transition:background .14s ease,transform .14s ease!important;
}
body.vano-map-surface.vano-map-surface .search-results .search-item:hover,
body.vano-map-surface.vano-map-surface .search-results .search-suggestion:hover,
body.vano-map-surface.vano-map-surface .search-results .search-item:focus-visible,
body.vano-map-surface.vano-map-surface .search-results .search-suggestion:focus-visible{
  outline:0!important;background:#fff1e7!important;box-shadow:inset 0 0 0 1px rgba(217,112,63,.08)!important;
}
body.vano-map-surface.vano-map-surface .search-results .search-item:active,
body.vano-map-surface.vano-map-surface .search-results .search-suggestion:active{transform:scale(.992)!important}

/* Keep the field visible while the software keyboard changes the visual viewport. */
@media(max-width:899px){
  body.vano-map-surface.vano-map-surface.vano-keyboard-open:not(.body-nav) #planSheet,
body.vano-map-surface.vano-map-surface.vano-search-interacting:not(.body-nav) #planSheet.planner-search-active{
    transition:none!important;
  }
  body.vano-map-surface.vano-map-surface.vano-keyboard-open:not(.body-nav) #planSheet{
    bottom:max(8px,calc(var(--vano-keyboard-bottom,0px) + 8px))!important;
  }
  body.vano-map-surface.vano-map-surface:not(.body-nav) #planSheet.planner-search-active.sheet-collapsed{
    overflow:visible!important;
  }
}

