{
  "format": "vano.mapbox.appearance-manifest/v1",
  "name": "VANO Mapbox White & Black",
  "source": {
    "repository": "miguel027dev/vano",
    "mapboxStyleVersion": 8,
    "styleSourceFiles": [
      "static/mapbox/vano-light-3d.json",
      "static/mapbox/vano-dark-3d.json"
    ],
    "codeOwners": [
      "vano/routes/core.py",
      "static/vano-map.js",
      "static/vano-theme.js"
    ]
  },
  "themeController": {
    "storageKey": "vano.theme.mode.v200",
    "htmlAttribute": "data-vano-theme",
    "event": "vano:themechange",
    "defaultMode": "light",
    "modes": [
      "light",
      "black"
    ],
    "persistPreference": true,
    "overrideByWeather": false,
    "overrideByTime": false,
    "rehydrateRuntimeLayersAfterStyleLoad": true
  },
  "themes": {
    "light": {
      "label": "White",
      "styleUrl": "/mapbox/vano-style/light.json",
      "ui": {
        "background": "#FFF8F2",
        "surface": "#FFFFFF",
        "text": "#27231F",
        "textSecondary": "#706861",
        "border": "#E8DED6",
        "brand": "#F59A62"
      },
      "style": {
        "version": 8,
        "name": "VANO Light 3D",
        "metadata": {
          "vano:purpose": "day-navigation",
          "vano:route-color": "#F59A62",
          "vano:route-shadow": "#B9572D",
          "vano:ui-surface": "#FFFBF7"
        },
        "imports": [
          {
            "id": "basemap",
            "url": "mapbox://styles/mapbox/standard",
            "config": {
              "lightPreset": "day",
              "theme": "faded",
              "showPlaceLabels": true,
              "showRoadLabels": true,
              "showPointOfInterestLabels": false,
              "showTransitLabels": false,
              "showLandmarkIcons": false,
              "showAdminBoundaries": false,
              "show3dObjects": true,
              "show3dBuildings": true,
              "show3dLandmarks": true,
              "show3dTrees": false
            }
          }
        ],
        "sources": {
          "vano-terrain": {
            "type": "raster-dem",
            "url": "mapbox://mapbox.mapbox-terrain-dem-v1",
            "tileSize": 512,
            "maxzoom": 14
          }
        },
        "terrain": {
          "source": "vano-terrain",
          "exaggeration": 0.62
        },
        "projection": {
          "name": "mercator"
        },
        "fog": {
          "range": [
            0.8,
            10
          ],
          "color": "#EAF2F8",
          "high-color": "#FFFFFF",
          "space-color": "#F4F7F9",
          "horizon-blend": 0.07,
          "star-intensity": 0
        },
        "layers": []
      }
    },
    "black": {
      "label": "Black",
      "styleUrl": "/mapbox/vano-style/black.json",
      "ui": {
        "background": "#0A0A0B",
        "surface": "#18181B",
        "text": "#F7F7F8",
        "textSecondary": "#B6B6BD",
        "border": "#323238",
        "brand": "#F59A62"
      },
      "style": {
        "version": 8,
        "name": "VANO Dark 3D",
        "metadata": {
          "vano:purpose": "night-navigation",
          "vano:route-color": "#F59A62",
          "vano:route-shadow": "#7A351B",
          "vano:ui-surface": "#171512"
        },
        "imports": [
          {
            "id": "basemap",
            "url": "mapbox://styles/mapbox/standard",
            "config": {
              "lightPreset": "night",
              "theme": "monochrome",
              "showPlaceLabels": true,
              "showRoadLabels": true,
              "showPointOfInterestLabels": false,
              "showTransitLabels": false,
              "showLandmarkIcons": false,
              "showAdminBoundaries": false,
              "show3dObjects": true,
              "show3dBuildings": true,
              "show3dLandmarks": true,
              "show3dTrees": false
            }
          }
        ],
        "sources": {
          "vano-terrain": {
            "type": "raster-dem",
            "url": "mapbox://mapbox.mapbox-terrain-dem-v1",
            "tileSize": 512,
            "maxzoom": 14
          }
        },
        "terrain": {
          "source": "vano-terrain",
          "exaggeration": 0.62
        },
        "projection": {
          "name": "mercator"
        },
        "fog": {
          "range": [
            0.6,
            8
          ],
          "color": "#0C1118",
          "high-color": "#14202E",
          "space-color": "#030507",
          "horizon-blend": 0.1,
          "star-intensity": 0.18
        },
        "layers": []
      }
    }
  },
  "designRules": {
    "route": {
      "primaryColor": "#F59A62",
      "secondaryColor": "#FFC6A5",
      "verifiedCongestionColor": "#D83B45",
      "redOnlyForConfirmedCongestion": true,
      "doNotColorEntireRouteRedForTraffic": true,
      "selectedRouteWidthByZoom": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        10,
        4.8,
        12,
        5.9,
        14,
        7.1,
        16,
        8.5,
        18,
        9.9,
        20,
        11.3
      ],
      "navigationRouteWidthByZoom": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        10,
        4.9,
        12,
        6,
        14,
        7.2,
        16,
        8.6,
        18,
        10,
        20,
        11.5
      ],
      "navigationCasingWidthByZoom": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        10,
        6.9,
        12,
        8.4,
        14,
        10,
        16,
        11.8,
        18,
        13.6,
        20,
        15.4
      ],
      "lineCap": "round",
      "lineJoin": "round",
      "preserveExistingAnimation": true
    },
    "labelsAndPoi": {
      "streetNames": true,
      "lowDensityWhileNavigating": true,
      "priorities": [
        "next-maneuver",
        "speed-limit",
        "verified-radar",
        "critical-alert"
      ],
      "contextualCategories": [
        "hospital",
        "parking",
        "fuel",
        "railway-crossing",
        "restaurant"
      ],
      "hideNonEssentialWhileNavigating": true,
      "noPermanentTrafficSegmentLabels": true,
      "hiddenCategories": [
        "pharmacy",
        "hotel",
        "lodging",
        "grocery",
        "convenience",
        "supermarket",
        "hypermarket",
        "market",
        "cafe",
        "coffee-shop",
        "school",
        "pet-shop"
      ],
      "alwaysKeepCategories": [
        "bank",
        "parking",
        "charging-station",
        "restaurant",
        "fast-food",
        "post",
        "fitness-centre",
        "park"
      ],
      "customIconAssetsPreserved": true,
      "filterAppliesTo": "vano-secondary-pois-icons",
      "note": "Ocultar somente os POIs visuais do mapa; manter busca de destinos, ícones registrados e pontos de apoio sob demanda."
    },
    "camera": {
      "owner": "static/vano-map.js",
      "preserveMotionStateMachine": true,
      "avoidPrematureBearingRotation": true,
      "avoidZoomOutWhenApproachingTurn": true,
      "shareRulesWithSimulation": true
    },
    "ui": {
      "navigationFirst": true,
      "minimumTouchTargetPx": 44,
      "respectReducedMotion": true,
      "attributionVisible": true,
      "avoidOverlappingAlertCards": true,
      "weatherDoesNotOverrideUserTheme": true
    },
    "routing": {
      "owner": "vano/services/routing.py",
      "unchangedByThisManifest": true,
      "congestionDataMustBeGrounded": true
    }
  }
}
