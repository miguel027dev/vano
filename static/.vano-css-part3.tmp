body.vano-auth-startup .vano-onboarding-v340 .ob-finish-v340:after,
body.vano-route-register .vano-onboarding-v340 .ob-next-v340:after,
body.vano-route-register .vano-onboarding-v340 .ob-finish-v340:after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 10%,rgba(255,255,255,.3),transparent 65%);transform:translateX(-120%);transition:transform .55s var(--v351-ease)}
body.vano-auth-startup .vano-onboarding-v340 .ob-next-v340:hover:after,
body.vano-auth-startup .vano-onboarding-v340 .ob-finish-v340:hover:after,
body.vano-route-register .vano-onboarding-v340 .ob-next-v340:hover:after,
body.vano-route-register .vano-onboarding-v340 .ob-finish-v340:hover:after{transform:translateX(120%)}

