body.vano-auth-startup .ob-card-v340,
body.vano-route-register .ob-card-v340{margin-top:22px!important;padding:16px!important;border-radius:24px!important;border:1px solid var(--v402-line)!important;background:var(--v402-card-2)!important;box-shadow:none!important}
body.vano-auth-startup .ob-card-head-v340,
body.vano-route-register .ob-card-head-v340{margin-bottom:15px!important}
body.vano-auth-startup .ob-card-head-v340 b,
