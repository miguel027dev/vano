/* ===== static/vano-benchmark-admin.css ===== */
/* VANO — Route Benchmark / Admin lab. Scoped to .bench261. */
.bench261{--b-bg:#0b0d10;--b-card:#111419;--b-card2:#161a20;--b-line:rgba(255,255,255,.085);--b-text:#f7f8fa;--b-muted:#939ca9;--b-orange:#f59a62;--b-orange2:#ffb079;min-height:calc(100vh - 72px);background:radial-gradient(circle at 18% 0,rgba(245,154,98,.095),transparent 28%),#0a0c0f;color:var(--b-text);padding:24px 0 56px}.bench261 *{box-sizing:border-box}.bench261-shell{width:min(1480px,calc(100% - 28px));margin:auto}.bench261-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;margin-bottom:20px}.bench261-kicker{display:inline-flex;align-items:center;gap:7px;color:var(--b-orange2);font-size:11px;font-weight:850;letter-spacing:.14em}.bench261-head h1{font-size:clamp(30px,4vw,48px);line-height:1;margin:8px 0 9px;letter-spacing:-1.8px}.bench261-head p{margin:0;color:var(--b-muted);max-width:760px;line-height:1.55}.bench261-head-actions{display:flex;gap:8px;flex-wrap:wrap}.bench261-btn,.bench261-icon-btn{border:1px solid var(--b-line);background:var(--b-card2);color:var(--b-text);border-radius:12px;min-height:40px;padding:0 13px;display:inline-flex;align-items:center;justify-content:center;gap:7px;font-weight:760}.bench261-btn.ghost{background:rgba(255,255,255,.025)}.bench261-btn:disabled{opacity:.4;cursor:not-allowed}.bench261-grid{display:grid;grid-template-columns:minmax(310px,390px) minmax(0,1fr);gap:16px;align-items:start}.bench261-panel,.bench261-map-card,.bench261-results-card{border:1px solid var(--b-line);background:linear-gradient(180deg,rgba(20,24,29,.97),rgba(12,15,18,.98));border-radius:22px;box-shadow:0 22px 65px rgba(0,0,0,.18)}.bench261-controls{padding:18px;position:sticky;top:88px}.bench261-panel-head,.bench261-map-card>header,.bench261-results-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.bench261-panel-head span,.bench261-map-card>header>div>span,.bench261-results-head>div>span{font-size:10px;font-weight:850;letter-spacing:.14em;color:var(--b-orange2)}.bench261-panel-head h2,.bench261-map-card h2,.bench261-results-head h2{margin:4px 0 0;font-size:18px}.bench261-icon-btn{width:38px;height:38px;padding:0}.bench261-presets{display:flex;gap:6px;overflow:auto;margin:16px 0 15px;padding-bottom:2px;scrollbar-width:none}.bench261-presets::-webkit-scrollbar{display:none}.bench261-presets button{white-space:nowrap;border:1px solid var(--b-line);background:#0d1014;color:#b9c0ca;border-radius:999px;padding:7px 10px;font-size:11px;font-weight:720}.bench261-presets button:hover{border-color:rgba(245,154,98,.42);color:#fff}.bench261-field-group{display:grid;gap:12px}.bench261-field{display:grid;gap:6px}.bench261-field>span{font-size:11px;font-weight:800;color:#cdd2d9}.bench261-field input,.bench261-field select{width:100%;height:44px;border:1px solid var(--b-line);border-radius:12px;background:#090c10;color:#f4f5f7;padding:0 12px;outline:0}.bench261-field input:focus,.bench261-field select:focus{border-color:rgba(245,154,98,.56);box-shadow:0 0 0 3px rgba(245,154,98,.08)}.bench261-field small{color:#78818d;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.bench261-input-row{display:grid;grid-template-columns:1fr 42px;gap:6px}.bench261-locate{border:1px solid var(--b-line);border-radius:12px;background:#11151a;color:var(--b-orange2)}.bench261-two-cols{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.bench261-block{margin-top:16px}.bench261-block-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.bench261-block-title>span{font-size:11px;font-weight:850}.bench261-block-title small{font-size:10px;color:#78818d}.bench261-mode-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.bench261-mode-grid label{position:relative;cursor:pointer}.bench261-mode-grid input{position:absolute;opacity:0;pointer-events:none}.bench261-mode-grid label>span{min-height:62px;border:1px solid var(--b-line);border-radius:13px;background:#0d1014;padding:9px 10px;display:grid;grid-template-columns:22px 1fr;grid-template-rows:auto auto;align-items:center;column-gap:4px}.bench261-mode-grid label>span svg{grid-row:1/3;color:#7d8793}.bench261-mode-grid b{font-size:12px}.bench261-mode-grid small{font-size:9px;color:#7e8792}.bench261-mode-grid input:checked+span{border-color:rgba(245,154,98,.48);background:linear-gradient(135deg,rgba(245,154,98,.13),rgba(245,154,98,.035));box-shadow:inset 0 0 0 1px rgba(245,154,98,.05)}.bench261-mode-grid input:checked+span svg{color:var(--b-orange2)}.bench261-switch{display:flex;align-items:center;gap:8px;margin-top:21px;cursor:pointer}.bench261-switch>input{position:absolute;opacity:0}.bench261-switch>span{width:34px;height:20px;border-radius:999px;background:#292e35;position:relative;transition:.2s}.bench261-switch>span:after{content:"";position:absolute;width:14px;height:14px;border-radius:50%;left:3px;top:3px;background:#9ba2ab;transition:.2s}.bench261-switch input:checked+span{background:rgba(245,154,98,.28)}.bench261-switch input:checked+span:after{left:17px;background:var(--b-orange2)}.bench261-switch div{display:grid}.bench261-switch b{font-size:10px}.bench261-switch small{font-size:9px;color:#737c88}.bench261-details{margin-top:14px;border:1px solid var(--b-line);border-radius:13px;background:#0d1014}.bench261-details summary{padding:11px 12px;list-style:none;display:flex;justify-content:space-between;align-items:center;font-size:11px;font-weight:760;cursor:pointer}.bench261-details summary::-webkit-details-marker{display:none}.bench261-checks{border-top:1px solid var(--b-line);padding:10px 12px;display:grid;gap:8px}.bench261-checks label{font-size:10px;color:#adb5c0;display:flex;gap:8px;align-items:center}.bench261-checks input{accent-color:var(--b-orange)}.bench261-run{width:100%;height:48px;margin-top:14px;border:0;border-radius:14px;background:linear-gradient(135deg,#ffb47e,#f58e50 58%,#ef6e2e);color:#17100c;display:flex;align-items:center;justify-content:center;gap:8px;font-weight:900;box-shadow:0 13px 30px rgba(245,154,98,.16)}.bench261-run:disabled{opacity:.6;cursor:wait}.bench261-progress{margin-top:12px}.bench261-progress>div{display:flex;justify-content:space-between;font-size:10px;color:#9aa2ad;margin-bottom:6px}.bench261-progress progress{width:100%;height:5px;border:0;border-radius:999px;overflow:hidden;background:#242930}.bench261-progress progress::-webkit-progress-bar{background:#242930}.bench261-progress progress::-webkit-progress-value{background:linear-gradient(90deg,#ffb079,#f59a62)}.bench261-progress progress::-moz-progress-bar{background:#f59a62}.bench261-message{min-height:18px;margin-top:8px;font-size:10px;color:#8d96a2}.bench261-message.error{color:#ff8b8b}.bench261-message.ok{color:#79d8a8}.bench261-main{display:grid;gap:16px;min-width:0}.bench261-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.bench261-summary article{min-height:93px;border:1px solid var(--b-line);border-radius:18px;background:linear-gradient(180deg,#15191e,#0f1216);padding:14px;display:flex;gap:11px;align-items:flex-start}.bench261-summary .summary-icon{width:36px;height:36px;border:1px solid rgba(245,154,98,.2);background:rgba(245,154,98,.08);border-radius:11px;color:var(--b-orange2);display:grid;place-items:center;flex:0 0 auto}.bench261-summary article>div{min-width:0;display:grid}.bench261-summary small{font-size:9px;letter-spacing:.1em;color:#7f8894}.bench261-summary b{font-size:22px;line-height:1.2;margin:3px 0;color:#f7f8fa}.bench261-summary em{font-size:9px;color:#747e8b;font-style:normal;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.bench261-map-card{overflow:hidden}.bench261-map-card>header{padding:14px 16px;border-bottom:1px solid var(--b-line)}.bench261-legend{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}.bench261-legend span{display:flex;gap:5px;align-items:center;font-size:9px;color:#9099a5}.bench261-legend i{width:14px;height:3px;border-radius:99px;background:#777}.bench261-legend .fastest i{background:#5ba8ff}.bench261-legend .smart i{background:#f59a62}.bench261-legend .safest i{background:#62d39c}.bench261-legend .quietest i{background:#b58cff}.bench261-map{height:390px;position:relative;background:#0b0e12}.bench261-map-empty{position:absolute;z-index:2;inset:0;display:grid;place-content:center;text-align:center;gap:5px;color:#7e8792;pointer-events:none}.bench261-map-empty svg{margin:auto;color:#5f6874}.bench261-map-empty b{color:#c8ced6;font-size:12px}.bench261-map-empty span{font-size:10px}.bench261-results-card{overflow:hidden}.bench261-results-head{padding:15px 16px;border-bottom:1px solid var(--b-line)}.bench261-result-meta{font-size:10px;color:#7f8995}.bench261-mode-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;padding:12px 14px 0}.bench261-mode-summary:empty{display:none}.bench261-mode-chip{border:1px solid var(--b-line);border-radius:13px;background:#0e1115;padding:10px}.bench261-mode-chip>span{display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#9ca5b0}.bench261-mode-chip>span b{color:#f3f5f7}.bench261-mode-chip>strong{display:block;font-size:19px;margin:7px 0 3px}.bench261-mode-chip>small{font-size:9px;color:#77818d}.bench261-table-wrap{overflow:auto;padding:12px 14px 14px}.bench261-table{width:100%;border-collapse:separate;border-spacing:0;min-width:1050px;font-size:10px}.bench261-table th{text-align:left;color:#75808d;font-size:9px;letter-spacing:.06em;padding:8px 9px;border-bottom:1px solid var(--b-line);position:sticky;top:0;background:#111419}.bench261-table td{padding:10px 9px;border-bottom:1px solid rgba(255,255,255,.045);color:#b9c1cb;white-space:nowrap}.bench261-table tr:last-child td{border-bottom:0}.bench261-table .mode-pill{display:inline-flex;align-items:center;gap:6px;font-weight:800;color:#fff}.bench261-table .mode-pill i{width:7px;height:7px;border-radius:50%;background:#777}.bench261-table .mode-fastest i{background:#5ba8ff}.bench261-table .mode-smart i{background:#f59a62}.bench261-table .mode-safest i{background:#62d39c}.bench261-table .mode-quietest i{background:#b58cff}.bench261-status{display:inline-flex;padding:4px 7px;border-radius:999px;background:rgba(77,205,137,.08);color:#76dca6}.bench261-status.fail{background:rgba(255,87,87,.08);color:#ff8b8b}.bench261-cache{color:#ffb47e}.bench261-empty-row td{text-align:center!important;padding:32px!important;color:#707a86!important}.mapboxgl-ctrl-group{background:#13171c!important;border:1px solid rgba(255,255,255,.08)!important;box-shadow:none!important}.mapboxgl-ctrl-group button{background:transparent!important}.mapboxgl-ctrl-icon{filter:invert(1);opacity:.72}.mapboxgl-popup-content{background:#12161b!important;color:#f4f5f7!important;border:1px solid rgba(255,255,255,.08);border-radius:12px!important;padding:9px 11px!important;font:10px Inter,system-ui,sans-serif}.mapboxgl-popup-tip{border-top-color:#12161b!important}.bench261-map .mapboxgl-canvas{outline:0}.bench261-route-label{font-size:10px}.bench261-route-label b{display:block;font-size:11px;margin-bottom:2px}.bench261-route-label span{color:#9ba4af}
@media(max-width:1100px){.bench261-grid{grid-template-columns:1fr}.bench261-controls{position:relative;top:auto}.bench261-summary{grid-template-columns:repeat(2,1fr)}}
@media(max-width:680px){.bench261{padding-top:12px}.bench261-shell{width:calc(100% - 14px)}.bench261-head{display:grid;gap:13px}.bench261-head-actions{display:grid;grid-template-columns:1fr 1fr 1fr}.bench261-btn{padding:0 8px;font-size:10px}.bench261-controls{padding:14px;border-radius:17px}.bench261-two-cols{grid-template-columns:1fr 1fr}.bench261-summary{gap:7px}.bench261-summary article{padding:11px;min-height:82px}.bench261-summary .summary-icon{display:none}.bench261-summary b{font-size:19px}.bench261-map{height:320px}.bench261-map-card,.bench261-results-card{border-radius:17px}.bench261-map-card>header{align-items:flex-start}.bench261-legend{max-width:180px;gap:5px 8px}.bench261-mode-summary{grid-template-columns:1fr 1fr}.bench261-head h1{font-size:32px}.bench261-head p{font-size:12px}.bench261-mode-grid label>span{min-height:58px}.bench261-table-wrap{padding:9px}.bench261-result-meta{display:none}}
/* VANO benchmark hardening */
.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
.bench261-run-row{display:flex;align-items:stretch;gap:8px;margin-top:14px}.bench261-run-row .bench261-run{flex:1 1 auto;margin-top:0}.bench261-run-row .bench261-btn{min-height:48px}.bench261-message.warn{color:#ffcc7f}.bench261-mode-grid input:focus-visible+span,.bench261-switch>input:focus-visible+span{outline:2px solid var(--b-orange2);outline-offset:2px}.bench261-locate:focus-visible,.bench261-btn:focus-visible,.bench261-icon-btn:focus-visible,.bench261-run:focus-visible{outline:2px solid var(--b-orange2);outline-offset:2px}.bench261-controls{max-height:calc(100dvh - 104px);overflow:auto;scrollbar-width:thin}.bench261-table th:first-child,.bench261-table td:first-child{position:sticky;left:0;z-index:2;background:#111419}.bench261-table td:first-child{background:#0f1216}.bench261-status.warn{background:rgba(255,176,32,.1);color:#ffcc7f}
@media(max-width:680px){.bench261{min-height:calc(100svh - 72px)}.bench261-controls{max-height:none;overflow:visible}.bench261-run-row{display:grid;grid-template-columns:minmax(0,1fr) auto}.bench261-table{min-width:920px;font-size:10px}.bench261-field input,.bench261-field select{font-size:16px}.bench261-table-wrap{overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}}
@media(prefers-reduced-motion:reduce){.bench261 *{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important}}


/* ===== static/vano-benchmark.css ===== */
/* VANO — Route Benchmark / Admin lab. Scoped to .bench261. */
.bench261{--b-bg:#0b0d10;--b-card:#111419;--b-card2:#161a20;--b-line:rgba(255,255,255,.085);--b-text:#f7f8fa;--b-muted:#939ca9;--b-orange:#f59a62;--b-orange2:#ffb079;min-height:calc(100vh - 72px);background:radial-gradient(circle at 18% 0,rgba(245,154,98,.095),transparent 28%),#0a0c0f;color:var(--b-text);padding:24px 0 56px}.bench261 *{box-sizing:border-box}.bench261-shell{width:min(1480px,calc(100% - 28px));margin:auto}.bench261-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;margin-bottom:20px}.bench261-kicker{display:inline-flex;align-items:center;gap:7px;color:var(--b-orange2);font-size:11px;font-weight:850;letter-spacing:.14em}.bench261-head h1{font-size:clamp(30px,4vw,48px);line-height:1;margin:8px 0 9px;letter-spacing:-1.8px}.bench261-head p{margin:0;color:var(--b-muted);max-width:760px;line-height:1.55}.bench261-head-actions{display:flex;gap:8px;flex-wrap:wrap}.bench261-btn,.bench261-icon-btn{border:1px solid var(--b-line);background:var(--b-card2);color:var(--b-text);border-radius:12px;min-height:40px;padding:0 13px;display:inline-flex;align-items:center;justify-content:center;gap:7px;font-weight:760}.bench261-btn.ghost{background:rgba(255,255,255,.025)}.bench261-btn:disabled{opacity:.4;cursor:not-allowed}.bench261-grid{display:grid;grid-template-columns:minmax(310px,390px) minmax(0,1fr);gap:16px;align-items:start}.bench261-panel,.bench261-map-card,.bench261-results-card{border:1px solid var(--b-line);background:linear-gradient(180deg,rgba(20,24,29,.97),rgba(12,15,18,.98));border-radius:22px;box-shadow:0 22px 65px rgba(0,0,0,.18)}.bench261-controls{padding:18px;position:sticky;top:88px}.bench261-panel-head,.bench261-map-card>header,.bench261-results-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.bench261-panel-head span,.bench261-map-card>header>div>span,.bench261-results-head>div>span{font-size:10px;font-weight:850;letter-spacing:.14em;color:var(--b-orange2)}.bench261-panel-head h2,.bench261-map-card h2,.bench261-results-head h2{margin:4px 0 0;font-size:18px}.bench261-icon-btn{width:38px;height:38px;padding:0}.bench261-presets{display:flex;gap:6px;overflow:auto;margin:16px 0 15px;padding-bottom:2px;scrollbar-width:none}.bench261-presets::-webkit-scrollbar{display:none}.bench261-presets button{white-space:nowrap;border:1px solid var(--b-line);background:#0d1014;color:#b9c0ca;border-radius:999px;padding:7px 10px;font-size:11px;font-weight:720}.bench261-presets button:hover{border-color:rgba(245,154,98,.42);color:#fff}.bench261-field-group{display:grid;gap:12px}.bench261-field{display:grid;gap:6px}.bench261-field>span{font-size:11px;font-weight:800;color:#cdd2d9}.bench261-field input,.bench261-field select{width:100%;height:44px;border:1px solid var(--b-line);border-radius:12px;background:#090c10;color:#f4f5f7;padding:0 12px;outline:0}.bench261-field input:focus,.bench261-field select:focus{border-color:rgba(245,154,98,.56);box-shadow:0 0 0 3px rgba(245,154,98,.08)}.bench261-field small{color:#78818d;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.bench261-input-row{display:grid;grid-template-columns:1fr 42px;gap:6px}.bench261-locate{border:1px solid var(--b-line);border-radius:12px;background:#11151a;color:var(--b-orange2)}.bench261-two-cols{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.bench261-block{margin-top:16px}.bench261-block-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.bench261-block-title>span{font-size:11px;font-weight:850}.bench261-block-title small{font-size:10px;color:#78818d}.bench261-mode-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.bench261-mode-grid label{position:relative;cursor:pointer}.bench261-mode-grid input{position:absolute;opacity:0;pointer-events:none}.bench261-mode-grid label>span{min-height:62px;border:1px solid var(--b-line);border-radius:13px;background:#0d1014;padding:9px 10px;display:grid;grid-template-columns:22px 1fr;grid-template-rows:auto auto;align-items:center;column-gap:4px}.bench261-mode-grid label>span svg{grid-row:1/3;color:#7d8793}.bench261-mode-grid b{font-size:12px}.bench261-mode-grid small{font-size:9px;color:#7e8792}.bench261-mode-grid input:checked+span{border-color:rgba(245,154,98,.48);background:linear-gradient(135deg,rgba(245,154,98,.13),rgba(245,154,98,.035));box-shadow:inset 0 0 0 1px rgba(245,154,98,.05)}.bench261-mode-grid input:checked+span svg{color:var(--b-orange2)}.bench261-switch{display:flex;align-items:center;gap:8px;margin-top:21px;cursor:pointer}.bench261-switch>input{position:absolute;opacity:0}.bench261-switch>span{width:34px;height:20px;border-radius:999px;background:#292e35;position:relative;transition:.2s}.bench261-switch>span:after{content:"";position:absolute;width:14px;height:14px;border-radius:50%;left:3px;top:3px;background:#9ba2ab;transition:.2s}.bench261-switch input:checked+span{background:rgba(245,154,98,.28)}.bench261-switch input:checked+span:after{left:17px;background:var(--b-orange2)}.bench261-switch div{display:grid}.bench261-switch b{font-size:10px}.bench261-switch small{font-size:9px;color:#737c88}.bench261-details{margin-top:14px;border:1px solid var(--b-line);border-radius:13px;background:#0d1014}.bench261-details summary{padding:11px 12px;list-style:none;display:flex;justify-content:space-between;align-items:center;font-size:11px;font-weight:760;cursor:pointer}.bench261-details summary::-webkit-details-marker{display:none}.bench261-checks{border-top:1px solid var(--b-line);padding:10px 12px;display:grid;gap:8px}.bench261-checks label{font-size:10px;color:#adb5c0;display:flex;gap:8px;align-items:center}.bench261-checks input{accent-color:var(--b-orange)}.bench261-run{width:100%;height:48px;margin-top:14px;border:0;border-radius:14px;background:linear-gradient(135deg,#ffb47e,#f58e50 58%,#ef6e2e);color:#17100c;display:flex;align-items:center;justify-content:center;gap:8px;font-weight:900;box-shadow:0 13px 30px rgba(245,154,98,.16)}.bench261-run:disabled{opacity:.6;cursor:wait}.bench261-progress{margin-top:12px}.bench261-progress>div{display:flex;justify-content:space-between;font-size:10px;color:#9aa2ad;margin-bottom:6px}.bench261-progress progress{width:100%;height:5px;border:0;border-radius:999px;overflow:hidden;background:#242930}.bench261-progress progress::-webkit-progress-bar{background:#242930}.bench261-progress progress::-webkit-progress-value{background:linear-gradient(90deg,#ffb079,#f59a62)}.bench261-progress progress::-moz-progress-bar{background:#f59a62}.bench261-message{min-height:18px;margin-top:8px;font-size:10px;color:#8d96a2}.bench261-message.error{color:#ff8b8b}.bench261-message.ok{color:#79d8a8}.bench261-main{display:grid;gap:16px;min-width:0}.bench261-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.bench261-summary article{min-height:93px;border:1px solid var(--b-line);border-radius:18px;background:linear-gradient(180deg,#15191e,#0f1216);padding:14px;display:flex;gap:11px;align-items:flex-start}.bench261-summary .summary-icon{width:36px;height:36px;border:1px solid rgba(245,154,98,.2);background:rgba(245,154,98,.08);border-radius:11px;color:var(--b-orange2);display:grid;place-items:center;flex:0 0 auto}.bench261-summary article>div{min-width:0;display:grid}.bench261-summary small{font-size:9px;letter-spacing:.1em;color:#7f8894}.bench261-summary b{font-size:22px;line-height:1.2;margin:3px 0;color:#f7f8fa}.bench261-summary em{font-size:9px;color:#747e8b;font-style:normal;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.bench261-map-card{overflow:hidden}.bench261-map-card>header{padding:14px 16px;border-bottom:1px solid var(--b-line)}.bench261-legend{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}.bench261-legend span{display:flex;gap:5px;align-items:center;font-size:9px;color:#9099a5}.bench261-legend i{width:14px;height:3px;border-radius:99px;background:#777}.bench261-legend .fastest i{background:#5ba8ff}.bench261-legend .smart i{background:#f59a62}.bench261-legend .safest i{background:#62d39c}.bench261-legend .quietest i{background:#b58cff}.bench261-map{height:390px;position:relative;background:#0b0e12}.bench261-map-empty{position:absolute;z-index:2;inset:0;display:grid;place-content:center;text-align:center;gap:5px;color:#7e8792;pointer-events:none}.bench261-map-empty svg{margin:auto;color:#5f6874}.bench261-map-empty b{color:#c8ced6;font-size:12px}.bench261-map-empty span{font-size:10px}.bench261-results-card{overflow:hidden}.bench261-results-head{padding:15px 16px;border-bottom:1px solid var(--b-line)}.bench261-result-meta{font-size:10px;color:#7f8995}.bench261-mode-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;padding:12px 14px 0}.bench261-mode-summary:empty{display:none}.bench261-mode-chip{border:1px solid var(--b-line);border-radius:13px;background:#0e1115;padding:10px}.bench261-mode-chip>span{display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#9ca5b0}.bench261-mode-chip>span b{color:#f3f5f7}.bench261-mode-chip>strong{display:block;font-size:19px;margin:7px 0 3px}.bench261-mode-chip>small{font-size:9px;color:#77818d}.bench261-table-wrap{overflow:auto;padding:12px 14px 14px}.bench261-table{width:100%;border-collapse:separate;border-spacing:0;min-width:1050px;font-size:10px}.bench261-table th{text-align:left;color:#75808d;font-size:9px;letter-spacing:.06em;padding:8px 9px;border-bottom:1px solid var(--b-line);position:sticky;top:0;background:#111419}.bench261-table td{padding:10px 9px;border-bottom:1px solid rgba(255,255,255,.045);color:#b9c1cb;white-space:nowrap}.bench261-table tr:last-child td{border-bottom:0}.bench261-table .mode-pill{display:inline-flex;align-items:center;gap:6px;font-weight:800;color:#fff}.bench261-table .mode-pill i{width:7px;height:7px;border-radius:50%;background:#777}.bench261-table .mode-fastest i{background:#5ba8ff}.bench261-table .mode-smart i{background:#f59a62}.bench261-table .mode-safest i{background:#62d39c}.bench261-table .mode-quietest i{background:#b58cff}.bench261-status{display:inline-flex;padding:4px 7px;border-radius:999px;background:rgba(77,205,137,.08);color:#76dca6}.bench261-status.fail{background:rgba(255,87,87,.08);color:#ff8b8b}.bench261-cache{color:#ffb47e}.bench261-empty-row td{text-align:center!important;padding:32px!important;color:#707a86!important}.mapboxgl-ctrl-group{background:#13171c!important;border:1px solid rgba(255,255,255,.08)!important;box-shadow:none!important}.mapboxgl-ctrl-group button{background:transparent!important}.mapboxgl-ctrl-icon{filter:invert(1);opacity:.72}.mapboxgl-popup-content{background:#12161b!important;color:#f4f5f7!important;border:1px solid rgba(255,255,255,.08);border-radius:12px!important;padding:9px 11px!important;font:10px Inter,system-ui,sans-serif}.mapboxgl-popup-tip{border-top-color:#12161b!important}.bench261-map .mapboxgl-canvas{outline:0}.bench261-route-label{font-size:10px}.bench261-route-label b{display:block;font-size:11px;margin-bottom:2px}.bench261-route-label span{color:#9ba4af}
@media(max-width:1100px){.bench261-grid{grid-template-columns:1fr}.bench261-controls{position:relative;top:auto}.bench261-summary{grid-template-columns:repeat(2,1fr)}}
@media(max-width:680px){.bench261{padding-top:12px}.bench261-shell{width:calc(100% - 14px)}.bench261-head{display:grid;gap:13px}.bench261-head-actions{display:grid;grid-template-columns:1fr 1fr 1fr}.bench261-btn{padding:0 8px;font-size:10px}.bench261-controls{padding:14px;border-radius:17px}.bench261-two-cols{grid-template-columns:1fr 1fr}.bench261-summary{gap:7px}.bench261-summary article{padding:11px;min-height:82px}.bench261-summary .summary-icon{display:none}.bench261-summary b{font-size:19px}.bench261-map{height:320px}.bench261-map-card,.bench261-results-card{border-radius:17px}.bench261-map-card>header{align-items:flex-start}.bench261-legend{max-width:180px;gap:5px 8px}.bench261-mode-summary{grid-template-columns:1fr 1fr}.bench261-head h1{font-size:32px}.bench261-head p{font-size:12px}.bench261-mode-grid label>span{min-height:58px}.bench261-table-wrap{padding:9px}.bench261-result-meta{display:none}}
/* VANO benchmark hardening */
.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
.bench261-run-row{display:flex;align-items:stretch;gap:8px;margin-top:14px}.bench261-run-row .bench261-run{flex:1 1 auto;margin-top:0}.bench261-run-row .bench261-btn{min-height:48px}.bench261-message.warn{color:#ffcc7f}.bench261-mode-grid input:focus-visible+span,.bench261-switch>input:focus-visible+span{outline:2px solid var(--b-orange2);outline-offset:2px}.bench261-locate:focus-visible,.bench261-btn:focus-visible,.bench261-icon-btn:focus-visible,.bench261-run:focus-visible{outline:2px solid var(--b-orange2);outline-offset:2px}.bench261-controls{max-height:calc(100dvh - 104px);overflow:auto;scrollbar-width:thin}.bench261-table th:first-child,.bench261-table td:first-child{position:sticky;left:0;z-index:2;background:#111419}.bench261-table td:first-child{background:#0f1216}.bench261-status.warn{background:rgba(255,176,32,.1);color:#ffcc7f}
@media(max-width:680px){.bench261{min-height:calc(100svh - 72px)}.bench261-controls{max-height:none;overflow:visible}.bench261-run-row{display:grid;grid-template-columns:minmax(0,1fr) auto}.bench261-table{min-width:920px;font-size:10px}.bench261-field input,.bench261-field select{font-size:16px}.bench261-table-wrap{overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}}
@media(prefers-reduced-motion:reduce){.bench261 *{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important}}

/* V325 public agent benchmark */
.bench261-head .bench261-kicker{letter-spacing:.08em}.bench261-message{line-height:1.45}.bench261-panel{box-shadow:0 18px 50px rgba(0,0,0,.16)}
@media(max-width:680px){.bench261-head-actions{grid-template-columns:1fr 1fr 1fr}.bench261-summary{grid-template-columns:1fr 1fr}.bench261-map{height:300px}}


/* ===== static/vano-brand.css ===== */
/* VANO MAPS — unified brand system, responsive desktop/tablet polish */
body.vano-auth-startup{
  --vano-brand-red:#FF3D00;
  --vano-brand-orange:#FF7A00;
  --vano-brand-soft:#FFA552;
  --vano-brand-amber:#FFD280;
  --vano-brand-cream:#FFF7ED;
  --vano-brand-ink:#181411;
  --vano-brand-dark:#100E0D;
  --vano:#FF7A00;
  --vano-2:#FF3D00;
  --vano-deep:#FF3D00;
  --vano-soft:#FFF7ED;
  --vano-focus:rgba(255,122,0,.15);
  --orange:#FF7A00;
  --orange-2:#FF3D00;
  --orange-3:#FFA552;
  --brand:#FF7A00;
  --brand-2:#FF3D00;
  --brand-soft:#FFF7ED;
  --max:1360px;
}

html body.vano-auth-startup{accent-color:var(--vano-brand-orange)}
body.vano-auth-startup ::selection{background:rgba(255,122,0,.22);color:inherit}
body.vano-auth-startup [data-lucide]{stroke-linecap:round;stroke-linejoin:round;stroke-width:2.05}

/* ---- shared public surfaces ---- */
html[data-vano-theme="light"] body.vano-auth-startup.vano-page-surface,
html[data-vano-theme="light"] body.vano-auth-startup.vano-admin-surface{
  background:
    radial-gradient(circle at 8% -5%,rgba(255,210,128,.24),transparent 24%),
    radial-gradient(circle at 94% 0%,rgba(255,165,82,.12),transparent 21%),
    #FFF9F4!important;
  color:#211B17!important;
}
html[data-vano-theme="black"] body.vano-auth-startup.vano-page-surface,
html[data-vano-theme="black"] body.vano-auth-startup.vano-admin-surface{
  background:
    radial-gradient(circle at 10% -8%,rgba(255,122,0,.10),transparent 24%),
    #0F0E0D!important;
  color:#FFF9F4!important;
}
body.vano-auth-startup.vano-page-surface:before,
body.vano-auth-startup.vano-admin-surface:before{display:none!important}

body.vano-auth-startup.vano-page-surface .topbar,
body.vano-auth-startup.vano-admin-surface .topbar{
  height:68px!important;
  background:rgba(255,250,246,.86)!important;
  border-bottom:1px solid rgba(80,45,25,.08)!important;
  box-shadow:0 8px 28px rgba(71,42,22,.055)!important;
  backdrop-filter:blur(24px) saturate(150%)!important;
  -webkit-backdrop-filter:blur(24px) saturate(150%)!important;
}
html[data-vano-theme="black"] body.vano-auth-startup.vano-page-surface .topbar,
html[data-vano-theme="black"] body.vano-auth-startup.vano-admin-surface .topbar{
  background:rgba(15,14,13,.88)!important;
  border-bottom-color:rgba(255,255,255,.07)!important;
  box-shadow:0 8px 30px rgba(0,0,0,.16)!important;
}
body.vano-auth-startup.vano-page-surface .nav,
body.vano-auth-startup.vano-admin-surface .nav{width:min(1360px,calc(100% - 40px));gap:18px}
body.vano-auth-startup.vano-page-surface .vano-nav-brand,
body.vano-auth-startup.vano-admin-surface .vano-nav-brand{min-width:150px}
body.vano-auth-startup.vano-page-surface .vano-nav-brand-images>.vano-brand-img,
body.vano-auth-startup.vano-admin-surface .vano-nav-brand-images>.vano-brand-img{
  height:42px!important;max-width:152px!important;width:auto!important;object-fit:contain!important;object-position:left center!important;
}
body.vano-auth-startup.vano-page-surface .brand:before,
body.vano-auth-startup.vano-admin-surface .brand:before{display:none!important}
body.vano-auth-startup.vano-page-surface .navlinks a,
body.vano-auth-startup.vano-admin-surface .navlinks a,
body.vano-auth-startup.vano-page-surface .navlinks button.navbtn,
body.vano-auth-startup.vano-admin-surface .navlinks button.navbtn{
  color:#74685F!important;border-radius:12px!important;font-size:13px!important;font-weight:720!important;padding:9px 12px!important;
}
body.vano-auth-startup.vano-page-surface .navlinks a:hover,
body.vano-auth-startup.vano-page-surface .navlinks a.active,
body.vano-auth-startup.vano-admin-surface .navlinks a:hover,
body.vano-auth-startup.vano-admin-surface .navlinks a.active{
  color:#E74300!important;background:#FFF0E7!important;
}
html[data-vano-theme="black"] body.vano-auth-startup.vano-page-surface .navlinks a,
html[data-vano-theme="black"] body.vano-auth-startup.vano-admin-surface .navlinks a{color:#B7ACA5!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-page-surface .navlinks a:hover,
html[data-vano-theme="black"] body.vano-auth-startup.vano-page-surface .navlinks a.active,
html[data-vano-theme="black"] body.vano-auth-startup.vano-admin-surface .navlinks a:hover,
html[data-vano-theme="black"] body.vano-auth-startup.vano-admin-surface .navlinks a.active{
  color:#FFB17B!important;background:#251A14!important;
}

body.vano-auth-startup.vano-page-surface .btn,
body.vano-auth-startup.vano-admin-surface .btn{
  min-height:42px!important;border-radius:13px!important;border-color:#E9DED6!important;background:#FFFDFB!important;color:#433A34!important;
  box-shadow:0 5px 16px rgba(67,46,33,.04)!important;font-weight:760!important;
}
body.vano-auth-startup.vano-page-surface .btn:hover,
body.vano-auth-startup.vano-admin-surface .btn:hover{border-color:#FFD0B4!important;background:#FFF8F3!important}
body.vano-auth-startup.vano-page-surface .btn-primary,
body.vano-auth-startup.vano-admin-surface .btn-primary,
body.vano-auth-startup.vano-login-v258 .auth-button.email{
  border-color:transparent!important;color:#fff!important;
  background:linear-gradient(135deg,#FF7A00 0%,#FF5B00 52%,#FF3D00 100%)!important;
  box-shadow:0 12px 28px rgba(255,82,0,.22),inset 0 1px 0 rgba(255,255,255,.24)!important;
}
body.vano-auth-startup.vano-page-surface .btn-primary:hover,
body.vano-auth-startup.vano-admin-surface .btn-primary:hover{box-shadow:0 15px 34px rgba(255,82,0,.28)!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-page-surface .btn,
html[data-vano-theme="black"] body.vano-auth-startup.vano-admin-surface .btn{background:#1A1715!important;border-color:#302B27!important;color:#F9F2EC!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-page-surface .btn-primary,
html[data-vano-theme="black"] body.vano-auth-startup.vano-admin-surface .btn-primary{background:linear-gradient(135deg,#FF7A00,#FF3D00)!important;border-color:transparent!important}

body.vano-auth-startup.vano-page-surface :is(.panel,.card,.kpi,.alert-card,.auth-card),
body.vano-auth-startup.vano-admin-surface :is(.panel,.card,.kpi,.alert-card){
  border-color:#EEE4DC!important;background:rgba(255,255,255,.90)!important;color:#2B231E!important;
  box-shadow:0 16px 45px rgba(82,54,35,.07),inset 0 1px 0 rgba(255,255,255,.9)!important;
}
html[data-vano-theme="black"] body.vano-auth-startup.vano-page-surface :is(.panel,.card,.kpi,.alert-card,.auth-card),
html[data-vano-theme="black"] body.vano-auth-startup.vano-admin-surface :is(.panel,.card,.kpi,.alert-card){
  background:#171411!important;border-color:#2B2723!important;color:#F8F1EB!important;box-shadow:0 16px 45px rgba(0,0,0,.16)!important;
}
body.vano-auth-startup.vano-page-surface :is(.page-title,.title,.section-title),
body.vano-auth-startup.vano-admin-surface :is(.page-title,.title,.section-title){color:#211A16!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-page-surface :is(.page-title,.title,.section-title),
html[data-vano-theme="black"] body.vano-auth-startup.vano-admin-surface :is(.page-title,.title,.section-title){color:#FFF9F4!important}
body.vano-auth-startup.vano-page-surface :is(.page-subtitle,.subtitle,.muted),
body.vano-auth-startup.vano-admin-surface :is(.page-subtitle,.subtitle,.muted){color:#756A62!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-page-surface :is(.page-subtitle,.subtitle,.muted),
html[data-vano-theme="black"] body.vano-auth-startup.vano-admin-surface :is(.page-subtitle,.subtitle,.muted){color:#A99E96!important}
body.vano-auth-startup.vano-page-surface .eyebrow,
body.vano-auth-startup.vano-admin-surface .eyebrow{color:#EF4B00!important}

body.vano-auth-startup.vano-page-surface :is(.iconbox,.alert-dot,.profile-detail summary .detail-icon),
body.vano-auth-startup.vano-admin-surface :is(.iconbox,.alert-dot){
  color:#F04B00!important;background:linear-gradient(145deg,#FFF7ED,#FFE6D4)!important;border-color:#FFD7BC!important;
  box-shadow:inset 0 1px 0 #fff,0 8px 20px rgba(255,90,0,.08)!important;
}
html[data-vano-theme="black"] body.vano-auth-startup.vano-page-surface :is(.iconbox,.alert-dot,.profile-detail summary .detail-icon),
html[data-vano-theme="black"] body.vano-auth-startup.vano-admin-surface :is(.iconbox,.alert-dot){background:#261B15!important;border-color:#3B2A20!important;color:#FF9A55!important}

body.vano-auth-startup.vano-page-surface :is(.input,.select,.textarea,.settings-field input,.settings-field select,.place-card input,.invite-box input,.faq-search),
body.vano-auth-startup.vano-admin-surface :is(.input,.select,.textarea){
  min-height:46px!important;border-radius:13px!important;border-color:#E7DED7!important;background:#FFFEFD!important;color:#2B241F!important;
}
body.vano-auth-startup.vano-page-surface :is(.input,.select,.textarea,.settings-field input,.settings-field select,.place-card input,.invite-box input,.faq-search):focus,
body.vano-auth-startup.vano-admin-surface :is(.input,.select,.textarea):focus{border-color:#FF8B42!important;box-shadow:0 0 0 4px rgba(255,122,0,.12)!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-page-surface :is(.input,.select,.textarea,.settings-field input,.settings-field select,.place-card input,.invite-box input,.faq-search),
html[data-vano-theme="black"] body.vano-auth-startup.vano-admin-surface :is(.input,.select,.textarea){background:#100F0E!important;border-color:#302C28!important;color:#F8F1EC!important}

body.vano-auth-startup .vano-theme-toggle{border-radius:13px!important}
body.vano-auth-startup.vano-page-surface .vano-theme-toggle,
body.vano-auth-startup.vano-admin-surface .vano-theme-toggle{border-color:#E8DED7!important;background:#FFFDFB!important;color:#62564E!important}
body.vano-auth-startup.vano-page-surface .vano-theme-toggle:hover,
body.vano-auth-startup.vano-admin-surface .vano-theme-toggle:hover{border-color:#FFC9A7!important;background:#FFF3EA!important;color:#E54A00!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-page-surface .vano-theme-toggle,
html[data-vano-theme="black"] body.vano-auth-startup.vano-admin-surface .vano-theme-toggle{background:#1B1816!important;border-color:#312C28!important;color:#E6DCD4!important}

/* ---- map surfaces: one consistent visual language ---- */
body.vano-auth-startup.vano-map-surface{
  --ui-ink:#261F1A;
  --ui-muted:#746B65;
  --ui-surface:rgba(255,253,250,.975);
  --ui-soft:#FFF5ED;
  --ui-line:#EADFD7;
  --ui-accent:#FF3D00;
  --ui-accent-soft:#FFF7ED;
  --ui-shadow:0 20px 58px rgba(55,39,28,.16),0 3px 10px rgba(55,39,28,.06);
  --vg-orange:#FF7A00;
  --vg-orange2:#FF7A00;
}
html[data-vano-theme="black"] body.vano-auth-startup.vano-map-surface{
  --ui-ink:#FFF7ED;
  --ui-muted:#B7AAA1;
  --ui-surface:rgba(24,21,19,.975);
  --ui-soft:#211C18;
  --ui-line:#3A312B;
  --ui-accent:#FF8B42;
  --ui-accent-soft:#302016;
  --ui-shadow:0 20px 60px rgba(0,0,0,.38),0 2px 10px rgba(0,0,0,.18);
}
body.vano-auth-startup.vano-map-surface #wsApp{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif!important}
body.vano-auth-startup.vano-map-surface #wsApp :is(.options-btn,.map-btn,.floating-locate,.floating-preview-cancel,.nav-stack-btn,.nav-audio-toggle,.nav-drawer-toggle,.nav-drawer-btn,.planner-adjust-btn,.row-btn){
  border-radius:15px!important;border-color:var(--ui-line)!important;background:var(--ui-surface)!important;color:var(--ui-ink)!important;
  box-shadow:0 10px 30px rgba(58,43,33,.10)!important;backdrop-filter:blur(18px) saturate(140%)!important;
}
body.vano-auth-startup.vano-map-surface #wsApp :is(.options-btn,.map-btn,.floating-locate,.nav-stack-btn,.nav-audio-toggle,.planner-adjust-btn,.row-btn):hover{border-color:#FFC59E!important;color:#E94A00!important;background:#FFF8F3!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-map-surface #wsApp :is(.options-btn,.map-btn,.floating-locate,.floating-preview-cancel,.nav-stack-btn,.nav-audio-toggle,.nav-drawer-toggle,.nav-drawer-btn,.planner-adjust-btn,.row-btn):hover{background:#2A211C!important;border-color:#5A3A28!important;color:#FFA56C!important}

body.vano-auth-startup.vano-map-surface #wsApp #planSheet,
body.vano-auth-startup.vano-map-surface #wsApp :is(#prefsDrawer,#safetyDrawer,#accountDrawer,#quickAlertSheet,#destinationConfirm,#resumeTripCard),
body.vano-auth-startup.vano-map-surface.body-nav #wsApp :is(#navManeuverTop,#activeNav.nav-panel.nav-minimal){
  background:var(--ui-surface)!important;border-color:var(--ui-line)!important;color:var(--ui-ink)!important;box-shadow:var(--ui-shadow)!important;
  backdrop-filter:blur(24px) saturate(150%)!important;-webkit-backdrop-filter:blur(24px) saturate(150%)!important;
}
body.vano-auth-startup.vano-map-surface #wsApp #planSheet{border-radius:28px!important}
body.vano-auth-startup.vano-map-surface #wsApp .planner-heading-copy small,
body.vano-auth-startup.vano-map-surface #wsApp .prefs-head-copy small,
body.vano-auth-startup.vano-map-surface #wsApp .prefs-section-label>span,
body.vano-auth-startup.vano-map-surface #wsApp .route-kicker,
body.vano-auth-startup.vano-map-surface #wsApp .route-head small{color:#F04E00!important}
body.vano-auth-startup.vano-map-surface #wsApp .planner-heading-copy b{color:var(--ui-ink)!important;letter-spacing:-.55px!important}
body.vano-auth-startup.vano-map-surface #wsApp .planner-search-card{
  background:var(--ui-surface)!important;border:1px solid var(--ui-line)!important;border-radius:18px!important;box-shadow:0 7px 24px rgba(63,45,31,.06)!important;
}
body.vano-auth-startup.vano-map-surface #wsApp .planner-location-row{background:transparent!important;border:0!important}
body.vano-auth-startup.vano-map-surface #wsApp #destinationInput{font-size:16px!important;color:var(--ui-ink)!important}
body.vano-auth-startup.vano-map-surface #wsApp #destinationInput::placeholder{color:#968B84!important}
body.vano-auth-startup.vano-map-surface #wsApp .planner-search-icon{color:#F04B00!important}
body.vano-auth-startup.vano-map-surface #wsApp .planner-capabilities span{border-color:#EBDDD3!important;background:#FFF9F4!important;color:#75675E!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-map-surface #wsApp .planner-capabilities span{background:#201B18!important;border-color:#342D28!important;color:#B9ADA5!important}
body.vano-auth-startup.vano-map-surface #wsApp :is(.planner-preset,.nearby-service){
  border:1px solid var(--ui-line)!important;border-radius:17px!important;background:linear-gradient(180deg,#FFFDFB,#FFF7ED)!important;color:var(--ui-ink)!important;box-shadow:0 5px 16px rgba(63,44,30,.04)!important;
}
body.vano-auth-startup.vano-map-surface #wsApp :is(.planner-preset,.nearby-service):hover{border-color:#FFA552!important;transform:translateY(-1px)!important;box-shadow:0 10px 24px rgba(255,90,0,.08)!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-map-surface #wsApp :is(.planner-preset,.nearby-service){background:linear-gradient(180deg,#211C19,#1B1715)!important;border-color:#382F29!important}
body.vano-auth-startup.vano-map-surface #wsApp :is(.planner-preset-icon,.nearby-service-icon,.route-option-icon){background:#FFF0E7!important;color:#F24E00!important;border-color:#FFD3B7!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-map-surface #wsApp :is(.planner-preset-icon,.nearby-service-icon,.route-option-icon){background:#302016!important;color:#FF9A5B!important;border-color:#4B3121!important}

body.vano-auth-startup.vano-map-surface #wsApp #startTripBtn,
body.vano-auth-startup.vano-map-surface #wsApp .destination-accept,
body.vano-auth-startup.vano-map-surface #wsApp .nav-alt-accept,
body.vano-auth-startup.vano-map-surface #wsApp .prefs-done,
body.vano-auth-startup.vano-map-surface #wsApp .vano-routine-save,
body.vano-auth-startup.vano-map-surface #wsApp .guest-drawer-primary{
  border-color:transparent!important;color:#fff!important;background:linear-gradient(135deg,#FF7A00 0%,#FF5A00 55%,#FF3D00 100%)!important;
  box-shadow:0 12px 28px rgba(255,78,0,.24),inset 0 1px 0 rgba(255,255,255,.22)!important;
}
body.vano-auth-startup.vano-map-surface #wsApp #startTripBtn:hover{box-shadow:0 16px 34px rgba(255,78,0,.30)!important}
body.vano-auth-startup.vano-map-surface #wsApp .pref-switch:checked::before{background:#FF5A00!important;border-color:#FF5A00!important}
body.vano-auth-startup.vano-map-surface #wsApp #smartBalance{accent-color:#FF5A00!important}

body.vano-auth-startup.vano-map-surface #wsApp :is(.route-variant,#routeMoreDetails,.sub-action,.parking-item,.pref-row,.safety-tool,.drawer-link,.guest-drawer-benefits span,.guest-drawer-secondary){border-color:var(--ui-line)!important}
body.vano-auth-startup.vano-map-surface #wsApp :is(.route-variant,.sub-action,.parking-item,.safety-tool,.drawer-link,.guest-drawer-benefits span,.guest-drawer-secondary){background:var(--ui-soft)!important;color:var(--ui-ink)!important}
body.vano-auth-startup.vano-map-surface #wsApp .route-variant.active{border-color:#FF9F66!important;background:#FFF1E7!important;box-shadow:inset 0 0 0 1px rgba(255,90,0,.08)!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-map-surface #wsApp .route-variant.active{background:#2D1E16!important;border-color:#74452A!important}
body.vano-auth-startup.vano-map-surface #wsApp #routeMoreContent{background:#FFF9F4!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-map-surface #wsApp #routeMoreContent{background:#171411!important}

body.vano-auth-startup.vano-map-surface.body-nav #wsApp #navManeuverTop .nav-maneuver-icon{background:#FFF0E6!important;color:#EE4A00!important;border-color:#FFD1B3!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-map-surface.body-nav #wsApp #navManeuverTop .nav-maneuver-icon{background:#302017!important;color:#FF9D60!important;border-color:#4B3223!important}
body.vano-auth-startup.vano-map-surface.body-nav #wsApp #activeNav .vano-nav-progress>i,
body.vano-auth-startup.vano-map-surface #wsApp .resume-trip-path{stroke:#FF5A00!important;background:#FF5A00!important}
body.vano-auth-startup.vano-map-surface.body-nav #wsApp #activeNav .vano-nav-trip-icon{color:#F04B00!important;background:#FFF0E7!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-map-surface.body-nav #wsApp #activeNav .vano-nav-trip-icon{background:#302016!important;color:#FF9D60!important}

/* brand in account drawer and splash */
body.vano-auth-startup.vano-map-surface #wsApp .guest-drawer-brand img,
body.vano-auth-startup.vano-map-surface #wsApp .v258-drawer-brand img{border-radius:14px!important;box-shadow:0 8px 20px rgba(255,78,0,.18)!important}
body.vano-auth-startup .vano-entry-splash-inner img{filter:drop-shadow(0 14px 30px rgba(255,78,0,.24))}

/* ---- tablet + desktop map layout ---- */
@media (min-width:768px){
  body.vano-auth-startup.vano-map-surface #wsApp{--ui-left:18px;--ui-right:18px;--ui-top:18px;--ui-bottom:18px}
  body.vano-auth-startup.vano-map-surface #wsApp #planSheet{
    left:18px!important;right:auto!important;top:18px!important;bottom:18px!important;width:min(400px,calc(100vw - 110px))!important;
    max-height:calc(100dvh - 36px)!important;overflow:auto!important;padding:18px!important;
  }
  body.vano-auth-startup.vano-map-surface #wsApp .planner-presets{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important}
  body.vano-auth-startup.vano-map-surface #wsApp .nearby-services{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important}
  body.vano-auth-startup.vano-map-surface #wsApp .planner-preset,
body.vano-auth-startup.vano-map-surface #wsApp .nearby-service{min-height:74px!important}
  body.vano-auth-startup.vano-map-surface #wsApp .map-tools{right:18px!important;top:18px!important}
  body.vano-auth-startup.vano-map-surface #wsApp .floating-locate{right:18px!important}
  body.vano-auth-startup.vano-map-surface #wsApp :is(#prefsDrawer,#safetyDrawer,#accountDrawer,#quickAlertSheet){left:auto!important;right:18px!important;bottom:18px!important;width:min(430px,calc(100vw - 36px))!important;max-height:calc(100dvh - 36px)!important;border-radius:26px!important}
  body.vano-auth-startup.vano-map-surface #wsApp :is(#destinationConfirm,#resumeTripCard){left:auto!important;right:18px!important;width:min(430px,calc(100vw - 36px))!important;bottom:18px!important}
  body.vano-auth-startup.vano-map-surface.body-nav #wsApp #navManeuverTop{left:18px!important;right:auto!important;top:18px!important;width:min(430px,calc(100vw - 110px))!important}
  body.vano-auth-startup.vano-map-surface.body-nav #wsApp #activeNav.nav-panel.nav-minimal{left:18px!important;right:auto!important;bottom:18px!important;width:min(430px,calc(100vw - 110px))!important}
  body.vano-auth-startup.vano-map-surface.body-nav #wsApp #navControlStack{right:18px!important;bottom:18px!important;left:auto!important}
  body.vano-auth-startup.vano-map-surface.body-nav #wsApp #vanoSpeedometerV220{left:466px!important;right:auto!important;bottom:18px!important}
}
@media (min-width:1180px){
  body.vano-auth-startup.vano-map-surface #wsApp{--ui-left:24px;--ui-right:24px;--ui-top:24px;--ui-bottom:24px}
  body.vano-auth-startup.vano-map-surface #wsApp #planSheet{left:24px!important;top:24px!important;bottom:24px!important;width:448px!important;max-height:calc(100dvh - 48px)!important;padding:20px!important}
  body.vano-auth-startup.vano-map-surface #wsApp .planner-heading-copy b{font-size:25px!important}
  body.vano-auth-startup.vano-map-surface #wsApp .planner-search-row{gap:10px!important}
  body.vano-auth-startup.vano-map-surface #wsApp .planner-presets{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  body.vano-auth-startup.vano-map-surface #wsApp .nearby-services{grid-template-columns:repeat(3,minmax(0,1fr))!important}
  body.vano-auth-startup.vano-map-surface #wsApp .nearby-service{min-height:92px!important;padding:12px 9px!important}
  body.vano-auth-startup.vano-map-surface #wsApp .map-tools{right:24px!important;top:24px!important}
  body.vano-auth-startup.vano-map-surface #wsApp .floating-locate{right:24px!important}
  body.vano-auth-startup.vano-map-surface #wsApp :is(#prefsDrawer,#safetyDrawer,#accountDrawer,#quickAlertSheet){right:24px!important;bottom:24px!important;width:454px!important;max-height:calc(100dvh - 48px)!important}
  body.vano-auth-startup.vano-map-surface #wsApp :is(#destinationConfirm,#resumeTripCard){right:24px!important;bottom:24px!important;width:454px!important}
  body.vano-auth-startup.vano-map-surface.body-nav #wsApp #navManeuverTop{left:24px!important;top:24px!important;width:448px!important}
  body.vano-auth-startup.vano-map-surface.body-nav #wsApp #activeNav.nav-panel.nav-minimal{left:24px!important;bottom:24px!important;width:448px!important}
  body.vano-auth-startup.vano-map-surface.body-nav #wsApp #navControlStack{right:24px!important;bottom:24px!important}
  body.vano-auth-startup.vano-map-surface.body-nav #wsApp #vanoSpeedometerV220{left:492px!important;bottom:24px!important}
  body.vano-auth-startup.vano-map-surface #wsApp .mapboxgl-ctrl-bottom-left{left:500px!important;transform:none!important}
}
@media (min-width:1500px){
  body.vano-auth-startup.vano-map-surface #wsApp #planSheet{width:470px!important}
  body.vano-auth-startup.vano-map-surface.body-nav #wsApp :is(#navManeuverTop,#activeNav.nav-panel.nav-minimal){width:470px!important}
  body.vano-auth-startup.vano-map-surface.body-nav #wsApp #vanoSpeedometerV220{left:516px!important}
}

/* ---- phone: preserve layout, upgrade touch/visual quality ---- */
@media (max-width:767px){
  body.vano-auth-startup.vano-map-surface #wsApp #planSheet{border-radius:24px 24px 0 0!important}
  body.vano-auth-startup.vano-map-surface #wsApp .planner-search-card{border-radius:17px!important}
  body.vano-auth-startup.vano-map-surface #wsApp .planner-preset,
body.vano-auth-startup.vano-map-surface #wsApp .nearby-service{border-radius:16px!important}
  body.vano-auth-startup.vano-map-surface #wsApp #startTripBtn{min-height:58px!important;border-radius:17px!important}
  body.vano-auth-startup.vano-page-surface .nav,
body.vano-auth-startup.vano-admin-surface .nav{width:calc(100% - 20px)!important}
  body.vano-auth-startup.vano-page-surface .vano-nav-brand-images>.vano-brand-img,
body.vano-auth-startup.vano-admin-surface .vano-nav-brand-images>.vano-brand-img{height:36px!important;max-width:126px!important}
}

/* ---- standalone auth ---- */
body.vano-auth-startup.vano-login-v258{--brand:#FF7A00!important;--brand-2:#FF3D00!important;--brand-soft:#FFF7ED!important;--surface-tint:#FFF7ED!important}
html[data-vano-theme="light"] body.vano-auth-startup.vano-login-v258{background:#FFF9F4!important;color:#211B17!important}
html[data-vano-theme="light"] body.vano-auth-startup.vano-login-v258 .auth-shell{border-color:#EDE2DA!important;background:#FFFDFB!important;box-shadow:0 28px 80px rgba(79,48,29,.10)!important}
html[data-vano-theme="light"] body.vano-auth-startup.vano-login-v258 .route-pane{background:linear-gradient(145deg,#FFF4EA,#F5EEE8)!important;border-color:#E9DED6!important}
body.vano-auth-startup.vano-login-v258 .vano-auth-banner{width:174px!important;height:58px!important;object-fit:contain!important;object-position:left center!important}
body.vano-auth-startup.vano-login-v258 .auth-button.email{background:linear-gradient(135deg,#FF7A00,#FF3D00)!important}
body.vano-auth-startup.vano-login-v258 .eyebrow{color:#EF4B00!important}
body.vano-auth-startup.vano-login-v258 .route-glow{background:rgba(255,122,0,.13)!important}
body.vano-auth-startup.vano-login-v258 .mini-chip svg{color:#F04B00!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-login-v258{background:#0F0E0D!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-login-v258 .auth-shell,
html[data-vano-theme="black"] body.vano-auth-startup.vano-login-v258 .auth-pane{background:#171411!important;border-color:#302A26!important}
html[data-vano-theme="black"] body.vano-auth-startup.vano-login-v258 .route-pane{background:linear-gradient(145deg,#211B17,#120F0D)!important;border-color:#302A26!important}
@media (min-width:1100px){body.vano-auth-startup.vano-login-v258 .auth-shell{grid-template-columns:minmax(440px,.86fr) minmax(620px,1.14fr)!important}}
@media (min-width:760px) and (max-width:1099px){body.vano-auth-startup.vano-login-v258 .auth-shell{grid-template-columns:minmax(370px,.96fr) minmax(390px,1.04fr)!important}body.vano-auth-startup .auth-pane{padding:38px!important}}

/* ---- standalone shared/live ---- */
body.vano-auth-startup.vano-shared-v258{--accent:#FF7A00!important}
body.vano-auth-startup.vano-shared-v258 .share-top,
body.vano-auth-startup.vano-shared-v258 .route-panel{border-color:#EADFD7!important;background:rgba(255,253,250,.97)!important;box-shadow:0 16px 45px rgba(70,45,28,.12)!important}
body.vano-auth-startup.vano-shared-v258 .route-kicker{color:#F04B00!important}
body.vano-auth-startup.vano-shared-v258 .route-note{background:#FFF0E6!important;color:#D94700!important}
body.vano-auth-startup.vano-shared-v258 .route-actions .primary{background:linear-gradient(135deg,#FF7A00,#FF3D00)!important;box-shadow:0 10px 24px rgba(255,79,0,.23)!important}
body.vano-auth-startup.vano-live-v258{--o:#FF7A00!important}
body.vano-auth-startup.vano-live-v258 .brand{gap:9px!important;padding:0 13px 0 7px!important}
body.vano-auth-startup.vano-live-v258 .brand img{width:36px;height:36px;border-radius:11px;object-fit:contain;box-shadow:0 7px 18px rgba(255,79,0,.20)}
body.vano-auth-startup.vano-live-v258 .progress i{background:linear-gradient(90deg,#FFD280,#FF7A00,#FF3D00)!important}
body.vano-auth-startup.vano-live-v258 .puck{background:linear-gradient(145deg,#FF7A00,#FF3D00)!important}

/* ---- generic responsive page/tablet polish ---- */
@media (min-width:760px) and (max-width:1099px){
  body.vano-auth-startup.vano-page-surface .container,
body.vano-auth-startup.vano-admin-surface .container{width:min(100% - 34px,1100px)!important}
  body.vano-auth-startup.vano-page-surface .grid-3{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  body.vano-auth-startup.vano-page-surface .kpi-grid,
body.vano-auth-startup.vano-admin-surface .kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  body.vano-auth-startup.vano-page-surface .navlinks,
body.vano-auth-startup.vano-admin-surface .navlinks{display:flex!important;gap:2px!important}
  body.vano-auth-startup.vano-page-surface .navlinks a,
body.vano-auth-startup.vano-admin-surface .navlinks a{padding-inline:9px!important;font-size:12px!important}
}
@media (max-width:859px){body.vano-auth-startup.vano-page-surface .navlinks,
body.vano-auth-startup.vano-admin-surface .navlinks{display:none!important}}
@media (min-width:1100px){
  body.vano-auth-startup.vano-page-surface .page,
body.vano-auth-startup.vano-admin-surface .page{padding-top:40px!important}
  body.vano-auth-startup.vano-page-surface .panel,
body.vano-auth-startup.vano-admin-surface .panel{border-radius:22px!important}
}

@media(prefers-reduced-motion:reduce){body.vano-auth-startup *{scroll-behavior:auto!important}}

/* Brand mark inside the planner: visible on larger screens, discreet on phones. */
body.vano-auth-startup.vano-map-surface #wsApp .planner-brand-icon{display:none;width:42px;height:42px;flex:0 0 42px;border-radius:13px;object-fit:contain;box-shadow:0 8px 20px rgba(255,61,0,.16)}
@media(min-width:768px){
  body.vano-auth-startup.vano-map-surface #wsApp .planner-heading{display:grid!important;grid-template-columns:42px minmax(0,1fr) auto!important;align-items:center!important;column-gap:10px!important}
  body.vano-auth-startup.vano-map-surface #wsApp .planner-brand-icon{display:block}
}


/* V330 — standalone live-trip desktop/tablet composition. */
@media (min-width: 900px){
  body.vano-auth-startup.vano-live-v258 .app{max-width:none;width:100%;margin:0;}
  body.vano-auth-startup.vano-live-v258 .top{left:24px;right:24px;top:24px;}
  body.vano-auth-startup.vano-live-v258 .card{
    left:24px;right:auto;bottom:24px;width:min(430px,calc(100vw - 48px));
    padding:16px 18px 18px;border-radius:26px;
  }
  body.vano-auth-startup.vano-live-v258 .card h1{font-size:24px;}
  body.vano-auth-startup.vano-live-v258 .card p{font-size:11px;}
  body.vano-auth-startup.vano-live-v258 .stat{padding:12px 8px;}
  body.vano-auth-startup.vano-live-v258 .stat b{font-size:14px;}
  body.vano-auth-startup.vano-live-v258 .mapboxgl-ctrl-bottom-right{bottom:24px;}
}

/* Brand-board canonical swatches available to every page/component. */
body.vano-auth-startup{
  --vano-brand-deep-orange-red:#FF3D00;
  --vano-brand-bright-orange:#FF7A00;
  --vano-brand-soft-orange:#FFA552;
  --vano-brand-warm-amber:#FFD280;
  --vano-brand-ivory:#FFF7ED;
}


/* ===== static/vano-legal.css ===== */
/* V311 — public/legal information surfaces */
.legal-shell{width:min(1080px,calc(100% - 32px));margin:0 auto}.legal-hero{position:relative;overflow:hidden;padding:34px 34px 30px;border:1px solid rgba(255,255,255,.075);border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.014));box-shadow:0 22px 70px rgba(0,0,0,.16)}.legal-hero:after{content:"";position:absolute;width:360px;height:360px;border-radius:50%;right:-160px;top:-210px;background:radial-gradient(circle,rgba(245,154,98,.18),rgba(245,154,98,0) 68%);pointer-events:none}.legal-hero__top{display:flex;align-items:flex-start;justify-content:space-between;gap:22px}.legal-hero h1{margin:8px 0 10px;font-size:clamp(34px,6vw,60px);letter-spacing:-2.6px;line-height:.98}.legal-hero p{margin:0;max-width:760px;color:var(--muted);line-height:1.65}.legal-updated{display:inline-flex;align-items:center;gap:7px;white-space:nowrap;padding:9px 11px;border-radius:999px;border:1px solid rgba(255,255,255,.08);background:rgba(0,0,0,.12);font-size:11px;color:#aeb5bf}.legal-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:22px}.legal-summary__item{min-width:0;padding:14px;border:1px solid rgba(255,255,255,.065);border-radius:15px;background:rgba(0,0,0,.10)}.legal-summary__item i{color:var(--orange-2)}.legal-summary__item b{display:block;margin-top:9px;font-size:12px}.legal-summary__item span{display:block;margin-top:4px;color:#7f8894;font-size:10px;line-height:1.45}.legal-layout{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:18px;margin-top:18px;align-items:start}.legal-card{border:1px solid rgba(255,255,255,.075);border-radius:24px;background:linear-gradient(180deg,rgba(255,255,255,.028),rgba(255,255,255,.012));overflow:hidden}.legal-copy{padding:26px 28px}.legal-copy section{scroll-margin-top:96px}.legal-copy section+section{margin-top:30px;padding-top:29px;border-top:1px solid rgba(255,255,255,.06)}.legal-copy h2{margin:0 0 10px;font-size:20px;letter-spacing:-.45px}.legal-copy h3{margin:18px 0 7px;font-size:14px}.legal-copy p,.legal-copy li{color:#9ca4af;font-size:13px;line-height:1.72}.legal-copy p{margin:0 0 11px}.legal-copy ul,.legal-copy ol{margin:8px 0 12px;padding-left:20px}.legal-copy strong{color:#e8ebef}.legal-copy a{color:var(--orange-2);text-decoration:underline;text-decoration-color:rgba(255,195,155,.35);text-underline-offset:3px}.legal-callout{display:flex;gap:12px;padding:14px 15px;border:1px solid rgba(99,164,255,.12);border-radius:16px;background:rgba(99,164,255,.04);margin:14px 0}.legal-callout.warning{border-color:rgba(255,176,32,.16);background:rgba(255,176,32,.04)}.legal-callout i{flex:none;margin-top:2px;color:#8ab8ff}.legal-callout.warning i{color:#ffbd4a}.legal-callout b{display:block;font-size:12px}.legal-callout span{display:block;margin-top:3px;color:#8a939f;font-size:11px;line-height:1.5}.legal-toc{position:sticky;top:90px;padding:17px;border:1px solid rgba(255,255,255,.07);border-radius:20px;background:rgba(15,17,20,.82);backdrop-filter:blur(18px)}.legal-toc b{display:block;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#747d89;margin:0 0 9px}.legal-toc a{display:block;padding:8px 9px;border-radius:10px;color:#a9b0ba;font-size:11px;line-height:1.35}.legal-toc a:hover,.legal-toc a:focus-visible{background:rgba(255,255,255,.045);color:#fff;outline:none}.legal-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:17px}.legal-contact-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px}.legal-contact{padding:14px;border:1px solid rgba(255,255,255,.065);border-radius:15px;background:rgba(255,255,255,.018)}.legal-contact small{display:block;color:#69737e;font-size:9px;text-transform:uppercase;letter-spacing:.1em;font-weight:800}.legal-contact b{display:block;margin-top:6px;font-size:12px;word-break:break-word}.legal-request{margin-top:18px}.legal-request .panel{border-radius:24px}.legal-request .table{font-size:11px}.legal-request .table-wrap{overflow:auto}.legal-request textarea{resize:vertical}.public-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.public-info-card{padding:20px;border:1px solid rgba(255,255,255,.07);border-radius:20px;background:linear-gradient(160deg,rgba(255,255,255,.035),rgba(255,255,255,.012))}.public-info-card i{color:var(--orange-2)}.public-info-card h3{margin:15px 0 7px;font-size:16px}.public-info-card p{margin:0;color:#8e97a2;font-size:11px;line-height:1.6}.public-split{display:grid;grid-template-columns:1.05fr .95fr;gap:16px}.public-highlight{padding:24px;border:1px solid rgba(255,107,26,.12);border-radius:22px;background:radial-gradient(circle at 95% 0,rgba(255,107,26,.12),transparent 42%),rgba(255,255,255,.018)}.public-highlight h2{margin:0 0 9px;font-size:25px;letter-spacing:-.8px}.public-highlight p{margin:0;color:#9099a4;line-height:1.65;font-size:12px}.public-pill-row{display:flex;gap:7px;flex-wrap:wrap;margin-top:15px}.public-pill{padding:7px 9px;border-radius:999px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.065);font-size:9px;color:#abb2bd}.error-v311{max-width:760px;margin:60px auto;text-align:center;padding:34px;border:1px solid rgba(255,255,255,.075);border-radius:28px;background:radial-gradient(circle at 50% -10%,rgba(255,107,26,.12),transparent 40%),rgba(255,255,255,.018)}.error-v311__code{font-size:12px;font-weight:900;letter-spacing:.18em;color:var(--orange-2)}.error-v311 h1{font-size:clamp(30px,7vw,52px);margin:10px 0 8px;letter-spacing:-2px}.error-v311 p{max-width:570px;margin:0 auto;color:#9099a4;line-height:1.6}.error-v311__actions{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-top:20px}.error-v311__hint{margin-top:18px;font-size:10px;color:#666f7a}.skip-link{position:fixed;left:12px;top:12px;z-index:2000;transform:translateY(-160%);padding:10px 13px;border-radius:11px;background:#fff;color:#111;font-weight:800;transition:transform .18s}.skip-link:focus{transform:translateY(0)}
@media(max-width:820px){.legal-layout{grid-template-columns:1fr}.legal-toc{position:relative;top:auto;order:-1}.legal-toc nav{display:flex;gap:5px;overflow:auto;padding-bottom:2px}.legal-toc b{margin-bottom:10px}.legal-toc a{white-space:nowrap}.public-grid{grid-template-columns:1fr 1fr}.public-split{grid-template-columns:1fr}}
@media(max-width:620px){.legal-shell{width:min(100% - 20px,1080px)}.legal-hero{padding:24px 20px;border-radius:22px}.legal-hero__top{display:block}.legal-updated{margin-top:13px}.legal-summary{grid-template-columns:1fr}.legal-copy{padding:21px 18px}.legal-contact-grid{grid-template-columns:1fr}.public-grid{grid-template-columns:1fr}.error-v311{margin:32px 10px;padding:28px 18px}.legal-copy p,.legal-copy li{font-size:12px}}
@media(prefers-reduced-motion:reduce){.skip-link{transition:none}}


/* ===== static/vano-live-page.css ===== */
/* VANO MAPS — canonical live-page bundle. */

/* Theme foundation */
/* ============================================================
   VANO V56 — white + purple system, automatic Black mode
   Official brand purple: #F59A62 / #FFC39B
   ============================================================ */
body.vano-live-v258{
  --vano:#F59A62;
  --vano-2:#FFC39B;
  --vano-deep:#D9703F;
  --vano-soft:#FFF4EC;
  --vano-soft-2:#FFFBF2;
  --vano-bg:#F6F7FB;
  --vano-card:#FFFFFF;
  --vano-card-2:#FAFAFD;
  --vano-ink:#171A2B;
  --vano-muted:#687386;
  --vano-line:#E3E6EE;
  --vano-line-strong:#D6DAE5;
  --vano-shadow:0 12px 34px rgba(32,38,70,.08);
  --vano-shadow-lg:0 28px 80px rgba(32,38,70,.13);
  --vano-radius:18px;
  /* Legacy aliases: old orange branding becomes VANO purple. Traffic/alerts
     that use dedicated hard-coded warning colors remain functional. */
  --orange:#F59A62;
  --orange-2:#FFC39B;
  --orange-3:#FFC39B;
  --bg:#F6F7FB;
  --surface:#FFFFFF;
  --surface-2:#F8F9FC;
  --surface-3:#F0F2F7;
  --text:#171A2B;
  --muted:#687386;
  --muted-2:#8891A1;
  --line:#E3E6EE;
  --shadow:var(--vano-shadow);
}
html body.vano-live-v258{background:var(--vano-bg)}
html body.vano-live-v258,
body.vano-live-v258{max-width:100%;overflow-x:hidden}
body.vano-live-v258{background:var(--vano-bg)!important;background-image:none!important;color:var(--vano-ink)!important}
body.vano-live-v258:before{display:none!important}

/* ---------- Global light surfaces ---------- */
html[data-vano-theme="light"] body.vano-live-v258 .topbar{
  background:rgba(255,255,255,.90)!important;border-bottom:1px solid rgba(215,219,230,.86)!important;
  box-shadow:0 8px 28px rgba(30,36,70,.055)!important;backdrop-filter:blur(22px) saturate(135%)!important;
}
html[data-vano-theme="light"] body.vano-live-v258 .brand,
html[data-vano-theme="light"] body.vano-live-v258 .page-title,
html[data-vano-theme="light"] body.vano-live-v258 .title,
html[data-vano-theme="light"] body.vano-live-v258 h1,
html[data-vano-theme="light"] body.vano-live-v258 h2,
html[data-vano-theme="light"] body.vano-live-v258 h3{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-live-v258 .navlinks a,
html[data-vano-theme="light"] body.vano-live-v258 .navlinks button.navbtn{color:#667185!important}
html[data-vano-theme="light"] body.vano-live-v258 .navlinks a:hover,
html[data-vano-theme="light"] body.vano-live-v258 .navlinks button.navbtn:hover,
html[data-vano-theme="light"] body.vano-live-v258 .navlinks a.active{background:#FFF4EC!important;color:#D9703F!important}
html[data-vano-theme="light"] body.vano-live-v258 .panel,
html[data-vano-theme="light"] body.vano-live-v258 .card,
html[data-vano-theme="light"] body.vano-live-v258 .kpi,
html[data-vano-theme="light"] body.vano-live-v258 .alert-card,
html[data-vano-theme="light"] body.vano-live-v258 .auth-card,
html[data-vano-theme="light"] body.vano-live-v258 .profile-hero,
html[data-vano-theme="light"] body.vano-live-v258 .profile-card,
html[data-vano-theme="light"] body.vano-live-v258 .profile-detail,
html[data-vano-theme="light"] body.vano-live-v258 .profile-link,
html[data-vano-theme="light"] body.vano-live-v258 .faq details{
  background:#fff!important;color:#171A2B!important;border-color:#E3E6EE!important;box-shadow:0 10px 28px rgba(34,40,75,.055)!important;
}
html[data-vano-theme="light"] body.vano-live-v258 .panel-head,
html[data-vano-theme="light"] .detail-body.vano-live-v258{border-color:#E8EAF1!important}
html[data-vano-theme="light"] body.vano-live-v258 .page-subtitle,
html[data-vano-theme="light"] body.vano-live-v258 .subtitle,
html[data-vano-theme="light"] body.vano-live-v258 .muted,
html[data-vano-theme="light"] body.vano-live-v258 .tiny{color:#707A8C!important}
html[data-vano-theme="light"] body.vano-live-v258 .input,
html[data-vano-theme="light"] body.vano-live-v258 .select,
html[data-vano-theme="light"] body.vano-live-v258 .textarea,
html[data-vano-theme="light"] body.vano-live-v258 .settings-field input,
html[data-vano-theme="light"] body.vano-live-v258 .settings-field select,
html[data-vano-theme="light"] body.vano-live-v258 .place-card input,
html[data-vano-theme="light"] body.vano-live-v258 .invite-box input{
  background:#FBFBFD!important;color:#171A2B!important;border-color:#DDE1EA!important;box-shadow:none!important;
}
html[data-vano-theme="light"] body.vano-live-v258 .input:focus,
html[data-vano-theme="light"] body.vano-live-v258 .select:focus,
html[data-vano-theme="light"] body.vano-live-v258 .textarea:focus,
html[data-vano-theme="light"] body.vano-live-v258 .settings-field input:focus,
html[data-vano-theme="light"] body.vano-live-v258 .settings-field select:focus{
  border-color:rgba(217,112,63,.62)!important;box-shadow:0 0 0 4px rgba(217,112,63,.09)!important;
}
html[data-vano-theme="light"] body.vano-live-v258 .profile-detail summary .detail-icon,
html[data-vano-theme="light"] body.vano-live-v258 .iconbox{background:#FFF4EC!important;color:#F59A62!important;border-color:#FFE0CC!important}
html[data-vano-theme="light"] body.vano-live-v258 .profile-detail summary .detail-copy span,
html[data-vano-theme="light"] body.vano-live-v258 .profile-card-head p,
html[data-vano-theme="light"] body.vano-live-v258 .privacy-note,
html[data-vano-theme="light"] body.vano-live-v258 .emergency-note,
html[data-vano-theme="light"] body.vano-live-v258 .family-note{color:#748093!important}
html[data-vano-theme="light"] body.vano-live-v258 .place-card,
html[data-vano-theme="light"] body.vano-live-v258 .fuel-choice,
html[data-vano-theme="light"] body.vano-live-v258 .family-person,
html[data-vano-theme="light"] body.vano-live-v258 .style-choice{background:#FAFAFD!important;border-color:#E4E7EF!important;color:#252A3B!important}
html[data-vano-theme="light"] body.vano-live-v258 .style-choice:has(input:checked){background:#FFFBF2!important;border-color:#FFC39B!important;box-shadow:0 0 0 3px rgba(217,112,63,.07)!important}
html[data-vano-theme="light"] body.vano-live-v258 .style-choice:has(input:checked) .style-select{background:#FFFBF2!important;color:#D9703F!important}
html[data-vano-theme="light"] body.vano-live-v258 .invite-main{background:#FFF2E8!important;color:#D9703F!important;border:1px solid #E8DED6!important}
html[data-vano-theme="light"] body.vano-live-v258 .profile-link i{color:#D9703F!important}
html[data-vano-theme="light"] body.vano-live-v258 footer{background:#F6F7FB!important;border-color:#E2E5ED!important;color:#7A8495!important}
html[data-vano-theme="light"] body.vano-live-v258 .mobile-dock{background:rgba(255,255,255,.94)!important;border-color:#DEE2EB!important;box-shadow:0 14px 38px rgba(29,35,69,.10)!important}
html[data-vano-theme="light"] body.vano-live-v258 .mobile-dock a{color:#778195!important}
html[data-vano-theme="light"] body.vano-live-v258 .mobile-dock a:hover{background:#FFF4EC!important;color:#D9703F!important}

/* ---------- Buttons ---------- */
body.vano-live-v258 .btn-primary,
body.vano-live-v258 .sheet-submit,
body.vano-live-v258 .auth-choice.primary{
  background:linear-gradient(135deg,#FFC39B 0%,#F59A62 58%,#D9703F 100%)!important;
  border-color:transparent!important;color:#fff!important;
  box-shadow:0 12px 28px rgba(217,112,63,.22)!important;
}
body.vano-live-v258 .btn-primary:hover,
body.vano-live-v258 .sheet-submit:hover,
body.vano-live-v258 .auth-choice.primary:hover{filter:brightness(1.025);box-shadow:0 15px 34px rgba(217,112,63,.27)!important}
body.vano-live-v258 .btn:focus-visible,
body.vano-live-v258 a:focus-visible,
body.vano-live-v258 button:focus-visible,
body.vano-live-v258 input:focus-visible,
body.vano-live-v258 select:focus-visible,
body.vano-live-v258 textarea:focus-visible{outline:3px solid rgba(217,112,63,.24)!important;outline-offset:2px}

/* ---------- Theme selector ---------- */
body.vano-live-v258 .vano-theme-setting-v56{display:grid;gap:12px;padding:14px;border:1px solid var(--vano-line);border-radius:17px;background:var(--vano-card-2)}
body.vano-live-v258 .vano-theme-setting-v56 .theme-copy{display:flex;align-items:flex-start;gap:10px}
body.vano-live-v258 .vano-theme-setting-v56 .theme-icon{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;flex:none;background:#FFF2E8;color:#F59A62;border:1px solid #FFE0CC}
body.vano-live-v258 .vano-theme-setting-v56 .theme-copy>div{min-width:0;flex:1}
body.vano-live-v258 .vano-theme-setting-v56 .theme-copy b{display:block;font-size:11px;color:var(--vano-ink)}
body.vano-live-v258 .vano-theme-setting-v56 .theme-copy span{display:block;margin-top:4px;color:var(--vano-muted);font-size:8.5px;line-height:1.45}
body.vano-live-v258 .vano-theme-options{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:5px;background:#ECEEF4;border-radius:14px}
body.vano-live-v258 .vano-theme-option{height:40px;border:0;border-radius:10px;background:transparent;color:#697386;font-size:9px;font-weight:900;display:flex;align-items:center;justify-content:center;gap:6px}
body.vano-live-v258 .vano-theme-option.active{background:#fff;color:#D9703F;box-shadow:0 4px 14px rgba(35,40,70,.10)}
body.vano-live-v258 .vano-theme-meta{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;color:#7A8495;font-size:8px;line-height:1.4}
body.vano-live-v258 .vano-theme-meta [data-theme-state]{color:#555FC9;font-weight:800}

/* ---------- Black theme ---------- */
html[data-vano-theme="black"] body.vano-live-v258{
  --vano-bg:#07080D;--vano-card:#101116;--vano-card-2:#15171D;--vano-ink:#F4F5F8;--vano-muted:#969EAC;--vano-line:#272A34;
  --bg:#07080D;--surface:#101116;--surface-2:#15171D;--surface-3:#1A1C23;--text:#F4F5F8;--muted:#969EAC;--muted-2:#777F8D;--line:#272A34;
}
html[data-vano-theme="black"] body.vano-live-v258,
html[data-vano-theme="black"] body.vano-live-v258{background:#07080D!important;color:#F4F5F8!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-theme-setting-v56{background:#15171D!important;border-color:#292C36!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-theme-setting-v56 .theme-icon{background:#27231F!important;color:#FFC39B!important;border-color:#27231F!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-theme-options{background:#0C0D12!important;border:1px solid #252832!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-theme-option{color:#8F97A5!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-theme-option.active{background:#27231F!important;color:#FFC39B!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-theme-meta{color:#7F8794!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-theme-meta [data-theme-state]{color:#FFC39B!important}
html[data-vano-theme="black"] body.vano-live-v258 .mobile-dock{background:rgba(10,11,15,.94)!important;border-color:#292C35!important}

/* ---------- Map app light refinement ---------- */
html[data-vano-theme="light"] body.vano-live-v258:has(.ws-app){background:#EEF1F7!important}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .search-card,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .sheet,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .destination-confirm,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .account-drawer,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .prefs-drawer,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .safety-drawer{
  background:rgba(255,255,255,.965)!important;color:#171A2B!important;border-color:rgba(220,224,234,.95)!important;
  box-shadow:0 18px 48px rgba(28,34,66,.13)!important;
}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .location-row{background:#F8F9FC!important;border-color:#E2E5ED!important}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .location-input{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .location-input::placeholder{color:#8A93A2!important}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .chip-shortcut,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .quick,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .map-btn,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .nav-stack-btn,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .nav-audio-toggle{background:#fff!important;color:#5E687A!important;border-color:#E0E4EC!important;box-shadow:0 8px 22px rgba(33,39,71,.09)!important}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .nav-stack-btn.active,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .nav-audio-toggle.active,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .map-btn.active{background:#FFF2E8!important;color:#D9703F!important;border-color:#E8DED6!important}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .segment,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .travel{background:#F1F3F7!important;border-color:#E1E4EC!important}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .segment button,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .travel button{color:#727D8F!important}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .segment button.active,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .travel button.active{background:#fff!important;color:#D9703F!important;box-shadow:0 3px 10px rgba(36,42,75,.09)!important}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .route-card,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .route-variant,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .parking-nearby,
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .route-insight{background:#FAFAFD!important;color:#252A3B!important;border-color:#E2E5ED!important}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .route-variant.active{background:#FFF4EC!important;border-color:#FFC39B!important}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .drawer-link{color:#32384A!important}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .drawer-link:hover{background:#FFF4EC!important}
html[data-vano-theme="light"] body.vano-live-v258 .ws-app .drawer-divider{background:#E7E9F0!important}

/* ---------- Entry / login: white + purple ---------- */
html[data-vano-theme="light"] body.vano-live-v258:has(.vano-entry){background:#F4F5FA!important}
html[data-vano-theme="light"] body.vano-live-v258 .vano-entry{background:#F4F5FA!important;color:#171A2B!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-screen{background:#fff!important;border-color:#E2E5ED!important;box-shadow:0 30px 90px rgba(35,41,76,.12)!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-screen:before{background:none!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-copy h1{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-copy h1 span{color:#F59A62!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-copy p{color:#697487!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-brandline{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-brandline span{color:#8A93A3!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-brandline img{filter:drop-shadow(0 7px 16px rgba(217,112,63,.18))!important}
html[data-vano-theme="light"] body.vano-live-v258 .city-art:before{background:linear-gradient(180deg,#fff 0%,rgba(255,255,255,.68) 34%,transparent 100%)!important}
html[data-vano-theme="light"] body.vano-live-v258 .city-art:after{background:linear-gradient(0deg,#fff 0%,rgba(255,255,255,.64) 36%,transparent 100%)!important}
html[data-vano-theme="light"] body.vano-live-v258 .city-art img{filter:saturate(.88) contrast(1.02) brightness(1.02)!important}
html[data-vano-theme="light"] body.vano-live-v258 .city-route-badge{background:rgba(255,255,255,.90)!important;color:#444B5C!important;border-color:#E1E4ED!important;box-shadow:0 10px 28px rgba(30,36,70,.10)!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-actions{background:#FAFAFD!important;border-color:#E7E9F0!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-actions-head h2{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-actions-head p{color:#707B8E!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-choice.secondary,
html[data-vano-theme="light"] body.vano-live-v258 .auth-guest{background:#fff!important;color:#2B3041!important;border-color:#DDE1EA!important;box-shadow:none!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-google{background:#fff!important;color:#202431!important;border-color:#DDE1EA!important;box-shadow:0 5px 16px rgba(35,41,70,.045)!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-divider{color:#9098A7!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-divider:before,
html[data-vano-theme="light"] body.vano-live-v258 .auth-divider:after{background:#E4E7EE!important}
html[data-vano-theme="light"] body.vano-live-v258 .auth-legal{color:#8A93A3!important}
html[data-vano-theme="light"] body.vano-live-v258 .sheet-backdrop{background:rgba(20,24,40,.34)!important}
html[data-vano-theme="light"] body.vano-live-v258 .sheet-card{background:#fff!important;color:#171A2B!important;border-color:#DFE3EC!important;box-shadow:0 30px 90px rgba(29,35,67,.22)!important}
html[data-vano-theme="light"] body.vano-live-v258 .sheet-grab{background:#D4D8E2!important}
html[data-vano-theme="light"] body.vano-live-v258 .sheet-head h2{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-live-v258 .sheet-head p{color:#747E90!important}
html[data-vano-theme="light"] body.vano-live-v258 .sheet-close{background:#F5F6F9!important;color:#6F7889!important;border-color:#E1E4EC!important}
html[data-vano-theme="light"] body.vano-live-v258 .sheet-field label{color:#555F72!important}
html[data-vano-theme="light"] body.vano-live-v258 .sheet-input,
html[data-vano-theme="light"] body.vano-live-v258 .sheet-select{background:#F9FAFC!important;color:#171A2B!important;border-color:#DDE1EA!important}
html[data-vano-theme="light"] body.vano-live-v258 .sheet-input:focus,
html[data-vano-theme="light"] body.vano-live-v258 .sheet-select:focus{border-color:rgba(217,112,63,.62)!important;box-shadow:0 0 0 4px rgba(217,112,63,.08)!important}
html[data-vano-theme="light"] body.vano-live-v258 .sheet-switch{color:#7B8495!important}

/* Purple line exactly follows the official VANO palette. */
body.vano-live-v258 .vano-entry .city-art .vano-login-route{filter:drop-shadow(0 0 8px rgba(217,112,63,.50))!important}
body.vano-live-v258 .vano-entry .city-art .vano-login-route path.route-halo{stroke:#F59A62!important;opacity:.12!important}
body.vano-live-v258 .vano-entry .city-art .vano-login-route path.route-main{stroke:url(#vanoLoginRouteGradient)!important;opacity:.98!important}
body.vano-live-v258 .vano-entry .splash-route{filter:drop-shadow(0 0 9px rgba(217,112,63,.72))!important}
body.vano-live-v258 .vano-entry .splash-route .route-halo{stroke:#F59A62!important;opacity:.10!important}
body.vano-live-v258 .vano-entry .splash-mark{filter:drop-shadow(0 0 18px rgba(217,112,63,.34))!important}
body.vano-live-v258 .vano-entry .splash-tag{color:#F59A62!important}
body.vano-live-v258 .vano-entry .splash-puck:after{background:#F59A62!important;box-shadow:0 0 12px rgba(217,112,63,.62)!important}
body.vano-live-v258 .vano-entry .vano-splash:after{background:linear-gradient(90deg,#F59A62,#FFC39B,#F59A62)!important;box-shadow:0 0 10px rgba(217,112,63,.55)!important}

/* ---------- Responsive polish ---------- */
@media (max-width:699px){
  body.vano-live-v258 .container,
body.vano-live-v258 .nav{width:calc(100% - 20px)!important}
  body.vano-live-v258 .topbar{height:58px!important}
  body.vano-live-v258 .page{padding:18px 0 82px!important}
  body.vano-live-v258 .profile-shell{width:100%!important}
  body.vano-live-v258 .profile-hero,
body.vano-live-v258 .profile-card,
body.vano-live-v258 .profile-detail,
body.vano-live-v258 .profile-link{border-radius:16px!important}
  body.vano-live-v258 .settings-grid,
body.vano-live-v258 .place-grid{grid-template-columns:1fr!important}
  body.vano-live-v258 .settings-grid .full{grid-column:auto!important}
  body.vano-live-v258 .vano-theme-options{grid-template-columns:repeat(3,minmax(0,1fr))}
  body.vano-live-v258 .vano-theme-option{height:42px;font-size:8.5px}
  body.vano-live-v258 .vano-entry .auth-screen{width:100%!important;max-width:520px!important;min-height:100svh!important;border:0!important;border-radius:0!important;box-shadow:none!important}
  html[data-vano-theme="light"] body.vano-live-v258 .vano-entry .auth-screen{background:#fff!important}
  body.vano-live-v258 .auth-copy{padding-top:max(26px,env(safe-area-inset-top))!important}
  body.vano-live-v258 .auth-actions{padding-bottom:max(18px,env(safe-area-inset-bottom))!important}
}

@media (min-width:700px) and (max-width:1099px){
  body.vano-live-v258 .container{width:min(940px,calc(100% - 36px))!important}
  body.vano-live-v258 .profile-shell{max-width:860px!important}
  body.vano-live-v258 .settings-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  body.vano-live-v258 .vano-entry{padding:18px!important}
  body.vano-live-v258 .auth-screen{width:min(1000px,calc(100vw - 36px))!important;height:min(780px,calc(100svh - 36px))!important;min-height:620px!important}
  body.vano-live-v258 .auth-actions{padding:42px 34px!important}
}

@media (min-width:1100px){
  body.vano-live-v258 .container{width:min(1220px,calc(100% - 56px))!important}
  body.vano-live-v258 .profile-shell{max-width:940px!important}
  body.vano-live-v258 .profile-card,
body.vano-live-v258 .profile-detail{border-radius:20px!important}
  body.vano-live-v258 .vano-entry{padding:28px!important}
  body.vano-live-v258 .auth-screen{width:min(1180px,calc(100vw - 56px))!important;height:min(790px,calc(100svh - 56px))!important}
}

@media (orientation:landscape) and (max-height:620px){
  body.vano-live-v258 .page{padding-top:12px!important}
  body.vano-live-v258 .topbar{height:52px!important}
  body.vano-live-v258 .vano-entry{padding:10px!important}
  body.vano-live-v258 .auth-screen{height:calc(100svh - 20px)!important;min-height:500px!important}
  body.vano-live-v258 .auth-copy{padding-top:28px!important;padding-bottom:8px!important}
  body.vano-live-v258 .auth-copy h1{font-size:38px!important}
  body.vano-live-v258 .auth-actions{padding-top:24px!important;padding-bottom:24px!important}
}

@media (pointer:coarse){
  body.vano-live-v258 button,
body.vano-live-v258 .btn,
body.vano-live-v258 a.auth-choice,
body.vano-live-v258 a.auth-google,
body.vano-live-v258 a.auth-guest,
body.vano-live-v258 .profile-link{min-height:44px}
}
@media (prefers-reduced-motion:reduce){
  body.vano-live-v258 *,
body.vano-live-v258 *:before,
body.vano-live-v258 *:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}

/* Entry information density: useful, not noisy. */
body.vano-live-v258 .auth-proof{display:flex;flex-wrap:wrap;gap:7px;margin-top:15px}
body.vano-live-v258 .auth-proof span{min-height:29px;display:inline-flex;align-items:center;gap:5px;padding:0 9px;border-radius:999px;font-size:7.5px;font-weight:820;letter-spacing:.01em}
html[data-vano-theme="light"] body.vano-live-v258 .auth-proof span{background:#FFFBF2;color:#D9703F;border:1px solid #FFFBF2}
html[data-vano-theme="black"] body.vano-live-v258 .auth-proof span{background:#19192C;color:#FFC39B;border:1px solid #27231F}
body.vano-live-v258 .auth-logout-note{display:flex;align-items:center;gap:9px;padding:11px 12px;border-radius:14px;margin-bottom:4px}
body.vano-live-v258 .auth-logout-note b{display:block;font-size:10px}body.vano-live-v258 .auth-logout-note span{display:block;margin-top:2px;font-size:8px}
html[data-vano-theme="light"] body.vano-live-v258 .auth-logout-note{background:#F0FAF6;border:1px solid #D7EFE4;color:#237555}
html[data-vano-theme="light"] body.vano-live-v258 .auth-logout-note span{color:#56836F}
html[data-vano-theme="black"] body.vano-live-v258 .auth-logout-note{background:#10221B;border:1px solid #204735;color:#70D6A5}
html[data-vano-theme="black"] body.vano-live-v258 .auth-logout-note span{color:#79A993}
@media(max-width:430px){body.vano-live-v258 .auth-proof{gap:5px;margin-top:11px}body.vano-live-v258 .auth-proof span{font-size:7px;padding:0 7px;min-height:26px}}

/* Shared/live route pages also follow the same day/night system. */
html[data-vano-theme="light"] body.vano-live-v258 .share-app,
html[data-vano-theme="light"] body.vano-live-v258:has(.share-app),
html[data-vano-theme="light"] body.vano-live-v258 .app,
html[data-vano-theme="light"] body.vano-live-v258:has(.app){background:#F6F7FB!important;color:#171A2B!important}
html[data-vano-theme="light"] body.vano-live-v258 .share-app .pill,
html[data-vano-theme="light"] body.vano-live-v258 .share-app .bottom,
html[data-vano-theme="light"] body.vano-live-v258 .app .brand,
html[data-vano-theme="light"] body.vano-live-v258 .app .status,
html[data-vano-theme="light"] body.vano-live-v258 .app .card{background:rgba(255,255,255,.94)!important;color:#171A2B!important;border-color:#E0E4EC!important;box-shadow:0 16px 40px rgba(34,40,72,.12)!important}
html[data-vano-theme="light"] body.vano-live-v258 .share-app .pill span,
html[data-vano-theme="light"] body.vano-live-v258 .share-app .route-label small,
html[data-vano-theme="light"] body.vano-live-v258 .app .card p,
html[data-vano-theme="light"] body.vano-live-v258 .app .privacy,
html[data-vano-theme="light"] body.vano-live-v258 .app .stat span{color:#747F91!important}
html[data-vano-theme="light"] body.vano-live-v258 .app .stat{background:#F8F9FC!important;border-color:#E2E5ED!important}
html[data-vano-theme="light"] body.vano-live-v258 .share-app .veil,
html[data-vano-theme="light"] body.vano-live-v258 .app .veil{background:linear-gradient(180deg,rgba(246,247,251,.18),transparent 24%,transparent 72%,rgba(246,247,251,.24))!important}
body.vano-live-v258 .vano-entry .vano-splash:before{
  background:linear-gradient(180deg,rgba(5,6,12,.28) 0%,rgba(5,6,12,.42) 34%,rgba(5,6,12,.64) 72%,#07080D 100%),url('/static/auth-city-route-vano.webp') center 49%/cover no-repeat!important;
}

/* ---------- Onboarding: same white/purple language ---------- */
html[data-vano-theme="light"] body.vano-live-v258:has(.onboard){background:#F6F7FB!important}
html[data-vano-theme="light"] body.vano-live-v258 .onboard{background:#F6F7FB!important;color:#171A2B!important}
html[data-vano-theme="light"] body.vano-live-v258 .vano-mini{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-live-v258 .vano-mini img{filter:drop-shadow(0 8px 16px rgba(217,112,63,.18))!important}
html[data-vano-theme="light"] body.vano-live-v258 .step-pill{color:#D9703F!important;background:#FFF2E8!important;border-color:#E8DED6!important}
html[data-vano-theme="light"] body.vano-live-v258 .ob-progress{background:#E6E8EF!important}
html[data-vano-theme="light"] body.vano-live-v258 .ob-head h1{color:#171A2B!important}
html[data-vano-theme="light"] body.vano-live-v258 .ob-head h1 span{color:#6D7789!important}
html[data-vano-theme="light"] body.vano-live-v258 .ob-head p{color:#707B8E!important}
html[data-vano-theme="light"] body.vano-live-v258 .ob-section{background:#fff!important;border-color:#E2E5ED!important;box-shadow:0 10px 26px rgba(33,39,73,.05)!important}
html[data-vano-theme="light"] body.vano-live-v258 .ob-section-title b{color:#222738!important}
html[data-vano-theme="light"] body.vano-live-v258 .ob-section-title span{color:#758093!important}
html[data-vano-theme="light"] body.vano-live-v258 .field label{color:#596477!important}
html[data-vano-theme="light"] body.vano-live-v258 .onboard .input,
html[data-vano-theme="light"] body.vano-live-v258 .onboard .select{background:#F9FAFC!important;color:#171A2B!important;border-color:#DDE1EA!important}
html[data-vano-theme="light"] body.vano-live-v258 .onboard .input::placeholder{color:#9AA2AF!important}
html[data-vano-theme="light"] body.vano-live-v258 .choice label,
html[data-vano-theme="light"] body.vano-live-v258 .pref label,
html[data-vano-theme="light"] body.vano-live-v258 .night-card{background:#FAFAFD!important;border-color:#E2E5ED!important}
html[data-vano-theme="light"] body.vano-live-v258 .choice label b,
html[data-vano-theme="light"] body.vano-live-v258 .pref label b,
html[data-vano-theme="light"] body.vano-live-v258 .night-card b{color:#252A3B!important}
html[data-vano-theme="light"] body.vano-live-v258 .choice label span,
html[data-vano-theme="light"] body.vano-live-v258 .pref label span,
html[data-vano-theme="light"] body.vano-live-v258 .night-card span{color:#748093!important}
html[data-vano-theme="light"] body.vano-live-v258 .choice input:checked+label,
html[data-vano-theme="light"] body.vano-live-v258 .pref input:checked+label{background:#FFFBF2!important;border-color:#FFC39B!important}
html[data-vano-theme="light"] body.vano-live-v258 .choice input:checked+label i,
html[data-vano-theme="light"] body.vano-live-v258 .pref input:checked+label .pref-icon{color:#F59A62!important}
html[data-vano-theme="light"] body.vano-live-v258 .pref input:checked+label .pref-icon{background:#FFFBF2!important}
html[data-vano-theme="light"] body.vano-live-v258 .pref input:checked+label .radio-dot{border-color:#F59A62!important}
html[data-vano-theme="light"] body.vano-live-v258 .pref input:checked+label .radio-dot:after{background:#F59A62!important}
html[data-vano-theme="light"] body.vano-live-v258 .switch input:checked+.slider{background:#F59A62!important}
html[data-vano-theme="light"] body.vano-live-v258 .mini-note{background:#F6F7FA!important;color:#7B8495!important}
html[data-vano-theme="light"] body.vano-live-v258 .presence-consent{background:#FFFBF2!important;border-color:#E8DED6!important}
html[data-vano-theme="light"] body.vano-live-v258 .presence-consent input{accent-color:#F59A62!important}
html[data-vano-theme="light"] body.vano-live-v258 .presence-consent b{color:#33384A!important}
html[data-vano-theme="light"] body.vano-live-v258 .presence-consent span span{color:#778195!important}
html[data-vano-theme="light"] body.vano-live-v258 .privacy-note{background:#F3F7FF!important;border-color:#DEE8FA!important;color:#68758A!important}
html[data-vano-theme="light"] body.vano-live-v258 .privacy-note b{color:#384156!important}
html[data-vano-theme="light"] body.vano-live-v258 .vehicle-hint i{color:#F59A62!important}
html[data-vano-theme="light"] body.vano-live-v258 .fine{color:#8891A1!important}

/* ---------- Generic data/admin screens ---------- */
html[data-vano-theme="light"] body.vano-live-v258 .table th{color:#707B8D!important;border-color:#E4E7EE!important;background:#FAFAFC!important}
html[data-vano-theme="light"] body.vano-live-v258 .table td{color:#303648!important;border-color:#E8EAF0!important}
html[data-vano-theme="light"] body.vano-live-v258 .table tr:hover td{background:#F8F8FF!important}
html[data-vano-theme="light"] body.vano-live-v258 .badge{background:#F3F4F8!important;color:#606B7E!important;border-color:#E0E4EC!important}
html[data-vano-theme="light"] body.vano-live-v258 .badge.orange{background:#FFF2E8!important;color:#D9703F!important;border-color:#E8DED6!important}
html[data-vano-theme="light"] body.vano-live-v258 .flash{background:rgba(255,255,255,.97)!important;color:#2C3244!important;border-color:#E1E4EC!important;box-shadow:0 14px 38px rgba(30,36,68,.12)!important}
html[data-vano-theme="light"] body.vano-live-v258 .empty{color:#7A8496!important}
html[data-vano-theme="light"] body.vano-live-v258 .code-num{color:#F59A62!important}

/* V56 splash: intentionally minimal — VANO mark only. */
body.vano-live-v258 .vano-entry .vano-splash{background:#F7F8FC!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-entry .vano-splash{background:#07080D!important}
body.vano-live-v258 .vano-entry .vano-splash:before,
body.vano-live-v258 .vano-entry .vano-splash:after,
body.vano-live-v258 .vano-entry .splash-map,
body.vano-live-v258 .vano-entry .splash-route,
body.vano-live-v258 .vano-entry .splash-word,
body.vano-live-v258 .vano-entry .splash-tag,
body.vano-live-v258 .vano-entry .splash-puck{display:none!important}
body.vano-live-v258 .vano-entry .splash-center{transform:none!important;animation:none!important;display:grid;place-items:center}
body.vano-live-v258 .vano-entry .splash-mark{width:92px!important;margin:0!important;filter:drop-shadow(0 12px 28px rgba(217,112,63,.20))!important;animation:vanoMarkV56 .58s cubic-bezier(.2,.8,.2,1) both!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-entry .splash-mark{filter:drop-shadow(0 0 24px rgba(217,112,63,.30))!important}
@keyframes vanoMarkV56{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:scale(1)}}


/* Shared system layer */
/* VANO v170 — complete visual system.
   Keeps the existing HTML/application structure and re-skins every shared surface
   with the VANO brand board: peach/orange, ivory, warm charcoal and warm gray. */
body.vano-live-v258{
  --vano-primary:#F59A62;
  --vano-primary-soft:#FFC39B;
  --vano-primary-deep:#D9703F;
  --vano-paper:#FFFBF2;
  --vano-paper-2:#FFF6EE;
  --vano-paper-3:#F7EEE5;
  --vano-ink:#27231F;
  --vano-muted:#706861;
  --vano-line:rgba(112,104,97,.16);
  --vano-line-strong:rgba(112,104,97,.25);
  --vano-white:#FFFFFF;
  --vano-shadow-sm:0 8px 24px rgba(79,58,43,.08);
  --vano-shadow:0 18px 50px rgba(79,58,43,.12);
  --vano-shadow-lg:0 30px 90px rgba(79,58,43,.16);
  --vano-ring:0 0 0 4px rgba(245,154,98,.16);
  --bg:#FFFBF2!important;
  --surface:#FFFFFF!important;
  --surface-2:#FFF6EE!important;
  --surface-3:#F7EEE5!important;
  --text:#27231F!important;
  --muted:#706861!important;
  --muted-2:#948A82!important;
  --line:rgba(112,104,97,.16)!important;
  --orange:#F59A62!important;
  --orange-2:#D9703F!important;
  --orange-3:#FFC39B!important;
  --o:#F59A62!important;
  --o2:#FFC39B!important;
  --shadow:var(--vano-shadow)!important;
  --brand:#F59A62!important;
  --brand-2:#D9703F!important;
  --brand-soft:#FFF0E5!important;
  --accent:#F59A62!important;
  --ink:#27231F!important;
  --soft:#FFF6EE!important;
}
html body.vano-live-v258{color-scheme:light!important;background:var(--vano-paper)!important}
html[data-vano-theme] body.vano-live-v258,
html[data-vano-theme] body.vano-live-v258{color-scheme:light!important}
body.vano-live-v258{
  color:var(--vano-ink)!important;
  background:
    radial-gradient(circle at 8% -8%,rgba(255,195,155,.28),transparent 30rem),
    radial-gradient(circle at 94% 0,rgba(245,154,98,.12),transparent 28rem),
    var(--vano-paper)!important;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
body.vano-live-v258:before{background:none!important}
body.vano-live-v258 ::selection{background:rgba(245,154,98,.28);color:var(--vano-ink)}
body.vano-live-v258 :focus-visible{outline:2px solid rgba(217,112,63,.55)!important;outline-offset:2px!important}

/* Header / navigation */
body.vano-live-v258 .topbar{
  background:rgba(255,251,242,.86)!important;
  border-bottom:1px solid rgba(112,104,97,.12)!important;
  box-shadow:0 8px 30px rgba(79,58,43,.045)!important;
  backdrop-filter:blur(24px) saturate(1.2)!important;
  -webkit-backdrop-filter:blur(24px) saturate(1.2)!important;
}
body.vano-live-v258 .nav{gap:14px!important}
body.vano-live-v258 .brand{color:var(--vano-ink)!important;font-weight:880!important;letter-spacing:-.45px!important}
body.vano-live-v258 .brand>span{display:none!important}
body.vano-live-v258 .vano-brand-wordmark{width:126px!important;height:38px!important;object-fit:contain!important;object-position:left center!important}
body.vano-live-v258 .navlinks a,
body.vano-live-v258 .navlinks button.navbtn{color:var(--vano-muted)!important;border-radius:999px!important;font-weight:720!important}
body.vano-live-v258 .navlinks a:hover,
body.vano-live-v258 .navlinks button.navbtn:hover,
body.vano-live-v258 .navlinks a.active{background:rgba(245,154,98,.11)!important;color:var(--vano-ink)!important}

/* Buttons */
body.vano-live-v258 .btn,
body.vano-live-v258 .auth-button,
body.vano-live-v258 .profile-v108-button,
body.vano-live-v258 .guest-limit-primary,
body.vano-live-v258 .guest-limit-secondary{
  border-radius:14px!important;
  font-weight:800!important;
  letter-spacing:-.12px!important;
  transition:transform .18s cubic-bezier(.2,.8,.2,1),box-shadow .18s ease,border-color .18s ease,background .18s ease!important;
}
body.vano-live-v258 .btn{
  background:rgba(255,255,255,.92)!important;
  color:var(--vano-ink)!important;
  border:1px solid var(--vano-line)!important;
  box-shadow:0 5px 16px rgba(79,58,43,.045)!important;
}
body.vano-live-v258 .btn:hover{transform:translateY(-1px)!important;border-color:rgba(217,112,63,.28)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-live-v258 .btn:active{transform:translateY(0) scale(.985)!important}
body.vano-live-v258 .btn-primary{
  color:#fff!important;
  border-color:transparent!important;
  background:linear-gradient(135deg,#FFC39B 0%,#F59A62 45%,#D9703F 100%)!important;
  box-shadow:0 11px 26px rgba(217,112,63,.22),inset 0 1px 0 rgba(255,255,255,.42)!important;
}
body.vano-live-v258 .btn-primary:hover{box-shadow:0 15px 34px rgba(217,112,63,.27),inset 0 1px 0 rgba(255,255,255,.46)!important}
body.vano-live-v258 .btn-danger{background:#FFF3F0!important;border-color:#F3CDC6!important;color:#A04435!important}

/* Shared cards / panels / forms */
body.vano-live-v258 .card,
body.vano-live-v258 .panel,
body.vano-live-v258 .kpi,
body.vano-live-v258 .alert-card,
body.vano-live-v258 .auth-card,
body.vano-live-v258 .modal-card,
body.vano-live-v258 .sheet-card{
  background:rgba(255,255,255,.94)!important;
  color:var(--vano-ink)!important;
  border-color:var(--vano-line)!important;
  box-shadow:var(--vano-shadow-sm)!important;
}
body.vano-live-v258 .card:hover,
body.vano-live-v258 .panel:hover{border-color:rgba(217,112,63,.23)!important}
body.vano-live-v258 .panel-head{border-bottom-color:rgba(112,104,97,.12)!important}
body.vano-live-v258 .subtitle,
body.vano-live-v258 .page-subtitle,
body.vano-live-v258 .muted,
body.vano-live-v258 .tiny,
body.vano-live-v258 .card p,
body.vano-live-v258 .panel p{color:var(--vano-muted)!important}
body.vano-live-v258 .eyebrow{color:var(--vano-primary-deep)!important}
body.vano-live-v258 .title,
body.vano-live-v258 .page-title,
body.vano-live-v258 .section-title{color:var(--vano-ink)!important}
body.vano-live-v258 .title span,
body.vano-live-v258 .section-title span,
body.vano-live-v258 .hero h1 span{color:var(--vano-primary-deep)!important}
body.vano-live-v258 .iconbox{
  background:linear-gradient(145deg,#FFF7F0,#FFE7D6)!important;
  color:var(--vano-primary-deep)!important;
  border-color:#FFDCC6!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 9px 22px rgba(217,112,63,.08)!important;
}
body.vano-live-v258 .input,
body.vano-live-v258 .select,
body.vano-live-v258 .textarea,
body.vano-live-v258 input:not([type=radio]):not([type=checkbox]):not([type=hidden]),
body.vano-live-v258 select,
body.vano-live-v258 textarea{
  color:var(--vano-ink)!important;
  background:rgba(255,255,255,.94)!important;
  border-color:var(--vano-line)!important;
}
body.vano-live-v258 .input::placeholder,
body.vano-live-v258 .textarea::placeholder,
body.vano-live-v258 input::placeholder,
body.vano-live-v258 textarea::placeholder{color:#9C9189!important}
body.vano-live-v258 .input:focus,
body.vano-live-v258 .select:focus,
body.vano-live-v258 .textarea:focus,
body.vano-live-v258 input:focus,
body.vano-live-v258 select:focus,
body.vano-live-v258 textarea:focus{
  border-color:rgba(217,112,63,.5)!important;
  box-shadow:var(--vano-ring)!important;
}
body.vano-live-v258 .badge{background:#FFF3E9!important;border-color:#FFD9C2!important;color:#A9522D!important}
body.vano-live-v258 .badge.green{background:#EDF8F3!important;border-color:#CDE8DB!important;color:#2B7258!important}
body.vano-live-v258 .badge.red{background:#FFF0EE!important;border-color:#F0CAC4!important;color:#A34B3E!important}
body.vano-live-v258 .table th{color:#8E837C!important;background:#FFF8F2!important;border-color:var(--vano-line)!important}
body.vano-live-v258 .table td{color:var(--vano-ink)!important;border-color:rgba(112,104,97,.10)!important}
body.vano-live-v258 .table tr:hover td{background:#FFFAF6!important}
body.vano-live-v258 .flash{background:rgba(255,255,255,.96)!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important;box-shadow:var(--vano-shadow-sm)!important}

/* Landing / public pages */
body.vano-live-v258 .hero-card{background:linear-gradient(145deg,#FFFFFF,#FFF6EE)!important;border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-lg)!important}
body.vano-live-v258 .mock-map{background:radial-gradient(circle at 30% 20%,#FFFDF9,#F4EDE6 62%,#EEE4DA)!important}
body.vano-live-v258 .mock-map:before,
body.vano-live-v258 .mock-map:after{filter:none!important;opacity:.7!important}
body.vano-live-v258 .map-bubble{background:rgba(39,35,31,.92)!important;color:#fff!important;border-color:rgba(255,255,255,.10)!important;box-shadow:0 15px 36px rgba(39,35,31,.18)!important}
body.vano-live-v258 .map-bubble small{color:#D9D1CB!important}
body.vano-live-v258 .route-line{border-color:var(--vano-primary)!important;border-left-color:transparent!important;border-bottom-color:var(--vano-primary-soft)!important;filter:drop-shadow(0 0 12px rgba(245,154,98,.27))!important}

/* Mobile dock */
body.vano-live-v258 .mobile-dock{
  background:rgba(255,251,242,.94)!important;
  border-color:rgba(112,104,97,.14)!important;
  box-shadow:0 16px 42px rgba(79,58,43,.14)!important;
  backdrop-filter:blur(24px) saturate(1.2)!important;
  -webkit-backdrop-filter:blur(24px) saturate(1.2)!important;
}
body.vano-live-v258 .mobile-dock a{color:#847A73!important}
body.vano-live-v258 .mobile-dock a:hover,
body.vano-live-v258 .mobile-dock a.active{background:#FFF0E5!important;color:var(--vano-primary-deep)!important}

/* Login standalone: override legacy purple without changing its structure */
body.vano-live-v258 .auth-page{background:
  radial-gradient(circle at 8% 0,rgba(255,195,155,.26),transparent 34rem),
  var(--vano-paper)!important}
body.vano-live-v258 .auth-shell{background:#fff!important;border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-lg)!important}
body.vano-live-v258 .auth-pane{background:linear-gradient(160deg,#FFFFFF 0%,#FFFCF8 100%)!important}
body.vano-live-v258 .auth-page .eyebrow,
body.vano-live-v258 .auth-page h1 span{color:var(--vano-primary-deep)!important}
body.vano-live-v258 .auth-page .eyebrow:before{background:var(--vano-primary)!important}
body.vano-live-v258 .product-pill{background:#FFF8F2!important;border-color:var(--vano-line)!important;color:var(--vano-muted)!important}
body.vano-live-v258 .product-pill i{background:var(--vano-primary)!important;box-shadow:0 0 0 4px rgba(245,154,98,.13)!important}
body.vano-live-v258 .auth-button.email{
  background:linear-gradient(135deg,#FFC39B,#F59A62 52%,#D9703F)!important;
  color:#fff!important;
  box-shadow:0 12px 28px rgba(217,112,63,.23)!important;
}
body.vano-live-v258 .auth-button.google{border-color:var(--vano-line)!important;box-shadow:0 6px 18px rgba(79,58,43,.06)!important}
body.vano-live-v258 .auth-links a:hover{color:var(--vano-primary-deep)!important}
body.vano-live-v258 .route-pane{background:#F4EEE7!important;border-left-color:var(--vano-line)!important}
body.vano-live-v258 .route-glow{background:rgba(245,154,98,.17)!important}
body.vano-live-v258 .live-badge,
body.vano-live-v258 .mini-chip,
body.vano-live-v258 .route-summary,
body.vano-live-v258 .reroute-card{border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-live-v258 .mini-chip svg,
body.vano-live-v258 .reroute-icon{color:var(--vano-primary-deep)!important}
body.vano-live-v258 .reroute-icon{background:#FFF0E5!important}
body.vano-live-v258 .reroute-line i{background:linear-gradient(90deg,var(--vano-primary-soft),var(--vano-primary-deep))!important}
body.vano-live-v258 .location-dot{background:var(--vano-primary)!important;box-shadow:0 4px 16px rgba(217,112,63,.28)!important}
body.vano-live-v258 .location-dot.end{background:var(--vano-ink)!important}

/* Onboarding/profile/admin polish */
body.vano-live-v258 .ob-card,
body.vano-live-v258 .profile-v108-card,
body.vano-live-v258 .profile-v72-card,
body.vano-live-v258 .activity-card,
body.vano-live-v258 .admin-card,
body.vano-live-v258 .admin-kpi{
  background:#fff!important;
  border-color:var(--vano-line)!important;
  box-shadow:var(--vano-shadow-sm)!important;
}
body.vano-live-v258 .ob-option.active,
body.vano-live-v258 .profile-v72-accent:has(input:checked),
body.vano-live-v258 .profile-v108-quick a:hover{
  border-color:rgba(217,112,63,.34)!important;
  background:#FFF5EC!important;
}
body.vano-live-v258 .profile-v108-quick-icon,
body.vano-live-v258 .profile-v72-icon,
body.vano-live-v258 .ob-icon{background:#FFF0E5!important;color:var(--vano-primary-deep)!important}

/* Shared route / live trip standalone */
body.vano-live-v258 .share-app,
body.vano-live-v258 .live-app{background:#F5EFE8!important;color:var(--vano-ink)!important}
body.vano-live-v258 .share-top,
body.vano-live-v258 .route-panel,
body.vano-live-v258 .live-top,
body.vano-live-v258 .live-app .card{background:rgba(255,251,242,.96)!important;border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow)!important}
body.vano-live-v258 .route-kicker,
body.vano-live-v258 .live-app .eyebrow{color:var(--vano-primary-deep)!important}
body.vano-live-v258 .route-actions .primary{background:linear-gradient(135deg,#FFC39B,#F59A62 55%,#D9703F)!important;color:#fff!important;box-shadow:0 10px 24px rgba(217,112,63,.2)!important}
body.vano-live-v258 .route-note{background:#FFF1E7!important;color:#8A4B2D!important}
body.vano-live-v258 .metric,
body.vano-live-v258 .stat{background:#FFF9F4!important;border-color:var(--vano-line)!important}
body.vano-live-v258 .progress i{background:linear-gradient(90deg,#FFC39B,#F59A62,#D9703F)!important}

@media(max-width:760px){
  body.vano-live-v258 .topbar{background:rgba(255,251,242,.94)!important}
  body.vano-live-v258 .container,
body.vano-live-v258 .nav{width:calc(100% - 18px)!important}
  body.vano-live-v258 .page{padding-top:18px!important}
  body.vano-live-v258 .card,
body.vano-live-v258 .panel{border-radius:18px!important}
  body.vano-live-v258 .auth-page{padding:0!important;background:#fff!important}
  body.vano-live-v258 .auth-shell{border:0!important;border-radius:0!important;min-height:100dvh!important;box-shadow:none!important}
}

@media(prefers-reduced-motion:reduce){
  body.vano-live-v258 *,
body.vano-live-v258 *:before,
body.vano-live-v258 *:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}


/* Dedicated admin/risk screens that shipped with hard-coded violet rules. */
body.vano-live-v258:has(.risk-admin){background:var(--vano-paper)!important;color:var(--vano-ink)!important}
body.vano-live-v258:has(.risk-admin) .topbar{background:rgba(255,251,242,.94)!important;border-color:var(--vano-line)!important}
body.vano-live-v258 .risk-eyebrow{color:var(--vano-primary-deep)!important}
body.vano-live-v258 .risk-card{border-color:var(--vano-line)!important;background:#fff!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-live-v258 .risk-card-head{border-color:rgba(112,104,97,.11)!important}
body.vano-live-v258 .rf-input,
body.vano-live-v258 .rf-select{background:#FFFCF9!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important}
body.vano-live-v258 .rf-input:focus,
body.vano-live-v258 .rf-select:focus{border-color:rgba(217,112,63,.52)!important;box-shadow:var(--vano-ring)!important}
body.vano-live-v258 .switch input:checked+span{background:linear-gradient(135deg,var(--vano-primary-soft),var(--vano-primary))!important}
body.vano-live-v258 .risk-submit{background:linear-gradient(135deg,#FFC39B,#F59A62 52%,#D9703F)!important;box-shadow:0 10px 24px rgba(217,112,63,.2)!important}
body.vano-live-v258 .zone-pill{background:#FFF1E7!important;color:#A4512D!important}
body.vano-live-v258 .policy-note{background:#FFF6EF!important;border-color:#FFE0CD!important;color:#795C4B!important}
body.vano-live-v258 .risk-back,
body.vano-live-v258 .mini-btn{border-color:var(--vano-line)!important;color:var(--vano-ink)!important}

/* Register / entry experience */
body.vano-live-v258:has(.vano-entry),
body.vano-live-v258 .vano-entry{background:var(--vano-paper)!important;color:var(--vano-ink)!important}
body.vano-live-v258 .v63-entry-shell{background:#fff!important;border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-lg)!important}
body.vano-live-v258 .v63-entry-shell:before{background:linear-gradient(115deg,rgba(255,255,255,.96) 0 43%,rgba(255,246,238,.54) 43% 100%)!important}
body.vano-live-v258 .v63-entry-brand em,
body.vano-live-v258 .v63-entry-kicker,
body.vano-live-v258 .v63-entry-panel h1 span{color:var(--vano-primary-deep)!important}
body.vano-live-v258 .v63-entry-brand em{background:#FFF0E5!important}
body.vano-live-v258 .v63-entry-proof span{border-color:var(--vano-line)!important;background:#FFF9F4!important;color:var(--vano-muted)!important}
body.vano-live-v258 .v63-route-stage{background:radial-gradient(circle at 72% 8%,rgba(255,195,155,.22),transparent 26%),linear-gradient(145deg,#FFF9F4,#F0E7DE)!important;border-color:var(--vano-line)!important}
body.vano-live-v258 .v63-stage-card,
body.vano-live-v258 .v63-stage-brand{background:rgba(255,251,242,.90)!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-live-v258 .auth-choice.primary,
body.vano-live-v258 .auth-google.auth-google-primary{background:linear-gradient(135deg,#FFC39B,#F59A62 50%,#D9703F)!important;color:#fff!important;border-color:transparent!important;box-shadow:0 12px 28px rgba(217,112,63,.21)!important}
body.vano-live-v258 .auth-choice.secondary,
body.vano-live-v258 .auth-guest{background:#fff!important;color:var(--vano-ink)!important;border-color:var(--vano-line)!important}
body.vano-live-v258 .auth-sheet .sheet-card{border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-lg)!important}
body.vano-live-v258 .sheet-input:focus,
body.vano-live-v258 .sheet-select:focus{border-color:rgba(217,112,63,.5)!important;box-shadow:var(--vano-ring)!important}
body.vano-live-v258 .sheet-submit{background:linear-gradient(135deg,#FFC39B,#F59A62 50%,#D9703F)!important;box-shadow:0 12px 26px rgba(217,112,63,.21)!important}

/* Onboarding: convert the legacy dark setup flow into a warm VANO setup flow. */
body.vano-live-v258 .onboard{
  background:radial-gradient(circle at 86% -6%,rgba(255,195,155,.30),transparent 30rem),radial-gradient(circle at 4% 36%,rgba(245,154,98,.10),transparent 25rem),var(--vano-paper)!important;
  color:var(--vano-ink)!important;
}
body.vano-live-v258 .vano-mini{color:var(--vano-ink)!important}
body.vano-live-v258 .vano-mini img{filter:drop-shadow(0 8px 18px rgba(217,112,63,.16))!important}
body.vano-live-v258 .step-pill{color:var(--vano-primary-deep)!important;border-color:#FFD7BF!important;background:#FFF1E6!important}
body.vano-live-v258 .ob-progress{background:#EFE4DB!important}body.vano-live-v258 .ob-progress i{background:linear-gradient(90deg,#FFC39B,#F59A62,#D9703F)!important;box-shadow:0 0 15px rgba(245,154,98,.22)!important}
body.vano-live-v258 .ob-head .eyebrow{color:var(--vano-primary-deep)!important}
body.vano-live-v258 .ob-head h1{color:var(--vano-ink)!important}body.vano-live-v258 .ob-head h1 span{color:#8A7F77!important}body.vano-live-v258 .ob-head p{color:var(--vano-muted)!important}
body.vano-live-v258 .ob-section{border-color:var(--vano-line)!important;background:rgba(255,255,255,.92)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-live-v258 .ob-section-title .ico{background:#FFF0E5!important;border-color:#FFDCC7!important;color:var(--vano-primary-deep)!important}
body.vano-live-v258 .ob-section-title b{color:var(--vano-ink)!important}body.vano-live-v258 .ob-section-title span{color:var(--vano-muted)!important}
body.vano-live-v258 .onboard .input,
body.vano-live-v258 .onboard .select{background:#FFFCF9!important;color:var(--vano-ink)!important;border-color:var(--vano-line)!important}
body.vano-live-v258 .onboard .input::placeholder{color:#A0958D!important}
body.vano-live-v258 .choice label,
body.vano-live-v258 .pref label,
body.vano-live-v258 .night-card{background:#FFFDFC!important;border-color:var(--vano-line)!important}
body.vano-live-v258 .choice label b,
body.vano-live-v258 .pref label b,
body.vano-live-v258 .night-card b,
body.vano-live-v258 .presence-consent b{color:var(--vano-ink)!important}
body.vano-live-v258 .choice label span,
body.vano-live-v258 .pref label span,
body.vano-live-v258 .night-card span,
body.vano-live-v258 .presence-consent span span{color:var(--vano-muted)!important}
body.vano-live-v258 .choice input:checked+label,
body.vano-live-v258 .pref input:checked+label{border-color:rgba(217,112,63,.38)!important;background:#FFF2E8!important;box-shadow:inset 0 0 0 1px rgba(245,154,98,.05)!important}
body.vano-live-v258 .pref-icon{background:#FFF5ED!important;color:#8A7E76!important}body.vano-live-v258 .pref input:checked+label .pref-icon{background:#FFEBDD!important;color:var(--vano-primary-deep)!important}
body.vano-live-v258 .radio-dot{border-color:#CFC2B8!important}body.vano-live-v258 .pref input:checked+label .radio-dot{border-color:var(--vano-primary)!important}body.vano-live-v258 .pref input:checked+label .radio-dot:after{background:var(--vano-primary)!important}
body.vano-live-v258 .slider{background:#D7CCC3!important}body.vano-live-v258 .switch input:checked+.slider{background:linear-gradient(135deg,var(--vano-primary-soft),var(--vano-primary))!important}
body.vano-live-v258 .mini-note{background:#FFF8F2!important;color:var(--vano-muted)!important}
body.vano-live-v258 .privacy-note{background:#FFF6EF!important;border-color:#FFE1CE!important;color:#796C63!important}body.vano-live-v258 .privacy-note i{color:var(--vano-primary-deep)!important}
body.vano-live-v258 .presence-consent{border-color:#FFD9C3!important;background:#FFF4EB!important}
body.vano-live-v258 .fine,
body.vano-live-v258 .optional,
body.vano-live-v258 .vehicle-hint{color:#887D75!important}body.vano-live-v258 .vehicle-hint i{color:var(--vano-primary-deep)!important}

/* Live trip standalone */
body.vano-live-v258 .app{background:#F4EEE7!important;color:var(--vano-ink)!important}
body.vano-live-v258 .app .map{background:#F1EAE3!important}
body.vano-live-v258 .app .veil{background:linear-gradient(180deg,rgba(255,251,242,.18),transparent 24%,transparent 70%,rgba(255,251,242,.12))!important}
body.vano-live-v258 .app .brand,
body.vano-live-v258 .app .status{background:rgba(255,251,242,.95)!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-live-v258 .app .status{color:var(--vano-muted)!important}
body.vano-live-v258 .app .dot{background:var(--vano-primary)!important;box-shadow:0 0 0 5px rgba(245,154,98,.13)!important}
body.vano-live-v258 .app .card{background:rgba(255,251,242,.97)!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important;box-shadow:0 -14px 42px rgba(67,49,37,.14)!important}
body.vano-live-v258 .app .grab{background:#D6CBC2!important}body.vano-live-v258 .app .eyebrow{color:var(--vano-primary-deep)!important}body.vano-live-v258 .app .card p,
body.vano-live-v258 .app .stat span,
body.vano-live-v258 .app .privacy{color:var(--vano-muted)!important}
body.vano-live-v258 .app .stat{background:#FFF8F2!important;border-color:var(--vano-line)!important}body.vano-live-v258 .app .progress{background:#EDE2D9!important}
body.vano-live-v258 .app .progress i{background:linear-gradient(90deg,#FFC39B,#F59A62,#D9703F)!important}
body.vano-live-v258 .app .puck{background:linear-gradient(145deg,#FFC39B,#F59A62 55%,#D9703F)!important;border-color:#FFFBF2!important;box-shadow:0 0 0 4px rgba(39,35,31,.82),0 9px 22px rgba(39,35,31,.24)!important}
body.vano-live-v258 .app .offline{background:var(--vano-paper)!important;color:var(--vano-ink)!important}body.vano-live-v258 .app .offline p{color:var(--vano-muted)!important}


/* Map layer */
/* VANO v170 — Mapbox/navigation redesign. Geometry and IDs are preserved. */
body.vano-live-v258 .ws-app{
  --v-card:rgba(255,251,242,.965);
  --v-card-solid:#FFFBF2;
  --v-ink:#27231F;
  --v-muted:#706861;
  --v-primary:#F59A62;
  --v-light:#FFC39B;
  --v-deep:#D9703F;
  --v-line:rgba(112,104,97,.17);
  --v-shadow:0 18px 48px rgba(67,49,37,.14);
  background:#F4EEE7!important;
  color:var(--v-ink)!important;
}
body.vano-live-v258 .ws-app #map{background:#F4EEE7!important}
body.vano-live-v258 .map-vignette{background:linear-gradient(180deg,rgba(255,251,242,.40),transparent 18%,transparent 76%,rgba(255,251,242,.14))!important}
body.vano-live-v258 .ambient-halo{opacity:.45!important;filter:saturate(.78)!important}
body.vano-live-v258 .vano-map-brand{
  background:rgba(255,251,242,.86)!important;
  border:1px solid rgba(112,104,97,.11)!important;
  border-radius:16px!important;
  box-shadow:0 8px 24px rgba(67,49,37,.09)!important;
  backdrop-filter:blur(18px) saturate(1.15)!important;
}
body.vano-live-v258 .vano-map-brand img{filter:none!important}

/* Search / planning sheet */
body.vano-live-v258 .search-card,
body.vano-live-v258 .planner-search-card.search-card{
  background:rgba(255,251,242,.94)!important;
  color:var(--v-ink)!important;
  border:1px solid rgba(112,104,97,.15)!important;
  border-radius:22px!important;
  box-shadow:0 14px 36px rgba(67,49,37,.13),inset 0 1px 0 rgba(255,255,255,.92)!important;
  backdrop-filter:blur(24px) saturate(1.25)!important;
  -webkit-backdrop-filter:blur(24px) saturate(1.25)!important;
}
body.vano-live-v258 .location-row+.location-row{border-top-color:rgba(112,104,97,.10)!important}
body.vano-live-v258 .location-input{color:var(--v-ink)!important;font-weight:760!important;letter-spacing:-.18px!important}
body.vano-live-v258 .location-input::placeholder{color:#958A82!important}
body.vano-live-v258 .row-btn,
body.vano-live-v258 .planner-adjust-btn,
body.vano-live-v258 .map-btn,
body.vano-live-v258 .options-btn,
body.vano-live-v258 .floating-locate,
body.vano-live-v258 .nav-stack-btn,
body.vano-live-v258 .nav-audio-toggle,
body.vano-live-v258 .nav-search-btn{
  background:rgba(255,251,242,.96)!important;
  color:var(--v-ink)!important;
  border:1px solid rgba(112,104,97,.13)!important;
  box-shadow:0 8px 22px rgba(67,49,37,.105)!important;
}
body.vano-live-v258 .row-btn:hover,
body.vano-live-v258 .planner-adjust-btn:hover,
body.vano-live-v258 .map-btn:hover,
body.vano-live-v258 .options-btn:hover,
body.vano-live-v258 .floating-locate:hover,
body.vano-live-v258 .nav-stack-btn:hover,
body.vano-live-v258 .nav-audio-toggle:hover{background:#FFF0E5!important;color:var(--v-deep)!important}
body.vano-live-v258 .search-results,
body.vano-live-v258 .search-results.search-results-portal{
  background:rgba(255,251,242,.985)!important;
  color:var(--v-ink)!important;
  border:1px solid rgba(112,104,97,.15)!important;
  box-shadow:0 20px 52px rgba(67,49,37,.16)!important;
  backdrop-filter:blur(22px)!important;
}
body.vano-live-v258 .search-item{border-color:rgba(112,104,97,.08)!important}
body.vano-live-v258 .search-item:hover,
body.vano-live-v258 .search-item:active{background:#FFF3E9!important}
body.vano-live-v258 .result-icon,
body.vano-live-v258 .planner-preset-icon,
body.vano-live-v258 .nearby-service-icon{
  background:linear-gradient(145deg,#FFF3E9,#FFE6D4)!important;
  color:var(--v-deep)!important;
  border-color:#FFDDC8!important;
}
body.vano-live-v258 .result-copy b,
body.vano-live-v258 .planner-heading-copy b{color:var(--v-ink)!important}
body.vano-live-v258 .result-copy small,
body.vano-live-v258 .result-meta,
body.vano-live-v258 .search-label,
body.vano-live-v258 .search-message,
body.vano-live-v258 .planner-tip,
body.vano-live-v258 .planner-heading-copy span{color:var(--v-muted)!important}

body.vano-live-v258 .sheet#planSheet,
body.vano-live-v258 .sheet,
body.vano-live-v258 .destination-confirm,
body.vano-live-v258 .prefs-drawer,
body.vano-live-v258 .safety-drawer,
body.vano-live-v258 .account-drawer,
body.vano-live-v258 .options-drawer{
  background:rgba(255,251,242,.975)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.15)!important;
  box-shadow:0 -14px 52px rgba(67,49,37,.15)!important;
  backdrop-filter:blur(26px) saturate(1.18)!important;
  -webkit-backdrop-filter:blur(26px) saturate(1.18)!important;
}
body.vano-live-v258 .grab,
body.vano-live-v258 .sheet-grab{background:#D9D0C8!important}
body.vano-live-v258 .planner-preset,
body.vano-live-v258 .nearby-service,
body.vano-live-v258 .quick,
body.vano-live-v258 .route-card,
body.vano-live-v258 .parking-nearby,
body.vano-live-v258 .parking-item,
body.vano-live-v258 .route-insight .insight,
body.vano-live-v258 .sub-action,
body.vano-live-v258 .safety-tool,
body.vano-live-v258 .pref-row{
  background:rgba(255,255,255,.88)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.13)!important;
  box-shadow:none!important;
}
body.vano-live-v258 .planner-preset:hover,
body.vano-live-v258 .nearby-service:hover,
body.vano-live-v258 .quick:hover,
body.vano-live-v258 .parking-item:hover,
body.vano-live-v258 .sub-action:hover{background:#FFF4EB!important;border-color:rgba(217,112,63,.22)!important}
body.vano-live-v258 .segment,
body.vano-live-v258 .travel{background:#F8EFE7!important;border-color:rgba(112,104,97,.12)!important;padding:4px!important}
body.vano-live-v258 .segment button,
body.vano-live-v258 .travel button{color:#7B716A!important;border-color:transparent!important;border-radius:12px!important}
body.vano-live-v258 .segment button.active,
body.vano-live-v258 .travel button.active,
body.vano-live-v258 .segment button.smart.active{
  color:#A94F29!important;
  background:#FFF8F3!important;
  border-color:#FFD6BD!important;
  box-shadow:0 5px 14px rgba(217,112,63,.09)!important;
}
body.vano-live-v258 .route-head h2,
body.vano-live-v258 .route-card h3,
body.vano-live-v258 .parking-head b{color:var(--v-ink)!important}
body.vano-live-v258 .route-head p,
body.vano-live-v258 .route-ai,
body.vano-live-v258 .parking-head span,
body.vano-live-v258 .parking-empty,
body.vano-live-v258 .route-card p{color:var(--v-muted)!important}
body.vano-live-v258 .route-time span{color:var(--v-ink)!important}
body.vano-live-v258 .route-time small{color:var(--v-deep)!important}
body.vano-live-v258 .customize-route-kicker span,
body.vano-live-v258 .route-choice-label{color:#9A8E86!important}
body.vano-live-v258 .customize-route-kicker b{color:var(--v-ink)!important}

/* Main CTA — deliberately rebuilt to feel like the hero action */
body.vano-live-v258 .start-trip-cta{
  position:relative!important;
  min-height:62px!important;
  padding:8px 12px 8px 9px!important;
  display:grid!important;
  grid-template-columns:46px minmax(0,1fr) 36px!important;
  align-items:center!important;
  gap:10px!important;
  border:1px solid rgba(255,255,255,.40)!important;
  border-radius:20px!important;
  overflow:hidden!important;
  background:
    radial-gradient(circle at 18% -10%,rgba(255,255,255,.58),transparent 30%),
    linear-gradient(135deg,#FFC39B 0%,#F59A62 48%,#D9703F 100%)!important;
  color:#fff!important;
  box-shadow:0 16px 36px rgba(217,112,63,.28),inset 0 1px 0 rgba(255,255,255,.54),inset 0 -1px 0 rgba(132,59,26,.10)!important;
  text-align:left!important;
  transform:translateZ(0)!important;
  transition:transform .2s cubic-bezier(.2,.8,.2,1),box-shadow .2s ease,filter .2s ease!important;
}
body.vano-live-v258 .start-trip-cta:before{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 18%,rgba(255,255,255,.20) 38%,transparent 58%);transform:translateX(-120%);transition:transform .6s ease;pointer-events:none}
body.vano-live-v258 .start-trip-cta:hover:before{transform:translateX(120%)}
body.vano-live-v258 .start-trip-cta:hover{transform:translateY(-1px)!important;box-shadow:0 19px 42px rgba(217,112,63,.34),inset 0 1px 0 rgba(255,255,255,.6)!important}
body.vano-live-v258 .start-trip-cta:active{transform:translateY(0) scale(.99)!important}
body.vano-live-v258 .start-trip-cta:disabled{filter:saturate(.72);opacity:.8!important}
body.vano-live-v258 .start-trip-icon{
  width:46px!important;height:46px!important;border-radius:15px!important;display:grid!important;place-items:center!important;
  background:linear-gradient(155deg,#38332E,#211E1B)!important;
  color:#FFF8F3!important;
  border:1px solid rgba(255,255,255,.14)!important;
  box-shadow:0 8px 18px rgba(68,37,23,.20),inset 0 1px 0 rgba(255,255,255,.12)!important;
}
body.vano-live-v258 .start-trip-icon svg{width:20px!important;height:20px!important;stroke-width:2.4!important}
body.vano-live-v258 .start-trip-copy{min-width:0!important;display:flex!important;flex-direction:column!important;gap:2px!important}
body.vano-live-v258 .start-trip-copy b{font-size:14px!important;line-height:1.12!important;letter-spacing:-.28px!important;color:#fff!important;font-weight:880!important}
body.vano-live-v258 .start-trip-copy small{font-size:9px!important;line-height:1.25!important;color:rgba(255,255,255,.82)!important;font-weight:720!important;letter-spacing:.01em!important}
body.vano-live-v258 .start-trip-arrow{width:34px!important;height:34px!important;border-radius:50%!important;display:grid!important;place-items:center!important;background:rgba(255,255,255,.17)!important;border:1px solid rgba(255,255,255,.20)!important;color:#fff!important;font-size:24px!important;line-height:1!important}

/* Confirmation / loading */
body.vano-live-v258 .destination-confirm-card,
body.vano-live-v258 .route-loading-card,
body.vano-live-v258 .resume-trip-card,
body.vano-live-v258 .immersive-choice-card,
body.vano-live-v258 .guest-limit-card{
  background:rgba(255,251,242,.98)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.16)!important;
  box-shadow:0 24px 68px rgba(67,49,37,.19)!important;
}
body.vano-live-v258 .destination-accept,
body.vano-live-v258 .resume-trip-continue,
body.vano-live-v258 .traffic-accept,
body.vano-live-v258 .guest-limit-primary{
  color:#fff!important;
  background:linear-gradient(135deg,#FFC39B,#F59A62 48%,#D9703F)!important;
  border-color:transparent!important;
  box-shadow:0 10px 25px rgba(217,112,63,.22)!important;
}
body.vano-live-v258 .destination-edit,
body.vano-live-v258 .resume-trip-dismiss,
body.vano-live-v258 .traffic-dismiss,
body.vano-live-v258 .guest-limit-secondary{background:#fff!important;color:var(--v-ink)!important;border-color:var(--v-line)!important}
body.vano-live-v258 .route-loading-spinner{border-color:rgba(245,154,98,.18)!important;border-top-color:var(--v-deep)!important}
body.vano-live-v258 .route-loading-dots i{background:var(--v-primary)!important}

/* Map controls/status */
body.vano-live-v258 .status-chip,
body.vano-live-v258 .gps-quality,
body.vano-live-v258 .traffic-radar,
body.vano-live-v258 .connectivity-pill,
body.vano-live-v258 .nav-map-mode,
body.vano-live-v258 .nav-tracking,
body.vano-live-v258 .nav-immersive-chip,
body.vano-live-v258 .nav-voice-popover,
body.vano-live-v258 .nav-alt-hint,
body.vano-live-v258 .nav-feedback{
  background:rgba(255,251,242,.94)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.14)!important;
  box-shadow:0 10px 28px rgba(67,49,37,.12)!important;
  backdrop-filter:blur(18px) saturate(1.2)!important;
}
body.vano-live-v258 .floating-speedo{background:rgba(39,35,31,.93)!important;color:#fff!important;border-color:rgba(255,255,255,.08)!important;box-shadow:0 12px 28px rgba(39,35,31,.22)!important}
body.vano-live-v258 .floating-speedo small{color:#CFC6BF!important}

/* Active navigation HUD */
body.vano-live-v258 .nav-maneuver-top{
  background:
    radial-gradient(circle at 18% -25%,rgba(255,195,155,.16),transparent 40%),
    linear-gradient(150deg,#302B27,#211E1B)!important;
  color:#FFFBF2!important;
  border:1px solid rgba(255,255,255,.09)!important;
  border-radius:24px!important;
  box-shadow:0 18px 44px rgba(39,35,31,.26),inset 0 1px 0 rgba(255,255,255,.06)!important;
  backdrop-filter:blur(18px)!important;
}
body.vano-live-v258 .nav-maneuver-icon{
  background:linear-gradient(145deg,#FFC39B,#F59A62 56%,#D9703F)!important;
  color:#fff!important;
  border:1px solid rgba(255,255,255,.28)!important;
  box-shadow:0 9px 20px rgba(217,112,63,.23),inset 0 1px 0 rgba(255,255,255,.45)!important;
}
body.vano-live-v258 .nav-maneuver-copy small{color:#CFC5BE!important}
body.vano-live-v258 .nav-maneuver-copy b{color:#fff!important}
body.vano-live-v258 .nav-maneuver-copy span{color:#E7DED8!important}
body.vano-live-v258 .nav-street-chip{background:rgba(255,251,242,.94)!important;color:var(--v-ink)!important;border-color:rgba(112,104,97,.13)!important;box-shadow:0 8px 22px rgba(67,49,37,.10)!important}
body.vano-live-v258 .nav-panel.nav-minimal{
  background:rgba(255,251,242,.965)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.15)!important;
  box-shadow:0 -18px 52px rgba(67,49,37,.17)!important;
  backdrop-filter:blur(24px) saturate(1.2)!important;
}
body.vano-live-v258 .nav-summary-item{background:#FFF8F2!important;border-color:rgba(112,104,97,.11)!important}
body.vano-live-v258 .nav-summary-item small{color:#9A8E86!important}
body.vano-live-v258 .nav-summary-item strong{color:var(--v-ink)!important}
body.vano-live-v258 .traffic-suggestion{background:#FFF4EA!important;border-color:#FFD7BE!important}
body.vano-live-v258 .traffic-suggestion-icon{background:#fff!important;color:var(--v-deep)!important}
body.vano-live-v258 .nav-alt-accept{background:var(--v-primary)!important;color:#fff!important}
body.vano-live-v258 .reroute .loading{border-color:rgba(245,154,98,.20)!important;border-top-color:var(--v-primary)!important}

/* User puck */
body.vano-live-v258 .user-marker.vano-uploaded-user{filter:drop-shadow(0 10px 14px rgba(66,42,28,.24))!important}
body.vano-live-v258 .user-marker.vano-uploaded-user .pulse{background:radial-gradient(circle,rgba(245,154,98,.22) 0 18%,rgba(245,154,98,.08) 36%,transparent 68%)!important;animation-duration:2.6s!important}
body.vano-live-v258 .user-marker.vano-uploaded-user .user-puck-image{filter:drop-shadow(0 1px 0 rgba(255,255,255,.45))!important}

/* Destination marker: built from DOM/CSS, no rectangular PNG asset. */
body.vano-live-v258 .route-marker.destination{
  width:48px!important;
  height:59px!important;
  overflow:visible!important;
  filter:none!important;
  pointer-events:none!important;
}
body.vano-live-v258 .arrival-ground{
  position:absolute!important;
  left:50%!important;
  bottom:0!important;
  width:29px!important;
  height:8px!important;
  transform:translateX(-50%)!important;
  border-radius:50%!important;
  background:rgba(39,35,31,.22)!important;
  filter:blur(4px)!important;
}
body.vano-live-v258 .arrival-bubble{
  position:absolute!important;
  left:50%!important;
  top:0!important;
  width:44px!important;
  height:44px!important;
  transform:translateX(-50%) translateZ(0)!important;
  border-radius:50%!important;
  background:linear-gradient(145deg,#3B3530,#211E1B)!important;
  border:1px solid rgba(255,255,255,.18)!important;
  box-shadow:
    0 10px 20px rgba(39,35,31,.24),
    0 3px 8px rgba(217,112,63,.12),
    inset 0 1px 0 rgba(255,255,255,.20),
    inset 0 -2px 5px rgba(0,0,0,.20)!important;
}
body.vano-live-v258 .arrival-bubble:after{
  content:""!important;
  position:absolute!important;
  left:50%!important;
  bottom:-10px!important;
  width:18px!important;
  height:18px!important;
  transform:translateX(-50%) rotate(45deg)!important;
  border-radius:3px 0 5px 0!important;
  background:linear-gradient(135deg,#2B2723 42%,#211E1B 100%)!important;
  border-right:1px solid rgba(255,255,255,.12)!important;
  border-bottom:1px solid rgba(255,255,255,.09)!important;
  box-shadow:5px 5px 10px rgba(39,35,31,.12)!important;
  z-index:-1!important;
}
body.vano-live-v258 .arrival-ring{
  position:absolute!important;
  inset:4px!important;
  border-radius:50%!important;
  padding:3px!important;
  background:linear-gradient(145deg,#FFE0CB 0%,#FFC39B 22%,#F59A62 58%,#D9703F 100%)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.64),0 1px 5px rgba(217,112,63,.20)!important;
}
body.vano-live-v258 .arrival-checkers{
  position:relative!important;
  display:block!important;
  width:100%!important;
  height:100%!important;
  overflow:hidden!important;
  border-radius:50%!important;
  background-color:#FFFBF2!important;
  background-image:conic-gradient(#27231F 25%,#FFFBF2 0 50%,#27231F 0 75%,#FFFBF2 0)!important;
  background-size:12px 12px!important;
  background-position:center!important;
  box-shadow:inset 0 0 0 1px rgba(39,35,31,.45),inset 0 -7px 10px rgba(39,35,31,.12),inset 0 7px 10px rgba(255,255,255,.28)!important;
  transform:rotate(-3deg)!important;
}
body.vano-live-v258 .arrival-checkers:before{
  content:""!important;
  position:absolute!important;
  inset:-4px!important;
  border-radius:50%!important;
  background:linear-gradient(145deg,rgba(255,255,255,.66) 0 21%,transparent 38% 65%,rgba(39,35,31,.10) 100%)!important;
  pointer-events:none!important;
}
body.vano-live-v258 .arrival-checkers:after{
  content:""!important;
  position:absolute!important;
  left:8px!important;right:8px!important;top:4px!important;height:7px!important;
  border-radius:50%!important;
  background:rgba(255,255,255,.32)!important;
  filter:blur(2px)!important;
}

body.vano-live-v258 .body-nav .route-marker.destination .arrival-visual{transform:scale(.96)!important;transform-origin:center bottom!important}

/* Map alerts rebuilt with the same polished DOM/CSS language as the arrival pin. */
body.vano-live-v258 .route-marker.alert-marker{position:relative!important;width:52px!important;height:64px!important;padding:0!important;border:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important;cursor:pointer!important;pointer-events:auto!important;appearance:none!important;-webkit-appearance:none!important}
body.vano-live-v258 .alert-visual{position:relative!important;display:block!important;width:52px!important;height:64px!important}
body.vano-live-v258 .alert-ground{position:absolute!important;left:50%!important;bottom:0!important;width:31px!important;height:8px!important;transform:translateX(-50%)!important;border-radius:50%!important;background:rgba(39,35,31,.18)!important;filter:blur(4px)!important}
body.vano-live-v258 .alert-bubble{position:absolute!important;left:50%!important;top:0!important;width:46px!important;height:46px!important;transform:translateX(-50%) translateZ(0)!important;border-radius:50%!important;background:linear-gradient(145deg,#3B3530,#211E1B)!important;border:1px solid rgba(255,255,255,.18)!important;box-shadow:0 10px 20px rgba(39,35,31,.22),0 3px 8px rgba(217,112,63,.12),inset 0 1px 0 rgba(255,255,255,.20),inset 0 -2px 5px rgba(0,0,0,.20)!important}
body.vano-live-v258 .alert-bubble:after{content:""!important;position:absolute!important;left:50%!important;bottom:-10px!important;width:18px!important;height:18px!important;transform:translateX(-50%) rotate(45deg)!important;border-radius:3px 0 5px 0!important;background:linear-gradient(135deg,#2B2723 42%,#211E1B 100%)!important;border-right:1px solid rgba(255,255,255,.12)!important;border-bottom:1px solid rgba(255,255,255,.09)!important;box-shadow:5px 5px 10px rgba(39,35,31,.12)!important;z-index:-1!important}
body.vano-live-v258 .alert-ring{position:absolute!important;inset:4px!important;display:grid!important;place-items:center!important;border-radius:50%!important;padding:3px!important;background:linear-gradient(145deg,#FFE0CB 0%,#FFC39B 22%,#F59A62 58%,#D9703F 100%)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.64),0 1px 5px rgba(217,112,63,.20)!important}
body.vano-live-v258 .alert-face{position:relative!important;display:grid!important;place-items:center!important;width:100%!important;height:100%!important;overflow:hidden!important;border-radius:50%!important;background:radial-gradient(circle at 34% 26%,#FFFFFF 0%,#FFF8F1 40%,#F1E5D8 100%)!important;box-shadow:inset 0 0 0 1px rgba(39,35,31,.16),inset 0 -7px 10px rgba(39,35,31,.09),inset 0 7px 10px rgba(255,255,255,.28)!important}
body.vano-live-v258 .alert-face:before{content:""!important;position:absolute!important;inset:0!important;border-radius:50%!important;background:linear-gradient(145deg,rgba(255,255,255,.58) 0 21%,transparent 38% 68%,rgba(39,35,31,.07) 100%)!important;pointer-events:none!important}
body.vano-live-v258 .alert-face:after{content:""!important;position:absolute!important;left:9px!important;right:9px!important;top:5px!important;height:7px!important;border-radius:50%!important;background:rgba(255,255,255,.34)!important;filter:blur(2px)!important;pointer-events:none!important}
body.vano-live-v258 .alert-icon{position:relative!important;z-index:1!important;display:grid!important;place-items:center!important;width:100%!important;height:100%!important}
body.vano-live-v258 .alert-icon-svg{width:24px!important;height:24px!important;display:block!important}
body.vano-live-v258 .alert-icon-svg .fg{fill:#27231F!important}body.vano-live-v258 .alert-icon-svg .accent{fill:#F59A62!important}body.vano-live-v258 .alert-icon-svg .light{fill:#FFFBF2!important}body.vano-live-v258 .alert-icon-svg .stroke{fill:none!important;stroke:#27231F!important;stroke-width:1.8!important;stroke-linecap:round!important;stroke-linejoin:round!important}body.vano-live-v258 .alert-icon-svg .stroke-fill{fill:#FFFBF2!important;stroke:#27231F!important;stroke-width:1.4!important}
body.vano-live-v258 .route-marker.alert-marker[data-kind="traffic"] .alert-face{background:radial-gradient(circle at 34% 26%,#FFFFFF 0%,#FFF7ED 38%,#F6E1CF 100%)!important}
body.vano-live-v258 .route-marker.alert-marker[data-kind="flood"] .alert-face{background:radial-gradient(circle at 34% 26%,#FFFFFF 0%,#FFF8F1 42%,#F0E9E0 100%)!important}
body.vano-live-v258 .route-marker.alert-marker[data-kind="police"] .alert-ring,
body.vano-live-v258 .route-marker.alert-marker[data-kind="security"] .alert-ring{background:linear-gradient(145deg,#FFE0CB 0%,#FFC39B 20%,#F59A62 55%,#CF6A3C 100%)!important}
@media(max-width:640px){body.vano-live-v258 .route-marker.alert-marker{width:48px!important;height:60px!important}body.vano-live-v258 .alert-visual{width:48px!important;height:60px!important}body.vano-live-v258 .alert-bubble{width:42px!important;height:42px!important}body.vano-live-v258 .alert-icon-svg{width:22px!important;height:22px!important}}

/* Arrival marker also used by standalone shared-route page */
body.vano-live-v258 .marker.dest{
  position:relative!important;width:38px!important;height:46px!important;border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important;
}
body.vano-live-v258 .marker.dest:before{
  content:""!important;position:absolute!important;left:50%!important;top:0!important;width:36px!important;height:36px!important;transform:translateX(-50%)!important;border-radius:50%!important;
  background:conic-gradient(#27231F 25%,#FFFBF2 0 50%,#27231F 0 75%,#FFFBF2 0) center/10px 10px!important;
  border:4px solid #F59A62!important;box-shadow:0 0 0 3px #27231F,0 8px 18px rgba(39,35,31,.22),inset 0 3px 6px rgba(255,255,255,.28)!important;
}
body.vano-live-v258 .marker.dest:after{
  content:""!important;position:absolute!important;left:50%!important;top:31px!important;width:14px!important;height:14px!important;transform:translateX(-50%) rotate(45deg)!important;background:#27231F!important;border-radius:2px!important;box-shadow:5px 5px 9px rgba(39,35,31,.10)!important;z-index:-1!important;
}

/* Popups / Mapbox chrome */
body.vano-live-v258 .mapboxgl-popup-content{background:rgba(255,251,242,.98)!important;color:var(--v-ink)!important;border:1px solid rgba(112,104,97,.15)!important;border-radius:16px!important;box-shadow:0 16px 38px rgba(67,49,37,.16)!important}
body.vano-live-v258 .mapboxgl-popup-tip{border-top-color:#FFFBF2!important}
body.vano-live-v258 .mapboxgl-ctrl-group{border-radius:14px!important;overflow:hidden!important;box-shadow:0 8px 22px rgba(67,49,37,.11)!important}
body.vano-live-v258 .mapboxgl-ctrl-group button{background:#FFFBF2!important;color:var(--v-ink)!important}
body.vano-live-v258 .mapboxgl-ctrl-attrib.mapboxgl-compact,
body.vano-live-v258 .mapboxgl-ctrl-attrib{background:rgba(255,251,242,.84)!important;color:#7F746D!important;border-color:rgba(112,104,97,.12)!important}

/* Do not let the legacy dark theme repaint the navigation. */
html[data-vano-theme="black"] body.vano-live-v258 .ws-app,
html[data-vano-theme="black"] body.vano-live-v258 .sheet#planSheet,
html[data-vano-theme="black"] body.vano-live-v258 .search-card,
html[data-vano-theme="black"] body.vano-live-v258 .nav-panel.nav-minimal,
html[data-vano-theme="black"] body.vano-live-v258 .destination-confirm,
html[data-vano-theme="black"] body.vano-live-v258 .prefs-drawer,
html[data-vano-theme="black"] body.vano-live-v258 .safety-drawer{background:rgba(255,251,242,.97)!important;color:var(--v-ink)!important;border-color:var(--v-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 .nav-maneuver-top{background:linear-gradient(150deg,#302B27,#211E1B)!important;color:#fff!important}

@media(max-width:640px){
  body.vano-live-v258 .search-card,
body.vano-live-v258 .planner-search-card.search-card{left:8px!important;right:8px!important;border-radius:19px!important}
  body.vano-live-v258 .sheet#planSheet,
body.vano-live-v258 .sheet{border-radius:24px 24px 0 0!important}
  body.vano-live-v258 .start-trip-cta{min-height:58px!important;border-radius:18px!important;grid-template-columns:42px minmax(0,1fr) 32px!important;gap:9px!important;padding:8px 10px 8px 8px!important}
  body.vano-live-v258 .start-trip-icon{width:42px!important;height:42px!important;border-radius:14px!important}
  body.vano-live-v258 .start-trip-copy b{font-size:13px!important}
  body.vano-live-v258 .start-trip-copy small{font-size:8px!important}
  body.vano-live-v258 .start-trip-arrow{width:30px!important;height:30px!important;font-size:21px!important}
  body.vano-live-v258 .nav-maneuver-top{border-radius:20px!important}
  body.vano-live-v258 .route-marker.destination{width:44px!important;height:55px!important}
  body.vano-live-v258 .route-marker.destination .arrival-visual{transform:scale(.94)!important;transform-origin:center bottom!important}
}
body.vano-live-v258 .start-trip-loading-icon .loading{width:18px!important;height:18px!important;border:2px solid rgba(255,255,255,.28)!important;border-top-color:#fff!important;border-radius:50%!important;animation:spin .7s linear infinite!important}
body.vano-live-v258 .start-trip-cta.is-starting .start-trip-arrow{font-size:16px!important;font-weight:900!important;letter-spacing:2px!important}


/* Black theme layer */
/* VANO v176 — final black-mode authority and auth/banner polish. */
body.vano-live-v258{--vb-bg:#171512;--vb-surface:#211E1B;--vb-surface-2:#27231F;--vb-surface-3:#302B27;--vb-text:#FFFBF2;--vb-muted:#D5CBC4;--vb-muted-2:#B9AEA7;--vb-line:rgba(255,251,242,.11);--vb-orange:#F59A62;--vb-orange-2:#FFC39B;--vb-orange-3:#D9703F}

/* Brand banner: use the exact supplied 2048×682 artwork but crop its built-in whitespace in CSS. */
body.vano-live-v258 .vano-auth-banner-link{display:block!important;width:min(100%,570px)!important;text-decoration:none!important}
body.vano-live-v258 .vano-auth-banner-frame{position:relative!important;display:block!important;width:min(100%,560px)!important;aspect-ratio:5.06/1!important;overflow:hidden!important;border-radius:20px!important;background:#fff!important;border:1px solid rgba(112,104,97,.10)!important;box-shadow:0 14px 38px rgba(74,51,36,.11)!important;isolation:isolate!important}
body.vano-live-v258 .vano-auth-banner-frame .vano-auth-banner{position:absolute!important;left:50%!important;top:50%!important;width:123.7%!important;height:auto!important;max-width:none!important;max-height:none!important;transform:translate(-50%,-50%)!important;display:block!important;image-rendering:auto!important;filter:none!important;object-fit:initial!important}
body.vano-live-v258 .vano-auth-banner--compact .vano-auth-banner-frame,
body.vano-live-v258 .vano-auth-banner-frame.compact{width:min(100%,465px)!important}
body.vano-live-v258 .vano-auth-tagline{margin:10px 0 0!important;color:#706861!important;font-size:12px!important;font-weight:720!important;line-height:1.3!important;letter-spacing:-.12px!important}
@media(max-width:760px){body.vano-live-v258 .vano-auth-banner-link{width:min(100%,380px)!important}body.vano-live-v258 .vano-auth-banner-frame{width:min(100%,360px)!important;border-radius:17px!important}body.vano-live-v258 .vano-auth-tagline{font-size:10.5px!important;margin-top:7px!important}}
@media(max-width:370px){body.vano-live-v258 .vano-auth-banner-link{width:min(100%,330px)!important}body.vano-live-v258 .vano-auth-banner-frame{width:min(100%,316px)!important}}

/* Black mode must paint before and across every normal page. */
html[data-vano-theme="black"] body.vano-live-v258{background:var(--vb-bg)!important;color-scheme:dark!important}
html[data-vano-theme="black"] body.vano-live-v258{background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258:before{background:radial-gradient(circle at 18% -10%,rgba(245,154,98,.055),transparent 28%),radial-gradient(circle at 88% 8%,rgba(255,195,155,.025),transparent 24%)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.page,.section,.auth-wrap,.onboard,.vano-entry){background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.topbar,.mobile-dock){background:rgba(23,21,18,.96)!important;border-color:var(--vb-line)!important;color:var(--vb-text)!important;box-shadow:0 12px 34px rgba(0,0,0,.24)!important}
html[data-vano-theme="black"] body.vano-live-v258 footer{background:var(--vb-bg)!important;border-color:var(--vb-line)!important;color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.navlinks a,.navlinks button.navbtn,.nav-actions .tiny){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.navlinks a:hover,.navlinks button.navbtn:hover,.navlinks a.active){background:var(--vb-surface-2)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.page-title,.title,.section-title,h1,h2,h3,h4,h5,h6,strong,b,summary,label){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.page-subtitle,.subtitle,.muted,.tiny,p,small){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.eyebrow,[class*="eyebrow"],[class*="kicker"]){color:var(--vb-orange-2)!important}

/* General surfaces/forms used by content pages. */
html[data-vano-theme="black"] body.vano-live-v258 :is(.panel,.card,.kpi,.alert-card,.auth-card,.invite-card,.faq-hero,.faq details,.notif,.users-surface,.flash){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:0 14px 42px rgba(0,0,0,.20)!important}
html[data-vano-theme="black"] :is(.panel-head,.panel-body.vano-live-v258,.card-body,.section,.table-wrap){border-color:var(--vb-line)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.input,.select,.textarea,input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),select,textarea){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.input,.select,.textarea,input,textarea)::placeholder{color:#AFA49D!important}
html[data-vano-theme="black"] body.vano-live-v258 table{color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.table th,.table td,thead,tbody,tr){border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 .table tr:hover td{background:rgba(255,251,242,.025)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.badge,.pill,.chip){border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 .btn:not(.btn-primary){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 .btn-primary{color:#fff!important}

/* Map UI: the account/profile drawer and its profile section were being repainted white by older CSS. */
html[data-vano-theme="black"] body.vano-live-v258 .ws-app{background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 .ws-app :is(.account-drawer,.safety-drawer,.prefs-drawer,.quick-alert-card,.search-results,.destination-confirm,.sheet#planSheet,.sheet,.route-card,.guest-limit-card,.resume-trip-card,.nav-panel.nav-minimal,.nav-voice-popover,.traffic-radar,.route-loading-card){background:rgba(33,30,27,.975)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:0 18px 50px rgba(0,0,0,.32)!important}
html[data-vano-theme="black"] body.vano-live-v258 .ws-app :is(.drawer-user,.drawer-link,.drawer-profile,.safety-tool,.pref-row,.quick-alert-grid button,.parking-item,.planner-preset,.nearby-service,.search-item,.search-suggestion,.location-row,.segment button,.travel button,.preview-actions .sub-action){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 .ws-app :is(.drawer-user b,.drawer-profile,.drawer-link,.drawer-link span,.drawer-link em,.drawer-link i,.safety-tool,.safety-tool b,.pref-row,.pref-row b,.quick-alert-label,.quick-alert-head h3,.search-item b,.search-suggestion b,.planner-heading-copy b,.route-card h3,.route-head h2,.destination-confirm h3,.nav-summary-item strong){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 .ws-app :is(.drawer-user span,.drawer-login p,.guest-drawer-content>p,.quick-alert-head p,.quick-alert-status,.result-address,.result-copy small,.search-label,.search-label span,.search-label em,.search-message,.search-message span,.search-suggestion small,.planner-heading-copy span,.route-card-meta,.route-ai,.destination-confirm p,.nav-summary-item small,.traffic-radar-copy span){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-live-v258 .ws-app :is(.drawer-divider,.support-title){border-color:var(--vb-line)!important;background-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 .ws-app :is(.drawer-link:hover,.drawer-link:active,.search-item:active,.search-suggestion:active,.quick-alert-grid button:active,.planner-preset:active,.nearby-service:active){background:var(--vb-surface-3)!important;color:var(--vb-orange-2)!important}
html[data-vano-theme="black"] body.vano-live-v258 .ws-app :is(.drawer-avatar.fallback,.quick-alert-close,.guest-drawer-close,.guest-drawer-secondary){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 .ws-app .guest-drawer-benefits span{background:var(--vb-surface-2)!important;color:var(--vb-muted)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 .ws-app .guest-drawer-primary{color:#fff!important}
html[data-vano-theme="black"] body.vano-live-v258 .ws-app .mapboxgl-popup-content{background:rgba(33,30,27,.99)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 .ws-app .mapboxgl-popup-content *{color:inherit!important}
html[data-vano-theme="black"] body.vano-live-v258 .ws-app .mapboxgl-popup-tip{border-top-color:var(--vb-surface)!important}
html[data-vano-theme="black"] body.vano-live-v258 .ws-app .mapboxgl-ctrl-group button{background:var(--vb-surface-2)!important;color:var(--vb-text)!important}
body.vano-live-v258 .map-mood-fade{transition:opacity .09s ease!important}

/* Profile page: authoritative dark skin for every nested profile surface. */
html[data-vano-theme="black"] body.vano-live-v258:has(.v72-profile-page){background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.profile-v72-hero,.profile-v72-card,.profile-v72-detail,.profile-v72-links,.profile-v108-quicknav a,.profile-v72-place,.profile-v72-nav-pref,.profile-v72-map-style,.profile-v72-accent,.profile-v72-fuel-list span,.profile-v72-person,.profile-v72-empty){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-live-v258 .profile-v72-detail summary{background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 .profile-v72-detail summary:hover{background:var(--vb-surface-2)!important}
html[data-vano-theme="black"] .profile-v72-detail-body.vano-live-v258{background:#1C1916!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.profile-v72-field input,.profile-v72-field select,.profile-v72-place input,.profile-v72-invite input){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.profile-v72-copy h1,.profile-v72-section-head h2,.profile-v72-subhead b,.profile-v72-detail-copy b,.profile-v72-place-head,.profile-v72-nav-copy b,.profile-v72-map-copy b,.profile-v72-person b,.profile-v72-links b,.profile-v108-quicknav b){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.profile-v72-copy p,.profile-v72-section-head p,.profile-v72-subcopy,.profile-v72-detail-copy small,.profile-v72-field>span,.profile-v72-nav-copy small,.profile-v72-map-copy small,.profile-v72-person small,.profile-v72-links small,.profile-v108-quicknav small){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.profile-v72-badge,.profile-v72-note,.profile-v72-nav-icon,.profile-v72-detail-icon,.profile-v72-card-icon,.profile-v72-link-icon,.profile-v108-quick-icon,.profile-v72-secondary){background:rgba(245,154,98,.10)!important;color:var(--vb-orange-2)!important;border-color:rgba(245,154,98,.18)!important}
html[data-vano-theme="black"] body.vano-live-v258 .profile-v72-switch{background:#4A433E!important}
html[data-vano-theme="black"] body.vano-live-v258 .profile-v72-switch:before{background:#FFFBF2!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.profile-v72-map-style:has(input:checked),.profile-v72-accent:has(input:checked),.profile-v72-fuel-list input:checked+span){background:rgba(245,154,98,.11)!important;border-color:rgba(245,154,98,.30)!important;color:var(--vb-orange-2)!important}

/* Onboarding and auth entry. */
html[data-vano-theme="black"] body.vano-live-v258 :is(.ob-shell,.ob-section,.choice label,.pref label,.night-card,.presence-consent,.privacy-note,.v63-entry-shell,.v63-entry-panel,.v63-auth-block,.auth-shell,.auth-pane,.sheet-card){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.ob-head h1,.ob-section-title b,.choice label b,.pref label b,.night-card b,.v63-entry-panel h1,.v63-auth-label span:first-child,.auth-copy h1,.sheet-head h2){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.ob-head p,.ob-section-title span,.choice label span,.pref label span,.night-card span,.v63-entry-lead,.auth-legal,.lead,.legal,.sheet-head p,.sheet-switch){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.ob-section .input,.ob-section .select,.sheet-input,.sheet-select,.field input,.input-shell,.auth-button.google,.auth-google,.auth-choice.secondary,.auth-guest){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.auth-button.email,.auth-choice.primary,.sheet-submit){color:#fff!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-auth-tagline{color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-auth-banner-frame{border-color:rgba(255,195,155,.16)!important;box-shadow:0 16px 42px rgba(0,0,0,.30)!important}
@media(max-width:760px){html[data-vano-theme="black"] body.vano-live-v258 :is(.auth-page[data-auth-page="login"],.auth-page[data-auth-page="login"] .auth-shell,.auth-page[data-auth-page="login"] .auth-pane,.vano-entry,.vano-entry .v63-entry-shell,.vano-entry .v63-entry-panel){background:var(--vb-bg)!important}}

/* Notifications/help/invites and generic content lists. */
html[data-vano-theme="black"] body.vano-live-v258 :is(.notif-shell,.notif-list,.faq-shell,.invite-shell){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.notif,.faq details,.invite-card){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.notif p,.notif small,.faq p,.faq small,.invite-card p,.invite-card small){color:var(--vb-muted)!important}

/* Admin pages: old admin-specific styles contained many late white !important rules. */
html[data-vano-theme="black"] body.vano-live-v258 :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76){background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76) :is([class*="card"],[class*="panel"],[class*="surface"],[class*="kpi"],[class*="metric"],[class*="tile"],[class*="row"],table){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76) :is(input,select,textarea){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76) :is(h1,h2,h3,h4,b,strong,label,th,td){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76) :is(p,small,.muted,span){border-color:var(--vb-line)!important}

/* Standalone shared/live pages when this sheet is linked there. */
html[data-vano-theme="black"] body.vano-live-v258 :is(.share-app,.map-unavailable,.app,.offline){background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.share-top,.route-panel,.share-app .metric,.share-app .route-actions button,.share-app .route-actions a:not(.primary),.live-trip-card){background:rgba(33,30,27,.97)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-live-v258 :is(.share-top span,.share-app .place small,.share-app .metric small,.share-app .copy-status,.share-app .route-panel p){color:var(--vb-muted)!important}


/* VANO v177 — remove the cramped mobile header shown in the screenshot.
   Signed-in phones already have the bottom dock, so the old wordmark/logout bar is redundant. */
@media(max-width:760px){
  body.vano-live-v258.vano-signed-in>.topbar,
body.vano-live-v258:has(.vano-entry)>.topbar,
body.vano-live-v258:has(.onboard)>.topbar{display:none!important}
  body.vano-live-v258.vano-signed-in{padding-top:0!important}
  body.vano-live-v258.vano-signed-in>.page,
body.vano-live-v258.vano-signed-in>.container.page{padding-top:max(14px,env(safe-area-inset-top))!important}
}

/* Desktop/tablet header stays restrained and does not duplicate the wordmark text. */
body.vano-live-v258 .topbar .brand>span{display:none!important}
body.vano-live-v258 .topbar .vano-brand-wordmark{width:132px!important;height:32px!important;max-width:132px!important;object-fit:contain!important;object-position:left center!important;filter:none!important}


/* VANO v178 — transparent auth branding.
   Removes the white/cropped banner frame entirely and uses high-resolution
   light/dark transparent assets so the identity feels native to the page. */
body.vano-live-v258 .vano-auth-banner-link{
  display:block!important;
  width:min(100%,560px)!important;
  max-width:560px!important;
  margin:0!important;
  padding:0!important;
  background:transparent!important;
  border:0!important;
  border-radius:0!important;
  box-shadow:none!important;
  overflow:visible!important;
  text-decoration:none!important;
}
body.vano-live-v258 .vano-auth-banner-clean{
  position:relative!important;
  display:block!important;
  width:100%!important;
  aspect-ratio:4.86/1!important;
  background:transparent!important;
  border:0!important;
  border-radius:0!important;
  box-shadow:none!important;
  overflow:visible!important;
  isolation:isolate!important;
}
body.vano-live-v258 .vano-auth-banner-clean:before{
  content:""!important;
  position:absolute!important;
  left:1.5%!important;
  top:17%!important;
  width:17%!important;
  aspect-ratio:1!important;
  border-radius:34%!important;
  background:rgba(245,154,98,.14)!important;
  filter:blur(22px)!important;
  transform:scale(.92)!important;
  z-index:-1!important;
  pointer-events:none!important;
}
body.vano-live-v258 .vano-auth-banner-clean .vano-auth-banner{
  position:absolute!important;
  inset:0!important;
  display:block!important;
  width:100%!important;
  height:100%!important;
  max-width:none!important;
  max-height:none!important;
  object-fit:contain!important;
  object-position:left center!important;
  transform:none!important;
  background:transparent!important;
  border:0!important;
  border-radius:0!important;
  box-shadow:none!important;
  image-rendering:auto!important;
  -webkit-font-smoothing:antialiased!important;
  filter:drop-shadow(0 10px 22px rgba(74,51,36,.08))!important;
}
body.vano-live-v258 .vano-auth-banner-dark{opacity:0!important;visibility:hidden!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-auth-banner-light{opacity:0!important;visibility:hidden!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-auth-banner-dark{opacity:1!important;visibility:visible!important;filter:drop-shadow(0 12px 28px rgba(0,0,0,.24))!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-auth-banner-clean:before{background:rgba(245,154,98,.18)!important;filter:blur(25px)!important}

/* Kill every legacy framed-banner style that could leak back in. */
body.vano-live-v258 .vano-auth-banner-frame{
  display:contents!important;
  width:auto!important;height:auto!important;aspect-ratio:auto!important;
  overflow:visible!important;border:0!important;border-radius:0!important;
  background:transparent!important;box-shadow:none!important;
}
body.vano-live-v258 .vano-auth-banner-frame .vano-auth-banner{position:static!important;transform:none!important}

/* Better auth hierarchy around the new lockup. */
body.vano-live-v258 .auth-page[data-auth-page="login"] .brand-row{
  position:relative!important;
  inset:auto!important;
  width:100%!important;
  min-height:0!important;
  margin:0 0 clamp(24px,4.5vh,48px)!important;
  padding:0!important;
  pointer-events:auto!important;
  display:block!important;
}
body.vano-live-v258 .auth-page[data-auth-page="login"] .auth-copy{
  margin:0!important;
  padding:0!important;
}
body.vano-live-v258 .vano-entry .v63-entry-brand{
  display:block!important;
  width:100%!important;
  margin:0 0 clamp(28px,5vh,52px)!important;
  padding:0!important;
}
body.vano-live-v258 .vano-entry .v63-entry-kicker{margin-top:0!important}

@media(max-width:760px){
  body.vano-live-v258 .vano-auth-banner-link{width:min(100%,390px)!important;max-width:390px!important}
  body.vano-live-v258 .vano-auth-banner-clean{aspect-ratio:4.86/1!important}
  body.vano-live-v258 .auth-page[data-auth-page="login"] .brand-row{margin-bottom:clamp(28px,6vh,48px)!important}
  body.vano-live-v258 .auth-page[data-auth-page="login"] .auth-pane{
    padding-top:max(24px,calc(env(safe-area-inset-top) + 16px))!important;
  }
  body.vano-live-v258 .vano-entry .v63-entry-brand{margin-bottom:34px!important}
}
@media(max-width:380px){
  body.vano-live-v258 .vano-auth-banner-link{width:min(100%,344px)!important}
  body.vano-live-v258 .auth-page[data-auth-page="login"] .brand-row{margin-bottom:26px!important}
  body.vano-live-v258 .vano-entry .v63-entry-brand{margin-bottom:28px!important}
}



/* ===== static/vano-login-startup.css ===== */
body.vano-auth-startup{
  --vano:#F59A62;
  --vano-strong:#E77842;
  --vano-soft:#FFF1E8;
  --ink:#201C19;
  --muted:#7C746E;
  --muted-2:#A09994;
  --surface:#FFFFFF;
  --surface-soft:#F8F6F4;
  --line:rgba(38,32,28,.09);
  --shadow:0 28px 80px rgba(39,31,26,.12),0 4px 18px rgba(39,31,26,.05);
  --ease:cubic-bezier(.2,.82,.2,1);
}

body.vano-auth-startup *{box-sizing:border-box}
html body.vano-auth-startup,
body.vano-auth-startup{margin:0;min-height:100%;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
html body.vano-auth-startup{background:#F4F1EE}
body.vano-auth-startup{color:var(--ink);background:#F4F1EE;overflow-x:hidden}
body.vano-auth-startup button,
body.vano-auth-startup input{font:inherit}
body.vano-auth-startup a{-webkit-tap-highlight-color:transparent}
body.vano-auth-startup button{-webkit-tap-highlight-color:transparent}

body.vano-auth-startup .vano-auth-startup{
  min-height:100svh;
  position:relative;
  display:grid;
  place-items:center;
  padding:max(72px,calc(env(safe-area-inset-top) + 58px)) max(22px,env(safe-area-inset-right)) max(28px,env(safe-area-inset-bottom)) max(22px,env(safe-area-inset-left));
  isolation:isolate;
}

body.vano-auth-startup .startup-ambient{position:fixed;inset:0;z-index:-3;overflow:hidden;background:linear-gradient(145deg,#F8F6F3 0%,#F3EFEB 54%,#EEEAE6 100%)}
body.vano-auth-startup .ambient-orb{position:absolute;border-radius:999px;filter:blur(1px);pointer-events:none}
body.vano-auth-startup .ambient-orb-a{width:min(42vw,590px);aspect-ratio:1;left:-14vw;top:-20vw;background:radial-gradient(circle,rgba(245,154,98,.17),rgba(245,154,98,0) 68%)}
body.vano-auth-startup .ambient-orb-b{width:min(46vw,660px);aspect-ratio:1;right:-16vw;bottom:-24vw;background:radial-gradient(circle,rgba(245,154,98,.10),rgba(245,154,98,0) 70%)}
body.vano-auth-startup .ambient-noise{position:absolute;inset:0;opacity:.19;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.055'/%3E%3C/svg%3E")}

body.vano-auth-startup .startup-topbar{position:fixed;z-index:30;top:max(18px,env(safe-area-inset-top));left:max(22px,env(safe-area-inset-left));right:max(22px,env(safe-area-inset-right));display:flex;align-items:center;justify-content:space-between;pointer-events:none}
body.vano-auth-startup .startup-wordmark,
body.vano-auth-startup .startup-theme{pointer-events:auto}
body.vano-auth-startup .startup-wordmark{display:inline-flex;align-items:center;width:174px;height:38px;text-decoration:none}
body.vano-auth-startup .startup-wordmark img{display:block;width:auto;height:30px;max-width:174px;object-fit:contain;object-position:left center;opacity:0;transition:opacity .16s ease}
body.vano-auth-startup .startup-wordmark img.is-ready{opacity:1}
body.vano-auth-startup .startup-theme{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.72);color:#625B56;box-shadow:0 8px 24px rgba(44,35,30,.06);backdrop-filter:blur(18px);cursor:pointer;transition:transform .18s var(--ease),background .2s ease,border-color .2s ease}
body.vano-auth-startup .startup-theme:hover{transform:translateY(-1px);background:#fff}
body.vano-auth-startup .startup-theme:active{transform:scale(.96)}
body.vano-auth-startup .startup-theme svg{position:absolute;width:18px;height:18px;transition:opacity .18s ease,transform .24s var(--ease)}
body.vano-auth-startup .startup-theme .theme-moon{opacity:0;transform:rotate(-16deg) scale(.8)}

body.vano-auth-startup .startup-flashes{position:fixed;z-index:40;top:max(70px,calc(env(safe-area-inset-top) + 60px));left:50%;width:min(430px,calc(100vw - 32px));transform:translateX(-50%);display:grid;gap:8px;pointer-events:none}
body.vano-auth-startup .startup-flash{display:flex;align-items:center;gap:10px;padding:12px 14px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.93);box-shadow:0 12px 36px rgba(35,29,25,.10);backdrop-filter:blur(16px);color:#5D5651;font-size:11px;font-weight:750;animation:flashIn .34s var(--ease) both}
body.vano-auth-startup .startup-flash-dot{width:8px;height:8px;flex:none;border-radius:50%;background:#8B817A}
body.vano-auth-startup .startup-flash.danger .startup-flash-dot{background:#D75B4B;box-shadow:0 0 0 5px rgba(215,91,75,.10)}
body.vano-auth-startup .startup-flash.success .startup-flash-dot{background:#45A16B;box-shadow:0 0 0 5px rgba(69,161,107,.10)}

body.vano-auth-startup .startup-shell{
  width:min(1060px,100%);
  min-height:660px;
  display:grid;
  grid-template-columns:minmax(0,1.02fr) minmax(380px,.98fr);
  overflow:hidden;
  border:1px solid rgba(38,32,28,.08);
  border-radius:32px;
  background:rgba(255,255,255,.94);
  box-shadow:var(--shadow);
  backdrop-filter:blur(18px);
  animation:shellIn .62s var(--ease) both;
}

body.vano-auth-startup .startup-auth{min-width:0;display:flex;align-items:stretch;background:rgba(255,255,255,.84)}
body.vano-auth-startup .startup-auth-inner{width:100%;min-height:100%;display:flex;flex-direction:column;padding:clamp(42px,5.4vw,70px) clamp(38px,5.8vw,72px) 28px}
body.vano-auth-startup .startup-flow{width:min(100%,470px);margin:auto 0;view-transition-name:auth-stage}
body.vano-auth-startup .startup-stage{animation:stageIn .38s var(--ease) both}
body.vano-auth-startup .startup-stage[hidden]{display:none!important}

body.vano-auth-startup .startup-copy{max-width:450px}
body.vano-auth-startup .startup-eyebrow{display:flex;align-items:center;gap:8px;color:#B96038;font-size:9px;font-weight:900;letter-spacing:.13em;text-transform:uppercase}
body.vano-auth-startup .startup-eyebrow>span{width:20px;height:2px;border-radius:999px;background:var(--vano)}
body.vano-auth-startup .startup-copy h1,
body.vano-auth-startup .startup-copy h2{margin:14px 0 13px;color:#25201D;line-height:.94;letter-spacing:-3.25px;font-weight:800}
body.vano-auth-startup .startup-copy h1{font-size:clamp(48px,5.1vw,66px)}
body.vano-auth-startup .startup-copy h2{font-size:clamp(44px,4.6vw,60px)}
body.vano-auth-startup .startup-copy h1 em{font-style:normal;color:var(--vano-strong)}
body.vano-auth-startup .startup-copy p{margin:0;max-width:395px;color:var(--muted);font-size:13px;line-height:1.6;font-weight:520}

body.vano-auth-startup .startup-status{display:flex;align-items:center;gap:9px;margin-top:19px;padding:10px 12px;border:1px solid rgba(64,153,102,.15);border-radius:13px;background:#F1F9F4;color:#347650;font-size:10.5px;font-weight:800}
body.vano-auth-startup .startup-status>span{width:22px;height:22px;display:grid;place-items:center;border-radius:50%;background:#DCEFE3}
body.vano-auth-startup .startup-status p{margin:0}

body.vano-auth-startup .startup-actions{display:grid;gap:10px;margin-top:30px}
body.vano-auth-startup .startup-primary,
body.vano-auth-startup .startup-secondary,
body.vano-auth-startup .startup-submit{width:100%;min-height:58px;border-radius:17px;text-decoration:none;position:relative;overflow:hidden;transition:transform .18s var(--ease),box-shadow .2s ease,border-color .2s ease,background .2s ease,opacity .2s ease}
body.vano-auth-startup .startup-primary{display:grid;grid-template-columns:24px 1fr 22px;align-items:center;gap:12px;padding:0 18px;border:1px solid rgba(35,30,26,.09);background:#fff;color:#26211E;box-shadow:0 9px 25px rgba(37,30,25,.065);font-size:12.5px;font-weight:860}
body.vano-auth-startup .startup-primary:before,
body.vano-auth-startup .startup-submit:before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(105deg,transparent 15%,rgba(255,255,255,.42) 48%,transparent 75%);transform:translateX(-115%);transition:transform .55s var(--ease)}
body.vano-auth-startup .startup-primary:hover:before,
body.vano-auth-startup .startup-submit:hover:before{transform:translateX(115%)}
body.vano-auth-startup .startup-primary:hover{transform:translateY(-1px);border-color:rgba(245,154,98,.25);box-shadow:0 14px 30px rgba(37,30,25,.085)}
body.vano-auth-startup .startup-primary:active,
body.vano-auth-startup .startup-secondary:active,
body.vano-auth-startup .startup-submit:active{transform:scale(.985)}
body.vano-auth-startup .startup-primary.is-disabled{display:flex;justify-content:center;color:#AAA29D;background:#F6F4F2;box-shadow:none;pointer-events:none}
body.vano-auth-startup .startup-google-mark{width:24px;height:24px;display:grid;place-items:center}
body.vano-auth-startup .startup-google-mark svg{width:21px;height:21px}
body.vano-auth-startup .startup-primary-label{text-align:center}
body.vano-auth-startup .startup-arrow{display:inline-flex;align-items:center;justify-content:center;font-style:normal;font-size:17px;line-height:1;transition:transform .2s var(--ease)}
body.vano-auth-startup .startup-primary:hover .startup-arrow,
body.vano-auth-startup .startup-secondary:hover .startup-arrow,
body.vano-auth-startup .startup-submit:hover .startup-arrow{transform:translateX(3px)}

body.vano-auth-startup .startup-secondary{display:grid;grid-template-columns:40px 1fr 22px;align-items:center;gap:12px;padding:7px 17px;border:1px solid rgba(35,30,26,.075);background:var(--surface-soft);color:#302A26;text-align:left;cursor:pointer}
body.vano-auth-startup .startup-secondary:hover{transform:translateY(-1px);background:#fff;border-color:rgba(245,154,98,.22)}
body.vano-auth-startup .startup-secondary-icon{width:40px;height:40px;display:grid;place-items:center;border:1px solid rgba(35,30,26,.06);border-radius:13px;background:#fff;color:#B95E36}
body.vano-auth-startup .startup-secondary-icon svg{width:18px;height:18px}
body.vano-auth-startup .startup-secondary-copy{display:grid;gap:2px;min-width:0}
body.vano-auth-startup .startup-secondary-copy b{font-size:12px;font-weight:850}
body.vano-auth-startup .startup-secondary-copy small{color:#918983;font-size:9.5px;font-weight:650}
body.vano-auth-startup .startup-secondary .startup-arrow{color:#AAA19B}

body.vano-auth-startup .startup-account-row{display:flex;align-items:center;justify-content:center;gap:5px;margin-top:17px;color:#99908A;font-size:10.5px;font-weight:650}
body.vano-auth-startup .startup-account-row a,
body.vano-auth-startup .startup-email-register a{color:#A95029;font-weight:900;text-decoration:none}
body.vano-auth-startup .startup-account-row a:hover,
body.vano-auth-startup .startup-email-register a:hover{text-decoration:underline;text-underline-offset:3px}
body.vano-auth-startup .startup-guest{width:max-content;margin:28px auto 0;display:flex;align-items:center;gap:7px;color:#716963;font-size:10.5px;font-weight:820;text-decoration:none;transition:color .18s ease,transform .18s var(--ease)}
body.vano-auth-startup .startup-guest:hover{color:#A6532F;transform:translateY(-1px)}
body.vano-auth-startup .startup-guest svg{width:15px;height:15px;transition:transform .2s var(--ease)}
body.vano-auth-startup .startup-guest:hover svg{transform:translateX(2px)}

body.vano-auth-startup .startup-back{display:inline-flex;align-items:center;gap:5px;margin:0 0 32px -7px;padding:7px;border:0;border-radius:11px;background:transparent;color:#766E68;cursor:pointer;font-size:10.5px;font-weight:800;transition:background .18s ease,color .18s ease,transform .18s var(--ease)}
body.vano-auth-startup .startup-back:hover{background:#F6F3F0;color:#A6532F;transform:translateX(-2px)}
body.vano-auth-startup .startup-back svg{width:18px;height:18px}
body.vano-auth-startup .startup-copy-email{margin-bottom:26px}
body.vano-auth-startup .startup-email-form{display:grid;gap:15px}
body.vano-auth-startup .startup-field{display:grid;gap:7px}
body.vano-auth-startup .startup-field-label{padding-left:2px;color:#655D58;font-size:9.5px;font-weight:850}
body.vano-auth-startup .startup-field-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
body.vano-auth-startup .startup-field-head a{color:#9A5B3F;font-size:9px;font-weight:850;text-decoration:none}
body.vano-auth-startup .startup-field-head a:hover{text-decoration:underline;text-underline-offset:3px}
body.vano-auth-startup .startup-input-wrap{position:relative;display:flex;align-items:center;height:54px;border:1px solid rgba(35,30,26,.095);border-radius:15px;background:#fff;transition:border-color .18s ease,box-shadow .18s ease,background .18s ease}
body.vano-auth-startup .startup-input-wrap:focus-within{border-color:rgba(245,154,98,.66);box-shadow:0 0 0 4px rgba(245,154,98,.11)}
body.vano-auth-startup .startup-input-wrap>svg{position:absolute;left:14px;width:18px;height:18px;color:#9D938C;pointer-events:none}
body.vano-auth-startup .startup-input-wrap input{width:100%;height:100%;padding:0 14px 0 44px;border:0;outline:0;background:transparent;color:#26211E;font-size:12px;font-weight:700}
body.vano-auth-startup .startup-input-wrap input::placeholder{color:#B0A8A2;font-weight:600}
body.vano-auth-startup .startup-password-wrap input{padding-right:52px}
body.vano-auth-startup .startup-password-toggle{position:absolute;right:7px;width:39px;height:39px;display:grid;place-items:center;border:0;border-radius:11px;background:#F6F3F0;color:#817770;cursor:pointer;transition:background .18s ease,color .18s ease,transform .18s var(--ease)}
body.vano-auth-startup .startup-password-toggle:hover{background:#F0ECE8;color:#A6532F}
body.vano-auth-startup .startup-password-toggle:active{transform:scale(.94)}
body.vano-auth-startup .startup-password-toggle svg{position:absolute;width:17px;height:17px}
body.vano-auth-startup .startup-password-toggle .eye-closed{display:none}
body.vano-auth-startup .startup-password-toggle.is-visible .eye-open{display:none}
body.vano-auth-startup .startup-password-toggle.is-visible .eye-closed{display:block}
body.vano-auth-startup .startup-submit{min-height:57px;margin-top:2px;display:flex;align-items:center;justify-content:center;gap:10px;border:0;background:linear-gradient(135deg,var(--vano),var(--vano-strong));color:#fff;box-shadow:0 14px 31px rgba(231,120,66,.23);font-size:12px;font-weight:900;cursor:pointer}
body.vano-auth-startup .startup-submit:hover{transform:translateY(-1px);box-shadow:0 17px 34px rgba(231,120,66,.28)}
body.vano-auth-startup .startup-email-register{margin:17px 0 0;text-align:center;color:#99908A;font-size:10.5px;font-weight:650}

body.vano-auth-startup .startup-primary.is-loading,
body.vano-auth-startup .startup-submit.is-loading{pointer-events:none;opacity:.8}
body.vano-auth-startup .startup-primary.is-loading .startup-google-mark,
body.vano-auth-startup .startup-primary.is-loading .startup-arrow,
body.vano-auth-startup .startup-submit.is-loading .startup-arrow{display:none}
body.vano-auth-startup .startup-primary.is-loading{grid-template-columns:1fr auto}
body.vano-auth-startup .startup-primary.is-loading .startup-primary-label{text-align:right}
body.vano-auth-startup .startup-primary.is-loading:after,
body.vano-auth-startup .startup-submit.is-loading:after{content:"";width:15px;height:15px;border:2px solid currentColor;border-right-color:transparent;border-radius:50%;animation:spin .7s linear infinite}
body.vano-auth-startup .startup-submit:disabled{cursor:default}

body.vano-auth-startup .startup-legal{margin-top:auto;padding-top:26px;color:#AAA19B;font-size:8.5px;line-height:1.55;text-align:left}
body.vano-auth-startup .startup-legal a{color:#817872;text-decoration:underline;text-decoration-color:rgba(129,120,114,.35);text-underline-offset:2px}

body.vano-auth-startup .startup-visual{position:relative;min-width:0;overflow:hidden;background:#25211E;color:#fff;isolation:isolate}
body.vano-auth-startup .visual-grid{position:absolute;inset:0;opacity:.24;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:32px 32px;mask-image:linear-gradient(to bottom,transparent 0%,#000 18%,#000 82%,transparent 100%)}
body.vano-auth-startup .visual-glow{position:absolute;width:440px;height:440px;right:-180px;top:-120px;border-radius:50%;background:radial-gradient(circle,rgba(245,154,98,.34),rgba(245,154,98,0) 69%)}
body.vano-auth-startup .visual-head{position:absolute;z-index:5;top:31px;left:32px;right:32px;display:flex;align-items:center;justify-content:space-between;color:rgba(255,255,255,.46);font-size:8px;font-weight:850;letter-spacing:.11em;text-transform:uppercase}
body.vano-auth-startup .visual-live{display:flex;align-items:center;gap:7px;color:rgba(255,255,255,.72)}
body.vano-auth-startup .visual-live i{width:7px;height:7px;border-radius:50%;background:var(--vano);box-shadow:0 0 0 0 rgba(245,154,98,.4);animation:livePulse 2.2s ease-out infinite}
body.vano-auth-startup .visual-map{position:absolute;inset:70px -5px 126px;transform:perspective(900px) rotateX(2deg) rotateZ(-2deg);transform-origin:center;transition:transform .35s var(--ease)}
body.vano-auth-startup .visual-roads,
body.vano-auth-startup .visual-route{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
body.vano-auth-startup .visual-roads path{fill:none;stroke:rgba(255,255,255,.085);stroke-width:1.4;vector-effect:non-scaling-stroke}
body.vano-auth-startup .route-halo,
body.vano-auth-startup .route-line{fill:none;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke}
body.vano-auth-startup .route-halo{stroke:rgba(245,154,98,.15);stroke-width:16}
body.vano-auth-startup .route-line{stroke:var(--vano);stroke-width:4.4;stroke-dasharray:7 10;animation:routeFlow 4.5s linear infinite}
body.vano-auth-startup .visual-pin{position:absolute;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.10);box-shadow:0 10px 24px rgba(0,0,0,.18);backdrop-filter:blur(9px)}
body.vano-auth-startup .visual-pin>span{width:8px;height:8px;border-radius:50%}
body.vano-auth-startup .visual-pin-origin{left:11.5%;bottom:11.5%}
body.vano-auth-startup .visual-pin-origin>span{background:#fff}
body.vano-auth-startup .visual-pin-destination{right:11%;top:7.3%}
body.vano-auth-startup .visual-pin-destination>span{background:var(--vano)}
body.vano-auth-startup .visual-user{position:absolute;left:49.4%;top:54%;width:27px;height:27px;display:grid;place-items:center}
body.vano-auth-startup .visual-user-ring{position:absolute;inset:0;border-radius:50%;background:rgba(245,154,98,.17);animation:userPulse 2.2s ease-out infinite}
body.vano-auth-startup .visual-user-dot{position:relative;width:12px;height:12px;border:3px solid #fff;border-radius:50%;background:var(--vano);box-shadow:0 6px 14px rgba(0,0,0,.25)}
body.vano-auth-startup .visual-card{position:absolute;border:1px solid rgba(255,255,255,.11);background:rgba(31,27,24,.72);box-shadow:0 17px 36px rgba(0,0,0,.20);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
body.vano-auth-startup .visual-route-card{left:11%;bottom:5%;width:min(278px,68%);padding:17px;border-radius:20px;animation:floatCard 5.5s ease-in-out infinite}
body.vano-auth-startup .visual-route-card>div:first-child{display:flex;align-items:flex-end;justify-content:space-between;gap:10px}
body.vano-auth-startup .visual-route-card small{color:rgba(255,255,255,.48);font-size:7.5px;font-weight:900;letter-spacing:.12em}
body.vano-auth-startup .visual-route-card b{font-size:24px;letter-spacing:-1px}
body.vano-auth-startup .visual-route-card p{margin:9px 0 0;color:rgba(255,255,255,.58);font-size:9px;line-height:1.45}
body.vano-auth-startup .visual-pill{position:absolute;right:14px;top:48px;padding:5px 8px;border-radius:999px;background:rgba(245,154,98,.13);color:#FFB487;font-size:7.5px;font-weight:850}
body.vano-auth-startup .visual-recalc-card{right:7%;top:29%;display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:16px;animation:recalcInOut 8s var(--ease) infinite}
body.vano-auth-startup .visual-recalc-icon{width:30px;height:30px;display:grid;place-items:center;border-radius:10px;background:rgba(245,154,98,.12);color:#FFAA78}
body.vano-auth-startup .visual-recalc-icon svg{width:15px;height:15px}
body.vano-auth-startup .visual-recalc-card div{display:grid;gap:2px}
body.vano-auth-startup .visual-recalc-card b{font-size:9.5px}
body.vano-auth-startup .visual-recalc-card small{color:rgba(255,255,255,.47);font-size:7.5px}
body.vano-auth-startup .visual-footer{position:absolute;z-index:5;left:32px;right:32px;bottom:31px}
body.vano-auth-startup .visual-footer p{margin:0 0 8px;color:rgba(255,255,255,.88);font-size:22px;line-height:1.06;letter-spacing:-.8px;font-weight:640}
body.vano-auth-startup .visual-footer p strong{font-weight:900;color:#fff}
body.vano-auth-startup .visual-footer>span{color:rgba(255,255,255,.42);font-size:8.5px;font-weight:650}

body.vano-auth-startup .startup-primary:focus-visible,
body.vano-auth-startup .startup-secondary:focus-visible,
body.vano-auth-startup .startup-submit:focus-visible,
body.vano-auth-startup .startup-back:focus-visible,
body.vano-auth-startup .startup-theme:focus-visible,
body.vano-auth-startup .startup-guest:focus-visible,
body.vano-auth-startup .startup-password-toggle:focus-visible,
body.vano-auth-startup .startup-account-row a:focus-visible,
body.vano-auth-startup .startup-field-head a:focus-visible{outline:3px solid rgba(245,154,98,.23);outline-offset:2px}
body.vano-auth-startup .startup-input-wrap input:focus-visible{outline:none}

html[data-vano-theme="black"] body.vano-auth-startup{background:#151311;color-scheme:dark}
html[data-vano-theme="black"] body.vano-auth-startup{background:#151311}
html[data-vano-theme="black"] body.vano-auth-startup .startup-ambient{background:linear-gradient(145deg,#171512,#1C1917 54%,#12100F 100%)}
html[data-vano-theme="black"] body.vano-auth-startup .ambient-orb-a{background:radial-gradient(circle,rgba(245,154,98,.10),rgba(245,154,98,0) 68%)}
html[data-vano-theme="black"] body.vano-auth-startup .ambient-orb-b{background:radial-gradient(circle,rgba(245,154,98,.055),rgba(245,154,98,0) 70%)}
html[data-vano-theme="black"] body.vano-auth-startup .startup-theme{background:rgba(34,30,27,.76);border-color:rgba(255,255,255,.08);color:#EAE1DB;box-shadow:none}
html[data-vano-theme="black"] body.vano-auth-startup .startup-theme:hover{background:#292521}
html[data-vano-theme="black"] body.vano-auth-startup .startup-theme .theme-sun{opacity:0;transform:rotate(16deg) scale(.8)}
html[data-vano-theme="black"] body.vano-auth-startup .startup-theme .theme-moon{opacity:1;transform:none}
html[data-vano-theme="black"] body.vano-auth-startup .startup-shell{border-color:rgba(255,255,255,.07);background:rgba(30,27,24,.96);box-shadow:0 30px 90px rgba(0,0,0,.34)}
html[data-vano-theme="black"] body.vano-auth-startup .startup-auth{background:rgba(30,27,24,.94)}
html[data-vano-theme="black"] body.vano-auth-startup .startup-copy h1,
html[data-vano-theme="black"] body.vano-auth-startup .startup-copy h2{color:#FFF8F2}
html[data-vano-theme="black"] body.vano-auth-startup .startup-copy p{color:#AAA09A}
html[data-vano-theme="black"] body.vano-auth-startup .startup-primary,
html[data-vano-theme="black"] body.vano-auth-startup .startup-input-wrap{background:#282420;border-color:rgba(255,255,255,.08);color:#FFF8F2;box-shadow:none}
html[data-vano-theme="black"] body.vano-auth-startup .startup-primary:hover{border-color:rgba(245,154,98,.22);background:#2C2824}
html[data-vano-theme="black"] body.vano-auth-startup .startup-secondary{background:#24211E;border-color:rgba(255,255,255,.07);color:#F8F0EB}
html[data-vano-theme="black"] body.vano-auth-startup .startup-secondary:hover{background:#2A2622;border-color:rgba(245,154,98,.22)}
html[data-vano-theme="black"] body.vano-auth-startup .startup-secondary-icon,
html[data-vano-theme="black"] body.vano-auth-startup .startup-password-toggle{background:#302B27;border-color:rgba(255,255,255,.06)}
html[data-vano-theme="black"] body.vano-auth-startup .startup-account-row,
html[data-vano-theme="black"] body.vano-auth-startup .startup-email-register,
html[data-vano-theme="black"] body.vano-auth-startup .startup-guest{color:#9F9690}
html[data-vano-theme="black"] body.vano-auth-startup .startup-back:hover{background:#26221F}
html[data-vano-theme="black"] body.vano-auth-startup .startup-field-label{color:#BBB1AA}
html[data-vano-theme="black"] body.vano-auth-startup .startup-input-wrap input{color:#FFF8F2}
html[data-vano-theme="black"] body.vano-auth-startup .startup-input-wrap input::placeholder{color:#756E69}
html[data-vano-theme="black"] body.vano-auth-startup .startup-password-toggle{color:#AAA09A}
html[data-vano-theme="black"] body.vano-auth-startup .startup-password-toggle:hover{background:#37312C;color:#FFC09A}
html[data-vano-theme="black"] body.vano-auth-startup .startup-legal{color:#756E69}
html[data-vano-theme="black"] body.vano-auth-startup .startup-legal a{color:#A59B94}
html[data-vano-theme="black"] body.vano-auth-startup .startup-flash{background:rgba(40,36,32,.95);border-color:rgba(255,255,255,.08);color:#E1D8D2}
html[data-vano-theme="black"] body.vano-auth-startup .startup-status{background:rgba(54,125,83,.10);border-color:rgba(91,177,124,.15)}

body.vano-auth-startup ::view-transition-old(auth-stage){animation:vtOut .18s ease both}
body.vano-auth-startup ::view-transition-new(auth-stage){animation:vtIn .34s var(--ease) both}

@media(min-width:1180px){
  body.vano-auth-startup .startup-shell{width:min(1120px,100%);min-height:690px;grid-template-columns:minmax(0,1.03fr) minmax(420px,.97fr)}
  body.vano-auth-startup .startup-auth-inner{padding-left:74px;padding-right:74px}
  body.vano-auth-startup .visual-footer p{font-size:24px}
}

@media(min-width:720px) and (max-width:960px){
  body.vano-auth-startup .vano-auth-startup{padding-left:18px;padding-right:18px}
  body.vano-auth-startup .startup-shell{grid-template-columns:minmax(0,1fr) 310px;min-height:630px;border-radius:28px}
  body.vano-auth-startup .startup-auth-inner{padding:42px 36px 26px}
  body.vano-auth-startup .startup-copy h1{font-size:50px}
  body.vano-auth-startup .startup-copy h2{font-size:46px}
  body.vano-auth-startup .visual-head,
body.vano-auth-startup .visual-footer{left:24px;right:24px}
  body.vano-auth-startup .visual-footer p{font-size:19px}
  body.vano-auth-startup .visual-route-card{left:7%;width:75%}
  body.vano-auth-startup .visual-recalc-card{right:4%;transform:scale(.9);transform-origin:right center}
}

@media(max-width:719px){
  html body.vano-auth-startup,
body.vano-auth-startup{background:#fff}
  body.vano-auth-startup .vano-auth-startup{display:block;min-height:100svh;padding:0;background:#fff}
  body.vano-auth-startup .startup-ambient{display:none}
  body.vano-auth-startup .startup-topbar{top:max(13px,env(safe-area-inset-top));left:max(17px,env(safe-area-inset-left));right:max(14px,env(safe-area-inset-right))}
  body.vano-auth-startup .startup-wordmark{width:162px;height:42px}
  body.vano-auth-startup .startup-wordmark img{height:29px;max-width:162px}
  body.vano-auth-startup .startup-theme{width:40px;height:40px;border-radius:13px;box-shadow:none;background:rgba(249,247,245,.92)}
  body.vano-auth-startup .startup-shell{width:100%;min-height:100svh;display:block;border:0;border-radius:0;background:#fff;box-shadow:none;backdrop-filter:none;animation:none}
  body.vano-auth-startup .startup-auth{min-height:100svh;background:#fff}
  body.vano-auth-startup .startup-auth-inner{min-height:100svh;padding:max(95px,calc(env(safe-area-inset-top) + 82px)) max(18px,env(safe-area-inset-right)) max(22px,calc(env(safe-area-inset-bottom) + 16px)) max(18px,env(safe-area-inset-left))}
  body.vano-auth-startup .startup-flow{width:100%;margin:auto 0}
  body.vano-auth-startup .startup-copy{max-width:100%}
  body.vano-auth-startup .startup-copy h1{font-size:clamp(47px,13.2vw,60px);letter-spacing:-3px}
  body.vano-auth-startup .startup-copy h2{font-size:clamp(45px,12vw,55px);letter-spacing:-2.8px}
  body.vano-auth-startup .startup-copy p{max-width:355px;font-size:12.5px}
  body.vano-auth-startup .startup-actions{margin-top:29px}
  body.vano-auth-startup .startup-primary,
body.vano-auth-startup .startup-secondary,
body.vano-auth-startup .startup-submit{min-height:58px;border-radius:17px}
  body.vano-auth-startup .startup-account-row{margin-top:16px}
  body.vano-auth-startup .startup-guest{margin-top:26px}
  body.vano-auth-startup .startup-legal{padding-top:30px;text-align:center;font-size:8px}
  body.vano-auth-startup .startup-visual{display:none}
  body.vano-auth-startup .startup-back{margin-bottom:30px}
  body.vano-auth-startup .startup-copy-email{margin-bottom:25px}
  body.vano-auth-startup .startup-email-form{gap:14px}
  body.vano-auth-startup .startup-input-wrap{height:55px}
  body.vano-auth-startup .startup-flashes{top:max(68px,calc(env(safe-area-inset-top) + 58px));width:calc(100vw - 28px)}
  html[data-vano-theme="black"] body.vano-auth-startup,
html[data-vano-theme="black"] body.vano-auth-startup{background:#1E1B18}
  html[data-vano-theme="black"] body.vano-auth-startup .startup-shell,
html[data-vano-theme="black"] body.vano-auth-startup .startup-auth{background:#1E1B18}
}

@media(max-width:390px){
  body.vano-auth-startup .startup-auth-inner{padding-left:15px;padding-right:15px;padding-top:max(88px,calc(env(safe-area-inset-top) + 76px))}
  body.vano-auth-startup .startup-copy h1{font-size:43px;letter-spacing:-2.6px}
  body.vano-auth-startup .startup-copy h2{font-size:42px}
  body.vano-auth-startup .startup-copy p{font-size:12px}
  body.vano-auth-startup .startup-secondary-copy small{font-size:9px}
  body.vano-auth-startup .startup-primary,
body.vano-auth-startup .startup-secondary,
body.vano-auth-startup .startup-submit{min-height:56px}
}

@media(max-height:700px) and (max-width:719px){
  body.vano-auth-startup .startup-auth-inner{padding-top:max(79px,calc(env(safe-area-inset-top) + 68px));padding-bottom:max(14px,env(safe-area-inset-bottom))}
  body.vano-auth-startup .startup-copy h1{font-size:42px;margin-top:10px;margin-bottom:9px}
  body.vano-auth-startup .startup-copy h2{font-size:40px;margin-top:10px;margin-bottom:9px}
  body.vano-auth-startup .startup-copy p{font-size:11.5px;line-height:1.45}
  body.vano-auth-startup .startup-actions{margin-top:20px;gap:8px}
  body.vano-auth-startup .startup-primary,
body.vano-auth-startup .startup-secondary,
body.vano-auth-startup .startup-submit{min-height:53px}
  body.vano-auth-startup .startup-account-row{margin-top:12px}
  body.vano-auth-startup .startup-guest{margin-top:18px}
  body.vano-auth-startup .startup-legal{padding-top:18px}
  body.vano-auth-startup .startup-back{margin-bottom:18px}
  body.vano-auth-startup .startup-copy-email{margin-bottom:18px}
  body.vano-auth-startup .startup-email-form{gap:10px}
  body.vano-auth-startup .startup-input-wrap{height:50px}
}

@media(prefers-reduced-motion:reduce){
  body.vano-auth-startup *,
body.vano-auth-startup *:before,
body.vano-auth-startup *:after{scroll-behavior:auto!important;animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}
}

@keyframes shellIn{from{opacity:0;transform:translateY(13px) scale(.994)}to{opacity:1;transform:none}}
@keyframes stageIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes flashIn{from{opacity:0;transform:translateY(-8px) scale(.98)}to{opacity:1;transform:none}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes routeFlow{to{stroke-dashoffset:-85}}
@keyframes floatCard{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
@keyframes userPulse{0%{transform:scale(.6);opacity:.8}75%,100%{transform:scale(1.8);opacity:0}}
@keyframes livePulse{0%{box-shadow:0 0 0 0 rgba(245,154,98,.38)}75%,100%{box-shadow:0 0 0 9px rgba(245,154,98,0)}}
@keyframes recalcInOut{0%,16%{opacity:0;transform:translateY(7px) scale(.97)}24%,72%{opacity:1;transform:none}82%,100%{opacity:0;transform:translateY(-5px) scale(.98)}}
@keyframes vtOut{to{opacity:0;transform:translateX(-12px)}}
@keyframes vtIn{from{opacity:0;transform:translateX(12px)}}


/* ===== static/vano-register.css ===== */
/* VANO MAPS V340 — simplified account creation */
body.vano-route-register .topbar,
body.vano-route-register .mobile-dock,
body.vano-route-register footer{display:none!important}
body.vano-route-register *{box-sizing:border-box}
html body.vano-route-register,
body.vano-route-register{min-height:100%;margin:0}
body.vano-route-register{padding-bottom:0!important;background:#f4f3f1;color:#24211f}
body.vano-route-register .vano-register-v340{min-height:100svh;padding:14px;background:radial-gradient(circle at 12% 4%,rgba(245,154,98,.16),transparent 25%),#f4f3f1}
body.vano-route-register .register-shell{width:min(1180px,100%);min-height:calc(100svh - 28px);margin:0 auto;display:grid;grid-template-columns:minmax(0,.92fr) minmax(420px,1.08fr);overflow:hidden;border:1px solid rgba(53,46,41,.08);border-radius:34px;background:#fff;box-shadow:0 28px 80px rgba(52,46,42,.10)}
body.vano-route-register .register-panel{min-width:0;padding:clamp(28px,5vw,68px);display:flex;flex-direction:column}
body.vano-route-register .register-brand{display:inline-flex;width:max-content;max-width:180px;text-decoration:none}
body.vano-route-register .register-brand .vano-adaptive-brand{display:flex;align-items:center}body.vano-route-register .register-brand img{width:auto;height:31px;max-width:170px;object-fit:contain;object-position:left}
body.vano-route-register .register-copy{margin-top:clamp(38px,7vh,78px);max-width:560px}body.vano-route-register .register-kicker{display:inline-flex;align-items:center;gap:7px;color:#c96334;font-size:10px;font-weight:900;letter-spacing:.11em;text-transform:uppercase}body.vano-route-register .register-copy h1{margin:13px 0 0;font-size:clamp(40px,5.1vw,66px);line-height:.96;letter-spacing:-3.4px;color:#24211f}body.vano-route-register .register-copy h1 span{display:block;color:#817a75}body.vano-route-register .register-copy p{max-width:520px;margin:17px 0 0;color:#756e68;font-size:13px;line-height:1.65}
body.vano-route-register .register-actions{width:min(100%,500px);margin-top:30px}body.vano-route-register .register-google,
body.vano-route-register .register-email-submit{width:100%;min-height:56px;border-radius:17px;display:grid;align-items:center;text-decoration:none;transition:transform .18s cubic-bezier(.2,.8,.2,1),box-shadow .2s ease,background .2s ease}body.vano-route-register .register-google{grid-template-columns:25px minmax(0,1fr) 20px;gap:11px;padding:0 17px;border:1px solid #dadde4;background:#fff;color:#24262c;box-shadow:0 8px 22px rgba(32,35,42,.06);font-size:13px;font-weight:850}body.vano-route-register .register-google:hover{transform:translateY(-1px);box-shadow:0 13px 28px rgba(32,35,42,.10)}body.vano-route-register .register-google:active{transform:scale(.985)}body.vano-route-register .register-google .google-logo{width:22px;height:22px}body.vano-route-register .register-google>i:last-child{justify-self:end;color:#8d9199}body.vano-route-register .register-google.is-disabled{display:flex;justify-content:center;color:#9b9da4;background:#f7f7f8;box-shadow:none}
body.vano-route-register .register-divider{height:38px;display:flex;align-items:center;gap:12px;color:#aaa39e;font-size:9px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}body.vano-route-register .register-divider:before,
body.vano-route-register .register-divider:after{content:"";height:1px;flex:1;background:#ece9e6}
body.vano-route-register .register-form{display:grid;gap:13px}body.vano-route-register .register-field{display:grid;gap:6px}body.vano-route-register .register-field label{margin-left:2px;color:#514b47;font-size:10px;font-weight:850}body.vano-route-register .register-field>small{margin-left:3px;color:#a09a95;font-size:8.5px}body.vano-route-register .register-input-shell{height:53px;display:grid;grid-template-columns:20px minmax(0,1fr) auto;align-items:center;gap:9px;padding:0 13px;border:1px solid #e4e1de;border-radius:15px;background:#faf9f8;color:#8d8782;transition:border-color .18s ease,box-shadow .18s ease,background .18s ease}body.vano-route-register .register-input-shell:focus-within{border-color:rgba(245,154,98,.72);background:#fff;box-shadow:0 0 0 4px rgba(245,154,98,.10)}body.vano-route-register .register-input-shell input{width:100%;height:100%;min-width:0;border:0;outline:0;background:transparent;color:#24211f;font-size:13px;font-weight:650}body.vano-route-register .register-input-shell input::placeholder{color:#aaa5a0;font-weight:500}body.vano-route-register .register-password-toggle{width:34px;height:34px;display:grid;place-items:center;border:0;border-radius:10px;background:transparent;color:#8e8883;cursor:pointer}body.vano-route-register .register-password-toggle:hover{background:#f1efed;color:#5b5550}
body.vano-route-register .register-email-submit{grid-template-columns:minmax(0,1fr) 20px;gap:10px;margin-top:3px;padding:0 17px;border:0;background:#F59A62;color:#fff;font-size:13px;font-weight:900;box-shadow:0 14px 32px rgba(222,116,64,.22);cursor:pointer}body.vano-route-register .register-email-submit i{justify-self:end}body.vano-route-register .register-email-submit:hover{background:#eb8950;transform:translateY(-1px);box-shadow:0 17px 38px rgba(222,116,64,.28)}body.vano-route-register .register-email-submit:active{transform:scale(.985)}
body.vano-route-register .register-existing{text-align:center;margin-top:16px;color:#88817c;font-size:10.5px}body.vano-route-register .register-existing a,
body.vano-route-register .register-legal a{color:#b85c31;font-weight:850;text-decoration:none}body.vano-route-register .register-guest{margin:13px auto 0;width:max-content;display:inline-flex;align-items:center;gap:6px;color:#8b8580;text-decoration:none;font-size:10px;font-weight:750}body.vano-route-register .register-guest:hover{color:#4e4844}body.vano-route-register .register-legal{margin:auto 0 0;padding-top:28px;color:#aaa39e;font-size:8.5px;line-height:1.5;max-width:500px}
body.vano-route-register .register-preview{position:relative;min-height:650px;overflow:hidden;background:#efefef}body.vano-route-register .register-city{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.02)}body.vano-route-register .preview-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.10),rgba(255,255,255,.02) 45%,rgba(26,23,21,.13))}body.vano-route-register .preview-top{position:absolute;top:34px;left:34px;right:34px}body.vano-route-register .preview-top>span{display:inline-flex;align-items:center;gap:6px;padding:8px 10px;border-radius:999px;background:rgba(255,255,255,.90);border:1px solid rgba(40,36,33,.06);box-shadow:0 9px 24px rgba(40,36,33,.08);font-size:9px;font-weight:900;letter-spacing:.08em}body.vano-route-register .preview-top>span i{width:7px;height:7px;border-radius:50%;background:#F59A62;box-shadow:0 0 0 5px rgba(245,154,98,.14)}body.vano-route-register .preview-top>b{display:block;margin-top:17px;font-size:clamp(42px,5vw,70px);line-height:.93;letter-spacing:-3.4px;color:#282522}body.vano-route-register .preview-route-card{position:absolute;left:32px;right:32px;bottom:86px;display:grid;grid-template-columns:46px minmax(0,1fr);gap:12px;align-items:center;padding:17px;border:1px solid rgba(255,255,255,.75);border-radius:21px;background:rgba(255,255,255,.90);box-shadow:0 18px 46px rgba(42,38,35,.14);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}body.vano-route-register .preview-route-icon{width:46px;height:46px;display:grid;place-items:center;border-radius:15px;background:#F59A62;color:#fff;box-shadow:0 9px 24px rgba(224,118,65,.24)}body.vano-route-register .preview-route-card small{display:block;color:#c56638;font-size:8px;font-weight:900;letter-spacing:.12em}body.vano-route-register .preview-route-card b{display:block;margin-top:3px;font-size:15px;letter-spacing:-.3px}body.vano-route-register .preview-route-card span:not(.preview-route-icon){display:block;margin-top:4px;color:#7f7873;font-size:10px;line-height:1.4}body.vano-route-register .preview-pills{position:absolute;left:32px;bottom:30px;display:flex;gap:7px}body.vano-route-register .preview-pills span{display:inline-flex;align-items:center;gap:5px;padding:8px 10px;border-radius:999px;background:rgba(255,255,255,.91);border:1px solid rgba(40,36,33,.06);font-size:9px;font-weight:850;color:#5f5954}
html[data-vano-theme="black"] body.vano-route-register{background:#171512;color:#fff8f2}html[data-vano-theme="black"] body.vano-route-register .vano-register-v340{background:radial-gradient(circle at 12% 4%,rgba(245,154,98,.13),transparent 25%),#171512}html[data-vano-theme="black"] body.vano-route-register .register-shell{background:#1f1c1a;border-color:rgba(255,255,255,.07);box-shadow:0 28px 80px rgba(0,0,0,.28)}html[data-vano-theme="black"] body.vano-route-register .register-copy h1,
html[data-vano-theme="black"] body.vano-route-register .register-input-shell input{color:#fff8f2}html[data-vano-theme="black"] body.vano-route-register .register-copy h1 span{color:#8f8781}html[data-vano-theme="black"] body.vano-route-register .register-copy p,
html[data-vano-theme="black"] body.vano-route-register .register-existing,
html[data-vano-theme="black"] body.vano-route-register .register-guest{color:#9f9791}html[data-vano-theme="black"] body.vano-route-register .register-google,
html[data-vano-theme="black"] body.vano-route-register .register-input-shell{background:#27231f;border-color:rgba(255,255,255,.09);color:#fff8f2}html[data-vano-theme="black"] body.vano-route-register .register-input-shell:focus-within{background:#2d2925;border-color:rgba(245,154,98,.62)}html[data-vano-theme="black"] body.vano-route-register .register-divider:before,
html[data-vano-theme="black"] body.vano-route-register .register-divider:after{background:rgba(255,255,255,.08)}
@media(max-width:900px){body.vano-route-register .vano-register-v340{padding:0}body.vano-route-register .register-shell{min-height:100svh;border:0;border-radius:0;grid-template-columns:1fr}body.vano-route-register .register-panel{padding:max(24px,env(safe-area-inset-top)) max(20px,env(safe-area-inset-right)) max(24px,env(safe-area-inset-bottom)) max(20px,env(safe-area-inset-left))}body.vano-route-register .register-preview{display:none}body.vano-route-register .register-copy{margin-top:clamp(34px,7vh,62px)}body.vano-route-register .register-copy h1{font-size:clamp(40px,9vw,58px)}body.vano-route-register .register-actions{width:100%;max-width:560px}body.vano-route-register .register-legal{margin-top:30px}}
@media(max-width:480px){body.vano-route-register .register-panel{padding-left:16px;padding-right:16px}body.vano-route-register .register-copy{margin-top:28px}body.vano-route-register .register-copy h1{font-size:40px;letter-spacing:-2.5px}body.vano-route-register .register-copy p{font-size:11.5px}body.vano-route-register .register-actions{margin-top:24px}body.vano-route-register .register-google,
body.vano-route-register .register-email-submit{min-height:53px;border-radius:15px}body.vano-route-register .register-input-shell{height:51px;border-radius:14px}body.vano-route-register .register-legal{padding-top:18px}}
@media(prefers-reduced-motion:reduce){body.vano-route-register .register-google,
body.vano-route-register .register-email-submit,
body.vano-route-register .register-input-shell{transition:none!important}}


/* ===== static/vano-seo.css ===== */
.vano-seo{--seo-card:rgba(255,255,255,.66);--seo-line:rgba(27,30,35,.10);--seo-text:#17191d;--seo-muted:#68717c;--seo-soft:#fff5ec;color:var(--seo-text);background:linear-gradient(180deg,#fffaf5 0,#fff 32%,#fff 100%);min-height:calc(100vh - 64px)}
.vano-seo .seo-wrap{width:min(1080px,calc(100% - 32px));margin:auto;padding:72px 0 86px}.vano-seo .seo-hero{max-width:850px}.vano-seo .seo-kicker{display:inline-flex;align-items:center;gap:8px;padding:7px 10px;border-radius:999px;background:#fff0e5;border:1px solid #ffd7be;color:#a34e23;font-size:12px;font-weight:850}.vano-seo h1{margin:18px 0 16px;font-size:clamp(38px,6vw,70px);line-height:.98;letter-spacing:-.055em}.vano-seo .seo-lead{max-width:780px;margin:0;font-size:clamp(17px,2.1vw,21px);line-height:1.6;color:var(--seo-muted)}
.vano-seo .seo-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px}.vano-seo .seo-primary,.vano-seo .seo-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 18px;border-radius:14px;font-weight:850;text-decoration:none}.vano-seo .seo-primary{background:#F59A62;color:#271307;box-shadow:0 12px 30px rgba(219,111,48,.22)}.vano-seo .seo-secondary{background:#fff;color:#32363b;border:1px solid var(--seo-line)}
.vano-seo .seo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:48px}.vano-seo .seo-card{padding:22px;border:1px solid var(--seo-line);border-radius:22px;background:var(--seo-card);box-shadow:0 15px 44px rgba(32,26,20,.05)}.vano-seo .seo-card i{color:#d96d35}.vano-seo .seo-card h2,.vano-seo .seo-card h3{margin:12px 0 7px;letter-spacing:-.025em}.vano-seo .seo-card p{margin:0;color:var(--seo-muted);line-height:1.65}.vano-seo .seo-section{margin-top:58px;max-width:900px}.vano-seo .seo-section h2{font-size:clamp(28px,4vw,42px);letter-spacing:-.04em;margin:0 0 14px}.vano-seo .seo-section p,.vano-seo .seo-section li{color:var(--seo-muted);line-height:1.75}.vano-seo .seo-section ul{padding-left:20px}.vano-seo .seo-faq{display:grid;gap:10px}.vano-seo details{border:1px solid var(--seo-line);border-radius:16px;background:var(--seo-card);padding:16px 18px}.vano-seo summary{cursor:pointer;font-weight:850}.vano-seo details p{margin:10px 0 0}.vano-seo code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;background:rgba(0,0,0,.055);padding:2px 5px;border-radius:6px}.vano-seo pre{overflow:auto;padding:18px;border-radius:18px;background:#16181c;color:#f7f7f8;border:1px solid rgba(255,255,255,.08);font-size:12px;line-height:1.7}.vano-seo .seo-note{padding:18px 20px;background:var(--seo-soft);border:1px solid #ffd9c2;border-radius:18px;color:#6d432d}
html[data-vano-theme="black"] .vano-seo,html[data-vano-theme-mode="black"] .vano-seo{--seo-card:rgba(255,255,255,.035);--seo-line:rgba(255,255,255,.08);--seo-text:#f4f5f7;--seo-muted:#a0a7b0;--seo-soft:rgba(245,154,98,.07);background:radial-gradient(circle at 25% 0,rgba(245,154,98,.08),transparent 30%),#0b0c0e}.vano-seo .seo-secondary{color:inherit}html[data-vano-theme="black"] .vano-seo .seo-secondary,html[data-vano-theme-mode="black"] .vano-seo .seo-secondary{background:#14171b}.vano-seo .seo-primary:hover,.vano-seo .seo-secondary:hover{transform:translateY(-1px)}
@media(max-width:760px){.vano-seo .seo-wrap{padding:44px 0 72px}.vano-seo .seo-grid{grid-template-columns:1fr;margin-top:34px}.vano-seo h1{font-size:44px}.vano-seo .seo-actions>a{flex:1 1 180px}.vano-seo .seo-section{margin-top:42px}}


/* ===== static/vano-shared-page.css ===== */
/* VANO MAPS V230 — bundle consolidado. Ordem preservada do runtime original. */

/* Shared system layer */
/* VANO v170 — complete visual system.
   Keeps the existing HTML/application structure and re-skins every shared surface
   with the VANO brand board: peach/orange, ivory, warm charcoal and warm gray. */
body.vano-shared-v258{
  --vano-primary:#F59A62;
  --vano-primary-soft:#FFC39B;
  --vano-primary-deep:#D9703F;
  --vano-paper:#FFFBF2;
  --vano-paper-2:#FFF6EE;
  --vano-paper-3:#F7EEE5;
  --vano-ink:#27231F;
  --vano-muted:#706861;
  --vano-line:rgba(112,104,97,.16);
  --vano-line-strong:rgba(112,104,97,.25);
  --vano-white:#FFFFFF;
  --vano-shadow-sm:0 8px 24px rgba(79,58,43,.08);
  --vano-shadow:0 18px 50px rgba(79,58,43,.12);
  --vano-shadow-lg:0 30px 90px rgba(79,58,43,.16);
  --vano-ring:0 0 0 4px rgba(245,154,98,.16);
  --bg:#FFFBF2!important;
  --surface:#FFFFFF!important;
  --surface-2:#FFF6EE!important;
  --surface-3:#F7EEE5!important;
  --text:#27231F!important;
  --muted:#706861!important;
  --muted-2:#948A82!important;
  --line:rgba(112,104,97,.16)!important;
  --orange:#F59A62!important;
  --orange-2:#D9703F!important;
  --orange-3:#FFC39B!important;
  --o:#F59A62!important;
  --o2:#FFC39B!important;
  --shadow:var(--vano-shadow)!important;
  --brand:#F59A62!important;
  --brand-2:#D9703F!important;
  --brand-soft:#FFF0E5!important;
  --accent:#F59A62!important;
  --ink:#27231F!important;
  --soft:#FFF6EE!important;
}
html body.vano-shared-v258{color-scheme:light!important;background:var(--vano-paper)!important}
html[data-vano-theme] body.vano-shared-v258,
html[data-vano-theme] body.vano-shared-v258{color-scheme:light!important}
body.vano-shared-v258{
  color:var(--vano-ink)!important;
  background:
    radial-gradient(circle at 8% -8%,rgba(255,195,155,.28),transparent 30rem),
    radial-gradient(circle at 94% 0,rgba(245,154,98,.12),transparent 28rem),
    var(--vano-paper)!important;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
body.vano-shared-v258:before{background:none!important}
body.vano-shared-v258 ::selection{background:rgba(245,154,98,.28);color:var(--vano-ink)}
body.vano-shared-v258 :focus-visible{outline:2px solid rgba(217,112,63,.55)!important;outline-offset:2px!important}

/* Header / navigation */
body.vano-shared-v258 .topbar{
  background:rgba(255,251,242,.86)!important;
  border-bottom:1px solid rgba(112,104,97,.12)!important;
  box-shadow:0 8px 30px rgba(79,58,43,.045)!important;
  backdrop-filter:blur(24px) saturate(1.2)!important;
  -webkit-backdrop-filter:blur(24px) saturate(1.2)!important;
}
body.vano-shared-v258 .nav{gap:14px!important}
body.vano-shared-v258 .brand{color:var(--vano-ink)!important;font-weight:880!important;letter-spacing:-.45px!important}
body.vano-shared-v258 .brand>span{display:none!important}
body.vano-shared-v258 .vano-brand-wordmark{width:126px!important;height:38px!important;object-fit:contain!important;object-position:left center!important}
body.vano-shared-v258 .navlinks a,
body.vano-shared-v258 .navlinks button.navbtn{color:var(--vano-muted)!important;border-radius:999px!important;font-weight:720!important}
body.vano-shared-v258 .navlinks a:hover,
body.vano-shared-v258 .navlinks button.navbtn:hover,
body.vano-shared-v258 .navlinks a.active{background:rgba(245,154,98,.11)!important;color:var(--vano-ink)!important}

/* Buttons */
body.vano-shared-v258 .btn,
body.vano-shared-v258 .auth-button,
body.vano-shared-v258 .profile-v108-button,
body.vano-shared-v258 .guest-limit-primary,
body.vano-shared-v258 .guest-limit-secondary{
  border-radius:14px!important;
  font-weight:800!important;
  letter-spacing:-.12px!important;
  transition:transform .18s cubic-bezier(.2,.8,.2,1),box-shadow .18s ease,border-color .18s ease,background .18s ease!important;
}
body.vano-shared-v258 .btn{
  background:rgba(255,255,255,.92)!important;
  color:var(--vano-ink)!important;
  border:1px solid var(--vano-line)!important;
  box-shadow:0 5px 16px rgba(79,58,43,.045)!important;
}
body.vano-shared-v258 .btn:hover{transform:translateY(-1px)!important;border-color:rgba(217,112,63,.28)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-shared-v258 .btn:active{transform:translateY(0) scale(.985)!important}
body.vano-shared-v258 .btn-primary{
  color:#fff!important;
  border-color:transparent!important;
  background:linear-gradient(135deg,#FFC39B 0%,#F59A62 45%,#D9703F 100%)!important;
  box-shadow:0 11px 26px rgba(217,112,63,.22),inset 0 1px 0 rgba(255,255,255,.42)!important;
}
body.vano-shared-v258 .btn-primary:hover{box-shadow:0 15px 34px rgba(217,112,63,.27),inset 0 1px 0 rgba(255,255,255,.46)!important}
body.vano-shared-v258 .btn-danger{background:#FFF3F0!important;border-color:#F3CDC6!important;color:#A04435!important}

/* Shared cards / panels / forms */
body.vano-shared-v258 .card,
body.vano-shared-v258 .panel,
body.vano-shared-v258 .kpi,
body.vano-shared-v258 .alert-card,
body.vano-shared-v258 .auth-card,
body.vano-shared-v258 .modal-card,
body.vano-shared-v258 .sheet-card{
  background:rgba(255,255,255,.94)!important;
  color:var(--vano-ink)!important;
  border-color:var(--vano-line)!important;
  box-shadow:var(--vano-shadow-sm)!important;
}
body.vano-shared-v258 .card:hover,
body.vano-shared-v258 .panel:hover{border-color:rgba(217,112,63,.23)!important}
body.vano-shared-v258 .panel-head{border-bottom-color:rgba(112,104,97,.12)!important}
body.vano-shared-v258 .subtitle,
body.vano-shared-v258 .page-subtitle,
body.vano-shared-v258 .muted,
body.vano-shared-v258 .tiny,
body.vano-shared-v258 .card p,
body.vano-shared-v258 .panel p{color:var(--vano-muted)!important}
body.vano-shared-v258 .eyebrow{color:var(--vano-primary-deep)!important}
body.vano-shared-v258 .title,
body.vano-shared-v258 .page-title,
body.vano-shared-v258 .section-title{color:var(--vano-ink)!important}
body.vano-shared-v258 .title span,
body.vano-shared-v258 .section-title span,
body.vano-shared-v258 .hero h1 span{color:var(--vano-primary-deep)!important}
body.vano-shared-v258 .iconbox{
  background:linear-gradient(145deg,#FFF7F0,#FFE7D6)!important;
  color:var(--vano-primary-deep)!important;
  border-color:#FFDCC6!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 9px 22px rgba(217,112,63,.08)!important;
}
body.vano-shared-v258 .input,
body.vano-shared-v258 .select,
body.vano-shared-v258 .textarea,
body.vano-shared-v258 input:not([type=radio]):not([type=checkbox]):not([type=hidden]),
body.vano-shared-v258 select,
body.vano-shared-v258 textarea{
  color:var(--vano-ink)!important;
  background:rgba(255,255,255,.94)!important;
  border-color:var(--vano-line)!important;
}
body.vano-shared-v258 .input::placeholder,
body.vano-shared-v258 .textarea::placeholder,
body.vano-shared-v258 input::placeholder,
body.vano-shared-v258 textarea::placeholder{color:#9C9189!important}
body.vano-shared-v258 .input:focus,
body.vano-shared-v258 .select:focus,
body.vano-shared-v258 .textarea:focus,
body.vano-shared-v258 input:focus,
body.vano-shared-v258 select:focus,
body.vano-shared-v258 textarea:focus{
  border-color:rgba(217,112,63,.5)!important;
  box-shadow:var(--vano-ring)!important;
}
body.vano-shared-v258 .badge{background:#FFF3E9!important;border-color:#FFD9C2!important;color:#A9522D!important}
body.vano-shared-v258 .badge.green{background:#EDF8F3!important;border-color:#CDE8DB!important;color:#2B7258!important}
body.vano-shared-v258 .badge.red{background:#FFF0EE!important;border-color:#F0CAC4!important;color:#A34B3E!important}
body.vano-shared-v258 .table th{color:#8E837C!important;background:#FFF8F2!important;border-color:var(--vano-line)!important}
body.vano-shared-v258 .table td{color:var(--vano-ink)!important;border-color:rgba(112,104,97,.10)!important}
body.vano-shared-v258 .table tr:hover td{background:#FFFAF6!important}
body.vano-shared-v258 .flash{background:rgba(255,255,255,.96)!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important;box-shadow:var(--vano-shadow-sm)!important}

/* Landing / public pages */
body.vano-shared-v258 .hero-card{background:linear-gradient(145deg,#FFFFFF,#FFF6EE)!important;border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-lg)!important}
body.vano-shared-v258 .mock-map{background:radial-gradient(circle at 30% 20%,#FFFDF9,#F4EDE6 62%,#EEE4DA)!important}
body.vano-shared-v258 .mock-map:before,
body.vano-shared-v258 .mock-map:after{filter:none!important;opacity:.7!important}
body.vano-shared-v258 .map-bubble{background:rgba(39,35,31,.92)!important;color:#fff!important;border-color:rgba(255,255,255,.10)!important;box-shadow:0 15px 36px rgba(39,35,31,.18)!important}
body.vano-shared-v258 .map-bubble small{color:#D9D1CB!important}
body.vano-shared-v258 .route-line{border-color:var(--vano-primary)!important;border-left-color:transparent!important;border-bottom-color:var(--vano-primary-soft)!important;filter:drop-shadow(0 0 12px rgba(245,154,98,.27))!important}

/* Mobile dock */
body.vano-shared-v258 .mobile-dock{
  background:rgba(255,251,242,.94)!important;
  border-color:rgba(112,104,97,.14)!important;
  box-shadow:0 16px 42px rgba(79,58,43,.14)!important;
  backdrop-filter:blur(24px) saturate(1.2)!important;
  -webkit-backdrop-filter:blur(24px) saturate(1.2)!important;
}
body.vano-shared-v258 .mobile-dock a{color:#847A73!important}
body.vano-shared-v258 .mobile-dock a:hover,
body.vano-shared-v258 .mobile-dock a.active{background:#FFF0E5!important;color:var(--vano-primary-deep)!important}

/* Login standalone: override legacy purple without changing its structure */
body.vano-shared-v258 .auth-page{background:
  radial-gradient(circle at 8% 0,rgba(255,195,155,.26),transparent 34rem),
  var(--vano-paper)!important}
body.vano-shared-v258 .auth-shell{background:#fff!important;border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-lg)!important}
body.vano-shared-v258 .auth-pane{background:linear-gradient(160deg,#FFFFFF 0%,#FFFCF8 100%)!important}
body.vano-shared-v258 .auth-page .eyebrow,
body.vano-shared-v258 .auth-page h1 span{color:var(--vano-primary-deep)!important}
body.vano-shared-v258 .auth-page .eyebrow:before{background:var(--vano-primary)!important}
body.vano-shared-v258 .product-pill{background:#FFF8F2!important;border-color:var(--vano-line)!important;color:var(--vano-muted)!important}
body.vano-shared-v258 .product-pill i{background:var(--vano-primary)!important;box-shadow:0 0 0 4px rgba(245,154,98,.13)!important}
body.vano-shared-v258 .auth-button.email{
  background:linear-gradient(135deg,#FFC39B,#F59A62 52%,#D9703F)!important;
  color:#fff!important;
  box-shadow:0 12px 28px rgba(217,112,63,.23)!important;
}
body.vano-shared-v258 .auth-button.google{border-color:var(--vano-line)!important;box-shadow:0 6px 18px rgba(79,58,43,.06)!important}
body.vano-shared-v258 .auth-links a:hover{color:var(--vano-primary-deep)!important}
body.vano-shared-v258 .route-pane{background:#F4EEE7!important;border-left-color:var(--vano-line)!important}
body.vano-shared-v258 .route-glow{background:rgba(245,154,98,.17)!important}
body.vano-shared-v258 .live-badge,
body.vano-shared-v258 .mini-chip,
body.vano-shared-v258 .route-summary,
body.vano-shared-v258 .reroute-card{border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-shared-v258 .mini-chip svg,
body.vano-shared-v258 .reroute-icon{color:var(--vano-primary-deep)!important}
body.vano-shared-v258 .reroute-icon{background:#FFF0E5!important}
body.vano-shared-v258 .reroute-line i{background:linear-gradient(90deg,var(--vano-primary-soft),var(--vano-primary-deep))!important}
body.vano-shared-v258 .location-dot{background:var(--vano-primary)!important;box-shadow:0 4px 16px rgba(217,112,63,.28)!important}
body.vano-shared-v258 .location-dot.end{background:var(--vano-ink)!important}

/* Onboarding/profile/admin polish */
body.vano-shared-v258 .ob-card,
body.vano-shared-v258 .profile-v108-card,
body.vano-shared-v258 .profile-v72-card,
body.vano-shared-v258 .activity-card,
body.vano-shared-v258 .admin-card,
body.vano-shared-v258 .admin-kpi{
  background:#fff!important;
  border-color:var(--vano-line)!important;
  box-shadow:var(--vano-shadow-sm)!important;
}
body.vano-shared-v258 .ob-option.active,
body.vano-shared-v258 .profile-v72-accent:has(input:checked),
body.vano-shared-v258 .profile-v108-quick a:hover{
  border-color:rgba(217,112,63,.34)!important;
  background:#FFF5EC!important;
}
body.vano-shared-v258 .profile-v108-quick-icon,
body.vano-shared-v258 .profile-v72-icon,
body.vano-shared-v258 .ob-icon{background:#FFF0E5!important;color:var(--vano-primary-deep)!important}

/* Shared route / live trip standalone */
body.vano-shared-v258 .share-app,
body.vano-shared-v258 .live-app{background:#F5EFE8!important;color:var(--vano-ink)!important}
body.vano-shared-v258 .share-top,
body.vano-shared-v258 .route-panel,
body.vano-shared-v258 .live-top,
body.vano-shared-v258 .live-app .card{background:rgba(255,251,242,.96)!important;border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow)!important}
body.vano-shared-v258 .route-kicker,
body.vano-shared-v258 .live-app .eyebrow{color:var(--vano-primary-deep)!important}
body.vano-shared-v258 .route-actions .primary{background:linear-gradient(135deg,#FFC39B,#F59A62 55%,#D9703F)!important;color:#fff!important;box-shadow:0 10px 24px rgba(217,112,63,.2)!important}
body.vano-shared-v258 .route-note{background:#FFF1E7!important;color:#8A4B2D!important}
body.vano-shared-v258 .metric,
body.vano-shared-v258 .stat{background:#FFF9F4!important;border-color:var(--vano-line)!important}
body.vano-shared-v258 .progress i{background:linear-gradient(90deg,#FFC39B,#F59A62,#D9703F)!important}

@media(max-width:760px){
  body.vano-shared-v258 .topbar{background:rgba(255,251,242,.94)!important}
  body.vano-shared-v258 .container,
body.vano-shared-v258 .nav{width:calc(100% - 18px)!important}
  body.vano-shared-v258 .page{padding-top:18px!important}
  body.vano-shared-v258 .card,
body.vano-shared-v258 .panel{border-radius:18px!important}
  body.vano-shared-v258 .auth-page{padding:0!important;background:#fff!important}
  body.vano-shared-v258 .auth-shell{border:0!important;border-radius:0!important;min-height:100dvh!important;box-shadow:none!important}
}

@media(prefers-reduced-motion:reduce){
  body.vano-shared-v258 *,
body.vano-shared-v258 *:before,
body.vano-shared-v258 *:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}


/* Dedicated admin/risk screens that shipped with hard-coded violet rules. */
body.vano-shared-v258:has(.risk-admin){background:var(--vano-paper)!important;color:var(--vano-ink)!important}
body.vano-shared-v258:has(.risk-admin) .topbar{background:rgba(255,251,242,.94)!important;border-color:var(--vano-line)!important}
body.vano-shared-v258 .risk-eyebrow{color:var(--vano-primary-deep)!important}
body.vano-shared-v258 .risk-card{border-color:var(--vano-line)!important;background:#fff!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-shared-v258 .risk-card-head{border-color:rgba(112,104,97,.11)!important}
body.vano-shared-v258 .rf-input,
body.vano-shared-v258 .rf-select{background:#FFFCF9!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important}
body.vano-shared-v258 .rf-input:focus,
body.vano-shared-v258 .rf-select:focus{border-color:rgba(217,112,63,.52)!important;box-shadow:var(--vano-ring)!important}
body.vano-shared-v258 .switch input:checked+span{background:linear-gradient(135deg,var(--vano-primary-soft),var(--vano-primary))!important}
body.vano-shared-v258 .risk-submit{background:linear-gradient(135deg,#FFC39B,#F59A62 52%,#D9703F)!important;box-shadow:0 10px 24px rgba(217,112,63,.2)!important}
body.vano-shared-v258 .zone-pill{background:#FFF1E7!important;color:#A4512D!important}
body.vano-shared-v258 .policy-note{background:#FFF6EF!important;border-color:#FFE0CD!important;color:#795C4B!important}
body.vano-shared-v258 .risk-back,
body.vano-shared-v258 .mini-btn{border-color:var(--vano-line)!important;color:var(--vano-ink)!important}

/* Register / entry experience */
body.vano-shared-v258:has(.vano-entry),
body.vano-shared-v258 .vano-entry{background:var(--vano-paper)!important;color:var(--vano-ink)!important}
body.vano-shared-v258 .v63-entry-shell{background:#fff!important;border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-lg)!important}
body.vano-shared-v258 .v63-entry-shell:before{background:linear-gradient(115deg,rgba(255,255,255,.96) 0 43%,rgba(255,246,238,.54) 43% 100%)!important}
body.vano-shared-v258 .v63-entry-brand em,
body.vano-shared-v258 .v63-entry-kicker,
body.vano-shared-v258 .v63-entry-panel h1 span{color:var(--vano-primary-deep)!important}
body.vano-shared-v258 .v63-entry-brand em{background:#FFF0E5!important}
body.vano-shared-v258 .v63-entry-proof span{border-color:var(--vano-line)!important;background:#FFF9F4!important;color:var(--vano-muted)!important}
body.vano-shared-v258 .v63-route-stage{background:radial-gradient(circle at 72% 8%,rgba(255,195,155,.22),transparent 26%),linear-gradient(145deg,#FFF9F4,#F0E7DE)!important;border-color:var(--vano-line)!important}
body.vano-shared-v258 .v63-stage-card,
body.vano-shared-v258 .v63-stage-brand{background:rgba(255,251,242,.90)!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-shared-v258 .auth-choice.primary,
body.vano-shared-v258 .auth-google.auth-google-primary{background:linear-gradient(135deg,#FFC39B,#F59A62 50%,#D9703F)!important;color:#fff!important;border-color:transparent!important;box-shadow:0 12px 28px rgba(217,112,63,.21)!important}
body.vano-shared-v258 .auth-choice.secondary,
body.vano-shared-v258 .auth-guest{background:#fff!important;color:var(--vano-ink)!important;border-color:var(--vano-line)!important}
body.vano-shared-v258 .auth-sheet .sheet-card{border-color:var(--vano-line)!important;box-shadow:var(--vano-shadow-lg)!important}
body.vano-shared-v258 .sheet-input:focus,
body.vano-shared-v258 .sheet-select:focus{border-color:rgba(217,112,63,.5)!important;box-shadow:var(--vano-ring)!important}
body.vano-shared-v258 .sheet-submit{background:linear-gradient(135deg,#FFC39B,#F59A62 50%,#D9703F)!important;box-shadow:0 12px 26px rgba(217,112,63,.21)!important}

/* Onboarding: convert the legacy dark setup flow into a warm VANO setup flow. */
body.vano-shared-v258 .onboard{
  background:radial-gradient(circle at 86% -6%,rgba(255,195,155,.30),transparent 30rem),radial-gradient(circle at 4% 36%,rgba(245,154,98,.10),transparent 25rem),var(--vano-paper)!important;
  color:var(--vano-ink)!important;
}
body.vano-shared-v258 .vano-mini{color:var(--vano-ink)!important}
body.vano-shared-v258 .vano-mini img{filter:drop-shadow(0 8px 18px rgba(217,112,63,.16))!important}
body.vano-shared-v258 .step-pill{color:var(--vano-primary-deep)!important;border-color:#FFD7BF!important;background:#FFF1E6!important}
body.vano-shared-v258 .ob-progress{background:#EFE4DB!important}body.vano-shared-v258 .ob-progress i{background:linear-gradient(90deg,#FFC39B,#F59A62,#D9703F)!important;box-shadow:0 0 15px rgba(245,154,98,.22)!important}
body.vano-shared-v258 .ob-head .eyebrow{color:var(--vano-primary-deep)!important}
body.vano-shared-v258 .ob-head h1{color:var(--vano-ink)!important}body.vano-shared-v258 .ob-head h1 span{color:#8A7F77!important}body.vano-shared-v258 .ob-head p{color:var(--vano-muted)!important}
body.vano-shared-v258 .ob-section{border-color:var(--vano-line)!important;background:rgba(255,255,255,.92)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-shared-v258 .ob-section-title .ico{background:#FFF0E5!important;border-color:#FFDCC7!important;color:var(--vano-primary-deep)!important}
body.vano-shared-v258 .ob-section-title b{color:var(--vano-ink)!important}body.vano-shared-v258 .ob-section-title span{color:var(--vano-muted)!important}
body.vano-shared-v258 .onboard .input,
body.vano-shared-v258 .onboard .select{background:#FFFCF9!important;color:var(--vano-ink)!important;border-color:var(--vano-line)!important}
body.vano-shared-v258 .onboard .input::placeholder{color:#A0958D!important}
body.vano-shared-v258 .choice label,
body.vano-shared-v258 .pref label,
body.vano-shared-v258 .night-card{background:#FFFDFC!important;border-color:var(--vano-line)!important}
body.vano-shared-v258 .choice label b,
body.vano-shared-v258 .pref label b,
body.vano-shared-v258 .night-card b,
body.vano-shared-v258 .presence-consent b{color:var(--vano-ink)!important}
body.vano-shared-v258 .choice label span,
body.vano-shared-v258 .pref label span,
body.vano-shared-v258 .night-card span,
body.vano-shared-v258 .presence-consent span span{color:var(--vano-muted)!important}
body.vano-shared-v258 .choice input:checked+label,
body.vano-shared-v258 .pref input:checked+label{border-color:rgba(217,112,63,.38)!important;background:#FFF2E8!important;box-shadow:inset 0 0 0 1px rgba(245,154,98,.05)!important}
body.vano-shared-v258 .pref-icon{background:#FFF5ED!important;color:#8A7E76!important}body.vano-shared-v258 .pref input:checked+label .pref-icon{background:#FFEBDD!important;color:var(--vano-primary-deep)!important}
body.vano-shared-v258 .radio-dot{border-color:#CFC2B8!important}body.vano-shared-v258 .pref input:checked+label .radio-dot{border-color:var(--vano-primary)!important}body.vano-shared-v258 .pref input:checked+label .radio-dot:after{background:var(--vano-primary)!important}
body.vano-shared-v258 .slider{background:#D7CCC3!important}body.vano-shared-v258 .switch input:checked+.slider{background:linear-gradient(135deg,var(--vano-primary-soft),var(--vano-primary))!important}
body.vano-shared-v258 .mini-note{background:#FFF8F2!important;color:var(--vano-muted)!important}
body.vano-shared-v258 .privacy-note{background:#FFF6EF!important;border-color:#FFE1CE!important;color:#796C63!important}body.vano-shared-v258 .privacy-note i{color:var(--vano-primary-deep)!important}
body.vano-shared-v258 .presence-consent{border-color:#FFD9C3!important;background:#FFF4EB!important}
body.vano-shared-v258 .fine,
body.vano-shared-v258 .optional,
body.vano-shared-v258 .vehicle-hint{color:#887D75!important}body.vano-shared-v258 .vehicle-hint i{color:var(--vano-primary-deep)!important}

/* Live trip standalone */
body.vano-shared-v258 .app{background:#F4EEE7!important;color:var(--vano-ink)!important}
body.vano-shared-v258 .app .map{background:#F1EAE3!important}
body.vano-shared-v258 .app .veil{background:linear-gradient(180deg,rgba(255,251,242,.18),transparent 24%,transparent 70%,rgba(255,251,242,.12))!important}
body.vano-shared-v258 .app .brand,
body.vano-shared-v258 .app .status{background:rgba(255,251,242,.95)!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important;box-shadow:var(--vano-shadow-sm)!important}
body.vano-shared-v258 .app .status{color:var(--vano-muted)!important}
body.vano-shared-v258 .app .dot{background:var(--vano-primary)!important;box-shadow:0 0 0 5px rgba(245,154,98,.13)!important}
body.vano-shared-v258 .app .card{background:rgba(255,251,242,.97)!important;border-color:var(--vano-line)!important;color:var(--vano-ink)!important;box-shadow:0 -14px 42px rgba(67,49,37,.14)!important}
body.vano-shared-v258 .app .grab{background:#D6CBC2!important}body.vano-shared-v258 .app .eyebrow{color:var(--vano-primary-deep)!important}body.vano-shared-v258 .app .card p,
body.vano-shared-v258 .app .stat span,
body.vano-shared-v258 .app .privacy{color:var(--vano-muted)!important}
body.vano-shared-v258 .app .stat{background:#FFF8F2!important;border-color:var(--vano-line)!important}body.vano-shared-v258 .app .progress{background:#EDE2D9!important}
body.vano-shared-v258 .app .progress i{background:linear-gradient(90deg,#FFC39B,#F59A62,#D9703F)!important}
body.vano-shared-v258 .app .puck{background:linear-gradient(145deg,#FFC39B,#F59A62 55%,#D9703F)!important;border-color:#FFFBF2!important;box-shadow:0 0 0 4px rgba(39,35,31,.82),0 9px 22px rgba(39,35,31,.24)!important}
body.vano-shared-v258 .app .offline{background:var(--vano-paper)!important;color:var(--vano-ink)!important}body.vano-shared-v258 .app .offline p{color:var(--vano-muted)!important}


/* Map layer */
/* VANO v170 — Mapbox/navigation redesign. Geometry and IDs are preserved. */
body.vano-shared-v258 .ws-app{
  --v-card:rgba(255,251,242,.965);
  --v-card-solid:#FFFBF2;
  --v-ink:#27231F;
  --v-muted:#706861;
  --v-primary:#F59A62;
  --v-light:#FFC39B;
  --v-deep:#D9703F;
  --v-line:rgba(112,104,97,.17);
  --v-shadow:0 18px 48px rgba(67,49,37,.14);
  background:#F4EEE7!important;
  color:var(--v-ink)!important;
}
body.vano-shared-v258 .ws-app #map{background:#F4EEE7!important}
body.vano-shared-v258 .map-vignette{background:linear-gradient(180deg,rgba(255,251,242,.40),transparent 18%,transparent 76%,rgba(255,251,242,.14))!important}
body.vano-shared-v258 .ambient-halo{opacity:.45!important;filter:saturate(.78)!important}
body.vano-shared-v258 .vano-map-brand{
  background:rgba(255,251,242,.86)!important;
  border:1px solid rgba(112,104,97,.11)!important;
  border-radius:16px!important;
  box-shadow:0 8px 24px rgba(67,49,37,.09)!important;
  backdrop-filter:blur(18px) saturate(1.15)!important;
}
body.vano-shared-v258 .vano-map-brand img{filter:none!important}

/* Search / planning sheet */
body.vano-shared-v258 .search-card,
body.vano-shared-v258 .planner-search-card.search-card{
  background:rgba(255,251,242,.94)!important;
  color:var(--v-ink)!important;
  border:1px solid rgba(112,104,97,.15)!important;
  border-radius:22px!important;
  box-shadow:0 14px 36px rgba(67,49,37,.13),inset 0 1px 0 rgba(255,255,255,.92)!important;
  backdrop-filter:blur(24px) saturate(1.25)!important;
  -webkit-backdrop-filter:blur(24px) saturate(1.25)!important;
}
body.vano-shared-v258 .location-row+.location-row{border-top-color:rgba(112,104,97,.10)!important}
body.vano-shared-v258 .location-input{color:var(--v-ink)!important;font-weight:760!important;letter-spacing:-.18px!important}
body.vano-shared-v258 .location-input::placeholder{color:#958A82!important}
body.vano-shared-v258 .row-btn,
body.vano-shared-v258 .planner-adjust-btn,
body.vano-shared-v258 .map-btn,
body.vano-shared-v258 .options-btn,
body.vano-shared-v258 .floating-locate,
body.vano-shared-v258 .nav-stack-btn,
body.vano-shared-v258 .nav-audio-toggle,
body.vano-shared-v258 .nav-search-btn{
  background:rgba(255,251,242,.96)!important;
  color:var(--v-ink)!important;
  border:1px solid rgba(112,104,97,.13)!important;
  box-shadow:0 8px 22px rgba(67,49,37,.105)!important;
}
body.vano-shared-v258 .row-btn:hover,
body.vano-shared-v258 .planner-adjust-btn:hover,
body.vano-shared-v258 .map-btn:hover,
body.vano-shared-v258 .options-btn:hover,
body.vano-shared-v258 .floating-locate:hover,
body.vano-shared-v258 .nav-stack-btn:hover,
body.vano-shared-v258 .nav-audio-toggle:hover{background:#FFF0E5!important;color:var(--v-deep)!important}
body.vano-shared-v258 .search-results,
body.vano-shared-v258 .search-results.search-results-portal{
  background:rgba(255,251,242,.985)!important;
  color:var(--v-ink)!important;
  border:1px solid rgba(112,104,97,.15)!important;
  box-shadow:0 20px 52px rgba(67,49,37,.16)!important;
  backdrop-filter:blur(22px)!important;
}
body.vano-shared-v258 .search-item{border-color:rgba(112,104,97,.08)!important}
body.vano-shared-v258 .search-item:hover,
body.vano-shared-v258 .search-item:active{background:#FFF3E9!important}
body.vano-shared-v258 .result-icon,
body.vano-shared-v258 .planner-preset-icon,
body.vano-shared-v258 .nearby-service-icon{
  background:linear-gradient(145deg,#FFF3E9,#FFE6D4)!important;
  color:var(--v-deep)!important;
  border-color:#FFDDC8!important;
}
body.vano-shared-v258 .result-copy b,
body.vano-shared-v258 .planner-heading-copy b{color:var(--v-ink)!important}
body.vano-shared-v258 .result-copy small,
body.vano-shared-v258 .result-meta,
body.vano-shared-v258 .search-label,
body.vano-shared-v258 .search-message,
body.vano-shared-v258 .planner-tip,
body.vano-shared-v258 .planner-heading-copy span{color:var(--v-muted)!important}

body.vano-shared-v258 .sheet#planSheet,
body.vano-shared-v258 .sheet,
body.vano-shared-v258 .destination-confirm,
body.vano-shared-v258 .prefs-drawer,
body.vano-shared-v258 .safety-drawer,
body.vano-shared-v258 .account-drawer,
body.vano-shared-v258 .options-drawer{
  background:rgba(255,251,242,.975)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.15)!important;
  box-shadow:0 -14px 52px rgba(67,49,37,.15)!important;
  backdrop-filter:blur(26px) saturate(1.18)!important;
  -webkit-backdrop-filter:blur(26px) saturate(1.18)!important;
}
body.vano-shared-v258 .grab,
body.vano-shared-v258 .sheet-grab{background:#D9D0C8!important}
body.vano-shared-v258 .planner-preset,
body.vano-shared-v258 .nearby-service,
body.vano-shared-v258 .quick,
body.vano-shared-v258 .route-card,
body.vano-shared-v258 .parking-nearby,
body.vano-shared-v258 .parking-item,
body.vano-shared-v258 .route-insight .insight,
body.vano-shared-v258 .sub-action,
body.vano-shared-v258 .safety-tool,
body.vano-shared-v258 .pref-row{
  background:rgba(255,255,255,.88)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.13)!important;
  box-shadow:none!important;
}
body.vano-shared-v258 .planner-preset:hover,
body.vano-shared-v258 .nearby-service:hover,
body.vano-shared-v258 .quick:hover,
body.vano-shared-v258 .parking-item:hover,
body.vano-shared-v258 .sub-action:hover{background:#FFF4EB!important;border-color:rgba(217,112,63,.22)!important}
body.vano-shared-v258 .segment,
body.vano-shared-v258 .travel{background:#F8EFE7!important;border-color:rgba(112,104,97,.12)!important;padding:4px!important}
body.vano-shared-v258 .segment button,
body.vano-shared-v258 .travel button{color:#7B716A!important;border-color:transparent!important;border-radius:12px!important}
body.vano-shared-v258 .segment button.active,
body.vano-shared-v258 .travel button.active,
body.vano-shared-v258 .segment button.smart.active{
  color:#A94F29!important;
  background:#FFF8F3!important;
  border-color:#FFD6BD!important;
  box-shadow:0 5px 14px rgba(217,112,63,.09)!important;
}
body.vano-shared-v258 .route-head h2,
body.vano-shared-v258 .route-card h3,
body.vano-shared-v258 .parking-head b{color:var(--v-ink)!important}
body.vano-shared-v258 .route-head p,
body.vano-shared-v258 .route-ai,
body.vano-shared-v258 .parking-head span,
body.vano-shared-v258 .parking-empty,
body.vano-shared-v258 .route-card p{color:var(--v-muted)!important}
body.vano-shared-v258 .route-time span{color:var(--v-ink)!important}
body.vano-shared-v258 .route-time small{color:var(--v-deep)!important}
body.vano-shared-v258 .customize-route-kicker span,
body.vano-shared-v258 .route-choice-label{color:#9A8E86!important}
body.vano-shared-v258 .customize-route-kicker b{color:var(--v-ink)!important}

/* Main CTA — deliberately rebuilt to feel like the hero action */
body.vano-shared-v258 .start-trip-cta{
  position:relative!important;
  min-height:62px!important;
  padding:8px 12px 8px 9px!important;
  display:grid!important;
  grid-template-columns:46px minmax(0,1fr) 36px!important;
  align-items:center!important;
  gap:10px!important;
  border:1px solid rgba(255,255,255,.40)!important;
  border-radius:20px!important;
  overflow:hidden!important;
  background:
    radial-gradient(circle at 18% -10%,rgba(255,255,255,.58),transparent 30%),
    linear-gradient(135deg,#FFC39B 0%,#F59A62 48%,#D9703F 100%)!important;
  color:#fff!important;
  box-shadow:0 16px 36px rgba(217,112,63,.28),inset 0 1px 0 rgba(255,255,255,.54),inset 0 -1px 0 rgba(132,59,26,.10)!important;
  text-align:left!important;
  transform:translateZ(0)!important;
  transition:transform .2s cubic-bezier(.2,.8,.2,1),box-shadow .2s ease,filter .2s ease!important;
}
body.vano-shared-v258 .start-trip-cta:before{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 18%,rgba(255,255,255,.20) 38%,transparent 58%);transform:translateX(-120%);transition:transform .6s ease;pointer-events:none}
body.vano-shared-v258 .start-trip-cta:hover:before{transform:translateX(120%)}
body.vano-shared-v258 .start-trip-cta:hover{transform:translateY(-1px)!important;box-shadow:0 19px 42px rgba(217,112,63,.34),inset 0 1px 0 rgba(255,255,255,.6)!important}
body.vano-shared-v258 .start-trip-cta:active{transform:translateY(0) scale(.99)!important}
body.vano-shared-v258 .start-trip-cta:disabled{filter:saturate(.72);opacity:.8!important}
body.vano-shared-v258 .start-trip-icon{
  width:46px!important;height:46px!important;border-radius:15px!important;display:grid!important;place-items:center!important;
  background:linear-gradient(155deg,#38332E,#211E1B)!important;
  color:#FFF8F3!important;
  border:1px solid rgba(255,255,255,.14)!important;
  box-shadow:0 8px 18px rgba(68,37,23,.20),inset 0 1px 0 rgba(255,255,255,.12)!important;
}
body.vano-shared-v258 .start-trip-icon svg{width:20px!important;height:20px!important;stroke-width:2.4!important}
body.vano-shared-v258 .start-trip-copy{min-width:0!important;display:flex!important;flex-direction:column!important;gap:2px!important}
body.vano-shared-v258 .start-trip-copy b{font-size:14px!important;line-height:1.12!important;letter-spacing:-.28px!important;color:#fff!important;font-weight:880!important}
body.vano-shared-v258 .start-trip-copy small{font-size:9px!important;line-height:1.25!important;color:rgba(255,255,255,.82)!important;font-weight:720!important;letter-spacing:.01em!important}
body.vano-shared-v258 .start-trip-arrow{width:34px!important;height:34px!important;border-radius:50%!important;display:grid!important;place-items:center!important;background:rgba(255,255,255,.17)!important;border:1px solid rgba(255,255,255,.20)!important;color:#fff!important;font-size:24px!important;line-height:1!important}

/* Confirmation / loading */
body.vano-shared-v258 .destination-confirm-card,
body.vano-shared-v258 .route-loading-card,
body.vano-shared-v258 .resume-trip-card,
body.vano-shared-v258 .immersive-choice-card,
body.vano-shared-v258 .guest-limit-card{
  background:rgba(255,251,242,.98)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.16)!important;
  box-shadow:0 24px 68px rgba(67,49,37,.19)!important;
}
body.vano-shared-v258 .destination-accept,
body.vano-shared-v258 .resume-trip-continue,
body.vano-shared-v258 .traffic-accept,
body.vano-shared-v258 .guest-limit-primary{
  color:#fff!important;
  background:linear-gradient(135deg,#FFC39B,#F59A62 48%,#D9703F)!important;
  border-color:transparent!important;
  box-shadow:0 10px 25px rgba(217,112,63,.22)!important;
}
body.vano-shared-v258 .destination-edit,
body.vano-shared-v258 .resume-trip-dismiss,
body.vano-shared-v258 .traffic-dismiss,
body.vano-shared-v258 .guest-limit-secondary{background:#fff!important;color:var(--v-ink)!important;border-color:var(--v-line)!important}
body.vano-shared-v258 .route-loading-spinner{border-color:rgba(245,154,98,.18)!important;border-top-color:var(--v-deep)!important}
body.vano-shared-v258 .route-loading-dots i{background:var(--v-primary)!important}

/* Map controls/status */
body.vano-shared-v258 .status-chip,
body.vano-shared-v258 .gps-quality,
body.vano-shared-v258 .traffic-radar,
body.vano-shared-v258 .connectivity-pill,
body.vano-shared-v258 .nav-map-mode,
body.vano-shared-v258 .nav-tracking,
body.vano-shared-v258 .nav-immersive-chip,
body.vano-shared-v258 .nav-voice-popover,
body.vano-shared-v258 .nav-alt-hint,
body.vano-shared-v258 .nav-feedback{
  background:rgba(255,251,242,.94)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.14)!important;
  box-shadow:0 10px 28px rgba(67,49,37,.12)!important;
  backdrop-filter:blur(18px) saturate(1.2)!important;
}
body.vano-shared-v258 .floating-speedo{background:rgba(39,35,31,.93)!important;color:#fff!important;border-color:rgba(255,255,255,.08)!important;box-shadow:0 12px 28px rgba(39,35,31,.22)!important}
body.vano-shared-v258 .floating-speedo small{color:#CFC6BF!important}

/* Active navigation HUD */
body.vano-shared-v258 .nav-maneuver-top{
  background:
    radial-gradient(circle at 18% -25%,rgba(255,195,155,.16),transparent 40%),
    linear-gradient(150deg,#302B27,#211E1B)!important;
  color:#FFFBF2!important;
  border:1px solid rgba(255,255,255,.09)!important;
  border-radius:24px!important;
  box-shadow:0 18px 44px rgba(39,35,31,.26),inset 0 1px 0 rgba(255,255,255,.06)!important;
  backdrop-filter:blur(18px)!important;
}
body.vano-shared-v258 .nav-maneuver-icon{
  background:linear-gradient(145deg,#FFC39B,#F59A62 56%,#D9703F)!important;
  color:#fff!important;
  border:1px solid rgba(255,255,255,.28)!important;
  box-shadow:0 9px 20px rgba(217,112,63,.23),inset 0 1px 0 rgba(255,255,255,.45)!important;
}
body.vano-shared-v258 .nav-maneuver-copy small{color:#CFC5BE!important}
body.vano-shared-v258 .nav-maneuver-copy b{color:#fff!important}
body.vano-shared-v258 .nav-maneuver-copy span{color:#E7DED8!important}
body.vano-shared-v258 .nav-street-chip{background:rgba(255,251,242,.94)!important;color:var(--v-ink)!important;border-color:rgba(112,104,97,.13)!important;box-shadow:0 8px 22px rgba(67,49,37,.10)!important}
body.vano-shared-v258 .nav-panel.nav-minimal{
  background:rgba(255,251,242,.965)!important;
  color:var(--v-ink)!important;
  border-color:rgba(112,104,97,.15)!important;
  box-shadow:0 -18px 52px rgba(67,49,37,.17)!important;
  backdrop-filter:blur(24px) saturate(1.2)!important;
}
body.vano-shared-v258 .nav-summary-item{background:#FFF8F2!important;border-color:rgba(112,104,97,.11)!important}
body.vano-shared-v258 .nav-summary-item small{color:#9A8E86!important}
body.vano-shared-v258 .nav-summary-item strong{color:var(--v-ink)!important}
body.vano-shared-v258 .traffic-suggestion{background:#FFF4EA!important;border-color:#FFD7BE!important}
body.vano-shared-v258 .traffic-suggestion-icon{background:#fff!important;color:var(--v-deep)!important}
body.vano-shared-v258 .nav-alt-accept{background:var(--v-primary)!important;color:#fff!important}
body.vano-shared-v258 .reroute .loading{border-color:rgba(245,154,98,.20)!important;border-top-color:var(--v-primary)!important}

/* User puck */
body.vano-shared-v258 .user-marker.vano-uploaded-user{filter:drop-shadow(0 10px 14px rgba(66,42,28,.24))!important}
body.vano-shared-v258 .user-marker.vano-uploaded-user .pulse{background:radial-gradient(circle,rgba(245,154,98,.22) 0 18%,rgba(245,154,98,.08) 36%,transparent 68%)!important;animation-duration:2.6s!important}
body.vano-shared-v258 .user-marker.vano-uploaded-user .user-puck-image{filter:drop-shadow(0 1px 0 rgba(255,255,255,.45))!important}

/* Destination marker: built from DOM/CSS, no rectangular PNG asset. */
body.vano-shared-v258 .route-marker.destination{
  width:48px!important;
  height:59px!important;
  overflow:visible!important;
  filter:none!important;
  pointer-events:none!important;
}
body.vano-shared-v258 .arrival-ground{
  position:absolute!important;
  left:50%!important;
  bottom:0!important;
  width:29px!important;
  height:8px!important;
  transform:translateX(-50%)!important;
  border-radius:50%!important;
  background:rgba(39,35,31,.22)!important;
  filter:blur(4px)!important;
}
body.vano-shared-v258 .arrival-bubble{
  position:absolute!important;
  left:50%!important;
  top:0!important;
  width:44px!important;
  height:44px!important;
  transform:translateX(-50%) translateZ(0)!important;
  border-radius:50%!important;
  background:linear-gradient(145deg,#3B3530,#211E1B)!important;
  border:1px solid rgba(255,255,255,.18)!important;
  box-shadow:
    0 10px 20px rgba(39,35,31,.24),
    0 3px 8px rgba(217,112,63,.12),
    inset 0 1px 0 rgba(255,255,255,.20),
    inset 0 -2px 5px rgba(0,0,0,.20)!important;
}
body.vano-shared-v258 .arrival-bubble:after{
  content:""!important;
  position:absolute!important;
  left:50%!important;
  bottom:-10px!important;
  width:18px!important;
  height:18px!important;
  transform:translateX(-50%) rotate(45deg)!important;
  border-radius:3px 0 5px 0!important;
  background:linear-gradient(135deg,#2B2723 42%,#211E1B 100%)!important;
  border-right:1px solid rgba(255,255,255,.12)!important;
  border-bottom:1px solid rgba(255,255,255,.09)!important;
  box-shadow:5px 5px 10px rgba(39,35,31,.12)!important;
  z-index:-1!important;
}
body.vano-shared-v258 .arrival-ring{
  position:absolute!important;
  inset:4px!important;
  border-radius:50%!important;
  padding:3px!important;
  background:linear-gradient(145deg,#FFE0CB 0%,#FFC39B 22%,#F59A62 58%,#D9703F 100%)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.64),0 1px 5px rgba(217,112,63,.20)!important;
}
body.vano-shared-v258 .arrival-checkers{
  position:relative!important;
  display:block!important;
  width:100%!important;
  height:100%!important;
  overflow:hidden!important;
  border-radius:50%!important;
  background-color:#FFFBF2!important;
  background-image:conic-gradient(#27231F 25%,#FFFBF2 0 50%,#27231F 0 75%,#FFFBF2 0)!important;
  background-size:12px 12px!important;
  background-position:center!important;
  box-shadow:inset 0 0 0 1px rgba(39,35,31,.45),inset 0 -7px 10px rgba(39,35,31,.12),inset 0 7px 10px rgba(255,255,255,.28)!important;
  transform:rotate(-3deg)!important;
}
body.vano-shared-v258 .arrival-checkers:before{
  content:""!important;
  position:absolute!important;
  inset:-4px!important;
  border-radius:50%!important;
  background:linear-gradient(145deg,rgba(255,255,255,.66) 0 21%,transparent 38% 65%,rgba(39,35,31,.10) 100%)!important;
  pointer-events:none!important;
}
body.vano-shared-v258 .arrival-checkers:after{
  content:""!important;
  position:absolute!important;
  left:8px!important;right:8px!important;top:4px!important;height:7px!important;
  border-radius:50%!important;
  background:rgba(255,255,255,.32)!important;
  filter:blur(2px)!important;
}

body.vano-shared-v258 .body-nav .route-marker.destination .arrival-visual{transform:scale(.96)!important;transform-origin:center bottom!important}

/* Map alerts rebuilt with the same polished DOM/CSS language as the arrival pin. */
body.vano-shared-v258 .route-marker.alert-marker{position:relative!important;width:52px!important;height:64px!important;padding:0!important;border:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important;cursor:pointer!important;pointer-events:auto!important;appearance:none!important;-webkit-appearance:none!important}
body.vano-shared-v258 .alert-visual{position:relative!important;display:block!important;width:52px!important;height:64px!important}
body.vano-shared-v258 .alert-ground{position:absolute!important;left:50%!important;bottom:0!important;width:31px!important;height:8px!important;transform:translateX(-50%)!important;border-radius:50%!important;background:rgba(39,35,31,.18)!important;filter:blur(4px)!important}
body.vano-shared-v258 .alert-bubble{position:absolute!important;left:50%!important;top:0!important;width:46px!important;height:46px!important;transform:translateX(-50%) translateZ(0)!important;border-radius:50%!important;background:linear-gradient(145deg,#3B3530,#211E1B)!important;border:1px solid rgba(255,255,255,.18)!important;box-shadow:0 10px 20px rgba(39,35,31,.22),0 3px 8px rgba(217,112,63,.12),inset 0 1px 0 rgba(255,255,255,.20),inset 0 -2px 5px rgba(0,0,0,.20)!important}
body.vano-shared-v258 .alert-bubble:after{content:""!important;position:absolute!important;left:50%!important;bottom:-10px!important;width:18px!important;height:18px!important;transform:translateX(-50%) rotate(45deg)!important;border-radius:3px 0 5px 0!important;background:linear-gradient(135deg,#2B2723 42%,#211E1B 100%)!important;border-right:1px solid rgba(255,255,255,.12)!important;border-bottom:1px solid rgba(255,255,255,.09)!important;box-shadow:5px 5px 10px rgba(39,35,31,.12)!important;z-index:-1!important}
body.vano-shared-v258 .alert-ring{position:absolute!important;inset:4px!important;display:grid!important;place-items:center!important;border-radius:50%!important;padding:3px!important;background:linear-gradient(145deg,#FFE0CB 0%,#FFC39B 22%,#F59A62 58%,#D9703F 100%)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.64),0 1px 5px rgba(217,112,63,.20)!important}
body.vano-shared-v258 .alert-face{position:relative!important;display:grid!important;place-items:center!important;width:100%!important;height:100%!important;overflow:hidden!important;border-radius:50%!important;background:radial-gradient(circle at 34% 26%,#FFFFFF 0%,#FFF8F1 40%,#F1E5D8 100%)!important;box-shadow:inset 0 0 0 1px rgba(39,35,31,.16),inset 0 -7px 10px rgba(39,35,31,.09),inset 0 7px 10px rgba(255,255,255,.28)!important}
body.vano-shared-v258 .alert-face:before{content:""!important;position:absolute!important;inset:0!important;border-radius:50%!important;background:linear-gradient(145deg,rgba(255,255,255,.58) 0 21%,transparent 38% 68%,rgba(39,35,31,.07) 100%)!important;pointer-events:none!important}
body.vano-shared-v258 .alert-face:after{content:""!important;position:absolute!important;left:9px!important;right:9px!important;top:5px!important;height:7px!important;border-radius:50%!important;background:rgba(255,255,255,.34)!important;filter:blur(2px)!important;pointer-events:none!important}
body.vano-shared-v258 .alert-icon{position:relative!important;z-index:1!important;display:grid!important;place-items:center!important;width:100%!important;height:100%!important}
body.vano-shared-v258 .alert-icon-svg{width:24px!important;height:24px!important;display:block!important}
body.vano-shared-v258 .alert-icon-svg .fg{fill:#27231F!important}body.vano-shared-v258 .alert-icon-svg .accent{fill:#F59A62!important}body.vano-shared-v258 .alert-icon-svg .light{fill:#FFFBF2!important}body.vano-shared-v258 .alert-icon-svg .stroke{fill:none!important;stroke:#27231F!important;stroke-width:1.8!important;stroke-linecap:round!important;stroke-linejoin:round!important}body.vano-shared-v258 .alert-icon-svg .stroke-fill{fill:#FFFBF2!important;stroke:#27231F!important;stroke-width:1.4!important}
body.vano-shared-v258 .route-marker.alert-marker[data-kind="traffic"] .alert-face{background:radial-gradient(circle at 34% 26%,#FFFFFF 0%,#FFF7ED 38%,#F6E1CF 100%)!important}
body.vano-shared-v258 .route-marker.alert-marker[data-kind="flood"] .alert-face{background:radial-gradient(circle at 34% 26%,#FFFFFF 0%,#FFF8F1 42%,#F0E9E0 100%)!important}
body.vano-shared-v258 .route-marker.alert-marker[data-kind="police"] .alert-ring,
body.vano-shared-v258 .route-marker.alert-marker[data-kind="security"] .alert-ring{background:linear-gradient(145deg,#FFE0CB 0%,#FFC39B 20%,#F59A62 55%,#CF6A3C 100%)!important}
@media(max-width:640px){body.vano-shared-v258 .route-marker.alert-marker{width:48px!important;height:60px!important}body.vano-shared-v258 .alert-visual{width:48px!important;height:60px!important}body.vano-shared-v258 .alert-bubble{width:42px!important;height:42px!important}body.vano-shared-v258 .alert-icon-svg{width:22px!important;height:22px!important}}

/* Arrival marker also used by standalone shared-route page */
body.vano-shared-v258 .marker.dest{
  position:relative!important;width:38px!important;height:46px!important;border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important;
}
body.vano-shared-v258 .marker.dest:before{
  content:""!important;position:absolute!important;left:50%!important;top:0!important;width:36px!important;height:36px!important;transform:translateX(-50%)!important;border-radius:50%!important;
  background:conic-gradient(#27231F 25%,#FFFBF2 0 50%,#27231F 0 75%,#FFFBF2 0) center/10px 10px!important;
  border:4px solid #F59A62!important;box-shadow:0 0 0 3px #27231F,0 8px 18px rgba(39,35,31,.22),inset 0 3px 6px rgba(255,255,255,.28)!important;
}
body.vano-shared-v258 .marker.dest:after{
  content:""!important;position:absolute!important;left:50%!important;top:31px!important;width:14px!important;height:14px!important;transform:translateX(-50%) rotate(45deg)!important;background:#27231F!important;border-radius:2px!important;box-shadow:5px 5px 9px rgba(39,35,31,.10)!important;z-index:-1!important;
}

/* Popups / Mapbox chrome */
body.vano-shared-v258 .mapboxgl-popup-content{background:rgba(255,251,242,.98)!important;color:var(--v-ink)!important;border:1px solid rgba(112,104,97,.15)!important;border-radius:16px!important;box-shadow:0 16px 38px rgba(67,49,37,.16)!important}
body.vano-shared-v258 .mapboxgl-popup-tip{border-top-color:#FFFBF2!important}
body.vano-shared-v258 .mapboxgl-ctrl-group{border-radius:14px!important;overflow:hidden!important;box-shadow:0 8px 22px rgba(67,49,37,.11)!important}
body.vano-shared-v258 .mapboxgl-ctrl-group button{background:#FFFBF2!important;color:var(--v-ink)!important}
body.vano-shared-v258 .mapboxgl-ctrl-attrib.mapboxgl-compact,
body.vano-shared-v258 .mapboxgl-ctrl-attrib{background:rgba(255,251,242,.84)!important;color:#7F746D!important;border-color:rgba(112,104,97,.12)!important}

/* Do not let the legacy dark theme repaint the navigation. */
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app,
html[data-vano-theme="black"] body.vano-shared-v258 .sheet#planSheet,
html[data-vano-theme="black"] body.vano-shared-v258 .search-card,
html[data-vano-theme="black"] body.vano-shared-v258 .nav-panel.nav-minimal,
html[data-vano-theme="black"] body.vano-shared-v258 .destination-confirm,
html[data-vano-theme="black"] body.vano-shared-v258 .prefs-drawer,
html[data-vano-theme="black"] body.vano-shared-v258 .safety-drawer{background:rgba(255,251,242,.97)!important;color:var(--v-ink)!important;border-color:var(--v-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .nav-maneuver-top{background:linear-gradient(150deg,#302B27,#211E1B)!important;color:#fff!important}

@media(max-width:640px){
  body.vano-shared-v258 .search-card,
body.vano-shared-v258 .planner-search-card.search-card{left:8px!important;right:8px!important;border-radius:19px!important}
  body.vano-shared-v258 .sheet#planSheet,
body.vano-shared-v258 .sheet{border-radius:24px 24px 0 0!important}
  body.vano-shared-v258 .start-trip-cta{min-height:58px!important;border-radius:18px!important;grid-template-columns:42px minmax(0,1fr) 32px!important;gap:9px!important;padding:8px 10px 8px 8px!important}
  body.vano-shared-v258 .start-trip-icon{width:42px!important;height:42px!important;border-radius:14px!important}
  body.vano-shared-v258 .start-trip-copy b{font-size:13px!important}
  body.vano-shared-v258 .start-trip-copy small{font-size:8px!important}
  body.vano-shared-v258 .start-trip-arrow{width:30px!important;height:30px!important;font-size:21px!important}
  body.vano-shared-v258 .nav-maneuver-top{border-radius:20px!important}
  body.vano-shared-v258 .route-marker.destination{width:44px!important;height:55px!important}
  body.vano-shared-v258 .route-marker.destination .arrival-visual{transform:scale(.94)!important;transform-origin:center bottom!important}
}
body.vano-shared-v258 .start-trip-loading-icon .loading{width:18px!important;height:18px!important;border:2px solid rgba(255,255,255,.28)!important;border-top-color:#fff!important;border-radius:50%!important;animation:spin .7s linear infinite!important}
body.vano-shared-v258 .start-trip-cta.is-starting .start-trip-arrow{font-size:16px!important;font-weight:900!important;letter-spacing:2px!important}


/* Black theme layer */
/* VANO v176 — final black-mode authority and auth/banner polish. */
body.vano-shared-v258{--vb-bg:#171512;--vb-surface:#211E1B;--vb-surface-2:#27231F;--vb-surface-3:#302B27;--vb-text:#FFFBF2;--vb-muted:#D5CBC4;--vb-muted-2:#B9AEA7;--vb-line:rgba(255,251,242,.11);--vb-orange:#F59A62;--vb-orange-2:#FFC39B;--vb-orange-3:#D9703F}

/* Brand banner: use the exact supplied 2048×682 artwork but crop its built-in whitespace in CSS. */
body.vano-shared-v258 .vano-auth-banner-link{display:block!important;width:min(100%,570px)!important;text-decoration:none!important}
body.vano-shared-v258 .vano-auth-banner-frame{position:relative!important;display:block!important;width:min(100%,560px)!important;aspect-ratio:5.06/1!important;overflow:hidden!important;border-radius:20px!important;background:#fff!important;border:1px solid rgba(112,104,97,.10)!important;box-shadow:0 14px 38px rgba(74,51,36,.11)!important;isolation:isolate!important}
body.vano-shared-v258 .vano-auth-banner-frame .vano-auth-banner{position:absolute!important;left:50%!important;top:50%!important;width:123.7%!important;height:auto!important;max-width:none!important;max-height:none!important;transform:translate(-50%,-50%)!important;display:block!important;image-rendering:auto!important;filter:none!important;object-fit:initial!important}
body.vano-shared-v258 .vano-auth-banner--compact .vano-auth-banner-frame,
body.vano-shared-v258 .vano-auth-banner-frame.compact{width:min(100%,465px)!important}
body.vano-shared-v258 .vano-auth-tagline{margin:10px 0 0!important;color:#706861!important;font-size:12px!important;font-weight:720!important;line-height:1.3!important;letter-spacing:-.12px!important}
@media(max-width:760px){body.vano-shared-v258 .vano-auth-banner-link{width:min(100%,380px)!important}body.vano-shared-v258 .vano-auth-banner-frame{width:min(100%,360px)!important;border-radius:17px!important}body.vano-shared-v258 .vano-auth-tagline{font-size:10.5px!important;margin-top:7px!important}}
@media(max-width:370px){body.vano-shared-v258 .vano-auth-banner-link{width:min(100%,330px)!important}body.vano-shared-v258 .vano-auth-banner-frame{width:min(100%,316px)!important}}

/* Black mode must paint before and across every normal page. */
html[data-vano-theme="black"] body.vano-shared-v258{background:var(--vb-bg)!important;color-scheme:dark!important}
html[data-vano-theme="black"] body.vano-shared-v258{background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258:before{background:radial-gradient(circle at 18% -10%,rgba(245,154,98,.055),transparent 28%),radial-gradient(circle at 88% 8%,rgba(255,195,155,.025),transparent 24%)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.page,.section,.auth-wrap,.onboard,.vano-entry){background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.topbar,.mobile-dock){background:rgba(23,21,18,.96)!important;border-color:var(--vb-line)!important;color:var(--vb-text)!important;box-shadow:0 12px 34px rgba(0,0,0,.24)!important}
html[data-vano-theme="black"] body.vano-shared-v258 footer{background:var(--vb-bg)!important;border-color:var(--vb-line)!important;color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.navlinks a,.navlinks button.navbtn,.nav-actions .tiny){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.navlinks a:hover,.navlinks button.navbtn:hover,.navlinks a.active){background:var(--vb-surface-2)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.page-title,.title,.section-title,h1,h2,h3,h4,h5,h6,strong,b,summary,label){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.page-subtitle,.subtitle,.muted,.tiny,p,small){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.eyebrow,[class*="eyebrow"],[class*="kicker"]){color:var(--vb-orange-2)!important}

/* General surfaces/forms used by content pages. */
html[data-vano-theme="black"] body.vano-shared-v258 :is(.panel,.card,.kpi,.alert-card,.auth-card,.invite-card,.faq-hero,.faq details,.notif,.users-surface,.flash){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:0 14px 42px rgba(0,0,0,.20)!important}
html[data-vano-theme="black"] :is(.panel-head,.panel-body.vano-shared-v258,.card-body,.section,.table-wrap){border-color:var(--vb-line)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.input,.select,.textarea,input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),select,textarea){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.input,.select,.textarea,input,textarea)::placeholder{color:#AFA49D!important}
html[data-vano-theme="black"] body.vano-shared-v258 table{color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.table th,.table td,thead,tbody,tr){border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .table tr:hover td{background:rgba(255,251,242,.025)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.badge,.pill,.chip){border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .btn:not(.btn-primary){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .btn-primary{color:#fff!important}

/* Map UI: the account/profile drawer and its profile section were being repainted white by older CSS. */
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app{background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app :is(.account-drawer,.safety-drawer,.prefs-drawer,.quick-alert-card,.search-results,.destination-confirm,.sheet#planSheet,.sheet,.route-card,.guest-limit-card,.resume-trip-card,.nav-panel.nav-minimal,.nav-voice-popover,.traffic-radar,.route-loading-card){background:rgba(33,30,27,.975)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:0 18px 50px rgba(0,0,0,.32)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app :is(.drawer-user,.drawer-link,.drawer-profile,.safety-tool,.pref-row,.quick-alert-grid button,.parking-item,.planner-preset,.nearby-service,.search-item,.search-suggestion,.location-row,.segment button,.travel button,.preview-actions .sub-action){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app :is(.drawer-user b,.drawer-profile,.drawer-link,.drawer-link span,.drawer-link em,.drawer-link i,.safety-tool,.safety-tool b,.pref-row,.pref-row b,.quick-alert-label,.quick-alert-head h3,.search-item b,.search-suggestion b,.planner-heading-copy b,.route-card h3,.route-head h2,.destination-confirm h3,.nav-summary-item strong){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app :is(.drawer-user span,.drawer-login p,.guest-drawer-content>p,.quick-alert-head p,.quick-alert-status,.result-address,.result-copy small,.search-label,.search-label span,.search-label em,.search-message,.search-message span,.search-suggestion small,.planner-heading-copy span,.route-card-meta,.route-ai,.destination-confirm p,.nav-summary-item small,.traffic-radar-copy span){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app :is(.drawer-divider,.support-title){border-color:var(--vb-line)!important;background-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app :is(.drawer-link:hover,.drawer-link:active,.search-item:active,.search-suggestion:active,.quick-alert-grid button:active,.planner-preset:active,.nearby-service:active){background:var(--vb-surface-3)!important;color:var(--vb-orange-2)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app :is(.drawer-avatar.fallback,.quick-alert-close,.guest-drawer-close,.guest-drawer-secondary){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app .guest-drawer-benefits span{background:var(--vb-surface-2)!important;color:var(--vb-muted)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app .guest-drawer-primary{color:#fff!important}
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app .mapboxgl-popup-content{background:rgba(33,30,27,.99)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app .mapboxgl-popup-content *{color:inherit!important}
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app .mapboxgl-popup-tip{border-top-color:var(--vb-surface)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .ws-app .mapboxgl-ctrl-group button{background:var(--vb-surface-2)!important;color:var(--vb-text)!important}
body.vano-shared-v258 .map-mood-fade{transition:opacity .09s ease!important}

/* Profile page: authoritative dark skin for every nested profile surface. */
html[data-vano-theme="black"] body.vano-shared-v258:has(.v72-profile-page){background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.profile-v72-hero,.profile-v72-card,.profile-v72-detail,.profile-v72-links,.profile-v108-quicknav a,.profile-v72-place,.profile-v72-nav-pref,.profile-v72-map-style,.profile-v72-accent,.profile-v72-fuel-list span,.profile-v72-person,.profile-v72-empty){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-shared-v258 .profile-v72-detail summary{background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .profile-v72-detail summary:hover{background:var(--vb-surface-2)!important}
html[data-vano-theme="black"] .profile-v72-detail-body.vano-shared-v258{background:#1C1916!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.profile-v72-field input,.profile-v72-field select,.profile-v72-place input,.profile-v72-invite input){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.profile-v72-copy h1,.profile-v72-section-head h2,.profile-v72-subhead b,.profile-v72-detail-copy b,.profile-v72-place-head,.profile-v72-nav-copy b,.profile-v72-map-copy b,.profile-v72-person b,.profile-v72-links b,.profile-v108-quicknav b){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.profile-v72-copy p,.profile-v72-section-head p,.profile-v72-subcopy,.profile-v72-detail-copy small,.profile-v72-field>span,.profile-v72-nav-copy small,.profile-v72-map-copy small,.profile-v72-person small,.profile-v72-links small,.profile-v108-quicknav small){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.profile-v72-badge,.profile-v72-note,.profile-v72-nav-icon,.profile-v72-detail-icon,.profile-v72-card-icon,.profile-v72-link-icon,.profile-v108-quick-icon,.profile-v72-secondary){background:rgba(245,154,98,.10)!important;color:var(--vb-orange-2)!important;border-color:rgba(245,154,98,.18)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .profile-v72-switch{background:#4A433E!important}
html[data-vano-theme="black"] body.vano-shared-v258 .profile-v72-switch:before{background:#FFFBF2!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.profile-v72-map-style:has(input:checked),.profile-v72-accent:has(input:checked),.profile-v72-fuel-list input:checked+span){background:rgba(245,154,98,.11)!important;border-color:rgba(245,154,98,.30)!important;color:var(--vb-orange-2)!important}

/* Onboarding and auth entry. */
html[data-vano-theme="black"] body.vano-shared-v258 :is(.ob-shell,.ob-section,.choice label,.pref label,.night-card,.presence-consent,.privacy-note,.v63-entry-shell,.v63-entry-panel,.v63-auth-block,.auth-shell,.auth-pane,.sheet-card){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.ob-head h1,.ob-section-title b,.choice label b,.pref label b,.night-card b,.v63-entry-panel h1,.v63-auth-label span:first-child,.auth-copy h1,.sheet-head h2){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.ob-head p,.ob-section-title span,.choice label span,.pref label span,.night-card span,.v63-entry-lead,.auth-legal,.lead,.legal,.sheet-head p,.sheet-switch){color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.ob-section .input,.ob-section .select,.sheet-input,.sheet-select,.field input,.input-shell,.auth-button.google,.auth-google,.auth-choice.secondary,.auth-guest){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.auth-button.email,.auth-choice.primary,.sheet-submit){color:#fff!important}
html[data-vano-theme="black"] body.vano-shared-v258 .vano-auth-tagline{color:var(--vb-muted)!important}
html[data-vano-theme="black"] body.vano-shared-v258 .vano-auth-banner-frame{border-color:rgba(255,195,155,.16)!important;box-shadow:0 16px 42px rgba(0,0,0,.30)!important}
@media(max-width:760px){html[data-vano-theme="black"] body.vano-shared-v258 :is(.auth-page[data-auth-page="login"],.auth-page[data-auth-page="login"] .auth-shell,.auth-page[data-auth-page="login"] .auth-pane,.vano-entry,.vano-entry .v63-entry-shell,.vano-entry .v63-entry-panel){background:var(--vb-bg)!important}}

/* Notifications/help/invites and generic content lists. */
html[data-vano-theme="black"] body.vano-shared-v258 :is(.notif-shell,.notif-list,.faq-shell,.invite-shell){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.notif,.faq details,.invite-card){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.notif p,.notif small,.faq p,.faq small,.invite-card p,.invite-card small){color:var(--vb-muted)!important}

/* Admin pages: old admin-specific styles contained many late white !important rules. */
html[data-vano-theme="black"] body.vano-shared-v258 :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76){background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76) :is([class*="card"],[class*="panel"],[class*="surface"],[class*="kpi"],[class*="metric"],[class*="tile"],[class*="row"],table){background:var(--vb-surface)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76) :is(input,select,textarea){background:var(--vb-surface-2)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76) :is(h1,h2,h3,h4,b,strong,label,th,td){color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.admin86,.audit-page,.admin-server-page,.finance93,.risk-admin,.admin-users-v76) :is(p,small,.muted,span){border-color:var(--vb-line)!important}

/* Standalone shared/live pages when this sheet is linked there. */
html[data-vano-theme="black"] body.vano-shared-v258 :is(.share-app,.map-unavailable,.app,.offline){background:var(--vb-bg)!important;color:var(--vb-text)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.share-top,.route-panel,.share-app .metric,.share-app .route-actions button,.share-app .route-actions a:not(.primary),.live-trip-card){background:rgba(33,30,27,.97)!important;color:var(--vb-text)!important;border-color:var(--vb-line)!important}
html[data-vano-theme="black"] body.vano-shared-v258 :is(.share-top span,.share-app .place small,.share-app .metric small,.share-app .copy-status,.share-app .route-panel p){color:var(--vb-muted)!important}


/* VANO v177 — remove the cramped mobile header shown in the screenshot.
   Signed-in phones already have the bottom dock, so the old wordmark/logout bar is redundant. */
@media(max-width:760px){
  body.vano-shared-v258.vano-signed-in>.topbar,
body.vano-shared-v258:has(.vano-entry)>.topbar,
body.vano-shared-v258:has(.onboard)>.topbar{display:none!important}
  body.vano-shared-v258.vano-signed-in{padding-top:0!important}
  body.vano-shared-v258.vano-signed-in>.page,
body.vano-shared-v258.vano-signed-in>.container.page{padding-top:max(14px,env(safe-area-inset-top))!important}
}

/* Desktop/tablet header stays restrained and does not duplicate the wordmark text. */
body.vano-shared-v258 .topbar .brand>span{display:none!important}
body.vano-shared-v258 .topbar .vano-brand-wordmark{width:132px!important;height:32px!important;max-width:132px!important;object-fit:contain!important;object-position:left center!important;filter:none!important}


/* VANO v178 — transparent auth branding.
   Removes the white/cropped banner frame entirely and uses high-resolution
   light/dark transparent assets so the identity feels native to the page. */
body.vano-shared-v258 .vano-auth-banner-link{
  display:block!important;
  width:min(100%,560px)!important;
  max-width:560px!important;
  margin:0!important;
  padding:0!important;
  background:transparent!important;
  border:0!important;
  border-radius:0!important;
  box-shadow:none!important;
  overflow:visible!important;
  text-decoration:none!important;
}
body.vano-shared-v258 .vano-auth-banner-clean{
  position:relative!important;
  display:block!important;
  width:100%!important;
  aspect-ratio:4.86/1!important;
  background:transparent!important;
  border:0!important;
  border-radius:0!important;
  box-shadow:none!important;
  overflow:visible!important;
  isolation:isolate!important;
}
body.vano-shared-v258 .vano-auth-banner-clean:before{
  content:""!important;
  position:absolute!important;
  left:1.5%!important;
  top:17%!important;
  width:17%!important;
  aspect-ratio:1!important;
  border-radius:34%!important;
  background:rgba(245,154,98,.14)!important;
  filter:blur(22px)!important;
  transform:scale(.92)!important;
  z-index:-1!important;
  pointer-events:none!important;
}
body.vano-shared-v258 .vano-auth-banner-clean .vano-auth-banner{
  position:absolute!important;
  inset:0!important;
  display:block!important;
  width:100%!important;
  height:100%!important;
  max-width:none!important;
  max-height:none!important;
  object-fit:contain!important;
  object-position:left center!important;
  transform:none!important;
  background:transparent!important;
  border:0!important;
  border-radius:0!important;
  box-shadow:none!important;
  image-rendering:auto!important;
  -webkit-font-smoothing:antialiased!important;
  filter:drop-shadow(0 10px 22px rgba(74,51,36,.08))!important;
}
body.vano-shared-v258 .vano-auth-banner-dark{opacity:0!important;visibility:hidden!important}
html[data-vano-theme="black"] body.vano-shared-v258 .vano-auth-banner-light{opacity:0!important;visibility:hidden!important}
html[data-vano-theme="black"] body.vano-shared-v258 .vano-auth-banner-dark{opacity:1!important;visibility:visible!important;filter:drop-shadow(0 12px 28px rgba(0,0,0,.24))!important}
html[data-vano-theme="black"] body.vano-shared-v258 .vano-auth-banner-clean:before{background:rgba(245,154,98,.18)!important;filter:blur(25px)!important}

/* Kill every legacy framed-banner style that could leak back in. */
body.vano-shared-v258 .vano-auth-banner-frame{
  display:contents!important;
  width:auto!important;height:auto!important;aspect-ratio:auto!important;
  overflow:visible!important;border:0!important;border-radius:0!important;
  background:transparent!important;box-shadow:none!important;
}
body.vano-shared-v258 .vano-auth-banner-frame .vano-auth-banner{position:static!important;transform:none!important}

/* Better auth hierarchy around the new lockup. */
body.vano-shared-v258 .auth-page[data-auth-page="login"] .brand-row{
  position:relative!important;
  inset:auto!important;
  width:100%!important;
  min-height:0!important;
  margin:0 0 clamp(24px,4.5vh,48px)!important;
  padding:0!important;
  pointer-events:auto!important;
  display:block!important;
}
body.vano-shared-v258 .auth-page[data-auth-page="login"] .auth-copy{
  margin:0!important;
  padding:0!important;
}
body.vano-shared-v258 .vano-entry .v63-entry-brand{
  display:block!important;
  width:100%!important;
  margin:0 0 clamp(28px,5vh,52px)!important;
  padding:0!important;
}
body.vano-shared-v258 .vano-entry .v63-entry-kicker{margin-top:0!important}

@media(max-width:760px){
  body.vano-shared-v258 .vano-auth-banner-link{width:min(100%,390px)!important;max-width:390px!important}
  body.vano-shared-v258 .vano-auth-banner-clean{aspect-ratio:4.86/1!important}
  body.vano-shared-v258 .auth-page[data-auth-page="login"] .brand-row{margin-bottom:clamp(28px,6vh,48px)!important}
  body.vano-shared-v258 .auth-page[data-auth-page="login"] .auth-pane{
    padding-top:max(24px,calc(env(safe-area-inset-top) + 16px))!important;
  }
  body.vano-shared-v258 .vano-entry .v63-entry-brand{margin-bottom:34px!important}
}
@media(max-width:380px){
  body.vano-shared-v258 .vano-auth-banner-link{width:min(100%,344px)!important}
  body.vano-shared-v258 .auth-page[data-auth-page="login"] .brand-row{margin-bottom:26px!important}
  body.vano-shared-v258 .vano-entry .v63-entry-brand{margin-bottom:28px!important}
}



/* ===== static/vano-ui.css ===== */
/* =====================================================================
   VANO MAPS V259 — stable UI layer
   Scope rule: account/admin pages and the map account drawer are isolated.
   No global map geometry is changed here.
   ===================================================================== */

body.vano-live-v258,
body.vano-shared-v258{
  --v258-bg:#f7f5f2;
  --v258-surface:#ffffff;
  --v258-surface-2:#fbfaf8;
  --v258-surface-3:#f3efeb;
  --v258-ink:#27231f;
  --v258-copy:#655e58;
  --v258-muted:#918880;
  --v258-line:#e9e2dc;
  --v258-line-strong:#ddd2ca;
  --v258-brand:#d9703f;
  --v258-brand-2:#f59a62;
  --v258-brand-3:#ffc39b;
  --v258-brand-soft:#fff0e7;
  --v258-good:#24845d;
  --v258-warn:#b57424;
  --v258-danger:#c75963;
  --v258-radius:22px;
  --v258-shadow:0 16px 48px rgba(67,49,38,.09);
  --v258-shadow-soft:0 8px 28px rgba(67,49,38,.065);
  --v258-focus:0 0 0 4px rgba(217,112,63,.13);
}

html[data-vano-theme="black"] body.vano-live-v258,
html[data-vano-theme="black"] body.vano-shared-v258{
  --v258-bg:#151310;
  --v258-surface:#1c1916;
  --v258-surface-2:#211d1a;
  --v258-surface-3:#28231f;
  --v258-ink:#fff9f4;
  --v258-copy:#c6bbb2;
  --v258-muted:#948981;
  --v258-line:#342e29;
  --v258-line-strong:#443a33;
  --v258-brand:#f59a62;
  --v258-brand-2:#ffc39b;
  --v258-brand-3:#ffe0cc;
  --v258-brand-soft:rgba(245,154,98,.12);
  --v258-good:#65c99b;
  --v258-warn:#e2aa62;
  --v258-danger:#ef8790;
  --v258-shadow:0 22px 62px rgba(0,0,0,.32);
  --v258-shadow-soft:0 10px 32px rgba(0,0,0,.22);
  --v258-focus:0 0 0 4px rgba(245,154,98,.16);
}

/* -------------------------- Non-map shell -------------------------- */
body.vano-live-v258.vano-page-surface,
body.vano-shared-v258.vano-page-surface{
  min-height:100dvh;
  background:
    radial-gradient(circle at 90% -10%,rgba(245,154,98,.12),transparent 28rem),
    radial-gradient(circle at 5% 45%,rgba(255,195,155,.08),transparent 25rem),
    var(--v258-bg);
  color:var(--v258-ink);
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  overflow-x:hidden;
  padding-bottom:0;
}
body.vano-live-v258.vano-page-surface *,
body.vano-live-v258.vano-page-surface *::before,
body.vano-live-v258.vano-page-surface *::after,
body.vano-shared-v258.vano-page-surface *,
body.vano-shared-v258.vano-page-surface *::before,
body.vano-shared-v258.vano-page-surface *::after{box-sizing:border-box}
body.vano-live-v258.vano-page-surface a,
body.vano-shared-v258.vano-page-surface a{color:inherit}
body.vano-live-v258.vano-page-surface button,
body.vano-live-v258.vano-page-surface input,
body.vano-live-v258.vano-page-surface select,
body.vano-live-v258.vano-page-surface textarea,
body.vano-shared-v258.vano-page-surface button,
body.vano-shared-v258.vano-page-surface input,
body.vano-shared-v258.vano-page-surface select,
body.vano-shared-v258.vano-page-surface textarea{font:inherit}
body.vano-live-v258.vano-page-surface button,
body.vano-live-v258.vano-page-surface a,
body.vano-shared-v258.vano-page-surface button,
body.vano-shared-v258.vano-page-surface a{-webkit-tap-highlight-color:transparent}
body.vano-live-v258.vano-page-surface :focus-visible,
body.vano-shared-v258.vano-page-surface :focus-visible{outline:0;box-shadow:var(--v258-focus)}
body.vano-live-v258.vano-page-surface .container,
body.vano-shared-v258.vano-page-surface .container{width:min(1160px,calc(100% - 34px));margin-inline:auto}
body.vano-live-v258.vano-page-surface .page,
body.vano-shared-v258.vano-page-surface .page{padding:34px 0 92px;min-height:calc(100dvh - 72px)}

body.vano-live-v258.vano-page-surface .topbar,
body.vano-shared-v258.vano-page-surface .topbar{
  position:sticky;top:0;z-index:300;height:66px;
  border-bottom:1px solid color-mix(in srgb,var(--v258-line) 80%,transparent);
  background:color-mix(in srgb,var(--v258-bg) 87%,transparent);
  backdrop-filter:blur(18px) saturate(145%);-webkit-backdrop-filter:blur(18px) saturate(145%);
  box-shadow:none;
}
body.vano-live-v258.vano-page-surface .nav,
body.vano-shared-v258.vano-page-surface .nav{width:min(1160px,calc(100% - 34px));height:100%;margin:auto;display:flex;align-items:center;gap:18px}
body.vano-live-v258.vano-page-surface .brand,
body.vano-shared-v258.vano-page-surface .brand{gap:9px;color:var(--v258-ink);text-decoration:none;font-weight:900;letter-spacing:-.35px}
body.vano-live-v258.vano-page-surface .brand:before,
body.vano-shared-v258.vano-page-surface .brand:before{display:none}
body.vano-live-v258.vano-page-surface .vano-brand-wordmark,
body.vano-shared-v258.vano-page-surface .vano-brand-wordmark{width:124px;max-height:34px;object-fit:contain;object-position:left center}
body.vano-live-v258.vano-page-surface .brand>span:not(.vano-adaptive-brand),
body.vano-shared-v258.vano-page-surface .brand>span:not(.vano-adaptive-brand){display:none}

/* V259 — adaptive VANO brand: dark mode uses the white-letter banner asset. */
body.vano-live-v258 .vano-adaptive-brand,
body.vano-shared-v258 .vano-adaptive-brand{position:relative;display:inline-grid!important;align-items:center;justify-items:start;line-height:0}
body.vano-live-v258 .vano-adaptive-brand>.vano-brand-img,
body.vano-shared-v258 .vano-adaptive-brand>.vano-brand-img{grid-area:1/1;display:block;max-width:100%;height:auto;object-fit:contain;transition:opacity .16s ease,visibility .16s ease}
body.vano-live-v258 .vano-adaptive-brand>.vano-brand-img-dark,
body.vano-shared-v258 .vano-adaptive-brand>.vano-brand-img-dark{opacity:0!important;visibility:hidden!important;pointer-events:none!important}
body.vano-live-v258 .vano-adaptive-brand>.vano-brand-img-light,
body.vano-shared-v258 .vano-adaptive-brand>.vano-brand-img-light{opacity:1!important;visibility:visible!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-adaptive-brand>.vano-brand-img-light,
html[data-vano-theme="black"] body.vano-shared-v258 .vano-adaptive-brand>.vano-brand-img-light{opacity:0!important;visibility:hidden!important;pointer-events:none!important}
html[data-vano-theme="black"] body.vano-live-v258 .vano-adaptive-brand>.vano-brand-img-dark,
html[data-vano-theme="black"] body.vano-shared-v258 .vano-adaptive-brand>.vano-brand-img-dark{opacity:1!important;visibility:visible!important}
body.vano-live-v258.vano-page-surface .vano-nav-brand,
body.vano-shared-v258.vano-page-surface .vano-nav-brand{min-width:132px!important;display:inline-flex!important;align-items:center!important}
body.vano-live-v258.vano-page-surface .vano-nav-brand-images,
body.vano-shared-v258.vano-page-surface .vano-nav-brand-images{width:132px!important;height:38px!important}
body.vano-live-v258.vano-page-surface .vano-nav-brand-images>.vano-brand-img,
body.vano-shared-v258.vano-page-surface .vano-nav-brand-images>.vano-brand-img{width:auto!important;height:38px!important;max-width:132px!important;object-position:left center!important}
body.vano-live-v258 .vano-auth-banner-clean.vano-adaptive-brand,
body.vano-live-v258 .vano-auth-banner-frame.vano-adaptive-brand,
body.vano-shared-v258 .vano-auth-banner-clean.vano-adaptive-brand,
body.vano-shared-v258 .vano-auth-banner-frame.vano-adaptive-brand{display:inline-grid!important}
body.vano-live-v258 .vano-mini-brand,
body.vano-shared-v258 .vano-mini-brand{width:138px;max-width:46vw}
body.vano-live-v258 .vano-share-brand,
body.vano-shared-v258 .vano-share-brand{width:150px;max-width:50vw}

body.vano-live-v258.vano-page-surface .navlinks,
body.vano-shared-v258.vano-page-surface .navlinks{display:flex;align-items:center;gap:4px;margin-left:10px}
body.vano-live-v258.vano-page-surface .navlinks a,
body.vano-live-v258.vano-page-surface .navlinks button.navbtn,
body.vano-shared-v258.vano-page-surface .navlinks a,
body.vano-shared-v258.vano-page-surface .navlinks button.navbtn{
  min-height:38px;padding:0 12px;border:0;border-radius:12px;background:transparent;color:var(--v258-copy);
  font-size:13px;font-weight:760;text-decoration:none;display:flex;align-items:center;
}
body.vano-live-v258.vano-page-surface .navlinks a:hover,
body.vano-live-v258.vano-page-surface .navlinks a.active,
body.vano-shared-v258.vano-page-surface .navlinks a:hover,
body.vano-shared-v258.vano-page-surface .navlinks a.active{background:var(--v258-surface);color:var(--v258-ink);box-shadow:0 0 0 1px var(--v258-line)}
body.vano-live-v258.vano-page-surface .nav-actions,
body.vano-shared-v258.vano-page-surface .nav-actions{margin-left:auto;display:flex;align-items:center;gap:8px;color:var(--v258-copy)}
body.vano-live-v258.vano-page-surface .nav-actions form,
body.vano-shared-v258.vano-page-surface .nav-actions form{margin:0}
body.vano-live-v258.vano-page-surface .vano-theme-toggle,
body.vano-shared-v258.vano-page-surface .vano-theme-toggle{border:1px solid var(--v258-line);background:var(--v258-surface);color:var(--v258-copy);box-shadow:none}

body.vano-live-v258.vano-page-surface .btn,
body.vano-shared-v258.vano-page-surface .btn{
  min-height:42px;padding:0 15px;border:1px solid var(--v258-line);border-radius:13px;background:var(--v258-surface);color:var(--v258-ink);
  box-shadow:none;font-weight:800;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;
}
body.vano-live-v258.vano-page-surface .btn:hover,
body.vano-shared-v258.vano-page-surface .btn:hover{border-color:var(--v258-line-strong);background:var(--v258-surface-2);transform:none}
body.vano-live-v258.vano-page-surface .btn:active,
body.vano-shared-v258.vano-page-surface .btn:active{transform:scale(.985)}
body.vano-live-v258.vano-page-surface .btn-primary,
body.vano-shared-v258.vano-page-surface .btn-primary{border-color:transparent;background:linear-gradient(135deg,var(--v258-brand-2),var(--v258-brand));color:#fff;box-shadow:0 10px 24px rgba(217,112,63,.18)}
body.vano-live-v258.vano-page-surface .btn-primary:hover,
body.vano-shared-v258.vano-page-surface .btn-primary:hover{background:linear-gradient(135deg,#f7a470,var(--v258-brand));box-shadow:0 12px 28px rgba(217,112,63,.22)}
body.vano-live-v258.vano-page-surface .btn-ghost,
body.vano-shared-v258.vano-page-surface .btn-ghost{background:transparent}
body.vano-live-v258.vano-page-surface .btn-sm,
body.vano-shared-v258.vano-page-surface .btn-sm{min-height:38px;padding-inline:12px}

body.vano-live-v258.vano-page-surface .page-head,
body.vano-shared-v258.vano-page-surface .page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin:0 0 22px}
body.vano-live-v258.vano-page-surface .eyebrow,
body.vano-shared-v258.vano-page-surface .eyebrow{color:var(--v258-brand);font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
body.vano-live-v258.vano-page-surface .page-title,
body.vano-live-v258.vano-page-surface .title,
body.vano-shared-v258.vano-page-surface .page-title,
body.vano-shared-v258.vano-page-surface .title{margin:5px 0 0;color:var(--v258-ink);font-size:clamp(28px,4vw,42px);line-height:1.02;letter-spacing:-1.5px}
body.vano-live-v258.vano-page-surface .page-subtitle,
body.vano-live-v258.vano-page-surface .subtitle,
body.vano-live-v258.vano-page-surface .muted,
body.vano-shared-v258.vano-page-surface .page-subtitle,
body.vano-shared-v258.vano-page-surface .subtitle,
body.vano-shared-v258.vano-page-surface .muted{color:var(--v258-copy);line-height:1.55}

body.vano-live-v258.vano-page-surface .panel,
body.vano-live-v258.vano-page-surface .card,
body.vano-live-v258.vano-page-surface .kpi,
body.vano-live-v258.vano-page-surface .alert-card,
body.vano-shared-v258.vano-page-surface .panel,
body.vano-shared-v258.vano-page-surface .card,
body.vano-shared-v258.vano-page-surface .kpi,
body.vano-shared-v258.vano-page-surface .alert-card{
  border:1px solid var(--v258-line);background:var(--v258-surface);color:var(--v258-ink);box-shadow:var(--v258-shadow-soft)
}
body.vano-live-v258.vano-page-surface .panel,
body.vano-shared-v258.vano-page-surface .panel{border-radius:var(--v258-radius);overflow:hidden}
body.vano-live-v258.vano-page-surface .panel-head,
body.vano-shared-v258.vano-page-surface .panel-head{padding:18px 20px;border-bottom:1px solid var(--v258-line)}
body.vano-live-v258.vano-page-surface .panel-body,
body.vano-shared-v258.vano-page-surface .panel-body{padding:20px}
body.vano-live-v258.vano-page-surface .card,
body.vano-shared-v258.vano-page-surface .card{border-radius:18px;padding:20px}
body.vano-live-v258.vano-page-surface .kpi,
body.vano-shared-v258.vano-page-surface .kpi{border-radius:18px;padding:18px}
body.vano-live-v258.vano-page-surface .alert-card,
body.vano-shared-v258.vano-page-surface .alert-card{border-radius:16px;padding:15px}
body.vano-live-v258.vano-page-surface .panel:hover,
body.vano-live-v258.vano-page-surface .card:hover,
body.vano-shared-v258.vano-page-surface .panel:hover,
body.vano-shared-v258.vano-page-surface .card:hover{border-color:var(--v258-line-strong)}

body.vano-live-v258.vano-page-surface .input,
body.vano-live-v258.vano-page-surface .select,
body.vano-live-v258.vano-page-surface .textarea,
body.vano-live-v258.vano-page-surface input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]),
body.vano-live-v258.vano-page-surface select,
body.vano-live-v258.vano-page-surface textarea,
body.vano-shared-v258.vano-page-surface .input,
body.vano-shared-v258.vano-page-surface .select,
body.vano-shared-v258.vano-page-surface .textarea,
body.vano-shared-v258.vano-page-surface input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]),
body.vano-shared-v258.vano-page-surface select,
body.vano-shared-v258.vano-page-surface textarea{
  width:100%;min-height:46px;border:1px solid var(--v258-line-strong);border-radius:13px;background:var(--v258-surface);color:var(--v258-ink);padding:11px 13px;outline:0;box-shadow:none;
}
body.vano-live-v258.vano-page-surface textarea,
body.vano-shared-v258.vano-page-surface textarea{min-height:112px;resize:vertical}
body.vano-live-v258.vano-page-surface input::placeholder,
body.vano-live-v258.vano-page-surface textarea::placeholder,
body.vano-shared-v258.vano-page-surface input::placeholder,
body.vano-shared-v258.vano-page-surface textarea::placeholder{color:var(--v258-muted)}
body.vano-live-v258.vano-page-surface input:focus,
body.vano-live-v258.vano-page-surface select:focus,
body.vano-live-v258.vano-page-surface textarea:focus,
body.vano-shared-v258.vano-page-surface input:focus,
body.vano-shared-v258.vano-page-surface select:focus,
body.vano-shared-v258.vano-page-surface textarea:focus{border-color:var(--v258-brand);box-shadow:var(--v258-focus)}
body.vano-live-v258.vano-page-surface label>span:first-child,
body.vano-shared-v258.vano-page-surface label>span:first-child{color:var(--v258-copy)}

body.vano-live-v258.vano-page-surface .table-wrap,
body.vano-shared-v258.vano-page-surface .table-wrap{border:1px solid var(--v258-line);border-radius:18px;overflow:auto;background:var(--v258-surface)}
body.vano-live-v258.vano-page-surface .table,
body.vano-shared-v258.vano-page-surface .table{width:100%;border-collapse:collapse}
body.vano-live-v258.vano-page-surface .table th,
body.vano-shared-v258.vano-page-surface .table th{background:var(--v258-surface-2);color:var(--v258-muted);font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;text-align:left}
body.vano-live-v258.vano-page-surface .table th,
body.vano-live-v258.vano-page-surface .table td,
body.vano-shared-v258.vano-page-surface .table th,
body.vano-shared-v258.vano-page-surface .table td{padding:13px 14px;border-bottom:1px solid var(--v258-line)}
body.vano-live-v258.vano-page-surface .table td,
body.vano-shared-v258.vano-page-surface .table td{color:var(--v258-copy);font-size:12px}
body.vano-live-v258.vano-page-surface .table tr:last-child td,
body.vano-shared-v258.vano-page-surface .table tr:last-child td{border-bottom:0}
body.vano-live-v258.vano-page-surface .table tr:hover td,
body.vano-shared-v258.vano-page-surface .table tr:hover td{background:var(--v258-surface-2)}

body.vano-live-v258.vano-page-surface .flash-wrap,
body.vano-shared-v258.vano-page-surface .flash-wrap{position:fixed;z-index:1000;top:78px;left:50%;transform:translateX(-50%);width:min(480px,calc(100% - 24px));display:grid;gap:8px}
body.vano-live-v258.vano-page-surface .flash,
body.vano-shared-v258.vano-page-surface .flash{border:1px solid var(--v258-line);border-radius:14px;background:var(--v258-surface);color:var(--v258-ink);box-shadow:var(--v258-shadow);backdrop-filter:blur(14px)}

body.vano-live-v258.vano-page-surface footer,
body.vano-shared-v258.vano-page-surface footer{border-top:1px solid var(--v258-line);background:color-mix(in srgb,var(--v258-bg) 85%,transparent);color:var(--v258-muted)}
body.vano-live-v258.vano-page-surface footer a,
body.vano-shared-v258.vano-page-surface footer a{color:var(--v258-copy);text-decoration:none}

/* ----------------------------- Auth basics ----------------------------- */
body.vano-live-v258.vano-page-surface .auth-wrap,
body.vano-shared-v258.vano-page-surface .auth-wrap{min-height:calc(100dvh - 66px);padding:38px 18px 100px;display:grid;place-items:start center;background:transparent}
body.vano-live-v258.vano-page-surface .auth-card,
body.vano-shared-v258.vano-page-surface .auth-card{width:min(480px,100%);margin-top:5vh;padding:28px;border:1px solid var(--v258-line);border-radius:26px;background:var(--v258-surface);color:var(--v258-ink);box-shadow:var(--v258-shadow)}
body.vano-live-v258.vano-page-surface .auth-card h1,
body.vano-shared-v258.vano-page-surface .auth-card h1{margin:12px 0 8px;color:var(--v258-ink);font-size:30px;letter-spacing:-1px}
body.vano-live-v258.vano-page-surface .auth-card .page-subtitle,
body.vano-shared-v258.vano-page-surface .auth-card .page-subtitle{margin-bottom:20px}
body.vano-live-v258.vano-page-surface .auth-card .tiny,
body.vano-shared-v258.vano-page-surface .auth-card .tiny{color:var(--v258-muted)}
body.vano-live-v258.vano-page-surface .vano-auth-banner-frame,
body.vano-shared-v258.vano-page-surface .vano-auth-banner-frame{border:0;background:transparent;box-shadow:none}
body.vano-live-v258.vano-page-surface .vano-auth-banner,
body.vano-shared-v258.vano-page-surface .vano-auth-banner{max-width:180px;height:auto}

/* --------------------------- Generic content pages --------------------------- */
body.vano-live-v258.vano-route-about .section,
body.vano-live-v258.vano-route-sobre .section,
body.vano-shared-v258.vano-route-about .section,
body.vano-shared-v258.vano-route-sobre .section{margin-top:26px}
body.vano-live-v258.vano-route-about .grid-3,
body.vano-shared-v258.vano-route-about .grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
body.vano-live-v258.vano-route-about .iconbox,
body.vano-shared-v258.vano-route-about .iconbox{background:var(--v258-brand-soft);color:var(--v258-brand);border-radius:14px}
body.vano-live-v258:is(.vano-route-privacy-policy,.vano-route-terms-of-use) .legal-copy,
body.vano-shared-v258:is(.vano-route-privacy-policy,.vano-route-terms-of-use) .legal-copy{max-width:850px;color:var(--v258-copy);font-size:14px;line-height:1.75}
body.vano-live-v258:is(.vano-route-privacy-policy,.vano-route-terms-of-use) .legal-copy h2,
body.vano-shared-v258:is(.vano-route-privacy-policy,.vano-route-terms-of-use) .legal-copy h2{color:var(--v258-ink);margin-top:28px;letter-spacing:-.45px}
body.vano-live-v258.vano-route-error .panel,
body.vano-shared-v258.vano-route-error .panel{max-width:650px;margin:8vh auto 0;text-align:center}
body.vano-live-v258.vano-route-error .code-num,
body.vano-shared-v258.vano-route-error .code-num{color:var(--v258-brand);font-weight:950}

/* --------------------------- Help / notifications --------------------------- */
body.vano-live-v258.vano-route-help-page .faq-shell,
body.vano-shared-v258.vano-route-help-page .faq-shell{max-width:820px}
body.vano-live-v258.vano-route-help-page .faq-hero h1,
body.vano-shared-v258.vano-route-help-page .faq-hero h1{color:var(--v258-ink)}
body.vano-live-v258.vano-route-help-page .faq-hero p,
body.vano-shared-v258.vano-route-help-page .faq-hero p{color:var(--v258-copy)}
body.vano-live-v258.vano-route-help-page .faq-search,
body.vano-shared-v258.vano-route-help-page .faq-search{height:50px;border:1px solid var(--v258-line-strong);border-radius:15px;background:var(--v258-surface);color:var(--v258-ink);box-shadow:var(--v258-shadow-soft)}
body.vano-live-v258.vano-route-help-page .faq details,
body.vano-shared-v258.vano-route-help-page .faq details{border:1px solid var(--v258-line);border-radius:16px;background:var(--v258-surface);box-shadow:0 4px 18px rgba(67,49,38,.035)}
body.vano-live-v258.vano-route-help-page .faq summary,
body.vano-shared-v258.vano-route-help-page .faq summary{color:var(--v258-ink);font-size:13px}
body.vano-live-v258.vano-route-help-page .faq details p,
body.vano-shared-v258.vano-route-help-page .faq details p{color:var(--v258-copy)}
body.vano-live-v258.vano-route-notifications-page .notif-shell,
body.vano-shared-v258.vano-route-notifications-page .notif-shell{max-width:820px;margin:auto}
body.vano-live-v258.vano-route-notifications-page .notif-head,
body.vano-shared-v258.vano-route-notifications-page .notif-head{margin-bottom:18px}
body.vano-live-v258.vano-route-notifications-page .notif-list,
body.vano-shared-v258.vano-route-notifications-page .notif-list{display:grid;gap:10px}
body.vano-live-v258.vano-route-notifications-page .notif-list>*,
body.vano-shared-v258.vano-route-notifications-page .notif-list>*{border-color:var(--v258-line);background:var(--v258-surface);box-shadow:var(--v258-shadow-soft)}
body.vano-live-v258.vano-route-notifications-page .notif-icon,
body.vano-shared-v258.vano-route-notifications-page .notif-icon{background:var(--v258-brand-soft);color:var(--v258-brand)}

/* --------------------------- Report / alerts --------------------------- */
body.vano-live-v258.vano-route-alerts-page .alert-card,
body.vano-shared-v258.vano-route-alerts-page .alert-card{display:grid;gap:8px}
body.vano-live-v258.vano-route-alerts-page .severity,
body.vano-live-v258.vano-route-alerts-page .badge,
body.vano-shared-v258.vano-route-alerts-page .severity,
body.vano-shared-v258.vano-route-alerts-page .badge{border:1px solid var(--v258-line);background:var(--v258-surface-2);color:var(--v258-copy)}
body.vano-live-v258.vano-route-report-page .split,
body.vano-shared-v258.vano-route-report-page .split{gap:16px}
body.vano-live-v258.vano-route-report-page #reportMap,
body.vano-shared-v258.vano-route-report-page #reportMap{border-color:var(--v258-line)!important;box-shadow:var(--v258-shadow-soft)}
body.vano-live-v258.vano-route-report-page .pick-note,
body.vano-shared-v258.vano-route-report-page .pick-note{color:var(--v258-copy)}

/* --------------------------- Onboarding --------------------------- */
body.vano-live-v258.vano-route-onboarding,
body.vano-shared-v258.vano-route-onboarding{background:var(--v258-bg)}
body.vano-live-v258.vano-route-onboarding .onboard,
body.vano-shared-v258.vano-route-onboarding .onboard{min-height:calc(100dvh - 66px);padding:34px 17px 100px;background:transparent;color:var(--v258-ink)}
body.vano-live-v258.vano-route-onboarding .ob-shell,
body.vano-shared-v258.vano-route-onboarding .ob-shell{width:min(900px,100%);margin:auto;border:1px solid var(--v258-line);border-radius:28px;background:var(--v258-surface);box-shadow:var(--v258-shadow);overflow:hidden}
body.vano-live-v258.vano-route-onboarding .ob-top,
body.vano-shared-v258.vano-route-onboarding .ob-top{border-bottom:1px solid var(--v258-line);background:var(--v258-surface-2)}
body.vano-live-v258.vano-route-onboarding .ob-head h1,
body.vano-shared-v258.vano-route-onboarding .ob-head h1{color:var(--v258-ink);letter-spacing:-1.2px}
body.vano-live-v258.vano-route-onboarding .ob-head p,
body.vano-shared-v258.vano-route-onboarding .ob-head p{color:var(--v258-copy)}
body.vano-live-v258.vano-route-onboarding .ob-section,
body.vano-shared-v258.vano-route-onboarding .ob-section{border:1px solid var(--v258-line);background:var(--v258-surface-2);border-radius:18px}
body.vano-live-v258.vano-route-onboarding .ob-section-title,
body.vano-live-v258.vano-route-onboarding .choice b,
body.vano-shared-v258.vano-route-onboarding .ob-section-title,
body.vano-shared-v258.vano-route-onboarding .choice b{color:var(--v258-ink)}
body.vano-live-v258.vano-route-onboarding .choice,
body.vano-shared-v258.vano-route-onboarding .choice{border-color:var(--v258-line);background:var(--v258-surface)}
body.vano-live-v258.vano-route-onboarding .choice:has(input:checked),
body.vano-shared-v258.vano-route-onboarding .choice:has(input:checked){border-color:var(--v258-brand);background:var(--v258-brand-soft);box-shadow:var(--v258-focus)}
body.vano-live-v258.vano-route-onboarding .step-pill,
body.vano-shared-v258.vano-route-onboarding .step-pill{background:var(--v258-brand-soft);color:var(--v258-brand)}

/* --------------------------- Register --------------------------- */
body.vano-live-v258.vano-route-register .vano-entry,
body.vano-shared-v258.vano-route-register .vano-entry{min-height:calc(100dvh - 66px);background:transparent;color:var(--v258-ink);padding-bottom:92px}
body.vano-live-v258.vano-route-register .v63-entry-shell,
body.vano-shared-v258.vano-route-register .v63-entry-shell{width:min(1040px,calc(100% - 32px));margin:30px auto;gap:18px}
body.vano-live-v258.vano-route-register .v63-entry-panel,
body.vano-shared-v258.vano-route-register .v63-entry-panel{border:1px solid var(--v258-line);border-radius:28px;background:var(--v258-surface);color:var(--v258-ink);box-shadow:var(--v258-shadow)}
body.vano-live-v258.vano-route-register .v63-entry-kicker,
body.vano-shared-v258.vano-route-register .v63-entry-kicker{color:var(--v258-brand)}
body.vano-live-v258.vano-route-register .v63-entry-panel h1,
body.vano-live-v258.vano-route-register .v63-auth-label,
body.vano-shared-v258.vano-route-register .v63-entry-panel h1,
body.vano-shared-v258.vano-route-register .v63-auth-label{color:var(--v258-ink)}
body.vano-live-v258.vano-route-register .v63-entry-lead,
body.vano-live-v258.vano-route-register .v63-entry-proof,
body.vano-live-v258.vano-route-register .v63-entry-footer,
body.vano-shared-v258.vano-route-register .v63-entry-lead,
body.vano-shared-v258.vano-route-register .v63-entry-proof,
body.vano-shared-v258.vano-route-register .v63-entry-footer{color:var(--v258-copy)}
body.vano-live-v258.vano-route-register .auth-google,
body.vano-live-v258.vano-route-register .auth-email,
body.vano-live-v258.vano-route-register .auth-field,
body.vano-shared-v258.vano-route-register .auth-google,
body.vano-shared-v258.vano-route-register .auth-email,
body.vano-shared-v258.vano-route-register .auth-field{border-color:var(--v258-line-strong);background:var(--v258-surface);color:var(--v258-ink)}
body.vano-live-v258.vano-route-register .auth-google-primary,
body.vano-shared-v258.vano-route-register .auth-google-primary{box-shadow:var(--v258-shadow-soft)}
body.vano-live-v258.vano-route-register .vano-splash,
body.vano-shared-v258.vano-route-register .vano-splash{background:var(--v258-bg)}

/* --------------------------- Profile --------------------------- */
body.vano-live-v258.vano-route-profile .v72-profile-page,
body.vano-shared-v258.vano-route-profile .v72-profile-page{background:transparent!important;color:var(--v258-ink)!important}
body.vano-live-v258.vano-route-profile .profile-v72-shell,
body.vano-shared-v258.vano-route-profile .profile-v72-shell{width:min(980px,100%);display:grid;gap:14px}
body.vano-live-v258.vano-route-profile .profile-v72-hero,
body.vano-shared-v258.vano-route-profile .profile-v72-hero{border:1px solid var(--v258-line)!important;border-radius:24px!important;background:linear-gradient(145deg,var(--v258-surface),var(--v258-surface-2))!important;box-shadow:var(--v258-shadow-soft)!important;color:var(--v258-ink)!important}
body.vano-live-v258.vano-route-profile .profile-v72-copy h1,
body.vano-shared-v258.vano-route-profile .profile-v72-copy h1{color:var(--v258-ink)!important;font-size:clamp(25px,5vw,36px)!important;letter-spacing:-1.1px!important}
body.vano-live-v258.vano-route-profile .profile-v72-copy p,
body.vano-shared-v258.vano-route-profile .profile-v72-copy p{color:var(--v258-copy)!important}
body.vano-live-v258.vano-route-profile .profile-v72-eyebrow,
body.vano-shared-v258.vano-route-profile .profile-v72-eyebrow{color:var(--v258-brand)!important}
body.vano-live-v258.vano-route-profile .profile-v72-badge,
body.vano-shared-v258.vano-route-profile .profile-v72-badge{border-color:var(--v258-line)!important;background:var(--v258-surface)!important;color:var(--v258-copy)!important}
body.vano-live-v258.vano-route-profile .profile-v72-map-button,
body.vano-shared-v258.vano-route-profile .profile-v72-map-button{border-color:transparent!important;background:linear-gradient(135deg,var(--v258-brand-2),var(--v258-brand))!important;color:white!important;box-shadow:0 10px 24px rgba(217,112,63,.16)!important}
body.vano-live-v258.vano-route-profile .profile-v108-quicknav,
body.vano-shared-v258.vano-route-profile .profile-v108-quicknav{gap:10px!important}
body.vano-live-v258.vano-route-profile .profile-v108-quicknav a,
body.vano-shared-v258.vano-route-profile .profile-v108-quicknav a{border:1px solid var(--v258-line)!important;border-radius:17px!important;background:var(--v258-surface)!important;color:var(--v258-ink)!important;box-shadow:0 4px 18px rgba(67,49,38,.04)!important}
body.vano-live-v258.vano-route-profile .profile-v108-quicknav a:hover,
body.vano-shared-v258.vano-route-profile .profile-v108-quicknav a:hover{border-color:var(--v258-line-strong)!important;transform:translateY(-1px)}
body.vano-live-v258.vano-route-profile .profile-v108-quicknav small,
body.vano-shared-v258.vano-route-profile .profile-v108-quicknav small{color:var(--v258-muted)!important}
body.vano-live-v258.vano-route-profile .profile-v108-quick-icon,
body.vano-live-v258.vano-route-profile .profile-v72-detail-icon,
body.vano-shared-v258.vano-route-profile .profile-v108-quick-icon,
body.vano-shared-v258.vano-route-profile .profile-v72-detail-icon{background:var(--v258-brand-soft)!important;color:var(--v258-brand)!important}
body.vano-live-v258.vano-route-profile .profile-v72-form,
body.vano-shared-v258.vano-route-profile .profile-v72-form{display:grid;gap:10px}
body.vano-live-v258.vano-route-profile .profile-v72-detail,
body.vano-shared-v258.vano-route-profile .profile-v72-detail{border:1px solid var(--v258-line)!important;border-radius:19px!important;background:var(--v258-surface)!important;color:var(--v258-ink)!important;box-shadow:0 4px 18px rgba(67,49,38,.035)!important;overflow:hidden}
body.vano-live-v258.vano-route-profile .profile-v72-detail>summary,
body.vano-shared-v258.vano-route-profile .profile-v72-detail>summary{min-height:70px!important;padding:13px 15px!important;background:transparent!important;color:var(--v258-ink)!important}
body.vano-live-v258.vano-route-profile .profile-v72-detail[open]>summary,
body.vano-shared-v258.vano-route-profile .profile-v72-detail[open]>summary{border-bottom:1px solid var(--v258-line)!important;background:var(--v258-surface-2)!important}
body.vano-live-v258.vano-route-profile .profile-v72-detail-copy b,
body.vano-live-v258.vano-route-profile .profile-v72-subhead b,
body.vano-live-v258.vano-route-profile .profile-v72-place-head b,
body.vano-shared-v258.vano-route-profile .profile-v72-detail-copy b,
body.vano-shared-v258.vano-route-profile .profile-v72-subhead b,
body.vano-shared-v258.vano-route-profile .profile-v72-place-head b{color:var(--v258-ink)!important}
body.vano-live-v258.vano-route-profile .profile-v72-detail-copy small,
body.vano-live-v258.vano-route-profile .profile-v72-subcopy,
body.vano-shared-v258.vano-route-profile .profile-v72-detail-copy small,
body.vano-shared-v258.vano-route-profile .profile-v72-subcopy{color:var(--v258-muted)!important}
body.vano-live-v258.vano-route-profile .profile-v72-detail-body,
body.vano-shared-v258.vano-route-profile .profile-v72-detail-body{background:var(--v258-surface)!important}
body.vano-live-v258.vano-route-profile .profile-v72-field input,
body.vano-live-v258.vano-route-profile .profile-v72-field select,
body.vano-live-v258.vano-route-profile .profile-v72-place input,
body.vano-shared-v258.vano-route-profile .profile-v72-field input,
body.vano-shared-v258.vano-route-profile .profile-v72-field select,
body.vano-shared-v258.vano-route-profile .profile-v72-place input{border-color:var(--v258-line-strong)!important;background:var(--v258-surface)!important;color:var(--v258-ink)!important}
body.vano-live-v258.vano-route-profile .profile-v72-note,
body.vano-shared-v258.vano-route-profile .profile-v72-note{border-color:var(--v258-line)!important;background:var(--v258-brand-soft)!important;color:var(--v258-copy)!important}
body.vano-live-v258.vano-route-profile .profile-v72-nav-pref,
body.vano-live-v258.vano-route-profile .profile-v72-map-style,
body.vano-shared-v258.vano-route-profile .profile-v72-nav-pref,
body.vano-shared-v258.vano-route-profile .profile-v72-map-style{border-color:var(--v258-line)!important;background:var(--v258-surface-2)!important;color:var(--v258-ink)!important}
body.vano-live-v258.vano-route-profile .profile-v72-nav-pref:has(input:checked),
body.vano-live-v258.vano-route-profile .profile-v72-map-style:has(input:checked),
body.vano-shared-v258.vano-route-profile .profile-v72-nav-pref:has(input:checked),
body.vano-shared-v258.vano-route-profile .profile-v72-map-style:has(input:checked){border-color:color-mix(in srgb,var(--v258-brand) 55%,var(--v258-line))!important;background:var(--v258-brand-soft)!important}
body.vano-live-v258.vano-route-profile .profile-v72-save,
body.vano-shared-v258.vano-route-profile .profile-v72-save{border:0!important;border-radius:17px!important;background:linear-gradient(135deg,var(--v258-brand-2),var(--v258-brand))!important;color:#fff!important;box-shadow:0 12px 28px rgba(217,112,63,.18)!important}
body.vano-live-v258.vano-route-profile .profile-v72-links a,
body.vano-shared-v258.vano-route-profile .profile-v72-links a{border-color:var(--v258-line)!important;background:var(--v258-surface)!important;color:var(--v258-ink)!important}
body.vano-live-v258.vano-route-profile .profile-v72-links small,
body.vano-shared-v258.vano-route-profile .profile-v72-links small{color:var(--v258-muted)!important}

/* --------------------------- Admin system --------------------------- */
/* V259: admin is a dedicated surface. Keep the dashboard's own CSS in charge of
   geometry and use this layer only for theme, stacking and interaction safety. */
body.vano-live-v258.vano-admin-surface,
body.vano-shared-v258.vano-admin-surface{background:#f6f8fc!important;color:#202533!important;overflow-x:hidden!important}
body.vano-live-v258.vano-admin-surface:before,
body.vano-shared-v258.vano-admin-surface:before{pointer-events:none!important}
body.vano-live-v258.vano-admin-surface .mobile-dock,
body.vano-shared-v258.vano-admin-surface .mobile-dock{display:none!important}
body.vano-live-v258.vano-admin-surface :is(a,button,input,select,textarea,summary,[role="button"]),
body.vano-shared-v258.vano-admin-surface :is(a,button,input,select,textarea,summary,[role="button"]){pointer-events:auto}
body.vano-live-v258.vano-admin-surface :is(.admin240,.admin240-shell,.admin-users-v76,.radar-admin),
body.vano-shared-v258.vano-admin-surface :is(.admin240,.admin240-shell,.admin-users-v76,.radar-admin){position:relative;z-index:1}
body.vano-live-v258.vano-admin-surface .topbar,
body.vano-shared-v258.vano-admin-surface .topbar{z-index:700!important}
body.vano-live-v258.vano-route-admin-dashboard .admin240,
body.vano-shared-v258.vano-route-admin-dashboard .admin240{padding-bottom:max(72px,env(safe-area-inset-bottom))!important}
body.vano-live-v258.vano-route-admin-dashboard .admin240-shell,
body.vano-shared-v258.vano-route-admin-dashboard .admin240-shell{isolation:isolate!important}
body.vano-live-v258.vano-route-admin-dashboard .admin240-topbar,
body.vano-shared-v258.vano-route-admin-dashboard .admin240-topbar{position:relative!important;z-index:3!important}
body.vano-live-v258.vano-route-admin-dashboard .admin240-nav,
body.vano-shared-v258.vano-route-admin-dashboard .admin240-nav{position:relative!important;z-index:2!important}
body.vano-live-v258.vano-route-admin-dashboard .admin240 :is(.admin240-card,.admin240-kpi,.admin240-server),
body.vano-shared-v258.vano-route-admin-dashboard .admin240 :is(.admin240-card,.admin240-kpi,.admin240-server){position:relative}
body.vano-live-v258.vano-route-admin-dashboard .node-config-modal,
body.vano-shared-v258.vano-route-admin-dashboard .node-config-modal{z-index:5200!important}
body.vano-live-v258.vano-route-admin-dashboard .node-config-backdrop,
body.vano-shared-v258.vano-route-admin-dashboard .node-config-backdrop{z-index:0!important;pointer-events:auto!important}
body.vano-live-v258.vano-route-admin-dashboard .node-config-dialog,
body.vano-shared-v258.vano-route-admin-dashboard .node-config-dialog{z-index:1!important;pointer-events:auto!important}
body.vano-live-v258.vano-route-admin-dashboard .node-config-modal[hidden],
body.vano-shared-v258.vano-route-admin-dashboard .node-config-modal[hidden]{display:none!important}
body.vano-live-v258.vano-route-admin-dashboard .admin240 :is(.node-action,.admin240-primary,.admin240-ghost,.node-filter),
body.vano-shared-v258.vano-route-admin-dashboard .admin240 :is(.node-action,.admin240-primary,.admin240-ghost,.node-filter){touch-action:manipulation!important}

/* Light admin polish — does not alter the dashboard grid or JS hooks. */
body.vano-live-v258.vano-route-admin-dashboard .admin240,
body.vano-live-v258.vano-route-admin-dashboard .admin240-shell,
body.vano-shared-v258.vano-route-admin-dashboard .admin240,
body.vano-shared-v258.vano-route-admin-dashboard .admin240-shell{background:transparent!important;color:#202533!important}
body.vano-live-v258.vano-route-admin-dashboard .admin240-topbar,
body.vano-shared-v258.vano-route-admin-dashboard .admin240-topbar{border-color:#e1e5ec!important;background:rgba(255,255,255,.96)!important;box-shadow:0 12px 32px rgba(38,45,73,.06)!important}
body.vano-live-v258.vano-route-admin-dashboard :is(.admin240-card,.admin240-kpi,.admin240-server),
body.vano-shared-v258.vano-route-admin-dashboard :is(.admin240-card,.admin240-kpi,.admin240-server){border-color:#e4e8ee!important;background:#fff!important;color:#202533!important;box-shadow:0 8px 26px rgba(38,45,73,.045)!important}
body.vano-live-v258.vano-route-admin-dashboard :is(.admin240-card h2,.admin240-kpi b,.server-head h3),
body.vano-shared-v258.vano-route-admin-dashboard :is(.admin240-card h2,.admin240-kpi b,.server-head h3){color:#26303f!important}
body.vano-live-v258.vano-route-admin-dashboard :is(.admin240-card small,.admin240-kpi small,.server-head p),
body.vano-shared-v258.vano-route-admin-dashboard :is(.admin240-card small,.admin240-kpi small,.server-head p){color:#8791a0!important}
body.vano-live-v258.vano-route-admin-dashboard .admin240-nav a,
body.vano-shared-v258.vano-route-admin-dashboard .admin240-nav a{border-color:#e3e7ed!important;background:#fff!important;color:#4e5969!important}
body.vano-live-v258.vano-route-admin-dashboard .admin240-nav a:hover,
body.vano-shared-v258.vano-route-admin-dashboard .admin240-nav a:hover{background:#fff4ed!important;color:#d9703f!important}
body.vano-live-v258.vano-route-admin-dashboard :is(.node-search,.node-sort,.node-config-dialog),
body.vano-shared-v258.vano-route-admin-dashboard :is(.node-search,.node-sort,.node-config-dialog){border-color:#dfe4eb!important;background:#fff!important;color:#303a49!important}

/* Other admin pages keep their own template CSS; these rules only normalize theme. */
body.vano-live-v258:is(.vano-route-admin-users,.vano-route-admin-audit-logs,.vano-route-admin-server-detail) :is(.users-surface,.admin86-card,.activity-kpi,.admin-modal-card),
body.vano-shared-v258:is(.vano-route-admin-users,.vano-route-admin-audit-logs,.vano-route-admin-server-detail) :is(.users-surface,.admin86-card,.activity-kpi,.admin-modal-card){border-color:var(--v258-line)!important;background:var(--v258-surface)!important;color:var(--v258-ink)!important;box-shadow:var(--v258-shadow-soft)!important}
body.vano-live-v258.vano-route-admin-users .admin-user-modal,
body.vano-shared-v258.vano-route-admin-users .admin-user-modal{z-index:5200!important}
body.vano-live-v258.vano-route-admin-users .admin-modal-backdrop,
body.vano-shared-v258.vano-route-admin-users .admin-modal-backdrop{pointer-events:auto!important}
body.vano-live-v258.vano-route-admin-users .admin-modal-card,
body.vano-shared-v258.vano-route-admin-users .admin-modal-card{position:relative!important;z-index:1!important}
body.vano-live-v258.vano-route-admin-users .users-table tr,
body.vano-live-v258.vano-route-admin-users .users-table td,
body.vano-live-v258.vano-route-admin-users .users-table th,
body.vano-shared-v258.vano-route-admin-users .users-table tr,
body.vano-shared-v258.vano-route-admin-users .users-table td,
body.vano-shared-v258.vano-route-admin-users .users-table th{border-color:var(--v258-line)!important;color:var(--v258-copy)!important}
body.vano-live-v258.vano-route-admin-users .users-table th,
body.vano-shared-v258.vano-route-admin-users .users-table th{background:var(--v258-surface-2)!important;color:var(--v258-muted)!important}
body.vano-live-v258.vano-route-admin-users .user-name,
body.vano-live-v258.vano-route-admin-users .admin-modal-head h2,
body.vano-shared-v258.vano-route-admin-users .user-name,
body.vano-shared-v258.vano-route-admin-users .admin-modal-head h2{color:var(--v258-ink)!important}
body.vano-live-v258.vano-route-admin-users .know-more,
body.vano-shared-v258.vano-route-admin-users .know-more{background:var(--v258-brand-soft)!important;color:var(--v258-brand)!important;border-color:transparent!important}
body.vano-live-v258.vano-route-admin-finance :is(.finance-card,.finance-kpi,.account-list>*,.finance-modal-card),
body.vano-live-v258.vano-route-admin-risk-zones :is(.risk-card,.risk-zone-card),
body.vano-live-v258.vano-route-admin-radars :is(.ra-card,.ra-kpi),
body.vano-shared-v258.vano-route-admin-finance :is(.finance-card,.finance-kpi,.account-list>*,.finance-modal-card),
body.vano-shared-v258.vano-route-admin-risk-zones :is(.risk-card,.risk-zone-card),
body.vano-shared-v258.vano-route-admin-radars :is(.ra-card,.ra-kpi){border-color:var(--v258-line)!important;background:var(--v258-surface)!important;color:var(--v258-ink)!important;box-shadow:var(--v258-shadow-soft)!important}

/* Admin Black: dedicated colors while preserving original component geometry. */
html[data-vano-theme="black"] body.vano-live-v258.vano-admin-surface,
html[data-vano-theme="black"] body.vano-shared-v258.vano-admin-surface{background:#121315!important;color:#f5f6f7!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-admin-surface:before,
html[data-vano-theme="black"] body.vano-shared-v258.vano-admin-surface:before{background:radial-gradient(circle at 10% -10%,rgba(245,154,98,.08),transparent 22%),linear-gradient(180deg,#151618,#101113 60%,#0e0f11)!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-admin-surface .topbar,
html[data-vano-theme="black"] body.vano-shared-v258.vano-admin-surface .topbar{background:rgba(17,18,20,.94)!important;border-bottom-color:#2a2d31!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-route-admin-dashboard .admin240-topbar,
html[data-vano-theme="black"] body.vano-live-v258.vano-route-admin-dashboard :is(.admin240-card,.admin240-kpi,.admin240-server),
html[data-vano-theme="black"] body.vano-live-v258.vano-route-admin-dashboard :is(.node-search,.node-sort,.node-config-dialog),
html[data-vano-theme="black"] body.vano-live-v258.vano-route-admin-dashboard .admin240-nav a,
html[data-vano-theme="black"] body.vano-shared-v258.vano-route-admin-dashboard .admin240-topbar,
html[data-vano-theme="black"] body.vano-shared-v258.vano-route-admin-dashboard :is(.admin240-card,.admin240-kpi,.admin240-server),
html[data-vano-theme="black"] body.vano-shared-v258.vano-route-admin-dashboard :is(.node-search,.node-sort,.node-config-dialog),
html[data-vano-theme="black"] body.vano-shared-v258.vano-route-admin-dashboard .admin240-nav a{border-color:#30343a!important;background:#1a1c1f!important;color:#e8e9eb!important;box-shadow:none!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-route-admin-dashboard :is(.admin240-card h2,.admin240-kpi b,.server-head h3),
html[data-vano-theme="black"] body.vano-shared-v258.vano-route-admin-dashboard :is(.admin240-card h2,.admin240-kpi b,.server-head h3){color:#f5f6f7!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-route-admin-dashboard :is(.admin240-card small,.admin240-kpi small,.server-head p),
html[data-vano-theme="black"] body.vano-shared-v258.vano-route-admin-dashboard :is(.admin240-card small,.admin240-kpi small,.server-head p){color:#9aa0a8!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-route-admin-dashboard .admin240-nav a:hover,
html[data-vano-theme="black"] body.vano-shared-v258.vano-route-admin-dashboard .admin240-nav a:hover{background:#2a211d!important;color:#ffc39b!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-route-admin-users .admin-modal-backdrop,
html[data-vano-theme="black"] body.vano-live-v258.vano-route-admin-dashboard .node-config-backdrop,
html[data-vano-theme="black"] body.vano-shared-v258.vano-route-admin-users .admin-modal-backdrop,
html[data-vano-theme="black"] body.vano-shared-v258.vano-route-admin-dashboard .node-config-backdrop{background:rgba(0,0,0,.62)!important;backdrop-filter:blur(6px)!important}

/* --------------------------- Mobile dock --------------------------- */
body.vano-live-v258.vano-page-surface .mobile-dock,
body.vano-shared-v258.vano-page-surface .mobile-dock{
  position:fixed;z-index:350;left:10px;right:10px;bottom:max(8px,env(safe-area-inset-bottom));height:62px;
  padding:6px;border:1px solid var(--v258-line);border-radius:19px;background:color-mix(in srgb,var(--v258-surface) 94%,transparent);
  box-shadow:0 16px 40px rgba(43,31,23,.15);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)
}
body.vano-live-v258.vano-page-surface .mobile-dock a,
body.vano-shared-v258.vano-page-surface .mobile-dock a{border-radius:13px;color:var(--v258-muted);font-size:9px;font-weight:800}
body.vano-live-v258.vano-page-surface .mobile-dock a:hover,
body.vano-live-v258.vano-page-surface .mobile-dock a:active,
body.vano-shared-v258.vano-page-surface .mobile-dock a:hover,
body.vano-shared-v258.vano-page-surface .mobile-dock a:active{background:var(--v258-brand-soft);color:var(--v258-brand)}

/* --------------------------- MAP: account drawer only --------------------------- */
body.vano-live-v258.vano-map-surface .account-backdrop,
body.vano-shared-v258.vano-map-surface .account-backdrop{z-index:210!important;background:rgba(30,23,19,.30)!important;backdrop-filter:blur(5px)!important;-webkit-backdrop-filter:blur(5px)!important}
body.vano-live-v258.vano-map-surface .account-drawer,
body.vano-shared-v258.vano-map-surface .account-drawer{
  z-index:220!important;overflow:auto!important;overscroll-behavior:contain;
  border:1px solid rgba(222,211,203,.92)!important;background:rgba(255,252,249,.985)!important;color:#27231f!important;
  box-shadow:0 24px 70px rgba(47,34,27,.22)!important;backdrop-filter:blur(24px) saturate(135%)!important;-webkit-backdrop-filter:blur(24px) saturate(135%)!important;
}
body.vano-live-v258.vano-map-surface .drawer-grab,
body.vano-shared-v258.vano-map-surface .drawer-grab{width:42px!important;height:5px!important;margin:3px auto 12px!important;background:#d6cbc4!important}
body.vano-live-v258.vano-map-surface .v258-drawer-head,
body.vano-shared-v258.vano-map-surface .v258-drawer-head{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;margin-bottom:10px!important}
body.vano-live-v258.vano-map-surface .v258-drawer-brand,
body.vano-shared-v258.vano-map-surface .v258-drawer-brand{display:flex!important;align-items:center!important;gap:9px!important;min-width:0!important}
body.vano-live-v258.vano-map-surface .v258-drawer-brand img,
body.vano-shared-v258.vano-map-surface .v258-drawer-brand img{width:34px!important;height:34px!important;border-radius:11px!important;object-fit:contain!important}
body.vano-live-v258.vano-map-surface .v258-drawer-brand span,
body.vano-shared-v258.vano-map-surface .v258-drawer-brand span{display:block!important;color:#9a8f87!important;font-size:8px!important;font-weight:900!important;letter-spacing:.12em!important}
body.vano-live-v258.vano-map-surface .v258-drawer-brand b,
body.vano-shared-v258.vano-map-surface .v258-drawer-brand b{display:block!important;margin-top:1px!important;color:#27231f!important;font-size:12px!important;letter-spacing:-.2px!important}
body.vano-live-v258.vano-map-surface .v258-drawer-close,
body.vano-shared-v258.vano-map-surface .v258-drawer-close{width:36px!important;height:36px!important;border:1px solid #e9e0da!important;border-radius:12px!important;background:#f8f4f1!important;color:#665e58!important;display:grid!important;place-items:center!important}
body.vano-live-v258.vano-map-surface .drawer-user,
body.vano-shared-v258.vano-map-surface .drawer-user{display:grid!important;grid-template-columns:54px minmax(0,1fr) auto!important;gap:11px!important;align-items:center!important;padding:12px!important;border:1px solid #eee4de!important;border-radius:18px!important;background:#fff!important}
body.vano-live-v258.vano-map-surface .drawer-avatar,
body.vano-shared-v258.vano-map-surface .drawer-avatar{width:54px!important;height:54px!important;border-radius:17px!important;border:1px solid #eee2da!important;background:#fff2e9!important;color:#d9703f!important}
body.vano-live-v258.vano-map-surface .drawer-user b,
body.vano-shared-v258.vano-map-surface .drawer-user b{color:#27231f!important;font-size:14px!important;letter-spacing:-.25px!important}
body.vano-live-v258.vano-map-surface .drawer-user span,
body.vano-shared-v258.vano-map-surface .drawer-user span{color:#8d827a!important;font-size:9.5px!important}
body.vano-live-v258.vano-map-surface .drawer-profile,
body.vano-shared-v258.vano-map-surface .drawer-profile{min-height:34px!important;padding:0 11px!important;border:1px solid #f1d8c8!important;border-radius:11px!important;background:#fff0e7!important;color:#d9703f!important;font-size:9px!important;font-weight:900!important;text-decoration:none!important;display:flex!important;align-items:center!important}
body.vano-live-v258.vano-map-surface .v258-drawer-section,
body.vano-shared-v258.vano-map-surface .v258-drawer-section{margin-top:12px!important}
body.vano-live-v258.vano-map-surface .v258-drawer-label,
body.vano-shared-v258.vano-map-surface .v258-drawer-label{display:flex!important;justify-content:space-between!important;gap:10px!important;padding:0 3px 7px!important;color:#998d85!important;font-size:8px!important;font-weight:900!important;letter-spacing:.11em!important;text-transform:uppercase!important}
body.vano-live-v258.vano-map-surface .drawer-list,
body.vano-shared-v258.vano-map-surface .drawer-list{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
body.vano-live-v258.vano-map-surface .drawer-list form,
body.vano-shared-v258.vano-map-surface .drawer-list form{grid-column:1/-1!important;margin:0!important}
body.vano-live-v258.vano-map-surface .drawer-link,
body.vano-shared-v258.vano-map-surface .drawer-link{min-height:66px!important;height:auto!important;padding:11px!important;border:1px solid #ece2dc!important;border-radius:16px!important;background:#fff!important;color:#3d3732!important;display:grid!important;grid-template-columns:32px minmax(0,1fr) auto!important;align-items:center!important;gap:9px!important;text-decoration:none!important;font-size:10px!important;font-weight:850!important}
body.vano-live-v258.vano-map-surface .drawer-link>i:first-child,
body.vano-shared-v258.vano-map-surface .drawer-link>i:first-child{width:32px!important;height:32px!important;padding:8px!important;border-radius:10px!important;background:#fff0e7!important;color:#d9703f!important}
body.vano-live-v258.vano-map-surface .drawer-link .v258-link-copy,
body.vano-shared-v258.vano-map-surface .drawer-link .v258-link-copy{min-width:0!important}
body.vano-live-v258.vano-map-surface .drawer-link .v258-link-copy b,
body.vano-shared-v258.vano-map-surface .drawer-link .v258-link-copy b{display:block!important;color:#37312d!important;font-size:10.5px!important}
body.vano-live-v258.vano-map-surface .drawer-link .v258-link-copy small,
body.vano-shared-v258.vano-map-surface .drawer-link .v258-link-copy small{display:block!important;margin-top:2px!important;color:#988d85!important;font-size:7.5px!important;font-weight:650!important;line-height:1.25!important}
body.vano-live-v258.vano-map-surface .drawer-link:hover,
body.vano-live-v258.vano-map-surface .drawer-link:active,
body.vano-shared-v258.vano-map-surface .drawer-link:hover,
body.vano-shared-v258.vano-map-surface .drawer-link:active{background:#fff8f3!important;border-color:#efd8c9!important;color:#d9703f!important}
body.vano-live-v258.vano-map-surface .drawer-link.drawer-logout,
body.vano-shared-v258.vano-map-surface .drawer-link.drawer-logout{width:100%!important;min-height:48px!important;grid-template-columns:30px minmax(0,1fr)!important;background:#fffafa!important;border-color:#f1e1e2!important;color:#b9515a!important}
body.vano-live-v258.vano-map-surface .drawer-link.drawer-logout>i:first-child,
body.vano-shared-v258.vano-map-surface .drawer-link.drawer-logout>i:first-child{width:30px!important;height:30px!important;padding:7px!important;background:#fff0f1!important;color:#c75963!important}
body.vano-live-v258.vano-map-surface .drawer-divider,
body.vano-shared-v258.vano-map-surface .drawer-divider{display:none!important}
body.vano-live-v258.vano-map-surface .notif-count,
body.vano-shared-v258.vano-map-surface .notif-count{min-width:20px!important;height:20px!important;border-radius:999px!important;background:#d9703f!important;color:#fff!important;display:grid!important;place-items:center!important;font-size:8px!important;font-style:normal!important}
body.vano-live-v258.vano-map-surface .guest-drawer-content,
body.vano-shared-v258.vano-map-surface .guest-drawer-content{padding:0!important}
body.vano-live-v258.vano-map-surface .guest-drawer-top,
body.vano-shared-v258.vano-map-surface .guest-drawer-top{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important}
body.vano-live-v258.vano-map-surface .guest-drawer-brand,
body.vano-shared-v258.vano-map-surface .guest-drawer-brand{display:flex!important;align-items:center!important;gap:10px!important}
body.vano-live-v258.vano-map-surface .guest-drawer-brand img,
body.vano-shared-v258.vano-map-surface .guest-drawer-brand img{width:42px!important;height:42px!important;border-radius:13px!important}
body.vano-live-v258.vano-map-surface .guest-drawer-brand small,
body.vano-shared-v258.vano-map-surface .guest-drawer-brand small{display:block!important;color:#d9703f!important;font-size:8px!important;font-weight:900!important;letter-spacing:.12em!important}
body.vano-live-v258.vano-map-surface .guest-drawer-brand b,
body.vano-shared-v258.vano-map-surface .guest-drawer-brand b{display:block!important;margin-top:2px!important;color:#27231f!important;font-size:11px!important}
body.vano-live-v258.vano-map-surface .guest-drawer-close,
body.vano-shared-v258.vano-map-surface .guest-drawer-close{width:36px!important;height:36px!important;border:1px solid #e9e0da!important;border-radius:12px!important;background:#f8f4f1!important;color:#655d57!important;display:grid!important;place-items:center!important}
body.vano-live-v258.vano-map-surface .guest-drawer-content h3,
body.vano-shared-v258.vano-map-surface .guest-drawer-content h3{margin:18px 0 7px!important;color:#27231f!important;font-size:23px!important;line-height:1.05!important;letter-spacing:-.8px!important}
body.vano-live-v258.vano-map-surface .guest-drawer-content>p,
body.vano-shared-v258.vano-map-surface .guest-drawer-content>p{margin:0!important;color:#746a63!important;font-size:10.5px!important;line-height:1.5!important}
body.vano-live-v258.vano-map-surface .guest-drawer-benefits,
body.vano-shared-v258.vano-map-surface .guest-drawer-benefits{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:7px!important;margin:14px 0!important}
body.vano-live-v258.vano-map-surface .guest-drawer-benefits span,
body.vano-shared-v258.vano-map-surface .guest-drawer-benefits span{min-height:58px!important;padding:9px 7px!important;border:1px solid #eee3dd!important;border-radius:14px!important;background:#fff!important;color:#615851!important;font-size:8px!important;font-weight:780!important;line-height:1.25!important;display:flex!important;flex-direction:column!important;justify-content:center!important;gap:6px!important}
body.vano-live-v258.vano-map-surface .guest-drawer-benefits i,
body.vano-shared-v258.vano-map-surface .guest-drawer-benefits i{color:#d9703f!important}
body.vano-live-v258.vano-map-surface .guest-drawer-actions,
body.vano-shared-v258.vano-map-surface .guest-drawer-actions{display:grid!important;grid-template-columns:1fr 1fr!important;gap:8px!important}
body.vano-live-v258.vano-map-surface .guest-drawer-primary,
body.vano-live-v258.vano-map-surface .guest-drawer-secondary,
body.vano-shared-v258.vano-map-surface .guest-drawer-primary,
body.vano-shared-v258.vano-map-surface .guest-drawer-secondary{min-height:48px!important;border-radius:14px!important;display:flex!important;align-items:center!important;justify-content:center!important;font-size:10.5px!important;font-weight:900!important;text-decoration:none!important}
body.vano-live-v258.vano-map-surface .guest-drawer-primary,
body.vano-shared-v258.vano-map-surface .guest-drawer-primary{border:0!important;background:linear-gradient(135deg,#f59a62,#d9703f)!important;color:#fff!important;box-shadow:0 10px 22px rgba(217,112,63,.20)!important}
body.vano-live-v258.vano-map-surface .guest-drawer-secondary,
body.vano-shared-v258.vano-map-surface .guest-drawer-secondary{border:1px solid #e8ddd6!important;background:#fff!important;color:#514943!important}
body.vano-live-v258.vano-map-surface .guest-drawer-continue,
body.vano-shared-v258.vano-map-surface .guest-drawer-continue{width:100%!important;min-height:38px!important;margin-top:7px!important;border:0!important;background:transparent!important;color:#8a8078!important;font-size:9px!important;font-weight:800!important}

html[data-vano-theme="black"] body.vano-live-v258.vano-map-surface .account-drawer,
html[data-vano-theme="black"] body.vano-shared-v258.vano-map-surface .account-drawer{border-color:#39312c!important;background:rgba(27,24,21,.985)!important;color:#fff9f4!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-map-surface .drawer-grab,
html[data-vano-theme="black"] body.vano-shared-v258.vano-map-surface .drawer-grab{background:#5c5048!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-map-surface :is(.drawer-user,.drawer-link,.guest-drawer-benefits span,.guest-drawer-secondary),
html[data-vano-theme="black"] body.vano-shared-v258.vano-map-surface :is(.drawer-user,.drawer-link,.guest-drawer-benefits span,.guest-drawer-secondary){border-color:#39312c!important;background:#211d1a!important;color:#f7eee8!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-map-surface :is(.drawer-user b,.v258-drawer-brand b,.guest-drawer-brand b,.guest-drawer-content h3,.drawer-link .v258-link-copy b),
html[data-vano-theme="black"] body.vano-shared-v258.vano-map-surface :is(.drawer-user b,.v258-drawer-brand b,.guest-drawer-brand b,.guest-drawer-content h3,.drawer-link .v258-link-copy b){color:#fff9f4!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-map-surface :is(.drawer-user span,.drawer-link .v258-link-copy small,.guest-drawer-content>p,.guest-drawer-continue),
html[data-vano-theme="black"] body.vano-shared-v258.vano-map-surface :is(.drawer-user span,.drawer-link .v258-link-copy small,.guest-drawer-content>p,.guest-drawer-continue){color:#a89b92!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-map-surface :is(.v258-drawer-close,.guest-drawer-close),
html[data-vano-theme="black"] body.vano-shared-v258.vano-map-surface :is(.v258-drawer-close,.guest-drawer-close){border-color:#3b332e!important;background:#28231f!important;color:#c9bdb5!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-map-surface .drawer-link:hover,
html[data-vano-theme="black"] body.vano-shared-v258.vano-map-surface .drawer-link:hover{background:#2a241f!important;border-color:#554033!important}

/* --------------------------- Responsive --------------------------- */
@media(max-width:900px){
  body.vano-live-v258.vano-page-surface .navlinks,
body.vano-shared-v258.vano-page-surface .navlinks{display:none}
  body.vano-live-v258.vano-page-surface .page,
body.vano-shared-v258.vano-page-surface .page{padding-top:22px;padding-bottom:100px}
  body.vano-live-v258.vano-route-about .grid-3,
body.vano-shared-v258.vano-route-about .grid-3{grid-template-columns:1fr}
  body.vano-live-v258.vano-route-register .v63-entry-shell,
body.vano-shared-v258.vano-route-register .v63-entry-shell{width:min(100% - 20px,680px);margin:16px auto}
  body.vano-live-v258.vano-route-profile .profile-v108-quicknav,
body.vano-shared-v258.vano-route-profile .profile-v108-quicknav{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  body.vano-live-v258.vano-route-admin-dashboard .admin240-grid-main,
body.vano-live-v258.vano-route-admin-dashboard .admin240-server-grid,
body.vano-shared-v258.vano-route-admin-dashboard .admin240-grid-main,
body.vano-shared-v258.vano-route-admin-dashboard .admin240-server-grid{grid-template-columns:1fr!important}
}
@media(max-width:640px){
  body.vano-live-v258.vano-page-surface .topbar,
body.vano-shared-v258.vano-page-surface .topbar{height:58px}
  body.vano-live-v258.vano-page-surface .nav,
body.vano-live-v258.vano-page-surface .container,
body.vano-shared-v258.vano-page-surface .nav,
body.vano-shared-v258.vano-page-surface .container{width:calc(100% - 20px)}
  body.vano-live-v258.vano-page-surface .vano-brand-wordmark,
body.vano-shared-v258.vano-page-surface .vano-brand-wordmark{width:108px;max-height:30px}
  body.vano-live-v258.vano-page-surface .nav-actions .hide-mobile,
body.vano-shared-v258.vano-page-surface .nav-actions .hide-mobile{display:none!important}
  body.vano-live-v258.vano-page-surface .nav-actions,
body.vano-shared-v258.vano-page-surface .nav-actions{gap:5px}
  body.vano-live-v258.vano-page-surface .btn-sm,
body.vano-shared-v258.vano-page-surface .btn-sm{min-height:36px;padding-inline:10px;font-size:11px}
  body.vano-live-v258.vano-page-surface .page,
body.vano-shared-v258.vano-page-surface .page{min-height:calc(100dvh - 58px);padding:18px 0 92px}
  body.vano-live-v258.vano-page-surface .page-head,
body.vano-shared-v258.vano-page-surface .page-head{align-items:flex-start;flex-direction:column;margin-bottom:16px}
  body.vano-live-v258.vano-page-surface .page-title,
body.vano-live-v258.vano-page-surface .title,
body.vano-shared-v258.vano-page-surface .page-title,
body.vano-shared-v258.vano-page-surface .title{font-size:28px;letter-spacing:-1px}
  body.vano-live-v258.vano-page-surface .panel,
body.vano-shared-v258.vano-page-surface .panel{border-radius:18px}body.vano-live-v258 .panel-head,
body.vano-shared-v258 .panel-head{padding:15px}body.vano-live-v258 .panel-body,
body.vano-shared-v258 .panel-body{padding:15px}
  body.vano-live-v258.vano-page-surface footer,
body.vano-shared-v258.vano-page-surface footer{display:none}
  body.vano-live-v258.vano-page-surface .auth-wrap,
body.vano-shared-v258.vano-page-surface .auth-wrap{min-height:calc(100dvh - 58px);padding:18px 10px 92px;place-items:start center}
  body.vano-live-v258.vano-page-surface .auth-card,
body.vano-shared-v258.vano-page-surface .auth-card{margin-top:4vh;padding:21px 17px;border-radius:21px}
  body.vano-live-v258.vano-route-onboarding .onboard,
body.vano-shared-v258.vano-route-onboarding .onboard{padding:14px 10px 94px}
  body.vano-live-v258.vano-route-onboarding .ob-shell,
body.vano-shared-v258.vano-route-onboarding .ob-shell{border-radius:20px}
  body.vano-live-v258.vano-route-profile .profile-v72-shell,
body.vano-shared-v258.vano-route-profile .profile-v72-shell{gap:10px}
  body.vano-live-v258.vano-route-profile .profile-v72-hero,
body.vano-shared-v258.vano-route-profile .profile-v72-hero{border-radius:19px!important}
  body.vano-live-v258.vano-route-profile .profile-v72-identity,
body.vano-shared-v258.vano-route-profile .profile-v72-identity{align-items:center!important}
  body.vano-live-v258.vano-route-profile .profile-v108-quicknav,
body.vano-shared-v258.vano-route-profile .profile-v108-quicknav{grid-template-columns:1fr!important}
  body.vano-live-v258.vano-route-profile .profile-v72-detail,
body.vano-shared-v258.vano-route-profile .profile-v72-detail{border-radius:16px!important}
  body.vano-live-v258.vano-route-profile .profile-v72-detail>summary,
body.vano-shared-v258.vano-route-profile .profile-v72-detail>summary{min-height:64px!important}
  body.vano-live-v258.vano-route-admin-users .users-table tr,
body.vano-shared-v258.vano-route-admin-users .users-table tr{border-color:var(--v258-line)!important;background:var(--v258-surface)!important}
  body.vano-live-v258.vano-map-surface .account-drawer,
body.vano-shared-v258.vano-map-surface .account-drawer{left:7px!important;right:7px!important;top:auto!important;bottom:max(7px,env(safe-area-inset-bottom))!important;width:auto!important;max-width:none!important;max-height:min(84dvh,720px)!important;border-radius:25px!important;padding:9px 11px max(12px,env(safe-area-inset-bottom))!important}
  body.vano-live-v258.vano-map-surface .drawer-list,
body.vano-shared-v258.vano-map-surface .drawer-list{grid-template-columns:1fr 1fr!important}
}
@media(max-width:390px){
  body.vano-live-v258.vano-page-surface .nav-actions>a.btn-primary,
body.vano-shared-v258.vano-page-surface .nav-actions>a.btn-primary{padding-inline:9px;font-size:10px}
  body.vano-live-v258.vano-map-surface .drawer-user,
body.vano-shared-v258.vano-map-surface .drawer-user{grid-template-columns:48px minmax(0,1fr)!important}body.vano-live-v258 .drawer-avatar,
body.vano-shared-v258 .drawer-avatar{width:48px!important;height:48px!important}body.vano-live-v258 .drawer-profile,
body.vano-shared-v258 .drawer-profile{display:none!important}
  body.vano-live-v258.vano-map-surface .drawer-link,
body.vano-shared-v258.vano-map-surface .drawer-link{min-height:61px!important;padding:9px!important}
  body.vano-live-v258.vano-map-surface .guest-drawer-benefits,
body.vano-shared-v258.vano-map-surface .guest-drawer-benefits{grid-template-columns:1fr!important}body.vano-live-v258 .guest-drawer-benefits span,
body.vano-shared-v258 .guest-drawer-benefits span{min-height:45px!important;flex-direction:row!important;align-items:center!important;justify-content:flex-start!important}
}
@media(prefers-reduced-motion:reduce){
  body.vano-live-v258.vano-page-surface *,
body.vano-live-v258.vano-page-surface *::before,
body.vano-live-v258.vano-page-surface *::after,
body.vano-shared-v258.vano-page-surface *,
body.vano-shared-v258.vano-page-surface *::before,
body.vano-shared-v258.vano-page-surface *::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}

/* --------------------------- Standalone login --------------------------- */
body.vano-live-v258.vano-login-v258,
body.vano-shared-v258.vano-login-v258{
  margin:0!important;min-height:100dvh!important;background:#f7f5f2!important;color:#27231f!important;
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif!important;overflow-x:hidden!important
}
html[data-vano-theme="black"] body.vano-live-v258.vano-login-v258,
html[data-vano-theme="black"] body.vano-shared-v258.vano-login-v258{background:#151310!important;color:#fff9f4!important}
body.vano-live-v258.vano-login-v258 .auth-page,
body.vano-shared-v258.vano-login-v258 .auth-page{min-height:100dvh!important;padding:14px!important;display:flex!important;align-items:stretch!important;background:transparent!important}
body.vano-live-v258.vano-login-v258 .auth-shell,
body.vano-shared-v258.vano-login-v258 .auth-shell{width:min(1480px,100%)!important;min-height:calc(100dvh - 28px)!important;margin:auto!important;display:grid!important;grid-template-columns:minmax(390px,.88fr) minmax(470px,1.12fr)!important;border:1px solid #e8e0da!important;border-radius:30px!important;background:#fff!important;box-shadow:0 26px 90px rgba(68,48,37,.11)!important;overflow:hidden!important}
body.vano-live-v258.vano-login-v258 .auth-pane,
body.vano-shared-v258.vano-login-v258 .auth-pane{padding:clamp(30px,4.4vw,68px)!important;display:flex!important;flex-direction:column!important;background:#fff!important;color:#27231f!important}
body.vano-live-v258.vano-login-v258 .brand-row,
body.vano-shared-v258.vano-login-v258 .brand-row{display:flex!important;align-items:center!important;justify-content:flex-start!important}
body.vano-live-v258.vano-login-v258 .vano-auth-banner-clean,
body.vano-shared-v258.vano-login-v258 .vano-auth-banner-clean{display:block!important}
body.vano-live-v258.vano-login-v258 .vano-auth-banner,
body.vano-shared-v258.vano-login-v258 .vano-auth-banner{width:min(190px,48vw)!important;height:auto!important;max-height:52px!important;object-fit:contain!important;object-position:left center!important}
body.vano-live-v258.vano-login-v258 .auth-copy,
body.vano-shared-v258.vano-login-v258 .auth-copy{margin:auto 0!important;max-width:560px!important;padding:42px 0 30px!important}
body.vano-live-v258.vano-login-v258 .eyebrow,
body.vano-shared-v258.vano-login-v258 .eyebrow{color:#d9703f!important;font-size:10px!important;font-weight:950!important;letter-spacing:.14em!important;text-transform:uppercase!important}
body.vano-live-v258.vano-login-v258 h1,
body.vano-shared-v258.vano-login-v258 h1{margin:13px 0 13px!important;color:#27231f!important;font-size:clamp(38px,5vw,66px)!important;line-height:.94!important;letter-spacing:-3.2px!important;font-weight:930!important}
body.vano-live-v258.vano-login-v258 h1 span,
body.vano-shared-v258.vano-login-v258 h1 span{display:block!important;color:#d9703f!important}
body.vano-live-v258.vano-login-v258 .lead,
body.vano-shared-v258.vano-login-v258 .lead{max-width:510px!important;margin:0!important;color:#706760!important;font-size:14px!important;line-height:1.62!important}
body.vano-live-v258.vano-login-v258 .auth-actions,
body.vano-shared-v258.vano-login-v258 .auth-actions{width:100%!important;max-width:500px!important;margin-top:28px!important;display:grid!important;gap:9px!important}
body.vano-live-v258.vano-login-v258 .auth-button,
body.vano-shared-v258.vano-login-v258 .auth-button{width:100%!important;height:54px!important;min-height:54px!important;border-radius:15px!important;font-size:13px!important;font-weight:850!important;text-decoration:none!important;box-sizing:border-box!important}
body.vano-live-v258.vano-login-v258 .auth-button.google,
body.vano-shared-v258.vano-login-v258 .auth-button.google{border:1px solid #e4ddd7!important;background:#fff!important;color:#27231f!important;box-shadow:0 6px 20px rgba(67,49,38,.05)!important}
body.vano-live-v258.vano-login-v258 .auth-button.google:hover,
body.vano-shared-v258.vano-login-v258 .auth-button.google:hover{border-color:#d6cbc4!important;box-shadow:0 10px 28px rgba(67,49,38,.08)!important}
body.vano-live-v258.vano-login-v258 .auth-button.email,
body.vano-shared-v258.vano-login-v258 .auth-button.email{border:0!important;background:linear-gradient(135deg,#f59a62,#d9703f)!important;color:#fff!important;box-shadow:0 12px 28px rgba(217,112,63,.21)!important}
body.vano-live-v258.vano-login-v258 .auth-links,
body.vano-shared-v258.vano-login-v258 .auth-links{margin-top:3px!important;color:#91867e!important;font-size:12px!important}
body.vano-live-v258.vano-login-v258 .auth-links a,
body.vano-shared-v258.vano-login-v258 .auth-links a{color:#3e3732!important;font-weight:900!important}
body.vano-live-v258.vano-login-v258 .guest-link,
body.vano-shared-v258.vano-login-v258 .guest-link{width:100%!important;height:43px!important;border:1px dashed #ddd3cc!important;border-radius:13px!important;background:#fbf9f7!important;color:#716861!important;font-size:10px!important;font-weight:850!important;text-decoration:none!important}
body.vano-live-v258.vano-login-v258 .legal,
body.vano-shared-v258.vano-login-v258 .legal{padding-top:18px!important;color:#a0968f!important;font-size:9px!important;line-height:1.5!important}
body.vano-live-v258.vano-login-v258 .legal a,
body.vano-shared-v258.vano-login-v258 .legal a{color:#766c65!important}
body.vano-live-v258.vano-login-v258 .status-note,
body.vano-shared-v258.vano-login-v258 .status-note{border:1px solid #d8ece2!important;background:#f2faf6!important;color:#287354!important;border-radius:13px!important}
body.vano-live-v258.vano-login-v258 .route-pane,
body.vano-shared-v258.vano-login-v258 .route-pane{position:relative!important;min-height:100%!important;background:linear-gradient(145deg,#f1efec,#ebe8e4)!important;border-left:1px solid #e8e0da!important;overflow:hidden!important}
body.vano-live-v258.vano-login-v258 .auth-sheet,
body.vano-shared-v258.vano-login-v258 .auth-sheet{z-index:1600!important;background:transparent!important}
body.vano-live-v258.vano-login-v258 .sheet-backdrop,
body.vano-shared-v258.vano-login-v258 .sheet-backdrop{background:rgba(37,30,26,.34)!important;backdrop-filter:blur(5px)!important;-webkit-backdrop-filter:blur(5px)!important}
body.vano-live-v258.vano-login-v258 .sheet-card,
body.vano-shared-v258.vano-login-v258 .sheet-card{width:min(450px,100%)!important;border:1px solid #e7ded8!important;border-radius:24px!important;background:#fff!important;color:#27231f!important;box-shadow:0 30px 90px rgba(49,35,28,.22)!important;padding:23px!important}
body.vano-live-v258.vano-login-v258 .sheet-head h2,
body.vano-shared-v258.vano-login-v258 .sheet-head h2{color:#27231f!important;letter-spacing:-.8px!important}body.vano-live-v258 .sheet-head p,
body.vano-shared-v258 .sheet-head p{color:#7e746d!important}
body.vano-live-v258.vano-login-v258 .sheet-close,
body.vano-shared-v258.vano-login-v258 .sheet-close{border-color:#e7ded8!important;background:#f8f5f2!important;color:#6b625c!important}
body.vano-live-v258.vano-login-v258 .field label,
body.vano-shared-v258.vano-login-v258 .field label{color:#5d554f!important;font-weight:800!important}
body.vano-live-v258.vano-login-v258 .field input,
body.vano-shared-v258.vano-login-v258 .field input{height:48px!important;border:1px solid #ddd3cc!important;border-radius:13px!important;background:#fff!important;color:#27231f!important;outline:0!important}
body.vano-live-v258.vano-login-v258 .field input:focus,
body.vano-shared-v258.vano-login-v258 .field input:focus{border-color:#d9703f!important;box-shadow:0 0 0 4px rgba(217,112,63,.12)!important}
body.vano-live-v258.vano-login-v258 .password-toggle,
body.vano-shared-v258.vano-login-v258 .password-toggle{color:#81766e!important}
body.vano-live-v258.vano-login-v258 .sheet-submit,
body.vano-shared-v258.vano-login-v258 .sheet-submit{height:50px!important;border:0!important;border-radius:14px!important;background:linear-gradient(135deg,#f59a62,#d9703f)!important;color:#fff!important;font-weight:900!important;box-shadow:0 12px 28px rgba(217,112,63,.18)!important}
body.vano-live-v258.vano-login-v258 .sheet-switch,
body.vano-shared-v258.vano-login-v258 .sheet-switch{color:#8b8078!important;font-size:11px!important}body.vano-live-v258 .sheet-switch a,
body.vano-shared-v258 .sheet-switch a{color:#d9703f!important;font-weight:850!important}
body.vano-live-v258.vano-login-v258 .vano-auth-theme-toggle,
body.vano-shared-v258.vano-login-v258 .vano-auth-theme-toggle{z-index:1700!important;top:max(18px,env(safe-area-inset-top))!important;right:max(18px,env(safe-area-inset-right))!important;border:1px solid #e6ddd7!important;background:rgba(255,255,255,.92)!important;color:#5e5650!important;box-shadow:0 8px 22px rgba(67,49,38,.08)!important}

html[data-vano-theme="black"] body.vano-live-v258.vano-login-v258 .auth-shell,
html[data-vano-theme="black"] body.vano-live-v258.vano-login-v258 .auth-pane,
html[data-vano-theme="black"] body.vano-live-v258.vano-login-v258 .sheet-card,
html[data-vano-theme="black"] body.vano-shared-v258.vano-login-v258 .auth-shell,
html[data-vano-theme="black"] body.vano-shared-v258.vano-login-v258 .auth-pane,
html[data-vano-theme="black"] body.vano-shared-v258.vano-login-v258 .sheet-card{border-color:#39312c!important;background:#1c1916!important;color:#fff9f4!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-login-v258 :is(h1,.sheet-head h2),
html[data-vano-theme="black"] body.vano-shared-v258.vano-login-v258 :is(h1,.sheet-head h2){color:#fff9f4!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-login-v258 :is(.lead,.legal,.sheet-head p,.sheet-switch),
html[data-vano-theme="black"] body.vano-shared-v258.vano-login-v258 :is(.lead,.legal,.sheet-head p,.sheet-switch){color:#b4a79e!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-login-v258 .route-pane,
html[data-vano-theme="black"] body.vano-shared-v258.vano-login-v258 .route-pane{border-color:#342e29!important;background:linear-gradient(145deg,#211d1a,#171411)!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-login-v258 :is(.auth-button.google,.guest-link,.field input),
html[data-vano-theme="black"] body.vano-shared-v258.vano-login-v258 :is(.auth-button.google,.guest-link,.field input){border-color:#3d342e!important;background:#211d1a!important;color:#f9f1eb!important}
html[data-vano-theme="black"] body.vano-live-v258.vano-login-v258 .vano-auth-theme-toggle,
html[data-vano-theme="black"] body.vano-shared-v258.vano-login-v258 .vano-auth-theme-toggle{border-color:#3d342e!important;background:#211d1a!important;color:#d5c8bf!important}

@media(max-width:820px){
  body.vano-live-v258.vano-login-v258 .auth-page,
body.vano-shared-v258.vano-login-v258 .auth-page{padding:0!important}
  body.vano-live-v258.vano-login-v258 .auth-shell,
body.vano-shared-v258.vano-login-v258 .auth-shell{min-height:100dvh!important;border:0!important;border-radius:0!important;grid-template-columns:1fr!important;grid-template-rows:auto minmax(160px,28vh)!important;box-shadow:none!important}
  body.vano-live-v258.vano-login-v258 .auth-pane,
body.vano-shared-v258.vano-login-v258 .auth-pane{order:0!important;padding:max(22px,env(safe-area-inset-top)) max(18px,env(safe-area-inset-right)) max(22px,env(safe-area-inset-bottom)) max(18px,env(safe-area-inset-left))!important;justify-content:center!important}
  body.vano-live-v258.vano-login-v258 .route-pane,
body.vano-shared-v258.vano-login-v258 .route-pane{order:1!important;min-height:160px!important;max-height:30vh!important;border-left:0!important;border-top:1px solid #e8e0da!important}
  body.vano-live-v258.vano-login-v258 .auth-copy,
body.vano-shared-v258.vano-login-v258 .auth-copy{margin:0!important;padding:32px 0 18px!important;max-width:none!important}
  body.vano-live-v258.vano-login-v258 h1,
body.vano-shared-v258.vano-login-v258 h1{font-size:clamp(36px,10vw,50px)!important;letter-spacing:-2px!important}
  body.vano-live-v258.vano-login-v258 .lead,
body.vano-shared-v258.vano-login-v258 .lead{font-size:13px!important}
  body.vano-live-v258.vano-login-v258 .auth-actions,
body.vano-shared-v258.vano-login-v258 .auth-actions{max-width:none!important;margin-top:22px!important}
  body.vano-live-v258.vano-login-v258 .route-summary,
body.vano-shared-v258.vano-login-v258 .route-summary{display:none!important}
  body.vano-live-v258.vano-login-v258 .auth-sheet,
body.vano-shared-v258.vano-login-v258 .auth-sheet{place-items:end center!important;padding:0!important}
  body.vano-live-v258.vano-login-v258 .sheet-card,
body.vano-shared-v258.vano-login-v258 .sheet-card{width:100%!important;border-radius:24px 24px 0 0!important;border-bottom:0!important;padding:20px max(18px,env(safe-area-inset-right)) max(22px,env(safe-area-inset-bottom)) max(18px,env(safe-area-inset-left))!important}
}
@media(max-width:420px){
  body.vano-live-v258.vano-login-v258 .auth-pane,
body.vano-shared-v258.vano-login-v258 .auth-pane{padding-inline:max(14px,env(safe-area-inset-left))!important}
  body.vano-live-v258.vano-login-v258 .auth-copy,
body.vano-shared-v258.vano-login-v258 .auth-copy{padding-top:24px!important}
  body.vano-live-v258.vano-login-v258 h1,
body.vano-shared-v258.vano-login-v258 h1{font-size:34px!important;letter-spacing:-1.6px!important}
  body.vano-live-v258.vano-login-v258 .lead,
body.vano-shared-v258.vano-login-v258 .lead{font-size:12.3px!important;line-height:1.5!important}
  body.vano-live-v258.vano-login-v258 .auth-button,
body.vano-shared-v258.vano-login-v258 .auth-button{height:50px!important;min-height:50px!important;font-size:12.5px!important}
  body.vano-live-v258.vano-login-v258 .route-pane,
body.vano-shared-v258.vano-login-v258 .route-pane{min-height:145px!important;max-height:22vh!important}
}

/* --------------------------- Shared/live standalone --------------------------- */
body.vano-live-v258.vano-shared-v258,
body.vano-live-v258.vano-live-v258,
body.vano-shared-v258.vano-shared-v258,
body.vano-shared-v258.vano-live-v258{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif!important}
body.vano-live-v258.vano-shared-v258 :is(.route-panel,.share-top),
body.vano-live-v258.vano-live-v258 :is(.top,.card),
body.vano-shared-v258.vano-shared-v258 :is(.route-panel,.share-top),
body.vano-shared-v258.vano-live-v258 :is(.top,.card){backdrop-filter:blur(20px) saturate(135%)!important;-webkit-backdrop-filter:blur(20px) saturate(135%)!important}
body.vano-live-v258.vano-shared-v258 .route-panel,
body.vano-live-v258.vano-live-v258 .card,
body.vano-shared-v258.vano-shared-v258 .route-panel,
body.vano-shared-v258.vano-live-v258 .card{border-radius:24px!important;box-shadow:0 20px 60px rgba(36,28,23,.16)!important}
body.vano-live-v258.vano-shared-v258 .route-actions button,
body.vano-live-v258.vano-live-v258 button,
body.vano-shared-v258.vano-shared-v258 .route-actions button,
body.vano-shared-v258.vano-live-v258 button{border-radius:13px!important}

/* V258 hard isolation guards */
body.vano-live-v258.vano-page-surface,
body.vano-shared-v258.vano-page-surface{background:radial-gradient(circle at 90% -10%,rgba(245,154,98,.12),transparent 28rem),radial-gradient(circle at 5% 45%,rgba(255,195,155,.08),transparent 25rem),var(--v258-bg)!important}
body.vano-live-v258.vano-page-surface::before,
body.vano-shared-v258.vano-page-surface::before{display:none!important;content:none!important}
body.vano-live-v258.vano-page-surface .vano-nav-avatar,
body.vano-shared-v258.vano-page-surface .vano-nav-avatar{width:30px;height:30px;border-radius:10px;object-fit:cover;border:1px solid var(--v258-line);background:var(--v258-surface)}
html[data-vano-theme="black"] body.vano-live-v258.vano-page-surface .vano-nav-avatar,
html[data-vano-theme="black"] body.vano-shared-v258.vano-page-surface .vano-nav-avatar{border-color:var(--v258-line-strong)}

