  body.vano-auth-startup .ob-step-actions-v340,
body.vano-route-register .ob-step-actions-v340{position:fixed!important;z-index:20;left:8px;right:8px;bottom:max(8px,env(safe-area-inset-bottom));min-height:68px!important;padding:8px!important;border:1px solid var(--v402-line)!important;border-radius:20px!important;background:color-mix(in srgb,var(--v402-card) 90%,transparent)!important;backdrop-filter:blur(22px)!important;box-shadow:0 16px 42px rgba(31,25,21,.12)!important}
  body.vano-auth-startup .ob-step-hint-v340,
body.vano-route-register .ob-step-hint-v340{display:none!important}body.vano-auth-startup .ob-next-v340,
body.vano-auth-startup .ob-finish-v340,
body.vano-route-register .ob-next-v340,
body.vano-route-register .ob-finish-v340{flex:1!important;min-width:0!important;min-height:50px!important}body.vano-auth-startup .ob-back-v340,
body.vano-route-register .ob-back-v340{min-width:76px!important;justify-content:center!important}
  body.vano-auth-startup .ob-preview-v340,
body.vano-route-register .ob-preview-v340{display:none!important}
}

@media(max-width:420px){
  body.vano-auth-startup .startup-copy h1,
body.vano-route-register .startup-copy h1{font-size:43px!important}body.vano-auth-startup .startup-copy p,
body.vano-route-register .startup-copy p{font-size:12px!important}body.vano-auth-startup .startup-benefits-v402 span:nth-child(3),
body.vano-route-register .startup-benefits-v402 span:nth-child(3){display:none}
  body.vano-auth-startup .register-copy h1,
body.vano-route-register .register-copy h1{font-size:40px!important}
  body.vano-auth-startup .ob-step-heading-v340 h1,
body.vano-route-register .ob-step-heading-v340 h1{font-size:35px!important}body.vano-auth-startup .ob-choice-card-v340 b,
body.vano-route-register .ob-choice-card-v340 b{font-size:10px!important}body.vano-auth-startup .ob-choice-card-v340 small,
body.vano-route-register .ob-choice-card-v340 small{font-size:7.8px!important}
  body.vano-auth-startup .ob-summary-grid-v340,
body.vano-route-register .ob-summary-grid-v340{grid-template-columns:1fr!important}
}

@media(prefers-reduced-motion:reduce){
  body.vano-auth-startup .startup-shell,
body.vano-auth-startup .startup-stage,
body.vano-auth-startup .vano-onboarding-js .ob-step.is-active,
body.vano-route-register .startup-shell,
body.vano-route-register .startup-stage,
body.vano-route-register .vano-onboarding-js .ob-step.is-active{animation:none!important}
  body.vano-auth-startup .startup-primary,
body.vano-auth-startup .startup-secondary,
body.vano-auth-startup .startup-submit,
body.vano-auth-startup .ob-next-v340,
body.vano-auth-startup .ob-finish-v340,
body.vano-auth-startup .ob-choice-card-v340,
body.vano-auth-startup .ob-language-card-v340,
body.vano-route-register .startup-primary,
body.vano-route-register .startup-secondary,
body.vano-route-register .startup-submit,
body.vano-route-register .ob-next-v340,
body.vano-route-register .ob-finish-v340,
body.vano-route-register .ob-choice-card-v340,
body.vano-route-register .ob-language-card-v340{transition:none!important}
}


/* ===== static/vano-auth-startup.css ===== */
/* VANO — startup-grade auth + onboarding polish */
body.vano-auth-startup,
body.vano-route-register{--v351-orange:#F59A62;--v351-orange-2:#E97742;--v351-ink:#211d1a;--v351-muted:#817873;--v351-line:rgba(42,35,31,.085);--v351-ease:cubic-bezier(.2,.78,.2,1)}

/* LOGIN */
body.vano-auth-startup .vano-auth-startup,
body.vano-route-register .vano-auth-startup{padding:max(72px,calc(env(safe-area-inset-top) + 58px)) max(18px,env(safe-area-inset-right)) max(22px,env(safe-area-inset-bottom)) max(18px,env(safe-area-inset-left))!important}
body.vano-auth-startup .vano-auth-startup .startup-shell,
body.vano-route-register .vano-auth-startup .startup-shell{min-height:min(720px,calc(100svh - 96px));border-radius:36px!important;background:rgba(255,255,255,.92)!important;box-shadow:0 35px 100px rgba(44,35,29,.13),0 4px 20px rgba(44,35,29,.05)!important}
body.vano-auth-startup .vano-auth-startup .startup-auth,
body.vano-route-register .vano-auth-startup .startup-auth{position:relative;overflow:hidden}
body.vano-auth-startup .vano-auth-startup .startup-auth:before,
body.vano-route-register .vano-auth-startup .startup-auth:before{content:"";position:absolute;width:180px;height:180px;border-radius:50%;left:-86px;bottom:-82px;background:radial-gradient(circle,rgba(245,154,98,.14),rgba(245,154,98,0) 70%);pointer-events:none}
body.vano-auth-startup .vano-auth-startup .startup-copy h1,
body.vano-auth-startup .vano-auth-startup .startup-copy h2,
body.vano-route-register .vano-auth-startup .startup-copy h1,
body.vano-route-register .vano-auth-startup .startup-copy h2{letter-spacing:-3.7px!important}
body.vano-auth-startup .vano-auth-startup .startup-primary,
body.vano-auth-startup .vano-auth-startup .startup-secondary,
body.vano-auth-startup .vano-auth-startup .startup-submit,
body.vano-route-register .vano-auth-startup .startup-primary,
body.vano-route-register .vano-auth-startup .startup-secondary,
body.vano-route-register .vano-auth-startup .startup-submit{min-height:60px!important;border-radius:19px!important}
body.vano-auth-startup .vano-auth-startup .startup-primary,
body.vano-auth-startup .vano-auth-startup .startup-secondary,
body.vano-route-register .vano-auth-startup .startup-primary,
body.vano-route-register .vano-auth-startup .startup-secondary{border-color:rgba(39,32,28,.08)!important}
body.vano-auth-startup .vano-auth-startup .startup-primary,
body.vano-route-register .vano-auth-startup .startup-primary{box-shadow:0 11px 30px rgba(36,29,25,.075)!important}
body.vano-auth-startup .vano-auth-startup .startup-secondary,
body.vano-route-register .vano-auth-startup .startup-secondary{background:rgba(249,247,245,.92)!important}
body.vano-auth-startup .vano-auth-startup .startup-input-wrap,
body.vano-route-register .vano-auth-startup .startup-input-wrap{min-height:56px!important;border-radius:17px!important;transition:border-color .2s ease,box-shadow .2s ease,background .2s ease,transform .2s var(--v351-ease)!important}
body.vano-auth-startup .vano-auth-startup .startup-input-wrap:focus-within,
body.vano-route-register .vano-auth-startup .startup-input-wrap:focus-within{transform:translateY(-1px);box-shadow:0 0 0 4px rgba(245,154,98,.11)!important}
body.vano-auth-startup .vano-auth-startup .startup-stage,
body.vano-route-register .vano-auth-startup .startup-stage{transform-origin:50% 35%}
body.vano-auth-startup .vano-auth-startup .startup-stage.v351-enter-forward,
body.vano-route-register .vano-auth-startup .startup-stage.v351-enter-forward{animation:v351AuthForward .38s var(--v351-ease) both}
body.vano-auth-startup .vano-auth-startup .startup-stage.v351-enter-back,
body.vano-route-register .vano-auth-startup .startup-stage.v351-enter-back{animation:v351AuthBack .34s var(--v351-ease) both}
@keyframes v351AuthForward{from{opacity:0;transform:translateX(18px) scale(.99)}to{opacity:1;transform:none}}
@keyframes v351AuthBack{from{opacity:0;transform:translateX(-18px) scale(.99)}to{opacity:1;transform:none}}

html[data-vano-theme="black"] body.vano-auth-startup .vano-auth-startup .startup-shell,
html[data-vano-theme="black"] body.vano-route-register .vano-auth-startup .startup-shell{background:rgba(29,26,23,.94)!important;border-color:rgba(255,255,255,.07)!important;box-shadow:0 35px 100px rgba(0,0,0,.35)!important}
html[data-vano-theme="black"] body.vano-auth-startup .vano-auth-startup .startup-secondary,
html[data-vano-theme="black"] body.vano-route-register .vano-auth-startup .startup-secondary{background:rgba(39,35,31,.9)!important}

/* REGISTER */
body.vano-auth-startup .vano-register-v340,
body.vano-route-register .vano-register-v340{padding:18px!important;background:radial-gradient(circle at 8% 0%,rgba(245,154,98,.17),transparent 28%),radial-gradient(circle at 100% 100%,rgba(245,154,98,.09),transparent 31%),#f4f2ef!important}
body.vano-auth-startup .vano-register-v340 .register-shell,
body.vano-route-register .vano-register-v340 .register-shell{min-height:calc(100svh - 36px)!important;border-radius:38px!important;box-shadow:0 36px 100px rgba(49,40,34,.12),0 4px 20px rgba(49,40,34,.05)!important}
body.vano-auth-startup .vano-register-v340 .register-panel,
body.vano-route-register .vano-register-v340 .register-panel{position:relative;overflow:hidden}
body.vano-auth-startup .vano-register-v340 .register-panel:after,
body.vano-route-register .vano-register-v340 .register-panel:after{content:"";position:absolute;right:-110px;top:-90px;width:240px;height:240px;border-radius:50%;background:radial-gradient(circle,rgba(245,154,98,.10),transparent 70%);pointer-events:none}
body.vano-auth-startup .vano-register-v340 .register-copy h1,
body.vano-route-register .vano-register-v340 .register-copy h1{letter-spacing:-3.8px!important}body.vano-auth-startup .vano-register-v340 .register-copy h1 span,
body.vano-route-register .vano-register-v340 .register-copy h1 span{margin-top:7px;font-size:.72em;line-height:1.03;letter-spacing:-2.3px}
body.vano-auth-startup .vano-register-v340 .register-google,
body.vano-auth-startup .vano-register-v340 .register-email-submit,
body.vano-route-register .vano-register-v340 .register-google,
body.vano-route-register .vano-register-v340 .register-email-submit{min-height:60px!important;border-radius:19px!important}
body.vano-auth-startup .vano-register-v340 .register-input-shell,
body.vano-route-register .vano-register-v340 .register-input-shell{height:57px!important;border-radius:17px!important;transition:transform .2s var(--v351-ease),border-color .2s ease,box-shadow .2s ease,background .2s ease!important}
body.vano-auth-startup .vano-register-v340 .register-input-shell:focus-within,
body.vano-route-register .vano-register-v340 .register-input-shell:focus-within{transform:translateY(-1px)}
body.vano-auth-startup .vano-register-v340 .register-field.is-valid .register-input-shell,
body.vano-route-register .vano-register-v340 .register-field.is-valid .register-input-shell{border-color:rgba(56,158,99,.32)!important;box-shadow:0 0 0 4px rgba(56,158,99,.065)!important}
body.vano-auth-startup .vano-register-v340 .register-field.is-invalid .register-input-shell,
body.vano-route-register .vano-register-v340 .register-field.is-invalid .register-input-shell{border-color:rgba(214,82,73,.48)!important;box-shadow:0 0 0 4px rgba(214,82,73,.07)!important}
body.vano-auth-startup .vano-register-v340 .register-email-submit.is-loading,
body.vano-route-register .vano-register-v340 .register-email-submit.is-loading{pointer-events:none;opacity:.78}
body.vano-auth-startup .vano-register-v340 .register-email-submit.is-loading i,
body.vano-route-register .vano-register-v340 .register-email-submit.is-loading i{animation:v351Spin .8s linear infinite}
@keyframes v351Spin{to{transform:rotate(360deg)}}

/* ONBOARDING */
body.vano-auth-startup .vano-onboarding-v340,
body.vano-route-register .vano-onboarding-v340{padding:18px!important;background:radial-gradient(circle at 7% 0%,rgba(245,154,98,.16),transparent 28%),#f4f2ef!important}
body.vano-auth-startup .vano-onboarding-v340 .ob-shell-v340,
body.vano-route-register .vano-onboarding-v340 .ob-shell-v340{min-height:calc(100svh - 36px)!important;border-radius:38px!important;box-shadow:0 36px 100px rgba(49,40,34,.12),0 4px 20px rgba(49,40,34,.05)!important;overflow:hidden!important}
body.vano-auth-startup .vano-onboarding-v340 .ob-main-v340,
body.vano-route-register .vano-onboarding-v340 .ob-main-v340{position:relative}
body.vano-auth-startup .vano-onboarding-v340 .ob-progress-v340,
body.vano-route-register .vano-onboarding-v340 .ob-progress-v340{height:5px!important;background:rgba(52,44,39,.07)!important;border-radius:999px!important;overflow:hidden!important}
body.vano-auth-startup .vano-onboarding-v340 .ob-progress-v340 i,
body.vano-route-register .vano-onboarding-v340 .ob-progress-v340 i{background:linear-gradient(90deg,#F59A62,#E97742)!important;box-shadow:0 0 16px rgba(245,154,98,.26)}
body.vano-auth-startup .vano-onboarding-v340 .ob-progress-steps-v344,
body.vano-route-register .vano-onboarding-v340 .ob-progress-steps-v344{margin-top:10px!important}
body.vano-auth-startup .vano-onboarding-v340 .ob-progress-steps-v344 span,
body.vano-route-register .vano-onboarding-v340 .ob-progress-steps-v344 span{transition:color .2s ease,transform .24s var(--v351-ease),opacity .2s ease!important}
body.vano-auth-startup .vano-onboarding-v340 .ob-progress-steps-v344 span.is-active,
body.vano-route-register .vano-onboarding-v340 .ob-progress-steps-v344 span.is-active{transform:translateY(-1px)}
body.vano-auth-startup .vano-onboarding-v340 .ob-step-v340,
body.vano-route-register .vano-onboarding-v340 .ob-step-v340{will-change:transform,opacity}
body.vano-auth-startup .vano-onboarding-v340 .ob-step.v351-step-forward,
body.vano-route-register .vano-onboarding-v340 .ob-step.v351-step-forward{animation:v351StepForward .42s var(--v351-ease) both}
body.vano-auth-startup .vano-onboarding-v340 .ob-step.v351-step-back,
body.vano-route-register .vano-onboarding-v340 .ob-step.v351-step-back{animation:v351StepBack .38s var(--v351-ease) both}
@keyframes v351StepForward{from{opacity:0;transform:translateX(24px) scale(.992)}to{opacity:1;transform:none}}
@keyframes v351StepBack{from{opacity:0;transform:translateX(-24px) scale(.992)}to{opacity:1;transform:none}}
body.vano-auth-startup .vano-onboarding-v340 .ob-step-heading-v340 h1,
body.vano-route-register .vano-onboarding-v340 .ob-step-heading-v340 h1{letter-spacing:-3.1px!important}
body.vano-auth-startup .vano-onboarding-v340 .ob-card-v340,
body.vano-route-register .vano-onboarding-v340 .ob-card-v340{border-radius:25px!important;box-shadow:0 13px 38px rgba(43,35,30,.055)!important}
body.vano-auth-startup .vano-onboarding-v340 .ob-input-v340,
body.vano-route-register .vano-onboarding-v340 .ob-input-v340{height:60px!important;border-radius:18px!important}
body.vano-auth-startup .vano-onboarding-v340 .ob-choice-card-v340,
body.vano-auth-startup .vano-onboarding-v340 .ob-language-card-v340,
body.vano-route-register .vano-onboarding-v340 .ob-choice-card-v340,
body.vano-route-register .vano-onboarding-v340 .ob-language-card-v340{border-radius:19px!important;overflow:hidden;position:relative}
body.vano-auth-startup .vano-onboarding-v340 .ob-choice-card-v340:after,
body.vano-auth-startup .vano-onboarding-v340 .ob-language-card-v340:after,
body.vano-route-register .vano-onboarding-v340 .ob-choice-card-v340:after,
body.vano-route-register .vano-onboarding-v340 .ob-language-card-v340:after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 20%,rgba(255,255,255,.32),transparent 68%);transform:translateX(-120%);pointer-events:none}
body.vano-auth-startup .vano-onboarding-v340 .ob-choice-v340 input:checked + .ob-choice-card-v340:after,
body.vano-auth-startup .vano-onboarding-v340 .ob-language-v340 input:checked + .ob-language-card-v340:after,
body.vano-route-register .vano-onboarding-v340 .ob-choice-v340 input:checked + .ob-choice-card-v340:after,
body.vano-route-register .vano-onboarding-v340 .ob-language-v340 input:checked + .ob-language-card-v340:after{animation:v351Sweep .48s var(--v351-ease)}
@keyframes v351Sweep{to{transform:translateX(120%)}}
body.vano-auth-startup .vano-onboarding-v340 .ob-next-v340,
body.vano-auth-startup .vano-onboarding-v340 .ob-finish-v340,
