@media(max-width:1080px){body.vano-route-admin-dashboard .admin350-nav{grid-template-columns:repeat(3,1fr)}body.vano-route-admin-dashboard .admin350-kpi-grid{grid-template-columns:repeat(2,1fr)}body.vano-route-admin-dashboard .admin350-operational-grid{grid-template-columns:1fr}body.vano-route-admin-dashboard .admin350-infra-summary{grid-template-columns:repeat(3,1fr)}body.vano-route-admin-dashboard .admin350-server-grid{grid-template-columns:repeat(2,1fr)}body.vano-route-admin-dashboard .admin350-advanced-grid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:760px){body.vano-route-admin-dashboard .admin350{padding-top:12px}body.vano-route-admin-dashboard .admin350-shell{width:calc(100% - 14px)}body.vano-route-admin-dashboard .admin350-hero{display:block;padding:17px;border-radius:20px}body.vano-route-admin-dashboard .admin350-command-mark{width:42px;height:42px;border-radius:13px}body.vano-route-admin-dashboard .admin350-hero h1{font-size:23px}body.vano-route-admin-dashboard .admin350-hero p{font-size:9.5px}body.vano-route-admin-dashboard .admin350-hero-actions{margin-top:14px;overflow:auto;padding-bottom:2px}body.vano-route-admin-dashboard .admin350-btn{min-height:38px;white-space:nowrap}body.vano-route-admin-dashboard .admin350-nav{display:flex;overflow:auto;gap:6px;margin-top:7px;scrollbar-width:none}body.vano-route-admin-dashboard .admin350-nav::-webkit-scrollbar{display:none}body.vano-route-admin-dashboard .admin350-nav a{flex:0 0 150px;min-height:57px}body.vano-route-admin-dashboard .admin350-kpi-grid{gap:6px;margin-top:7px}body.vano-route-admin-dashboard .admin350-kpi{padding:12px;border-radius:15px}body.vano-route-admin-dashboard .admin350-kpi>strong{font-size:24px;margin:10px 0}body.vano-route-admin-dashboard .admin350-kpi-top small{font-size:7.5px}body.vano-route-admin-dashboard .admin350-kpi-foot span{font-size:7.5px}body.vano-route-admin-dashboard .admin350-operational-grid,
body.vano-route-admin-dashboard .admin350-infra,
body.vano-route-admin-dashboard .admin350-activity-grid,
body.vano-route-admin-dashboard .admin350-advanced,
body.vano-route-admin-dashboard .admin350-danger{margin-top:7px}body.vano-route-admin-dashboard .admin350-health-card,
body.vano-route-admin-dashboard .admin350-product-card,
body.vano-route-admin-dashboard .admin350-infra,
body.vano-route-admin-dashboard .admin350-activity-grid>.admin350-card{padding:14px;border-radius:18px}body.vano-route-admin-dashboard .admin350-health-body{grid-template-columns:1fr;gap:13px}body.vano-route-admin-dashboard .admin350-health-score>div:last-child span{max-width:none}body.vano-route-admin-dashboard .admin350-infra-summary{grid-template-columns:repeat(3,1fr);gap:5px}body.vano-route-admin-dashboard .admin350-topology{grid-template-columns:1fr;margin-top:10px;gap:9px}body.vano-route-admin-dashboard .admin350-topology-line{display:none}body.vano-route-admin-dashboard .admin350-topology-nodes{padding-top:8px;border-top:1px solid var(--a-line)}body.vano-route-admin-dashboard .admin350-toolbar{display:grid;grid-template-columns:1fr auto}body.vano-route-admin-dashboard .admin350 .node-filter-group{grid-column:1/-1;overflow:auto}body.vano-route-admin-dashboard .admin350 .node-filter{white-space:nowrap}body.vano-route-admin-dashboard .admin350 .node-search{min-width:0}body.vano-route-admin-dashboard .admin350-server-grid{grid-template-columns:1fr}body.vano-route-admin-dashboard .admin350-activity-grid{grid-template-columns:1fr}body.vano-route-admin-dashboard .admin350-advanced-grid{grid-template-columns:repeat(2,1fr)}body.vano-route-admin-dashboard .admin350-danger{display:grid;padding:14px}body.vano-route-admin-dashboard .admin350-reset-form,
body.vano-route-admin-dashboard .admin350-danger-button{width:100%}body.vano-route-admin-dashboard .admin350-danger-button{justify-content:center}body.vano-route-admin-dashboard .admin350-modal{padding:8px}body.vano-route-admin-dashboard .admin350-modal .node-config-dialog{border-radius:18px}body.vano-route-admin-dashboard .admin350-modal .node-form-grid{grid-template-columns:1fr}body.vano-route-admin-dashboard .admin350-modal .node-form-grid .full{grid-column:auto}body.vano-route-admin-dashboard .admin350-reveal{opacity:1;transform:none}}
@media(max-width:460px){body.vano-route-admin-dashboard .admin350-kpi-grid{grid-template-columns:1fr 1fr}body.vano-route-admin-dashboard .admin350-kpi.is-primary{grid-column:1/-1}body.vano-route-admin-dashboard .admin350-nav a{flex-basis:138px}body.vano-route-admin-dashboard .admin350-health-metrics{grid-template-columns:repeat(2,1fr)}body.vano-route-admin-dashboard .admin350-infra-summary{grid-template-columns:repeat(2,1fr)}body.vano-route-admin-dashboard .admin350-section-head{display:block}body.vano-route-admin-dashboard .admin350-section-actions{margin-top:10px;justify-content:space-between}body.vano-route-admin-dashboard .admin350-server-kpis{grid-template-columns:repeat(2,1fr)}body.vano-route-admin-dashboard .admin350-feed-row{grid-template-columns:30px minmax(0,1fr)}body.vano-route-admin-dashboard .admin350-feed-row time{display:none}body.vano-route-admin-dashboard .admin350-advanced>summary{grid-template-columns:34px 1fr}body.vano-route-admin-dashboard .admin350-summary-action{display:none}body.vano-route-admin-dashboard .admin350-danger-copy{align-items:start}}
@media(prefers-reduced-motion:reduce){body.vano-route-admin-dashboard .admin350-reveal{opacity:1;transform:none}body.vano-route-admin-dashboard .admin350-reveal.is-visible{transition:none}body.vano-route-admin-dashboard .admin350-btn,
body.vano-route-admin-dashboard .admin350-nav a,
body.vano-route-admin-dashboard .admin350-server{transition:none}}


/* ===== static/vano-auth-experience.css ===== */
/* VANO MAPS — Auth + onboarding experience system
   Unified startup visual language, mobile-first, light/black parity. */
body.vano-auth-startup,
body.vano-route-register{
  --v402-accent:#f28b50;
  --v402-accent-strong:#de6f36;
  --v402-accent-soft:#fff0e6;
  --v402-bg:#f5f3ef;
  --v402-card:#ffffff;
  --v402-card-2:#faf8f5;
  --v402-ink:#1d1b19;
  --v402-muted:#77716c;
  --v402-faint:#aaa39d;
  --v402-line:rgba(31,26,22,.09);
  --v402-line-strong:rgba(31,26,22,.14);
  --v402-shadow:0 28px 80px rgba(39,31,25,.11),0 2px 10px rgba(39,31,25,.035);
  --v402-shadow-soft:0 14px 34px rgba(39,31,25,.07);
  --v402-ease:cubic-bezier(.2,.82,.2,1);
}
html[data-vano-theme="black"] body.vano-auth-startup,
html[data-vano-theme-mode="black"] body.vano-auth-startup,
html[data-vano-theme="black"] body.vano-route-register,
html[data-vano-theme-mode="black"] body.vano-route-register{
  --v402-accent:#ff9a5f;
  --v402-accent-strong:#f08143;
  --v402-accent-soft:rgba(255,154,95,.11);
  --v402-bg:#090b0e;
  --v402-card:#111418;
  --v402-card-2:#171a1f;
  --v402-ink:#f7f5f2;
  --v402-muted:#9ba0a8;
  --v402-faint:#696f78;
  --v402-line:rgba(255,255,255,.075);
  --v402-line-strong:rgba(255,255,255,.13);
  --v402-shadow:0 28px 90px rgba(0,0,0,.34),0 2px 10px rgba(0,0,0,.22);
  --v402-shadow-soft:0 18px 42px rgba(0,0,0,.22);
}

/* ---------------- LOGIN / ENTRY ---------------- */
body.vano-auth-startup.vano-auth-startup,
body.vano-route-register.vano-auth-startup{
  background:var(--v402-bg);
  color:var(--v402-ink);
  padding:max(72px,calc(env(safe-area-inset-top) + 58px)) max(18px,env(safe-area-inset-right)) max(20px,env(safe-area-inset-bottom)) max(18px,env(safe-area-inset-left));
}
body.vano-auth-startup .startup-ambient,
body.vano-route-register .startup-ambient{background:var(--v402-bg)!important}
body.vano-auth-startup .startup-ambient:before,
body.vano-route-register .startup-ambient:before{content:"";position:absolute;inset:0;background:linear-gradient(rgba(28,25,22,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(28,25,22,.025) 1px,transparent 1px);background-size:34px 34px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.75),transparent 88%);pointer-events:none}
html[data-vano-theme="black"] body.vano-auth-startup .startup-ambient:before,
html[data-vano-theme-mode="black"] body.vano-auth-startup .startup-ambient:before,
html[data-vano-theme="black"] body.vano-route-register .startup-ambient:before,
html[data-vano-theme-mode="black"] body.vano-route-register .startup-ambient:before{background-image:linear-gradient(rgba(255,255,255,.024) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.024) 1px,transparent 1px)}
body.vano-auth-startup .ambient-orb-a,
body.vano-route-register .ambient-orb-a{width:min(62vw,780px)!important;left:-24vw!important;top:-32vw!important;background:radial-gradient(circle,rgba(242,139,80,.18),rgba(242,139,80,0) 68%)!important}
body.vano-auth-startup .ambient-orb-b,
body.vano-route-register .ambient-orb-b{width:min(50vw,680px)!important;right:-16vw!important;bottom:-27vw!important;background:radial-gradient(circle,rgba(242,139,80,.09),rgba(242,139,80,0) 70%)!important}
html[data-vano-theme="black"] body.vano-auth-startup .ambient-orb-a,
html[data-vano-theme-mode="black"] body.vano-auth-startup .ambient-orb-a,
html[data-vano-theme="black"] body.vano-route-register .ambient-orb-a,
html[data-vano-theme-mode="black"] body.vano-route-register .ambient-orb-a{background:radial-gradient(circle,rgba(255,145,82,.10),transparent 68%)!important}

body.vano-auth-startup .startup-topbar,
body.vano-route-register .startup-topbar{top:max(16px,env(safe-area-inset-top));left:max(20px,env(safe-area-inset-left));right:max(20px,env(safe-area-inset-right))}
body.vano-auth-startup .startup-wordmark,
body.vano-route-register .startup-wordmark{height:40px;width:172px}
body.vano-auth-startup .startup-wordmark img,
body.vano-route-register .startup-wordmark img{height:31px}
body.vano-auth-startup .startup-theme,
body.vano-route-register .startup-theme{width:44px;height:44px;border-radius:15px;border:1px solid var(--v402-line)!important;background:color-mix(in srgb,var(--v402-card) 84%,transparent)!important;color:var(--v402-muted)!important;box-shadow:var(--v402-shadow-soft)!important}

body.vano-auth-startup .startup-shell,
body.vano-route-register .startup-shell{
  width:min(1140px,100%)!important;
  min-height:min(700px,calc(100svh - 108px))!important;
  grid-template-columns:minmax(0,.92fr) minmax(440px,1.08fr)!important;
  border:1px solid var(--v402-line)!important;
  border-radius:34px!important;
  background:var(--v402-card)!important;
  box-shadow:var(--v402-shadow)!important;
  overflow:hidden;
}
body.vano-auth-startup .startup-auth,
body.vano-route-register .startup-auth{background:var(--v402-card)!important;position:relative}
body.vano-auth-startup .startup-auth:before,
body.vano-route-register .startup-auth:before{content:"";position:absolute;left:0;top:0;width:5px;height:100%;background:linear-gradient(180deg,var(--v402-accent),transparent 34%,transparent 65%,var(--v402-accent));opacity:.5}
body.vano-auth-startup .startup-auth-inner,
body.vano-route-register .startup-auth-inner{padding:clamp(38px,5vw,70px) clamp(32px,5.1vw,64px) 26px!important}
body.vano-auth-startup .startup-flow,
body.vano-route-register .startup-flow{width:min(100%,490px)!important}
body.vano-auth-startup .startup-eyebrow,
body.vano-route-register .startup-eyebrow{color:var(--v402-accent-strong)!important;font-size:9px!important;letter-spacing:.15em!important}
body.vano-auth-startup .startup-eyebrow>span,
body.vano-route-register .startup-eyebrow>span{background:var(--v402-accent)!important;width:24px!important}
body.vano-auth-startup .startup-copy h1,
body.vano-auth-startup .startup-copy h2,
body.vano-route-register .startup-copy h1,
body.vano-route-register .startup-copy h2{color:var(--v402-ink)!important;letter-spacing:-3.5px!important}
body.vano-auth-startup .startup-copy h1,
body.vano-route-register .startup-copy h1{font-size:clamp(50px,5vw,68px)!important;line-height:.92!important;margin-top:16px!important}
body.vano-auth-startup .startup-copy h1 em,
body.vano-route-register .startup-copy h1 em{color:var(--v402-accent-strong)!important}
body.vano-auth-startup .startup-copy p,
body.vano-route-register .startup-copy p{color:var(--v402-muted)!important;font-size:13px!important;max-width:410px!important}
body.vano-auth-startup .startup-benefits-v402,
body.vano-route-register .startup-benefits-v402{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px}
body.vano-auth-startup .startup-benefits-v402 span,
body.vano-route-register .startup-benefits-v402 span{display:inline-flex;align-items:center;gap:6px;min-height:28px;padding:0 9px;border-radius:999px;border:1px solid var(--v402-line);background:var(--v402-card-2);color:var(--v402-muted);font-size:9px;font-weight:800}
body.vano-auth-startup .startup-benefits-v402 svg,
body.vano-route-register .startup-benefits-v402 svg{width:13px;height:13px;color:var(--v402-accent-strong)}

body.vano-auth-startup .startup-actions,
body.vano-route-register .startup-actions{gap:9px!important;margin-top:26px!important}
body.vano-auth-startup .startup-primary,
body.vano-auth-startup .startup-secondary,
body.vano-auth-startup .startup-submit,
body.vano-route-register .startup-primary,
body.vano-route-register .startup-secondary,
body.vano-route-register .startup-submit{min-height:60px!important;border-radius:18px!important}
body.vano-auth-startup .startup-primary,
body.vano-route-register .startup-primary{border-color:var(--v402-line)!important;background:var(--v402-card)!important;color:var(--v402-ink)!important;box-shadow:0 8px 24px rgba(36,28,23,.055)!important}
html[data-vano-theme="black"] body.vano-auth-startup .startup-primary,
html[data-vano-theme-mode="black"] body.vano-auth-startup .startup-primary,
html[data-vano-theme="black"] body.vano-route-register .startup-primary,
html[data-vano-theme-mode="black"] body.vano-route-register .startup-primary{background:#181b20!important;box-shadow:none!important}
body.vano-auth-startup .startup-primary:hover,
body.vano-route-register .startup-primary:hover{border-color:rgba(242,139,80,.34)!important;box-shadow:0 14px 32px rgba(36,28,23,.08)!important}
body.vano-auth-startup .startup-secondary,
body.vano-route-register .startup-secondary{background:var(--v402-card-2)!important;border-color:var(--v402-line)!important;color:var(--v402-ink)!important}
body.vano-auth-startup .startup-secondary:hover,
body.vano-route-register .startup-secondary:hover{background:var(--v402-card)!important;border-color:rgba(242,139,80,.28)!important}
body.vano-auth-startup .startup-secondary-icon,
body.vano-route-register .startup-secondary-icon{background:var(--v402-card)!important;border-color:var(--v402-line)!important;color:var(--v402-accent-strong)!important}
body.vano-auth-startup .startup-secondary-copy small,
body.vano-auth-startup .startup-account-row,
body.vano-auth-startup .startup-guest,
body.vano-route-register .startup-secondary-copy small,
body.vano-route-register .startup-account-row,
body.vano-route-register .startup-guest{color:var(--v402-muted)!important}
body.vano-auth-startup .startup-account-row a,
body.vano-auth-startup .startup-email-register a,
body.vano-route-register .startup-account-row a,
body.vano-route-register .startup-email-register a{color:var(--v402-accent-strong)!important}
body.vano-auth-startup .startup-guest,
body.vano-route-register .startup-guest{margin-top:23px!important;padding:9px 12px;border-radius:999px;border:1px solid transparent}
body.vano-auth-startup .startup-guest:hover,
body.vano-route-register .startup-guest:hover{background:var(--v402-card-2);border-color:var(--v402-line)}

body.vano-auth-startup .startup-stage-email .startup-back,
body.vano-route-register .startup-stage-email .startup-back{color:var(--v402-muted)!important}
body.vano-auth-startup .startup-stage-email .startup-back:hover,
body.vano-route-register .startup-stage-email .startup-back:hover{background:var(--v402-card-2)!important;color:var(--v402-ink)!important}
body.vano-auth-startup .startup-field-label,
body.vano-route-register .startup-field-label{color:var(--v402-muted)!important}
body.vano-auth-startup .startup-field-head a,
body.vano-route-register .startup-field-head a{color:var(--v402-accent-strong)!important}
body.vano-auth-startup .startup-input-wrap,
body.vano-route-register .startup-input-wrap{height:59px!important;border-radius:18px!important;background:var(--v402-card-2)!important;border:1px solid var(--v402-line)!important;box-shadow:none!important}
body.vano-auth-startup .startup-input-wrap:hover,
body.vano-route-register .startup-input-wrap:hover{border-color:var(--v402-line-strong)!important;background:var(--v402-card)!important}
body.vano-auth-startup .startup-input-wrap:focus-within,
body.vano-route-register .startup-input-wrap:focus-within{background:var(--v402-card)!important;border-color:rgba(242,139,80,.54)!important;box-shadow:0 0 0 4px rgba(242,139,80,.11)!important;transform:translateY(-1px)}
body.vano-auth-startup .startup-input-wrap input,
body.vano-route-register .startup-input-wrap input{color:var(--v402-ink)!important;font-size:14px!important;font-weight:680!important}
body.vano-auth-startup .startup-input-wrap input::placeholder,
body.vano-route-register .startup-input-wrap input::placeholder{color:var(--v402-faint)!important}
body.vano-auth-startup .startup-input-wrap>svg,
body.vano-auth-startup .startup-password-toggle,
body.vano-route-register .startup-input-wrap>svg,
body.vano-route-register .startup-password-toggle{color:var(--v402-accent-strong)!important}
body.vano-auth-startup .startup-submit,
body.vano-route-register .startup-submit{border:0!important;background:linear-gradient(135deg,#f39a60,#e77539)!important;color:#fff!important;box-shadow:0 16px 34px rgba(222,111,54,.24)!important;font-weight:900!important}
body.vano-auth-startup .startup-submit:hover,
body.vano-route-register .startup-submit:hover{box-shadow:0 20px 42px rgba(222,111,54,.31)!important;transform:translateY(-1px)}

body.vano-auth-startup .startup-visual,
body.vano-route-register .startup-visual{position:relative;background:#101318!important;border-left:1px solid var(--v402-line)!important}
body.vano-auth-startup .visual-grid,
body.vano-route-register .visual-grid{opacity:.5!important;background-size:36px 36px!important}
body.vano-auth-startup .visual-glow,
body.vano-route-register .visual-glow{background:radial-gradient(circle at 52% 35%,rgba(255,148,86,.16),transparent 28%),radial-gradient(circle at 48% 78%,rgba(255,148,86,.08),transparent 30%)!important}
body.vano-auth-startup .visual-head,
body.vano-route-register .visual-head{padding:28px 30px!important;color:#d6d8db!important}
body.vano-auth-startup .visual-live,
body.vano-route-register .visual-live{background:rgba(255,255,255,.06)!important;border:1px solid rgba(255,255,255,.08)!important;border-radius:999px!important;padding:7px 10px!important}
body.vano-auth-startup .visual-live i,
body.vano-route-register .visual-live i{background:#74d99a!important;box-shadow:0 0 0 5px rgba(116,217,154,.11)!important}
body.vano-auth-startup .visual-map,
body.vano-route-register .visual-map{inset:82px 34px 118px 34px!important;border-radius:30px!important;border:1px solid rgba(255,255,255,.08)!important;background:linear-gradient(160deg,#161b20,#0f1216)!important;box-shadow:0 35px 80px rgba(0,0,0,.34)!important;overflow:hidden}
body.vano-auth-startup .visual-roads path,
body.vano-route-register .visual-roads path{stroke:rgba(255,255,255,.085)!important;stroke-width:9!important}
body.vano-auth-startup .visual-route .route-line,
body.vano-route-register .visual-route .route-line{stroke:#ff9255!important;filter:drop-shadow(0 0 10px rgba(255,146,85,.34))}
body.vano-auth-startup .visual-route .route-halo,
body.vano-route-register .visual-route .route-halo{stroke:rgba(255,146,85,.14)!important}
body.vano-auth-startup .visual-route-card,
body.vano-route-register .visual-route-card{left:18px!important;bottom:18px!important;right:auto!important;width:min(270px,calc(100% - 36px));background:rgba(16,19,23,.78)!important;border:1px solid rgba(255,255,255,.1)!important;color:#fff!important;backdrop-filter:blur(18px)!important}
body.vano-auth-startup .visual-route-card small,
body.vano-auth-startup .visual-route-card p,
body.vano-route-register .visual-route-card small,
body.vano-route-register .visual-route-card p{color:#9fa7af!important}
body.vano-auth-startup .visual-route-card .visual-pill,
body.vano-route-register .visual-route-card .visual-pill{background:rgba(255,146,85,.14)!important;color:#ffb98f!important;border-color:rgba(255,146,85,.18)!important}
body.vano-auth-startup .visual-recalc-card,
body.vano-route-register .visual-recalc-card{right:18px!important;top:18px!important;background:rgba(16,19,23,.78)!important;border:1px solid rgba(255,255,255,.1)!important;color:#fff!important;backdrop-filter:blur(18px)!important}
body.vano-auth-startup .visual-recalc-card small,
body.vano-route-register .visual-recalc-card small{color:#9fa7af!important}
body.vano-auth-startup .visual-footer,
body.vano-route-register .visual-footer{left:34px!important;right:34px!important;bottom:29px!important;color:#fff!important}
body.vano-auth-startup .visual-footer p,
body.vano-route-register .visual-footer p{font-size:23px!important;letter-spacing:-1px!important}
