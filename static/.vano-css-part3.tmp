body.vano-route-admin-dashboard .admin350-modal .node-form-grid textarea{width:100%;border:1px solid var(--a-line);background:var(--a-soft);color:var(--a-text);border-radius:10px;padding:9px 10px;outline:0;font-size:9.5px}body.vano-route-admin-dashboard .admin350-modal .node-form-grid input:focus,
