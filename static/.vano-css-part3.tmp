body.vano-route-register .ob-journey-v402>span.is-done>i{background:rgba(64,164,104,.11);border-color:rgba(64,164,104,.16);color:#43a36a}

body.vano-auth-startup .ob-step-v340,
body.vano-route-register .ob-step-v340{padding-top:clamp(26px,4vh,42px)!important}
body.vano-auth-startup .ob-eyebrow-v340,
body.vano-route-register .ob-eyebrow-v340{min-height:30px!important;padding:0 10px!important;background:var(--v402-accent-soft)!important;border-color:transparent!important;color:var(--v402-accent-strong)!important;font-size:9px!important;letter-spacing:.1em!important}
body.vano-auth-startup .ob-step-heading-v340 h1,
body.vano-route-register .ob-step-heading-v340 h1{margin:15px 0 10px!important;font-size:clamp(39px,4.9vw,62px)!important;line-height:.94!important;letter-spacing:-3.3px!important;color:var(--v402-ink)!important;max-width:700px!important}
body.vano-auth-startup .ob-step-heading-v340 h1 span,
body.vano-route-register .ob-step-heading-v340 h1 span{color:var(--v402-muted)!important}
body.vano-auth-startup .ob-step-heading-v340 p,
