  body.vano-auth-startup .ob-summary-v340,
body.vano-route-register .ob-summary-v340{grid-template-columns:50px minmax(0,1fr)!important}body.vano-auth-startup .ob-summary-avatar-v340,
body.vano-route-register .ob-summary-avatar-v340{width:50px!important;height:50px!important}body.vano-auth-startup .ob-summary-badge-v340,
body.vano-route-register .ob-summary-badge-v340{grid-column:1/-1;width:max-content!important}
  body.vano-auth-startup .ob-summary-grid-v340,
