body.vano-route-register .ob-shell.ob-shell-v402{display:block!important;min-height:calc(100svh - 16px)!important;border-radius:26px!important;overflow:visible!important}
  body.vano-auth-startup .ob-main-v340,
body.vano-route-register .ob-main-v340{min-height:calc(100svh - 16px)!important;padding:18px 15px 13px!important}
  body.vano-auth-startup .ob-brand-v340,
body.vano-route-register .ob-brand-v340{max-width:154px!important}body.vano-auth-startup .ob-brand-v340 img,
body.vano-route-register .ob-brand-v340 img{height:27px!important;max-width:154px!important}
  body.vano-auth-startup .ob-head-actions-v402,
body.vano-route-register .ob-head-actions-v402{gap:6px}body.vano-auth-startup .ob-step-label-v340,
body.vano-route-register .ob-step-label-v340{min-height:32px!important}body.vano-auth-startup .ob-theme-v402,
