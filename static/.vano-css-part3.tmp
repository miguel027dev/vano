  body.vano-auth-startup .ob-journey-v402,
body.vano-route-register .ob-journey-v402{gap:4px;margin-top:10px}body.vano-auth-startup .ob-journey-v402>span,
body.vano-route-register .ob-journey-v402>span{grid-template-columns:24px 1fr;gap:6px;padding:6px 5px}body.vano-auth-startup .ob-journey-v402>span>i,
body.vano-route-register .ob-journey-v402>span>i{width:24px;height:24px;border-radius:8px}body.vano-auth-startup .ob-journey-v402>span small,
body.vano-route-register .ob-journey-v402>span small{display:none}
  body.vano-auth-startup .ob-step-v340,
body.vano-route-register .ob-step-v340{padding-top:26px!important;padding-bottom:88px!important}
  body.vano-auth-startup .ob-step-heading-v340 h1,
body.vano-route-register .ob-step-heading-v340 h1{font-size:clamp(36px,10.8vw,49px)!important;letter-spacing:-2.5px!important;line-height:.96!important}body.vano-auth-startup .ob-step-heading-v340 p,
body.vano-route-register .ob-step-heading-v340 p{font-size:11.5px!important}
  body.vano-auth-startup .ob-card-v340,
body.vano-route-register .ob-card-v340{margin-top:18px!important;padding:12px!important;border-radius:20px!important}
  body.vano-auth-startup .ob-live-profile-v402,
body.vano-route-register .ob-live-profile-v402{padding:10px!important}body.vano-auth-startup .ob-live-profile-v402 em,
body.vano-route-register .ob-live-profile-v402 em{display:none}
  body.vano-auth-startup .ob-field-grid-v340,
body.vano-route-register .ob-field-grid-v340{grid-template-columns:1fr!important}body.vano-auth-startup .ob-field-choice-v340,
body.vano-route-register .ob-field-choice-v340{grid-column:auto!important}
  body.vano-auth-startup .ob-choice-grid-v340,
