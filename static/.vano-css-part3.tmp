body.vano-auth-startup .ob-progress-steps-v344,
body.vano-route-register .ob-progress-steps-v344{display:none!important}
body.vano-auth-startup .ob-journey-v402,
body.vano-route-register .ob-journey-v402{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:12px}
body.vano-auth-startup .ob-journey-v402>span,
body.vano-route-register .ob-journey-v402>span{min-width:0;display:grid;grid-template-columns:26px minmax(0,1fr);align-items:center;gap:8px;padding:7px;border-radius:12px;color:var(--v402-faint);transition:.24s var(--v402-ease)}
body.vano-auth-startup .ob-journey-v402>span>i,
body.vano-route-register .ob-journey-v402>span>i{width:26px;height:26px;display:grid;place-items:center;border-radius:9px;border:1px solid var(--v402-line);background:var(--v402-card-2);font-style:normal;font-size:9px;font-weight:900;color:var(--v402-muted)}
body.vano-auth-startup .ob-journey-v402>span b,
body.vano-route-register .ob-journey-v402>span b{display:block;font-size:9.5px;color:inherit;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
body.vano-auth-startup .ob-journey-v402>span small,
body.vano-route-register .ob-journey-v402>span small{display:block;margin-top:1px;font-size:7.5px;color:var(--v402-faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
body.vano-auth-startup .ob-journey-v402>span.is-active,
body.vano-route-register .ob-journey-v402>span.is-active{background:var(--v402-accent-soft);color:var(--v402-accent-strong)}
body.vano-auth-startup .ob-journey-v402>span.is-active>i,
body.vano-route-register .ob-journey-v402>span.is-active>i{background:var(--v402-accent);border-color:transparent;color:#fff;box-shadow:0 8px 18px rgba(222,111,54,.20)}
body.vano-auth-startup .ob-journey-v402>span.is-done,
body.vano-route-register .ob-journey-v402>span.is-done{color:var(--v402-muted)}
