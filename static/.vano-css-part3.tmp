  body.vano-auth-startup .ob-language-grid-v340,
body.vano-route-register .ob-language-grid-v340{grid-template-columns:1fr!important;gap:7px!important}body.vano-auth-startup .ob-language-card-v340,
body.vano-route-register .ob-language-card-v340{min-height:61px!important}
  body.vano-auth-startup .ob-language-foot-v344,
