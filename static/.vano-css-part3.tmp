body.vano-auth-startup .ob-step-label-v340,
body.vano-route-register .ob-step-label-v340{min-height:34px!important;padding:0 11px!important;border-radius:999px!important;background:var(--v402-card-2)!important;border-color:var(--v402-line)!important;color:var(--v402-muted)!important;font-size:9px!important;letter-spacing:.08em!important}
body.vano-auth-startup .ob-theme-v402,
body.vano-route-register .ob-theme-v402{width:36px;height:36px;display:grid;place-items:center;border:1px solid var(--v402-line);border-radius:12px;background:var(--v402-card-2);color:var(--v402-muted);transition:.2s var(--v402-ease)}
body.vano-auth-startup .ob-theme-v402:hover,
body.vano-route-register .ob-theme-v402:hover{transform:translateY(-1px);border-color:rgba(242,139,80,.25);color:var(--v402-accent-strong)}
body.vano-auth-startup .ob-theme-v402 .v402-moon,
body.vano-route-register .ob-theme-v402 .v402-moon{display:none}
html[data-vano-theme="black"] body.vano-auth-startup .ob-theme-v402 .v402-sun,
html[data-vano-theme-mode="black"] body.vano-auth-startup .ob-theme-v402 .v402-sun,
html[data-vano-theme="black"] body.vano-route-register .ob-theme-v402 .v402-sun,
html[data-vano-theme-mode="black"] body.vano-route-register .ob-theme-v402 .v402-sun{display:none}
html[data-vano-theme="black"] body.vano-auth-startup .ob-theme-v402 .v402-moon,
html[data-vano-theme-mode="black"] body.vano-auth-startup .ob-theme-v402 .v402-moon,
html[data-vano-theme="black"] body.vano-route-register .ob-theme-v402 .v402-moon,
html[data-vano-theme-mode="black"] body.vano-route-register .ob-theme-v402 .v402-moon{display:block}
body.vano-auth-startup .ob-progress-v340,
body.vano-route-register .ob-progress-v340{height:3px!important;margin-top:18px!important;background:var(--v402-line)!important}
body.vano-auth-startup .ob-progress-v340 i,
