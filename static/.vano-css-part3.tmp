/* VANO MAPS — unified stylesheet part 3. */

/* ===== static/vano-access.css ===== */
body.vano-route-access-page.vano-route-access-page{--access-ink:#202a37;--access-muted:#596572;--access-surface:#fff;--access-line:#e5e8ec;background:#f7f8fa!important;color:var(--access-ink)!important;min-height:100svh;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
body.vano-route-access-page.vano-route-access-page>.topbar,
body.vano-route-access-page.vano-route-access-page>footer,
body.vano-route-access-page.vano-route-access-page>.mobile-dock{display:none!important}
body.vano-route-access-page .access-page,
body.vano-route-access-page .access-page *{box-sizing:border-box}
body.vano-route-access-page .access-page{max-width:1184px;margin:auto;padding:24px max(20px,env(safe-area-inset-right)) max(24px,env(safe-area-inset-bottom)) max(20px,env(safe-area-inset-left))}
body.vano-route-access-page .access-page a{text-decoration:none;color:inherit}
body.vano-route-access-page .access-page svg{width:22px;height:22px;flex-shrink:0}
body.vano-route-access-page .access-header,
body.vano-route-access-page .access-brand,
body.vano-route-access-page .access-back,
body.vano-route-access-page .access-card-top,
body.vano-route-access-page .access-footer,
body.vano-route-access-page .access-footer nav{display:flex;align-items:center}
body.vano-route-access-page .access-header{justify-content:space-between;gap:20px}
body.vano-route-access-page .access-brand{gap:10px;font-weight:850;font-size:20px;letter-spacing:-.6px}
body.vano-route-access-page .access-brand img{border-radius:12px}body.vano-route-access-page .access-brand-light{font-weight:500;color:var(--access-muted);font-size:14px;letter-spacing:1px}
body.vano-route-access-page .access-back{gap:6px;font-size:14px;font-weight:650;min-height:44px}
body.vano-route-access-page .access-intro{padding:68px 0 40px;text-align:center}
body.vano-route-access-page .access-eyebrow{display:inline-flex;align-items:center;gap:8px;color:#985029;font-size:12px;font-weight:650;line-height:1.5}
body.vano-route-access-page .access-eyebrow>span{height:7px;width:7px;border-radius:50%;background:#ed792f}
body.vano-route-access-page .access-intro h1{font-size:clamp(42px,6.5vw,72px);line-height:1.02;letter-spacing:-.055em;margin:22px 0 20px;color:var(--access-ink);font-weight:800}
body.vano-route-access-page .access-intro h1 span{color:#c65320}
body.vano-route-access-page .access-intro p{font-size:16px;line-height:1.65;color:var(--access-muted);margin:0}
body.vano-route-access-page .access-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
body.vano-route-access-page .access-card{min-width:0;display:flex;flex-direction:column;padding:26px 24px 20px;background:var(--access-surface);border:1px solid var(--access-line);border-radius:24px;box-shadow:0 8px 28px #24304006}
body.vano-route-access-page .access-android{border-color:#edc5ab;background:linear-gradient(150deg,#fff5eb 0%,var(--access-surface) 60%)}
body.vano-route-access-page .access-card-top{justify-content:space-between;gap:12px;flex-wrap:wrap}
body.vano-route-access-page .access-platform-icon{display:grid;place-items:center;width:50px;height:50px;border:1px solid var(--access-line);border-radius:16px;background:var(--access-surface);color:var(--access-ink)}
body.vano-route-access-page .access-platform-icon svg{width:27px;height:27px}
body.vano-route-access-page .access-badge{font-size:11px;line-height:1.4;color:#356557;background:#edf6f1;padding:6px 9px;border-radius:8px;font-weight:650}
body.vano-route-access-page .access-badge-soon{background:#ffe9d8;color:#8e491e}
body.vano-route-access-page .access-card h2{font-size:25px;letter-spacing:-.8px;line-height:1.15;margin:24px 0 11px;color:var(--access-ink)}
body.vano-route-access-page .access-card>p{color:var(--access-muted);font-size:14px;line-height:1.65;margin:0;max-width:29em}
body.vano-route-access-page .access-countdown{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin:25px 0 10px}
body.vano-route-access-page .access-countdown[hidden]{display:none}
body.vano-route-access-page .access-countdown>div{border:1px solid #eed7c6;border-radius:12px;background:var(--access-surface);padding:10px 2px;text-align:center;min-width:0}
body.vano-route-access-page .access-countdown strong{display:block;font-size:27px;line-height:1.1;font-variant-numeric:tabular-nums;color:var(--access-ink);font-weight:750}
body.vano-route-access-page .access-countdown span{font-size:10px;line-height:1.6;color:var(--access-muted)}
body.vano-route-access-page .access-card .access-release-date{font-size:11px;text-align:center;margin-bottom:24px}
body.vano-route-access-page .access-feature{display:flex;align-items:center;gap:12px;margin:30px 0;padding:20px 0;line-height:1.7;font-size:13px;color:var(--access-muted)}
body.vano-route-access-page .access-feature>svg{color:#bd5f2b}body.vano-route-access-page .access-feature strong{font-weight:550;color:var(--access-ink)}
body.vano-route-access-page .access-card-bottom{margin-top:auto}
body.vano-route-access-page .access-action{display:flex;justify-content:center;align-items:center;gap:10px;min-height:50px;width:100%;border-radius:13px;border:1px solid #d6dce2;background:var(--access-surface);padding:12px;font-size:14px;line-height:1.4;font-weight:700;text-align:center}
body.vano-route-access-page .access-action-primary{background:#d85e28!important;border-color:#d85e28!important;color:white!important}
body.vano-route-access-page .access-action-disabled{color:#6d625b;border-color:#e6ddd5;background:#f3eee9;cursor:not-allowed}
body.vano-route-access-page .access-action:not(:disabled):hover{box-shadow:0 4px 14px #242b3815}body.vano-route-access-page .access-action:not(:disabled):active{transform:translateY(1px)}
body.vano-route-access-page .access-note{font-size:11px;text-align:center;line-height:1.6;color:var(--access-muted);margin:12px 0 0}
body.vano-route-access-page .access-footer{margin-top:36px;padding-top:20px;border-top:1px solid var(--access-line);font-size:12px;line-height:1.5;color:var(--access-muted);justify-content:space-between;gap:16px;flex-wrap:wrap}
body.vano-route-access-page .access-footer nav{gap:20px}body.vano-route-access-page .access-footer a{display:inline-flex;align-items:center;min-height:44px}
body.vano-route-access-page .access-page :focus-visible{outline:3px solid #9c451b;outline-offset:4px}
html[data-vano-theme="black"] body.vano-route-access-page.vano-route-access-page{--access-ink:#f2f4f7;--access-muted:#b2bbc7;--access-surface:#1c222b;--access-line:#343d49;background:#12171f!important}
html[data-vano-theme="black"] body.vano-route-access-page .access-android{background:linear-gradient(145deg,#35251d,#1c222b 65%);border-color:#785137}
html[data-vano-theme="black"] body.vano-route-access-page .access-intro h1 span{color:#ffad74}html[data-vano-theme="black"] body.vano-route-access-page .access-eyebrow{color:#fbb78e}
html[data-vano-theme="black"] body.vano-route-access-page .access-action-disabled{background:#302b28;color:#d3c7bd;border-color:#51443a}
@media(max-width:800px){body.vano-route-access-page .access-page{max-width:600px}body.vano-route-access-page .access-options{grid-template-columns:1fr;gap:16px}body.vano-route-access-page .access-intro{padding:44px 0 30px}body.vano-route-access-page .access-card{padding:22px}body.vano-route-access-page .access-card h2{margin-top:20px}body.vano-route-access-page .access-feature{margin:16px 0}body.vano-route-access-page .access-countdown{max-width:340px;width:100%;align-self:center}body.vano-route-access-page .access-footer{margin-top:24px}body.vano-route-access-page .access-note{font-size:12px}body.vano-route-access-page .access-brand-light{display:none}}
@media(max-width:350px){body.vano-route-access-page .access-page{padding-inline:16px}body.vano-route-access-page .access-intro h1{font-size:42px}body.vano-route-access-page .access-card{padding:18px}body.vano-route-access-page .access-badge{font-size:10px}body.vano-route-access-page .access-footer{display:block}}
@media(prefers-reduced-motion:reduce){body.vano-route-access-page .access-page *{transition:none!important;animation:none!important}}


/* ===== static/vano-admin-page.css ===== */
/* VANO MAPS — bundle consolidado. Ordem preservada do runtime original. */

/* ---- vano-admin.css ---- */
html:has(.admin86 body.vano-admin-surface),
body.vano-admin-surface:has(.admin86){background:#f6f8fc!important;color:#111827}
body.vano-admin-surface:has(.admin86):before{background:
  radial-gradient(circle at 10% -10%,rgba(217,112,63,.12),transparent 22%),
  radial-gradient(circle at 90% 0%,rgba(90,209,255,.10),transparent 20%),
  linear-gradient(180deg,#fbfcff,#f3f6fb 45%,#eef3f8 100%)!important;opacity:1}
body.vano-admin-surface:has(.admin86) .topbar{background:rgba(255,255,255,.86)!important;border-bottom:1px solid rgba(106,122,145,.12)!important;backdrop-filter:blur(18px);box-shadow:0 12px 30px rgba(40,54,85,.05)}
body.vano-admin-surface:has(.admin86) .navlinks a,
body.vano-admin-surface:has(.admin86) .navlinks button.navbtn,
body.vano-admin-surface:has(.admin86) .nav-actions span{color:#566174}
body.vano-admin-surface:has(.admin86) .navlinks a:hover,
body.vano-admin-surface:has(.admin86) .navlinks a.active,
body.vano-admin-surface:has(.admin86) .navlinks button.navbtn:hover{background:#eef3ff;color:#1b2230}
body.vano-admin-surface:has(.admin86) .btn{border-color:#d7dfeb;background:#fff;color:#1f2937;box-shadow:0 10px 20px rgba(63,79,107,.06)}
body.vano-admin-surface:has(.admin86) .btn:hover{background:#f8fbff;border-color:#c9d4e4}
body.vano-admin-surface:has(.admin86) .btn-primary{background:linear-gradient(135deg,#D9703F,#F59A62);color:#fff;border-color:transparent;box-shadow:0 16px 30px rgba(217,112,63,.20)}
body.vano-admin-surface:has(.admin86) footer{border-top:1px solid rgba(106,122,145,.10);color:#6c7584}

body.vano-admin-surface .admin86{padding:28px 0 90px}
body.vano-admin-surface .admin86-wrap{width:min(1360px,calc(100% - 28px))}
body.vano-admin-surface .admin86-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:18px}
body.vano-admin-surface .admin86-eyebrow{display:inline-flex;align-items:center;padding:7px 12px;border-radius:999px;background:#eef0ff;color:#D9703F;font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
body.vano-admin-surface .admin86-head h1{margin:10px 0 8px;font-size:clamp(34px,4vw,52px);line-height:1;letter-spacing:-2px;color:#0f172a}
body.vano-admin-surface .admin86-head p{margin:0;max-width:760px;color:#677487;line-height:1.65;font-size:15px}
body.vano-admin-surface .admin86-actions{display:flex;flex-wrap:wrap;gap:10px}
body.vano-admin-surface .admin86-btn{min-height:42px;border-radius:14px;font-weight:800}

body.vano-admin-surface .admin86-card{background:rgba(255,255,255,.94);border:1px solid rgba(212,221,236,.88);border-radius:26px;box-shadow:0 20px 50px rgba(57,72,97,.08),inset 0 1px 0 rgba(255,255,255,.8)}
body.vano-admin-surface .panel-pad{padding:20px}
body.vano-admin-surface .section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:16px}body.vano-admin-surface .section-head h2{margin:5px 0 0;font-size:22px;letter-spacing:-.8px;color:#111827}body.vano-admin-surface .section-head p{margin:7px 0 0;color:#6b7280;font-size:14px;line-height:1.55}body.vano-admin-surface .section-tag{display:inline-flex;align-items:center;padding:6px 10px;border-radius:999px;background:#f1f4ff;color:#D9703F;font-size:11px;font-weight:800;letter-spacing:.07em;text-transform:uppercase}body.vano-admin-surface .compact-spread{align-items:center}body.vano-admin-surface .pill-soft{display:inline-flex;align-items:center;gap:6px;padding:10px 14px;border-radius:999px;background:#f6f8fc;border:1px solid #dde5f0;color:#5f6b7d;font-size:13px;font-weight:700}body.vano-admin-surface .pill-soft b{color:#111827}body.vano-admin-surface .is-status{text-transform:capitalize;padding:8px 12px;font-size:12px}

body.vano-admin-surface .admin86-hero{display:grid;grid-template-columns:1.25fr .78fr;gap:18px;padding:24px;margin-bottom:16px;overflow:hidden;position:relative}body.vano-admin-surface .admin86-hero:before{content:"";position:absolute;right:-40px;top:-30px;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(217,112,63,.14),transparent 62%);pointer-events:none}body.vano-admin-surface .hero-copy{position:relative;z-index:1}body.vano-admin-surface .hero-tag{display:inline-flex;padding:6px 11px;border-radius:999px;background:#eef2ff;color:#D9703F;font-size:11px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}body.vano-admin-surface .hero-mainline{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin-top:14px}body.vano-admin-surface .hero-mainline small,
body.vano-admin-surface .hero-capacity-box small,
body.vano-admin-surface .hero-meta-grid small,
body.vano-admin-surface .mini-stat small{display:block;color:#738194;font-size:12px;font-weight:700}body.vano-admin-surface .hero-mainline h2{margin:5px 0 0;font-size:clamp(46px,8vw,78px);line-height:.92;letter-spacing:-3px;color:#0f172a}body.vano-admin-surface .hero-capacity-box{min-width:180px;padding:16px 18px;border-radius:22px;background:linear-gradient(180deg,#f7f9ff,#eef3ff);border:1px solid #dde4fb}body.vano-admin-surface .hero-capacity-box b{display:block;margin-top:6px;font-size:34px;letter-spacing:-1.5px;color:#D9703F}body.vano-admin-surface .hero-occupancy-copy{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:12px;color:#516072;font-size:14px}body.vano-admin-surface .hero-occupancy-copy b{font-size:16px;color:#162033}body.vano-admin-surface .hero-progress{height:14px;margin-top:10px;border-radius:999px;background:#ebf0f8;overflow:hidden;border:1px solid #dbe5f2}body.vano-admin-surface .hero-progress span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#D9703F,#F59A62 55%,#67d4ff);box-shadow:0 8px 18px rgba(217,112,63,.25);transition:width .35s ease}body.vano-admin-surface .hero-meta-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:18px}body.vano-admin-surface .hero-meta-grid>div{padding:14px 16px;border-radius:18px;background:#f8faff;border:1px solid #e3eaf4}body.vano-admin-surface .hero-meta-grid b,
body.vano-admin-surface .mini-stat b{display:block;margin-top:5px;font-size:22px;letter-spacing:-1px;color:#121826}body.vano-admin-surface .hero-warning{display:flex;align-items:center;gap:8px;margin-top:14px;padding:12px 14px;border-radius:16px;background:#fff8ea;border:1px solid #f4dfab;color:#7f5c16;font-size:14px;line-height:1.45}body.vano-admin-surface .hero-side{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-content:start}body.vano-admin-surface .mini-stat{padding:16px;border-radius:20px;background:#f8fbff;border:1px solid #e1e8f4}body.vano-admin-surface .mini-stat b{font-size:26px}body.vano-admin-surface .mini-stat.emphasis{background:linear-gradient(180deg,#FFFBF2,#eef0ff);border-color:#E8DED6}

body.vano-admin-surface .admin86-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}body.vano-admin-surface .kpi-card{padding:18px 18px 16px;border-radius:22px;background:#fff;border:1px solid #dde5f0;box-shadow:0 12px 28px rgba(63,79,107,.05)}body.vano-admin-surface .kpi-card.accent{background:linear-gradient(145deg,#FFFBF2,#fff)}body.vano-admin-surface .kpi-label{display:block;color:#6d7890;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}body.vano-admin-surface .kpi-card b{display:block;margin-top:10px;font-size:34px;line-height:1;letter-spacing:-1.5px;color:#0f172a}body.vano-admin-surface .kpi-card small{display:block;margin-top:6px;color:#778293;font-size:13px}

body.vano-admin-surface .admin86-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}body.vano-admin-surface .summary-grid,
body.vano-admin-surface .health-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}body.vano-admin-surface .summary-grid>div,
body.vano-admin-surface .health-grid>div{padding:14px 15px;border-radius:18px;background:#f8fbff;border:1px solid #e2eaf5}body.vano-admin-surface .summary-grid small,
body.vano-admin-surface .health-grid small{display:block;color:#6f7c8f;font-size:12px;font-weight:700}body.vano-admin-surface .summary-grid b,
body.vano-admin-surface .health-grid b{display:block;margin-top:5px;color:#101827;font-size:24px;letter-spacing:-1px}body.vano-admin-surface .live-chip{display:inline-flex;align-items:center;gap:8px;padding:10px 12px;border-radius:999px;background:#f8fbff;border:1px solid #e1e8f3;color:#687588;font-size:13px;font-weight:700}body.vano-admin-surface .live-dot{width:10px;height:10px;border-radius:50%;background:#29c27e;box-shadow:0 0 0 6px rgba(41,194,126,.16)}

body.vano-admin-surface .infra-panel{padding:22px;margin-bottom:16px}body.vano-admin-surface .infra-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}body.vano-admin-surface .admin86-primary{min-height:44px;border-radius:14px;font-weight:800}body.vano-admin-surface .server-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}body.vano-admin-surface .server-card{padding:16px;border-radius:22px;background:#fbfdff;border:1px solid #e2eaf5;box-shadow:0 12px 28px rgba(70,86,115,.05);transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}body.vano-admin-surface .server-card:hover{transform:translateY(-2px);box-shadow:0 18px 34px rgba(70,86,115,.09);border-color:#ced8e8}body.vano-admin-surface .server-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}body.vano-admin-surface .server-id{display:inline-flex;align-items:center;justify-content:center;min-width:54px;height:26px;padding:0 10px;border-radius:999px;background:#eef2ff;color:#D9703F;font-size:11px;font-weight:900;letter-spacing:.08em}body.vano-admin-surface .server-head h3{margin:8px 0 3px;font-size:18px;letter-spacing:-.6px;color:#131c2c}body.vano-admin-surface .server-head p{margin:0;color:#738194;font-size:13px}body.vano-admin-surface .server-status{flex:0 0 auto;padding:9px 11px;border-radius:999px;font-size:11px;font-weight:900;letter-spacing:.08em}body.vano-admin-surface .status-test{background:#FFFBF2;color:#D9703F}body.vano-admin-surface .status-online{background:#e8fbf1;color:#15965e}body.vano-admin-surface .status-offline{background:#ffedf0;color:#d9485f}body.vano-admin-surface .status-pending{background:#fff7e8;color:#ba7816}body.vano-admin-surface .status-disabled{background:#eef1f5;color:#7a8596}body.vano-admin-surface .server-users-row{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-top:14px}body.vano-admin-surface .server-users-row small,
body.vano-admin-surface .server-metrics small,
body.vano-admin-surface .server-meta-list span{display:block;color:#718095;font-size:12px;font-weight:700}body.vano-admin-surface .server-users-row b{display:block;margin-top:5px;font-size:28px;letter-spacing:-1.2px;color:#111827}body.vano-admin-surface .mini-badge{padding:10px 12px;border-radius:14px;background:#f4f8ff;border:1px solid #e0e9f6;color:#5f6e82;font-size:12px;font-weight:800}body.vano-admin-surface .server-visual-wrap{display:grid;grid-template-columns:130px 1fr;gap:14px;align-items:center;margin-top:12px;padding:14px;border-radius:20px;background:linear-gradient(180deg,#f8fbff,#f2f6fd);border:1px solid #e1e9f6}body.vano-admin-surface .server-rack{position:relative;height:168px;border-radius:24px;background:linear-gradient(180deg,#fbfcff,#eef4ff);border:2px solid #d8e2f1;box-shadow:inset 0 1px 0 rgba(255,255,255,.85),0 10px 22px rgba(79,99,130,.08);overflow:hidden}body.vano-admin-surface .server-rack-top{position:absolute;top:10px;left:14px;right:14px;height:12px;border-radius:999px;background:linear-gradient(90deg,#d8e0ec,#eef4fc)}body.vano-admin-surface .server-rack-fill{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(180deg,rgba(217,112,63,.12),rgba(217,112,63,.22) 55%,rgba(86,202,255,.32));transition:height .35s ease}body.vano-admin-surface .server-rack-fill:after{content:"";position:absolute;left:10px;right:10px;top:10px;height:36px;background:linear-gradient(180deg,rgba(255,255,255,.28),transparent);border-radius:16px}body.vano-admin-surface .server-slot-grid{position:absolute;inset:28px 12px 12px;display:grid;grid-template-rows:repeat(4,1fr);gap:8px}body.vano-admin-surface .server-slot{position:relative;display:grid;grid-template-columns:12px 1fr auto;align-items:center;gap:8px;padding:0 10px;border-radius:13px;background:rgba(255,255,255,.68);border:1px solid rgba(212,222,238,.95);backdrop-filter:blur(2px);z-index:1;transition:background .25s ease,border-color .25s ease,transform .18s ease,box-shadow .18s ease}body.vano-admin-surface .server-slot.active{background:linear-gradient(90deg,rgba(217,112,63,.18),rgba(103,212,255,.16));border-color:rgba(245,154,98,.42);box-shadow:0 8px 18px rgba(217,112,63,.12)}body.vano-admin-surface .slot-led{width:8px;height:8px;border-radius:50%;background:#cad3e1;box-shadow:0 0 0 4px rgba(202,211,225,.20)}body.vano-admin-surface .server-slot.active .slot-led{background:#D9703F;box-shadow:0 0 0 5px rgba(217,112,63,.18)}body.vano-admin-surface .slot-line{height:6px;border-radius:999px;background:#d3dce8}body.vano-admin-surface .slot-line.short{width:26px}body.vano-admin-surface .server-slot.active .slot-line{background:linear-gradient(90deg,#F59A62,#69d5ff)}body.vano-admin-surface .server-visual-copy{display:grid;gap:12px}body.vano-admin-surface .server-visual-copy>div{padding:12px 14px;border-radius:16px;background:#fff;border:1px solid #e3ebf5}body.vano-admin-surface .server-visual-copy small{display:block;color:#748195;font-size:12px;font-weight:700}body.vano-admin-surface .server-visual-copy b{display:block;margin-top:6px;font-size:26px;line-height:1;color:#101827;letter-spacing:-1px}body.vano-admin-surface .server-visual-copy span{display:block;margin-top:6px;color:#5e6b7f;font-size:14px;font-weight:800}body.vano-admin-surface .server-progress{height:10px;margin-top:10px;border-radius:999px;background:#ebf0f7;overflow:hidden;border:1px solid #dbe5f2}body.vano-admin-surface .server-progress span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#D9703F,#F59A62 55%,#67d4ff);transition:width .35s ease}body.vano-admin-surface .server-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}body.vano-admin-surface .server-metrics>div,
body.vano-admin-surface .server-meta-list>div{padding:12px;border-radius:16px;background:#fff;border:1px solid #e4ebf5}body.vano-admin-surface .server-metrics b{display:block;margin-top:4px;font-size:18px;color:#111827}body.vano-admin-surface .server-meta-list{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}body.vano-admin-surface .server-meta-list strong,
body.vano-admin-surface .server-meta-list code{display:block;margin-top:5px;color:#1c2535;font:700 12px/1.35 ui-monospace,SFMono-Regular,Menlo,monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}body.vano-admin-surface .server-note{margin-top:12px;padding:12px 14px;border-radius:16px;background:#f7f9fc;border:1px dashed #d7dfeb;color:#687688;font-size:13px;line-height:1.5}body.vano-admin-surface .infra-note{display:flex;align-items:flex-start;gap:8px;margin-top:14px;padding:13px 15px;border-radius:18px;background:#f8fbff;border:1px solid #e1e8f3;color:#69778b;font-size:13px;line-height:1.55}body.vano-admin-surface .infra-note code{color:#D9703F;background:#edf0ff;padding:2px 6px;border-radius:8px}

body.vano-admin-surface .lower-grid{align-items:start}body.vano-admin-surface .list-card{padding:20px}body.vano-admin-surface .list-wrap{display:grid;gap:8px}body.vano-admin-surface .list-row{display:grid;grid-template-columns:minmax(180px,2fr) repeat(4,minmax(88px,.6fr));gap:12px;align-items:center;padding:14px 12px;border-radius:18px;background:#fbfdff;border:1px solid #e4ebf5}body.vano-admin-surface .row-main{min-width:0}body.vano-admin-surface .row-main b{display:block;font-size:15px;color:#111827;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}body.vano-admin-surface .row-main span{display:block;margin-top:5px;color:#748094;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}body.vano-admin-surface .row-data small{display:block;color:#748094;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}body.vano-admin-surface .row-data b{display:block;margin-top:4px;color:#111827;font-size:14px}body.vano-admin-surface .empty-state{padding:34px;text-align:center;color:#7a8799;font-size:14px}

