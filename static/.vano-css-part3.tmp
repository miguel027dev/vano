/* VANO — distributed node configuration */
body.vano-admin-surface .distributed-readiness{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}body.vano-admin-surface .ready-pill{display:inline-flex;align-items:center;gap:6px;padding:8px 10px;border-radius:999px;background:#f6f8fc;border:1px solid #dfe6f1;color:#637084;font-size:12px;font-weight:800}body.vano-admin-surface .ready-pill.ok{background:#ecfbf3;border-color:#ccefdc;color:#13845a}body.vano-admin-surface .ready-pill.warn{background:#fff8e8;border-color:#f0dfb5;color:#9a6817}body.vano-admin-surface .ready-pill.danger{background:#fff0f2;border-color:#f4ccd3;color:#bd4053}body.vano-admin-surface .server-card-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}body.vano-admin-surface .node-action{min-height:40px;border:1px solid #dce4ef;border-radius:13px;background:#fff;color:#293548;font-weight:800;font-size:12px;display:flex;align-items:center;justify-content:center;gap:7px;transition:.18s ease}body.vano-admin-surface .node-action:hover:not(:disabled){border-color:#c8d3e2;background:#f7f9fd;transform:translateY(-1px)}body.vano-admin-surface .node-action:disabled{opacity:.45;cursor:not-allowed}body.vano-admin-surface .node-config-modal[hidden]{display:none}body.vano-admin-surface .node-config-modal{position:fixed;inset:0;z-index:4000;display:grid;place-items:center;padding:18px}body.vano-admin-surface .node-config-backdrop{position:absolute;inset:0;background:rgba(20,28,43,.38);backdrop-filter:blur(5px)}body.vano-admin-surface .node-config-dialog{position:relative;width:min(620px,100%);max-height:min(760px,calc(100% - 18px));overflow:auto;background:#fff;border:1px solid #dbe3ef;border-radius:26px;box-shadow:0 30px 90px rgba(30,45,70,.24);padding:22px}body.vano-admin-surface .node-config-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}body.vano-admin-surface .node-config-head h2{margin:7px 0 4px;color:#111827;font-size:25px;letter-spacing:-.8px}body.vano-admin-surface .node-config-head p{margin:0;color:#748095;font-size:13px}body.vano-admin-surface .node-modal-close{width:40px;height:40px;border:1px solid #dfe6f0;border-radius:13px;background:#f8faff;color:#4e5a6d;font-size:24px;line-height:1}body.vano-admin-surface .node-config-form{margin-top:18px}body.vano-admin-surface .node-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}body.vano-admin-surface .node-form-grid label{display:flex;flex-direction:column;gap:7px;min-width:0}body.vano-admin-surface .node-form-grid label.full{grid-column:1/-1}body.vano-admin-surface .node-form-grid label>span{color:#59677a;font-size:12px;font-weight:800}body.vano-admin-surface .node-form-grid input{width:100%;min-height:45px;border:1px solid #d7e0ec;border-radius:13px;background:#fbfdff;color:#121a29;padding:11px 12px;outline:none;font-size:14px}body.vano-admin-surface .node-form-grid input:focus{border-color:#F59A62;box-shadow:0 0 0 3px rgba(217,112,63,.10)}body.vano-admin-surface .node-form-grid small{color:#8590a1;font-size:11px}body.vano-admin-surface .node-toggle{display:flex;align-items:center;gap:10px;margin-top:14px;padding:13px;border-radius:15px;background:#f7f9fd;border:1px solid #e1e8f2;color:#465367;font-size:13px;font-weight:750}body.vano-admin-surface .node-toggle input{width:18px;height:18px;accent-color:#D9703F}body.vano-admin-surface .node-config-message{min-height:22px;margin-top:12px;color:#627086;font-size:13px}body.vano-admin-surface .node-config-message.error{color:#c33e53}body.vano-admin-surface .node-config-message.ok{color:#15845c}body.vano-admin-surface .node-config-footer{display:flex;justify-content:flex-end;gap:10px;margin-top:12px;padding-top:14px;border-top:1px solid #e8edf4}body.vano-admin-surface .server-meta-list{grid-template-columns:1fr 1fr}body.vano-admin-surface .server-card[data-status="online"]{border-color:#d5e9df}body.vano-admin-surface .server-card[data-status="offline"]{border-color:#f1d6dc}body.vano-admin-surface .server-card[data-status="pending"]{border-color:#efe3c6}
@media(max-width:560px){body.vano-admin-surface .distributed-readiness{gap:6px}body.vano-admin-surface .ready-pill{font-size:10px;padding:7px 9px}body.vano-admin-surface .server-card-actions{grid-template-columns:1fr}body.vano-admin-surface .node-config-modal{padding:7px}body.vano-admin-surface .node-config-dialog{border-radius:20px;padding:16px;max-height:calc(100% - 10px)}body.vano-admin-surface .node-form-grid{grid-template-columns:1fr}body.vano-admin-surface .node-form-grid label.full{grid-column:auto}body.vano-admin-surface .node-config-footer{display:grid;grid-template-columns:1fr 1fr}body.vano-admin-surface .node-config-footer .btn{width:100%;min-width:0;padding:10px 8px}}

body.vano-admin-surface .status-degraded{background:#fff6df!important;color:#a86a00!important;border-color:#f0d89a!important}

/* VANO — operations-first white admin polish */
body.vano-admin-surface .admin86{background:linear-gradient(180deg,#f8faff 0,#f4f7fb 52%,#f7f9fc 100%)}
body.vano-admin-surface .admin86-wrap{max-width:1420px}body.vano-admin-surface .admin86-head{padding:8px 2px 2px}body.vano-admin-surface .admin86-head h1{font-weight:900;letter-spacing:-2.3px}body.vano-admin-surface .admin86-head p{max-width:820px}
body.vano-admin-surface .admin86-card{box-shadow:0 18px 48px rgba(55,72,105,.065),inset 0 1px 0 #fff}body.vano-admin-surface .admin86-hero{border-color:#dbe3f0;background:linear-gradient(128deg,#fff 0%,#fbfcff 58%,#FFFBF2 100%)}
body.vano-admin-surface .hero-mainline h2{font-size:clamp(54px,7vw,84px)}body.vano-admin-surface .kpi-card{min-height:132px;display:flex;flex-direction:column;justify-content:center}body.vano-admin-surface .kpi-card b{font-size:38px}
body.vano-admin-surface .node-ops-toolbar{display:grid;grid-template-columns:auto minmax(240px,1fr) auto;align-items:center;gap:12px;margin:2px 0 16px;padding:10px;border:1px solid #e0e7f1;border-radius:18px;background:linear-gradient(180deg,#fbfdff,#f6f9fd)}
body.vano-admin-surface .node-filter-group{display:flex;gap:6px;flex-wrap:wrap}body.vano-admin-surface .node-filter{min-height:38px;padding:0 12px;border:1px solid transparent;border-radius:12px;background:transparent;color:#69758a;font-size:12px;font-weight:800;cursor:pointer;transition:.18s ease}body.vano-admin-surface .node-filter b{display:inline-grid;place-items:center;min-width:22px;height:22px;margin-left:5px;padding:0 6px;border-radius:999px;background:#edf1f7;color:#657186;font-size:10px}body.vano-admin-surface .node-filter:hover{background:#fff;border-color:#dde5f0}body.vano-admin-surface .node-filter.active{background:#fff;color:#D9703F;border-color:#E8DED6;box-shadow:0 8px 20px rgba(217,112,63,.08)}body.vano-admin-surface .node-filter.active b{background:#FFFBF2;color:#D9703F}
body.vano-admin-surface .node-search{min-width:0;height:40px;display:flex;align-items:center;gap:8px;padding:0 12px;border:1px solid #dde5f0;border-radius:13px;background:#fff;color:#7b879a}body.vano-admin-surface .node-search input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:#1c2534;font-size:13px}body.vano-admin-surface .node-search input::placeholder{color:#9aa5b5}body.vano-admin-surface .node-auto-refresh{display:flex;align-items:center;gap:7px;height:38px;padding:0 11px;border-radius:12px;background:#edf9f4;color:#2d7f5e;font-size:11px;font-weight:800;white-space:nowrap}
body.vano-admin-surface .server-card{position:relative;overflow:hidden;background:linear-gradient(180deg,#fff,#fbfdff)}body.vano-admin-surface .server-card:before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:#d9e1ec}body.vano-admin-surface .server-card[data-status="online"]:before{background:#35c98a}body.vano-admin-surface .server-card[data-status="degraded"]:before,
body.vano-admin-surface .server-card[data-status="pending"]:before{background:#f3b44d}body.vano-admin-surface .server-card[data-status="offline"]:before{background:#ef6673}body.vano-admin-surface .server-card.is-filtered-out{display:none!important}body.vano-admin-surface .server-head h3{font-size:19px}body.vano-admin-surface .server-visual-wrap{background:linear-gradient(145deg,#f7f9ff,#f2f6fc)}body.vano-admin-surface .server-metrics>div{background:#fbfcfe}body.vano-admin-surface .server-meta-list>div{background:#fbfcfe}body.vano-admin-surface .server-card-actions{position:relative;z-index:1}
@media(max-width:900px){body.vano-admin-surface .node-ops-toolbar{grid-template-columns:1fr}body.vano-admin-surface .node-auto-refresh{justify-content:center}body.vano-admin-surface .node-search{order:2}body.vano-admin-surface .node-filter-group{order:1}body.vano-admin-surface .node-auto-refresh{order:3}}
@media(max-width:560px){body.vano-admin-surface .node-filter-group{display:grid;grid-template-columns:1fr 1fr}body.vano-admin-surface .node-filter{width:100%}body.vano-admin-surface .node-ops-toolbar{padding:8px}body.vano-admin-surface .kpi-card{min-height:112px}body.vano-admin-surface .kpi-card b{font-size:31px}}

/* VANO — server management center */
body.vano-admin-surface .status-draining{background:#eaf2ff!important;color:#3567a8!important;border-color:#cddcf3!important}body.vano-admin-surface .server-card[data-status="draining"]{border-color:#cfddf2}body.vano-admin-surface .server-card[data-status="draining"]:before{background:#5b8fd8}body.vano-admin-surface .server-card-actions{grid-template-columns:1.1fr 1fr 1fr}body.vano-admin-surface .manage-node{text-decoration:none;background:linear-gradient(135deg,#FFFBF2,#f8fbff);border-color:#E8DED6;color:#D9703F}body.vano-admin-surface .dispatch-ops-panel{padding:20px;margin-bottom:16px}body.vano-admin-surface .dispatch-ops-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}body.vano-admin-surface .dispatch-ops-grid>div{padding:16px;border-radius:18px;background:linear-gradient(180deg,#fbfdff,#f6f9fe);border:1px solid #e0e8f4}body.vano-admin-surface .dispatch-ops-grid small{display:block;color:#748196;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.055em}body.vano-admin-surface .dispatch-ops-grid b{display:block;margin-top:7px;font-size:25px;letter-spacing:-1px;color:#121a29}body.vano-admin-surface .admin-ops-feed{margin-bottom:0}body.vano-admin-surface .ops-feed-row{display:grid;grid-template-columns:10px minmax(0,1fr);gap:11px;align-items:flex-start;padding:12px 10px;border-radius:15px;background:#fbfdff;border:1px solid #e5ebf4}body.vano-admin-surface .ops-feed-row+.ops-feed-row{margin-top:7px}body.vano-admin-surface .ops-dot{width:9px;height:9px;margin-top:4px;border-radius:999px;background:#D9703F;box-shadow:0 0 0 4px rgba(217,112,63,.10)}body.vano-admin-surface .ops-dot.fail{background:#eb6274;box-shadow:0 0 0 4px rgba(235,98,116,.10)}body.vano-admin-surface .ops-feed-row b{display:block;color:#172033;font-size:13px;line-height:1.35}body.vano-admin-surface .ops-feed-row small{display:block;margin-top:4px;color:#788499;font-size:11px;line-height:1.4}body.vano-admin-surface .node-form-grid select,
body.vano-admin-surface .node-form-grid textarea{width:100%;border:1px solid #d7e0ec;border-radius:13px;background:#fbfdff;color:#121a29;padding:11px 12px;outline:none;font-size:14px}body.vano-admin-surface .node-form-grid select{min-height:45px}body.vano-admin-surface .node-form-grid textarea{resize:vertical;min-height:88px;line-height:1.45}body.vano-admin-surface .node-form-grid select:focus,
body.vano-admin-surface .node-form-grid textarea:focus{border-color:#F59A62;box-shadow:0 0 0 3px rgba(217,112,63,.10)}body.vano-admin-surface .node-toggle.warning{background:#fff9ee;border-color:#efdfbc;color:#7a5c22}

/* Dedicated server detail */
body.vano-admin-surface .admin-server-page{padding:28px 0 90px;background:linear-gradient(180deg,#f8faff,#f4f7fb 50%,#f8fafc)}body.vano-admin-surface .admin-server-wrap{width:min(1420px,calc(100% - 28px));margin:auto}body.vano-admin-surface .server-detail-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:16px}body.vano-admin-surface .server-detail-back{display:inline-flex;align-items:center;gap:7px;color:#687588;font-size:13px;font-weight:800}body.vano-admin-surface .server-detail-head h1{margin:10px 0 6px;font-size:clamp(34px,4vw,50px);letter-spacing:-2px;color:#101827}body.vano-admin-surface .server-detail-head p{margin:0;color:#748095;font-size:14px}body.vano-admin-surface .server-detail-actions{display:flex;gap:9px;flex-wrap:wrap}body.vano-admin-surface .server-detail-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:16px}body.vano-admin-surface .server-live-card,
body.vano-admin-surface .server-config-card,
body.vano-admin-surface .server-log-card,
body.vano-admin-surface .server-users-card{padding:20px}body.vano-admin-surface .server-live-hero{display:grid;grid-template-columns:180px 1fr;gap:20px;align-items:center}body.vano-admin-surface .server-live-rack{height:220px}body.vano-admin-surface .server-live-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}body.vano-admin-surface .server-live-summary>div{padding:14px;border-radius:17px;background:#f8fbff;border:1px solid #e2eaf4}body.vano-admin-surface .server-live-summary small{display:block;color:#718095;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.055em}body.vano-admin-surface .server-live-summary b{display:block;margin-top:5px;font-size:24px;color:#111827;letter-spacing:-.8px}body.vano-admin-surface .server-health-note{margin-top:12px;padding:12px 14px;border-radius:16px;background:#f7f9fd;border:1px solid #e0e8f3;color:#617086;font-size:13px;line-height:1.45}body.vano-admin-surface .server-detail-kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:16px}body.vano-admin-surface .server-detail-kpis>div{padding:15px;border-radius:19px;background:#fff;border:1px solid #dee6f1;box-shadow:0 10px 24px rgba(61,78,106,.04)}body.vano-admin-surface .server-detail-kpis small{display:block;color:#758196;font-size:11px;font-weight:800}body.vano-admin-surface .server-detail-kpis b{display:block;margin-top:6px;color:#101827;font-size:24px;letter-spacing:-.8px}body.vano-admin-surface .server-config-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}body.vano-admin-surface .server-config-grid label{display:flex;flex-direction:column;gap:7px}body.vano-admin-surface .server-config-grid label.full{grid-column:1/-1}body.vano-admin-surface .server-config-grid span{color:#5e6b7d;font-size:12px;font-weight:800}body.vano-admin-surface .server-config-grid input,
body.vano-admin-surface .server-config-grid select,
body.vano-admin-surface .server-config-grid textarea{width:100%;min-height:44px;border:1px solid #d8e1ed;border-radius:13px;background:#fbfdff;color:#121a29;padding:10px 12px;outline:0;font-size:13px}body.vano-admin-surface .server-config-grid textarea{min-height:92px;resize:vertical}body.vano-admin-surface .server-config-grid input:focus,
body.vano-admin-surface .server-config-grid select:focus,
body.vano-admin-surface .server-config-grid textarea:focus{border-color:#F59A62;box-shadow:0 0 0 3px rgba(217,112,63,.09)}body.vano-admin-surface .server-config-flags{display:grid;gap:8px;margin-top:12px}body.vano-admin-surface .server-config-flags label{display:flex;align-items:center;gap:9px;padding:11px 12px;border-radius:14px;background:#f8faff;border:1px solid #e2e9f4;color:#4f5c70;font-size:12px;font-weight:750}body.vano-admin-surface .server-config-flags input{width:18px;height:18px;accent-color:#D9703F}body.vano-admin-surface .server-config-buttons{display:flex;justify-content:flex-end;gap:9px;margin-top:13px}body.vano-admin-surface .server-log-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:12px}body.vano-admin-surface .server-log-filters{display:flex;gap:6px;flex-wrap:wrap}body.vano-admin-surface .log-filter{height:36px;padding:0 11px;border:1px solid #dde5ef;border-radius:11px;background:#fff;color:#68758a;font-size:11px;font-weight:800}body.vano-admin-surface .log-filter.active{background:#FFFBF2;border-color:#E8DED6;color:#D9703F}body.vano-admin-surface .server-log-table-wrap{overflow:auto;border:1px solid #e3e9f2;border-radius:17px}body.vano-admin-surface .server-log-table{width:100%;border-collapse:collapse;min-width:860px;background:#fff}body.vano-admin-surface .server-log-table th{padding:11px 12px;background:#f7f9fc;color:#788499;font-size:10px;text-transform:uppercase;letter-spacing:.06em;text-align:left;position:sticky;top:0}body.vano-admin-surface .server-log-table td{padding:12px;border-top:1px solid #edf1f6;color:#263246;font-size:12px;vertical-align:middle}body.vano-admin-surface .server-log-table .log-user b{display:block;color:#141d2c}body.vano-admin-surface .server-log-table .log-user small{display:block;margin-top:2px;color:#8390a2}body.vano-admin-surface .log-result{display:inline-flex;align-items:center;padding:6px 8px;border-radius:999px;font-size:10px;font-weight:900}body.vano-admin-surface .log-result.ok{background:#eaf9f1;color:#18835d}body.vano-admin-surface .log-result.fail{background:#fff0f2;color:#bd4255}body.vano-admin-surface .log-prefetch{color:#D9703F;font-weight:800}body.vano-admin-surface .log-request{max-width:170px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;color:#647187;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}body.vano-admin-surface .server-management-note{padding:13px 15px;border-radius:16px;background:#FFFBF2;border:1px solid #E8DED6;color:#D9703F;font-size:12px;line-height:1.5}body.vano-admin-surface .audit-page{padding:28px 0 90px;background:#f7f9fc}body.vano-admin-surface .audit-table-wrap{overflow:auto;border:1px solid #e1e8f2;border-radius:18px;background:#fff}body.vano-admin-surface .audit-table{width:100%;min-width:820px;border-collapse:collapse}body.vano-admin-surface .audit-table th{padding:12px;background:#f7f9fd;color:#788499;font-size:10px;text-transform:uppercase;letter-spacing:.06em;text-align:left}body.vano-admin-surface .audit-table td{padding:12px;border-top:1px solid #edf1f6;font-size:12px;color:#273348;vertical-align:top}body.vano-admin-surface .audit-meta{max-width:520px;white-space:pre-wrap;overflow-wrap:anywhere;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;color:#68758a}
@media(max-width:1120px){body.vano-admin-surface .dispatch-ops-grid,
body.vano-admin-surface .server-detail-kpis{grid-template-columns:repeat(3,1fr)}body.vano-admin-surface .server-detail-grid{grid-template-columns:1fr}body.vano-admin-surface .server-live-summary{grid-template-columns:repeat(3,1fr)}}
@media(max-width:720px){body.vano-admin-surface .dispatch-ops-grid{grid-template-columns:repeat(2,1fr)}body.vano-admin-surface .server-card-actions{grid-template-columns:1fr}body.vano-admin-surface .admin-server-wrap{width:calc(100% - 14px)}body.vano-admin-surface .server-detail-head{flex-direction:column}body.vano-admin-surface .server-detail-actions{width:100%}body.vano-admin-surface .server-detail-actions .btn{flex:1}body.vano-admin-surface .server-detail-kpis{grid-template-columns:repeat(2,1fr)}body.vano-admin-surface .server-live-hero{grid-template-columns:1fr}body.vano-admin-surface .server-live-rack{height:170px}body.vano-admin-surface .server-live-summary{grid-template-columns:repeat(2,1fr)}body.vano-admin-surface .server-config-grid{grid-template-columns:1fr}body.vano-admin-surface .server-config-grid label.full{grid-column:auto}body.vano-admin-surface .server-config-buttons{display:grid;grid-template-columns:1fr}body.vano-admin-surface .server-config-buttons .btn{width:100%}}
@media(max-width:390px){body.vano-admin-surface .dispatch-ops-grid,
body.vano-admin-surface .server-detail-kpis,
body.vano-admin-surface .server-live-summary{grid-template-columns:1fr}body.vano-admin-surface .server-detail-actions{display:grid;grid-template-columns:1fr}body.vano-admin-surface .admin86-actions{display:grid;grid-template-columns:1fr 1fr}}


/* VANO — clearer distributed infrastructure view */
body.vano-admin-surface .infra-topology-panel{padding:20px;margin-bottom:16px}body.vano-admin-surface .infra-topology{display:grid;grid-template-columns:220px 44px minmax(0,1fr);gap:12px;align-items:stretch}body.vano-admin-surface .topology-central{display:flex;flex-direction:column;justify-content:center;padding:18px;border-radius:20px;background:linear-gradient(145deg,#FFFBF2,#fbfdff);border:1px solid #E8DED6}body.vano-admin-surface .topology-central-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:14px;background:#D9703F;color:#fff;box-shadow:0 10px 24px rgba(217,112,63,.22)}body.vano-admin-surface .topology-central small{margin-top:12px;color:#D9703F;font-size:10px;font-weight:900;letter-spacing:.07em;text-transform:uppercase}body.vano-admin-surface .topology-central b{margin-top:4px;color:#171b2c;font-size:19px}body.vano-admin-surface .topology-central span{margin-top:4px;color:#768195;font-size:11px}body.vano-admin-surface .topology-link{position:relative;display:grid;place-items:center}body.vano-admin-surface .topology-link:before{content:"";position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,#F59A62,#dbe4f0)}body.vano-admin-surface .topology-link i{position:relative;width:10px;height:10px;border-radius:50%;background:#D9703F;box-shadow:0 0 0 5px #FFFBF2}body.vano-admin-surface .topology-nodes{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}body.vano-admin-surface .topology-node{min-width:0;padding:10px 11px;border-radius:15px;background:#fbfdff;border:1px solid #e1e8f3;display:grid;gap:4px;position:relative;overflow:hidden}body.vano-admin-surface .topology-node:before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:#d7dee9}body.vano-admin-surface .topology-node.online:before{background:#35c98a}body.vano-admin-surface .topology-node.degraded:before,
body.vano-admin-surface .topology-node.pending:before,
body.vano-admin-surface .topology-node.draining:before{background:#f3b44d}body.vano-admin-surface .topology-node.offline:before,
body.vano-admin-surface .topology-node.disabled:before{background:#ef6673}body.vano-admin-surface .topology-node-head{display:flex;align-items:center;justify-content:space-between;gap:6px}body.vano-admin-surface .topology-node strong{font-size:11px;color:#182133;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}body.vano-admin-surface .topology-node em{width:7px;height:7px;border-radius:50%;background:#a7b0bf}body.vano-admin-surface .topology-node.online em{background:#27bb7d}body.vano-admin-surface .topology-node.degraded em,
body.vano-admin-surface .topology-node.pending em,
body.vano-admin-surface .topology-node.draining em{background:#e7a834}body.vano-admin-surface .topology-node.offline em,
body.vano-admin-surface .topology-node.disabled em{background:#e85e70}body.vano-admin-surface .topology-node span{font-size:10px;color:#738095;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}body.vano-admin-surface .topology-node small{font-size:9px;color:#929bad}body.vano-admin-surface .node-sort{height:40px;min-width:160px;border:1px solid #dde5f0;border-radius:13px;background:#fff;color:#526075;padding:0 10px;font-size:12px;font-weight:750;outline:0}body.vano-admin-surface .node-sort:focus{border-color:#F59A62;box-shadow:0 0 0 3px rgba(217,112,63,.08)}
@media(max-width:1100px){body.vano-admin-surface .infra-topology{grid-template-columns:180px 30px minmax(0,1fr)}body.vano-admin-surface .topology-nodes{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:760px){body.vano-admin-surface .infra-topology{grid-template-columns:1fr}body.vano-admin-surface .topology-link{height:20px}body.vano-admin-surface .topology-link:before{left:50%;right:auto;top:0;bottom:0;width:2px;height:auto}body.vano-admin-surface .topology-nodes{grid-template-columns:repeat(2,minmax(0,1fr))}body.vano-admin-surface .node-sort{width:100%;min-width:0;order:3}body.vano-admin-surface .node-auto-refresh{order:4}}
@media(max-width:390px){body.vano-admin-surface .topology-nodes{grid-template-columns:1fr}}

/* V93 toolbar: four controls on desktop, single-column on narrow screens. */
body.vano-admin-surface .node-ops-toolbar{grid-template-columns:auto minmax(220px,1fr) 170px auto}
@media(max-width:900px){body.vano-admin-surface .node-ops-toolbar{grid-template-columns:1fr}body.vano-admin-surface .node-filter-group{order:1}body.vano-admin-surface .node-search{order:2}body.vano-admin-surface .node-sort{order:3;width:100%;min-width:0}body.vano-admin-surface .node-auto-refresh{order:4;justify-content:center}}

/* VANO — admin activity/audit readability */
body.vano-admin-surface .audit123 .server-detail-head{margin-bottom:16px}body.vano-admin-surface .activity-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-bottom:12px}body.vano-admin-surface .activity-kpi{padding:14px 15px;border:1px solid rgba(255,255,255,.07);border-radius:15px;background:rgba(255,255,255,.025);display:grid;gap:3px}body.vano-admin-surface .activity-kpi small,
body.vano-admin-surface .activity-card-head>div>small{font-size:8px;letter-spacing:.1em;font-weight:900;color:#7e8792}body.vano-admin-surface .activity-kpi b{font-size:24px;letter-spacing:-.7px}body.vano-admin-surface .activity-kpi span{font-size:9px;color:#7e8792}body.vano-admin-surface .activity-card{margin-bottom:12px}body.vano-admin-surface .activity-card-head{padding:15px 16px;display:flex;justify-content:space-between;align-items:end;gap:14px;border-bottom:1px solid rgba(255,255,255,.06)}body.vano-admin-surface .activity-card-head h2{margin:2px 0 3px;font-size:16px}body.vano-admin-surface .activity-card-head p{margin:0;font-size:10px;color:#818a96}body.vano-admin-surface .activity-search{width:min(340px,42vw);height:40px;display:flex;align-items:center;gap:7px;padding:0 11px;border:1px solid rgba(255,255,255,.08);border-radius:11px;background:#0c0e11;color:#8a939e}body.vano-admin-surface .activity-search input{width:100%;border:0;outline:0;background:transparent;color:#f1f3f5;font:inherit;font-size:10px}body.vano-admin-surface .activity-table td{vertical-align:top}body.vano-admin-surface .activity-table td>b,
body.vano-admin-surface .activity-table td>small{display:block}body.vano-admin-surface .activity-table td>small{margin-top:3px;color:#7f8792;font-size:8px}body.vano-admin-surface .activity-detail{max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}body.vano-admin-surface .activity-path{max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}body.vano-admin-surface .ip-chip{display:inline-flex;margin-top:5px;padding:3px 6px;border:1px solid rgba(217,112,63,.15);border-radius:7px;background:rgba(217,112,63,.07);color:#FFC39B;font-size:8px}body.vano-admin-surface .event-chip,
body.vano-admin-surface .status-chip{display:inline-flex;align-items:center;justify-content:center;padding:4px 7px;border-radius:999px;border:1px solid rgba(255,255,255,.08);font-size:8px;font-weight:850;text-transform:uppercase;letter-spacing:.03em}body.vano-admin-surface .event-click{color:#E8DED6;border-color:rgba(217,112,63,.18);background:rgba(217,112,63,.08)}body.vano-admin-surface .event-request{color:#b8c0c9}body.vano-admin-surface .event-navigation{color:#9fd6ff}body.vano-admin-surface .status-chip.is-ok{color:#9ae6bd;border-color:rgba(42,184,108,.18);background:rgba(42,184,108,.06)}body.vano-admin-surface .status-chip.is-error{color:#ffb2b2;border-color:rgba(255,91,91,.2);background:rgba(255,91,91,.07)}body.vano-admin-surface .activity-empty-filter{padding:24px;text-align:center;color:#7e8792;font-size:10px}body.vano-admin-surface .sensitive-audit-card{margin-top:12px}
@media(max-width:900px){body.vano-admin-surface .activity-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}body.vano-admin-surface .activity-card-head{align-items:stretch;flex-direction:column}body.vano-admin-surface .activity-search{width:100%}body.vano-admin-surface .activity-table{min-width:820px}}
@media(max-width:560px){body.vano-admin-surface .audit123 .admin-server-wrap{padding-left:10px;padding-right:10px}body.vano-admin-surface .activity-kpis{gap:7px}body.vano-admin-surface .activity-kpi{padding:12px}body.vano-admin-surface .activity-kpi b{font-size:20px}body.vano-admin-surface .activity-card-head{padding:13px}body.vano-admin-surface .audit-table-wrap{-webkit-overflow-scrolling:touch;scrollbar-width:thin}}

/* V123 topology polish: same structure, faster visual scan for the operator. */
body.vano-admin-surface .infra-topology-panel{overflow:hidden}body.vano-admin-surface .topology-central{box-shadow:0 12px 30px rgba(217,112,63,.08)}body.vano-admin-surface .topology-node{transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease}body.vano-admin-surface .topology-node:hover{transform:translateY(-1px);border-color:#cfd8e7;box-shadow:0 8px 20px rgba(28,38,55,.06)}body.vano-admin-surface .topology-node.online{background:linear-gradient(180deg,#fbfffd,#fbfdff)}body.vano-admin-surface .topology-node.offline,
body.vano-admin-surface .topology-node.disabled{background:linear-gradient(180deg,#fffafa,#fbfdff)}body.vano-admin-surface .topology-node.degraded,
body.vano-admin-surface .topology-node.pending,
body.vano-admin-surface .topology-node.draining{background:linear-gradient(180deg,#fffdf7,#fbfdff)}
@media(max-width:760px){body.vano-admin-surface .infra-topology-panel{padding:15px}body.vano-admin-surface .topology-central{padding:15px}body.vano-admin-surface .topology-nodes{gap:7px}body.vano-admin-surface .topology-node{min-height:68px}}


/* ---- vano-admin-finance.css ---- */
body.vano-admin-surface .finance93{min-height:100vh;background:#f4f6fa;color:#121723;padding:28px 18px 64px}body.vano-admin-surface .finance-shell{max-width:1440px;margin:auto}body.vano-admin-surface .finance-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;margin-bottom:22px}body.vano-admin-surface .finance-back{display:inline-flex;align-items:center;gap:7px;color:#667085;text-decoration:none;font-size:13px;font-weight:700;margin-bottom:15px}body.vano-admin-surface .finance-eyebrow,
body.vano-admin-surface .modal-tag{font-size:10px;font-weight:900;letter-spacing:.16em;color:#F59A62}body.vano-admin-surface .finance-head h1{font-size:38px;line-height:1;margin:7px 0 10px;letter-spacing:-.04em}body.vano-admin-surface .finance-head p{margin:0;color:#7b8493;max-width:700px}body.vano-admin-surface .finance-actions{display:flex;gap:9px;flex-wrap:wrap}body.vano-admin-surface .finance-btn,
body.vano-admin-surface .finance-link-btn{border:1px solid #dfe3eb;background:white;color:#202735;border-radius:12px;padding:11px 14px;font:700 13px inherit;display:inline-flex;align-items:center;gap:8px;text-decoration:none;cursor:pointer;box-shadow:0 2px 10px #19213a0a}body.vano-admin-surface .finance-btn.primary{background:#F59A62;color:white;border-color:#F59A62;box-shadow:0 10px 24px #F59A622e}body.vano-admin-surface .finance-kpis{display:grid;grid-template-columns:1.4fr repeat(4,1fr);gap:12px;margin-bottom:12px}body.vano-admin-surface .finance-kpi{background:#fff;border:1px solid #e5e8ee;border-radius:18px;padding:18px;min-height:118px;display:flex;flex-direction:column;justify-content:center;box-shadow:0 10px 34px #10182808}body.vano-admin-surface .finance-kpi.hero{background:linear-gradient(145deg,#151b2a,#252d43);color:#fff;border:0}body.vano-admin-surface .finance-kpi span{font-size:11px;font-weight:800;color:#7b8493;text-transform:uppercase;letter-spacing:.08em}body.vano-admin-surface .finance-kpi.hero span,
body.vano-admin-surface .finance-kpi.hero small{color:#b8c0d0}body.vano-admin-surface .finance-kpi b{font-size:24px;letter-spacing:-.03em;margin:7px 0 5px}body.vano-admin-surface .finance-kpi small{font-size:11px;color:#98a0ac}body.vano-admin-surface .finance-kpi.income b,
body.vano-admin-surface .money.income{color:#0c9b68}body.vano-admin-surface .finance-kpi.expense b,
body.vano-admin-surface .money.expense{color:#dc4c5a}body.vano-admin-surface .finance-grid{display:grid;gap:12px}body.vano-admin-surface .accounts-grid{grid-template-columns:1.15fr .85fr;margin-bottom:12px}body.vano-admin-surface .bottom-grid{grid-template-columns:1fr 1fr;margin-top:12px}body.vano-admin-surface .finance-card{background:#fff;border:1px solid #e5e8ee;border-radius:18px;padding:18px;box-shadow:0 10px 34px #10182808}body.vano-admin-surface .finance-section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:16px}body.vano-admin-surface .finance-section-head span{font-size:9px;font-weight:900;letter-spacing:.14em;color:#F59A62}body.vano-admin-surface .finance-section-head h2{font-size:18px;margin:4px 0 0;letter-spacing:-.02em}body.vano-admin-surface .finance-section-head p{font-size:11px;color:#8b93a0;margin:5px 0 0}body.vano-admin-surface .finance-section-head em{font-size:11px;color:#8b93a0;font-style:normal}body.vano-admin-surface .finance-link-btn{padding:8px 10px;font-size:11px}body.vano-admin-surface .account-list,
body.vano-admin-surface .commitment-list,
body.vano-admin-surface .audit-list,
body.vano-admin-surface .category-list{display:flex;flex-direction:column;gap:9px}body.vano-admin-surface .account-row{display:grid;grid-template-columns:38px 1fr auto;gap:11px;align-items:center;padding:12px;border:1px solid #edf0f4;border-radius:14px;background:#fbfcfd}body.vano-admin-surface .account-row.muted{opacity:.55}body.vano-admin-surface .account-icon{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:#eef0ff;color:#F59A62}body.vano-admin-surface .account-main{display:flex;flex-direction:column}body.vano-admin-surface .account-main b{font-size:13px}body.vano-admin-surface .account-main span,
body.vano-admin-surface .account-balance small{font-size:10px;color:#8d95a2}body.vano-admin-surface .account-balance{text-align:right}body.vano-admin-surface .account-balance b{display:block;font-size:15px;margin-top:2px}body.vano-admin-surface .category-row{padding:5px 0}body.vano-admin-surface .category-top{display:flex;justify-content:space-between;font-size:11px;margin-bottom:7px}body.vano-admin-surface .category-top span{color:#6f7784}body.vano-admin-surface .category-track{height:6px;border-radius:99px;background:#eff1f5;overflow:hidden}body.vano-admin-surface .category-track i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,#F59A62,#F59A62)}body.vano-admin-surface .ledger-card{padding:0;overflow:hidden}body.vano-admin-surface .ledger-head{padding:18px 18px 6px}body.vano-admin-surface .ledger-filters{display:flex;gap:5px;flex-wrap:wrap}body.vano-admin-surface .ledger-filters button{border:1px solid #e2e6ed;background:#fff;border-radius:9px;padding:7px 9px;font-size:10px;font-weight:800;color:#667085;cursor:pointer}body.vano-admin-surface .ledger-filters button.active{background:#171d2b;color:#fff;border-color:#171d2b}body.vano-admin-surface .finance-table-wrap{overflow:auto}body.vano-admin-surface .finance-table{width:100%;border-collapse:collapse;min-width:940px}body.vano-admin-surface .finance-table th{font-size:9px;letter-spacing:.09em;color:#8b93a0;text-align:left;background:#fafbfc;border-top:1px solid #edf0f4;border-bottom:1px solid #edf0f4;padding:10px 14px}body.vano-admin-surface .finance-table td{padding:12px 14px;border-bottom:1px solid #f0f2f5;font-size:11px;vertical-align:middle}body.vano-admin-surface .finance-table td b{display:block;font-size:12px}body.vano-admin-surface .finance-table td small{display:block;color:#8a92a0;margin-top:3px}body.vano-admin-surface .money{font-weight:900;white-space:nowrap}body.vano-admin-surface .finance-status{display:inline-flex;padding:5px 8px;border-radius:99px;font-size:9px;font-weight:900}body.vano-admin-surface .finance-status.posted{background:#e9f8f1;color:#087d56}body.vano-admin-surface .finance-status.pending{background:#fff5db;color:#9b6810}body.vano-admin-surface .finance-status.voided{background:#f0f1f3;color:#777f8b}body.vano-admin-surface .finance-row-actions{display:flex;gap:5px}body.vano-admin-surface .finance-row-actions form{display:inline}body.vano-admin-surface .finance-row-actions button,
body.vano-admin-surface .commit-toggle{border:1px solid #e1e5eb;background:#fff;border-radius:8px;padding:6px 8px;cursor:pointer;color:#687180;font-size:10px}body.vano-admin-surface .commitment-row{display:grid;grid-template-columns:1fr auto auto;gap:10px;align-items:center;padding:11px 12px;border:1px solid #edf0f4;border-radius:13px}body.vano-admin-surface .commitment-row.off{opacity:.48}body.vano-admin-surface .commitment-row div{display:flex;flex-direction:column}body.vano-admin-surface .commitment-row b{font-size:12px}body.vano-admin-surface .commitment-row span{font-size:10px;color:#8b93a0;margin-top:3px}body.vano-admin-surface .commitment-row strong{font-size:12px}body.vano-admin-surface .audit-card{max-height:430px;overflow:hidden}body.vano-admin-surface .audit-list{overflow:auto;max-height:315px;padding-right:3px}body.vano-admin-surface .audit-row{display:grid;grid-template-columns:9px 1fr auto;gap:9px;align-items:center;padding:9px 0;border-bottom:1px solid #f0f2f5}body.vano-admin-surface .audit-dot{width:7px;height:7px;border-radius:50%;background:#F59A62}body.vano-admin-surface .audit-row div{display:flex;flex-direction:column}body.vano-admin-surface .audit-row b{font-size:10px}body.vano-admin-surface .audit-row small{font-size:9px;color:#8c94a1;margin-top:2px}body.vano-admin-surface .audit-row code{font-size:9px;color:#687180;background:#f5f6f8;padding:4px 6px;border-radius:6px}body.vano-admin-surface .finance-empty{padding:20px;text-align:center;color:#9aa1ac;font-size:11px}body.vano-admin-surface .finance-modal[hidden]{display:none}body.vano-admin-surface .finance-modal{position:fixed;inset:0;background:#11182778;backdrop-filter:blur(8px);z-index:3000;display:grid;place-items:center;padding:18px}body.vano-admin-surface .finance-modal-card{position:relative;background:#fff;border-radius:22px;width:min(780px,100%);max-height:90vh;overflow:auto;padding:24px;box-shadow:0 28px 90px #11182745}body.vano-admin-surface .finance-modal-card.small{width:min(500px,100%)}body.vano-admin-surface .finance-modal-card h2{margin:6px 0 18px;font-size:24px;letter-spacing:-.03em}body.vano-admin-surface .modal-close{position:absolute;right:16px;top:16px;width:34px;height:34px;border-radius:10px;border:1px solid #e4e7ec;background:#fff;display:grid;place-items:center;cursor:pointer}body.vano-admin-surface .finance-form{display:flex;flex-direction:column;gap:12px}body.vano-admin-surface .finance-form .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}body.vano-admin-surface .finance-form label{display:flex;flex-direction:column;gap:6px}body.vano-admin-surface .finance-form label.wide{grid-column:1/-1}body.vano-admin-surface .finance-form label span{font-size:10px;font-weight:800;color:#5f6876}body.vano-admin-surface .finance-form input,
body.vano-admin-surface .finance-form select,
body.vano-admin-surface .finance-form textarea{width:100%;border:1px solid #dfe4eb;border-radius:11px;padding:11px 12px;font:12px inherit;background:#fbfcfd;outline:none}body.vano-admin-surface .finance-form input:focus,
body.vano-admin-surface .finance-form select:focus,
body.vano-admin-surface .finance-form textarea:focus{border-color:#F59A62;box-shadow:0 0 0 3px #F59A6212}body.vano-admin-surface .finance-form textarea{min-height:78px;resize:vertical}body.vano-admin-surface .finance-submit{border:0;border-radius:12px;background:#F59A62;color:#fff;padding:12px 15px;font:800 12px inherit;display:inline-flex;justify-content:center;align-items:center;gap:7px;cursor:pointer}body.vano-admin-surface .finance93 .flash{max-width:1440px;margin:0 auto 12px}
@media(max-width:1100px){body.vano-admin-surface .finance-kpis{grid-template-columns:repeat(2,1fr)}body.vano-admin-surface .finance-kpi.hero{grid-column:1/-1}body.vano-admin-surface .accounts-grid,
body.vano-admin-surface .bottom-grid{grid-template-columns:1fr}}
@media(max-width:700px){body.vano-admin-surface .finance93{padding:18px 10px 50px}body.vano-admin-surface .finance-head{align-items:flex-start;flex-direction:column}body.vano-admin-surface .finance-head h1{font-size:31px}body.vano-admin-surface .finance-actions{width:100%}body.vano-admin-surface .finance-btn{flex:1;justify-content:center}body.vano-admin-surface .finance-kpis{grid-template-columns:1fr}body.vano-admin-surface .finance-kpi.hero{grid-column:auto}body.vano-admin-surface .finance-form .form-grid{grid-template-columns:1fr}body.vano-admin-surface .finance-form label.wide{grid-column:auto}body.vano-admin-surface .commitment-row{grid-template-columns:1fr auto}body.vano-admin-surface .commitment-row form{grid-column:1/-1}body.vano-admin-surface .finance-card{padding:14px}body.vano-admin-surface .ledger-card{padding:0}}


/* --------------------------------------------------------------------------
   V231 — Admin Control Center rebuild. Scoped so finance/audit/server pages
   keep their own layouts while /admin gets a cleaner operational surface.
   -------------------------------------------------------------------------- */
html:has(.admin240 body.vano-admin-surface),
body.vano-admin-surface:has(.admin240){background:#f4f6fa!important;color:#172033!important}
body.vano-admin-surface:has(.admin240):before{content:none!important}
body.vano-admin-surface .admin240{min-height:100vh;padding:24px 16px 72px;background:
  radial-gradient(circle at 4% 0%,rgba(245,154,98,.09),transparent 25%),
  radial-gradient(circle at 100% 6%,rgba(72,104,190,.08),transparent 24%),#f4f6fa!important;color:#172033!important}
body.vano-admin-surface .admin240-shell{width:min(1460px,100%);margin:0 auto;display:grid;gap:14px}
body.vano-admin-surface .admin240-topbar{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;padding:6px 2px 5px}
body.vano-admin-surface .admin240-brand{display:flex;align-items:flex-start;gap:13px;min-width:0}body.vano-admin-surface .admin240-logo{width:46px;height:46px;border-radius:15px;display:grid;place-items:center;background:#171d2b;color:#fff;box-shadow:0 10px 25px rgba(17,24,39,.14)}
body.vano-admin-surface .admin240-brand small,
body.vano-admin-surface .admin240-card header small,
body.vano-admin-surface .admin240-section-head small{font-size:9px;font-weight:900;letter-spacing:.15em;color:#d9703f}body.vano-admin-surface .admin240-brand h1{margin:3px 0 4px;font-size:31px;line-height:1;letter-spacing:-.045em;color:#161d2b}body.vano-admin-surface .admin240-brand p{margin:0;color:#7c8797;font-size:12px;line-height:1.45}
body.vano-admin-surface .admin240-top-actions{display:flex;gap:8px;flex-wrap:wrap}body.vano-admin-surface .admin240-ghost,
body.vano-admin-surface .admin240-primary,
body.vano-admin-surface .admin240-link{appearance:none;text-decoration:none;border:1px solid #dfe4ec;border-radius:12px;background:#fff;color:#3d4758;padding:10px 13px;font:800 11px/1 inherit;display:inline-flex;align-items:center;justify-content:center;gap:7px;cursor:pointer;box-shadow:0 3px 12px rgba(20,30,50,.04)}body.vano-admin-surface .admin240-primary{background:#171d2b;color:#fff;border-color:#171d2b}body.vano-admin-surface .admin240-link{padding:7px 9px;background:#f8f9fb;box-shadow:none}
body.vano-admin-surface .admin240-nav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:9px}body.vano-admin-surface .admin240-nav a{display:flex;align-items:center;gap:10px;min-width:0;padding:13px 14px;border:1px solid #e2e6ed;border-radius:16px;background:rgba(255,255,255,.9);color:#505b6c;text-decoration:none;box-shadow:0 8px 28px rgba(20,30,50,.035);transition:.16s ease}body.vano-admin-surface .admin240-nav a:hover{transform:translateY(-1px);border-color:#d3d9e4;box-shadow:0 12px 30px rgba(20,30,50,.07)}body.vano-admin-surface .admin240-nav svg{color:#d9703f;flex:0 0 auto}body.vano-admin-surface .admin240-nav span{display:grid;gap:2px;min-width:0}body.vano-admin-surface .admin240-nav b{font-size:12px;color:#212a39}body.vano-admin-surface .admin240-nav small{font-size:9px;color:#8a94a3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
body.vano-admin-surface .admin240-overview{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}body.vano-admin-surface .admin240-kpi{min-height:112px;border:1px solid #e1e5ec;border-radius:18px;background:#fff;padding:16px;display:flex;align-items:flex-start;gap:12px;box-shadow:0 10px 30px rgba(20,30,50,.045)}body.vano-admin-surface .admin240-kpi.primary{background:linear-gradient(145deg,#171d2b,#252e42);border-color:transparent;color:#fff}body.vano-admin-surface .admin240-kpi .kpi-icon{width:37px;height:37px;border-radius:12px;display:grid;place-items:center;background:#fff3eb;color:#d9703f;flex:0 0 auto}body.vano-admin-surface .admin240-kpi.primary .kpi-icon{background:rgba(255,255,255,.1);color:#ffbd90}body.vano-admin-surface .admin240-kpi>div{display:grid;gap:3px;min-width:0}body.vano-admin-surface .admin240-kpi small{font-size:8px;letter-spacing:.13em;font-weight:900;color:#8c95a3}body.vano-admin-surface .admin240-kpi.primary small{color:#b5bed0}body.vano-admin-surface .admin240-kpi b{font-size:27px;line-height:1.05;letter-spacing:-.04em;color:#182131}body.vano-admin-surface .admin240-kpi.primary b{color:#fff}body.vano-admin-surface .admin240-kpi span:not(.kpi-icon){font-size:10px;color:#8d96a4;line-height:1.35}body.vano-admin-surface .admin240-kpi.primary span:not(.kpi-icon){color:#b8c1d2}
body.vano-admin-surface .admin240-grid-main{display:grid;grid-template-columns:1.12fr .88fr;gap:12px}body.vano-admin-surface .admin240-card{border:1px solid #e1e5ec;border-radius:20px;background:#fff;box-shadow:0 12px 34px rgba(20,30,50,.045);padding:18px;min-width:0}body.vano-admin-surface .admin240-card>header,
body.vano-admin-surface .admin240-card .admin240-section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px}body.vano-admin-surface .admin240-card header h2,
body.vano-admin-surface .admin240-section-head h2{margin:3px 0 0;font-size:18px;letter-spacing:-.025em;color:#1a2231}body.vano-admin-surface .admin240-section-head p{margin:6px 0 0;color:#8590a0;font-size:11px}body.vano-admin-surface .admin240-live{display:inline-flex;align-items:center;gap:6px;font-size:9px;font-weight:900;color:#27865f;background:#edf9f3;border:1px solid #d9f0e5;padding:6px 8px;border-radius:99px}body.vano-admin-surface .admin240-live i{width:6px;height:6px;border-radius:50%;background:#2bb673;box-shadow:0 0 0 4px rgba(43,182,115,.12)}
body.vano-admin-surface .admin240-health-main{display:grid;grid-template-columns:180px 1fr;gap:18px;margin-top:17px}body.vano-admin-surface .admin240-health-score{border-radius:17px;background:#f6f8fb;border:1px solid #e8ebf1;display:flex;flex-direction:column;justify-content:center;padding:17px}body.vano-admin-surface .admin240-health-score strong{font-size:34px;letter-spacing:-.05em;color:#171f2d}body.vano-admin-surface .admin240-health-score span{font-size:10px;color:#8a94a3;margin-top:3px}body.vano-admin-surface .admin240-capacity{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}body.vano-admin-surface .admin240-capacity>div{border:1px solid #edf0f4;border-radius:14px;padding:12px;background:#fbfcfd;display:grid;gap:4px}body.vano-admin-surface .admin240-capacity span{font-size:9px;color:#8a94a2;font-weight:700}body.vano-admin-surface .admin240-capacity b{font-size:17px;color:#222b3a}body.vano-admin-surface .admin240-progress,
body.vano-admin-surface .admin240 .server-progress{height:7px;border-radius:99px;background:#edf0f4;overflow:hidden;margin-top:13px}body.vano-admin-surface .admin240-progress span,
body.vano-admin-surface .admin240 .server-progress span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#d9703f,#f3a06b);transition:width .25s ease}body.vano-admin-surface .admin240-health-foot{display:flex;gap:16px;flex-wrap:wrap;margin-top:10px;color:#8a93a1;font-size:10px}body.vano-admin-surface .admin240-health-foot b{color:#485365}
body.vano-admin-surface .admin240-pulse-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:16px}body.vano-admin-surface .admin240-pulse-grid>div{border:1px solid #edf0f4;border-radius:14px;background:#fafbfc;padding:12px;display:grid;gap:3px}body.vano-admin-surface .admin240-pulse-grid small{font-size:8px!important;color:#8b95a4!important}body.vano-admin-surface .admin240-pulse-grid b{font-size:20px;letter-spacing:-.035em}body.vano-admin-surface .admin240-pulse-grid span{font-size:9px;color:#8b95a4}
body.vano-admin-surface .admin240-infra{padding:18px}body.vano-admin-surface .admin240-head-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}body.vano-admin-surface .admin240-muted{font-size:9px;color:#929ba9}body.vano-admin-surface .admin240-infra-summary{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}body.vano-admin-surface .admin240-infra-summary>span:not(.hidden-dynamic){padding:8px 10px;border-radius:11px;background:#f7f8fa;border:1px solid #e9ecf1;font-size:9px;color:#7d8796}body.vano-admin-surface .admin240-infra-summary b{color:#273142;margin-left:3px}body.vano-admin-surface .hidden-dynamic{display:none!important}
body.vano-admin-surface .admin240-topology{display:grid;grid-template-columns:170px 1fr;gap:10px;margin-top:12px;padding:10px;border:1px solid #e8ebf0;border-radius:16px;background:#fafbfc}body.vano-admin-surface .admin240-central{display:flex;align-items:center;gap:9px;border-radius:13px;background:#171d2b;color:#fff;padding:11px}body.vano-admin-surface .admin240-central svg{color:#ffae77}body.vano-admin-surface .admin240-central span{display:grid;gap:2px}body.vano-admin-surface .admin240-central b{font-size:11px}body.vano-admin-surface .admin240-central small{font-size:8px;color:#afb9cb}body.vano-admin-surface .admin240-topology-nodes{display:flex;gap:6px;overflow:auto;padding-bottom:1px}body.vano-admin-surface .admin240 .topology-node{flex:0 0 108px!important;min-height:53px!important;border-radius:11px!important;padding:8px!important;background:#fff!important;border:1px solid #e5e9ef!important;display:grid!important;gap:2px!important;box-shadow:none!important;transform:none!important}body.vano-admin-surface .admin240 .topology-node:before{content:"";width:7px;height:7px;border-radius:50%;background:#b6bfca}body.vano-admin-surface .admin240 .topology-node.online:before{background:#23ad6d}body.vano-admin-surface .admin240 .topology-node.offline:before,
body.vano-admin-surface .admin240 .topology-node.disabled:before{background:#df5962}body.vano-admin-surface .admin240 .topology-node.degraded:before,
body.vano-admin-surface .admin240 .topology-node.pending:before,
body.vano-admin-surface .admin240 .topology-node.draining:before{background:#e4aa43}body.vano-admin-surface .admin240 .topology-node b{font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}body.vano-admin-surface .admin240 .topology-node small,
body.vano-admin-surface .admin240 .topology-node em{font-size:7px;color:#8d97a5;font-style:normal;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
body.vano-admin-surface .admin240-toolbar{display:grid;grid-template-columns:auto minmax(220px,1fr) 150px;gap:9px;align-items:center;margin-top:12px}body.vano-admin-surface .admin240 .node-filter-group{display:flex;gap:5px;flex-wrap:wrap}body.vano-admin-surface .admin240 .node-filter{border:1px solid #e2e6ed;background:#fff;border-radius:10px;padding:8px 9px;color:#667183;font:800 9px inherit;cursor:pointer}body.vano-admin-surface .admin240 .node-filter.active{background:#171d2b;color:#fff;border-color:#171d2b}body.vano-admin-surface .admin240 .node-filter b{font-size:8px;margin-left:2px}body.vano-admin-surface .admin240 .node-search{height:38px;border:1px solid #e0e5ec;background:#fff;border-radius:11px;display:flex;align-items:center;gap:8px;padding:0 11px;color:#8c96a4}body.vano-admin-surface .admin240 .node-search input{border:0!important;outline:0!important;background:transparent!important;width:100%;font-size:10px;color:#2d3747;padding:0!important;box-shadow:none!important}body.vano-admin-surface .admin240 .node-sort{height:38px;border:1px solid #e0e5ec;border-radius:11px;background:#fff;color:#5e6979;padding:0 10px;font-size:10px;font-weight:800;outline:none}
body.vano-admin-surface .admin240-server-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:9px!important;margin-top:10px!important}body.vano-admin-surface .admin240 .admin240-server{border:1px solid #e5e8ee!important;border-radius:16px!important;background:#fff!important;padding:13px!important;box-shadow:none!important;min-width:0;transition:.16s ease}body.vano-admin-surface .admin240 .admin240-server:hover{border-color:#d3d9e3!important;box-shadow:0 9px 24px rgba(20,30,50,.06)!important}body.vano-admin-surface .admin240 .server-head{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}body.vano-admin-surface .admin240 .server-id{font-size:8px;color:#d9703f;font-weight:900;letter-spacing:.12em}body.vano-admin-surface .admin240 .server-head h3{font-size:13px!important;margin:2px 0 2px!important;color:#222b39!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px}body.vano-admin-surface .admin240 .server-head p{font-size:8px!important;color:#8d96a4!important;margin:0!important}body.vano-admin-surface .admin240 .server-status{padding:5px 7px!important;border-radius:99px!important;font-size:7px!important;font-weight:900!important}body.vano-admin-surface .admin240 .status-online{background:#eaf8f1!important;color:#188658!important}body.vano-admin-surface .admin240 .status-offline,
body.vano-admin-surface .admin240 .status-disabled{background:#fff0f1!important;color:#c14650!important}body.vano-admin-surface .admin240 .status-degraded,
body.vano-admin-surface .admin240 .status-pending,
body.vano-admin-surface .admin240 .status-draining{background:#fff6df!important;color:#a56f15!important}body.vano-admin-surface .admin240-server-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-top:12px}body.vano-admin-surface .admin240-server-kpis>div{padding:8px;border-radius:10px;background:#f8f9fb;border:1px solid #edf0f4;min-width:0}body.vano-admin-surface .admin240-server-kpis small{display:block;font-size:7px;color:#9099a7}body.vano-admin-surface .admin240-server-kpis b{display:block;margin-top:2px;font-size:10px;color:#313b4a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}body.vano-admin-surface .admin240-server-state{display:flex;justify-content:space-between;margin-top:6px;color:#8a94a2;font-size:8px}body.vano-admin-surface .admin240-server-state b{color:#4f5969}body.vano-admin-surface .admin240-server-url{margin-top:9px;padding:8px 9px;background:#fafbfc;border:1px solid #edf0f4;border-radius:10px;display:grid;gap:3px}body.vano-admin-surface .admin240-server-url span{font-size:7px;color:#929ba8}body.vano-admin-surface .admin240-server-url code{font-size:8px;color:#596475;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}body.vano-admin-surface .admin240 .server-card-actions{display:grid!important;grid-template-columns:repeat(3,1fr)!important;gap:5px!important;margin-top:9px!important}body.vano-admin-surface .admin240 .node-action{min-height:31px!important;border:1px solid #e2e6ec!important;background:#fff!important;border-radius:9px!important;color:#5b6676!important;font:800 8px inherit!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:5px!important;text-decoration:none!important;padding:6px!important;cursor:pointer}body.vano-admin-surface .admin240 .node-action:hover{background:#f5f7fa!important;color:#d9703f!important}body.vano-admin-surface .admin240 .node-action:disabled{opacity:.38;cursor:not-allowed}body.vano-admin-surface .admin240 .server-card.is-filtered-out{display:none!important}
body.vano-admin-surface .admin240-bottom-grid{grid-template-columns:1fr 1fr}body.vano-admin-surface .admin240-feed{display:grid;gap:3px;margin-top:12px}body.vano-admin-surface .admin240-feed-row{display:grid;grid-template-columns:31px minmax(0,1fr) auto;gap:9px;align-items:center;padding:9px 3px;border-bottom:1px solid #f0f2f5}body.vano-admin-surface .admin240-feed-row:last-child{border-bottom:0}body.vano-admin-surface .feed-icon{width:30px;height:30px;border-radius:10px;background:#edf2ff;color:#6579b6;display:grid;place-items:center}body.vano-admin-surface .feed-icon.alert{background:#fff1ea;color:#d9703f}body.vano-admin-surface .admin240-feed-row>div{display:grid;gap:2px;min-width:0}body.vano-admin-surface .admin240-feed-row b{font-size:10px;color:#333d4c;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}body.vano-admin-surface .admin240-feed-row small,
body.vano-admin-surface .admin240-feed-row time{font-size:8px;color:#9099a6}body.vano-admin-surface .admin240-feed-row time{white-space:nowrap}body.vano-admin-surface .admin240-empty{padding:20px;text-align:center;color:#929ba8;font-size:10px}
body.vano-admin-surface .admin240-advanced{padding:0;overflow:hidden}body.vano-admin-surface .admin240-advanced summary{list-style:none;cursor:pointer;padding:15px 17px;display:flex;align-items:center;justify-content:space-between}body.vano-admin-surface .admin240-advanced summary::-webkit-details-marker{display:none}body.vano-admin-surface .admin240-advanced summary>span{display:flex;align-items:center;gap:8px}body.vano-admin-surface .admin240-advanced summary b{font-size:11px}body.vano-admin-surface .admin240-advanced summary small{font-size:9px;color:#8e98a6}body.vano-admin-surface .admin240-advanced[open] summary{border-bottom:1px solid #edf0f4}body.vano-admin-surface .admin240-advanced-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:14px 17px 17px}body.vano-admin-surface .admin240-advanced-grid>div{padding:11px;border-radius:12px;background:#f8f9fb;border:1px solid #edf0f4;display:grid;gap:3px}body.vano-admin-surface .admin240-advanced-grid small{font-size:8px;color:#8f98a6}body.vano-admin-surface .admin240-advanced-grid b{font-size:15px}
/* Keep existing modal behavior, but make the surface consistent with the new page. */
body.vano-admin-surface .admin240 .node-config-modal[hidden]{display:none!important}body.vano-admin-surface .admin240 .node-config-modal{position:fixed;inset:0;z-index:4000;display:grid;place-items:center;padding:18px}body.vano-admin-surface .admin240 .node-config-backdrop{position:absolute;inset:0;background:rgba(20,25,36,.54);backdrop-filter:blur(8px)}body.vano-admin-surface .admin240 .node-config-dialog{position:relative;z-index:1;width:min(760px,100%);max-height:90vh;overflow:auto;border-radius:20px;background:#fff;border:1px solid #e0e4eb;box-shadow:0 30px 90px rgba(20,25,40,.25)}body.vano-admin-surface .admin240 .node-config-head{padding:18px 20px 13px;border-bottom:1px solid #edf0f4;display:flex;justify-content:space-between;gap:15px}body.vano-admin-surface .admin240 .node-config-head h2{margin:3px 0 3px;font-size:20px}body.vano-admin-surface .admin240 .node-config-head p{margin:0;color:#8c96a4;font-size:10px}body.vano-admin-surface .admin240 .node-modal-close{width:34px;height:34px;border:1px solid #e3e6eb;border-radius:10px;background:#f8f9fb;font-size:20px;cursor:pointer}body.vano-admin-surface .admin240 .node-config-form{padding:17px 20px 20px}body.vano-admin-surface .admin240 .node-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}body.vano-admin-surface .admin240 .node-form-grid label{display:grid;gap:5px}body.vano-admin-surface .admin240 .node-form-grid label.full{grid-column:1/-1}body.vano-admin-surface .admin240 .node-form-grid label>span,
body.vano-admin-surface .admin240 .node-toggle span{font-size:9px;font-weight:800;color:#697486}body.vano-admin-surface .admin240 .node-form-grid input,
body.vano-admin-surface .admin240 .node-form-grid select,
body.vano-admin-surface .admin240 .node-form-grid textarea{width:100%;border:1px solid #dfe4eb;border-radius:10px;background:#fbfcfd;padding:10px 11px;font:10px inherit;color:#303a49;outline:none}body.vano-admin-surface .admin240 .node-form-grid input:focus,
body.vano-admin-surface .admin240 .node-form-grid select:focus,
body.vano-admin-surface .admin240 .node-form-grid textarea:focus{border-color:#d9703f;box-shadow:0 0 0 3px rgba(217,112,63,.09)}body.vano-admin-surface .admin240 .node-toggle{display:flex;align-items:center;gap:8px;margin-top:10px}body.vano-admin-surface .admin240 .node-config-message{min-height:22px;padding-top:8px;font-size:9px}body.vano-admin-surface .admin240 .node-config-message.ok{color:#23855d}body.vano-admin-surface .admin240 .node-config-message.error{color:#c44955}body.vano-admin-surface .admin240 .node-config-footer{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}
@media(max-width:1150px){body.vano-admin-surface .admin240-nav{grid-template-columns:repeat(3,1fr)}body.vano-admin-surface .admin240-overview{grid-template-columns:repeat(2,1fr)}body.vano-admin-surface .admin240-grid-main{grid-template-columns:1fr}body.vano-admin-surface .admin240-server-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}body.vano-admin-surface .admin240-toolbar{grid-template-columns:1fr 1fr}body.vano-admin-surface .admin240 .node-filter-group{grid-column:1/-1}body.vano-admin-surface .admin240-topology{grid-template-columns:1fr}body.vano-admin-surface .admin240-bottom-grid{grid-template-columns:1fr}}
@media(max-width:720px){body.vano-admin-surface .admin240{padding:14px 9px 50px}body.vano-admin-surface .admin240-topbar{align-items:flex-start;flex-direction:column}body.vano-admin-surface .admin240-top-actions{width:100%}body.vano-admin-surface .admin240-top-actions>*{flex:1}body.vano-admin-surface .admin240-nav{grid-template-columns:repeat(2,1fr)}body.vano-admin-surface .admin240-overview{grid-template-columns:1fr 1fr}body.vano-admin-surface .admin240-health-main{grid-template-columns:1fr}body.vano-admin-surface .admin240-server-grid{grid-template-columns:1fr!important}body.vano-admin-surface .admin240-toolbar{grid-template-columns:1fr}body.vano-admin-surface .admin240 .node-filter-group{grid-column:auto}body.vano-admin-surface .admin240-pulse-grid{grid-template-columns:1fr 1fr}body.vano-admin-surface .admin240-advanced-grid{grid-template-columns:repeat(2,1fr)}body.vano-admin-surface .admin240 .node-form-grid{grid-template-columns:1fr}body.vano-admin-surface .admin240 .node-form-grid label.full{grid-column:auto}body.vano-admin-surface .admin240-feed-row{grid-template-columns:31px 1fr}body.vano-admin-surface .admin240-feed-row time{grid-column:2}body.vano-admin-surface .admin240-brand h1{font-size:28px}}
@media(max-width:470px){body.vano-admin-surface .admin240-nav{grid-template-columns:1fr}body.vano-admin-surface .admin240-overview{grid-template-columns:1fr}body.vano-admin-surface .admin240-pulse-grid{grid-template-columns:1fr}body.vano-admin-surface .admin240-capacity{grid-template-columns:1fr 1fr}body.vano-admin-surface .admin240-server-kpis{grid-template-columns:repeat(2,1fr)}body.vano-admin-surface .admin240 .server-card-actions{grid-template-columns:1fr!important}body.vano-admin-surface .admin240-advanced-grid{grid-template-columns:1fr}body.vano-admin-surface .admin240-advanced summary>span small{display:none}}

/* V342 — temporary database account reset, available only inside admin. */
body.vano-admin-surface .admin342-danger{margin-top:12px!important;padding:16px 17px!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:18px!important;border-color:#f0d3d0!important;background:linear-gradient(180deg,#fffafa,#fff7f6)!important}
body.vano-admin-surface .admin342-danger-copy{display:flex;align-items:flex-start;gap:12px;min-width:0}body.vano-admin-surface .admin342-danger-icon{width:38px;height:38px;flex:0 0 38px;border-radius:12px;display:grid;place-items:center;background:#fff0ef;color:#cb554d;border:1px solid #f2d7d4}body.vano-admin-surface .admin342-danger-copy small{display:block;color:#c45a52;font-size:8px;font-weight:900;letter-spacing:.12em}body.vano-admin-surface .admin342-danger-copy h2{margin:4px 0 4px!important;color:#503431!important;font-size:15px!important;letter-spacing:-.25px}body.vano-admin-surface .admin342-danger-copy p{margin:0!important;max-width:650px;color:#8b6f6b!important;font-size:9px!important;line-height:1.55}body.vano-admin-surface .admin342-danger-copy p b{color:#67423e}body.vano-admin-surface .admin342-reset-form{flex:0 0 auto}body.vano-admin-surface .admin342-danger-button{min-height:38px;padding:0 13px;border:1px solid #d65e56;border-radius:11px;background:#cf554d;color:#fff;display:inline-flex;align-items:center;justify-content:center;gap:7px;font:900 9px inherit;cursor:pointer;box-shadow:0 7px 18px rgba(207,85,77,.14);transition:.16s ease}body.vano-admin-surface .admin342-danger-button:hover{background:#bd4740}body.vano-admin-surface .admin342-danger-button:active{transform:scale(.98)}body.vano-admin-surface .admin342-danger-button:disabled{opacity:.58;cursor:wait}
@media(max-width:720px){body.vano-admin-surface .admin342-danger{align-items:stretch!important;flex-direction:column!important}body.vano-admin-surface .admin342-reset-form,
body.vano-admin-surface .admin342-danger-button{width:100%}}


/* ===== static/vano-admin-privacy.css ===== */
body.vano-admin-surface .admin86{--a-bg:#f5f6f8;--a-card:#fff;--a-text:#15181d;--a-muted:#747d88;--a-line:#e5e8ec;--a-soft:#f8f9fb;--a-orange:#F59A62;min-height:100vh;background:var(--a-bg);color:var(--a-text);padding:30px 0 80px}body.vano-admin-surface .admin86-wrap{width:min(1240px,calc(100% - 32px));margin:auto}body.vano-admin-surface .admin255-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;margin-bottom:22px}body.vano-admin-surface .admin255-head h1{margin:5px 0 5px;font-size:34px;letter-spacing:-1.4px}body.vano-admin-surface .admin255-head p{margin:0;color:var(--a-muted);max-width:680px}body.vano-admin-surface .admin255-kicker,
body.vano-admin-surface .section-tag{font-size:11px;text-transform:uppercase;letter-spacing:.1em;font-weight:900;color:#c96534}body.vano-admin-surface .admin255-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}body.vano-admin-surface .admin255-actions a,
body.vano-admin-surface .admin255-action{display:inline-flex;align-items:center;gap:7px;min-height:38px;padding:0 12px;border-radius:11px;border:1px solid var(--a-line);background:var(--a-card);color:var(--a-text);font-size:12px;font-weight:800;text-decoration:none}body.vano-admin-surface .admin255-actions a:hover,
body.vano-admin-surface .admin255-action:hover{border-color:#f0b18e;background:#fff8f4}
body.vano-admin-surface .admin255-overview{display:grid;grid-template-columns:1.35fr repeat(4,1fr);gap:10px;margin-bottom:14px}body.vano-admin-surface .admin255-stat{background:var(--a-card);border:1px solid var(--a-line);border-radius:18px;padding:17px;min-width:0}body.vano-admin-surface .admin255-stat.primary{background:linear-gradient(145deg,#fff7f1,#fff);border-color:#f5d8c6}body.vano-admin-surface .admin255-stat small{display:block;color:var(--a-muted);font-weight:700;font-size:11px}body.vano-admin-surface .admin255-stat b{display:block;margin-top:7px;font-size:26px;letter-spacing:-.8px}body.vano-admin-surface .admin255-stat.primary b{font-size:38px}body.vano-admin-surface .admin255-stat .sub{margin-top:5px;color:var(--a-muted);font-size:11px}body.vano-admin-surface .admin255-progress{height:6px;border-radius:99px;background:#edf0f3;overflow:hidden;margin-top:12px}body.vano-admin-surface .admin255-progress span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#F59A62,#dd6f3b)}
body.vano-admin-surface .admin255-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:14px;margin-top:14px}body.vano-admin-surface .admin255-card{background:var(--a-card);border:1px solid var(--a-line);border-radius:20px;padding:20px;box-shadow:0 8px 30px rgba(24,30,38,.035)}body.vano-admin-surface .admin255-card h2{font-size:19px;margin:4px 0 4px;letter-spacing:-.4px}body.vano-admin-surface .admin255-card p{margin:0;color:var(--a-muted);font-size:12px;line-height:1.55}body.vano-admin-surface .admin255-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:15px}body.vano-admin-surface .admin255-live{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--a-muted);white-space:nowrap}body.vano-admin-surface .live-dot{width:7px;height:7px;border-radius:50%;background:#36b879;box-shadow:0 0 0 4px rgba(54,184,121,.10)}
body.vano-admin-surface .admin255-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}body.vano-admin-surface .admin255-metric{padding:12px;background:var(--a-soft);border:1px solid #eef0f3;border-radius:13px}body.vano-admin-surface .admin255-metric small{display:block;color:var(--a-muted);font-size:10px}body.vano-admin-surface .admin255-metric b{display:block;margin-top:5px;font-size:17px}body.vano-admin-surface .admin255-healthline{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid var(--a-line);font-size:12px}body.vano-admin-surface .admin255-healthline:last-child{border:0}body.vano-admin-surface .admin255-healthline span{color:var(--a-muted)}
body.vano-admin-surface .admin255-topology{display:flex;gap:8px;align-items:stretch;overflow:auto;padding-bottom:3px}body.vano-admin-surface .topology-central{min-width:170px;padding:13px;border-radius:14px;background:#fff3eb;border:1px solid #f4d5c2}body.vano-admin-surface .topology-central small,
body.vano-admin-surface .topology-central span{display:block;color:var(--a-muted);font-size:10px}body.vano-admin-surface .topology-central b{display:block;margin:4px 0}body.vano-admin-surface .topology-nodes{display:flex;gap:6px}body.vano-admin-surface .topology-node{min-width:118px;padding:10px;border:1px solid var(--a-line);border-radius:12px;background:var(--a-soft)}body.vano-admin-surface .topology-node strong,
body.vano-admin-surface .topology-node span,
body.vano-admin-surface .topology-node small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}body.vano-admin-surface .topology-node strong{font-size:11px}body.vano-admin-surface .topology-node span,
body.vano-admin-surface .topology-node small{font-size:9px;color:var(--a-muted);margin-top:4px}body.vano-admin-surface .topology-node.online{border-color:#bfe8d5;background:#f3fbf7}body.vano-admin-surface .topology-node.offline,
body.vano-admin-surface .topology-node.disabled{border-color:#f0cccc;background:#fff7f7}
body.vano-admin-surface .admin255-nodes{margin-top:14px}body.vano-admin-surface .node-ops-toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:14px 0}body.vano-admin-surface .node-filter-group{display:flex;gap:5px;flex-wrap:wrap}body.vano-admin-surface .node-filter{border:1px solid var(--a-line);background:var(--a-card);color:var(--a-muted);border-radius:10px;padding:9px 11px;font-weight:800;font-size:11px}body.vano-admin-surface .node-filter.active{background:#fff1e8;border-color:#efc3a7;color:#a95025}body.vano-admin-surface .node-search{display:flex;align-items:center;gap:7px;flex:1;min-width:210px;padding:0 11px;height:38px;border:1px solid var(--a-line);border-radius:11px;background:var(--a-card)}body.vano-admin-surface .node-search input{width:100%;border:0;outline:0;background:transparent;color:var(--a-text);font-size:12px}body.vano-admin-surface .node-sort{height:38px;border:1px solid var(--a-line);border-radius:11px;background:var(--a-card);color:var(--a-text);padding:0 10px}body.vano-admin-surface .server-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}body.vano-admin-surface .server-card{border:1px solid var(--a-line);border-radius:16px;background:var(--a-card);padding:15px;min-width:0}body.vano-admin-surface .server-card.is-filtered-out{display:none}body.vano-admin-surface .server-head{display:flex;justify-content:space-between;gap:10px}body.vano-admin-surface .server-id{font-size:9px;color:var(--a-muted);text-transform:uppercase;font-weight:900}body.vano-admin-surface .server-head h3{margin:3px 0 2px;font-size:15px}body.vano-admin-surface .server-head p{font-size:10px;margin:0;color:var(--a-muted)}body.vano-admin-surface .server-status{height:23px;padding:0 8px;border-radius:999px;display:inline-flex;align-items:center;font-size:9px;font-weight:900;background:#f1f2f4}body.vano-admin-surface .status-online{background:#e8f8f0;color:#20734f}body.vano-admin-surface .status-offline,
body.vano-admin-surface .status-disabled{background:#fdecec;color:#a33c3c}body.vano-admin-surface .status-degraded,
body.vano-admin-surface .status-pending,
body.vano-admin-surface .status-draining{background:#fff3d8;color:#8b6514}body.vano-admin-surface .server-users-row{display:flex;justify-content:space-between;margin-top:13px}body.vano-admin-surface .server-users-row small{display:block;color:var(--a-muted);font-size:9px}body.vano-admin-surface .server-users-row b{font-size:18px}body.vano-admin-surface .mini-badge{font-size:9px;color:var(--a-muted);padding-top:5px}body.vano-admin-surface .server-progress{height:5px;background:#eef0f3;border-radius:99px;overflow:hidden;margin:9px 0 12px}body.vano-admin-surface .server-progress span{display:block;height:100%;background:#F59A62}body.vano-admin-surface .server-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}body.vano-admin-surface .server-metrics div{padding:8px;background:var(--a-soft);border-radius:9px}body.vano-admin-surface .server-metrics small{display:block;color:var(--a-muted);font-size:8px}body.vano-admin-surface .server-metrics b{font-size:11px}body.vano-admin-surface .server-details{margin-top:10px;border-top:1px solid var(--a-line);padding-top:9px}body.vano-admin-surface .server-details summary{font-size:10px;font-weight:850;cursor:pointer;color:var(--a-muted)}body.vano-admin-surface .server-meta-list{display:grid;gap:6px;margin-top:8px}body.vano-admin-surface .server-meta-list div{display:grid;grid-template-columns:68px 1fr;gap:6px;font-size:9px}body.vano-admin-surface .server-meta-list span{color:var(--a-muted)}body.vano-admin-surface .server-meta-list code,
body.vano-admin-surface .server-meta-list strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}body.vano-admin-surface .server-card-actions{display:flex;gap:5px;margin-top:11px}body.vano-admin-surface .node-action{flex:1;display:inline-flex;align-items:center;justify-content:center;gap:5px;min-height:32px;border-radius:9px;border:1px solid var(--a-line);background:var(--a-card);color:var(--a-text);font-size:9px;font-weight:850;text-decoration:none}body.vano-admin-surface .node-action:hover{background:#fff5ef}body.vano-admin-surface .server-note{margin-top:7px;color:var(--a-muted);font-size:9px}body.vano-admin-surface .infra-note{margin-top:12px;padding:12px;border-radius:12px;background:var(--a-soft);color:var(--a-muted);font-size:10px}
body.vano-admin-surface .admin255-fold{margin-top:14px}body.vano-admin-surface .admin255-fold>summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;padding:18px 20px;border:1px solid var(--a-line);border-radius:18px;background:var(--a-card);font-weight:900}body.vano-admin-surface .admin255-fold[open]>summary{border-radius:18px 18px 0 0}body.vano-admin-surface .admin255-fold-body{border:1px solid var(--a-line);border-top:0;background:var(--a-card);padding:18px;border-radius:0 0 18px 18px}body.vano-admin-surface .admin255-feed{display:grid;gap:7px}body.vano-admin-surface .admin255-feed-row{display:grid;grid-template-columns:1fr auto;gap:12px;padding:11px 0;border-bottom:1px solid var(--a-line)}body.vano-admin-surface .admin255-feed-row:last-child{border:0}body.vano-admin-surface .admin255-feed-row b,
body.vano-admin-surface .admin255-feed-row span{display:block;font-size:11px}body.vano-admin-surface .admin255-feed-row span{color:var(--a-muted);margin-top:3px}body.vano-admin-surface .admin255-feed-row aside{text-align:right;font-size:10px;color:var(--a-muted)}
body.vano-admin-surface .admin-js-mirrors{display:none!important}body.vano-admin-surface .node-config-modal[hidden]{display:none}body.vano-admin-surface .node-config-modal{position:fixed;inset:0;z-index:99999;display:grid;place-items:center;padding:18px}body.vano-admin-surface .node-config-backdrop{position:absolute;inset:0;background:rgba(8,10,12,.56);backdrop-filter:blur(7px)}body.vano-admin-surface .node-config-dialog{position:relative;width:min(780px,100%);max-height:90vh;overflow:auto;background:var(--a-card);border:1px solid var(--a-line);border-radius:22px;box-shadow:0 30px 100px rgba(0,0,0,.25)}body.vano-admin-surface .node-config-head{display:flex;justify-content:space-between;padding:20px;border-bottom:1px solid var(--a-line)}body.vano-admin-surface .node-config-head h2{margin:3px 0}body.vano-admin-surface .node-config-head p{margin:0;color:var(--a-muted);font-size:11px}body.vano-admin-surface .node-modal-close{width:36px;height:36px;border-radius:10px;border:1px solid var(--a-line);background:var(--a-card);font-size:20px}body.vano-admin-surface .node-config-form{padding:20px}body.vano-admin-surface .node-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}body.vano-admin-surface .node-form-grid label{display:grid;gap:5px;font-size:10px;font-weight:800}body.vano-admin-surface .node-form-grid .full{grid-column:1/-1}body.vano-admin-surface .node-form-grid input,
body.vano-admin-surface .node-form-grid select,
body.vano-admin-surface .node-form-grid textarea{width:100%;border:1px solid var(--a-line);background:var(--a-soft);color:var(--a-text);border-radius:10px;padding:10px;outline:0}body.vano-admin-surface .node-toggle{display:flex;gap:9px;margin-top:13px;font-size:11px}body.vano-admin-surface .node-config-message{min-height:20px;margin-top:10px;font-size:11px}body.vano-admin-surface .node-config-message.ok{color:#27805a}body.vano-admin-surface .node-config-message.error{color:#b53d3d}body.vano-admin-surface .node-config-footer{display:flex;justify-content:flex-end;gap:8px;margin-top:15px}body.vano-admin-surface .admin86-primary{background:#F59A62!important;color:#2b1508!important;border-color:#e98a52!important}
html[data-vano-theme="black"] body.vano-admin-surface .admin86,
html[data-vano-theme-mode="black"] body.vano-admin-surface .admin86{--a-bg:#0b0d10;--a-card:#12151a;--a-text:#f2f4f7;--a-muted:#929ba7;--a-line:rgba(255,255,255,.075);--a-soft:#171b21}body.vano-admin-surface .admin86 .btn{color:var(--a-text)}html[data-vano-theme="black"] body.vano-admin-surface .admin255-stat.primary,
html[data-vano-theme-mode="black"] body.vano-admin-surface .admin255-stat.primary{background:linear-gradient(145deg,rgba(245,154,98,.09),#12151a);border-color:rgba(245,154,98,.2)}html[data-vano-theme="black"] body.vano-admin-surface .topology-central,
html[data-vano-theme-mode="black"] body.vano-admin-surface .topology-central{background:rgba(245,154,98,.08);border-color:rgba(245,154,98,.16)}html[data-vano-theme="black"] body.vano-admin-surface .node-filter.active,
html[data-vano-theme-mode="black"] body.vano-admin-surface .node-filter.active{background:rgba(245,154,98,.10);border-color:rgba(245,154,98,.22);color:#f3b18c}
@media(max-width:1050px){body.vano-admin-surface .admin255-overview{grid-template-columns:repeat(3,1fr)}body.vano-admin-surface .admin255-stat.primary{grid-column:span 2}body.vano-admin-surface .server-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){body.vano-admin-surface .admin86{padding-top:18px}body.vano-admin-surface .admin86-wrap{width:calc(100% - 18px)}body.vano-admin-surface .admin255-head{display:block}body.vano-admin-surface .admin255-actions{justify-content:flex-start;margin-top:13px;flex-wrap:nowrap;overflow:auto;padding-bottom:4px}body.vano-admin-surface .admin255-actions a{white-space:nowrap}body.vano-admin-surface .admin255-overview{grid-template-columns:1fr 1fr}body.vano-admin-surface .admin255-stat.primary{grid-column:1/-1}body.vano-admin-surface .admin255-grid{grid-template-columns:1fr}body.vano-admin-surface .admin255-metrics{grid-template-columns:1fr 1fr}body.vano-admin-surface .server-grid{grid-template-columns:1fr}body.vano-admin-surface .node-search{order:3;flex-basis:100%}body.vano-admin-surface .node-sort{flex:1}body.vano-admin-surface .node-form-grid{grid-template-columns:1fr}body.vano-admin-surface .node-form-grid .full{grid-column:auto}}


/* ===== static/vano-admin.css ===== */
body.vano-route-admin-dashboard .admin350{--a-bg:#f5f6f7;--a-card:#fff;--a-soft:#f7f8f9;--a-line:#e8e9ec;--a-line-strong:#dcdfe3;--a-text:#17191d;--a-muted:#777e88;--a-faint:#a3a8b0;--a-accent:#f59a62;--a-accent-deep:#dc7640;--a-accent-soft:#fff1e7;--a-green:#2d9c6f;--a-green-soft:#eaf7f1;--a-red:#c64d4d;--a-red-soft:#fff0f0;--a-yellow:#c48a27;--a-yellow-soft:#fff7e5;min-height:100vh;background:radial-gradient(circle at 12% 0%,rgba(245,154,98,.065),transparent 24%),var(--a-bg);color:var(--a-text);padding:26px 0 90px}body.vano-route-admin-dashboard .admin350-shell{width:min(1240px,calc(100% - 34px));margin:0 auto}body.vano-route-admin-dashboard .admin350-hero{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:26px 28px;border:1px solid var(--a-line);border-radius:26px;background:linear-gradient(135deg,#fff 0%,#fff 60%,#fff6f0 100%);box-shadow:0 18px 50px rgba(20,24,31,.05)}body.vano-route-admin-dashboard .admin350-hero:after{content:"";position:absolute;width:330px;height:330px;right:-110px;top:-160px;border-radius:999px;background:radial-gradient(circle,rgba(245,154,98,.18),transparent 67%);pointer-events:none}body.vano-route-admin-dashboard .admin350-hero-copy{position:relative;z-index:1;display:flex;align-items:center;gap:16px;min-width:0}body.vano-route-admin-dashboard .admin350-command-mark{width:50px;height:50px;border-radius:16px;display:grid;place-items:center;flex:none;background:linear-gradient(145deg,#2e2925,#161718);color:#fff;border:1px solid rgba(255,255,255,.07);box-shadow:0 10px 24px rgba(30,24,21,.16)}body.vano-route-admin-dashboard .admin350-kicker{display:flex;align-items:center;gap:7px;font-size:9px;font-weight:900;letter-spacing:.14em;color:#9d5a32}body.vano-route-admin-dashboard .admin350-kicker em{font-style:normal;padding:3px 6px;border-radius:999px;background:#eef8f3;color:#2b7d5b;letter-spacing:.08em}body.vano-route-admin-dashboard .admin350-live-dot{width:7px;height:7px;border-radius:999px;background:#2eb47b;box-shadow:0 0 0 4px rgba(46,180,123,.1)}body.vano-route-admin-dashboard .admin350-hero h1{margin:6px 0 4px;font-size:28px;line-height:1.05;letter-spacing:-1px}body.vano-route-admin-dashboard .admin350-hero p{margin:0;color:var(--a-muted);font-size:11px;line-height:1.5}body.vano-route-admin-dashboard .admin350-hero-actions{position:relative;z-index:1;display:flex;align-items:center;gap:7px;flex:none}body.vano-route-admin-dashboard .admin350-btn{min-height:40px;padding:0 13px;border-radius:12px;border:1px solid var(--a-line-strong);display:inline-flex;align-items:center;justify-content:center;gap:7px;text-decoration:none;color:var(--a-text);background:var(--a-card);font-size:10px;font-weight:850;cursor:pointer;transition:.2s ease}body.vano-route-admin-dashboard .admin350-btn:hover{transform:translateY(-1px);border-color:#e5b89b}body.vano-route-admin-dashboard .admin350-btn.is-primary{background:linear-gradient(180deg,#ffad78,#f59a62);border-color:#e78952;color:#2a160b;box-shadow:0 7px 18px rgba(245,154,98,.18)}body.vano-route-admin-dashboard .admin350-btn.is-soft{background:var(--a-soft)}body.vano-route-admin-dashboard .admin350-nav{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin-top:12px}body.vano-route-admin-dashboard .admin350-nav a{display:grid;grid-template-columns:36px minmax(0,1fr) 14px;align-items:center;gap:9px;min-height:64px;padding:10px 11px;border:1px solid var(--a-line);border-radius:16px;background:var(--a-card);color:var(--a-text);text-decoration:none;box-shadow:0 8px 24px rgba(20,24,31,.025);transition:.2s ease}body.vano-route-admin-dashboard .admin350-nav a:hover{transform:translateY(-2px);border-color:#edc7ae;box-shadow:0 10px 24px rgba(20,24,31,.055)}body.vano-route-admin-dashboard .admin350-nav a>span{width:36px;height:36px;border-radius:11px;display:grid;place-items:center;background:var(--a-soft);color:#747982}body.vano-route-admin-dashboard .admin350-nav a>div{min-width:0}body.vano-route-admin-dashboard .admin350-nav b,
body.vano-route-admin-dashboard .admin350-nav small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}body.vano-route-admin-dashboard .admin350-nav b{font-size:10.5px}body.vano-route-admin-dashboard .admin350-nav small{font-size:8.5px;color:var(--a-muted);margin-top:2px}body.vano-route-admin-dashboard .admin350-nav>a>svg{color:#b0b4ba}body.vano-route-admin-dashboard .admin350-kpi-grid{display:grid;grid-template-columns:1.25fr repeat(3,1fr);gap:9px;margin-top:12px}body.vano-route-admin-dashboard .admin350-kpi{padding:16px;border:1px solid var(--a-line);border-radius:19px;background:var(--a-card);box-shadow:0 10px 28px rgba(20,24,31,.03)}body.vano-route-admin-dashboard .admin350-kpi.is-primary{background:linear-gradient(145deg,#fff,#fff5ee);border-color:#f0d8c8}body.vano-route-admin-dashboard .admin350-kpi-top{display:flex;align-items:center;gap:7px}body.vano-route-admin-dashboard .admin350-kpi-top>span{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;background:var(--a-soft);color:#727780}body.vano-route-admin-dashboard .admin350-kpi.is-primary .admin350-kpi-top>span{background:#ffe9da;color:#a85b31}body.vano-route-admin-dashboard .admin350-kpi-top small{font-size:8.5px;font-weight:900;letter-spacing:.08em;color:var(--a-muted)}body.vano-route-admin-dashboard .admin350-kpi-top em{margin-left:auto;font-size:8px;font-style:normal;color:#a1582d;background:#fff0e6;border-radius:999px;padding:4px 6px}body.vano-route-admin-dashboard .admin350-kpi>strong{display:block;margin:13px 0 12px;font-size:29px;line-height:1;letter-spacing:-1.2px}body.vano-route-admin-dashboard .admin350-kpi-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;padding-top:10px;border-top:1px solid var(--a-line)}body.vano-route-admin-dashboard .admin350-kpi-foot span{font-size:8.5px;color:var(--a-muted)}body.vano-route-admin-dashboard .admin350-kpi-foot b{font-size:9.5px}body.vano-route-admin-dashboard .admin350-operational-grid{display:grid;grid-template-columns:1.35fr .85fr;gap:10px;margin-top:10px}body.vano-route-admin-dashboard .admin350-card{border:1px solid var(--a-line);border-radius:21px;background:var(--a-card);box-shadow:0 10px 30px rgba(20,24,31,.025)}body.vano-route-admin-dashboard .admin350-health-card,
body.vano-route-admin-dashboard .admin350-product-card{padding:19px}body.vano-route-admin-dashboard .admin350-card-head,
body.vano-route-admin-dashboard .admin350-section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}body.vano-route-admin-dashboard .admin350-card-head>div>span,
body.vano-route-admin-dashboard .admin350-section-head>div>span{display:block;font-size:8.5px;font-weight:900;letter-spacing:.12em;color:#9b5b35}body.vano-route-admin-dashboard .admin350-card-head h2,
body.vano-route-admin-dashboard .admin350-section-head h2{margin:5px 0 3px;font-size:17px;letter-spacing:-.45px}body.vano-route-admin-dashboard .admin350-card-head p,
body.vano-route-admin-dashboard .admin350-section-head p{margin:0;color:var(--a-muted);font-size:9.5px;line-height:1.5}body.vano-route-admin-dashboard .admin350-live{display:flex;align-items:center;gap:6px;font-size:9px;color:var(--a-muted);white-space:nowrap}body.vano-route-admin-dashboard .admin350-live>span{width:7px;height:7px;border-radius:999px;background:#2eb47b;box-shadow:0 0 0 4px rgba(46,180,123,.08)}body.vano-route-admin-dashboard .admin350-health-body{display:grid;grid-template-columns:1fr 1.2fr;gap:18px;align-items:center;margin-top:18px}body.vano-route-admin-dashboard .admin350-health-score{display:flex;align-items:center;gap:13px}body.vano-route-admin-dashboard .admin350-ring{width:82px;height:82px;flex:none;border-radius:999px;display:grid;place-content:center;text-align:center;background:conic-gradient(#40ad7e 0 78%,#e8ecea 78% 100%);position:relative}body.vano-route-admin-dashboard .admin350-ring:after{content:"";position:absolute;inset:7px;border-radius:999px;background:var(--a-card)}body.vano-route-admin-dashboard .admin350-ring strong,
body.vano-route-admin-dashboard .admin350-ring small{position:relative;z-index:1}body.vano-route-admin-dashboard .admin350-ring strong{font-size:18px;letter-spacing:-.5px}body.vano-route-admin-dashboard .admin350-ring small{font-size:8px;color:var(--a-muted);margin-top:2px}body.vano-route-admin-dashboard .admin350-health-score>div:last-child b,
body.vano-route-admin-dashboard .admin350-health-score>div:last-child span{display:block}body.vano-route-admin-dashboard .admin350-health-score>div:last-child b{font-size:11px}body.vano-route-admin-dashboard .admin350-health-score>div:last-child span{font-size:9px;line-height:1.45;color:var(--a-muted);margin-top:3px;max-width:150px}body.vano-route-admin-dashboard .admin350-health-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}body.vano-route-admin-dashboard .admin350-health-metrics>div{padding:9px;border:1px solid var(--a-line);border-radius:11px;background:var(--a-soft)}body.vano-route-admin-dashboard .admin350-health-metrics span,
body.vano-route-admin-dashboard .admin350-health-metrics b{display:block}body.vano-route-admin-dashboard .admin350-health-metrics span{font-size:8px;color:var(--a-muted)}body.vano-route-admin-dashboard .admin350-health-metrics b{font-size:11px;margin-top:4px}body.vano-route-admin-dashboard .admin350-occupancy-head{display:flex;justify-content:space-between;align-items:center;margin-top:16px;font-size:8.5px;color:var(--a-muted)}body.vano-route-admin-dashboard .admin350-occupancy-head b{font-size:9px;color:var(--a-text)}body.vano-route-admin-dashboard .admin350-progress{height:6px;margin-top:6px;border-radius:999px;background:var(--a-soft);overflow:hidden}body.vano-route-admin-dashboard .admin350-progress>span{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,#f7b68e,#f18b50);transition:width .35s ease}body.vano-route-admin-dashboard .admin350-signal-list{display:grid;gap:0;margin-top:11px}body.vano-route-admin-dashboard .admin350-signal{display:grid;grid-template-columns:32px 1fr auto;align-items:center;gap:9px;min-height:52px;border-bottom:1px solid var(--a-line)}body.vano-route-admin-dashboard .admin350-signal:last-child{border-bottom:0}body.vano-route-admin-dashboard .admin350-signal>span{width:30px;height:30px;border-radius:10px;background:var(--a-soft);display:grid;place-items:center;color:#777c84}body.vano-route-admin-dashboard .admin350-signal>span.is-good{background:var(--a-green-soft);color:#2e8864}body.vano-route-admin-dashboard .admin350-signal>span.is-warn{background:var(--a-red-soft);color:#b84b4b}body.vano-route-admin-dashboard .admin350-signal small,
body.vano-route-admin-dashboard .admin350-signal b{display:block}body.vano-route-admin-dashboard .admin350-signal small{font-size:8px;color:var(--a-muted)}body.vano-route-admin-dashboard .admin350-signal b{font-size:11px;margin-top:2px}body.vano-route-admin-dashboard .admin350-signal em{font-size:8.5px;font-style:normal;color:var(--a-muted);white-space:nowrap}body.vano-route-admin-dashboard .admin350-infra{margin-top:10px;padding:20px}body.vano-route-admin-dashboard .admin350-section-head{align-items:center}body.vano-route-admin-dashboard .admin350-section-actions{display:flex;align-items:center;gap:8px}body.vano-route-admin-dashboard .admin350-updated{font-size:8.5px;color:var(--a-muted);transition:.2s ease}body.vano-route-admin-dashboard .admin350-updated.is-fresh{color:#27825e;transform:translateY(-1px)}body.vano-route-admin-dashboard .admin350-infra-summary{display:grid;grid-template-columns:repeat(6,1fr);gap:6px;margin-top:16px}body.vano-route-admin-dashboard .admin350-infra-summary>div{padding:10px 11px;border:1px solid var(--a-line);border-radius:12px;background:var(--a-soft)}body.vano-route-admin-dashboard .admin350-infra-summary span,
body.vano-route-admin-dashboard .admin350-infra-summary b{display:block}body.vano-route-admin-dashboard .admin350-infra-summary span{font-size:8px;color:var(--a-muted)}body.vano-route-admin-dashboard .admin350-infra-summary b{font-size:13px;margin-top:3px}body.vano-route-admin-dashboard .admin350-infra-summary>div.is-success{background:var(--a-green-soft);border-color:#d6ebdf}body.vano-route-admin-dashboard .admin350-topology{display:grid;grid-template-columns:160px 42px minmax(0,1fr);align-items:center;margin-top:14px;padding:13px;border:1px solid var(--a-line);border-radius:16px;background:linear-gradient(180deg,var(--a-soft),var(--a-card))}body.vano-route-admin-dashboard .admin350-central{display:grid;grid-template-columns:36px 1fr;gap:8px;align-items:center}body.vano-route-admin-dashboard .admin350-central>span{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:#ffeadd;color:#9c552d}body.vano-route-admin-dashboard .admin350-central small,
body.vano-route-admin-dashboard .admin350-central b,
