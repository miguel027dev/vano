body.vano-auth-startup .register-kicker,
body.vano-route-register .register-kicker{display:inline-flex!important;align-items:center!important;gap:7px!important;min-height:31px!important;padding:0 10px!important;border-radius:999px!important;background:var(--v402-accent-soft)!important;color:var(--v402-accent-strong)!important;font-size:9px!important;font-weight:900!important;letter-spacing:.09em!important;text-transform:uppercase!important}
body.vano-auth-startup .register-copy h1,
body.vano-route-register .register-copy h1{margin:16px 0 12px!important;font-size:clamp(43px,4.8vw,63px)!important;line-height:.94!important;letter-spacing:-3.2px!important;color:var(--v402-ink)!important}
body.vano-auth-startup .register-copy h1 span,
body.vano-route-register .register-copy h1 span{display:block!important;color:var(--v402-muted)!important}
body.vano-auth-startup .register-copy p,
body.vano-route-register .register-copy p{margin:0!important;max-width:430px!important;color:var(--v402-muted)!important;font-size:13px!important;line-height:1.62!important}
body.vano-auth-startup .register-actions,
body.vano-route-register .register-actions{margin-top:27px!important;max-width:500px!important}
body.vano-auth-startup .register-google,
body.vano-auth-startup .register-email-submit,
body.vano-route-register .register-google,
body.vano-route-register .register-email-submit{min-height:59px!important;border-radius:18px!important}
body.vano-auth-startup .register-google,
body.vano-route-register .register-google{display:grid!important;grid-template-columns:24px 1fr 18px!important;align-items:center!important;gap:10px!important;padding:0 18px!important;border:1px solid var(--v402-line)!important;background:var(--v402-card-2)!important;color:var(--v402-ink)!important;font-size:12px!important;font-weight:880!important;box-shadow:none!important;transition:.2s var(--v402-ease)!important}
body.vano-auth-startup .register-google:hover,
body.vano-route-register .register-google:hover{transform:translateY(-1px)!important;background:var(--v402-card)!important;border-color:rgba(242,139,80,.3)!important;box-shadow:var(--v402-shadow-soft)!important}
body.vano-auth-startup .register-divider,
body.vano-route-register .register-divider{display:flex!important;align-items:center!important;gap:10px!important;margin:17px 0!important;color:var(--v402-faint)!important;font-size:9px!important;font-weight:800!important;text-transform:uppercase!important;letter-spacing:.08em!important}
body.vano-auth-startup .register-divider:before,
body.vano-auth-startup .register-divider:after,
body.vano-route-register .register-divider:before,
body.vano-route-register .register-divider:after{content:""!important;height:1px!important;background:var(--v402-line)!important;flex:1!important}
body.vano-auth-startup .register-form,
body.vano-route-register .register-form{display:grid!important;gap:14px!important}
body.vano-auth-startup .register-field,
body.vano-route-register .register-field{display:grid!important;gap:7px!important}
body.vano-auth-startup .register-field>label,
body.vano-route-register .register-field>label{padding-left:2px!important;color:var(--v402-muted)!important;font-size:9.5px!important;font-weight:850!important}
body.vano-auth-startup .register-input-shell,
body.vano-route-register .register-input-shell{min-height:59px!important;display:flex!important;align-items:center!important;gap:10px!important;padding:0 15px!important;border-radius:18px!important;border:1px solid var(--v402-line)!important;background:var(--v402-card-2)!important;transition:.2s var(--v402-ease)!important}
body.vano-auth-startup .register-input-shell:hover,
body.vano-route-register .register-input-shell:hover{background:var(--v402-card)!important;border-color:var(--v402-line-strong)!important}
body.vano-auth-startup .register-input-shell:focus-within,
body.vano-route-register .register-input-shell:focus-within{background:var(--v402-card)!important;border-color:rgba(242,139,80,.54)!important;box-shadow:0 0 0 4px rgba(242,139,80,.11)!important;transform:translateY(-1px)!important}
body.vano-auth-startup .register-input-shell>i,
body.vano-route-register .register-input-shell>i{color:var(--v402-accent-strong)!important}
body.vano-auth-startup .register-input-shell input,
body.vano-route-register .register-input-shell input{width:100%!important;min-width:0!important;border:0!important;outline:0!important;background:transparent!important;color:var(--v402-ink)!important;font-size:14px!important;font-weight:680!important}
body.vano-auth-startup .register-input-shell input::placeholder,
body.vano-route-register .register-input-shell input::placeholder{color:var(--v402-faint)!important}
body.vano-auth-startup .register-password-toggle,
body.vano-route-register .register-password-toggle{width:36px!important;height:36px!important;display:grid!important;place-items:center!important;border:0!important;background:transparent!important;color:var(--v402-muted)!important;border-radius:11px!important}
body.vano-auth-startup .register-password-toggle:hover,
body.vano-route-register .register-password-toggle:hover{background:var(--v402-accent-soft)!important;color:var(--v402-accent-strong)!important}
body.vano-auth-startup .register-field>small,
body.vano-route-register .register-field>small{color:var(--v402-faint)!important;font-size:9.5px!important;padding-left:2px!important}
body.vano-auth-startup .register-field.is-valid .register-input-shell,
body.vano-route-register .register-field.is-valid .register-input-shell{border-color:rgba(69,161,107,.28)!important}
body.vano-auth-startup .register-field.is-invalid .register-input-shell,
body.vano-route-register .register-field.is-invalid .register-input-shell{border-color:rgba(215,91,75,.42)!important;box-shadow:0 0 0 4px rgba(215,91,75,.07)!important}
body.vano-auth-startup .register-email-submit,
body.vano-route-register .register-email-submit{border:0!important;background:linear-gradient(135deg,#f39a60,#e77539)!important;color:#fff!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:9px!important;font-size:12px!important;font-weight:900!important;box-shadow:0 16px 34px rgba(222,111,54,.24)!important}
body.vano-auth-startup .register-email-submit:hover,
body.vano-route-register .register-email-submit:hover{transform:translateY(-1px)!important;box-shadow:0 20px 42px rgba(222,111,54,.31)!important}
body.vano-auth-startup .register-existing,
body.vano-auth-startup .register-legal,
body.vano-route-register .register-existing,
body.vano-route-register .register-legal{color:var(--v402-muted)!important}
body.vano-auth-startup .register-existing,
body.vano-route-register .register-existing{margin-top:16px!important;text-align:center!important;font-size:10.5px!important}
body.vano-auth-startup .register-existing a,
body.vano-route-register .register-existing a{color:var(--v402-accent-strong)!important;font-weight:900!important}
body.vano-auth-startup .register-guest,
body.vano-route-register .register-guest{display:flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;width:max-content!important;margin:16px auto 0!important;color:var(--v402-muted)!important;font-size:10px!important;font-weight:800!important;padding:8px 11px!important;border-radius:999px!important;border:1px solid transparent!important}
body.vano-auth-startup .register-guest:hover,
body.vano-route-register .register-guest:hover{background:var(--v402-card-2)!important;border-color:var(--v402-line)!important;color:var(--v402-ink)!important}
body.vano-auth-startup .register-legal,
body.vano-route-register .register-legal{margin-top:auto!important;padding-top:25px!important;font-size:9px!important;line-height:1.5!important}
body.vano-auth-startup .register-preview,
body.vano-route-register .register-preview{position:relative!important;overflow:hidden!important;background:#101318!important;border-left:1px solid var(--v402-line)!important}
body.vano-auth-startup .register-city,
body.vano-route-register .register-city{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;object-fit:cover!important;filter:saturate(.72) contrast(1.03) brightness(.78)!important;transform:scale(1.03)!important}
body.vano-auth-startup .preview-shade,
body.vano-route-register .preview-shade{position:absolute!important;inset:0!important;background:linear-gradient(180deg,rgba(10,12,15,.16),rgba(10,12,15,.12) 38%,rgba(10,12,15,.76))!important}
body.vano-auth-startup .preview-top,
body.vano-route-register .preview-top{position:absolute!important;top:32px!important;left:32px!important;right:32px!important;color:#fff!important}
body.vano-auth-startup .preview-top>span,
body.vano-route-register .preview-top>span{display:inline-flex!important;align-items:center!important;gap:7px!important;min-height:29px!important;padding:0 10px!important;border-radius:999px!important;background:rgba(15,18,22,.55)!important;border:1px solid rgba(255,255,255,.11)!important;backdrop-filter:blur(16px)!important;font-size:8px!important;font-weight:900!important;letter-spacing:.12em!important}
body.vano-auth-startup .preview-top>span i,
body.vano-route-register .preview-top>span i{width:7px!important;height:7px!important;border-radius:50%!important;background:#76d99b!important;box-shadow:0 0 0 5px rgba(118,217,155,.11)!important}
body.vano-auth-startup .preview-top>b,
body.vano-route-register .preview-top>b{display:block!important;margin-top:18px!important;font-size:clamp(34px,4vw,52px)!important;line-height:.95!important;letter-spacing:-2.7px!important}
body.vano-auth-startup .preview-route-card,
body.vano-route-register .preview-route-card{position:absolute!important;left:32px!important;right:32px!important;bottom:94px!important;display:grid!important;grid-template-columns:44px 1fr!important;gap:12px!important;padding:15px!important;border-radius:21px!important;background:rgba(16,19,23,.76)!important;border:1px solid rgba(255,255,255,.10)!important;backdrop-filter:blur(18px)!important;box-shadow:0 20px 52px rgba(0,0,0,.22)!important;color:#fff!important}
body.vano-auth-startup .preview-route-icon,
body.vano-route-register .preview-route-icon{width:44px!important;height:44px!important;border-radius:14px!important;display:grid!important;place-items:center!important;background:rgba(255,148,86,.14)!important;color:#ffad79!important}
body.vano-auth-startup .preview-route-card small,
body.vano-route-register .preview-route-card small{display:block!important;color:#ffb98f!important;font-size:8px!important;font-weight:900!important;letter-spacing:.11em!important}
body.vano-auth-startup .preview-route-card b,
body.vano-route-register .preview-route-card b{display:block!important;margin-top:3px!important;font-size:15px!important}
body.vano-auth-startup .preview-route-card span,
body.vano-route-register .preview-route-card span{display:block!important;margin-top:3px!important;color:#a6adb4!important;font-size:10px!important;line-height:1.45!important}
body.vano-auth-startup .preview-pills,
body.vano-route-register .preview-pills{position:absolute!important;left:32px!important;right:32px!important;bottom:34px!important;display:flex!important;gap:7px!important;flex-wrap:wrap!important}
body.vano-auth-startup .preview-pills>span,
body.vano-route-register .preview-pills>span{display:inline-flex!important;align-items:center!important;gap:5px!important;min-height:30px!important;padding:0 10px!important;border-radius:999px!important;background:rgba(16,19,23,.64)!important;border:1px solid rgba(255,255,255,.08)!important;color:#ccd0d5!important;backdrop-filter:blur(14px)!important;font-size:9px!important;font-weight:780!important}

/* ---------------- ONBOARDING ---------------- */
body.vano-auth-startup.vano-route-onboarding,
body.vano-route-register.vano-route-onboarding{background:var(--v402-bg)!important;color:var(--v402-ink)!important}
