body.vano-auth-startup .ob-completion-chip.is-complete,
body.vano-route-register .ob-completion-chip.is-complete{background:rgba(64,164,104,.09)!important;border-color:rgba(64,164,104,.14)!important;color:#3e9561!important}
body.vano-auth-startup .ob-live-profile-v402,
body.vano-route-register .ob-live-profile-v402{display:flex;align-items:center;gap:11px;padding:12px 13px;margin-bottom:14px;border-radius:18px;background:var(--v402-card);border:1px solid var(--v402-line);box-shadow:0 8px 24px rgba(34,27,22,.035)}
body.vano-auth-startup .ob-live-profile-v402>span,
body.vano-route-register .ob-live-profile-v402>span{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,#ffa56e,#e9773d);color:#fff;font-size:15px;font-weight:900;box-shadow:0 10px 22px rgba(222,111,54,.18)}
body.vano-auth-startup .ob-live-profile-v402 small,
body.vano-route-register .ob-live-profile-v402 small{display:block;color:var(--v402-faint);font-size:8px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
body.vano-auth-startup .ob-live-profile-v402 b,
body.vano-route-register .ob-live-profile-v402 b{display:block;margin-top:3px;color:var(--v402-ink);font-size:13px;letter-spacing:-.01em}
body.vano-auth-startup .ob-live-profile-v402 em,
body.vano-route-register .ob-live-profile-v402 em{margin-left:auto;font-style:normal;color:var(--v402-muted);font-size:9px;font-weight:700}

body.vano-auth-startup .ob-field-v340>span,
body.vano-route-register .ob-field-v340>span{color:var(--v402-muted)!important;font-size:10px!important;margin-bottom:7px!important}
body.vano-auth-startup .ob-field-note-v340,
body.vano-route-register .ob-field-note-v340{color:var(--v402-faint)!important;font-size:9.5px!important;margin-top:6px!important}
body.vano-auth-startup .ob-input-v340,
body.vano-route-register .ob-input-v340{height:58px!important;border-radius:17px!important;background:var(--v402-card)!important;border-color:var(--v402-line)!important;box-shadow:none!important;padding:0 15px!important}
body.vano-auth-startup .ob-input-v340:hover,
body.vano-route-register .ob-input-v340:hover{border-color:var(--v402-line-strong)!important}
body.vano-auth-startup .ob-input-v340:focus-within,
body.vano-route-register .ob-input-v340:focus-within{background:var(--v402-card)!important;border-color:rgba(242,139,80,.52)!important;box-shadow:0 0 0 4px rgba(242,139,80,.10)!important;transform:translateY(-1px)!important}
body.vano-auth-startup .ob-input-v340 i,
body.vano-route-register .ob-input-v340 i{color:var(--v402-accent-strong)!important}
body.vano-auth-startup .ob-input-v340 input,
body.vano-route-register .ob-input-v340 input{color:var(--v402-ink)!important;font-size:14px!important;font-weight:720!important}
body.vano-auth-startup .ob-input-v340 input::placeholder,
body.vano-route-register .ob-input-v340 input::placeholder{color:var(--v402-faint)!important}
body.vano-auth-startup .ob-field-grid-v340,
body.vano-route-register .ob-field-grid-v340{grid-template-columns:minmax(150px,.44fr) minmax(0,1.56fr)!important;gap:12px!important}
body.vano-auth-startup .ob-field-choice-v340,
body.vano-route-register .ob-field-choice-v340{grid-column:auto!important}
body.vano-auth-startup .ob-choice-grid-v340,
body.vano-route-register .ob-choice-grid-v340{gap:8px!important}
body.vano-auth-startup .ob-choice-card-v340,
body.vano-route-register .ob-choice-card-v340{min-height:67px!important;padding:11px 12px!important;border-radius:16px!important;background:var(--v402-card)!important;border-color:var(--v402-line)!important;box-shadow:none!important}
body.vano-auth-startup .ob-choice-card-v340 b,
body.vano-route-register .ob-choice-card-v340 b{color:var(--v402-ink)!important;font-size:11px!important}
body.vano-auth-startup .ob-choice-card-v340 small,
body.vano-route-register .ob-choice-card-v340 small{color:var(--v402-faint)!important;font-size:8.5px!important}
body.vano-auth-startup .ob-choice-card-v340 i,
body.vano-route-register .ob-choice-card-v340 i{color:var(--v402-accent-strong)!important}
body.vano-auth-startup .ob-choice-v340 input:checked + .ob-choice-card-v340,
body.vano-route-register .ob-choice-v340 input:checked + .ob-choice-card-v340{background:var(--v402-accent-soft)!important;border-color:rgba(242,139,80,.36)!important;box-shadow:0 10px 24px rgba(222,111,54,.07)!important;transform:translateY(-1px)!important}
body.vano-auth-startup .ob-profile-footer-v344,
body.vano-route-register .ob-profile-footer-v344{color:var(--v402-faint)!important;font-size:9px!important}
body.vano-auth-startup .ob-profile-footer-v344 span,
body.vano-route-register .ob-profile-footer-v344 span{background:transparent!important;border:0!important;padding:0!important}

body.vano-auth-startup .ob-language-panel-v344,
body.vano-route-register .ob-language-panel-v344{padding:15px!important}
body.vano-auth-startup .ob-language-head-v344,
body.vano-route-register .ob-language-head-v344{align-items:center!important;padding:0 1px 13px!important;border-bottom:1px solid var(--v402-line)!important;margin-bottom:13px!important}
body.vano-auth-startup .ob-language-current-v344,
body.vano-route-register .ob-language-current-v344{background:var(--v402-card)!important;border-color:var(--v402-line)!important;box-shadow:none!important}
body.vano-auth-startup .ob-language-current-v344 small,
body.vano-route-register .ob-language-current-v344 small{color:var(--v402-faint)!important}
body.vano-auth-startup .ob-language-current-v344 b,
body.vano-route-register .ob-language-current-v344 b{color:var(--v402-ink)!important}
body.vano-auth-startup .ob-language-grid-v340,
body.vano-route-register .ob-language-grid-v340{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
body.vano-auth-startup .ob-language-card-v340,
body.vano-route-register .ob-language-card-v340{min-height:66px!important;padding:10px 12px!important;border-radius:16px!important;background:var(--v402-card)!important;border-color:var(--v402-line)!important;box-shadow:none!important}
body.vano-auth-startup .ob-language-card-v340 em,
body.vano-route-register .ob-language-card-v340 em{font-size:22px!important;filter:saturate(.92)}
body.vano-auth-startup .ob-language-card-v340 b,
body.vano-route-register .ob-language-card-v340 b{color:var(--v402-ink)!important;font-size:11px!important}
body.vano-auth-startup .ob-language-card-v340 small,
body.vano-route-register .ob-language-card-v340 small{color:var(--v402-faint)!important;font-size:9px!important}
body.vano-auth-startup .ob-language-check-v344,
body.vano-route-register .ob-language-check-v344{width:25px!important;height:25px!important;border-radius:9px!important;background:var(--v402-card-2)!important;border:1px solid var(--v402-line)!important;color:var(--v402-faint)!important}
body.vano-auth-startup .ob-language-v340 input:checked + .ob-language-card-v340,
body.vano-route-register .ob-language-v340 input:checked + .ob-language-card-v340{background:var(--v402-accent-soft)!important;border-color:rgba(242,139,80,.38)!important;box-shadow:0 10px 24px rgba(222,111,54,.07)!important;transform:translateY(-1px)!important}
body.vano-auth-startup .ob-language-v340 input:checked + .ob-language-card-v340 .ob-language-check-v344,
body.vano-route-register .ob-language-v340 input:checked + .ob-language-card-v340 .ob-language-check-v344{background:var(--v402-accent)!important;border-color:transparent!important;color:#fff!important}
body.vano-auth-startup .ob-language-foot-v344,
body.vano-route-register .ob-language-foot-v344{color:var(--v402-faint)!important;font-size:9px!important}

body.vano-auth-startup .ob-step-actions-v340,
body.vano-route-register .ob-step-actions-v340{padding-top:18px!important;min-height:70px!important}
body.vano-auth-startup .ob-step-hint-v340,
body.vano-route-register .ob-step-hint-v340{color:var(--v402-faint)!important;font-size:9.5px!important}
body.vano-auth-startup .ob-step-hint-v340 i,
body.vano-route-register .ob-step-hint-v340 i{color:var(--v402-accent-strong)!important}
body.vano-auth-startup .ob-back-v340,
body.vano-route-register .ob-back-v340{color:var(--v402-muted)!important;font-size:10.5px!important;min-height:46px!important;padding:0 10px!important;border-radius:14px!important}
body.vano-auth-startup .ob-back-v340:hover,
body.vano-route-register .ob-back-v340:hover{background:var(--v402-card-2)!important;color:var(--v402-ink)!important}
body.vano-auth-startup .ob-next-v340,
body.vano-auth-startup .ob-finish-v340,
body.vano-route-register .ob-next-v340,
body.vano-route-register .ob-finish-v340{min-height:52px!important;border-radius:16px!important;background:linear-gradient(135deg,#f39a60,#e77539)!important;color:#fff!important;font-size:11px!important;box-shadow:0 14px 30px rgba(222,111,54,.22)!important}
body.vano-auth-startup .ob-next-v340:hover,
body.vano-auth-startup .ob-finish-v340:hover,
body.vano-route-register .ob-next-v340:hover,
body.vano-route-register .ob-finish-v340:hover{transform:translateY(-1px)!important;box-shadow:0 18px 38px rgba(222,111,54,.29)!important}
body.vano-auth-startup .ob-finish-v340,
body.vano-route-register .ob-finish-v340{min-width:250px!important}

body.vano-auth-startup .ob-summary-v340,
body.vano-route-register .ob-summary-v340{margin-top:19px!important;padding:15px!important;border-radius:21px!important;background:var(--v402-card-2)!important;border-color:var(--v402-line)!important;box-shadow:none!important}
body.vano-auth-startup .ob-summary-avatar-v340,
body.vano-route-register .ob-summary-avatar-v340{width:54px!important;height:54px!important;border-radius:17px!important;background:linear-gradient(135deg,#ffa56e,#e9773d)!important;box-shadow:0 12px 25px rgba(222,111,54,.18)!important}
body.vano-auth-startup .ob-summary-copy-v340 small,
body.vano-route-register .ob-summary-copy-v340 small{color:var(--v402-accent-strong)!important}
body.vano-auth-startup .ob-summary-copy-v340 b,
body.vano-route-register .ob-summary-copy-v340 b{color:var(--v402-ink)!important;font-size:16px!important}
body.vano-auth-startup .ob-summary-copy-v340 span,
body.vano-route-register .ob-summary-copy-v340 span{color:var(--v402-muted)!important}
body.vano-auth-startup .ob-summary-badge-v340,
body.vano-route-register .ob-summary-badge-v340{background:rgba(64,164,104,.09)!important;border-color:rgba(64,164,104,.14)!important;color:#3f9863!important}
body.vano-auth-startup .ob-summary-grid-v340,
body.vano-route-register .ob-summary-grid-v340{gap:8px!important;margin-top:8px!important}
body.vano-auth-startup .ob-summary-grid-v340>div,
body.vano-route-register .ob-summary-grid-v340>div{padding:13px!important;border-radius:17px!important;background:var(--v402-card-2)!important;border-color:var(--v402-line)!important}
body.vano-auth-startup .ob-summary-icon-v340,
body.vano-route-register .ob-summary-icon-v340{background:var(--v402-accent-soft)!important;color:var(--v402-accent-strong)!important}
body.vano-auth-startup .ob-summary-grid-v340 small,
body.vano-route-register .ob-summary-grid-v340 small{color:var(--v402-faint)!important}
body.vano-auth-startup .ob-summary-grid-v340 b,
body.vano-route-register .ob-summary-grid-v340 b{color:var(--v402-ink)!important;font-size:13px!important}
body.vano-auth-startup .ob-ready-note-v340,
body.vano-route-register .ob-ready-note-v340{background:var(--v402-card-2)!important;color:var(--v402-muted)!important;border:1px solid var(--v402-line)!important;border-radius:17px!important}
body.vano-auth-startup .ob-ready-note-v340>i,
body.vano-route-register .ob-ready-note-v340>i{background:var(--v402-accent-soft)!important;color:var(--v402-accent-strong)!important}
body.vano-auth-startup .ob-ready-note-v340 b,
body.vano-route-register .ob-ready-note-v340 b{color:var(--v402-ink)!important}

body.vano-auth-startup .ob-preview-v340,
body.vano-route-register .ob-preview-v340{background:#0e1115!important;border-left:1px solid var(--v402-line)!important}
body.vano-auth-startup .ob-preview-v340>img,
body.vano-route-register .ob-preview-v340>img{filter:saturate(.72) contrast(1.03) brightness(.66)!important;transform:scale(1.045)!important}
body.vano-auth-startup .ob-preview-overlay-v340,
body.vano-route-register .ob-preview-overlay-v340{background:linear-gradient(180deg,rgba(8,10,13,.1),rgba(8,10,13,.18) 45%,rgba(8,10,13,.72))!important}
body.vano-auth-startup .ob-preview-brand-v340,
body.vano-route-register .ob-preview-brand-v340{top:28px!important;left:28px!important;right:28px!important;padding:10px!important;border-radius:17px!important;background:rgba(15,18,22,.68)!important;border-color:rgba(255,255,255,.09)!important;box-shadow:0 18px 42px rgba(0,0,0,.18)!important;color:#fff!important;backdrop-filter:blur(18px)!important}
body.vano-auth-startup .ob-preview-brand-v340 img,
body.vano-route-register .ob-preview-brand-v340 img{width:38px!important;height:38px!important}
body.vano-auth-startup .ob-preview-brand-v340 small,
body.vano-route-register .ob-preview-brand-v340 small{color:#ffb88e!important}
body.vano-auth-startup .ob-preview-brand-v340 b,
body.vano-route-register .ob-preview-brand-v340 b{color:#fff!important;font-size:12px!important}
body.vano-auth-startup .ob-preview-card-v340,
body.vano-route-register .ob-preview-card-v340{left:28px!important;right:28px!important;bottom:28px!important;padding:16px!important;border-radius:21px!important;background:rgba(15,18,22,.76)!important;border-color:rgba(255,255,255,.10)!important;box-shadow:0 20px 50px rgba(0,0,0,.26)!important;backdrop-filter:blur(20px)!important}
body.vano-auth-startup .ob-preview-card-v340 small,
body.vano-route-register .ob-preview-card-v340 small{color:#ffb88e!important}
body.vano-auth-startup .ob-preview-card-v340 b,
body.vano-route-register .ob-preview-card-v340 b{color:#fff!important;font-size:16px!important}
body.vano-auth-startup .ob-preview-card-v340 span,
body.vano-route-register .ob-preview-card-v340 span{color:#a6adb5!important}
body.vano-auth-startup .ob-preview-meter-v340,
body.vano-route-register .ob-preview-meter-v340{background:rgba(255,255,255,.09)!important}
body.vano-auth-startup .ob-preview-meter-v340 i,
body.vano-route-register .ob-preview-meter-v340 i{background:#ff9558!important}
body.vano-auth-startup .ob-preview-route-v402,
body.vano-route-register .ob-preview-route-v402{position:absolute;inset:130px 26px 126px;pointer-events:none;filter:drop-shadow(0 6px 18px rgba(0,0,0,.2))}
body.vano-auth-startup .ob-preview-route-v402 svg,
body.vano-route-register .ob-preview-route-v402 svg{width:100%;height:100%;overflow:visible}
body.vano-auth-startup .ob-preview-route-v402 .road,
body.vano-route-register .ob-preview-route-v402 .road{fill:none;stroke:rgba(255,255,255,.075);stroke-width:8;stroke-linecap:round}
body.vano-auth-startup .ob-preview-route-v402 .route-halo,
body.vano-route-register .ob-preview-route-v402 .route-halo{fill:none;stroke:rgba(255,149,88,.15);stroke-width:14;stroke-linecap:round}
body.vano-auth-startup .ob-preview-route-v402 .route,
body.vano-route-register .ob-preview-route-v402 .route{fill:none;stroke:#ff9558;stroke-width:5;stroke-linecap:round;stroke-dasharray:6 0}
body.vano-auth-startup .ob-preview-route-v402 .pin,
body.vano-route-register .ob-preview-route-v402 .pin{fill:#fff;stroke:#ff9558;stroke-width:5}
body.vano-auth-startup .ob-preview-route-v402 .user,
body.vano-route-register .ob-preview-route-v402 .user{fill:#ff9558;stroke:#fff;stroke-width:4}

body.vano-auth-startup .ob-invalid-v340 .ob-input-v340,
body.vano-route-register .ob-invalid-v340 .ob-input-v340{border-color:#d65b52!important;box-shadow:0 0 0 4px rgba(214,91,82,.08)!important}
body.vano-auth-startup .ob-inline-error-v340,
body.vano-route-register .ob-inline-error-v340{color:#c9534b!important;font-size:9px!important}

/* Dark fixes for legacy declarations */
html[data-vano-theme="black"] body.vano-auth-startup.vano-route-onboarding,
html[data-vano-theme-mode="black"] body.vano-auth-startup.vano-route-onboarding,
html[data-vano-theme="black"] body.vano-route-register.vano-route-onboarding,
html[data-vano-theme-mode="black"] body.vano-route-register.vano-route-onboarding{background:var(--v402-bg)!important;color:var(--v402-ink)!important}
html[data-vano-theme="black"] body.vano-auth-startup .ob-card-v340,
html[data-vano-theme-mode="black"] body.vano-auth-startup .ob-card-v340,
html[data-vano-theme="black"] body.vano-auth-startup .ob-summary-v340,
html[data-vano-theme-mode="black"] body.vano-auth-startup .ob-summary-v340,
html[data-vano-theme="black"] body.vano-auth-startup .ob-summary-grid-v340>div,
html[data-vano-theme-mode="black"] body.vano-auth-startup .ob-summary-grid-v340>div,
html[data-vano-theme="black"] body.vano-route-register .ob-card-v340,
html[data-vano-theme-mode="black"] body.vano-route-register .ob-card-v340,
html[data-vano-theme="black"] body.vano-route-register .ob-summary-v340,
html[data-vano-theme-mode="black"] body.vano-route-register .ob-summary-v340,
html[data-vano-theme="black"] body.vano-route-register .ob-summary-grid-v340>div,
html[data-vano-theme-mode="black"] body.vano-route-register .ob-summary-grid-v340>div{background:var(--v402-card-2)!important;border-color:var(--v402-line)!important}
html[data-vano-theme="black"] body.vano-auth-startup .ob-input-v340,
html[data-vano-theme-mode="black"] body.vano-auth-startup .ob-input-v340,
html[data-vano-theme="black"] body.vano-auth-startup .ob-choice-card-v340,
html[data-vano-theme-mode="black"] body.vano-auth-startup .ob-choice-card-v340,
html[data-vano-theme="black"] body.vano-auth-startup .ob-language-card-v340,
html[data-vano-theme-mode="black"] body.vano-auth-startup .ob-language-card-v340,
html[data-vano-theme="black"] body.vano-route-register .ob-input-v340,
html[data-vano-theme-mode="black"] body.vano-route-register .ob-input-v340,
html[data-vano-theme="black"] body.vano-route-register .ob-choice-card-v340,
html[data-vano-theme-mode="black"] body.vano-route-register .ob-choice-card-v340,
html[data-vano-theme="black"] body.vano-route-register .ob-language-card-v340,
html[data-vano-theme-mode="black"] body.vano-route-register .ob-language-card-v340{background:var(--v402-card)!important;border-color:var(--v402-line)!important}

/* ---------------- MOBILE ---------------- */
@media(max-width:900px){
  body.vano-auth-startup.vano-auth-startup,
body.vano-route-register.vano-auth-startup{display:block!important;padding:max(68px,calc(env(safe-area-inset-top) + 55px)) 10px max(10px,env(safe-area-inset-bottom))!important}
  body.vano-auth-startup .startup-topbar,
body.vano-route-register .startup-topbar{left:max(15px,env(safe-area-inset-left));right:max(15px,env(safe-area-inset-right));top:max(12px,env(safe-area-inset-top))}
  body.vano-auth-startup .startup-wordmark,
body.vano-route-register .startup-wordmark{width:148px}body.vano-auth-startup .startup-wordmark img,
body.vano-route-register .startup-wordmark img{height:27px}
  body.vano-auth-startup .startup-theme,
body.vano-route-register .startup-theme{width:40px;height:40px;border-radius:13px}
  body.vano-auth-startup .startup-shell,
body.vano-route-register .startup-shell{display:block!important;min-height:calc(100svh - 78px)!important;border-radius:27px!important}
  body.vano-auth-startup .startup-auth,
body.vano-route-register .startup-auth{min-height:calc(100svh - 78px)!important}
  body.vano-auth-startup .startup-auth:before,
body.vano-route-register .startup-auth:before{width:100%;height:4px;background:linear-gradient(90deg,var(--v402-accent),transparent 60%)}
  body.vano-auth-startup .startup-auth-inner,
body.vano-route-register .startup-auth-inner{padding:32px 20px 22px!important;min-height:calc(100svh - 78px)!important}
  body.vano-auth-startup .startup-flow,
body.vano-route-register .startup-flow{margin:auto 0!important;width:100%!important}
  body.vano-auth-startup .startup-copy h1,
body.vano-route-register .startup-copy h1{font-size:clamp(45px,13vw,61px)!important;letter-spacing:-3.1px!important}
  body.vano-auth-startup .startup-copy h2,
body.vano-route-register .startup-copy h2{font-size:clamp(42px,12vw,56px)!important;letter-spacing:-2.7px!important}
  body.vano-auth-startup .startup-benefits-v402,
body.vano-route-register .startup-benefits-v402{margin-top:15px}
  body.vano-auth-startup .startup-primary,
body.vano-auth-startup .startup-secondary,
body.vano-auth-startup .startup-submit,
body.vano-route-register .startup-primary,
body.vano-route-register .startup-secondary,
body.vano-route-register .startup-submit{min-height:58px!important}
  body.vano-auth-startup .startup-visual,
body.vano-route-register .startup-visual{display:none!important}
  body.vano-auth-startup .startup-legal,
body.vano-route-register .startup-legal{font-size:8.5px!important;padding-top:20px!important}

  body.vano-auth-startup .vano-register-v340,
body.vano-route-register .vano-register-v340{padding:10px!important}
  body.vano-auth-startup .register-shell,
body.vano-route-register .register-shell{display:block!important;min-height:calc(100svh - 20px)!important;border-radius:27px!important}
  body.vano-auth-startup .register-panel,
body.vano-route-register .register-panel{min-height:calc(100svh - 20px)!important;padding:24px 18px 18px!important}
  body.vano-auth-startup .register-brand,
body.vano-route-register .register-brand{margin-bottom:34px!important}body.vano-auth-startup .register-brand img,
body.vano-route-register .register-brand img{height:28px!important}
  body.vano-auth-startup .register-copy h1,
body.vano-route-register .register-copy h1{font-size:clamp(41px,11.8vw,56px)!important;letter-spacing:-2.8px!important}
  body.vano-auth-startup .register-actions,
body.vano-route-register .register-actions{max-width:none!important}
  body.vano-auth-startup .register-preview,
