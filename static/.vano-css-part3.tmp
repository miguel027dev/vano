body.vano-route-register .visual-footer span{color:#959ca5!important}

/* ---------------- REGISTRATION ---------------- */
body.vano-auth-startup .vano-register-v340,
body.vano-route-register .vano-register-v340{min-height:100svh!important;padding:14px!important;background:radial-gradient(circle at 12% 0,rgba(242,139,80,.14),transparent 26%),var(--v402-bg)!important;color:var(--v402-ink)!important}
body.vano-auth-startup .register-shell,
body.vano-route-register .register-shell{width:min(1140px,100%)!important;min-height:calc(100svh - 28px)!important;margin:0 auto!important;display:grid!important;grid-template-columns:minmax(0,.92fr) minmax(430px,1.08fr)!important;border:1px solid var(--v402-line)!important;border-radius:34px!important;background:var(--v402-card)!important;box-shadow:var(--v402-shadow)!important;overflow:hidden!important}
body.vano-auth-startup .register-panel,
body.vano-route-register .register-panel{padding:clamp(30px,4.8vw,62px)!important;display:flex!important;flex-direction:column!important;min-width:0!important;background:var(--v402-card)!important}
body.vano-auth-startup .register-brand,
body.vano-route-register .register-brand{display:inline-flex!important;align-items:center!important;width:max-content!important;max-width:190px!important;margin-bottom:clamp(38px,6vh,68px)!important}
body.vano-auth-startup .register-brand img,
body.vano-route-register .register-brand img{height:31px!important;max-width:184px!important;object-fit:contain!important}
body.vano-auth-startup .register-copy,
