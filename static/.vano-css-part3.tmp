body.vano-route-register .ob-shell.ob-shell-v402{width:min(1200px,100%)!important;min-height:calc(100svh - 28px)!important;grid-template-columns:minmax(0,1.04fr) minmax(400px,.76fr)!important;border:1px solid var(--v402-line)!important;border-radius:34px!important;background:var(--v402-card)!important;box-shadow:var(--v402-shadow)!important}
body.vano-auth-startup .ob-main-v340,
