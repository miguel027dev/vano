opacity:.4;cursor:not-allowed}body.vano-route-admin-dashboard .admin350-activity-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}body.vano-route-admin-dashboard .admin350-activity-grid>.admin350-card{padding:18px}body.vano-route-admin-dashboard .admin350-pill{min-width:26px;height:26px;padding:0 8px;border-radius:999px;display:grid;place-items:center;background:var(--a-soft);font-size:8.5px;font-weight:900;color:var(--a-muted)}body.vano-route-admin-dashboard .admin350-text-link{font-size:8.5px;font-weight:850;color:#9b552e;text-decoration:none}body.vano-route-admin-dashboard .admin350-feed{display:grid;margin-top:8px}body.vano-route-admin-dashboard .admin350-feed-row{display:grid;grid-template-columns:32px minmax(0,1fr) auto;align-items:center;gap:9px;min-height:52px;border-bottom:1px solid var(--a-line)}body.vano-route-admin-dashboard .admin350-feed-row:last-child{border-bottom:0}body.vano-route-admin-dashboard .admin350-feed-icon{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;background:var(--a-soft);color:#757b84}body.vano-route-admin-dashboard .admin350-feed-icon.is-alert{background:var(--a-yellow-soft);color:#9b7125}body.vano-route-admin-dashboard .admin350-feed-row b,
