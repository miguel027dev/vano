# Never publish this file with real values. Install as /etc/vano/vano.env (chmod 600).
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=8878
VANO_PUBLIC_ORIGIN=https://vanomaps.example.com
VANO_TRUST_PROXY=1
# Single process + persistent private volume + backups only; NOT a scalable distributed DB.
VANO_ALLOW_SINGLE_INSTANCE_JSON=1
VANO_DATA_FILE=/var/lib/vano/store.json
VANO_SECURITY_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_VALUE
RESEND_API_KEY=REPLACE_WITH_EMAIL_PROVIDER_API_KEY
VANO_EMAIL_FROM="VANO Maps <seguranca@seu-dominio.com>"
# Choose ONE trusted route provider / original V1 backend; never paste sk.* into frontend.
VANO_V1_API_URL=https://sua-api-v1.example.com
VITE_MAPBOX_PUBLIC_TOKEN=REPLACE_WITH_PK_PUBLIC_TOKEN
VITE_DEMO_MODE=false
