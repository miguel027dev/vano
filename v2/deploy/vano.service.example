# /etc/systemd/system/vano.service
# Provision an unprivileged account `vano`, /srv/vano/vano-react-v2, and /var/lib/vano (0700).
[Unit]
Description=VANO Maps secure single-instance API and static frontend
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=vano
Group=vano
WorkingDirectory=/srv/vano/vano-react-v2
Environment=NODE_ENV=production
EnvironmentFile=/etc/vano/vano.env
ExecStart=/usr/local/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vano
RestrictSUIDSGID=true
LockPersonality=true
[Install]
WantedBy=multi-user.target
